# Build configuration only. Why the pins and block order are what they are:
# docs/architecture/002-the-dependency-pins.md. Versions and history: state.md, CHANGELOG.md.

[package]
name = "agnostic"
version = "${file:VERSION}"
description = "agnostic — TODO"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "agnostic"

[deps]
stdlib = [
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string",
    "vec", "slice", "args", "process", "assert", "bench",
    "fnptr", "freelist", "hashmap", "hashmap_fast", "callback", "chrono", "math",
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sha1",
    "mmap", "dynlib", "fdlopen", "async", "bayan",
    "net", "http", "tls", "sakshi", "sandhi", "patra", "sigil",
]

[deps.agnosai]
git = "https://github.com/MacCracken/agnosai.git"
tag = "2.2.3"
modules = ["dist/agnosai.cyr"]

[deps.libro]
git = "https://github.com/MacCracken/libro.git"
tag = "2.11.3"
modules = ["dist/libro.cyr"]

[release]
bins = ["agnostic"]
cross_bins = ["agnostic-aarch64"]
