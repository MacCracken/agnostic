[package]
name = "agnostic"
version = "${file:VERSION}"
description = "agnostic — TODO"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.11"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "agnostic"

[deps]
stdlib = [
    "syscalls", "alloc", "result", "tagged", "fmt", "io", "fs", "str", "string",
    "vec", "slice", "args", "process", "assert", "bench",
    "fnptr", "freelist", "hashmap", "hashmap_fast", "callback", "chrono", "math",
    "atomic", "sync", "thread", "thread_local", "ct", "keccak", "random", "sha1",
    "mmap", "dynlib", "fdlopen",
    "async",
    "bayan",
    "net", "http", "tls", "sakshi", "sandhi",
    # M4 — persistence. `patra` is an embedded single-file store folded into the
    # toolchain stdlib, so it is a stdlib entry rather than a `[deps.*]` block.
    # ⚠ `libro`, the audit chain, is NOT in the toolchain snapshot: it reaches
    # `lib/` only transitively through agnosai. See `[deps.libro]` below.
    "patra",
    # M5 — identity. `sigil` is the crypto tier: Argon2id, SHA-256, HMAC-SHA256.
    # (Constant-time compare is `ct_eq_bytes`, which lives in `ct` above.)
    #
    # ⚠ **Declaring it changes nothing today, and that is the point.** sigil
    # already reaches the compile unit transitively — agnosai declares
    # `[deps.sigil]` at 3.12.9 — and the duplicate-fn warning count is identical
    # with and without this line, measured. It is here so that a future agnosai
    # which stops depending on sigil cannot silently take the crypto tier away
    # from the identity surface. Same defensive reasoning the `sakshi` note in
    # `scripts/check-clean.sh` records.
    "sigil",
]

# Release artifacts. `bins` is the native build; `cross_bins` is what the
# release workflow cross-compiles. first-party-standards.md:956 makes both
# x86_64-linux and aarch64-linux artifacts a release-checklist item, so the
# aarch64 entry is not optional once a tag is cut.
# AgnosAI — the engine tier, linked in-process rather than called over HTTP.
# Agnostic owns the product tier; everything crew/task/agent/scheduling-shaped
# lives here. See CYRIUS-PORT-BRIEF.md §3.
# ⚠ **No `path = "../agnosai"`, deliberately.** `path` beats `tag` when a checkout
# is present, so a local resolve silently vendors the sibling's work-in-progress
# into `lib/` and the lock — content that corresponds to no tag and that CI cannot
# fetch. agnosai removed the same `path` from its own `[deps.kavach]` for exactly
# this reason. Resolve from the tag only.
#
# ⚠ **This tag and `[package].cyrius` above move TOGETHER.** agnosai 2.0.5 carries
# bote 3.3.3 -> libro 2.8.10, which declares `[deps.patra] = 1.13.10`, and
# `cyrius deps` overlays a declared dep's copy on top of the stdlib snapshot on
# every resolve. Only a Cyrius that folds 1.13.10 (**6.5.34**) makes `lib/` match
# the pin, and `scripts/check-clean.sh` allows no file to differ. Bumping either
# one alone leaves this repo red: 2.0.4 pulls libro 2.8.8 (patra 1.13.9), which
# would downgrade against a 6.5.34 snapshot just as surely as 2.0.5 upgraded
# against a 6.5.32 one.
#
# ⚠ **The same lockstep at 6.6.2 — and this time the stale half was the DEP.**
# The 6.6.2 `Result` value form retires `payload()` / `tag()` / 1-arg
# `result_unwrap()`. agnosai 2.0.6 pins kavach 3.12.2, whose `dist/kavach.cyr`
# predates that flip, so bumping `[package].cyrius` alone left 41 hard compile
# errors in vendored `lib/` — 34 of them in kavach — on EVERY surface (build,
# all 24 `.tcyr`, the bench, the fuzz harness). Nothing in `src/` needed a line
# changed: agnostic's own code uses no `Result`/`Option`/`Either` at all.
# 2.0.8 pins kavach 3.12.5 + libro 2.10.x, which are migrated. Move both.
#
# ⚠ At 6.6.11 / agnosai 2.1.1 the folded copies WIN, not the chain's. 6.6.11 folds
# **sigil 3.13.4** and **patra 1.15.1**; the chain still declares sigil 3.12.18
# (agnosai, kavach 3.13.1, libro 2.10.3) and patra 1.14.3 (libro). `cyrius deps`
# refuses to overwrite a folded stdlib leaf with a dep's artifact ("refusing to
# overwrite stdlib leaf"), so `lib/sigil.cyr` / `lib/patra.cyr` stay the 6.6.11
# snapshot — byte-identical to `git show 6.6.11:lib/<mod>` — and `check-clean.sh`
# stays green. The whole suite runs against those folded copies.
#
# ⛔ From 6.6.11 on, agnosai must be ≥ 2.1.1. 6.6.11 checks enum qualifiers, and
# agnosai 2.1.0 still spells kavach's renamed enum `Backend.NOOP` / `.WASM` /
# `.PROCESS` / `.OCI` (it is `KavachBackend` now), which 6.6.11 refuses with
# "'Backend' is not an enum". 2.1.1's dist carries the corrected spelling.
# ⛔ THE FOUR PINS BELOW ARE NOT OPTIONAL, AND THEY MUST PRECEDE [deps.agnosai].
# agnosai 2.0.8's own published manifest declares bote, majra, ai-hwaccel and tyche
# with `path = "../<sibling>"` ALONGSIDE their tags. A path override makes the tag
# INERT: on a machine that has those siblings checked out, resolution reads the
# working tree; on CI, which has none, it reads the tag. Same commit, two different
# `lib/` trees, so `cyrius.lock` is written differently on each and the
# "Lockfile agrees with a clean resolution" gate can never pass. Declaring them here
# WITHOUT a path removes the override from this repo's resolution entirely, so the
# lock is a function of the tags alone. Tags match what agnosai 2.1.1 itself pins —
# changing one here without checking agnosai is how the two silently diverge.
[deps.bote]
git = "https://github.com/MacCracken/bote.git"
tag = "3.3.13"

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
tag = "2.9.1"

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.4.0"

[deps.tyche]
git = "https://github.com/MacCracken/tyche.git"
tag = "1.1.0"

[deps.agnosai]
git = "https://github.com/MacCracken/agnosai.git"
tag = "2.1.1"
modules = ["dist/agnosai.cyr"]

[release]
bins = ["agnostic"]
cross_bins = ["agnostic-aarch64"]
