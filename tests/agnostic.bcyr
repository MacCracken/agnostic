# agnostic benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.

# The whole program (0.1.7), for the route table below. It includes the store and
# audit locks (0.1.4) the rlock benches use, so they need no include of their own.
include "src/app.cyr"

fn bench_noop(): i64 { return 0; }

# The route table is a flat scan in table order — `src/http/router.cyr` says why it
# is not indexed, and asks every change that adds a route to re-measure rather than
# inherit that sentence. These are the measurement: the first entry, the last, and a
# miss, which tries every pattern before answering 404.
fn _agnostic_bench_route(name, path): i64 {
    var a = arena_allocator(8388608);
    var p = str_from(path);
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < 100000) {
        agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, p);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);

    # What every store operation now pays before it touches patra: one
    # uncontended enter/exit pair. Two `gettid` syscalls plus one CAS each way.
    var l = agnostic_rlock_new();
    var br = bench_new("rlock_enter_exit");
    bench_batch_start(br);
    i = 0;
    while (i < 100000) {
        agnostic_rlock_enter(l);
        agnostic_rlock_exit(l);
        i = i + 1;
    }
    bench_batch_stop(br, 100000);
    bench_report(br);

    # A composed operation re-entering a lock it already holds.
    agnostic_rlock_enter(l);
    var bn = bench_new("rlock_reenter_nested");
    bench_batch_start(bn);
    i = 0;
    while (i < 100000) {
        agnostic_rlock_enter(l);
        agnostic_rlock_exit(l);
        i = i + 1;
    }
    bench_batch_stop(bn, 100000);
    bench_report(bn);
    agnostic_rlock_exit(l);

    # The stdlib mutex it is built on, for scale.
    var m = mutex_new();
    var bm = bench_new("mutex_lock_unlock");
    bench_batch_start(bm);
    i = 0;
    while (i < 100000) {
        mutex_lock(m);
        mutex_unlock(m);
        i = i + 1;
    }
    bench_batch_stop(bm, 100000);
    bench_report(bm);

    _agnostic_bench_route("route_first_health", "/health");
    _agnostic_bench_route("route_last_ui_plugin", "/ui/plugins/swarm");
    _agnostic_bench_route("route_miss_404", "/no/such/route");
    return 0;
}

# Prefixed: a bench binary links all of lib/, which exports ~180 unprefixed
# names. A bare `r` here is a global in Cyrius's single flat namespace and
# last-definition-wins would apply silently. No collision exists today —
# lib/ declares no single-letter globals — but the dep set is about to grow.
var _agnostic_bench_exit_code = main();
sys_exit_group(_agnostic_bench_exit_code);
