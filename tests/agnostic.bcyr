# agnostic benchmarks
# Stdlib auto-included via cyrius.cyml
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report.
# For sub-1us ops use batch_size >= 1000 to amortize clock_gettime overhead
# (~240 ns per start/stop pair on x86_64 Linux). See lib/bench.cyr header for
# the full overhead-vs-batching guidance.

# The whole program (0.1.7), for the route table below. It includes the store and
# audit locks (0.1.4) the rlock benches use, so they need no include of their own.
include "src/app.cyr"
include "tests/support/tmp.cyr"   # scratch paths under $TMPDIR (0.1.15)

fn bench_noop(): i64 { return 0; }

# The route table is a flat scan in table order — `src/http/router.cyr` says why it
# is not indexed, and asks every change that adds a route to re-measure rather than
# inherit that sentence. These are the measurement: the first entry, the last, and a
# miss, which tries every pattern before answering 404.
#
# One 8 MiB arena serves all 100,000 resolutions: a resolution takes at most 64 bytes
# of it (the two-capture path, measured at 0.1.8), so the run never spills.
fn _agnostic_bench_route(name, path): i64 {
    var a = arena_allocator(8388608);
    var p = str_from(path);
    var b = bench_new(name);
    bench_batch_start(b);
    var i = 0;
    while (i < 100000) {
        agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, p);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);
    return 0;
}

# 0.1.8 — what every socket request now pays for the two transport rules (ADR 0006),
# before any routing: a media-type compare and a loopback-Host compare.
fn _agnostic_bench_guards(): i64 {
    var hits = 0;
    var ct = str_from("application/json; charset=utf-8");
    var bc = bench_new("guard_content_type_json");
    bench_batch_start(bc);
    var i = 0;
    while (i < 1000000) {
        hits = hits + agnostic_content_type_is_json(ct);
        i = i + 1;
    }
    bench_batch_stop(bc, 1000000);
    bench_report(bc);

    var host = str_from("127.0.0.1:8000");
    var bh = bench_new("guard_host_loopback");
    bench_batch_start(bh);
    i = 0;
    while (i < 1000000) {
        hits = hits + agnostic_host_is_loopback(host);
        i = i + 1;
    }
    bench_batch_stop(bh, 1000000);
    bench_report(bh);
    return hits;
}

# 0.1.8 — validating the largest plugin document a PUT may carry (~32 KiB of nested
# objects, numbers, booleans and strings) before it is stored. Allocation-free.
fn _agnostic_bench_json_kind(): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    var k = 0;
    while (k < 600) {
        if (k > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "\"key");
        str_builder_add_int(sb, k);
        str_builder_add_cstr(sb, "\":{\"n\":12.5,\"ok\":true,\"s\":\"the quick brown fox\"}");
        k = k + 1;
    }
    str_builder_add_cstr(sb, "}");
    var doc = str_builder_build(sb);
    var kinds = 0;
    var bj = bench_new("json_kind_32k");
    bench_batch_start(bj);
    var i = 0;
    while (i < 1000) {
        kinds = kinds + agnostic_json_kind(doc);
        i = i + 1;
    }
    bench_batch_stop(bj, 1000);
    bench_report(bj);
    return kinds;
}

# 0.1.9 — what a request the shell made for a plugin pays on the plugin rung (ADR 0007):
# find the plugin, read its switch, and match the route against its grants. The path is a
# crew-events URL, granted by the fourth permission Swarm Command holds, so the match walks
# most of its grant list before it hits.
fn _agnostic_bench_plugin_gate(): i64 {
    agnostic_webgui_init();
    var p = agnostic_plugin_find(str_from("swarm"));
    if (p == 0) { return 0; }
    atomic_store(p + AGNOSTIC_PLUGIN_ENABLED, 1);
    var a = arena_allocator(8388608);
    var pid = str_from("swarm");
    var path = str_from("/api/v1/crews/6ba7b810-9dad-41d1-80b4-00c04fd430c8/events?after=12");
    var refused = 0;
    var bg = bench_new("plugin_gate_granted");
    bench_batch_start(bg);
    var i = 0;
    while (i < 100000) {
        if (agnostic_plugin_gate_a(a, pid, AGNOSTIC_METHOD_GET, path) != 0) { refused = refused + 1; }
        i = i + 1;
        if ((i & 1023) == 0) { reset_via(a); }
    }
    bench_batch_stop(bg, 100000);
    bench_report(bg);
    return refused;
}

# 0.1.9 — what a poll of `GET /crews/{id}/events?after=N` pays to copy events out of the
# ring under the ledger lock: the whole 256-event window (a reader starting at 0) and one
# new event (a reader keeping up).
fn _agnostic_bench_ledger_snapshot(): i64 {
    agnostic_ledger_reset();
    var bus = agnosai_event_bus_new();
    var id = str_from("bench-crew");
    var e = agnostic_ledger_record(id, str_from("bench"), agnosai_event_bus_subscribe(bus, id));
    var tx = agnosai_event_bus_sender(bus, id);
    var k = 0;
    while (k < 256) {
        agnosai_event_sender_send(tx, agnosai_crew_event_new(id, str_from("token"), bayan_json_v_obj_new()));
        k = k + 1;
    }
    agnostic_ledger_drain(e);
    var a = arena_allocator(1048576);
    var n = 0;
    var bw = bench_new("ledger_snapshot_window_256");
    bench_batch_start(bw);
    var i = 0;
    while (i < 10000) {
        n = n + vec_len(agnostic_ledger_snap_events(agnostic_ledger_snapshot_a(a, e, 0)));
        reset_via(a);
        i = i + 1;
    }
    bench_batch_stop(bw, 10000);
    bench_report(bw);
    var b1 = bench_new("ledger_snapshot_one_new");
    bench_batch_start(b1);
    i = 0;
    while (i < 100000) {
        n = n + vec_len(agnostic_ledger_snap_events(agnostic_ledger_snapshot_a(a, e, 255)));
        reset_via(a);
        i = i + 1;
    }
    bench_batch_stop(b1, 100000);
    bench_report(b1);
    return n;
}

# 0.1.10 — what `GET /api/v1/audit/entries` pays to copy a page of 50 entries out of the
# kept ring under the audit lock (ADR 0011), with the ring full: no store read, no global
# allocation, whatever the trail's size.
fn _agnostic_bench_audit_entries(): i64 {
    var path = _tt_tmp_path("bench-audit");
    sys_unlink(path);
    patra_init();
    if (agnostic_audit_open(str_from(path)) == 0) { return 0; }
    var k = 0;
    while (k < AGNOSTIC_AUDIT_RING) {
        agnostic_audit_record(SEV_INFO, AGNOSTIC_AUDIT_SRC, str_from("crew.submit"),
          str_from("crew_id=6ba7b810-9dad-41d1-80b4-00c04fd430c8"));
        k = k + 1;
    }
    var a = arena_allocator(1048576);
    var n = 0;
    var be = bench_new("audit_entries_page_50");
    bench_batch_start(be);
    var i = 0;
    while (i < 10000) {
        n = n + vec_len(agnostic_audit_entries_a(a, AGNOSTIC_AUDIT_RING, 50));
        reset_via(a);
        i = i + 1;
    }
    bench_batch_stop(be, 10000);
    bench_report(be);
    agnostic_audit_close();
    sys_unlink(path);
    return n;
}

# 0.1.13 — what ADR 0013 adds to every crew: the in-flight row written at submit (an indexed
# "already stored?" read, then an INSERT) and deleted with the outcome (a scan of the few live
# rows, then the DELETE). Two fdatasyncs, both under the store lock. ⚠ The store is under
# `$TMPDIR`, else `/tmp` (0.1.15; always `/tmp` before). On tmpfs the fsync half is
# under-reported; on a real disk it dominates — so compare figures from the same filesystem.
fn _agnostic_bench_inflight(): i64 {
    var path = _tt_tmp_path("bench-inflight");
    sys_unlink(path);
    patra_init();
    if (agnostic_store_open(str_from(path)) == 0) { return 0; }
    agnostic_crews_ensure();
    var id = str_from("6ba7b810-9dad-41d1-80b4-00c04fd430c8");
    var scope = str_from("_");
    var name = str_from("bench");
    var mode = str_from("live");
    var proc = str_from("sequential");
    var n = 0;
    var bi = bench_new("crew_inflight_mark_clear");
    bench_batch_start(bi);
    var i = 0;
    while (i < 1000) {
        n = n + agnostic_crews_mark_inflight(id, scope, name, 1000 + i, 3, mode, proc);
        agnostic_store_lock();
        _agnostic_crews_inflight_drop_locked(id);
        agnostic_store_unlock();
        i = i + 1;
    }
    bench_batch_stop(bi, 1000);
    bench_report(bi);
    agnostic_store_close();
    sys_unlink(path);
    return n;
}

# 0.1.16 (ADR 0020): what a request pays for its server span with export on — the child of an
# inbound traceparent, and the record: parse the two contexts, build the span in the request's
# arena, encode it into the exporter's ring. With export off the record costs one load.
#
# The exporter is never started, so nothing drains its ring but this: 200 records per batch
# (the ring holds 256, so none is dropped), drained between batches, outside the timing.
fn _agnostic_bench_server_span(): i64 {
    thread_local_init();
    var a = arena_allocator(1048576);
    var keep = arena_allocator(4096);
    var inbound = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");

    var bc = bench_new("trace_child");
    bench_batch_start(bc);
    var i = 0;
    while (i < 100000) {
        if ((i & 1023) == 0) { reset_via(a); }
        agnostic_trace_child_a(a, inbound);
        i = i + 1;
    }
    bench_batch_stop(bc, 100000);
    bench_report(bc);

    var saved = _agnosai_telemetry_exporter;
    var e = agnosai_otlp_exporter_new(0, str_from("bench"), 3600000);
    _agnosai_telemetry_exporter = e;
    var ring = agnosai_otlp_exporter_ring(e);
    var service = str_from("bench");
    agnostic_trace_set(agnostic_trace_child_a(keep, inbound));
    thread_local_set(AGNOSTIC_TRACE_PARENT_SLOT, inbound);
    var path = str_from("/api/v1/crews/6ba7b810-9dad-41d1-80b4-00c04fd430c8");
    var ctx = agnostic_reqctx_new_a(keep, 0, 0);
    agnostic_reqctx_set_route(ctx, "/api/v1/crews/:id");
    var bs = bench_new("server_span_record");
    var round = 0;
    while (round < 100) {
        agnosai_otlp_ring_drain(ring, service);
        reset_via(a);
        bench_batch_start(bs);
        i = 0;
        while (i < 200) {
            _agnostic_serve_record_span_a(a, AGNOSTIC_METHOD_GET, path, ctx, 200, 1);
            i = i + 1;
        }
        bench_batch_stop(bs, 200);
        round = round + 1;
    }
    bench_report(bs);
    agnosai_otlp_ring_drain(ring, service);
    _agnosai_telemetry_exporter = saved;
    agnostic_trace_clear();
    return 0;
}

# 0.1.17: what decoding an accepted crew body costs — 4 agents, 8 tasks, two of them with
# dependencies. Since 0.1.17 the door checks the whole body in the request's arena before it
# builds anything, so an accepted body is decoded twice; this is the price. The arena is
# rewound each time; what the build keeps on the global heap is the engine's to keep.
fn _agnostic_bench_crew_decode(): i64 {
    var a = arena_allocator(1048576);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"bench\",\"process\":\"dag\",\"agents\":[");
    var i = 0;
    while (i < 4) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"key\":\"agent-");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, "\",\"role\":\"tester\",\"goal\":\"find the bugs\",\"complexity\":\"medium\"");
        str_builder_add_cstr(sb, ",\"tools\":[\"k6\",\"playwright\"]}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"tasks\":[");
    i = 0;
    while (i < 8) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"description\":\"run the suite and report what failed\"");
        if (i >= 6) { str_builder_add_cstr(sb, ",\"dependencies\":[0,1]"); }
        str_builder_add_cstr(sb, "}");
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]}");
    var body = str_builder_build(sb);
    var v = bayan_json_v_parse_buf(str_data(body), str_len(body));
    var rj: i64[1];
    var ok = 0;
    var b = bench_new("crew_decode_4a_8t");
    bench_batch_start(b);
    i = 0;
    while (i < 2000) {
        reset_via(a);
        store64(&rj, 0);
        if (agnostic_crew_req_from_value_a(a, v, &rj) != 0) { ok = ok + 1; }
        i = i + 1;
    }
    bench_batch_stop(b, 2000);
    bench_report(b);

    # What the row above leaves out: it decodes a value parsed once, outside its loop, so a change to
    # bayan's parser cannot show there. Every JSON write route pays this first.
    var p = bench_new("json_parse_crew_4a_8t");
    bench_batch_start(p);
    i = 0;
    while (i < 2000) {
        reset_via(a);
        if (bayan_json_v_parse_buf_a(a, str_data(body), str_len(body)) != 0) { ok = ok + 1; }
        i = i + 1;
    }
    bench_batch_stop(p, 2000);
    bench_report(p);
    return ok;
}

# One listing row. `GET /crews` asks this of every crew the ledger holds, and until 0.2.2 each one
# built a JSON object to read two integers from.
fn _agnostic_bench_ledger_row(): i64 {
    var a = arena_allocator(1048576);
    var e = agnostic_ledger_record(str_from("bench-row"), str_from("bench"), 0);
    var b = bench_new("ledger_row");
    bench_batch_start(b);
    var i = 0;
    while (i < 100000) {
        if ((i & 1023) == 0) { reset_via(a); }
        agnostic_ledger_row_a(a, e);
        i = i + 1;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);
    return 0;
}

# Rendering a 64 KB response. bayan's builder takes about three times its output in the arena, so
# this is the row that says what a large response asks of a worker.
fn _agnostic_bench_json_build(): i64 {
    var a = arena_allocator_growable(65536);
    var arr = bayan_json_v_arr_new();
    var item = str_from("a string of about one hundred bytes, which is what a crew's listing row comes to, more or less");
    var i = 0;
    while (i < 640) {
        bayan_json_v_arr_push(arr, bayan_json_v_str_new(item));
        i = i + 1;
    }
    var b = bench_new("json_build_64k");
    bench_batch_start(b);
    i = 0;
    while (i < 1000) {
        reset_via(a);
        bayan_json_v_build_a(a, arr);
        i = i + 1;
    }
    bench_batch_stop(b, 1000);
    bench_report(b);
    return 0;
}

# 0.2.3 — a crew id, the same shape the engine mints: `6ba7b810-9dad-41d1-80b4-` and twelve
# hex digits of `n`.
fn _agnostic_bench_id_a(a, n): i64 {
    var buf = alloc_via(a, 37);
    memcpy(buf, "6ba7b810-9dad-41d1-80b4-", 24);
    var i = 0;
    while (i < 12) {
        store8(buf + 35 - i, load8("0123456789abcdef" + ((n >> (i * 4)) & 15)));
        i = i + 1;
    }
    store8(buf + 36, 0);
    return str_new_a(a, buf, 36);
}

# A finished crew's listing row, for `_agnostic_bench_store_crews`.
fn _agnostic_bench_row_a(a, n): i64 {
    var row = agnostic_crew_row_new_a(a);
    agnostic_crew_row_set(row, AGNOSTIC_CR_CREW_ID, _agnostic_bench_id_a(a, n));
    agnostic_crew_row_set(row, AGNOSTIC_CR_SCOPE, str_from_a(a, "_"));
    agnostic_crew_row_set(row, AGNOSTIC_CR_NAME, str_from_a(a, "bench"));
    agnostic_crew_row_set(row, AGNOSTIC_CR_STATUS, AGNOSTIC_CREW_COMPLETED);
    agnostic_crew_row_set(row, AGNOSTIC_CR_SUBMITTED, 1700000000000 + n);
    agnostic_crew_row_set(row, AGNOSTIC_CR_STARTED, 1700000000001 + n);
    agnostic_crew_row_set(row, AGNOSTIC_CR_FINISHED, 1700000000002 + n);
    agnostic_crew_row_set(row, AGNOSTIC_CR_NTASKS, 1);
    agnostic_crew_row_set(row, AGNOSTIC_CR_MODE, str_from_a(a, "placeholder"));
    return row;
}

# `count` finished crews in scope `_`, written in BATCH mode: seeding at the 11.5 ms a row
# costs for real would spend minutes before the first measurement.
fn _agnostic_bench_store_crews(count, doc: Str): i64 {
    var db = agnostic_store_db();
    patra_set_sync_mode(db, PATRA_SYNC_BATCH);
    var a = arena_allocator(1048576);
    var i = 0;
    while (i < count) {
        agnostic_crews_save_row(_agnostic_bench_row_a(a, i), doc);
        reset_via(a);
        i = i + 1;
    }
    patra_set_sync_mode(db, PATRA_SYNC_FULL);
    return count;
}

# 0.2.3 — the audit's P4 and P5. What one page of `GET /api/v1/crews` costs over 10,000
# durable crews, what a stored crew costs to read, and what one finished crew costs to
# write (11.5 ms on a real disk; `_agnostic_bench_inflight` says why tmpfs reads lower).
fn _agnostic_bench_crews(): i64 {
    var path = _tt_tmp_path("bench-crews");
    sys_unlink(path);
    patra_init();
    if (agnostic_store_open(str_from(path)) == 0) { return 0; }
    agnostic_crews_ensure();
    _agnostic_bench_store_crews(10000, str_from("{\"status\":\"completed\",\"scope\":\"_\"}"));

    var ctx_a = arena_allocator(65536);
    var ctx = agnostic_reqctx_new_a(ctx_a, 0, 0);
    var a = arena_allocator(67108864);
    var list = str_from("/api/v1/crews?limit=50");
    var n = 0;
    var bl = bench_new("crews_list_10k");
    bench_batch_start(bl);
    var i = 0;
    while (i < 50) {
        if (agnostic_route_crews_list_a(a, list, ctx) != 0) { n = n + 1; }
        reset_via(a);
        i = i + 1;
    }
    bench_batch_stop(bl, 50);
    bench_report(bl);

    # A document the audit's size, 422 KB: forty tasks of about 10 KB each.
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"crew_id\":\"x\",\"status\":\"completed\",\"results\":[");
    var t = 0;
    while (t < 40) {
        if (t > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "{\"task_id\":\"t\",\"status\":\"completed\",\"output\":\"");
        var c = 0;
        while (c < 1050) { str_builder_add_cstr(sb, "0123456789"); c = c + 1; }
        str_builder_add_cstr(sb, "\"}");
        t = t + 1;
    }
    str_builder_add_cstr(sb, "],\"scope\":\"_\"}");
    var big = str_builder_build(sb);
    var seed = arena_allocator(1048576);
    var row = _agnostic_bench_row_a(seed, 20000);
    agnostic_crews_save_row(row, big);
    var id = agnostic_crew_row_get(row, AGNOSTIC_CR_CREW_ID);
    var bg = bench_new("crew_get_stored_422k");
    bench_batch_start(bg);
    var j = 0;
    while (j < 200) {
        if (agnostic_route_crew_get_a(a, id, ctx) != 0) { n = n + 1; }
        reset_via(a);
        j = j + 1;
    }
    bench_batch_stop(bg, 200);
    bench_report(bg);

    var doc = str_from("{\"status\":\"completed\",\"scope\":\"_\"}");
    var bs = bench_new("crew_save_row");
    bench_batch_start(bs);
    var k = 0;
    while (k < 200) {
        n = n + agnostic_crews_save_row(_agnostic_bench_row_a(seed, 30000 + k), doc);
        reset_via(seed);
        k = k + 1;
    }
    bench_batch_stop(bs, 200);
    bench_report(bs);
    agnostic_store_close();
    sys_unlink(path);
    return n;
}

# 0.2.3 — the audit's two credential paths: 109 and 153 µs before 0.2.2 made each one
# statement. Both read the store, so a slow one is store-lock time for everybody.
fn _agnostic_bench_authn(): i64 {
    var path = _tt_tmp_path("bench-authn");
    sys_unlink(path);
    patra_init();
    if (agnostic_store_open(str_from(path)) == 0) { return 0; }
    agnostic_auth_ensure();
    agnostic_argon_pool_init();
    var k = alloc(32);
    memset(k, 7, 32);
    agnostic_jwt_set_secret(k, 32);
    var seed = arena_allocator(1048576);
    var uid = agnostic_users_create_a(seed, str_from("bench@example.com"),
      str_from("bench-password"), AGNOSTIC_ROLE_ADMIN, str_from("acme"));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Bearer ");
    str_builder_add(sb, agnostic_jwt_issue_a(seed, uid, AGNOSTIC_ROLE_ADMIN, str_from("acme"), 86400));
    var bearer = str_builder_build(sb);
    var sk = str_builder_new();
    str_builder_add_cstr(sk, "ApiKey ");
    str_builder_add(sk, agnostic_apikey_issue_a(seed, uid, str_from("bench")));
    var apikey = str_builder_build(sk);
    var a = arena_allocator(1048576);
    var n = 0;
    var bb = bench_new("authn_bearer");
    bench_batch_start(bb);
    var i = 0;
    while (i < 5000) {
        if (agnostic_authn_resolve_a(a, bearer) != 0) { n = n + 1; }
        reset_via(a);
        i = i + 1;
    }
    bench_batch_stop(bb, 5000);
    bench_report(bb);
    var bk = bench_new("authn_apikey");
    bench_batch_start(bk);
    var j = 0;
    while (j < 5000) {
        if (agnostic_authn_resolve_a(a, apikey) != 0) { n = n + 1; }
        reset_via(a);
        j = j + 1;
    }
    bench_batch_stop(bk, 5000);
    bench_report(bk);
    agnostic_store_close();
    sys_unlink(path);
    return n;
}

# 0.2.3 — the audit's P3: a start reads and verifies the whole trail. 589 B and about 16 µs
# per entry, for the life of the process.
# What an administrator's listing costs at 1,000 users, under the store lock, and one user by id
# (0.3.0). Rows go in directly: an Argon2 each would make this a benchmark of that.
fn _agnostic_bench_identity(): i64 {
    var path = _tt_tmp_path("bench-identity");
    sys_unlink(path);
    patra_init();
    if (agnostic_store_open(str_from(path)) == 0) { return 0; }
    agnostic_auth_ensure();
    var a = arena_allocator(8388608);
    var rec = agnostic_auth_decoy_record_a(a);
    agnostic_store_lock();
    patra_set_sync_mode(agnostic_store_db(), PATRA_SYNC_BATCH);
    agnostic_store_unlock();
    var i = 0;
    var uid = 0;
    while (i < 1000) {
        var sb = str_builder_new_a(a);
        str_builder_add_cstr_a(a, sb, "user-");
        str_builder_add_int_a(a, sb, i);
        str_builder_add_cstr_a(a, sb, "@example.com");
        var email = str_builder_build_a(a, sb);
        uid = agnostic_users_uid_a(a, email);
        agnostic_store_lock();
        _agnostic_users_insert_locked_a(a, uid, email, rec, AGNOSTIC_ROLE_VIEWER, str_from_a(a, "acme"));
        agnostic_store_unlock();
        i = i + 1;
    }
    agnostic_store_lock();
    patra_set_sync_mode(agnostic_store_db(), PATRA_SYNC_FULL);
    agnostic_store_unlock();
    var n = 0;
    var bl = bench_new("users_list_1k");
    bench_batch_start(bl);
    var j = 0;
    while (j < 20) {
        reset_via(a);
        n = n + vec_len(agnostic_users_list_a(a, str_from_a(a, "acme")));
        j = j + 1;
    }
    bench_batch_stop(bl, 20);
    bench_report(bl);
    var bg = bench_new("user_get");
    bench_batch_start(bg);
    var k = 0;
    while (k < 5000) {
        if (agnostic_users_get_a(a, uid) != 0) { n = n + 1; }
        reset_via(a);
        k = k + 1;
    }
    bench_batch_stop(bg, 5000);
    bench_report(bg);
    agnostic_store_close();
    sys_unlink(path);
    return n;
}

fn _agnostic_bench_audit_open(): i64 {
    var path = _tt_tmp_path("bench-audit-open");
    var p = str_from(path);
    sys_unlink(path);
    patra_init();
    if (agnostic_audit_open(p) == 0) { return 0; }
    patrastore_set_sync_mode(_agnostic_audit_store, PATRA_SYNC_BATCH);
    var k = 0;
    while (k < 10000) {
        agnostic_audit_record(SEV_INFO, AGNOSTIC_AUDIT_SRC, str_from("crew.submit"),
          str_from("crew_id=6ba7b810-9dad-41d1-80b4-00c04fd430c8"));
        k = k + 1;
    }
    agnostic_audit_close();
    var n = 0;
    var bo = bench_new("audit_open_10k");
    bench_batch_start(bo);
    var i = 0;
    while (i < 5) {
        n = n + agnostic_audit_open(p);
        agnostic_audit_close();
        i = i + 1;
    }
    bench_batch_stop(bo, 5);
    bench_report(bo);
    sys_unlink(path);
    return n;
}

# 0.2.3 — the whole serve adapter on `/health`, over a socketpair, with the same request
# arena a worker would have. The pair's own cost is in the figure.
fn _agnostic_bench_serve_handler(): i64 {
    var req = "GET /health HTTP/1.1\r\nHost: localhost\r\n\r\n";
    var len = strlen(req);
    var n = 0;
    var arena = arena_allocator(AGNOSTIC_SERVE_ARENA_BYTES);
    _sandhi_req_arena_slot = thread_local_alloc();
    thread_local_set(_sandhi_req_arena_slot, arena);
    var bh = bench_new("serve_handler_health");
    bench_batch_start(bh);
    var i = 0;
    while (i < 20000) {
        var fds: i64[1];
        store64(&fds, 0);
        if (sys_socketpair(1, SOCK_STREAM, 0, &fds) == 0) {
            var server_fd = load32(&fds);
            var client_fd = load32(&fds + 4);
            reset_via(arena);
            agnostic_serve_handler(0, server_fd, req, len);
            var buf[1024];
            n = n + sys_read(client_fd, &buf, 1023);
            sys_close(server_fd);
            sys_close(client_fd);
        }
        i = i + 1;
    }
    bench_batch_stop(bh, 20000);
    bench_report(bh);
    return n;
}

fn main(): i64 {
    alloc_init();
    var b = bench_new("noop");
    bench_batch_start(b);
    var i = 0;
    while (i < 1000000) { bench_noop(); i = i + 1; }
    bench_batch_stop(b, 1000000);
    bench_report(b);

    # What every store operation now pays before it touches patra: one
    # uncontended enter/exit pair. Two `gettid` syscalls plus one CAS each way.
    var l = agnostic_rlock_new();
    var br = bench_new("rlock_enter_exit");
    bench_batch_start(br);
    i = 0;
    while (i < 100000) {
        agnostic_rlock_enter(l);
        agnostic_rlock_exit(l);
        i = i + 1;
    }
    bench_batch_stop(br, 100000);
    bench_report(br);

    # A composed operation re-entering a lock it already holds.
    agnostic_rlock_enter(l);
    var bn = bench_new("rlock_reenter_nested");
    bench_batch_start(bn);
    i = 0;
    while (i < 100000) {
        agnostic_rlock_enter(l);
        agnostic_rlock_exit(l);
        i = i + 1;
    }
    bench_batch_stop(bn, 100000);
    bench_report(bn);
    agnostic_rlock_exit(l);

    # The stdlib mutex it is built on, for scale.
    var m = mutex_new();
    var bm = bench_new("mutex_lock_unlock");
    bench_batch_start(bm);
    i = 0;
    while (i < 100000) {
        mutex_lock(m);
        mutex_unlock(m);
        i = i + 1;
    }
    bench_batch_stop(bm, 100000);
    bench_report(bm);

    _agnostic_bench_route("route_first_health", "/health");
    _agnostic_bench_route("route_last_ui_plugin", "/ui/plugins/swarm");
    _agnostic_bench_route("route_miss_404", "/no/such/route");
    # The one two-capture pattern (0.1.8), just before the `/ui` entries at the table's end.
    _agnostic_bench_route("route_plugindata_doc", "/api/v1/plugins/swarm/data/swarm-abc123");
    _agnostic_bench_guards();
    _agnostic_bench_json_kind();
    _agnostic_bench_plugin_gate();
    _agnostic_bench_ledger_snapshot();
    _agnostic_bench_audit_entries();
    _agnostic_bench_inflight();
    _agnostic_bench_server_span();
    _agnostic_bench_crew_decode();
    _agnostic_bench_ledger_row();
    _agnostic_bench_json_build();
    _agnostic_bench_crews();
    _agnostic_bench_authn();
    _agnostic_bench_identity();
    _agnostic_bench_audit_open();
    _agnostic_bench_serve_handler();
    return 0;
}

# Prefixed: a bench binary links all of lib/, which exports ~180 unprefixed
# names. A bare `r` here is a global in Cyrius's single flat namespace and
# last-definition-wins would apply silently. No collision exists today —
# lib/ declares no single-letter globals — but the dep set is about to grow.
var _agnostic_bench_exit_code = main();
sys_exit_group(_agnostic_bench_exit_code);
