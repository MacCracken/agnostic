# agnostic/routes/crews — the crew surface end to end.
#
# Covers the route table, the status contract, and the two behaviours
# ORACLE-AUDIT.md §3.2 and §3.5 got wrong: a cancel that addresses an id the
# engine never saw, and a cancel that relabels a record instead of stopping work.
# The whole program, in its canonical order — see src/app.cyr for why this is
# one include rather than a list every suite has to keep in step.
include "src/app.cyr"

var _T_BODY = "{\"name\":\"sweep\",\"agents\":[{\"key\":\"a1\",\"role\":\"tester\",\"goal\":\"find bugs\"}],\"tasks\":[{\"description\":\"run the suite\"}]}";

fn _t_status(a, method, path, body): i64 {
    return agnostic_response_status(
      agnostic_route_dispatch_a(a, method, str_from(path), str_from(body), 1048576, 0));
}

# `_t_status` for a path already built as a `Str`.
fn _t_status_s(a, method, path): i64 {
    return agnostic_response_status(
      agnostic_route_dispatch_a(a, method, path, str_from(""), 1048576, 0));
}

fn _t_json(a, method, path, body): i64 {
    return agnostic_response_body(
      agnostic_route_dispatch_a(a, method, str_from(path), str_from(body), 1048576, 0));
}

fn test_route_table() {
    test_group("crews/table");

    var a = arena_allocator(65536);

    var m = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"));
    assert_eq(agnostic_route_match_id(m), AGNOSTIC_ROUTE_CREW_SUBMIT, "POST /api/v1/crews");

    var g = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET,
      str_from("/api/v1/crews/6ba7b810-9dad-11d1-80b4-00c04fd430c8"));
    assert_eq(agnostic_route_match_id(g), AGNOSTIC_ROUTE_CREW_GET, "GET /api/v1/crews/{id}");
    assert_eq(str_eq_cstr(agnostic_route_match_param(g), "6ba7b810-9dad-11d1-80b4-00c04fd430c8"), 1,
      "the id is captured");

    var c = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews/abc/cancel"));
    assert_eq(agnostic_route_match_id(c), AGNOSTIC_ROUTE_CREW_CANCEL, "POST /api/v1/crews/{id}/cancel");
    assert_eq(str_eq_cstr(agnostic_route_match_param(c), "abc"), 1, "captured across a trailing segment");

    var e = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/crews/abc/events"));
    assert_eq(agnostic_route_match_id(e), AGNOSTIC_ROUTE_CREW_EVENTS, "GET /api/v1/crews/{id}/events");

    # A query string must not stop the match — otherwise a cache-buster 404s.
    var q = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/crews/abc?t=1"));
    assert_eq(agnostic_route_match_id(q), AGNOSTIC_ROUTE_CREW_GET, "a query string is stripped");

    # Every crew route is privileged; only the probes are public.
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_CREW_SUBMIT), 1, "submit needs auth");
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_CREW_GET), 1, "poll needs auth");
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_CREW_CANCEL), 1, "cancel needs auth");
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_CREW_EVENTS), 1, "events needs auth");
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_HEALTH), 0, "health stays public");
}

fn test_method_mismatch_is_405() {
    test_group("crews/405");

    var a = arena_allocator(65536);

    # ⚠ A method the collection does not take earns a 405 naming the mismatch rather
    # than a 404 claiming the collection does not exist. `GET` was that example until
    # 0.1.9, when the listing arrived; `DELETE` is now.
    assert_eq(_t_status(a, AGNOSTIC_METHOD_DELETE, "/api/v1/crews", ""), HTTP_METHOD_NOT_ALLOWED,
      "DELETE on the collection is 405, not 404");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_GET, "/api/v1/crews", ""), HTTP_OK,
      "and GET on it is the listing (0.1.9)");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_DELETE, "/api/v1/crews/abc", ""), HTTP_METHOD_NOT_ALLOWED,
      "DELETE on a crew is 405");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_GET, "/api/v1/crews/abc/cancel", ""), HTTP_METHOD_NOT_ALLOWED,
      "GET on cancel is 405");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_GET, "/api/v1/nope", ""), HTTP_NOT_FOUND,
      "an unknown path is still 404");
}

fn test_malformed_id_is_422() {
    test_group("crews/bad-id");

    var a = arena_allocator(65536);
    agnostic_engine_reset();

    # A malformed id is a 422, not a 404 — the client's id is wrong, which is a
    # different fact from the crew not existing.
    assert_eq(_t_status(a, AGNOSTIC_METHOD_GET, "/api/v1/crews/not-a-uuid", ""),
      AGNOSTIC_HTTP_UNPROCESSABLE, "poll with a malformed id is 422");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_POST, "/api/v1/crews/not-a-uuid/cancel", ""),
      AGNOSTIC_HTTP_UNPROCESSABLE, "cancel with a malformed id is 422");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_GET, "/api/v1/crews/not-a-uuid/events", ""),
      AGNOSTIC_HTTP_UNPROCESSABLE, "events with a malformed id is 422");

    # Well-formed but unknown is 404.
    assert_eq(_t_status(a, AGNOSTIC_METHOD_GET, "/api/v1/crews/6ba7b810-9dad-11d1-80b4-00c04fd430c8", ""),
      HTTP_NOT_FOUND, "a well-formed id we never submitted is 404");
}

fn test_uppercase_id_is_normalised() {
    test_group("crews/id-case");

    var a = arena_allocator(65536);
    agnostic_engine_reset();

    # ⚠ Both registries are keyed by the canonical LOWERCASE form. Validating an
    # id without normalising it is a silent 404 on a perfectly valid uppercase
    # id — the engine has its own scar from exactly this.
    var lower = str_from("6ba7b810-9dad-11d1-80b4-00c04fd430c8");
    var upper = str_from("6BA7B810-9DAD-11D1-80B4-00C04FD430C8");

    assert_eq(str_eq(_agnostic_crew_key_a(a, lower), lower), 1, "a lowercase id passes through unallocated");
    assert_eq(str_eq(_agnostic_crew_key_a(a, upper), lower), 1, "an uppercase id folds to the canonical form");
    assert_eq(_agnostic_crew_key_a(a, str_from("nope")), 0, "a malformed id is refused");

    agnostic_ledger_reset();
    agnostic_ledger_record(lower, str_from("c"), 0);
    assert_neq(agnostic_ledger_entry(_agnostic_crew_key_a(a, upper)), 0,
      "so an uppercase id finds the crew it names");
}

fn test_engine_down_is_503() {
    test_group("crews/no-engine");

    var a = arena_allocator(262144);
    agnostic_engine_reset();

    # ⚠ 503, not 500. The request was fine; the server cannot serve it right now.
    assert_eq(_t_status(a, AGNOSTIC_METHOD_POST, "/api/v1/crews", _T_BODY), HTTP_SERVICE_UNAVAILABLE,
      "submitting with no engine is 503");
    assert_eq(agnostic_engine_is_ready(), 0, "and readiness says so");
}

fn test_submit_rejections() {
    test_group("crews/reject");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_engine_init(agnostic_config_from_env());

    assert_eq(_t_status(a, AGNOSTIC_METHOD_POST, "/api/v1/crews", "not json"), HTTP_BAD_REQUEST,
      "a non-JSON body is 400");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_POST, "/api/v1/crews", "{}"), HTTP_BAD_REQUEST,
      "an empty object is 400");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_POST, "/api/v1/crews",
        "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}],\"extra\":1}"),
      AGNOSTIC_HTTP_UNPROCESSABLE, "an unknown field is 422");

    # Body-size rejection happens BEFORE routing, so an oversized body to a real
    # path is a 413 rather than being parsed to discover where it goes.
    assert_eq(agnostic_response_status(
        agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
          str_from(_T_BODY), 4, 0)), HTTP_PAYLOAD_TOO_LARGE, "an oversized body is 413");
}

fn test_submit_accepts_with_202() {
    test_group("crews/submit");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    # ⚠ 202, not 200 and not 201. The crew has been accepted and is not finished,
    # which is exactly what 202 means. The engine's own route returns 200 because
    # it runs the crew inline — the shape this tier exists not to inherit.
    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    assert_eq(agnostic_response_status(resp), AGNOSTIC_HTTP_ACCEPTED, "a valid submission is 202");

    var body = agnostic_response_body(resp);
    var id = agnostic_req_str(body, AGNOSTIC_JK_CREW_ID);
    assert_neq(id, 0, "the response carries a crew id");
    assert_eq(agnosai_uuid_is_valid(id), 1, "and it is the engine's UUID");
    assert_eq(str_eq_cstr(agnostic_req_str(body, AGNOSTIC_JK_NAME), "sweep"), 1, "and the crew name");

    # ⚠ ORACLE-AUDIT.md §3.2's precondition, asserted: the id we hand back is the
    # one the ENGINE assigned, so it addresses the crew the engine is running.
    # The oracle discarded that id and later cancelled a local UUID instead.
    assert_neq(agnostic_ledger_entry(id), 0, "the ledger holds the engine's id");

    # The placeholder disclosure. With no AGNOSTIC_LLM_URL the engine echoes task
    # descriptions back as output with status COMPLETED, and nothing in the
    # results can tell that from real work — so the mode is on the response.
    assert_eq(str_eq_cstr(agnostic_req_str(body, AGNOSTIC_JK_MODE), "placeholder"), 1,
      "a placeholder-mode engine says so on accept");
}

fn test_poll_reports_a_real_outcome() {
    test_group("crews/poll");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    var id = agnostic_req_str(agnostic_response_body(resp), AGNOSTIC_JK_CREW_ID);

    var path = str_builder_new();
    str_builder_add_cstr(path, "/api/v1/crews/");
    str_builder_add(path, id);
    var url = str_builder_build(path);

    # The crew runs on a detached thread. Placeholder tasks finish in
    # microseconds, but the poll must not depend on that — bounded wait, and the
    # assertions below hold whether it finished or not.
    var tries = 0;
    var status = AGNOSTIC_CREW_PENDING;
    while (tries < 100) {
        var r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, url, str_from(""), 1048576, 0);
        assert_eq(agnostic_response_status(r), HTTP_OK, "polling a submitted crew is 200");
        status = agnostic_crew_status_from_engine(
          agnosai_crew_status_from_wire(agnostic_req_str(agnostic_response_body(r), AGNOSTIC_JK_STATUS)));
        if (agnostic_status_is_terminal(status) == 1) { break; }
        sleep_ms(10);
        tries = tries + 1;
    }

    assert_eq(agnostic_status_is_terminal(status), 1, "the crew reached a terminal state");

    # ⭐ And it is COMPLETED, not the vacuous success §3.1 produced. A crew that
    # really ran its one task reports one result; the normalisation would have
    # demoted it to FAILED had the result set been empty.
    assert_eq(status, AGNOSTIC_CREW_COMPLETED, "a real one-task crew completes");

    var final = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, url, str_from(""), 1048576, 0);
    var fb = agnostic_response_body(final);
    var count = bayan_json_v_obj_get_by_str(fb, AGNOSTIC_JK_TASK_COUNT);
    assert_eq(bayan_json_v_int(count), 1, "carrying its one task result");
    assert_eq(bayan_json_v_obj_get_by_str(fb, AGNOSTIC_JK_ERROR), 0, "and no error");
    assert_eq(str_eq_cstr(agnostic_req_str(fb, AGNOSTIC_JK_MODE), "placeholder"), 1,
      "with the engine mode disclosed on every poll");
}

fn test_cancel_never_relabels_what_it_did_not_cancel() {
    test_group("crews/cancel");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    # ⭐ ORACLE-AUDIT.md §3.2, IN ONE ASSERTION.
    #
    # The oracle POSTed a local UUID AgnosAI had never seen, got a 404, DISCARDED
    # it, and marked its own record cancelled while the crew kept running. An id
    # we never submitted must be a 404 — and must relabel nothing.
    assert_eq(agnostic_crew_cancel(str_from("6ba7b810-9dad-11d1-80b4-00c04fd430c8")),
      AGNOSTIC_CANCEL_NOT_SUBMITTED, "cancelling an unknown id reports not-submitted");
    assert_eq(_t_status(a, AGNOSTIC_METHOD_POST,
        "/api/v1/crews/6ba7b810-9dad-11d1-80b4-00c04fd430c8/cancel", ""), HTTP_NOT_FOUND,
      "and the route answers 404");

    # ⭐ ORACLE-AUDIT.md §3.4 / §3.5: a finished crew is NOT relabelled. The
    # oracle's background task later rewrote `cancelled` back to `completed`;
    # here the terminal state is refused a cancel outright.
    var e = agnostic_ledger_record(str_from("11111111-1111-1111-1111-111111111111"),
      str_from("done"), 0);
    agnostic_ledger_latch(e, AGNOSTIC_CREW_COMPLETED, 0, 0);

    assert_eq(agnostic_crew_cancel(str_from("11111111-1111-1111-1111-111111111111")),
      AGNOSTIC_CANCEL_ALREADY_TERMINAL, "cancelling a finished crew is refused");
    assert_eq(agnostic_ledger_status(e), AGNOSTIC_CREW_COMPLETED,
      "and its recorded outcome is UNCHANGED — not relabelled cancelled");

    assert_eq(_t_status(a, AGNOSTIC_METHOD_POST,
        "/api/v1/crews/11111111-1111-1111-1111-111111111111/cancel", ""), AGNOSTIC_HTTP_CONFLICT,
      "the route answers 409, not a 200 claiming it cancelled something");
}

fn test_cancel_a_live_crew_stops_it() {
    test_group("crews/cancel-live");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    # A crew the engine genuinely knows. Whether it has already finished by the
    # time we cancel is a race, so both answers are legitimate — what must NOT
    # happen is a success reported for a cancel that did nothing.
    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    var id = agnostic_req_str(agnostic_response_body(resp), AGNOSTIC_JK_CREW_ID);

    var rc = agnostic_crew_cancel(id);
    var ok = 0;
    if (rc == AGNOSTIC_CANCEL_OK) { ok = 1; }
    if (rc == AGNOSTIC_CANCEL_ALREADY_TERMINAL) { ok = 1; }
    assert_eq(ok, 1, "cancelling a known crew either cancels it or reports it already finished");

    # Whichever arm ran, the ledger is terminal and stays terminal.
    var e = agnostic_ledger_entry(id);
    assert_eq(agnostic_status_is_terminal(agnostic_ledger_status(e)), 1, "the crew is terminal");
    var was = agnostic_ledger_status(e);
    agnostic_crew_cancel(id);
    assert_eq(agnostic_ledger_status(e), was, "a second cancel changes nothing");
}

fn test_events_route() {
    test_group("crews/events");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    var id = agnostic_req_str(agnostic_response_body(resp), AGNOSTIC_JK_CREW_ID);

    var path = str_builder_new();
    str_builder_add_cstr(path, "/api/v1/crews/");
    str_builder_add(path, id);
    str_builder_add_cstr(path, "/events");

    var r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_builder_build(path),
      str_from(""), 1048576, 0);
    assert_eq(agnostic_response_status(r), HTTP_OK, "the events route answers 200");

    var body = agnostic_response_body(r);
    var events = bayan_json_v_obj_get_by_str(body, AGNOSTIC_JK_EVENTS);
    assert_neq(events, 0, "events is always present");
    assert_eq(bayan_json_v_is_arr(events), 1, "as an array");

    # ⚠ `dropped_events` is always present. The bus is lossy under back-pressure
    # and the retained window is capped, so a client is told the sequence may
    # have gaps rather than shown a suspiciously tidy one.
    var dropped = bayan_json_v_obj_get_by_str(body, AGNOSTIC_JK_DROPPED);
    assert_neq(dropped, 0, "dropped_events is always reported");
    assert_eq(bayan_json_v_int(dropped) >= 0, 1, "as a count");
}

# ⭐ The status the events route reports is CURRENT. It used to be the ledger's
# latch, which only `GET /crews/{id}` refreshed — so a client polling events alone
# (the swarm plugin's live view, 0.1.8) saw `pending` for a crew long finished.
fn test_events_route_status_is_current() {
    test_group("crews/events-status");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    var id = agnostic_req_str(agnostic_response_body(resp), AGNOSTIC_JK_CREW_ID);
    var path = str_builder_new();
    str_builder_add_cstr(path, "/api/v1/crews/");
    str_builder_add(path, id);
    str_builder_add_cstr(path, "/events");
    var url = str_builder_build(path);

    # Bounded wait, polling ONLY the events route — never `GET /crews/{id}`.
    var tries = 0;
    var body = 0;
    var done = 0;
    while (tries < 100) {
        var r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, url, str_from(""), 1048576, 0);
        body = agnostic_response_body(r);
        if (str_eq_cstr(agnostic_req_str(body, AGNOSTIC_JK_STATUS), "completed") == 1) {
            done = 1;
            break;
        }
        sleep_ms(10);
        tries = tries + 1;
    }
    assert_eq(done, 1, "polling the events route alone sees the crew complete");

    # And the snapshot that says so is whole: the closing event is in it.
    var events = bayan_json_v_obj_get_by_str(body, AGNOSTIC_JK_EVENTS);
    var n = bayan_json_v_arr_len(events);
    assert_eq(n > 0, 1, "the completed crew's events are there");
    var last = bayan_json_v_arr_get(events, n - 1);
    assert_eq(str_eq_cstr(agnostic_req_str(last, AGNOSTIC_JK_TYPE), "crew_completed"), 1,
      "ending with crew_completed");
}

# The `/events` URL for a crew, with an optional raw query (0 for none).
fn _t_events_url(id, query): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/api/v1/crews/");
    str_builder_add(sb, id);
    str_builder_add_cstr(sb, "/events");
    if (query != 0) {
        str_builder_add_cstr(sb, "?");
        str_builder_add_cstr(sb, query);
    }
    return str_builder_build(sb);
}

# ⭐ `?after=N` is a cursor (0.1.9): every event carries `seq` and `at_ms`, `next` is
# what to send back, and a reader that sends it reads each event exactly once.
fn test_events_cursor() {
    test_group("crews/events-cursor");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    var id = agnostic_req_str(agnostic_response_body(resp), AGNOSTIC_JK_CREW_ID);

    # Read the whole run through the cursor, never asking for an event twice.
    var after = 0;
    var seen = 0;
    var contiguous = 1;
    var first_type = 0;
    var last_type = 0;
    var tries = 0;
    var done = 0;
    while (tries < 200 && done == 0) {
        var q = str_builder_new();
        str_builder_add_cstr(q, "after=");
        str_builder_add_int(q, after);
        var r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
          _t_events_url(id, str_data(str_builder_build(q))), str_from(""), 1048576, 0);
        var body = agnostic_response_body(r);
        var evs = bayan_json_v_obj_get_by_str(body, AGNOSTIC_JK_EVENTS);
        var n = bayan_json_v_arr_len(evs);
        var i = 0;
        while (i < n) {
            var ev = bayan_json_v_arr_get(evs, i);
            var seq = agnostic_req_int(ev, AGNOSTIC_JK_SEQ, 0 - 1);
            if (seq != after + 1) { contiguous = 0; }
            if (agnostic_req_int(ev, AGNOSTIC_JK_AT_MS, 0 - 1) < 0) { contiguous = 0; }
            if (seen == 0) { first_type = agnostic_req_str(ev, AGNOSTIC_JK_TYPE); }
            last_type = agnostic_req_str(ev, AGNOSTIC_JK_TYPE);
            after = seq;
            seen = seen + 1;
            i = i + 1;
        }
        assert_eq(agnostic_req_int(body, AGNOSTIC_JK_NEXT, 0 - 1) == after, 1,
          "next is always the last number read");
        if (str_eq_cstr(agnostic_req_str(body, AGNOSTIC_JK_STATUS), "completed") == 1) { done = 1; }
        else { sleep_ms(10); }
        tries = tries + 1;
    }
    assert_eq(done, 1, "the crew completes while it is read through the cursor");
    assert_eq(contiguous, 1, "every event is numbered one past the last, with a time");
    assert_eq(seen > 2, 1, "and the run produced several");
    assert_eq(str_eq_cstr(first_type, "crew_started"), 1, "the first is crew_started");
    assert_eq(str_eq_cstr(last_type, "crew_completed"), 1, "the last is crew_completed");

    var q2 = str_builder_new();
    str_builder_add_cstr(q2, "after=");
    str_builder_add_int(q2, after);
    var again = agnostic_response_body(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
        _t_events_url(id, str_data(str_builder_build(q2))), str_from(""), 1048576, 0));
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get_by_str(again, AGNOSTIC_JK_EVENTS)), 0,
      "asking again from next reads nothing twice");
    assert_eq(agnostic_req_int(again, AGNOSTIC_JK_MISSED, 0 - 1), 0, "and missed is reported, zero");
    assert_eq(agnostic_req_int(again, AGNOSTIC_JK_LOST, 0 - 1) >= 0, 1, "lost_events is reported");

    var whole = agnostic_response_body(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
        _t_events_url(id, 0), str_from(""), 1048576, 0));
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get_by_str(whole, AGNOSTIC_JK_EVENTS)), seen,
      "without after, the whole window — as before 0.1.9");

    # A cursor is a count; anything else is refused rather than read as 0.
    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_GET, _t_events_url(id, "after=x")),
      AGNOSTIC_HTTP_UNPROCESSABLE, "after=x is 422");
    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_GET, _t_events_url(id, "after=-1")),
      AGNOSTIC_HTTP_UNPROCESSABLE, "after=-1 is 422");
    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_GET, _t_events_url(id, "after=")),
      AGNOSTIC_HTTP_UNPROCESSABLE, "an empty after is 422");
    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_GET, _t_events_url(id, "t=1&after=2")),
      HTTP_OK, "another parameter beside it is fine");
}

# Publish `count` events of `type` for crew `id` on `bus`, numbering their data from `from`.
# A copy of tests/ledger.tcyr's: each suite is its own compile unit.
fn _t_send(bus, id, type, from, count): i64 {
    var tx = agnosai_event_bus_sender(bus, id);
    var i = 0;
    while (i < count) {
        var data = bayan_json_v_obj_new();
        bayan_json_v_obj_set(data, str_from("n"), bayan_json_v_int_new(from + i));
        agnosai_event_sender_send(tx, agnosai_crew_event_new(id, str_from(type), data));
        i = i + 1;
    }
    return count;
}

# `GET .../events?{query}` for `id` in `a`, which is emptied first: the body, or 0 unless 200.
fn _t_events_get(a, id, query): i64 {
    reset_via(a);
    var r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, _t_events_url(id, query),
      str_from(""), 1048576, 0);
    if (agnostic_response_status(r) != HTTP_OK) { return 0; }
    return agnostic_response_body(r);
}

# The `seq` of event `i` in an events body, or -1.
fn _t_seq_at(body, i): i64 {
    var evs = bayan_json_v_obj_get_by_str(body, AGNOSTIC_JK_EVENTS);
    if (i >= bayan_json_v_arr_len(evs)) { return 0 - 1; }
    return agnostic_req_int(bayan_json_v_arr_get(evs, i), AGNOSTIC_JK_SEQ, 0 - 1);
}

# ⭐ H3, over HTTP: a reader whose cursor is older than the 256 events a crew holds is
# TOLD (0.1.9). It gets every event still held, from the oldest, and `missed` counts
# the numbers after its cursor that the ring had already overwritten. The oldest cursor
# still answerable is `events[0].seq`, and `after=0` is everything held. Pinned here
# beside tests/ledger.tcyr's ring tests, which the route only formats.
#
# No engine (reset, not initialised): the refresh only drains, so the crew stays
# `pending` and the test owns every event. 300 are sent in two drained batches of 200
# and 100 — one batch of 300 would overflow the bus's per-subscriber queue and come
# out as `lost_events`, the other kind of gap, not as `missed`.
fn test_events_gap() {
    test_group("crews/events-gap");

    agnostic_engine_reset();
    var a = arena_allocator(1048576);
    var id = str_from("0b1f6c3e-3f7a-4b8e-9d2c-5a6e7f8091a2");
    var bus = agnosai_event_bus_new();
    var e = agnostic_ledger_record(id, str_from("gap"), agnosai_event_bus_subscribe(bus, id));
    _t_send(bus, id, "token", 1, 200);
    agnostic_ledger_drain(e);
    _t_send(bus, id, "token", 201, 100);
    agnostic_ledger_drain(e);

    var behind = _t_events_get(a, id, "after=10");
    assert_neq(behind, 0, "a cursor older than the window is answered 200, not refused");
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get_by_str(behind, AGNOSTIC_JK_EVENTS)),
      AGNOSTIC_LEDGER_MAX_EVENTS, "with every event still held");
    assert_eq(_t_seq_at(behind, 0), 45, "from the oldest held, 45: the oldest cursor is events[0].seq");
    assert_eq(_t_seq_at(behind, 255), 300, "to the newest, 300");
    assert_eq(agnostic_req_int(behind, AGNOSTIC_JK_NEXT, 0 - 1), 300, "next is the newest");
    assert_eq(agnostic_req_int(behind, AGNOSTIC_JK_MISSED, 0 - 1), 34,
      "and missed says 11 through 44 are gone: the gap is not silent");
    assert_eq(agnostic_req_int(behind, AGNOSTIC_JK_LOST, 0 - 1), 0, "none of it lost on the bus");
    assert_eq(agnostic_req_int(behind, AGNOSTIC_JK_DROPPED, 0 - 1), 44,
      "dropped_events counts the 44 the ring overwrote");
    assert_eq(str_eq_cstr(agnostic_req_str(behind, AGNOSTIC_JK_STATUS), "pending"), 1,
      "under the crew's status");

    var zero = _t_events_get(a, id, "after=0");
    assert_eq(agnostic_req_int(zero, AGNOSTIC_JK_MISSED, 0 - 1), 44, "after=0 missed all 44");
    assert_eq(_t_seq_at(zero, 0), 45, "and is everything held, from 45");

    var bare = _t_events_get(a, id, 0);
    assert_eq(agnostic_req_int(bare, AGNOSTIC_JK_MISSED, 0 - 1), 44,
      "without after, the whole window still says what it lacks");

    var edge = _t_events_get(a, id, "after=43");
    assert_eq(agnostic_req_int(edge, AGNOSTIC_JK_MISSED, 0 - 1), 1, "a cursor one short of the window missed 1");

    var held = _t_events_get(a, id, "after=44");
    assert_eq(agnostic_req_int(held, AGNOSTIC_JK_MISSED, 0 - 1), 0, "a cursor at the window's edge missed none");
    assert_eq(_t_seq_at(held, 0), 45, "and reads on from 45");

    var newest = _t_events_get(a, id, "after=300");
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get_by_str(newest, AGNOSTIC_JK_EVENTS)), 0,
      "a cursor at the newest reads nothing");
    assert_eq(agnostic_req_int(newest, AGNOSTIC_JK_NEXT, 0 - 1), 300, "and next stays 300");

    # A cursor past the newest was never issued for this crew; it reads nothing and is
    # handed back unchanged, as tests/ledger.tcyr pins at the ring.
    var ahead = _t_events_get(a, id, "after=999");
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get_by_str(ahead, AGNOSTIC_JK_EVENTS)), 0,
      "a cursor ahead of the crew reads nothing");
    assert_eq(agnostic_req_int(ahead, AGNOSTIC_JK_MISSED, 0 - 1), 0, "misses nothing");
    assert_eq(agnostic_req_int(ahead, AGNOSTIC_JK_NEXT, 0 - 1), 999, "and next is 999, unchanged");
}

var _T_CREWDB = "/tmp/agnostic-crews-route-collector.patra";

# ⭐ The collector (0.1.9): with no client polling at all, a finished crew's outcome is
# latched and PERSISTED, and its events are collected and timed. Before 0.1.9 an outcome
# was latched only by a poll, so a crew that finished unwatched did not survive a restart.
fn test_collector_without_a_poller() {
    test_group("crews/collector");

    agnostic_store_close();
    sys_unlink(_T_CREWDB);
    patra_init();
    agnostic_store_open(str_from(_T_CREWDB));
    agnostic_crews_ensure();

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    var id = agnostic_req_str(agnostic_response_body(resp), AGNOSTIC_JK_CREW_ID);
    var entry = agnostic_ledger_entry(id);
    assert_neq(entry, 0, "the crew is in the ledger");

    # Only the collector's sweep — no route is called from here to the end.
    var sa = arena_allocator(262144);
    var sweeps = 0;
    while (sweeps < 300 && agnostic_ledger_is_live(entry) == 1) {
        agnostic_collector_sweep_a(sa);
        reset_via(sa);
        sleep_ms(10);
        sweeps = sweeps + 1;
    }
    assert_eq(agnostic_ledger_is_live(entry), 0, "the sweep alone carries the crew to the end");
    assert_eq(agnostic_ledger_status(entry), AGNOSTIC_CREW_COMPLETED, "and latches its outcome");
    assert_neq(agnostic_crews_doc_a(a, id), 0, "which is PERSISTED without anyone polling");
    assert_eq(agnostic_ledger_started_ms(entry) > 0, 1, "its crew_started was collected");
    assert_eq(agnostic_ledger_finished_ms(entry) >= agnostic_ledger_started_ms(entry), 1,
      "and it finished after it started");
    assert_eq(agnostic_ledger_event_count(entry) > 2, 1, "with its events numbered");
    assert_eq(vec_len(agnostic_ledger_live_entries_a(sa)), 0, "and nothing left to sweep");
    assert_eq(agnostic_collector_sweep_a(sa), 0, "so a further sweep refreshes nothing");
    # 0.1.13: the outcome the collector wrote discharged the crew's in-flight row with it.
    assert_eq(agnostic_crews_inflight_count(), 0, "and the crew is no longer in flight");
    agnostic_store_close();
    sys_unlink(_T_CREWDB);
}

var _T_RESTARTDB = "/tmp/agnostic-crews-route-restart.patra";

# A fresh store at `_T_RESTARTDB` and a fresh engine, as a mount leaves them.
fn _t_fresh_store() {
    agnostic_store_close();
    sys_unlink(_T_RESTARTDB);
    patra_init();
    agnostic_store_open(str_from(_T_RESTARTDB));
    agnostic_crews_ensure();
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());
    return 0;
}

# ⭐ 0.1.13 (ADR 0013): an accepted crew is recorded as in flight at submit, and its outcome
# — written when a poll latches it — clears the record.
fn test_submit_marks_the_crew_in_flight() {
    test_group("crews/inflight-mark");

    _t_fresh_store();
    var a = arena_allocator(262144);
    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    assert_eq(agnostic_response_status(resp), AGNOSTIC_HTTP_ACCEPTED, "a crew is accepted");
    var id = agnostic_req_str(agnostic_response_body(resp), AGNOSTIC_JK_CREW_ID);
    # No collector and no poll yet, so nothing has latched: the crew has no outcome.
    assert_eq(agnostic_crews_inflight_count(), 1, "⭐ and recorded as in flight at submit");

    var tries = 0;
    var done = 0;
    while (tries < 200 && done == 0) {
        var b = agnostic_response_body(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
            _t_crew_url(id, ""), str_from(""), 1048576, 0));
        if (str_eq_cstr(agnostic_req_str(b, AGNOSTIC_JK_STATUS), "completed") == 1) { done = 1; }
        else { sleep_ms(10); }
        tries = tries + 1;
    }
    assert_eq(done, 1, "polled to its end");
    assert_neq(agnostic_crews_doc_a(a, id), 0, "its outcome is stored");
    assert_eq(agnostic_crews_inflight_count(), 0, "⭐ and that cleared the in-flight record");
    agnostic_store_close();
    sys_unlink(_T_RESTARTDB);
}

# ⭐ H4 (0.1.13, ADR 0013): a crew accepted before a restart that never finished answers 200
# `interrupted` — before 0.1.13 its id, handed out in a 202, answered 404 like a typo.
fn test_an_interrupted_crew_is_not_404() {
    test_group("crews/interrupted-not-404");

    _t_fresh_store();
    var a = arena_allocator(262144);
    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_BODY), 1048576, 0);
    var id = agnostic_req_str(agnostic_response_body(resp), AGNOSTIC_JK_CREW_ID);
    assert_neq(id, 0, "a crew is accepted and never polled");

    # The process dies: the engine and the ledger are gone, the store is reopened, and the
    # next mount builds a new engine and runs the start-up sweep.
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_store_close();
    patra_init();
    agnostic_store_open(str_from(_T_RESTARTDB));
    agnostic_crews_ensure();
    agnostic_engine_init(agnostic_config_from_env());
    assert_eq(agnostic_crews_interrupt_inflight(), 1, "the start-up sweep interrupts it");

    var g = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, _t_crew_url(id, ""), str_from(""), 1048576, 0);
    assert_eq(agnostic_response_status(g), HTTP_OK, "⭐ GET answers 200 — it was 404 before 0.1.13");
    if (agnostic_response_status(g) != HTTP_OK) {   # the reads below need the body; the failure is named above
        agnostic_store_close();
        sys_unlink(_T_RESTARTDB);
        return 0;
    }
    var gb = agnostic_response_body(g);
    assert_eq(str_eq_cstr(agnostic_req_str(gb, AGNOSTIC_JK_STATUS), "interrupted"), 1,
      "⭐ with status interrupted — terminal, not a stale pending");
    assert_eq(agnostic_req_int(gb, AGNOSTIC_JK_TASKS_SUB, 0 - 1), 1, "tasks_submitted 1, as accepted");
    assert_eq(str_eq_cstr(agnostic_req_str(gb, AGNOSTIC_JK_CREW_SCOPE), "_"), 1, "in the scope it was submitted in");
    assert_eq(str_eq_cstr(agnostic_req_str(gb, AGNOSTIC_JK_NAME), "sweep"), 1, "and its name");

    # What only the ledger held does not survive: events, plan and cancel answer 404.
    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_GET, _t_crew_url(id, "/events")), HTTP_NOT_FOUND,
      "its events are not held");
    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_GET, _t_crew_url(id, "/plan")), HTTP_NOT_FOUND,
      "nor its plan");
    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_POST, _t_crew_url(id, "/cancel")), HTTP_NOT_FOUND,
      "and cancel answers 404, as for any crew from before a restart");

    var list = agnostic_response_body(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
        str_from("/api/v1/crews"), str_from(""), 1048576, 0));
    var crews = bayan_json_v_obj_get_by_str(list, AGNOSTIC_JK_CREWS);
    assert_eq(bayan_json_v_arr_len(crews), 1, "the listing holds it");
    if (bayan_json_v_arr_len(crews) == 1) {
        var item = bayan_json_v_arr_get(crews, 0);
        assert_eq(str_eq(agnostic_req_str(item, AGNOSTIC_JK_CREW_ID), id), 1, "that crew");
        assert_eq(str_eq_cstr(agnostic_req_str(item, AGNOSTIC_JK_STATUS), "interrupted"), 1, "listed as interrupted");
    }

    assert_eq(_t_status(a, AGNOSTIC_METHOD_POST, "/api/v1/crews", _T_BODY), AGNOSTIC_HTTP_ACCEPTED,
      "and the new process accepts crews as before");
    agnostic_store_close();
    sys_unlink(_T_RESTARTDB);
}

var _T_DAG = "{\"name\":\"plan\",\"process\":\"dag\",\"agents\":[{\"key\":\"a1\",\"role\":\"tester\",\"goal\":\"find bugs\",\"llm_model\":\"m1\"},{\"key\":\"a2\",\"role\":\"writer\",\"goal\":\"write it up\"}],\"tasks\":[{\"description\":\"one\"},{\"description\":\"two\",\"priority\":\"high\"},{\"description\":\"three\",\"dependencies\":[0,1]}]}";

fn _t_crew_url(id, tail): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/api/v1/crews/");
    str_builder_add(sb, id);
    str_builder_add_cstr(sb, tail);
    return str_builder_build(sb);
}

# ⭐ 0.1.9: the 202 names each task's engine id in request order, GET says how the crew
# ran, and `/plan` describes any crew well enough to watch it without having submitted it.
fn test_task_ids_and_plan() {
    test_group("crews/plan");

    var a = arena_allocator(262144);
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());

    var resp = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"),
      str_from(_T_DAG), 1048576, 0);
    assert_eq(agnostic_response_status(resp), AGNOSTIC_HTTP_ACCEPTED, "the DAG crew is accepted");
    var acc = agnostic_response_body(resp);
    var id = agnostic_req_str(acc, AGNOSTIC_JK_CREW_ID);
    var ids = bayan_json_v_obj_get_by_str(acc, AGNOSTIC_JK_TASK_IDS);
    assert_eq(bayan_json_v_arr_len(ids), 3, "the 202 carries one task id per task");
    var t0 = bayan_json_v_str(bayan_json_v_arr_get(ids, 0));
    var t2 = bayan_json_v_str(bayan_json_v_arr_get(ids, 2));
    assert_eq(agnosai_uuid_is_valid(t0), 1, "each an engine UUID");
    assert_eq(str_eq(t0, t2), 0, "and distinct");
    assert_eq(agnostic_req_int(acc, AGNOSTIC_JK_SUBMITTED_AT, 0 - 1) > 0, 1, "and when it was accepted");

    var plan_r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, _t_crew_url(id, "/plan"),
      str_from(""), 1048576, 0);
    assert_eq(agnostic_response_status(plan_r), HTTP_OK, "the plan route answers 200");
    var plan = agnostic_response_body(plan_r);
    assert_eq(str_eq_cstr(agnostic_req_str(plan, AGNOSTIC_JK_PROCESS), "dag"), 1, "with the process");
    var tasks = bayan_json_v_obj_get_by_str(plan, AGNOSTIC_JK_TASKS);
    assert_eq(bayan_json_v_arr_len(tasks), 3, "and every task");
    var pt0 = bayan_json_v_arr_get(tasks, 0);
    var pt1 = bayan_json_v_arr_get(tasks, 1);
    var pt2 = bayan_json_v_arr_get(tasks, 2);
    assert_eq(str_eq(agnostic_req_str(pt0, AGNOSTIC_JK_TASK_ID), t0), 1, "in request order: task 0 is the 202's first id");
    assert_eq(str_eq(agnostic_req_str(pt2, AGNOSTIC_JK_TASK_ID), t2), 1, "and task 2 its third");
    assert_eq(str_eq_cstr(agnostic_req_str(pt1, AGNOSTIC_JK_DESCRIPTION), "two"), 1, "each with its description");
    assert_eq(str_eq_cstr(agnostic_req_str(pt1, AGNOSTIC_JK_PRIORITY), "high"), 1, "and priority");
    var deps = bayan_json_v_obj_get_by_str(pt2, AGNOSTIC_JK_DEPENDENCIES);
    assert_eq(bayan_json_v_arr_len(deps), 2, "dependencies come back");
    assert_eq(bayan_json_v_int(bayan_json_v_arr_get(deps, 0)) + bayan_json_v_int(bayan_json_v_arr_get(deps, 1)), 1,
      "as the indices 0 and 1 they were sent as");
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get_by_str(pt0, AGNOSTIC_JK_DEPENDENCIES)), 0,
      "and an empty array where there are none");
    var agents = bayan_json_v_obj_get_by_str(plan, AGNOSTIC_JK_AGENTS);
    assert_eq(bayan_json_v_arr_len(agents), 2, "the agents it was given");
    var ag0 = bayan_json_v_arr_get(agents, 0);
    assert_eq(str_eq_cstr(agnostic_req_str(ag0, AGNOSTIC_JK_KEY), "a1"), 1, "each by key");
    assert_eq(str_eq_cstr(agnostic_req_str(ag0, AGNOSTIC_JK_LLM_MODEL), "m1"), 1, "with its model when it has one");

    # The crew outcome now says how it ran — wait for it to finish first.
    var tries = 0;
    var body = 0;
    while (tries < 200) {
        body = agnostic_response_body(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
            _t_crew_url(id, ""), str_from(""), 1048576, 0));
        if (str_eq_cstr(agnostic_req_str(body, AGNOSTIC_JK_STATUS), "completed") == 1) { break; }
        sleep_ms(10);
        tries = tries + 1;
    }
    assert_eq(str_eq_cstr(agnostic_req_str(body, AGNOSTIC_JK_STATUS), "completed"), 1, "the crew completes");
    assert_eq(str_eq_cstr(agnostic_req_str(body, AGNOSTIC_JK_NAME), "plan"), 1, "GET names it");
    assert_eq(str_eq_cstr(agnostic_req_str(body, AGNOSTIC_JK_PROCESS), "dag"), 1, "says its process");
    assert_eq(agnostic_req_int(body, AGNOSTIC_JK_TASKS_SUB, 0 - 1), 3, "how many tasks it was given");
    var sub_at = agnostic_req_int(body, AGNOSTIC_JK_SUBMITTED_AT, 0 - 1);
    var fin_at = agnostic_req_int(body, AGNOSTIC_JK_FINISHED_AT, 0 - 1);
    assert_eq(sub_at > 0, 1, "when it was accepted");
    assert_eq(fin_at >= sub_at, 1, "and when it finished, no earlier");
    var usage = bayan_json_v_obj_get_by_str(body, AGNOSTIC_JK_USAGE);
    assert_neq(usage, 0, "and its usage");
    assert_eq(agnostic_req_int(usage, AGNOSTIC_JK_METERED, 0 - 1), 0,
      "which, on the placeholder engine, metered nothing — no tokens invented for an echo");

    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_GET,
        str_from("/api/v1/crews/6ba7b810-9dad-11d1-80b4-00c04fd430c8/plan")), HTTP_NOT_FOUND,
      "a crew never submitted has no plan: 404");
    assert_eq(_t_status_s(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/crews/nope/plan")),
      AGNOSTIC_HTTP_UNPROCESSABLE, "a malformed id is 422");
    assert_eq(agnostic_perm_for_route(AGNOSTIC_ROUTE_CREW_PLAN), AGNOSTIC_PERM_READ, "reading a plan is READ");
}

fn test_readiness_registers_the_engine() {
    test_group("crews/ready");

    var a = arena_allocator(65536);
    agnostic_engine_reset();
    agnostic_ready_reset();
    agnostic_ready_register(str_from("engine"), &agnostic_engine_is_ready);

    # ⚠ /ready is 503 while the engine is down; /health stays 200. A process
    # whose engine is not up cannot do the one thing it exists for — but
    # restarting it would not help, which is the whole ADR 0001 split.
    assert_eq(agnostic_response_status(agnostic_route_ready_a(a)), HTTP_SERVICE_UNAVAILABLE,
      "/ready is 503 with the engine down");
    assert_eq(agnostic_response_status(agnostic_route_health_a(a)), HTTP_OK,
      "/health stays 200 regardless");

    agnostic_engine_init(agnostic_config_from_env());
    assert_eq(agnostic_response_status(agnostic_route_ready_a(a)), HTTP_OK,
      "/ready is 200 once the engine is up");
    agnostic_ready_reset();
}

fn main() {
    alloc_init();
    thread_local_init();
    test_route_table();
    test_method_mismatch_is_405();
    test_malformed_id_is_422();
    test_uppercase_id_is_normalised();
    test_engine_down_is_503();
    test_submit_rejections();
    test_submit_accepts_with_202();
    test_poll_reports_a_real_outcome();
    test_cancel_never_relabels_what_it_did_not_cancel();
    test_cancel_a_live_crew_stops_it();
    test_events_route();
    test_events_route_status_is_current();
    test_events_cursor();
    test_events_gap();
    test_collector_without_a_poller();
    test_submit_marks_the_crew_in_flight();
    test_an_interrupted_crew_is_not_404();
    test_task_ids_and_plan();
    test_readiness_registers_the_engine();
    return assert_summary();
}

var _agnostic_crews_route_test_exit = main();
if (_agnostic_crews_route_test_exit > 0) { _agnostic_crews_route_test_exit = 1; }
sys_exit_group(_agnostic_crews_route_test_exit);
