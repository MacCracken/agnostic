# agnostic/http/forwarded + the proxy list — which address a request came from (0.3.1, audit S7).
#
# ⚠ Every case below that an attacker could write is the point of the suite: the rule that keeps
# the login bucket working behind a proxy is the rule that keeps a caller from choosing their own.
include "src/strcase.cyr"
include "src/config.cyr"
include "src/http/forwarded.cyr"

fn _t_ip(text) { return net_parse_ipv4(text); }

fn _t_table(text) { return agnostic_config_parse_proxies(str_from(text)); }

# A request whose headers are `headers`, each line ending CRLF, then a blank line and `body`.
fn _t_req(headers, body) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "POST /api/v1/auth/login HTTP/1.1\r\nHost: x\r\n");
    str_builder_add_cstr(sb, headers);
    str_builder_add_cstr(sb, "\r\n");
    str_builder_add_cstr(sb, body);
    return str_builder_build(sb);
}

# What `agnostic_client_addr` answers for a peer and those headers.
fn _t_addr(peer, headers) {
    var r = _t_req(headers, "");
    return agnostic_client_addr(peer, str_data(r), str_len(r));
}

fn test_the_list() {
    test_group("forwarded/list");
    assert_eq(_t_table(""), 0, "empty is none");
    var one = _t_table("127.0.0.1");
    assert_eq(load64(one + AGNOSTIC_PXT_COUNT), 1, "one address");
    assert_eq(agnostic_proxy_trusted(one, _t_ip("127.0.0.1")), 1, "is trusted");
    assert_eq(agnostic_proxy_trusted(one, _t_ip("127.0.0.2")), 0, "and its neighbour is not");
    var nets = _t_table("10.0.0.0/8, 192.168.1.128/25 ,172.16.0.1");
    assert_eq(load64(nets + AGNOSTIC_PXT_COUNT), 3, "a list, spaces or not");
    assert_eq(agnostic_proxy_trusted(nets, _t_ip("10.255.255.255")), 1, "the top of a network");
    assert_eq(agnostic_proxy_trusted(nets, _t_ip("11.0.0.0")), 0, "one past it");
    assert_eq(agnostic_proxy_trusted(nets, _t_ip("192.168.1.128")), 1, "a /25 from its base");
    assert_eq(agnostic_proxy_trusted(nets, _t_ip("192.168.1.127")), 0, "and not below it");
    assert_eq(agnostic_proxy_trusted(nets, _t_ip("172.16.0.1")), 1, "a bare address among networks");
    assert_eq(agnostic_proxy_trusted(0, _t_ip("127.0.0.1")), 0, "no table trusts nobody");

    assert_eq(_t_table("0.0.0.0/0"), 0 - 1, "⭐ /0 is refused: it would trust every caller");
    assert_eq(_t_table("10.1.2.3/8"), 0 - 1, "host bits under a mask are refused");
    assert_eq(_t_table("10.0.0.0/33"), 0 - 1, "past /32");
    assert_eq(_t_table("10.0.0.0/"), 0 - 1, "a slash with no prefix");
    assert_eq(_t_table("10.0.0.0/08"), 0 - 1, "a prefix with a leading zero");
    assert_eq(_t_table("proxy.internal"), 0 - 1, "a name");
    assert_eq(_t_table("1.2.3"), 0 - 1, "three parts");
    assert_eq(_t_table("010.0.0.1"), 0 - 1, "an octal-looking part");
    assert_eq(_t_table("1.2.3.4,,5.6.7.8"), 0 - 1, "an empty entry");
    assert_eq(_t_table("::1"), 0 - 1, "IPv6: the socket peer this is compared with is IPv4");

    var sb = str_builder_new();
    var i = 0;
    while (i < AGNOSTIC_PROXIES_MAX) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, "10.0.0.");
        str_builder_add_int(sb, i + 1);
        i = i + 1;
    }
    var full = str_builder_build(sb);
    assert_eq(load64(agnostic_config_parse_proxies(full) + AGNOSTIC_PXT_COUNT), AGNOSTIC_PROXIES_MAX,
      "the most it takes");
    var over = str_builder_new();
    str_builder_add(over, full);
    str_builder_add_cstr(over, ",10.0.1.1");
    assert_eq(agnostic_config_parse_proxies(str_builder_build(over)), 0 - 1, "and one more is refused");
}

fn test_who_may_say() {
    test_group("forwarded/who-may-say");
    var attacker = _t_ip("203.0.113.9");
    var proxy = _t_ip("127.0.0.1");

    agnostic_forwarded_set_proxies(0);
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 9.9.9.9\r\n"), proxy, "with no list the header is ignored");

    agnostic_forwarded_set_proxies(_t_table("127.0.0.1,10.0.0.0/8"));
    assert_eq(_t_addr(attacker, "X-Forwarded-For: 9.9.9.9\r\n"), attacker,
      "⭐ a peer not on the list cannot name itself a bucket");
    assert_eq(_t_addr(proxy, ""), proxy, "a proxy's own request is the proxy's");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 9.9.9.9\r\n"), _t_ip("9.9.9.9"), "the client, through a proxy");
    assert_eq(_t_addr(proxy, "x-FORWARDED-for:9.9.9.9\r\n"), _t_ip("9.9.9.9"), "in any case, with no space");
}

fn test_the_walk() {
    test_group("forwarded/walk");
    var proxy = _t_ip("127.0.0.1");
    var client = _t_ip("9.9.9.9");
    agnostic_forwarded_set_proxies(_t_table("127.0.0.1,10.0.0.0/8"));

    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1.1.1.1, 9.9.9.9\r\n"), client,
      "⭐ the rightmost: the left of the header is the caller's to write");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1.1.1.1, 9.9.9.9, 10.0.0.5, 10.9.9.9\r\n"), client,
      "past each trusted hop");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 10.0.0.5, 10.0.0.6\r\n"), proxy, "every hop trusted leaves the peer");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 9.9.9.9, junk\r\n"), proxy,
      "⭐ a token that does not parse ends what can be believed");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 9.9.9.9, junk, 10.0.0.5\r\n"), proxy,
      "even behind a trusted hop");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: junk, 9.9.9.9\r\n"), client, "junk to the left is left");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: \r\n"), proxy, "an empty value");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 9.9.9.9,\r\n"), proxy, "a trailing comma is an empty token");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 0.0.0.0\r\n"), proxy, "0.0.0.0 is nobody");

    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1.1.1.1\r\nX-Forwarded-For: 9.9.9.9\r\n"), client,
      "⭐ a proxy that adds a line: the client's own line comes first, and loses");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 9.9.9.9\r\nX-Forwarded-For: junk\r\n"), proxy, "across lines too");

    var r = _t_req("", "X-Forwarded-For: 1.1.1.1\r\n");
    assert_eq(agnostic_client_addr(proxy, str_data(r), str_len(r)), proxy, "a body is not a header");
    assert_eq(_t_addr(proxy, "X-Forwarded-Forged: 1.1.1.1\r\n"), proxy, "nor is a longer name");
    assert_eq(_t_addr(proxy, "Y: X-Forwarded-For: 1.1.1.1\r\n"), proxy, "nor a value that reads like one");

    assert_eq(_t_addr(proxy, "X-Forwarded-For: 9.9.9.9:51234\r\n"), client, "a port goes: it is not the client");
    assert_eq(agnostic_client_addr(proxy, "", 0), proxy, "an empty request");
}

fn test_ipv6() {
    test_group("forwarded/ipv6");
    var proxy = _t_ip("127.0.0.1");
    agnostic_forwarded_set_proxies(_t_table("127.0.0.1"));

    var k = _t_addr(proxy, "X-Forwarded-For: 2001:db8:1:2:3:4:5:6\r\n");
    assert_neq(k, proxy, "an IPv6 client is told from the proxy");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 2001:db8:1:2:aaaa::1\r\n"), k, "⭐ a host's /64 is one bucket");
    assert_neq(_t_addr(proxy, "X-Forwarded-For: 2001:db8:1:3::1\r\n"), k, "and the next /64 another");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: [2001:db8:1:2::1]:443\r\n"), k, "brackets and a port");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: [2001:db8:1:2::1]\r\n"), k, "brackets");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 2001:DB8:1:2::1\r\n"), k, "in either case");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: ::ffff:9.9.9.9\r\n"), _t_ip("9.9.9.9"), "a mapped address is IPv4");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: ::ffff:127.0.0.1\r\n"), proxy,
      "⭐ so a mapped proxy is still a proxy");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1:2:3:4:5:6:1.2.3.4\r\n"),
      _t_addr(proxy, "X-Forwarded-For: 1:2:3:4::\r\n"), "a dotted tail");

    var bad = "1:2:3";
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1:2:3\r\n"), proxy, bad);
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1::2::3\r\n"), proxy, "two gaps");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: :::\r\n"), proxy, "three colons");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 12345::\r\n"), proxy, "a group of five");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1:2:3:4:5:6:7:8:9\r\n"), proxy, "nine groups");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1:2:3:4:5:6:7:8::\r\n"), proxy, "eight and a gap");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: 1:\r\n"), proxy, "a trailing colon");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: ::\r\n"), proxy, "the unspecified address");
    assert_eq(_t_addr(proxy, "X-Forwarded-For: [2001:db8::1\r\n"), proxy, "an open bracket");
}

fn test_text() {
    test_group("forwarded/text");
    var a = arena_allocator(4096);
    assert_eq(str_eq_cstr(agnostic_addr_text_a(a, _t_ip("9.8.7.6")), "9.8.7.6"), 1, "dotted");
    assert_eq(str_eq_cstr(agnostic_addr_text_a(a, 0), "0.0.0.0"), 1, "unknown reads as it always did");
    agnostic_forwarded_set_proxies(_t_table("127.0.0.1"));
    var k = _t_addr(_t_ip("127.0.0.1"), "X-Forwarded-For: 2001:db8:0:ab::1\r\n");
    assert_eq(str_eq_cstr(agnostic_addr_text_a(a, k), "2001:db8:0:ab::/64"), 1, "an IPv6 client as its /64");
}

fn main() {
    alloc_init();
    test_the_list();
    test_who_may_say();
    test_the_walk();
    test_ipv6();
    test_text();
    return assert_summary();
}

var _agnostic_forwarded_test_exit = main();
if (_agnostic_forwarded_test_exit > 0) { _agnostic_forwarded_test_exit = 1; }
sys_exit_group(_agnostic_forwarded_test_exit);
