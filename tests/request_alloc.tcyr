# agnostic — what a request leaves on the global heap (0.1.15).
#
# `lib/alloc.cyr` is a bump allocator with no `free()`. A request is served from its own arena,
# which sandhi rewinds when the request ends, so anything a request path allocates from the
# GLOBAL heap instead is kept until the process exits — in proportion to requests served.
# `src/http/response.cyr`'s header says it for the error arms: the 404 is what an
# unauthenticated scanner hits hardest.
#
# Measured at 0.1.13, one dispatch each from a fresh arena, on a mounted server with auth
# required: a 404 kept 16 bytes, a 401 16, any authenticated request 16, a failed login 128, a
# successful login 696, an audited write 416; at 0.1.14 listing the definitions kept 152. This
# suite holds every one of those paths to 0 of agnostic's own: it takes `alloc_used()` around a
# dispatch whose path, body, context and arena were all built before it, the second time each
# request is made (the first may run a one-time lazy init). An audited request still keeps
# libro's entry, which is libro's to settle (`_t_libro_record_cost`).
#
# Not held to it, by design: a submitted crew (the engine and the ledger keep it), a created
# definition (the definition cache keeps what it stores), and creating a user. Since 0.1.17 a
# crew or definition body refused part-way is held to it too: the doors check the whole body
# before they build anything (`alloc/refused-bodies`).
include "src/app.cyr"
include "tests/support/tmp.cyr"   # scratch paths under $TMPDIR (0.1.15)

var _T_RADB = _tt_tmp_path("request-alloc-db");
var _T_RAAUDIT = _tt_tmp_path("request-alloc-audit");
var _T_PW = "a long enough password";
var _t_token = 0;
var _t_viewer_token = 0;

fn _t_open() {
    patra_init();
    agnostic_definitions_open(str_from(_T_RADB));
    agnostic_auth_ensure();
    agnostic_tenants_ensure();
    agnostic_settings_ensure();
    agnostic_plugindata_ensure();
    agnostic_crews_ensure();
    agnostic_webgui_init();
    agnostic_presets_init();
    agnostic_audit_open(str_from(_T_RAAUDIT));
    agnostic_argon_pool_init();
    agnostic_rl_init();
    agnostic_rl_reset();
    var k = alloc(32);
    var i = 0;
    while (i < 32) { store8(k + i, 40 + i); i = i + 1; }
    agnostic_jwt_set_secret(k, 32);
    agnostic_authn_set_mode(AGNOSTIC_AUTH_REQUIRED);
    var a = arena_allocator(1048576);
    var uid = agnostic_users_create_a(a, str_from("alloc@example.com"), str_from(_T_PW),
      AGNOSTIC_ROLE_ADMIN, str_from("acme"));
    _t_token = agnostic_jwt_issue_a(default_alloc(), uid, AGNOSTIC_ROLE_ADMIN, str_from("acme"), 600);
    var vid = agnostic_users_create_a(a, str_from("viewer@example.com"), str_from(_T_PW),
      AGNOSTIC_ROLE_VIEWER, str_from("acme"));
    _t_viewer_token = agnostic_jwt_issue_a(default_alloc(), vid, AGNOSTIC_ROLE_VIEWER, str_from("acme"), 600);
    return uid;
}

# How many bytes the global heap grew across ONE dispatch of `method` `path` with `body`, from a
# fresh arena. `auth` is 0 for no credential, 1 for the admin's token, 2 for the viewer's;
# `transport` 1 marks the context as a socket request with no Content-Type.
fn _t_cost_once(method, path, body, auth, transport) {
    var a = arena_allocator(1048576);
    var p = str_from_a(a, path);
    var b = str_from_a(a, body);
    var authz = 0;
    if (auth == 1) {
        var h = alloc_via(a, 7 + str_len(_t_token));
        memcpy(h, "Bearer ", 7);
        memcpy(h + 7, str_data(_t_token), str_len(_t_token));
        authz = str_new_a(a, h, 7 + str_len(_t_token));
    }
    if (auth == 2) { authz = _t_viewer_authz_a(a); }
    if (auth == 3) { authz = str_from_a(a, "ApiKey x"); }
    var ctx = agnostic_reqctx_new_a(a, authz, 7);
    if (transport == 1) { agnostic_reqctx_set_transport(ctx, 0, str_from_a(a, "localhost")); }
    var before = alloc_used();
    agnostic_route_dispatch_a(a, method, p, b, 4096, ctx);
    return alloc_used() - before;
}

# `Bearer <the viewer's token>` in `a`.
fn _t_viewer_authz_a(a) {
    var n = str_len(_t_viewer_token);
    var h = alloc_via(a, 7 + n);
    memcpy(h, "Bearer ", 7);
    memcpy(h + 7, str_data(_t_viewer_token), n);
    return str_new_a(a, h, 7 + n);
}

# The second dispatch's cost: the first may run a one-time lazy initialisation.
fn _t_cost(method, path, body, auth, transport) {
    _t_cost_once(method, path, body, auth, transport);
    return _t_cost_once(method, path, body, auth, transport);
}

# ⭐ 0.3.1: a refusal past its budget writes nothing and keeps nothing, so a flood of 401s costs the
# heap as little as it costs the disk. The budget itself keeps libro's entry, as every audited
# request does, and that is what the budget bounds.
fn test_a_refusal_past_the_budget_keeps_nothing() {
    test_group("alloc/refusal-budget");
    agnostic_refusal_init();
    agnostic_refusal_reset();
    var libro = _t_libro_record_cost();
    assert_eq(libro > 0, 1, "precondition: libro's entry is measured");
    var i = 0;
    var a = arena_allocator(1048576);
    while (i < AGNOSTIC_REFUSAL_BURST - 1) {
        agnostic_refusal_note_a(a, AGNOSTIC_REFUSAL_UNAUTHENTICATED, 0, 0);
        reset_via(a);
        i = i + 1;
    }
    assert_eq(_t_cost_once(AGNOSTIC_METHOD_GET, "/api/v1/crews", "", 0, 0) - libro, 0,
      "⭐ a 401 inside the budget keeps libro's entry and nothing of agnostic's");
    var appended = agnostic_audit_appended();
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/crews", "", 0, 0), 0, "⭐ past it, a 401 keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_PUT, "/api/v1/plugins/swarm", "{\"enabled\":true}", 2, 0), 0,
      "and a 403 keeps nothing");
    assert_eq(agnostic_audit_appended(), appended, "having written nothing");
    agnostic_refusal_reset();
}

# ⭐ 0.3.1: a crew over its tenant's limit is refused before it is built. Building one keeps it on the
# global heap, so a refusal after that step would be a leak a tenant at its limit could drive.
fn test_a_crew_over_its_limit_keeps_nothing() {
    test_group("alloc/tenant-limit");
    agnostic_refusal_init();
    agnostic_refusal_reset();
    agnostic_tenant_limits_init(1, 0);
    agnostic_tenant_limits_reset();
    agnostic_engine_init(agnostic_config_from_env());
    var body = "{\"name\":\"c\",\"agents\":[{\"key\":\"a1\",\"role\":\"r\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"d\"}]}"; #skip-lint
    _t_cost_once(AGNOSTIC_METHOD_POST, "/api/v1/crews", body, 1, 0);
    assert_eq(agnostic_refusal_count(AGNOSTIC_REFUSAL_TENANT_RATE), 0, "precondition: the minute's crew was admitted");
    var i = 0;
    while (i < AGNOSTIC_REFUSAL_BURST) {
        _t_cost_once(AGNOSTIC_METHOD_POST, "/api/v1/crews", body, 1, 0);
        i = i + 1;
    }
    assert_eq(agnostic_refusal_count(AGNOSTIC_REFUSAL_TENANT_RATE), AGNOSTIC_REFUSAL_BURST,
      "precondition: refused since");
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/crews", body, 1, 0), 0,
      "⭐ a crew refused for its limit keeps nothing");
    agnostic_tenant_limits_init(0, 0);
    agnostic_tenant_limits_reset();
    agnostic_refusal_reset();
}

# ⭐ 0.3.1: `agnosai_metrics_gather` would keep about 1 KB a scrape for ever (ADR 0027).
fn test_a_scrape_keeps_nothing() {
    test_group("alloc/metrics");
    agnostic_refusal_init();
    agnosai_metrics_global();
    var a = arena_allocator(1048576);
    agnostic_route_metrics_a(a);
    reset_via(a);
    var before = alloc_used();
    agnostic_route_metrics_a(a);
    assert_eq(alloc_used() - before, 0, "⭐ a scrape keeps nothing");
}

fn test_refusals_keep_nothing() {
    test_group("alloc/refusals");

    var big = alloc(5000);
    memset(big, 32, 4999);
    store8(big + 4999, 0);
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/health", "", 0, 0), 0, "GET /health keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/agents/definitions", big, 0, 0), 0, "a 413 keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/nope", "", 0, 0), 0, "⭐ a 404 keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/health", "", 0, 0), 0, "a 405, with its Allow, keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/crews", "", 0, 0), 0, "⭐ a 401 keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/crews", "", 3, 0), 0,
      "⭐ a 401 for an unknown API key keeps nothing, though it hashes the key");
    assert_eq(_t_cost(AGNOSTIC_METHOD_PUT, "/api/v1/plugins/swarm", "{\"enabled\":true}", 2, 0), 0,
      "a 403 keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_PUT, "/api/v1/plugins/swarm/data/x", "{}", 1, 1), 0,
      "a 415 keeps nothing");
}

fn test_authenticated_requests_keep_nothing() {
    test_group("alloc/authenticated");

    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/agents/definitions", "", 1, 0), 0,
      "⭐ an authenticated GET keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/presets", "", 1, 0), 0, "nor does reading the presets");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/audit", "", 1, 0), 0, "nor the audit verdict");
    # The identity routes (0.3.0): reads and refusals, which anyone holding a token can repeat.
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/auth/me", "", 2, 0), 0, "nor asking who you are");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/auth/api-keys", "", 2, 0), 0, "nor listing your keys");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/users", "", 1, 0), 0, "nor listing a tenant's users");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/users/0000000000000001", "", 1, 0), 0,
      "nor a user who is not there");
    assert_eq(_t_cost(AGNOSTIC_METHOD_PUT, "/api/v1/users/0000000000000001", "{\"role\":\"viewer\"}", 1, 0), 0,
      "nor changing one");
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/users", "{\"email\":\"x\",\"password\":\"s\",\"role\":\"viewer\"}",
        1, 0), 0, "nor a refused user");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/users", "", 2, 0), 0, "nor a viewer's 403");
}

# What one audit record keeps on the global heap that is not agnostic's: libro's `chain_append`
# builds an entry per append — its struct, timestamp and hash Strs — and a streaming chain
# drops it. libro 2.9.0's `chain_append_nokeep` saves the struct but returns no entry to
# persist, so it is libro's to settle (roadmap, Upstream). Measured here, the second time, so
# the suites below can hold agnostic's own share of an audited request to 0.
fn _t_libro_record_cost() {
    var i = 0;
    var cost = 0;
    while (i < 2) {
        var a = arena_allocator(65536);
        var act = str_from_a(a, "probe.record");
        var det = agnostic_audit_detail_a(a, "k", str_from_a(a, "v"));
        var before = alloc_used();
        agnostic_audit_record(SEV_INFO, AGNOSTIC_AUDIT_SRC, act, det);
        cost = alloc_used() - before;
        i = i + 1;
    }
    return cost;
}

fn test_login_keeps_nothing() {
    test_group("alloc/login");

    var libro = _t_libro_record_cost();
    agnostic_rl_reset();
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/auth/login",
        "{\"email\":\"alloc@example.com\",\"password\":\"wrong\"}", 0, 0) - libro, 0,
      "⭐ a failed login keeps nothing of agnostic's — only libro's audit entry");
    agnostic_rl_reset();
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/auth/login",
        "{\"email\":\"alloc@example.com\",\"password\":\"a long enough password\"}", 0, 0) - libro, 0,
      "⭐ a successful login keeps nothing of agnostic's — only libro's audit entry");
    agnostic_rl_reset();
}

fn test_audited_writes_keep_nothing() {
    test_group("alloc/audited-writes");

    var libro = _t_libro_record_cost();
    assert_eq(libro > 0, 1, "precondition: libro's entry is measured");
    var n0 = agnostic_audit_appended();
    assert_eq(_t_cost(AGNOSTIC_METHOD_PUT, "/api/v1/plugins/swarm/data/doc", "{\"v\":1}", 1, 0) - libro, 0,
      "⭐ an audited document write keeps nothing of agnostic's");
    assert_eq(_t_cost_once(AGNOSTIC_METHOD_DELETE, "/api/v1/plugins/swarm/data/doc", "", 1, 0) - libro, 0,
      "nor does deleting it");
    assert_eq(agnostic_audit_appended(), n0 + 3, "and all three were audited");
}

# ⭐ 0.1.17: a body refused part-way keeps nothing. Until then the doors decoded straight into
# the global heap and kept everything built before the refusal: 152 B for a crew refused at its
# second agent, 672 B at its second task, 392 B for a definition refused for its `complexity`,
# and a whole crew's worth for a dependency cycle, which was found last.
var _T_AG = "{\"key\":\"a1\",\"role\":\"r\",\"goal\":\"g\"}";

# A crew body: its agents array's contents, then its tasks array's.
fn _t_crew(agents, tasks) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"c\",\"agents\":[");
    str_builder_add_cstr(sb, agents);
    str_builder_add_cstr(sb, "],\"tasks\":[");
    str_builder_add_cstr(sb, tasks);
    str_builder_add_cstr(sb, "]}");
    return str_data(str_builder_build(sb));
}

fn test_refused_bodies_keep_nothing() {
    test_group("alloc/refused-bodies");
    var two = str_data(str_cat(str_cat(str_from(_T_AG), str_from(",")),
        str_from("{\"key\":\"a2\",\"role\":\"r\",\"goal\":\"g\",\"bogus\":1}")));
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/crews", _t_crew(two, "{\"description\":\"t\"}"), 1, 0), 0,
      "⭐ a crew refused at its second agent keeps nothing (152 B until 0.1.17)");
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/crews",
        _t_crew(_T_AG, "{\"description\":\"t\"},{\"description\":\"u\",\"bogus\":1}"), 1, 0), 0,
      "⭐ nor one refused at its second task (672 B)");
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/crews",
        _t_crew(_T_AG, "{\"description\":\"t\",\"dependencies\":[1]},{\"description\":\"u\",\"dependencies\":[0]}"),
        1, 0), 0, "⭐ nor one refused for a dependency cycle, found after every task decoded");
    var cx = str_data(str_cat(str_cat(str_from(_T_AG), str_from(",")),
        str_from("{\"key\":\"a2\",\"role\":\"r\",\"goal\":\"g\",\"complexity\":\"extreme\"}")));
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/crews", _t_crew(cx, "{\"description\":\"t\"}"), 1, 0), 0,
      "nor one refused for an agent's complexity");

    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/agents/definitions",
        "{\"key\":\"cx\",\"role\":\"r\",\"goal\":\"g\",\"complexity\":\"extreme\"}", 1, 0), 0,
      "⭐ a definition refused for its complexity keeps nothing (392 B)");
    var taken = "{\"key\":\"taken\",\"role\":\"r\",\"goal\":\"g\"}";
    _t_cost_once(AGNOSTIC_METHOD_POST, "/api/v1/agents/definitions", taken, 1, 0);
    assert_neq(agnostic_definitions_get(str_from("acme:taken")), 0, "precondition: `taken` is stored");
    assert_eq(_t_cost(AGNOSTIC_METHOD_POST, "/api/v1/agents/definitions", taken, 1, 0), 0,
      "⭐ nor does a 409 for a taken key, refused before it is built");
    assert_eq(_t_cost(AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/absent",
        "{\"key\":\"absent\",\"role\":\"r\",\"goal\":\"g\"}", 1, 0), 0,
      "nor a PUT to an absent definition (404)");
    assert_eq(_t_cost(AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/taken",
        "{\"key\":\"other\",\"role\":\"r\",\"goal\":\"g\"}", 1, 0), 0,
      "nor a PUT whose body names another key (400)");
    # The pre-checks look the key up first. A lookup that misses keeps nothing, so a create
    # that succeeds pays nothing more for them than the store's own check under its lock.
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/agents/definitions/absent", "", 1, 0), 0,
      "a lookup that misses keeps nothing");
}

# ⭐ Past the cache a definition is decoded for the reader, not for the process: through 0.2.1 each
# read kept it on the global heap, 12.8 KB a GET and 778 KB a listing, for anyone with READ.
fn test_definitions_past_the_cache_keep_nothing() {
    test_group("alloc/definitions-past-cache");
    var i = 0;
    while (i < AGNOSTIC_DEFINITIONS_MAX + 2) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "{\"key\":\"past-");
        str_builder_add_int(sb, i);
        str_builder_add_cstr(sb, "\",\"role\":\"r\",\"goal\":\"g\",\"tools\":[\"a\",\"b\"],\"focus\":\"f\"}");
        _t_cost_once(AGNOSTIC_METHOD_POST, "/api/v1/agents/definitions", str_data(str_builder_build(sb)), 1, 0);
        i = i + 1;
    }
    var path = "/api/v1/agents/definitions/past-257";
    assert_eq(agnostic_response_status(_t_get_a(path)), HTTP_OK, "precondition: it is stored");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, path, "", 1, 0), 0, "⭐ a definition past the cache keeps nothing");
    assert_eq(_t_cost(AGNOSTIC_METHOD_GET, "/api/v1/agents/definitions", "", 1, 0), 0, "⭐ nor does listing them");
}

# The status of an authenticated GET of `path`.
fn _t_get_a(path) {
    var a = arena_allocator(1048576);
    var h = alloc_via(a, 7 + str_len(_t_token));
    memcpy(h, "Bearer ", 7);
    memcpy(h + 7, str_data(_t_token), str_len(_t_token));
    var ctx = agnostic_reqctx_new_a(a, str_new_a(a, h, 7 + str_len(_t_token)), 7);
    return agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from_a(a, path), str_from_a(a, ""), 4096, ctx);
}

fn main() {
    alloc_init();
    thread_local_init();
    agnostic_crypto_main_init();
    _t_open();
    test_refusals_keep_nothing();
    test_authenticated_requests_keep_nothing();
    test_login_keeps_nothing();
    test_audited_writes_keep_nothing();
    test_refused_bodies_keep_nothing();
    test_definitions_past_the_cache_keep_nothing();
    test_a_refusal_past_the_budget_keeps_nothing();
    test_a_crew_over_its_limit_keeps_nothing();
    test_a_scrape_keeps_nothing();
    agnostic_audit_close();
    agnostic_store_close();
    _tt_unlink_store(_T_RADB);
    _tt_unlink_store(_T_RAAUDIT);
    return assert_summary();
}

var _agnostic_request_alloc_test_exit = main();
if (_agnostic_request_alloc_test_exit > 0) { _agnostic_request_alloc_test_exit = 1; }
sys_exit_group(_agnostic_request_alloc_test_exit);
