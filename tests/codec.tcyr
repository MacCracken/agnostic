# agnostic/http/codec — allow-list decoding.
#
# This suite is the regression barrier for the oracle's single most damaging
# defect class: Pydantic's extra='ignore' silently discarding client fields.
include "src/strcase.cyr"
include "src/config.cyr"
include "src/trace.cyr"
include "src/log.cyr"
include "src/http/status.cyr"
include "src/http/response.cyr"
include "src/http/codec.cyr"

fn _t_parse(a, s): i64 {
    return agnostic_decode_a(a, str_from(s));
}

fn test_decode_basics() {
    test_group("codec/decode");

    var a = arena_allocator(65536);

    var v = _t_parse(a, "{\"name\":\"crew-1\",\"count\":3,\"live\":true}");
    assert_neq(v, 0, "well-formed object parses");
    assert_eq(bayan_json_v_is_obj(v), 1, "parses as an object");

    assert_eq(agnostic_decode_a(a, str_from("")), 0, "empty body is not valid JSON");
    assert_eq(agnostic_decode_a(a, str_from("{\"a\":")), 0, "truncated JSON returns 0");
    assert_eq(agnostic_decode_a(a, str_from("not json")), 0, "garbage returns 0");

    # What the parser takes and the validator refuses: a string a strict client cannot decode.
    var bad = alloc(16);
    memcpy(bad, "{\"a\":\"x\"}", 9);
    store8(bad + 6, 0xFF);
    assert_eq(agnostic_decode_a(a, str_new(bad, 9)), 0, "raw invalid UTF-8 returns 0");
    store8(bad + 6, 1);
    assert_eq(agnostic_decode_a(a, str_new(bad, 9)), 0, "and so does a raw control byte");
    memcpy(bad, "{\"a\":\"xy\"}", 10);
    store8(bad + 6, 0xC0);
    store8(bad + 7, 0xAF);
    assert_eq(agnostic_decode_a(a, str_new(bad, 10)), 0, "and an overlong form");
}

fn test_allow_list_accepts_known() {
    test_group("codec/allow-known");

    var a = arena_allocator(65536);
    var v = _t_parse(a, "{\"name\":\"crew-1\",\"count\":3}");

    var allowed = agnostic_fields_a(a);
    agnostic_field_a(a, allowed, "name", AGNOSTIC_FK_STRING);
    agnostic_field_a(a, allowed, "count", AGNOSTIC_FK_INT);

    assert_eq(agnostic_no_unknown_fields(v, allowed), 1, "every key is permitted");
    assert_eq(agnostic_unknown_field(v, allowed), 0, "no unknown field to report");

    # A permitted field being absent is fine — the allow-list bounds what MAY
    # appear, not what must.
    var v2 = _t_parse(a, "{\"name\":\"crew-1\"}");
    assert_eq(agnostic_no_unknown_fields(v2, allowed), 1, "a subset of permitted keys is fine");
}

# Every kind, required or not, and what a refusal says. `tests/api_schema.tcyr` proves each real
# body's rows at its door; this proves the rules those rows are read by.
fn test_field_rows() {
    test_group("codec/field-rows");
    var a = arena_allocator(65536);
    var f = agnostic_fields_a(a);
    agnostic_field_req_a(a, f, "name", AGNOSTIC_FK_STRING);
    agnostic_field_a(a, f, "count", AGNOSTIC_FK_INT);
    agnostic_field_a(a, f, "on", AGNOSTIC_FK_BOOL);
    agnostic_field_a(a, f, "doc", AGNOSTIC_FK_OBJECT);
    agnostic_field_a(a, f, "list", AGNOSTIC_FK_ARRAY);
    agnostic_field_a(a, f, "names", AGNOSTIC_FK_STRINGS);
    agnostic_field_a(a, f, "ints", AGNOSTIC_FK_INTS);

    assert_eq(agnostic_field_bad(_t_parse(a, "{\"name\":\"x\"}"), f), 0, "the required field alone passes");
    assert_eq(agnostic_field_bad(_t_parse(a,
          "{\"name\":\"x\",\"count\":1,\"on\":true,\"doc\":{},\"list\":[1,\"a\"],\"names\":[\"a\"],\"ints\":[1]}"), f), 0, #skip-lint
      "every kind, as itself");
    assert_eq(agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"names\":[],\"ints\":[]}"), f), 0,
      "an empty array of either is an array of it");
    assert_eq(agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"count\":null,\"doc\":null}"), f), 0,
      "null in an optional field is the field left out");

    var missing = agnostic_field_bad(_t_parse(a, "{}"), f);
    assert_eq(str_eq_cstr(agnostic_field_name(missing), "name"), 1, "a required field left out is refused");
    assert_eq(str_eq_cstr(agnostic_field_refusal_a(a, missing), "'name' is required and must be a string"), 1,
      "and says so");
    assert_eq(agnostic_field_status(missing), HTTP_BAD_REQUEST, "400 at the crew doors");
    var nul = agnostic_field_bad(_t_parse(a, "{\"name\":null}"), f);
    assert_eq(str_eq_cstr(agnostic_field_name(nul), "name"), 1, "and null in it is the field missing");

    var wrong = agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"count\":\"7\"}"), f);
    assert_eq(str_eq_cstr(agnostic_field_refusal_a(a, wrong), "'count' must be an integer"), 1,
      "\"7\" is not an integer");
    assert_eq(agnostic_field_status(wrong), AGNOSTIC_HTTP_UNPROCESSABLE, "422 for an optional field");
    var flt = agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"count\":1.5}"), f);
    assert_eq(str_eq_cstr(agnostic_field_name(flt), "count"), 1, "nor is 1.5");
    var tru = agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"on\":\"true\"}"), f);
    assert_eq(str_eq_cstr(agnostic_field_refusal_a(a, tru), "'on' must be a boolean"), 1,
      "\"true\" is not a boolean");
    var o = agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"doc\":[]}"), f);
    assert_eq(str_eq_cstr(agnostic_field_refusal_a(a, o), "'doc' must be an object"), 1, "an array is not an object");
    var arr = agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"list\":{}}"), f);
    assert_eq(str_eq_cstr(agnostic_field_refusal_a(a, arr), "'list' must be an array"), 1, "an object is not an array");
    var ns = agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"names\":[\"a\",1]}"), f);
    assert_eq(str_eq_cstr(agnostic_field_refusal_a(a, ns), "'names' must be an array of strings"), 1,
      "one element of the wrong type is enough");
    var nc = agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"names\":\"a\"}"), f);
    assert_eq(str_eq_cstr(agnostic_field_name(nc), "names"), 1, "and a bare string is not an array of them");
    var is = agnostic_field_bad(_t_parse(a, "{\"name\":\"x\",\"ints\":[1,\"2\"]}"), f);
    assert_eq(str_eq_cstr(agnostic_field_refusal_a(a, is), "'ints' must be an array of integers"), 1,
      "of integers too");

    assert_eq(str_eq_cstr(str_from(agnostic_field_kind_type(AGNOSTIC_FK_STRINGS)), "array"), 1,
      "the schema calls an array of strings an array");
    assert_eq(str_eq_cstr(str_from(agnostic_field_kind_items(AGNOSTIC_FK_INTS)), "integer"), 1,
      "and names what it holds");
    assert_eq(agnostic_field_kind_items(AGNOSTIC_FK_ARRAY), 0, "an array its decoder walks names nothing");
}

fn test_allow_list_rejects_unknown() {
    test_group("codec/allow-unknown");

    var a = arena_allocator(65536);

    # ⭐ THE ORACLE DEFECT, IN ONE ASSERTION.
    #
    # ORACLE-AUDIT.md §2.2: fourteen fields were dropped between the API and the
    # engine because Pydantic defaults to extra='ignore'. `gpu_strict` was one —
    # a caller asking for a hard-fail GPU requirement silently got a CPU
    # fallback. §3.3 records the same mechanism eating an entire `tasks` array.
    #
    # An unlisted key must be REJECTED, never discarded.
    var v = _t_parse(a, "{\"name\":\"crew-1\",\"gpu_strict\":true}");

    var allowed = agnostic_fields_a(a);
    agnostic_field_a(a, allowed, "name", AGNOSTIC_FK_STRING);

    assert_eq(agnostic_no_unknown_fields(v, allowed), 0,
      "an unlisted field is rejected, not silently dropped");

    # And the caller is told WHICH field. The oracle reported nothing at all.
    var bad = agnostic_unknown_field(v, allowed);
    assert_neq(bad, 0, "the offending field is reported");
    assert_eq(str_eq_cstr(bad, "gpu_strict"), 1, "reported by name");
}

fn test_allow_list_edges() {
    test_group("codec/allow-edges");

    var a = arena_allocator(65536);
    var allowed = agnostic_fields_a(a);
    agnostic_field_a(a, allowed, "name", AGNOSTIC_FK_STRING);

    # An empty object trivially satisfies any allow-list.
    var empty = _t_parse(a, "{}");
    assert_eq(agnostic_no_unknown_fields(empty, allowed), 1, "empty object passes");

    # A null value is still a null pointer — reject rather than fault.
    assert_eq(agnostic_no_unknown_fields(0, allowed), 0, "null object is rejected, not a fault");
    assert_eq(agnostic_no_unknown_fields(empty, 0), 0, "null allow-list is rejected, not a fault");

    # Matching is exact, not prefix — "nam" and "names" are both unknown.
    var near = _t_parse(a, "{\"names\":\"x\"}");
    assert_eq(agnostic_no_unknown_fields(near, allowed), 0, "near-miss key is not a match");
}

fn test_required_str() {
    test_group("codec/req_str");

    var a = arena_allocator(65536);
    var v = _t_parse(a, "{\"name\":\"crew-1\",\"count\":3}");

    var got = agnostic_req_str(v, str_from("name"));
    assert_neq(got, 0, "present string field returns a value");
    assert_eq(str_eq_cstr(got, "crew-1"), 1, "value is correct");

    assert_eq(agnostic_req_str(v, str_from("missing")), 0, "absent field returns 0");
    assert_eq(agnostic_req_str(v, str_from("count")), 0, "wrong type returns 0, not a coercion");
    assert_eq(agnostic_req_str(0, str_from("name")), 0, "null object returns 0");
}

fn test_optional_str() {
    test_group("codec/opt_str");

    var a = arena_allocator(65536);
    var dflt = str_from("fallback");

    var v = _t_parse(a, "{\"name\":\"crew-1\",\"note\":null,\"count\":3}");

    assert_eq(str_eq_cstr(agnostic_opt_str(v, str_from("name"), dflt), "crew-1"), 1, "present value wins");
    assert_eq(str_eq(agnostic_opt_str(v, str_from("absent"), dflt), dflt), 1, "absent falls back to default");
    assert_eq(str_eq(agnostic_opt_str(v, str_from("note"), dflt), dflt), 1, "JSON null falls back to default");

    # ⚠ Wrong type is NOT the default — it returns 0, distinctly. `{"name": 42}`
    # is a client error, and collapsing it to the default is how a typo becomes
    # a silent default in production.
    assert_eq(agnostic_opt_str(v, str_from("count"), dflt), 0,
      "wrong type returns 0, distinct from the default");
}

fn test_required_int_bool() {
    test_group("codec/req_int_bool");

    var a = arena_allocator(65536);
    var v = _t_parse(a, "{\"count\":3,\"live\":true,\"off\":false,\"name\":\"x\",\"strflag\":\"true\"}");

    assert_eq(agnostic_req_int(v, str_from("count"), 0 - 1), 3, "int field read");
    assert_eq(agnostic_req_int(v, str_from("absent"), 0 - 1), 0 - 1, "absent int gives the sentinel");
    assert_eq(agnostic_req_int(v, str_from("name"), 0 - 1), 0 - 1, "wrong type gives the sentinel");

    assert_eq(agnostic_req_bool(v, str_from("live"), 0 - 1), 1, "true read");
    assert_eq(agnostic_req_bool(v, str_from("off"), 0 - 1), 0, "false read as 0, not as the sentinel");
    assert_eq(agnostic_req_bool(v, str_from("absent"), 0 - 1), 0 - 1, "absent bool gives the sentinel");

    # ⚠ A JSON string "true" is NOT a boolean. Coercing it would make
    # {"gpu_strict": "false"} read as TRUE, since the string is non-empty —
    # exactly the silent misreading this module exists to stop.
    assert_eq(agnostic_req_bool(v, str_from("strflag"), 0 - 1), 0 - 1,
      "a string is not coerced to a boolean");
}

fn test_encode_roundtrip() {
    test_group("codec/encode");

    var a = arena_allocator(65536);
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from("status"), bayan_json_v_str_new_a(a, str_from("ok")));

    var out = agnostic_encode_a(a, obj);
    assert_neq(out, 0, "encode produced bytes");

    # Re-parse what we emitted: a codec whose output its own decoder rejects is
    # broken regardless of how the bytes look.
    var back = agnostic_decode_a(a, out);
    assert_neq(back, 0, "our own output re-parses");
    assert_eq(str_eq_cstr(agnostic_req_str(back, str_from("status")), "ok"), 1, "round-trip preserves the value");
}

var _t_top_value = 0;
# 0.2.3: one key of a stored document, read without a parse.
fn _t_top(json, key) {
    var at = 0;
    var len = 0;
    var r = agnostic_json_top_str(str_from(json), key, &at, &len);
    if (r == 1) { _t_top_value = str_new(at, len); }
    return r;
}

fn test_top_str() {
    test_group("codec/top-str");
    assert_eq(_t_top("{\"a\":1,\"scope\":\"acme\",\"z\":[{}]}", "scope"), 1, "a key among others");
    assert_eq(str_eq_cstr(_t_top_value, "acme"), 1, "its string, without the quotes");
    assert_eq(_t_top(" { \"scope\" : \"acme\" } \n", "scope"), 1, "whitespace is passed over");
    assert_eq(str_eq_cstr(_t_top_value, "acme"), 1, "the same string");
    assert_eq(_t_top("{\"scope\":\"first\",\"scope\":\"second\"}", "scope"), 1, "a repeated key");
    assert_eq(str_eq_cstr(_t_top_value, "first"), 1, "the first wins, as bayan's lookup does");
    assert_eq(_t_top("{\"a\":\"x\\\"scope\\\":\\\"no\",\"scope\":\"yes\"}", "scope"), 1, "a quote inside a string");
    assert_eq(str_eq_cstr(_t_top_value, "yes"), 1, "is not a key");
    assert_eq(_t_top("{\"a\":{\"scope\":\"nested\"}}", "scope"), 0, "⭐ a nested key is not a top-level one");
    assert_eq(_t_top("{\"a\":[\"scope\",\"x\"]}", "scope"), 0, "nor is a string in an array");
    assert_eq(_t_top("{}", "scope"), 0, "an empty object has no key");
    assert_eq(_t_top("{\"scope\":7}", "scope"), 0, "a number is not a string");
    assert_eq(_t_top("{\"scope\":7,\"scope\":\"x\"}", "scope"), 0, "and it stays the first value");
    assert_eq(_t_top("{\"scopes\":\"x\",\"scop\":\"y\"}", "scope"), 0, "a key must match whole");
    assert_eq(_t_top("[\"scope\"]", "scope"), 0 - 1, "an array is not an object");
    assert_eq(_t_top("{\"scope\":\"x\"", "scope"), 0 - 1, "⭐ an object that never closes is refused");
    assert_eq(_t_top("{\"scope\":\"x\"} tail", "scope"), 0 - 1, "and so is anything after it");
    assert_eq(_t_top("{\"scope\":\"x\",}", "scope"), 0 - 1, "and a trailing comma");
    assert_eq(_t_top("{\"scope\":\"x\",\"a\":}", "scope"), 0 - 1, "and a bad value past the key");
    assert_eq(_t_top("", "scope"), 0 - 1, "and nothing at all");
    assert_eq(agnostic_json_top_str(0, "scope", 0, 0), 0 - 1, "and no body");
    return 0;
}

fn main() {
    alloc_init();
    thread_local_init();
    test_decode_basics();
    test_allow_list_accepts_known();
    test_field_rows();
    test_allow_list_rejects_unknown();
    test_allow_list_edges();
    test_required_str();
    test_optional_str();
    test_required_int_bool();
    test_encode_roundtrip();
    test_top_str();
    return assert_summary();
}

var _agnostic_codec_test_exit = main();
if (_agnostic_codec_test_exit > 0) { _agnostic_codec_test_exit = 1; }
sys_exit_group(_agnostic_codec_test_exit);
