# agnostic/http/router — matching, resolution, and the dispatch ladder.
# The whole program, in its canonical order — see src/app.cyr for why this is
# one include rather than a list every suite has to keep in step.
include "src/app.cyr"
include "tests/support/tmp.cyr"   # scratch paths under $TMPDIR (0.1.15)

var _T_ROUTERDB = _tt_tmp_path("router-test");

fn _t_has(s: Str, needle): i64 {
    var n = str_len(s);
    var d = str_data(s);
    var m = 0;
    while ((load8(needle + m) & 0xFF) != 0) { m = m + 1; }
    if (m > n) { return 0; }
    var i = 0;
    while (i <= n - m) {
        var j = 0;
        while (j < m) {
            if ((load8(d + i + j) & 0xFF) != (load8(needle + j) & 0xFF)) { break; }
            j = j + 1;
        }
        if (j == m) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn test_method_parse() {
    test_group("router/method");

    assert_eq(agnostic_method_from(str_from("GET")), AGNOSTIC_METHOD_GET, "GET");
    assert_eq(agnostic_method_from(str_from("POST")), AGNOSTIC_METHOD_POST, "POST");
    assert_eq(agnostic_method_from(str_from("PUT")), AGNOSTIC_METHOD_PUT, "PUT");
    assert_eq(agnostic_method_from(str_from("DELETE")), AGNOSTIC_METHOD_DELETE, "DELETE");

    # An unknown verb maps to NONE, which the table can never match — so it 404s
    # rather than being silently treated as GET.
    assert_eq(agnostic_method_from(str_from("PATCH")), AGNOSTIC_METHOD_NONE, "unknown verb is NONE");
    assert_eq(agnostic_method_from(str_from("get")), AGNOSTIC_METHOD_NONE, "methods are case-sensitive per RFC");
    assert_eq(agnostic_method_from(str_from("")), AGNOSTIC_METHOD_NONE, "empty is NONE");

    # 0.1.13 (H5): the inverse, which the API schema names each route's method with. Every
    # method round-trips through its name; NONE and anything past DELETE have none.
    var m = AGNOSTIC_METHOD_GET;
    var bad = 0;
    while (m <= AGNOSTIC_METHOD_DELETE) {
        var name = agnostic_method_name(m);
        if (name == 0) {
            bad = bad + 1;
        } elif (agnostic_method_from(str_from(name)) != m) {
            bad = bad + 1;
        }
        m = m + 1;
    }
    assert_eq(bad, 0, "each method's name parses back to it");
    assert_eq(str_eq_cstr(str_from(agnostic_method_name(AGNOSTIC_METHOD_DELETE)), "DELETE"), 1, "DELETE is DELETE");
    assert_eq(agnostic_method_name(AGNOSTIC_METHOD_NONE), 0, "NONE has no name");
    assert_eq(agnostic_method_name(AGNOSTIC_METHOD_DELETE + 1), 0, "nor does a value past DELETE");
}

fn test_path_matching() {
    test_group("router/match");

    var a = arena_allocator(65536);
    var param = 0;

    assert_eq(agnostic_path_matches_a(a, str_from("/health"), "/health", &param), 1, "exact match");
    assert_eq(agnostic_path_matches_a(a, str_from("/ready"), "/health", &param), 0, "different literal");
    assert_eq(agnostic_path_matches_a(a, str_from("/health/x"), "/health", &param), 0, "extra segment does not match");
    assert_eq(agnostic_path_matches_a(a, str_from("/heal"), "/health", &param), 0, "prefix does not match");
    assert_eq(agnostic_path_matches_a(a, str_from("/healthy"), "/health", &param), 0, "longer literal does not match");

    # ⚠ A trailing separator introduces one more, EMPTY, segment. Treating
    # "bytes remain" as "another segment" would make /health/ match /health.
    assert_eq(agnostic_path_matches_a(a, str_from("/health/"), "/health", &param), 0,
      "trailing slash is a distinct path");
}

fn test_named_param() {
    test_group("router/param");

    var a = arena_allocator(65536);
    var param = 0;

    assert_eq(agnostic_path_matches_a(a, str_from("/crews/abc"), "/crews/:id", &param), 1, "named param matches");
    assert_neq(param, 0, "param captured");
    assert_eq(str_eq_cstr(param, "abc"), 1, "captured value is correct");

    # An empty segment is not a value.
    assert_eq(agnostic_path_matches_a(a, str_from("/crews/"), "/crews/:id", &param), 0, "empty segment does not fill a param");

    # The param binds exactly one segment, not the remainder.
    assert_eq(agnostic_path_matches_a(a, str_from("/crews/abc/cancel"), "/crews/:id", &param), 0,
      "a param binds one segment, not the rest of the path");

    assert_eq(agnostic_path_matches_a(a, str_from("/crews/abc/cancel"), "/crews/:id/cancel", &param), 1,
      "param mid-pattern matches");
    assert_eq(str_eq_cstr(param, "abc"), 1, "mid-pattern capture is correct");

    # ⭐ The capture is remembered and materialised only on a full match. A
    # pattern that matches its param then fails a later segment must leave
    # nothing behind — this asserts the observable half: no stale capture.
    var stale = str_from("sentinel");
    param = stale;
    assert_eq(agnostic_path_matches_a(a, str_from("/crews/abc/other"), "/crews/:id/cancel", &param), 0,
      "fails on the trailing segment");
    assert_eq(param, 0, "a failed match clears the out-param rather than leaving a partial capture");
}

fn test_query_stripping() {
    test_group("router/query");

    var a = arena_allocator(65536);

    # ⚠ Without stripping, GET /health?probe=1 404s. AgnosAI never strips, so its
    # own health endpoint 404s for any caller appending a cache-buster.
    assert_eq(str_eq_cstr(agnostic_path_only_a(a, str_from("/health?probe=1")), "/health"), 1, "query stripped");
    assert_eq(str_eq_cstr(agnostic_path_only_a(a, str_from("/health#frag")), "/health"), 1, "fragment stripped");
    assert_eq(str_eq_cstr(agnostic_path_only_a(a, str_from("/health")), "/health"), 1, "no query is unchanged");
    assert_eq(str_eq_cstr(agnostic_path_only_a(a, str_from("/health?")), "/health"), 1, "empty query stripped");
}

fn test_resolve() {
    test_group("router/resolve");

    var a = arena_allocator(65536);

    var m = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/health"));
    assert_eq(agnostic_route_match_id(m), AGNOSTIC_ROUTE_HEALTH, "GET /health resolves");

    m = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/ready"));
    assert_eq(agnostic_route_match_id(m), AGNOSTIC_ROUTE_READY, "GET /ready resolves");

    m = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/health?x=1"));
    assert_eq(agnostic_route_match_id(m), AGNOSTIC_ROUTE_HEALTH, "query string does not prevent resolution");

    # The plan route takes a query since 0.1.14 (`?explain=selection&task=N`, ADR 0016): it
    # resolves with one, and the dispatcher hands the handler the raw path — a bad `explain`
    # is the handler's 422, decided before the crew is looked up.
    m = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET,
      str_from("/api/v1/crews/6ba7b810-9dad-11d1-80b4-00c04fd430c8/plan?explain=selection&task=0"));
    assert_eq(agnostic_route_match_id(m), AGNOSTIC_ROUTE_CREW_PLAN, "a plan with a query resolves");
    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
          str_from("/api/v1/crews/6ba7b810-9dad-11d1-80b4-00c04fd430c8/plan?explain=nope"), str_from(""), 1048576, 0)),
      AGNOSTIC_HTTP_UNPROCESSABLE, "and its query reaches the handler");

    m = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/nope"));
    assert_eq(agnostic_route_match_id(m), AGNOSTIC_ROUTE_NONE, "unknown path does not resolve");
    assert_eq(agnostic_route_match_method_mismatch(m), 0, "unknown path is not a method mismatch");

    # ⭐ 405 vs 404. The path exists, the method does not — telling the client
    # "not found" would say the resource does not exist when it does.
    m = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_POST, str_from("/health"));
    assert_eq(agnostic_route_match_id(m), AGNOSTIC_ROUTE_NONE, "wrong method does not resolve");
    assert_eq(agnostic_route_match_method_mismatch(m), 1, "wrong method is flagged as a mismatch, not a miss");
}

# The method for `k` = 0..3, in the table's column order.
fn _t_method(k): i64 {
    if (k == 0) { return AGNOSTIC_METHOD_GET; }
    if (k == 1) { return AGNOSTIC_METHOD_POST; }
    if (k == 2) { return AGNOSTIC_METHOD_PUT; }
    return AGNOSTIC_METHOD_DELETE;
}

# A concrete path for `pattern`: its first `:name` segment becomes `x1`, its second `x2`.
fn _t_concrete(pattern): i64 {
    var sb = str_builder_new();
    var caps = 0;
    var i = 0;
    while ((load8(pattern + i) & 0xFF) != 0) {
        var c = load8(pattern + i) & 0xFF;
        if (c == 58) {
            caps = caps + 1;
            str_builder_putc(sb, 120);          # 'x'
            str_builder_putc(sb, 48 + caps);    # '1', '2'
            while ((load8(pattern + i) & 0xFF) != 0 && (load8(pattern + i) & 0xFF) != 47) { i = i + 1; }
        } else {
            str_builder_putc(sb, c);
            i = i + 1;
        }
    }
    return str_builder_build(sb);
}

# How many `:name` segments `pattern` has.
fn _t_captures(pattern): i64 {
    var n = 0;
    var i = 0;
    while ((load8(pattern + i) & 0xFF) != 0) {
        if ((load8(pattern + i) & 0xFF) == 58) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# 1 when match `m` carries exactly what `_t_concrete` put in a pattern with `caps`
# parameters: `x1` as param and `x2` as param2, and 0 where there is none.
fn _t_carries(m, caps): i64 {
    var p1 = agnostic_route_match_param(m);
    var p2 = agnostic_route_match_param2(m);
    if (caps == 0) {
        if (p1 != 0 || p2 != 0) { return 0; }
        return 1;
    }
    if (p1 == 0) { return 0; }
    if (str_eq_cstr(p1, "x1") != 1) { return 0; }
    if (caps == 1) {
        if (p2 != 0) { return 0; }
        return 1;
    }
    if (p2 == 0) { return 0; }
    return str_eq_cstr(p2, "x2");
}

# How many arms of the table hold `id`.
fn _t_arms_of(id): i64 {
    var n = 0;
    var i = 0;
    while (agnostic_route_row_pattern(i) != 0) {
        var k = 0;
        while (k < 4) {
            if (agnostic_route_row_id(i, _t_method(k)) == id) { n = n + 1; }
            k = k + 1;
        }
        i = i + 1;
    }
    return n;
}

# 1 when C string `c` is `want`; 0 for a null `c`, so a missing header fails by name.
fn _t_cstr_is(c, want): i64 {
    if (c == 0) { return 0; }
    return streq(c, want);
}

fn test_route_table() {
    test_group("router/table");

    var a = arena_allocator(1048576);

    var rows = 0;
    while (agnostic_route_row_pattern(rows) != 0) { rows = rows + 1; }
    assert_eq(rows, 21, "21 rows: 20 paths, `/ui` listed with and without its slash");
    assert_eq(agnostic_route_row_pattern(21), 0, "past the last row there is no pattern");
    assert_eq(agnostic_route_row_pattern(0 - 1), 0, "nor before the first");
    assert_eq(agnostic_route_row_id(21, AGNOSTIC_METHOD_GET), AGNOSTIC_ROUTE_NONE, "nor an id");
    # ⚠ A row that would not fit is refused rather than written past the storage, so
    # a full table may have dropped one: the build must leave room for another.
    assert_eq((rows + 1) * AGNOSTIC_RR_SIZE <= AGNOSTIC_RR_TABLE_BYTES, 1,
      "the table has room for another row, so none was refused");

    # ⭐ Every arm round-trips: its own pattern, made concrete, resolves to its own id,
    # with its captures. An earlier row that shadowed a later one would fail here.
    # A failure prints `got` (what resolved) against `expected` (the arm's id).
    var arms = 0;
    var unnamed = 0 - 1;
    var i = 0;
    while (i < rows) {
        var pattern = agnostic_route_row_pattern(i);
        var path = _t_concrete(pattern);
        var caps = _t_captures(pattern);
        var k = 0;
        while (k < 4) {
            var id = agnostic_route_row_id(i, _t_method(k));
            if (id != AGNOSTIC_ROUTE_NONE) {
                arms = arms + 1;
                var m = agnostic_route_resolve_a(a, _t_method(k), path);
                assert_eq(agnostic_route_match_id(m), id, "a row's own path resolves to its own id");
                var carried = AGNOSTIC_ROUTE_NONE;
                if (_t_carries(m, caps) == 1) { carried = id; }
                assert_eq(carried, id, "and carries x1 as param, x2 as param2, 0 where there is none");
                if (_t_cstr_is(agnostic_route_match_pattern(m), pattern) == 0 && unnamed < 0) { unnamed = i; }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    assert_eq(arms, 27, "27 arms: 26 route ids, the shell's twice");
    # ⭐ 0.1.16 (ADR 0020): and names its own row's pattern — the server span's `http.route`.
    # A failure prints the first row at fault as `got`.
    assert_eq(unnamed, 0 - 1, "every hit names the pattern of the row that answered");

    # Every route id has an arm, and only the shell has two (`/ui`, `/ui/`). A failure
    # prints the first id at fault as `got`.
    var missing = 0;
    var doubled = 0;
    var id2 = AGNOSTIC_ROUTE_HEALTH;
    while (id2 <= AGNOSTIC_ROUTE_AUDIT_ENTRIES) {
        var n = _t_arms_of(id2);
        if (n == 0 && missing == 0) { missing = id2; }
        if (n > 1 && id2 != AGNOSTIC_ROUTE_UI_SHELL && doubled == 0) { doubled = id2; }
        id2 = id2 + 1;
    }
    assert_eq(missing, 0, "every route id from HEALTH to AUDIT_ENTRIES has an arm");
    assert_eq(doubled, 0, "no id but the shell's has two arms");
    assert_eq(_t_arms_of(AGNOSTIC_ROUTE_UI_SHELL), 2, "the shell has two: /ui and /ui/");

    # ⚠ An unknown verb is NONE, and no row has an arm for it: on a known path it is a
    # method mismatch — 405, like any method the path lacks — and on an unknown one a miss.
    var m2 = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_NONE, str_from("/api/v1/crews"));
    assert_eq(agnostic_route_match_id(m2), AGNOSTIC_ROUTE_NONE, "an unknown verb resolves to nothing");
    assert_eq(agnostic_route_match_method_mismatch(m2), 1, "on a known path it is a mismatch");
    m2 = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_NONE, str_from("/nope"));
    assert_eq(agnostic_route_match_method_mismatch(m2), 0, "on an unknown path it is a miss");
    var r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_NONE, str_from("/health"), str_from(""), 1048576, 0);
    assert_eq(agnostic_response_status(r), HTTP_METHOD_NOT_ALLOWED, "so it answers 405, not 404");

    # ⭐ A 405 names the methods its path takes (0.1.15, RFC 9110 §15.5.6). Every row's own
    # path, sent with each method it lacks and with an unknown verb, lists exactly its arms.
    # A failure prints the row's index as `got`.
    var wrong = 0 - 1;
    var probes = 0;
    i = 0;
    while (i < rows) {
        var path2 = _t_concrete(agnostic_route_row_pattern(i));
        var want = 0;
        var k2 = 0;
        while (k2 < 4) {
            if (agnostic_route_row_id(i, _t_method(k2)) != AGNOSTIC_ROUTE_NONE) {
                want = want | (1 << _t_method(k2));
            }
            k2 = k2 + 1;
        }
        k2 = 0;
        while (k2 < 5) {
            var meth = AGNOSTIC_METHOD_NONE;
            if (k2 < 4) { meth = _t_method(k2); }
            if (agnostic_route_row_id(i, meth) == AGNOSTIC_ROUTE_NONE) {
                probes = probes + 1;
                var m3 = agnostic_route_resolve_a(a, meth, path2);
                if (agnostic_route_match_allow(m3) != want && wrong < 0) { wrong = i; }
            }
            k2 = k2 + 1;
        }
        i = i + 1;
    }
    assert_eq(wrong, 0 - 1, "every row's path, sent a method it lacks, allows exactly its arms");
    assert_eq(probes, 21 * 5 - 27, "one probe for each method a row lacks, and the unknown verb");
    var hit = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/health"));
    assert_eq(agnostic_route_match_allow(hit), 0, "a hit allows nothing: only a 405 reads it");
    var miss = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/nope"));
    assert_eq(agnostic_route_match_allow(miss), 0, "nor does a path no row has");
    assert_eq(agnostic_route_match_pattern(miss), 0, "a 404 names no route");
    assert_eq(agnostic_route_match_pattern(agnostic_route_resolve_a(a, AGNOSTIC_METHOD_POST, str_from("/health"))), 0,
      "nor does a 405: no row answered its method");
    assert_eq(agnostic_route_match_pattern(0), 0, "nor no match at all");

    # Dispatch hands the pattern to the request context, where the serve adapter reads it.
    var rc = agnostic_reqctx_new_a(a, 0, 0);
    assert_eq(agnostic_reqctx_route(rc), 0, "a new context names no route");
    agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/presets/x?y=1"), str_from(""), 1048576, rc);
    assert_eq(_t_cstr_is(agnostic_reqctx_route(rc), "/api/v1/presets/:name"), 1,
      "⭐ dispatch records the pattern, not the path or its query");
    var rc2 = agnostic_reqctx_new_a(a, 0, 0);
    agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/nope"), str_from(""), 1048576, rc2);
    assert_eq(agnostic_reqctx_route(rc2), 0, "and none for a 404");
    assert_eq(agnostic_reqctx_route(0) + agnostic_reqctx_set_route(0, "/x"), 0, "no context, no route");

    # The header line, in the table's column order.
    var line = agnostic_route_allow_header_a(a, (1 << AGNOSTIC_METHOD_DELETE) | (1 << AGNOSTIC_METHOD_GET)
      | (1 << AGNOSTIC_METHOD_PUT));
    assert_eq(_t_cstr_is(line, "Allow: GET, PUT, DELETE\r\n"), 1, "methods in column order, comma-separated");
    assert_eq(agnostic_route_allow_header_a(a, 0), 0, "an empty mask is no header");
    r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/health"), str_from(""), 1048576, 0);
    assert_eq(_t_cstr_is(agnostic_response_headers(r), "Allow: GET\r\n"), 1, "and the 405 carries it");
    r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/nope"), str_from(""), 1048576, 0);
    assert_eq(agnostic_response_headers(r), 0, "a 404 carries none");
}

fn test_needs_auth() {
    test_group("router/auth-seam");

    # Probes stay public: an orchestrator cannot present a credential, and a
    # readiness check behind auth fails closed for the wrong reason.
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_HEALTH), 0, "health is public");
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_READY), 0, "ready is public");
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_NONE), 0, "no route needs no auth");

    # ⭐ Anything not explicitly classified requires auth, so forgetting to
    # classify a future route fails SAFE rather than exposing it.
    assert_eq(agnostic_route_needs_auth(99), 1, "an unclassified route id defaults to requiring auth");
}

fn test_dispatch() {
    test_group("router/dispatch");

    var a = arena_allocator(65536);
    var empty = str_from("");
    agnostic_ready_reset();

    var r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/health"), empty, 1048576, 0);
    assert_eq(agnostic_response_status(r), HTTP_OK, "GET /health dispatches to 200");

    r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/ready"), empty, 1048576, 0);
    assert_eq(agnostic_response_status(r), HTTP_OK, "GET /ready dispatches to 200");

    r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/nope"), empty, 1048576, 0);
    assert_eq(agnostic_response_status(r), HTTP_NOT_FOUND, "unknown path is 404");

    r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST, str_from("/health"), empty, 1048576, 0);
    assert_eq(agnostic_response_status(r), HTTP_METHOD_NOT_ALLOWED, "wrong method is 405, not 404");
}

fn test_body_limit() {
    test_group("router/body-limit");

    var a = arena_allocator(65536);
    var big = str_from("0123456789");

    # ⭐ The size check runs BEFORE routing. A 20 MB body aimed at a bad path
    # should be rejected on size, not parsed to discover it has nowhere to go.
    var r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/nope"), big, 5, 0);
    assert_eq(agnostic_response_status(r), HTTP_PAYLOAD_TOO_LARGE,
      "oversize body is 413 even for a path that would 404");

    r = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/health"), big, 10, 0);
    assert_eq(agnostic_response_status(r), HTTP_OK, "a body exactly at the limit is accepted");
}

fn test_preset_routes() {
    test_group("router/presets");

    var a = arena_allocator(65536);

    var l = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/presets"));
    assert_eq(agnostic_route_match_id(l), AGNOSTIC_ROUTE_PRESET_LIST, "GET /api/v1/presets");

    var g = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/presets/quality-lean"));
    assert_eq(agnostic_route_match_id(g), AGNOSTIC_ROUTE_PRESET_GET, "GET /api/v1/presets/{name}");
    assert_eq(str_eq_cstr(agnostic_route_match_param(g), "quality-lean"), 1, "the name is captured");

    # ⚠ The library is READ-ONLY in M3, and the paths are still in the table — so
    # a write earns a 405 naming the mismatch rather than a 404 claiming the
    # collection does not exist. Creating a preset is a durable object: M4.
    var post = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/presets"));
    assert_eq(agnostic_route_match_id(post), AGNOSTIC_ROUTE_NONE, "POST does not resolve");
    assert_eq(agnostic_route_match_method_mismatch(post), 1, "but reports a method mismatch, not a miss");

    var del = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_DELETE, str_from("/api/v1/presets/quality-lean"));
    assert_eq(agnostic_route_match_method_mismatch(del), 1, "and so does DELETE on one");

    # Every preset route is privileged; the default in `agnostic_route_needs_auth`
    # is what protects a route nobody remembered to classify.
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_PRESET_LIST), 1, "listing needs auth");
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_PRESET_GET), 1, "fetching needs auth");
}

fn test_preset_dispatch() {
    test_group("router/preset-dispatch");

    agnostic_presets_reset();
    agnostic_presets_init();
    var a = arena_allocator(262144);

    var list = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/presets"),
      str_from(""), 1048576, 0);
    assert_eq(agnostic_response_status(list), HTTP_OK, "the listing answers 200");
    var body = agnostic_response_body(list);
    assert_eq(bayan_json_v_int(bayan_json_v_obj_get_by_str(body, AGNOSTIC_JK_TOTAL)), 18,
      "with all eighteen");

    var one = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
      str_from("/api/v1/presets/devops-lean"), str_from(""), 1048576, 0);
    assert_eq(agnostic_response_status(one), HTTP_OK, "a known preset answers 200");
    assert_eq(str_eq_cstr(agnostic_req_str(agnostic_response_body(one), AGNOSTIC_JK_NAME),
        "devops-lean"), 1, "with the document it names");

    var miss = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
      str_from("/api/v1/presets/no-such-thing"), str_from(""), 1048576, 0);
    assert_eq(agnostic_response_status(miss), HTTP_NOT_FOUND, "an unknown name is 404");

    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST,
          str_from("/api/v1/presets"), str_from(""), 1048576, 0)), HTTP_METHOD_NOT_ALLOWED,
      "and a write is 405");
}

fn test_definition_routes() {
    test_group("router/definitions");

    var a = arena_allocator(65536);

    var l = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/agents/definitions"));
    assert_eq(agnostic_route_match_id(l), AGNOSTIC_ROUTE_DEF_LIST, "GET list");
    var c = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/agents/definitions"));
    assert_eq(agnostic_route_match_id(c), AGNOSTIC_ROUTE_DEF_CREATE, "POST create");

    var g = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/agents/definitions/qa-1"));
    assert_eq(agnostic_route_match_id(g), AGNOSTIC_ROUTE_DEF_GET, "GET one");
    assert_eq(str_eq_cstr(agnostic_route_match_param(g), "qa-1"), 1, "the key is captured");
    var p = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_PUT, str_from("/api/v1/agents/definitions/qa-1"));
    assert_eq(agnostic_route_match_id(p), AGNOSTIC_ROUTE_DEF_REPLACE, "PUT replace");
    var dl = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_DELETE, str_from("/api/v1/agents/definitions/qa-1"));
    assert_eq(agnostic_route_match_id(dl), AGNOSTIC_ROUTE_DEF_DELETE, "DELETE one");

    # ⚠ The collection and the item cannot swallow each other: the matcher
    # requires an exact segment count, 4 against 5.
    assert_eq(agnostic_route_match_id(agnostic_route_resolve_a(a, AGNOSTIC_METHOD_PUT,
          str_from("/api/v1/agents/definitions"))), AGNOSTIC_ROUTE_NONE, "PUT on the collection does not resolve");

    # `/api/v1/agents` alone is deliberately not a route — an "agents" collection
    # would mean running agents, which are not addressable objects.
    var bare = agnostic_route_resolve_a(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/agents"));
    assert_eq(agnostic_route_match_id(bare), AGNOSTIC_ROUTE_NONE, "/api/v1/agents is not a route");
    assert_eq(agnostic_route_match_method_mismatch(bare), 0, "and 404s rather than 405s");

    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_DEF_CREATE), 1, "create needs auth");
    assert_eq(agnostic_route_needs_auth(AGNOSTIC_ROUTE_DEF_DELETE), 1, "delete needs auth");
}

# A request context carrying `If-Match: <tag>` (a Str, or 0 for none).
fn _t_if_match(a, tag) {
    var c = agnostic_reqctx_new_a(a, 0, 0);
    agnostic_reqctx_set_headers(c, 0, 0, tag, 0);
    return c;
}

# A definition route's answer: method, path, body (C strings) and `If-Match`.
fn _t_def_req(a, method, path, body, tag) {
    return agnostic_route_dispatch_a(a, method, str_from(path), str_from(body), 1048576, _t_if_match(a, tag));
}

# The `ETag` header line a response carries, as the tag between `ETag: ` and CRLF, or 0.
fn _t_etag_header(r) {
    var h = agnostic_response_headers(r);
    if (h == 0) { return 0; }
    var n = strlen(h);
    if (n < 8 || memeq(h, "ETag: ", 6) == 0) { return 0; }
    return str_from_buf(h + 6, n - 8);
}

# ⭐ 0.1.15: a definition has a revision, and a write made from an old one is refused. Until then
# the Library edited with a last-writer-wins PUT: of two editors, the second undid the first.
fn test_definition_revisions() {
    test_group("router/definition-revisions");

    agnostic_definitions_open(str_from(_T_ROUTERDB));
    agnostic_definitions_reset();
    var a = arena_allocator(1048576);
    var c = _t_def_req(a, AGNOSTIC_METHOD_POST, "/api/v1/agents/definitions",
      "{\"key\":\"rev-1\",\"role\":\"tester\",\"goal\":\"find bugs\"}", 0);
    assert_eq(agnostic_response_status(c), AGNOSTIC_HTTP_CREATED, "created");
    var t1 = agnostic_req_str(agnostic_response_body(c), AGNOSTIC_JK_ETAG);
    assert_neq(t1, 0, "a create answers its revision as etag");
    if (t1 == 0) { return 0; }
    assert_eq(str_len(t1), 18, "a quoted 16-hex tag, the format plugin documents use");
    var h1 = _t_etag_header(c);
    assert_eq(h1 != 0 && str_eq(h1, t1) == 1, 1, "and as an ETag header");

    var g = _t_def_req(a, AGNOSTIC_METHOD_GET, "/api/v1/agents/definitions/rev-1", "", 0);
    var gh = _t_etag_header(g);
    assert_eq(gh != 0 && str_eq(gh, t1) == 1, 1, "a GET names the same revision");

    # Their write, from the current revision, lands and moves it.
    var put_theirs = _t_def_req(a, AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/rev-1",
      "{\"key\":\"rev-1\",\"role\":\"tester\",\"goal\":\"their goal\"}", t1);
    assert_eq(agnostic_response_status(put_theirs), HTTP_OK, "a PUT from the current revision is 200");
    var t2 = agnostic_req_str(agnostic_response_body(put_theirs), AGNOSTIC_JK_ETAG);
    assert_eq(t2 != 0 && str_eq(t2, t1) == 0, 1, "and answers a new revision");

    # Mine, from the old one, is refused and changes nothing.
    var put_mine = _t_def_req(a, AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/rev-1",
      "{\"key\":\"rev-1\",\"role\":\"tester\",\"goal\":\"my goal\"}", t1);
    assert_eq(agnostic_response_status(put_mine), AGNOSTIC_HTTP_PRECONDITION_FAILED,
      "⭐ a PUT from an old revision is 412");
    var code = agnostic_req_str(agnostic_response_body(put_mine), AGNOSTIC_JK_CODE);
    assert_eq(code != 0 && str_eq_cstr(code, "revision") == 1, 1, "with code revision");
    var now = agnostic_definitions_get(str_from("rev-1"));
    assert_eq(str_eq_cstr(agnosai_agent_goal(agnostic_agent_def_engine(now)), "their goal"), 1, "⭐ and theirs stands");

    # A precondition is checked before the body is read (RFC 9110 §13.2.1), and an absent
    # definition is still 404 with one.
    assert_eq(agnostic_response_status(_t_def_req(a, AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/rev-1",
          "{}", t1)), AGNOSTIC_HTTP_PRECONDITION_FAILED, "a stale tag is 412 whatever the body");
    assert_eq(agnostic_response_status(_t_def_req(a, AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/absent",
          "{\"key\":\"absent\",\"role\":\"r\",\"goal\":\"g\"}", t1)), HTTP_NOT_FOUND,
      "an absent definition is 404, with If-Match or without");
    assert_eq(agnostic_response_status(_t_def_req(a, AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/rev-1",
          "{\"key\":\"rev-1\",\"role\":\"tester\",\"goal\":\"any goal\"}", str_from("*"))), HTTP_OK,
      "If-Match: * means only that it exists");
    assert_eq(agnostic_response_status(_t_def_req(a, AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/rev-1",
          "{\"key\":\"rev-1\",\"role\":\"tester\",\"goal\":\"no tag\"}", 0)), HTTP_OK,
      "and a PUT without one is unconditional, as before");

    # Delete: from an old revision refused, from the current one done.
    assert_eq(agnostic_response_status(_t_def_req(a, AGNOSTIC_METHOD_DELETE, "/api/v1/agents/definitions/rev-1",
          "", t2)), AGNOSTIC_HTTP_PRECONDITION_FAILED, "⭐ a DELETE from an old revision is 412");
    assert_neq(agnostic_definitions_get(str_from("rev-1")), 0, "and deletes nothing");
    var cur = _t_etag_header(_t_def_req(a, AGNOSTIC_METHOD_GET, "/api/v1/agents/definitions/rev-1", "", 0));
    assert_eq(agnostic_response_status(_t_def_req(a, AGNOSTIC_METHOD_DELETE, "/api/v1/agents/definitions/rev-1",
          "", cur)), HTTP_OK, "a DELETE from the current revision is 200");
    assert_eq(agnostic_definitions_get(str_from("rev-1")), 0, "and it is gone");
    return 0;
}

# ⭐ 0.1.15: a definition's `complexity` is one of the three at the door, and one stored before
# then with another value is read as it is.
fn test_definition_complexity() {
    test_group("router/definition-complexity");

    agnostic_definitions_open(str_from(_T_ROUTERDB));
    agnostic_definitions_reset();
    var a = arena_allocator(1048576);
    var bad = _t_def_req(a, AGNOSTIC_METHOD_POST, "/api/v1/agents/definitions",
      "{\"key\":\"cx-1\",\"role\":\"r\",\"goal\":\"g\",\"complexity\":\"extreme\"}", 0);
    assert_eq(agnostic_response_status(bad), HTTP_BAD_REQUEST, "⭐ a POST with another complexity is 400");
    assert_eq(agnostic_definitions_get(str_from("cx-1")), 0, "and stores nothing");

    # A definition stored before 0.1.15 with another value: written past the door, as it was.
    var v = agnostic_decode_a(a, str_from("{\"key\":\"cx-old\",\"role\":\"r\",\"goal\":\"g\",\"complexity\":\"extreme\"}"));
    var rj: i64[1];
    var d = agnostic_agent_def_decode_a(default_alloc(), v, 0 - 1, &rj);
    assert_neq(d, 0, "precondition: the decoder still accepts it");
    assert_eq(agnostic_definitions_create(str_from("cx-old"), d), AGNOSTIC_DEF_OK, "precondition: stored");
    agnostic_definitions_close();
    agnostic_definitions_open(str_from(_T_ROUTERDB));
    var g = _t_def_req(a, AGNOSTIC_METHOD_GET, "/api/v1/agents/definitions/cx-old", "", 0);
    assert_eq(agnostic_response_status(g), HTTP_OK, "⭐ a stored one is read as it is, after a restart");
    var put_same = _t_def_req(a, AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/cx-old",
      "{\"key\":\"cx-old\",\"role\":\"r\",\"goal\":\"g\",\"complexity\":\"extreme\"}", 0);
    assert_eq(agnostic_response_status(put_same), HTTP_BAD_REQUEST, "but cannot be saved again as it is");
    var put_fixed = _t_def_req(a, AGNOSTIC_METHOD_PUT, "/api/v1/agents/definitions/cx-old",
      "{\"key\":\"cx-old\",\"role\":\"r\",\"goal\":\"g\",\"complexity\":\"high\"}", 0);
    assert_eq(agnostic_response_status(put_fixed), HTTP_OK, "only with one of the three");
    return 0;
}

fn test_definition_dispatch() {
    test_group("router/definition-dispatch");

    # The store is patra-backed as of M4, so the routes need a database open —
    # without one, `create` answers MISSING and the handler 500s. That is the
    # right failure: a route that cannot persist must not report success.
    agnostic_definitions_open(str_from(_T_ROUTERDB));
    agnostic_definitions_reset();
    var a = arena_allocator(262144);
    var body = "{\"key\":\"qa-1\",\"role\":\"tester\",\"goal\":\"find bugs\",\"focus\":\"orchestration\"}";

    var created = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST,
      str_from("/api/v1/agents/definitions"), str_from(body), 1048576, 0);
    assert_eq(agnostic_response_status(created), AGNOSTIC_HTTP_CREATED,
      "creating a definition is 201, not 202 — it is complete when the call returns");

    var cb = agnostic_response_body(created);
    assert_eq(str_eq_cstr(agnostic_req_str(cb, AGNOSTIC_JK_STORAGE), "patra"), 1,
      "and every response says where it lives — 'patra' since M4, one literal");
    assert_eq(bayan_json_v_arr_len(bayan_json_v_obj_get_by_str(cb, AGNOSTIC_JK_UNFORWARDED)), 1,
      "naming the field that was retained but shapes nothing");

    # 409, not an upsert.
    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_POST,
          str_from("/api/v1/agents/definitions"), str_from(body), 1048576, 0)), AGNOSTIC_HTTP_CONFLICT,
      "creating the same key twice is 409");

    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
          str_from("/api/v1/agents/definitions/qa-1"), str_from(""), 1048576, 0)), HTTP_OK, "GET one is 200");
    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
          str_from("/api/v1/agents/definitions/absent"), str_from(""), 1048576, 0)), HTTP_NOT_FOUND,
      "an absent key is 404");
    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
          str_from("/api/v1/agents/definitions/NOT_A_KEY"), str_from(""), 1048576, 0)),
      AGNOSTIC_HTTP_UNPROCESSABLE, "a malformed key is 422, not 404");

    # PUT to an absent key never creates.
    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_PUT,
          str_from("/api/v1/agents/definitions/absent"),
          str_from("{\"key\":\"absent\",\"role\":\"r\",\"goal\":\"g\"}"), 1048576, 0)),
      HTTP_NOT_FOUND, "PUT to an absent key is 404, never a quiet create");

    # A body whose key disagrees with the path is a 400, not a silent preference.
    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_PUT,
          str_from("/api/v1/agents/definitions/qa-1"),
          str_from("{\"key\":\"other\",\"role\":\"r\",\"goal\":\"g\"}"), 1048576, 0)),
      HTTP_BAD_REQUEST, "a body key that disagrees with the path is 400");

    var listed = agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
      str_from("/api/v1/agents/definitions"), str_from(""), 1048576, 0);
    assert_eq(bayan_json_v_int(bayan_json_v_obj_get_by_str(
          agnostic_response_body(listed), AGNOSTIC_JK_TOTAL)), 1, "the listing counts what it returned");

    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_DELETE,
          str_from("/api/v1/agents/definitions/qa-1"), str_from(""), 1048576, 0)), HTTP_OK, "DELETE is 200");
    assert_eq(agnostic_response_status(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_DELETE,
          str_from("/api/v1/agents/definitions/qa-1"), str_from(""), 1048576, 0)), HTTP_NOT_FOUND,
      "and deleting twice is 404");
}

fn main() {
    alloc_init();
    thread_local_init();
    test_method_parse();
    test_definition_routes();
    test_definition_dispatch();
    test_definition_revisions();
    test_definition_complexity();
    test_preset_routes();
    test_preset_dispatch();
    test_path_matching();
    test_named_param();
    test_query_stripping();
    test_resolve();
    test_route_table();
    test_needs_auth();
    test_dispatch();
    test_body_limit();
    _tt_unlink_store(_T_ROUTERDB);
    return assert_summary();
}

var _agnostic_router_test_exit = main();
if (_agnostic_router_test_exit > 0) { _agnostic_router_test_exit = 1; }
sys_exit_group(_agnostic_router_test_exit);
