# agnostic/trace — thread-local request ids.
#
# Stdlib is auto-prepended from cyrius.cyml; do NOT include a stdlib module here.
include "src/strcase.cyr"
include "src/config.cyr"
include "src/trace.cyr"

# ⚠ **`thread_local_init()` is not optional in this suite.**
#
# `thread_local_set` faults on a thread whose local table has not been
# initialised. Under the server, sandhi initialises each pooled worker before it
# runs a handler — but a .tcyr `main()` is a bare thread that nobody initialised,
# so the FIRST `agnostic_trace_set` here segfaults without this call. The failure
# is a hard crash with no assertion output, which reads like a compiler problem
# rather than a missing setup call.

fn test_slot_claimed() {
    test_group("trace/slot");

    # The slot is claimed at load time, before main(). Slots are handed out
    # monotonically from 16, so a real slot is >= 16 — 0 would mean the top-level
    # initialiser silently evaluated to 0, which is the Cyrius failure mode where
    # a top-level var reads a global declared later.
    assert_gte(AGNOSTIC_TRACE_SLOT, 16, "slot claimed at load, outside the reserved 0-15 range");
}

fn test_set_current_roundtrip() {
    test_group("trace/set-current");

    agnostic_trace_clear();
    assert_eq(agnostic_trace_current(), 0, "a cleared slot reads 0");

    var tp = str_from("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01");
    agnostic_trace_set(tp);
    assert_eq(str_eq(agnostic_trace_current(), tp), 1, "set then current round-trips");

    agnostic_trace_clear();
    assert_eq(agnostic_trace_current(), 0, "clear resets to 0");
}

fn test_generate() {
    test_group("trace/generate");

    var a = arena_allocator(65536);
    assert_neq(a, 0, "test arena allocated");

    var t1 = agnostic_trace_generate_a(a);
    assert_neq(t1, 0, "generate returns a Str");
    assert_eq(str_len(t1), AGNOSTIC_TRACE_LEN, "traceparent is exactly 55 bytes");

    var d = str_data(t1);
    assert_eq(load8(d) & 0xFF, 48, "version high nibble is '0'");
    assert_eq(load8(d + 1) & 0xFF, 48, "version low nibble is '0'");
    assert_eq(load8(d + 2) & 0xFF, 45, "dash after version");
    assert_eq(load8(d + 35) & 0xFF, 45, "dash after 32-hex trace id");
    assert_eq(load8(d + 52) & 0xFF, 45, "dash after 16-hex span id");
    assert_eq(load8(d + 53) & 0xFF, 48, "flags high is '0'");
    assert_eq(load8(d + 54) & 0xFF, 49, "flags low is '1' — sampled");

    # Every byte of both ids must be lowercase hex. A bug in the nibble->ASCII
    # map shows up here rather than as a mysterious downstream parse failure.
    var i = 3;
    var non_hex = 0;
    while (i < 52) {
        if (i != 35) {
            var c = load8(d + i) & 0xFF;
            var ok = 0;
            if (c >= 48) { if (c <= 57) { ok = 1; } }
            if (c >= 97) { if (c <= 102) { ok = 1; } }
            if (ok == 0) { non_hex = non_hex + 1; }
        }
        i = i + 1;
    }
    assert_eq(non_hex, 0, "every id byte is lowercase hex");

    # Two consecutive ids must differ. If the random source degrades to zeros the
    # counter-and-clock mix in the span id still separates them, which is exactly
    # what that mix is for.
    var t2 = agnostic_trace_generate_a(a);
    assert_eq(str_eq(t1, t2), 0, "consecutive ids differ");
}

fn test_generate_exhausted_arena() {
    test_group("trace/arena-exhaustion");

    # ⭐ THE M1 GATE. A full arena answers 0, and a Str of 0 is indistinguishable
    # from a valid one — there is no option type and no error channel through the
    # _a families. Anything that does not check will carry the 0 forward and fault
    # at the first dereference, far from the cause.
    #
    # A 16-byte arena cannot hold a 56-byte buffer, so alloc_via must fail.
    var tiny = arena_allocator(16);
    assert_neq(tiny, 0, "tiny arena itself allocated");

    var t = agnostic_trace_generate_a(tiny);
    assert_eq(t, 0, "generate returns 0 rather than a half-built Str when the arena is full");
}

# Which inbound traceparents are honoured (0.1.14, ADR 0018): exactly the ones the engine's own
# parser accepts, so a request's log lines and its crew's spans share one trace id.
fn test_valid() {
    test_group("trace/valid");
    var a = arena_allocator(65536);

    var spec = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01";
    assert_eq(agnostic_trace_valid_a(a, str_from(spec)), 1, "the W3C specification's example");
    assert_eq(agnostic_trace_valid_a(a, str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00")), 1,
      "not sampled is still valid (and honoured downstream)");
    assert_eq(agnostic_trace_valid_a(a, agnostic_trace_generate_a(a)), 1, "every id this server mints");

    assert_eq(agnostic_trace_valid_a(a, 0), 0, "no header");
    assert_eq(agnostic_trace_valid_a(a, str_from("00-4BF92F3577B34DA6A3CE929D0E0E4736-00f067aa0ba902b7-01")), 0,
      "uppercase hex: no conforming sender writes it");
    assert_eq(agnostic_trace_valid_a(a, str_from("01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")), 0,
      "another version");
    assert_eq(agnostic_trace_valid_a(a, str_from("ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")), 0,
      "the forbidden version");
    assert_eq(agnostic_trace_valid_a(a, str_from("00-00000000000000000000000000000000-00f067aa0ba902b7-01")), 0,
      "an all-zero trace id");
    assert_eq(agnostic_trace_valid_a(a, str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01")), 0,
      "an all-zero parent id");
    assert_eq(agnostic_trace_valid_a(a, str_from("00_4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01")), 0,
      "a separator out of place");
    assert_eq(agnostic_trace_valid_a(a, str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0g")), 0,
      "flags that are not hex");
    assert_eq(agnostic_trace_valid_a(a, str_from("00-4bf92f3577b34da6a3ce929d0e0e473-00f067aa0ba902b7-01")), 0,
      "one byte short — the length check alone let 55-byte garbage through until 0.1.14");
    assert_eq(agnostic_trace_valid_a(a, str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01x")), 0,
      "one byte long");
    assert_eq(agnostic_trace_valid_a(a, str_from("zz-zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz-zzzzzzzzzzzzzzzz-zz")), 0,
      "55 bytes of garbage");
}

# 1 when `a` and `b` (traceparents) agree on bytes [from, to).
fn _t_same_bytes(a, b, from, to) {
    var i = from;
    while (i < to) {
        if ((load8(str_data(a) + i) & 255) != (load8(str_data(b) + i) & 255)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# ⭐ 0.1.16 (ADR 0020): a child of an inbound traceparent is agnostic's own span under the
# caller's — the same trace id and flags, a span id of its own.
fn test_child() {
    test_group("trace/child");
    var a = arena_allocator(65536);
    var inbound = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");

    var c = agnostic_trace_child_a(a, inbound);
    assert_neq(c, 0, "a child is minted");
    if (c == 0) { return 0; }
    assert_eq(str_len(c), AGNOSTIC_TRACE_LEN, "55 bytes");
    assert_eq(_t_same_bytes(c, inbound, 0, 36), 1, "the same version and trace id");
    assert_eq(_t_same_bytes(c, inbound, 52, 55), 1, "the same flags");
    assert_eq(_t_same_bytes(c, inbound, 36, 52), 0, "⭐ and a span id of its own");
    assert_eq(agnostic_trace_valid_a(a, c), 1, "a traceparent the engine accepts");
    assert_eq(str_eq(c, agnostic_trace_child_a(a, inbound)), 0, "two children differ");

    var off = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00");
    var oc = agnostic_trace_child_a(a, off);
    assert_eq(_t_same_bytes(oc, off, 52, 55), 1, "⭐ an unsampled caller's child is unsampled too");

    assert_eq(agnostic_trace_child_a(arena_allocator(16), inbound), 0, "an exhausted arena answers 0");
}

# A raw request carrying `header` (a C string ending CRLF, or "" for none).
fn _t_req(header) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "GET /health HTTP/1.1\r\nHost: 127.0.0.1\r\n");
    str_builder_add_cstr(sb, header);
    str_builder_add_cstr(sb, "\r\n");
    return str_builder_build(sb);
}

# What `agnostic_trace_begin_a` sets for a request: the current id, and its parent.
fn test_begin() {
    test_group("trace/begin");
    var a = arena_allocator(65536);
    var inbound = str_from("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01");

    var r = _t_req("traceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\n");
    var tp = agnostic_trace_begin_a(a, str_data(r), str_len(r));
    assert_eq(str_eq(agnostic_trace_current(), tp), 1, "begin sets the id it answers");
    assert_eq(str_eq(agnostic_trace_parent(), inbound), 1, "⭐ the inbound header is the parent");
    assert_eq(_t_same_bytes(tp, inbound, 0, 36), 1, "the current id keeps the caller's trace id");
    assert_eq(_t_same_bytes(tp, inbound, 36, 52), 0, "⭐ under a span id of agnostic's own");

    r = _t_req("");
    tp = agnostic_trace_begin_a(a, str_data(r), str_len(r));
    assert_eq(agnostic_trace_parent(), 0, "no header: no parent — the minted id is a root");
    assert_eq(agnostic_trace_valid_a(a, tp), 1, "and a valid one");

    r = _t_req("traceparent: 00-4BF92F3577B34DA6A3CE929D0E0E4736-00f067aa0ba902b7-01\r\n");
    tp = agnostic_trace_begin_a(a, str_data(r), str_len(r));
    assert_eq(agnostic_trace_parent(), 0, "a header the engine refuses is no parent either");
    assert_eq(_t_same_bytes(tp, inbound, 3, 35), 0, "and the minted id is a new trace");

    r = _t_req("traceparent: 00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01\r\n");
    agnostic_trace_begin_a(a, str_data(r), str_len(r));
    agnostic_trace_clear();
    assert_eq(agnostic_trace_current() + agnostic_trace_parent(), 0, "clear resets both slots");
    assert_gte(AGNOSTIC_TRACE_PARENT_SLOT, 16, "the parent slot is claimed at load too");
    assert_neq(AGNOSTIC_TRACE_PARENT_SLOT, AGNOSTIC_TRACE_SLOT, "and is its own");
}

fn main() {
    alloc_init();
    # See the header — without this the first trace_set segfaults.
    thread_local_init();

    test_slot_claimed();
    test_set_current_roundtrip();
    test_generate();
    test_generate_exhausted_arena();
    test_valid();
    test_child();
    test_begin();
    return assert_summary();
}

var _agnostic_trace_test_exit = main();
if (_agnostic_trace_test_exit > 0) { _agnostic_trace_test_exit = 1; }
sys_exit_group(_agnostic_trace_test_exit);
