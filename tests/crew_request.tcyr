# agnostic/engine/request — one task model, and every field forwarded or refused.
#
# ORACLE-AUDIT.md §3.3: the oracle's request model declared no `tasks` field, so
# a client-supplied `tasks` array was silently discarded and a single-task
# fallback ran instead — every time, with no error. §2.2 records fourteen more
# fields dropped the same way, `gpu_strict` being the one that turned a hard-fail
# GPU requirement into a silent CPU fallback.
#
# This suite is the barrier for both.
include "src/strcase.cyr"
include "src/config.cyr"
include "src/trace.cyr"
include "src/log.cyr"
include "src/http/status.cyr"
include "src/http/response.cyr"
include "src/http/codec.cyr"
include "src/engine/reject.cyr"
include "src/engine/agentdef.cyr"
include "src/engine/request.cyr"

fn _t_has(s: Str, needle): i64 {
    var n = str_len(s);
    var d = str_data(s);
    var m = 0;
    while ((load8(needle + m) & 0xFF) != 0) { m = m + 1; }
    if (m > n) { return 0; }
    var i = 0;
    while (i <= n - m) {
        var j = 0;
        while (j < m) {
            if ((load8(d + i + j) & 0xFF) != (load8(needle + j) & 0xFF)) { break; }
            j = j + 1;
        }
        if (j == m) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Decode `body`; returns the request, leaving the rejection in `out`.
fn _t_decode(a, body, out): i64 {
    store64(out, 0);
    var v = agnostic_decode_a(a, str_from(body));
    if (v == 0) { return 0; }
    return agnostic_crew_req_from_value_a(a, v, out);
}

# A minimal valid submission with one agent and one task.
fn _t_valid(): i64 {
    return "{\"name\":\"sweep\",\"agents\":[{\"key\":\"a1\",\"role\":\"tester\",\"goal\":\"find bugs\"}],\"tasks\":[{\"description\":\"run the suite\"}]}";
}

fn test_valid_minimum() {
    test_group("request/valid");

    var a = arena_allocator(262144);
    var rj: i64[1];
    var r = _t_decode(a, _t_valid(), &rj);

    assert_neq(r, 0, "a minimal well-formed submission decodes");
    assert_eq(load64(&rj), 0, "with no rejection");
    assert_eq(str_eq_cstr(agnostic_crew_req_name(r), "sweep"), 1, "name read");
    assert_eq(vec_len(agnostic_crew_req_agents(r)), 1, "one agent");
    assert_eq(vec_len(agnostic_crew_req_tasks(r)), 1, "one task");
    assert_eq(agnostic_crew_req_process(r), AGNOSTIC_PROCESS_SEQUENTIAL, "process defaults to sequential");
    assert_eq(agnostic_crew_req_concurrency(r), AGNOSTIC_REQ_UNSET, "concurrency unset");
}

fn test_tasks_are_required() {
    test_group("request/tasks-required");

    var a = arena_allocator(262144);
    var rj: i64[1];

    # ⭐ ORACLE-AUDIT.md §3.3, IN ONE ASSERTION.
    #
    # The oracle accepted a body with no `tasks` and quietly ran a fabricated
    # single task holding the raw description with every agent attached. There is
    # no fallback here to fall into: a submission without tasks is refused.
    var r = _t_decode(a, "{\"name\":\"sweep\",\"agents\":[{\"key\":\"a1\",\"role\":\"t\",\"goal\":\"g\"}]}", &rj);
    assert_eq(r, 0, "a body with no 'tasks' is refused, not rewritten");
    assert_eq(agnostic_reject_status(load64(&rj)), HTTP_BAD_REQUEST, "as a 400");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "tasks"), 1, "naming the field");

    # An empty array is refused too — "zero tasks" is not a crew.
    var r2 = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[]}", &rj);
    assert_eq(r2, 0, "an empty task array is refused");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "at least one task"), 1, "saying so");
}

fn test_the_oracles_fallback_shape_is_rejected() {
    test_group("request/no-fallback");

    var a = arena_allocator(262144);
    var rj: i64[1];

    # The exact body the oracle's fallback was built around: a crew-level
    # `description` and no tasks. Rather than being turned into a one-task crew,
    # it is refused, and the response names the field that does not belong.
    var r = _t_decode(a,
      "{\"name\":\"s\",\"description\":\"do everything\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_eq(r, 0, "a crew-level 'description' is not silently absorbed");
    assert_eq(agnostic_reject_status(load64(&rj)), AGNOSTIC_HTTP_UNPROCESSABLE, "422 for an unknown field");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "description"), 1, "reported by name");
}

fn test_unknown_fields_named() {
    test_group("request/unknown");

    var a = arena_allocator(262144);
    var rj: i64[1];

    var r = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\",\"nonsense\":true}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_eq(r, 0, "an unknown AGENT field is refused");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "nonsense"), 1, "named");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "agents[0]"), 1, "and located");

    var r2 = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\",\"retries\":3}]}",
      &rj);
    assert_eq(r2, 0, "an unknown TASK field is refused");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "retries"), 1, "named");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "tasks[0]"), 1, "and located");
}

fn test_gpu_strict_is_refused_by_name() {
    test_group("request/gpu-strict");

    var a = arena_allocator(262144);
    var rj: i64[1];

    # ⭐ ORACLE-AUDIT.md §2.2 / §3.11 — and the field is NOT `gpu_required`.
    #
    # The oracle declares both (`agents/base.py:61-62`) and hard-fails only on
    # `gpu_required AND gpu_strict` (`config/gpu_scheduler.py:196`): `required`
    # asks for a GPU, `strict` says fail rather than fall back to CPU. The oracle
    # forwarded the first and dropped the second, so every hard-fail request
    # silently became a CPU fallback.
    #
    # ⚠ The Cyrius engine cannot express strictness at all — `gpu_strict` appears
    # ZERO times in lib/agnosai.cyr and `agnosai_agent_with_gpu` has no such
    # parameter. So it is REFUSED, and refused with its own message: a caller who
    # needs hard-fail must learn the platform cannot do it, not that they typo'd.
    var r = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\",\"gpu_required\":true,\"gpu_strict\":true}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_eq(r, 0, "gpu_strict is refused, never accepted and dropped");
    assert_eq(agnostic_reject_status(load64(&rj)), AGNOSTIC_HTTP_UNPROCESSABLE, "as a 422");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "gpu_strict"), 1, "naming the field");

    # ⚠ And NOT with the generic "unknown field" message, which would read as a
    # typo. The refusal says the capability does not exist and names the field
    # that does exist.
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "unknown field"), 0,
      "not the generic unknown-field message");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "hard-fail"), 1,
      "explaining what is unsupported");
    # ⚠ Located, because one decoder serves both surfaces: inside a crew's
    # `agents` array the message carries the index; on the standalone definition
    # surface the same refusal goes out unprefixed.
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "agents[0]"), 1, "and located");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "gpu_required"), 1,
      "and pointing at the field that does work");
}

fn test_gpu_required_is_forwarded() {
    test_group("request/gpu");

    var a = arena_allocator(262144);
    var rj: i64[1];

    # The three GPU fields the engine CAN act on. `gpu_required` asks for a GPU;
    # it is not the hard-fail flag — see `test_gpu_strict_is_refused_by_name`.
    # All three must arrive on the agent definition the engine will schedule.
    var r = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\",\"gpu_required\":true,\"gpu_memory_min_mb\":8192}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_neq(r, 0, "the submission decodes");

    var agent = agnostic_agent_def_engine(vec_get(agnostic_crew_req_agents(r), 0));
    assert_eq(agnosai_agent_gpu_required(agent), 1, "gpu_required reached the engine definition");
    assert_eq(agnosai_agent_gpu_memory_min_mb(agent), 8192, "and so did the memory floor");

    # ⚠ A JSON string is NOT a boolean. Coercing `"false"` would read as true —
    # the string is non-empty — which is the silent misreading the codec exists
    # to stop. It must be a 422, not a default.
    var r2 = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\",\"gpu_required\":\"false\"}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_eq(r2, 0, "a string in a boolean field is refused, not coerced");
    assert_eq(agnostic_reject_status(load64(&rj)), AGNOSTIC_HTTP_UNPROCESSABLE, "as a 422");
}

fn test_optional_agent_fields_forwarded() {
    test_group("request/agent-fields");

    var a = arena_allocator(262144);
    var rj: i64[1];
    var r = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\",\"name\":\"Ann\",\"domain\":\"qa\",\"backstory\":\"veteran\",\"complexity\":\"high\",\"llm_model\":\"m1\",\"tools\":[\"grep\",\"curl\"]}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_neq(r, 0, "every listed agent field is accepted");

    var agent = agnostic_agent_def_engine(vec_get(agnostic_crew_req_agents(r), 0));
    assert_eq(str_eq_cstr(agnosai_agent_name(agent), "Ann"), 1, "name forwarded");
    assert_eq(str_eq_cstr(agnosai_agent_domain(agent), "qa"), 1, "domain forwarded");
    assert_eq(str_eq_cstr(agnosai_agent_backstory(agent), "veteran"), 1, "backstory forwarded");
    assert_eq(str_eq_cstr(agnosai_agent_complexity(agent), "high"), 1, "complexity forwarded");
    assert_eq(str_eq_cstr(agnosai_agent_llm_model(agent), "m1"), 1, "llm_model forwarded");
    assert_eq(vec_len(agnosai_agent_tools(agent)), 2, "tools forwarded");
}

fn test_process_modes() {
    test_group("request/process");

    assert_eq(agnostic_process_from_wire(str_from("sequential")), AGNOSTIC_PROCESS_SEQUENTIAL, "sequential");
    assert_eq(agnostic_process_from_wire(str_from("parallel")), AGNOSTIC_PROCESS_PARALLEL, "parallel");
    assert_eq(agnostic_process_from_wire(str_from("dag")), AGNOSTIC_PROCESS_DAG, "dag");

    # ⚠ NOT a silent fallback to sequential. `_agnosai_route_process_for` defaults
    # anything it does not recognise, so a typo'd "paralell" runs sequentially and
    # nothing says so. An unrecognised mode is an error here.
    assert_eq(agnostic_process_from_wire(str_from("paralell")), 0 - 1, "a typo is an error, not a default");
    assert_eq(agnostic_process_from_wire(str_from("hierarchical")), 0 - 1,
      "hierarchical is refused rather than silently run as sequential");

    var a = arena_allocator(262144);
    var rj: i64[1];
    var r = _t_decode(a,
      "{\"name\":\"s\",\"process\":\"paralell\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_eq(r, 0, "and the decoder refuses it");
    assert_eq(agnostic_reject_status(load64(&rj)), HTTP_BAD_REQUEST, "as a 400");
}

fn test_concurrency_only_where_it_applies() {
    test_group("request/concurrency");

    var a = arena_allocator(262144);
    var rj: i64[1];

    var ok = _t_decode(a,
      "{\"name\":\"s\",\"process\":\"parallel\",\"max_concurrency\":8,\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_neq(ok, 0, "max_concurrency is accepted with parallel");
    assert_eq(agnostic_crew_req_concurrency(ok), 8, "and read");

    # ⚠ A field that would be accepted and then have no effect is exactly the
    # failure this milestone is about. The engine takes concurrency from the
    # process mode, so `max_concurrency` alongside `sequential` would do nothing.
    var bad = _t_decode(a,
      "{\"name\":\"s\",\"process\":\"sequential\",\"max_concurrency\":8,\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_eq(bad, 0, "but refused where it would silently do nothing");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "parallel"), 1, "explaining where it applies");

    var oor = _t_decode(a,
      "{\"name\":\"s\",\"process\":\"parallel\",\"max_concurrency\":9999,\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    assert_eq(oor, 0, "and bounded");
}

fn test_priority_and_risk() {
    test_group("request/priority-risk");

    assert_eq(agnostic_priority_from_wire(str_from("background")), AGNOSAI_PRIORITY_BACKGROUND, "background");
    assert_eq(agnostic_priority_from_wire(str_from("critical")), AGNOSAI_PRIORITY_CRITICAL, "critical");
    assert_eq(agnostic_priority_from_wire(str_from("urgent")), 0 - 1, "an unknown priority is an error");
    assert_eq(agnostic_risk_from_wire(str_from("medium")), AGNOSAI_RISK_MEDIUM, "medium risk");
    assert_eq(agnostic_risk_from_wire(str_from("extreme")), 0 - 1, "an unknown risk is an error");

    var a = arena_allocator(262144);
    var rj: i64[1];
    var r = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\",\"priority\":\"background\",\"risk\":\"high\"}]}",
      &rj);
    assert_neq(r, 0, "wire names decode");
    var t = vec_get(agnostic_crew_req_tasks(r), 0);

    # ⚠ AGNOSAI_PRIORITY_BACKGROUND is 0, and UNSET is -1. If the sentinel were 0
    # these two would be the same value and "background" would be indistinguishable
    # from "omitted".
    assert_eq(agnostic_task_req_priority(t), AGNOSAI_PRIORITY_BACKGROUND, "background is 0, not 'unset'");
    assert_neq(agnostic_task_req_priority(t), AGNOSTIC_REQ_UNSET, "and is distinguishable from unset");
    assert_eq(agnostic_task_req_risk(t), AGNOSAI_RISK_HIGH, "risk decoded");
}

fn test_dependency_validation() {
    test_group("request/deps");

    var a = arena_allocator(262144);
    var rj: i64[1];

    var oor = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\",\"dependencies\":[5]}]}",
      &rj);
    assert_eq(oor, 0, "an out-of-range dependency is refused");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "out of range"), 1, "saying so");

    var self = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\",\"dependencies\":[0]}]}",
      &rj);
    assert_eq(self, 0, "a self-dependency is refused");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "itself"), 1, "saying so");
}

fn test_cycles_are_refused() {
    test_group("request/cycle");

    var a = arena_allocator(262144);
    var rj: i64[1];

    # ⭐ THE PERMANENTLY-PENDING CREW, STOPPED AT THE FRONT DOOR.
    #
    # `agnosai_crew_runner_run` returns 0 on its error arm — a cyclic DAG among
    # them — and `_agnosai_orch_finish_err` then stores no outcome: it puts back the
    # PENDING `_agnosai_orch_register` seeded (agnosai 2.1.5, ADR 022).
    # `_agnosai_orch_submit_thread` discards that return, so a cyclic graph
    # submitted asynchronously reports `pending` forever.
    #
    # Rejecting the cycle here makes that arm unreachable through Agnostic.
    var r = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\",\"dependencies\":[1]},{\"description\":\"y\",\"dependencies\":[0]}]}",
      &rj);
    assert_eq(r, 0, "a two-task cycle is refused before submission");
    assert_eq(agnostic_reject_status(load64(&rj)), HTTP_BAD_REQUEST, "as a 400");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "cycle"), 1, "naming the problem");

    # A longer cycle, to show the detector is not just a pair check.
    var r3 = _t_decode(a,
      "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\",\"dependencies\":[2]},{\"description\":\"y\",\"dependencies\":[0]},{\"description\":\"z\",\"dependencies\":[1]}]}",
      &rj);
    assert_eq(r3, 0, "a three-task cycle is refused too");

    # And an acyclic diamond is accepted — a detector that rejects everything is
    # not a detector.
    var ok = _t_decode(a,
      "{\"name\":\"s\",\"process\":\"dag\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"root\"},{\"description\":\"l\",\"dependencies\":[0]},{\"description\":\"r\",\"dependencies\":[0]},{\"description\":\"join\",\"dependencies\":[1,2]}]}",
      &rj);
    assert_neq(ok, 0, "an acyclic diamond is accepted");
    assert_eq(vec_len(agnostic_crew_req_tasks(ok)), 4, "with every task");
}

fn test_required_scalars() {
    test_group("request/required");

    var a = arena_allocator(262144);
    var rj: i64[1];

    assert_eq(_t_decode(a, "{\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}", &rj), 0,
      "'name' is required");
    assert_eq(_t_decode(a, "{\"name\":\"s\",\"tasks\":[{\"description\":\"x\"}]}", &rj), 0,
      "'agents' is required");
    assert_eq(_t_decode(a, "{\"name\":\"s\",\"agents\":[],\"tasks\":[{\"description\":\"x\"}]}", &rj), 0,
      "at least one agent is required");
    assert_eq(_t_decode(a, "{\"name\":\"\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}", &rj), 0,
      "an empty name is refused");
    assert_eq(_t_decode(a, "{\"name\":\"s\",\"agents\":[{\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}", &rj), 0,
      "an agent without 'key' is refused");
    assert_eq(_t_decode(a, "{\"name\":\"s\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"\"}]}", &rj), 0,
      "an empty task description is refused");

    var arr = _t_decode(a, "[1,2,3]", &rj);
    assert_eq(arr, 0, "a JSON array body is refused");
    assert_eq(agnostic_reject_status(load64(&rj)), HTTP_BAD_REQUEST, "as a 400");
}

fn test_spec_build() {
    test_group("request/spec");

    var a = arena_allocator(262144);
    var rj: i64[1];
    var r = _t_decode(a,
      "{\"name\":\"sweep\",\"process\":\"dag\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"first\"},{\"description\":\"second\",\"dependencies\":[0]}]}",
      &rj);
    assert_neq(r, 0, "decoded");

    var spec = agnostic_crew_spec_build(r);
    assert_neq(spec, 0, "spec built");
    assert_eq(str_eq_cstr(agnosai_crew_name(spec), "sweep"), 1, "name carried");
    assert_eq(vec_len(agnosai_crew_tasks(spec)), 2, "both tasks");
    assert_eq(vec_len(agnosai_crew_agents(spec)), 1, "the agent");
    assert_eq(agnosai_process_kind(agnosai_crew_process(spec)), AGNOSAI_PROCESS_DAG, "dag mode");

    # ⚠ The crew id is minted by `agnosai_crew_new` — by the ENGINE. Agnostic
    # never generates one, which is what makes ORACLE-AUDIT §3.2 unwritable.
    assert_neq(agnosai_crew_id(spec), 0, "the engine assigned an id");

    # Dependencies are index-based on the wire and id-based in the spec, so the
    # second pass must have resolved index 0 to the first task's engine id.
    var t0 = vec_get(agnosai_crew_tasks(spec), 0);
    var t1 = vec_get(agnosai_crew_tasks(spec), 1);
    var deps = agnosai_task_dependencies(t1);
    assert_eq(vec_len(deps), 1, "the dependency survived");
    assert_eq(str_eq(vec_get(deps, 0), agnosai_task_id(t0)), 1,
      "resolved from an index to the engine's task id");

    # A default-concurrency parallel spec picks up the documented default.
    var pr = _t_decode(a,
      "{\"name\":\"s\",\"process\":\"parallel\",\"agents\":[{\"key\":\"a\",\"role\":\"t\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\"}]}",
      &rj);
    var pspec = agnostic_crew_spec_build(pr);
    assert_eq(agnosai_process_max_concurrency(agnosai_crew_process(pspec)),
      AGNOSTIC_REQ_DEFAULT_CONCURRENCY, "parallel without max_concurrency uses the default");
}

# A body with one task carrying `hints` — a JSON fragment — and two agents the selector can
# tell apart only by what the task asks for.
fn _t_hinted(hints): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"h\",\"agents\":[");
    str_builder_add_cstr(sb, "{\"key\":\"web\",\"role\":\"r\",\"goal\":\"g\",\"tools\":[\"playwright\"],\"domain\":\"web\"},");
    str_builder_add_cstr(sb, "{\"key\":\"load\",\"role\":\"r\",\"goal\":\"g\",\"tools\":[\"k6\"],\"domain\":\"performance\",\"complexity\":\"high\",\"gpu_required\":true}");
    str_builder_add_cstr(sb, "],\"tasks\":[{\"description\":\"x\"");
    str_builder_add_cstr(sb, hints);
    str_builder_add_cstr(sb, "}]}");
    return str_cstr(str_builder_build(sb));
}

# The status a body with task hints `hints` is refused with, or 0 when it decodes.
fn _t_hint_status(a, hints): i64 {
    var rj: i64[1];
    var r = _t_decode(a, _t_hinted(hints), &rj);
    if (r != 0) { return 0; }
    return agnostic_reject_status(load64(&rj));
}

# The index of the agent the engine's selector ranks first for task 0 of `body`'s spec.
fn _t_picked(a, hints): i64 {
    var rj: i64[1];
    var r = _t_decode(a, _t_hinted(hints), &rj);
    if (r == 0) { return 0 - 1; }
    var spec = agnostic_crew_spec_build(r);
    var ranked = agnosai_rank_agents(agnosai_crew_agents(spec), vec_get(agnosai_crew_tasks(spec), 0));
    return agnosai_scored_index(vec_get(ranked, 0));
}

# ⭐ The task's selection hints (0.1.14, ADR 0017): decoded strictly, forwarded into the engine
# task's context under the selector's own keys, and what the selector then decides by.
fn test_selection_hints() {
    test_group("request/hints");

    var a = arena_allocator(262144);
    var rj: i64[1];
    var r = _t_decode(a, _t_hinted(",\"required_tools\":[\"k6\",\"jq\"],\"complexity\":\"high\",\"domain\":\"Performance\",\"gpu_required\":true"), &rj);
    assert_neq(r, 0, "a task with all four hints decodes");
    var t = vec_get(agnostic_crew_req_tasks(r), 0);
    assert_eq(vec_len(agnostic_task_req_required_tools(t)), 2, "required_tools decoded");
    assert_eq(agnostic_task_req_complexity(t), AGNOSTIC_COMPLEXITY_HIGH, "complexity decoded");
    assert_eq(str_eq_cstr(agnostic_task_req_domain(t), "Performance"), 1, "domain decoded, case kept");
    assert_eq(agnostic_task_req_gpu_required(t), 1, "gpu_required decoded");

    var spec = agnostic_crew_spec_build(r);
    var ctx = agnosai_task_context(vec_get(agnosai_crew_tasks(spec), 0));
    var tools = map_get(ctx, str_from("required_tools"));
    assert_eq(bayan_json_v_is_arr(tools), 1, "required_tools reaches the engine as an array");
    assert_eq(str_eq_cstr(bayan_json_v_str(bayan_json_v_arr_get(tools, 0)), "k6"), 1, "of the names sent");
    assert_eq(str_eq_cstr(bayan_json_v_str(map_get(ctx, str_from("complexity"))), "high"), 1,
      "complexity as its wire name");
    assert_eq(str_eq_cstr(bayan_json_v_str(map_get(ctx, str_from("domain"))), "Performance"), 1, "domain as sent");
    assert_eq(bayan_json_v_bool(map_get(ctx, str_from("gpu_required"))), 1, "gpu_required as a boolean");

    # A task that names no hint gets no context key: the selector's own defaults apply.
    var plain = _t_decode(a, _t_valid(), &rj);
    var pctx = agnosai_task_context(vec_get(agnosai_crew_tasks(agnostic_crew_spec_build(plain)), 0));
    var stray = 0;
    if (pctx != 0) {
        if (map_get(pctx, str_from("required_tools")) != 0) { stray = stray + 1; }
        if (map_get(pctx, str_from("complexity")) != 0) { stray = stray + 1; }
        if (map_get(pctx, str_from("domain")) != 0) { stray = stray + 1; }
        if (map_get(pctx, str_from("gpu_required")) != 0) { stray = stray + 1; }
    }
    assert_eq(stray, 0, "an unhinted task carries no hint key");

    # ⭐ What they are for. With no hint only complexity separates the two — the task reads as
    # medium — so `web` (medium by default) beats `load` (high); each hint alone moves the task
    # to the agent that matches it.
    assert_eq(_t_picked(a, ""), 0, "no hints: complexity alone decides, for the medium agent");
    assert_eq(_t_picked(a, ",\"required_tools\":[\"k6\"]"), 1, "required_tools picks the agent with the tool");
    assert_eq(_t_picked(a, ",\"domain\":\"PERFORMANCE\""), 1, "domain picks the agent in it, case-insensitively");
    assert_eq(_t_picked(a, ",\"complexity\":\"high\""), 1, "complexity picks the agent that matches it");
    assert_eq(_t_picked(a, ",\"gpu_required\":true"), 1, "gpu_required picks the agent with a GPU");
    assert_eq(_t_picked(a, ",\"required_tools\":[\"playwright\"],\"domain\":\"web\""), 0,
      "and hints for the other agent pick it");

    # Accepted edges: an empty tool list (no requirement), null for any hint (absent).
    assert_eq(_t_hint_status(a, ",\"required_tools\":[]"), 0, "an empty required_tools is no requirement");
    assert_eq(_t_hint_status(a, ",\"required_tools\":null,\"complexity\":null,\"domain\":null,\"gpu_required\":null"), 0,
      "null is absent");
    assert_eq(_t_hint_status(a, ",\"gpu_required\":false"), 0, "gpu_required false is accepted");

    # Refused, each by name — the engine would have read every one of these silently.
    assert_eq(_t_hint_status(a, ",\"required_tools\":\"k6\""), AGNOSTIC_HTTP_UNPROCESSABLE,
      "required_tools that is not an array is 422");
    assert_eq(_t_hint_status(a, ",\"required_tools\":[\"k6\",7]"), AGNOSTIC_HTTP_UNPROCESSABLE,
      "one non-string entry is 422 — the engine would score every agent full coverage");
    assert_eq(_t_hint_status(a, ",\"required_tools\":[\"\"]"), HTTP_BAD_REQUEST, "an empty tool name is 400");
    var many = str_builder_new();
    str_builder_add_cstr(many, ",\"required_tools\":[");
    var i = 0;
    while (i <= AGNOSTIC_REQ_MAX_TOOLS) {
        if (i > 0) { str_builder_add_cstr(many, ","); }
        str_builder_add_cstr(many, "\"t\"");
        i = i + 1;
    }
    str_builder_add_cstr(many, "]");
    assert_eq(_t_hint_status(a, str_cstr(str_builder_build(many))), HTTP_BAD_REQUEST,
      "more than the tool cap is 400");
    assert_eq(_t_hint_status(a, ",\"complexity\":\"hihg\""), HTTP_BAD_REQUEST,
      "a complexity typo is 400 — the engine would read it as medium");
    assert_eq(_t_hint_status(a, ",\"complexity\":\"HIGH\""), HTTP_BAD_REQUEST, "wire names are lowercase");
    assert_eq(_t_hint_status(a, ",\"complexity\":3"), AGNOSTIC_HTTP_UNPROCESSABLE, "a complexity number is 422");
    assert_eq(_t_hint_status(a, ",\"domain\":\"\""), HTTP_BAD_REQUEST, "an empty domain is 400");
    assert_eq(_t_hint_status(a, ",\"domain\":5"), AGNOSTIC_HTTP_UNPROCESSABLE, "a domain number is 422");
    assert_eq(_t_hint_status(a, ",\"gpu_required\":\"true\""), AGNOSTIC_HTTP_UNPROCESSABLE,
      "gpu_required as a string is 422, never read as true");

    # The length caps: identifiers, at most AGNOSTIC_REQ_MAX_HINT bytes each.
    var longname = str_builder_new();
    str_builder_add_cstr(longname, ",\"required_tools\":[\"");
    var j = 0;
    while (j <= AGNOSTIC_REQ_MAX_HINT) { str_builder_add_cstr(longname, "t"); j = j + 1; }
    str_builder_add_cstr(longname, "\"]");
    assert_eq(_t_hint_status(a, str_cstr(str_builder_build(longname))), HTTP_BAD_REQUEST,
      "a tool name one byte past the cap is 400");
    var longdom = str_builder_new();
    str_builder_add_cstr(longdom, ",\"domain\":\"");
    j = 0;
    while (j <= AGNOSTIC_REQ_MAX_HINT) { str_builder_add_cstr(longdom, "d"); j = j + 1; }
    str_builder_add_cstr(longdom, "\"");
    assert_eq(_t_hint_status(a, str_cstr(str_builder_build(longdom))), HTTP_BAD_REQUEST,
      "and so is a domain");

    # ⭐ Rendered as the engine renders them: 64 names of 256 control bytes each are within
    # every per-field cap, but escaped (\u0001 is six bytes) they come to ~98 KB — past the
    # engine's 50,000-byte prompt-input cap, where the model would see them cut in half.
    var esc = str_builder_new();
    str_builder_add_cstr(esc, ",\"required_tools\":[");
    var k = 0;
    while (k < AGNOSTIC_REQ_MAX_TOOLS) {
        if (k > 0) { str_builder_add_cstr(esc, ","); }
        str_builder_add_cstr(esc, "\"");
        j = 0;
        while (j < AGNOSTIC_REQ_MAX_HINT) { str_builder_add_cstr(esc, "\\u0001"); j = j + 1; }
        str_builder_add_cstr(esc, "\"");
        k = k + 1;
    }
    str_builder_add_cstr(esc, "]");
    var big = arena_allocator(8388608);
    assert_eq(_t_hint_status(big, str_cstr(str_builder_build(esc))), HTTP_BAD_REQUEST,
      "hints past the engine's context cap once rendered are 400");
    reset_via(big);
    var full = str_builder_new();
    str_builder_add_cstr(full, ",\"required_tools\":[");
    k = 0;
    while (k < AGNOSTIC_REQ_MAX_TOOLS) {
        if (k > 0) { str_builder_add_cstr(full, ","); }
        str_builder_add_cstr(full, "\"");
        j = 0;
        while (j < AGNOSTIC_REQ_MAX_HINT) { str_builder_add_cstr(full, "t"); j = j + 1; }
        str_builder_add_cstr(full, "\"");
        k = k + 1;
    }
    str_builder_add_cstr(full, "]");
    assert_eq(_t_hint_status(big, str_cstr(str_builder_build(full))), 0,
      "while every cap at its limit, in plain names, fits");
    reset_via(big);
    # ⚠ And an arena too small to render them in answers -1, which refuses — never 0, which
    # would read as "nothing to render" and wave them through.
    var hr = _t_decode(big, _t_hinted(",\"domain\":\"performance\""), &rj);
    assert_neq(hr, 0, "a hinted task decodes");
    var ht = vec_get(agnostic_crew_req_tasks(hr), 0);
    assert_eq(_agnostic_task_req_hints_rendered_len_a(arena_allocator(64), ht), 0 - 1,
      "measuring in an arena that runs out is -1, not 'fits'");
    assert_eq(_agnostic_task_req_hints_rendered_len_a(big, ht) > 0, 1, "and in one that does not, a length");
    reset_via(big);

    reset_via(a);
    var bad = _t_decode(a, _t_hinted(",\"complexity\":\"hihg\""), &rj);
    assert_eq(bad, 0, "refused");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "tasks[0]"), 1, "naming the task");
    assert_eq(_t_has(agnostic_reject_message(load64(&rj)), "low, medium, high"), 1, "and the levels");
}

# An agent's empty domain is no domain (0.1.14): the engine compares a STATED domain, and ""
# matches nothing, so an agent saved with "" would lose every task that names a domain.
fn test_empty_agent_domain_is_absent() {
    test_group("request/empty-domain");
    var a = arena_allocator(262144);
    var rj: i64[1];
    var r = _t_decode(a,
      "{\"name\":\"d\",\"agents\":[{\"key\":\"a\",\"role\":\"r\",\"goal\":\"g\",\"domain\":\"\"},{\"key\":\"b\",\"role\":\"r\",\"goal\":\"g\"}],\"tasks\":[{\"description\":\"x\",\"domain\":\"performance\"}]}",
      &rj);
    assert_neq(r, 0, "an empty agent domain is accepted");
    var spec = agnostic_crew_spec_build(r);
    var agents = agnosai_crew_agents(spec);
    assert_eq(agnosai_agent_domain(vec_get(agents, 0)), 0, "and reaches the engine as no domain");
    var ranked = agnosai_rank_agents(agents, vec_get(agnosai_crew_tasks(spec), 0));
    assert_eq(agnosai_scored_index(vec_get(ranked, 0)), 0,
      "so it ties with the agent that has none, and the first still wins");
}

# A crew whose one agent carries `complexity` `c` (a C string), answered with its rejection.
fn _t_agent_cx(a, c, out) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"name\":\"c\",\"agents\":[{\"key\":\"a\",\"role\":\"r\",\"goal\":\"g\",\"complexity\":\"");
    str_builder_add_cstr(sb, c);
    str_builder_add_cstr(sb, "\"}],\"tasks\":[{\"description\":\"x\"}]}");
    return _t_decode(a, str_data(str_builder_build(sb)), out);
}

# ⭐ 0.1.15: an agent's `complexity` is one of the three, as a task's hint has been since 0.1.14
# (ADR 0017). The engine reads any other value as medium without a word.
fn test_agent_complexity_is_checked() {
    test_group("request/agent-complexity");
    var a = arena_allocator(262144);
    var rj: i64[1];
    assert_neq(_t_agent_cx(a, "high", &rj), 0, "high is accepted");
    assert_neq(_t_agent_cx(a, "low", &rj), 0, "and low");
    assert_eq(_t_agent_cx(a, "extreme", &rj), 0, "⭐ another value is refused");
    var rj0 = load64(&rj);
    assert_eq(agnostic_reject_status(rj0), HTTP_BAD_REQUEST, "with 400, as a task's hint is");
    assert_eq(_t_has(agnostic_reject_message(rj0), "agents[0]: 'complexity' must be one of low, medium, high"), 1,
      "naming the agent and the three");
    assert_eq(_t_agent_cx(a, "HIGH", &rj), 0, "the engine's case-insensitive spelling is refused too");
    assert_neq(_t_decode(a, _t_valid(), &rj), 0, "and an agent with none is unaffected");
}

# ⭐ 0.1.15: the hints Swarm Command 0.5.1 sends pick each task's role agent. Its role roster
# gives each agent `domain` its role and `tools` the kinds the role uses, and each task the same
# `domain` and `required_tools` — the shape `specToCrewRequest` builds (tests/webgui). A coder
# and a reviewer use the same kinds, so the tools alone tie and the domain decides.
fn test_swarm_role_hints_pick_the_role() {
    test_group("request/swarm-roles");
    var a = arena_allocator(262144);
    var rj: i64[1];
    var r = _t_decode(a,
      "{\"name\":\"s\",\"process\":\"parallel\",\"agents\":[{\"key\":\"planner\",\"role\":\"Planner\",\"goal\":\"g\",\"domain\":\"planner\",\"tools\":[\"llm\",\"db\",\"fs\"]},{\"key\":\"coder\",\"role\":\"Coder\",\"goal\":\"g\",\"domain\":\"coder\",\"tools\":[\"exec\",\"fs\",\"llm\"]},{\"key\":\"reviewer\",\"role\":\"Reviewer\",\"goal\":\"g\",\"domain\":\"reviewer\",\"tools\":[\"llm\",\"exec\",\"fs\"]}],\"tasks\":[{\"description\":\"review\",\"domain\":\"reviewer\",\"required_tools\":[\"llm\",\"exec\",\"fs\"]},{\"description\":\"code\",\"domain\":\"coder\",\"required_tools\":[\"exec\",\"fs\",\"llm\"]},{\"description\":\"plan\",\"domain\":\"planner\",\"required_tools\":[\"llm\",\"db\",\"fs\"]}]}",
      &rj);
    assert_neq(r, 0, "the swarm's request decodes");
    if (r == 0) { return 0; }
    var spec = agnostic_crew_spec_build(r);
    var agents = agnosai_crew_agents(spec);
    var tasks = agnosai_crew_tasks(spec);
    assert_eq(agnosai_scored_index(vec_get(agnosai_rank_agents(agents, vec_get(tasks, 0)), 0)), 2,
      "⭐ the review goes to the reviewer, though the coder has the same tools");
    assert_eq(agnosai_scored_index(vec_get(agnosai_rank_agents(agents, vec_get(tasks, 1)), 0)), 1,
      "the code to the coder");
    assert_eq(agnosai_scored_index(vec_get(agnosai_rank_agents(agents, vec_get(tasks, 2)), 0)), 0,
      "and the plan to the planner");
    return 0;
}

fn test_bounds_match_the_engine() {
    test_group("request/bounds");

    # ⚠ A bound ABOVE the engine's would turn a clean 400 into a rejection deeper
    # in, where the message is worse. These must not drift upward.
    assert_eq(AGNOSTIC_REQ_MAX_AGENTS <= AGNOSAI_CREW_MAX_AGENTS, 1, "agent cap is at or below the engine's");
    assert_eq(AGNOSTIC_REQ_MAX_TASKS <= AGNOSAI_CREW_MAX_TASKS, 1, "task cap is at or below the engine's");
    assert_eq(AGNOSTIC_REQ_MAX_STRING <= AGNOSAI_CREW_MAX_STRING_LEN, 1, "string cap is at or below the engine's");
    assert_eq(AGNOSTIC_REQ_MAX_CONCURRENCY <= AGNOSAI_CREW_MAX_CONCURRENCY, 1,
      "concurrency cap is at or below the engine's");
    # A task's hints in plain names, every cap at its limit, fit the engine's prompt-input cap.
    assert_eq(AGNOSTIC_REQ_MAX_TOOLS * (AGNOSTIC_REQ_MAX_HINT + 8) + AGNOSTIC_REQ_MAX_HINT + 128
      < AGNOSAI_MAX_INPUT_LENGTH, 1, "the hint caps leave room under the engine's context cap");
}

fn main() {
    alloc_init();
    thread_local_init();
    test_valid_minimum();
    test_tasks_are_required();
    test_the_oracles_fallback_shape_is_rejected();
    test_unknown_fields_named();
    test_gpu_strict_is_refused_by_name();
    test_gpu_required_is_forwarded();
    test_optional_agent_fields_forwarded();
    test_process_modes();
    test_concurrency_only_where_it_applies();
    test_priority_and_risk();
    test_dependency_validation();
    test_cycles_are_refused();
    test_required_scalars();
    test_spec_build();
    test_selection_hints();
    test_empty_agent_domain_is_absent();
    test_agent_complexity_is_checked();
    test_swarm_role_hints_pick_the_role();
    test_bounds_match_the_engine();
    return assert_summary();
}

var _agnostic_request_test_exit = main();
if (_agnostic_request_test_exit > 0) { _agnostic_request_test_exit = 1; }
sys_exit_group(_agnostic_request_test_exit);
