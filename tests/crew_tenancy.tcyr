# agnostic/routes/crews — crews belong to a tenant, are listed per tenant, and a keyed
# submit is safe to retry (0.1.9).
#
# What this suite holds:
#
#   1. A crew belongs to the scope it was submitted in. To every other scope it does not
#      exist: GET, cancel, events and plan all answer 404 — not 403, which would confirm it.
#   2. `GET /api/v1/crews` lists the caller's crews and nobody else's, newest first, with a
#      cursor that pages without repeating or skipping.
#   3. A finished crew stays listed after the ledger forgets it (a restart), from the
#      durable index, and its stored outcome is still scoped.
#   4. `Idempotency-Key`: the same key and body answers the same crew; the same key with
#      another body is refused; keys do not cross scopes.
#   5. A crew a restart interrupted (0.1.13) is still scoped, listed and filtered.
#   6. An agent definition belongs to its tenant the way a crew does (0.3.0, audit S3).
include "src/app.cyr"
include "tests/support/tmp.cyr"   # scratch paths under $TMPDIR (0.1.15)

var _T_DB = _tt_tmp_path("crew-tenancy-suite");
var _T_MAXB = 1048576;
var _T_BODY = "{\"name\":\"sweep\",\"agents\":[{\"key\":\"a1\",\"role\":\"tester\",\"goal\":\"find bugs\"}],\"tasks\":[{\"description\":\"run the suite\"}]}"; #skip-lint
var _T_BODY2 = "{\"name\":\"other\",\"agents\":[{\"key\":\"a1\",\"role\":\"tester\",\"goal\":\"find bugs\"}],\"tasks\":[{\"description\":\"something else\"}]}"; #skip-lint

fn _t_open() {
    agnostic_store_close();
    sys_unlink(_T_DB);
    patra_init();
    agnostic_store_open(str_from(_T_DB));
    agnostic_auth_ensure();
    agnostic_tenants_ensure();
    agnostic_crews_ensure();
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_engine_init(agnostic_config_from_env());
    return 0;
}

# A request context carrying `Bearer <token>` (0 for none), and an Idempotency-Key (0).
fn _t_ctx(a, token, idem) {
    var authz = 0;
    if (token != 0) {
        var h = alloc_via(a, 7 + str_len(token));
        memcpy(h, "Bearer ", 7);
        memcpy(h + 7, str_data(token), str_len(token));
        authz = str_new_a(a, h, 7 + str_len(token));
    }
    var c = agnostic_reqctx_new_a(a, authz, 0);
    if (idem != 0) { agnostic_reqctx_set_headers(c, str_from(idem), 0, 0, 0); }
    return c;
}

fn _t_req(a, method, path: Str, body, ctx) {
    return agnostic_route_dispatch_a(a, method, path, str_from(body), _T_MAXB, ctx);
}

fn _t_url(id, tail) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/api/v1/crews/");
    str_builder_add(sb, id);
    str_builder_add_cstr(sb, tail);
    return str_builder_build(sb);
}

fn _t_submit(a, ctx, body) {
    var r = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), body, ctx);
    return agnostic_req_str(agnostic_response_body(r), AGNOSTIC_JK_CREW_ID);
}

# Wait, polling as `ctx`, until the crew is terminal. 1 when it got there.
fn _t_wait(a, id, ctx) {
    var tries = 0;
    while (tries < 300) {
        var b = agnostic_response_body(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(id, ""), "", ctx));
        var st = agnostic_req_str(b, AGNOSTIC_JK_STATUS);
        if (st != 0) {
            if (str_eq_cstr(st, "completed") == 1 || str_eq_cstr(st, "failed") == 1) { return 1; }
        }
        sleep_ms(10);
        tries = tries + 1;
    }
    return 0;
}

fn _t_list(a, query, ctx) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/api/v1/crews");
    if (query != 0) { str_builder_add_cstr(sb, "?"); str_builder_add_cstr(sb, query); }
    return _t_req(a, AGNOSTIC_METHOD_GET, str_builder_build(sb), "", ctx);
}

fn _t_listed(r) {
    return bayan_json_v_obj_get_by_str(agnostic_response_body(r), AGNOSTIC_JK_CREWS);
}

fn test_crews_belong_to_their_tenant() {
    test_group("tenancy/isolation");
    _t_open();
    var a = arena_allocator(4194304);

    agnostic_argon_pool_init();
    var k = alloc(32);
    var i = 0;
    while (i < 32) { store8(k + i, 70 + i); i = i + 1; }
    agnostic_jwt_set_secret(k, 32);
    var ua = agnostic_users_create_a(a, str_from("op@acme.example"), str_from("pw"), AGNOSTIC_ROLE_OPERATOR,
      str_from("acme"));
    var ug = agnostic_users_create_a(a, str_from("op@globex.example"), str_from("pw"), AGNOSTIC_ROLE_OPERATOR,
      str_from("globex"));
    var ta = agnostic_jwt_issue_a(a, ua, AGNOSTIC_ROLE_OPERATOR, str_from("acme"), 600);
    var tg = agnostic_jwt_issue_a(a, ug, AGNOSTIC_ROLE_OPERATOR, str_from("globex"), 600);

    # A crew in the default scope, submitted with authentication off.
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    var anon = _t_submit(a, 0, _T_BODY);
    assert_neq(anon, 0, "a crew is accepted with authentication off");
    assert_eq(_t_wait(a, anon, 0), 1, "and finishes");

    agnostic_authn_set_mode(AGNOSTIC_AUTH_REQUIRED);
    var acme = _t_submit(a, _t_ctx(a, ta, 0), _T_BODY);
    assert_neq(acme, 0, "an acme operator submits a crew");
    var accepted = agnostic_response_body(agnostic_route_dispatch_a(a, AGNOSTIC_METHOD_GET,
        _t_url(acme, ""), str_from(""), _T_MAXB, _t_ctx(a, ta, 0)));
    assert_eq(str_eq_cstr(agnostic_req_str(accepted, AGNOSTIC_JK_CREW_SCOPE), "acme"), 1,
      "⭐ and the crew is acme's");

    # ⭐ To globex, acme's crew does not exist — on every route.
    var cg = _t_ctx(a, tg, 0);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, ""), "", cg)), HTTP_NOT_FOUND,
      "globex cannot read acme's crew — 404, not 403");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, "/events"), "", _t_ctx(a, tg, 0))),
      HTTP_NOT_FOUND, "nor its events");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, "/plan"), "", _t_ctx(a, tg, 0))),
      HTTP_NOT_FOUND, "nor its plan");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, "/plan?explain=selection"), "",
          _t_ctx(a, tg, 0))), HTTP_NOT_FOUND, "nor why its tasks got their agents (0.1.14)");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_POST, _t_url(acme, "/cancel"), "", _t_ctx(a, tg, 0))),
      HTTP_NOT_FOUND, "nor cancel it");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(anon, ""), "", _t_ctx(a, ta, 0))),
      HTTP_NOT_FOUND, "and the default scope's crew is not acme's either");
    assert_eq(_t_wait(a, acme, _t_ctx(a, ta, 0)), 1, "acme reads its own crew to the end");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, "/plan"), "", _t_ctx(a, ta, 0))),
      HTTP_OK, "and its plan");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, "/plan?explain=selection"), "",
          _t_ctx(a, ta, 0))), HTTP_OK, "explained, too");

    # ⭐ The listing is per tenant.
    var la = _t_listed(_t_list(a, 0, _t_ctx(a, ta, 0)));
    assert_eq(bayan_json_v_arr_len(la), 1, "acme lists exactly its one crew");
    assert_eq(str_eq(agnostic_req_str(bayan_json_v_arr_get(la, 0), AGNOSTIC_JK_CREW_ID), acme), 1, "that one");
    assert_eq(bayan_json_v_arr_len(_t_listed(_t_list(a, 0, _t_ctx(a, tg, 0)))), 0, "globex lists none");
    assert_eq(agnostic_response_status(_t_list(a, 0, 0)), HTTP_UNAUTHORIZED, "and without a credential, 401");

    # A durable crew read back after the ledger forgets it is still scoped.
    agnostic_ledger_reset();
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, ""), "", _t_ctx(a, ta, 0))),
      HTTP_OK, "after a restart acme still reads its finished crew, from the store");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, ""), "", _t_ctx(a, tg, 0))),
      HTTP_NOT_FOUND, "⭐ and globex still cannot — the stored document carries its scope");
    var after = _t_listed(_t_list(a, 0, _t_ctx(a, ta, 0)));
    assert_eq(bayan_json_v_arr_len(after), 1, "⭐ and it is still listed, from the durable index");
    var item = bayan_json_v_arr_get(after, 0);
    assert_eq(str_eq_cstr(agnostic_req_str(item, AGNOSTIC_JK_STATUS), "completed"), 1, "with its status");
    assert_eq(agnostic_req_int(item, AGNOSTIC_JK_TASKS_SUB, 0 - 1), 1, "its task count");
    assert_eq(agnostic_req_int(item, AGNOSTIC_JK_FINISHED_AT, 0 - 1) > 0, 1, "and when it finished");
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
}

fn test_listing_pages_by_cursor() {
    test_group("tenancy/list-cursor");
    _t_open();
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    var a = arena_allocator(4194304);

    var n = 0;
    while (n < 5) {
        _t_submit(a, 0, _T_BODY);
        sleep_ms(3);
        n = n + 1;
    }
    var all = _t_listed(_t_list(a, 0, 0));
    assert_eq(bayan_json_v_arr_len(all), 5, "five crews listed");
    var newest_first = 1;
    var j = 1;
    while (j < 5) {
        if (agnostic_req_int(bayan_json_v_arr_get(all, j), AGNOSTIC_JK_SUBMITTED_AT, 0)
          > agnostic_req_int(bayan_json_v_arr_get(all, j - 1), AGNOSTIC_JK_SUBMITTED_AT, 0)) { newest_first = 0; }
        j = j + 1;
    }
    assert_eq(newest_first, 1, "newest first");

    # Two at a time, following `next`, must visit all five once each.
    var seen = 0;
    var same = 1;
    var pages = 0;
    var cursor = 0;
    while (pages < 5) {
        var q = str_builder_new();
        str_builder_add_cstr(q, "limit=2");
        if (cursor != 0) { str_builder_add_cstr(q, "&before="); str_builder_add(q, cursor); }
        var r = _t_list(a, str_data(str_builder_build(q)), 0);
        assert_eq(agnostic_response_status(r), HTTP_OK, "each page is 200");
        var page = _t_listed(r);
        var p = 0;
        while (p < bayan_json_v_arr_len(page)) {
            if (str_eq(agnostic_req_str(bayan_json_v_arr_get(page, p), AGNOSTIC_JK_CREW_ID),
                agnostic_req_str(bayan_json_v_arr_get(all, seen), AGNOSTIC_JK_CREW_ID)) == 0) { same = 0; }
            seen = seen + 1;
            p = p + 1;
        }
        pages = pages + 1;
        cursor = agnostic_req_str(agnostic_response_body(r), AGNOSTIC_JK_NEXT);
        if (cursor == 0) { break; }
    }
    assert_eq(seen, 5, "paging by two visits every crew");
    assert_eq(same, 1, "once each, in the listing's order");
    assert_eq(pages, 3, "in three pages, the last without a next");

    assert_eq(agnostic_response_status(_t_list(a, "limit=0", 0)), AGNOSTIC_HTTP_UNPROCESSABLE, "limit=0 is 422");
    assert_eq(agnostic_response_status(_t_list(a, "limit=201", 0)), AGNOSTIC_HTTP_UNPROCESSABLE, "limit=201 is 422");
    assert_eq(agnostic_response_status(_t_list(a, "before=yesterday", 0)), AGNOSTIC_HTTP_UNPROCESSABLE,
      "a cursor that is not one is 422");
    assert_eq(agnostic_response_status(_t_list(a, "before=12.not-a-uuid", 0)), AGNOSTIC_HTTP_UNPROCESSABLE,
      "nor is one with a bad id");
    assert_eq(agnostic_perm_for_route(AGNOSTIC_ROUTE_CREW_LIST), AGNOSTIC_PERM_READ, "listing is READ");
}

# How many crews a listing query answers, as `ctx`.
fn _t_count(a, query, ctx) {
    return bayan_json_v_arr_len(_t_listed(_t_list(a, query, ctx)));
}

# ⭐ 0.1.10: `?status=` filters before the page is cut, so a filtered page is full and its
# cursor continues the same filter.
fn test_listing_filters_by_status() {
    test_group("tenancy/list-status");
    _t_open();
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    var a = arena_allocator(4194304);

    var done = _t_submit(a, 0, _T_BODY);
    assert_eq(_t_wait(a, done, 0), 1, "a crew completes");
    # Four more, in the states a placeholder engine never leaves a crew in.
    var sc = AGNOSTIC_SCOPE_DEFAULT;
    var f = agnostic_ledger_record_owned(str_from("aaaaaaaa-0000-4000-8000-000000000001"), str_from("broke"), 0, sc, 0,
      0);
    agnostic_ledger_latch(f, AGNOSTIC_CREW_FAILED, str_from("it broke"), 0);
    agnostic_ledger_record_owned(str_from("aaaaaaaa-0000-4000-8000-000000000002"), str_from("waiting"), 0, sc, 0, 0);
    var r = agnostic_ledger_record_owned(str_from("aaaaaaaa-0000-4000-8000-000000000003"), str_from("busy"), 0, sc, 0,
      0);
    agnostic_ledger_latch(r, AGNOSTIC_CREW_RUNNING, 0, 0);
    var c = agnostic_ledger_record_owned(str_from("aaaaaaaa-0000-4000-8000-000000000004"), str_from("stopped"), 0, sc, 0, 0); #skip-lint
    agnostic_ledger_latch(c, AGNOSTIC_CREW_CANCELLED, 0, 0);

    assert_eq(_t_count(a, 0, 0), 5, "unfiltered, all five");
    assert_eq(_t_count(a, "status=completed", 0), 1, "one completed");
    var only = bayan_json_v_arr_get(_t_listed(_t_list(a, "status=completed", 0)), 0);
    assert_eq(str_eq(agnostic_req_str(only, AGNOSTIC_JK_CREW_ID), done), 1, "and it is the one that ran");
    assert_eq(_t_count(a, "status=failed", 0), 1, "one failed");
    assert_eq(_t_count(a, "status=cancelled", 0), 1, "one cancelled");
    assert_eq(_t_count(a, "status=pending", 0), 1, "one pending");
    assert_eq(_t_count(a, "status=running", 0), 1, "one running");
    assert_eq(_t_count(a, "status=active", 0), 2, "active is pending and running together");
    assert_eq(_t_count(a, "status=unknown", 0), 0, "and nothing is unknown");
    # 0.1.13: a status a restart writes is a filter like the rest — here, matching none.
    assert_eq(agnostic_response_status(_t_list(a, "status=interrupted", 0)), HTTP_OK,
      "status=interrupted is a filter, not a 422");
    assert_eq(_t_count(a, "status=interrupted", 0), 0, "and nothing here was interrupted");

    # The filter holds across pages.
    var p1 = _t_list(a, "status=active&limit=1", 0);
    assert_eq(bayan_json_v_arr_len(_t_listed(p1)), 1, "a filtered page of one");
    var cur = agnostic_req_str(agnostic_response_body(p1), AGNOSTIC_JK_NEXT);
    assert_neq(cur, 0, "with a next");
    var q = str_builder_new();
    str_builder_add_cstr(q, "status=active&limit=1&before=");
    str_builder_add(q, cur);
    var p2 = _t_list(a, str_data(str_builder_build(q)), 0);
    var second = bayan_json_v_arr_get(_t_listed(p2), 0);
    assert_eq(str_eq_cstr(agnostic_req_str(second, AGNOSTIC_JK_STATUS), "pending") == 1
      || str_eq_cstr(agnostic_req_str(second, AGNOSTIC_JK_STATUS), "running") == 1, 1,
      "the next page is still the filter's");
    assert_eq(agnostic_req_str(agnostic_response_body(p2), AGNOSTIC_JK_NEXT), 0, "and the last");

    assert_eq(agnostic_response_status(_t_list(a, "status=bogus", 0)), AGNOSTIC_HTTP_UNPROCESSABLE,
      "a status that is not one is 422");
    assert_eq(agnostic_response_status(_t_list(a, "status=", 0)), AGNOSTIC_HTTP_UNPROCESSABLE,
      "and so is an empty one");
    assert_eq(agnostic_response_status(_t_list(a, "status=Completed", 0)), AGNOSTIC_HTTP_UNPROCESSABLE,
      "status names are lowercase, as the wire spells them");
    agnostic_ledger_reset();
}

# ⭐ 0.1.13 (ADR 0013): a crew a restart interrupted is still its tenant's — read, listed and
# filtered as `interrupted` by acme, and as invisible as ever to everyone else.
fn test_an_interrupted_crew_stays_its_tenants() {
    test_group("tenancy/interrupted");
    _t_open();
    var a = arena_allocator(4194304);

    agnostic_argon_pool_init();
    var k = alloc(32);
    var i = 0;
    while (i < 32) { store8(k + i, 110 + i); i = i + 1; }
    agnostic_jwt_set_secret(k, 32);
    var ua = agnostic_users_create_a(a, str_from("op3@acme.example"), str_from("pw"), AGNOSTIC_ROLE_OPERATOR,
      str_from("acme"));
    var ug = agnostic_users_create_a(a, str_from("op3@globex.example"), str_from("pw"), AGNOSTIC_ROLE_OPERATOR,
      str_from("globex"));
    var ta = agnostic_jwt_issue_a(a, ua, AGNOSTIC_ROLE_OPERATOR, str_from("acme"), 600);
    var tg = agnostic_jwt_issue_a(a, ug, AGNOSTIC_ROLE_OPERATOR, str_from("globex"), 600);
    agnostic_authn_set_mode(AGNOSTIC_AUTH_REQUIRED);
    var acme = _t_submit(a, _t_ctx(a, ta, 0), _T_BODY);
    assert_neq(acme, 0, "an acme operator submits a crew");

    # The process dies before the crew's outcome is written; the next start sweeps it.
    agnostic_engine_reset();
    agnostic_ledger_reset();
    agnostic_store_close();
    patra_init();
    agnostic_store_open(str_from(_T_DB));
    agnostic_auth_ensure();
    agnostic_tenants_ensure();
    agnostic_crews_ensure();
    agnostic_engine_init(agnostic_config_from_env());
    assert_eq(agnostic_crews_interrupt_inflight(), 1, "the start-up sweep interrupts it");

    var g = _t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, ""), "", _t_ctx(a, ta, 0));
    assert_eq(agnostic_response_status(g), HTTP_OK, "acme reads its interrupted crew");
    if (agnostic_response_status(g) == HTTP_OK) {
        var gs = agnostic_response_body(g);
        var gv = bayan_json_v_parse_buf_a(a, str_data(gs), str_len(gs));
        assert_eq(str_eq_cstr(agnostic_req_str(gv, AGNOSTIC_JK_STATUS), "interrupted"), 1, "as interrupted");
    }
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, ""), "", _t_ctx(a, tg, 0))),
      HTTP_NOT_FOUND, "⭐ globex cannot — the stored document carries acme's scope");
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(acme, ""), "", 0)), HTTP_NOT_FOUND,
      "nor can the default scope");
    agnostic_authn_set_mode(AGNOSTIC_AUTH_REQUIRED);

    # Cancel answers from the store too (0.1.15): 409 to its tenant, who can read it, and 404
    # to everyone else, as GET does.
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_POST, _t_url(acme, "/cancel"), "", _t_ctx(a, ta, 0))),
      AGNOSTIC_HTTP_CONFLICT, "acme's cancel is 409: the crew has finished");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_POST, _t_url(acme, "/cancel"), "", _t_ctx(a, tg, 0))),
      HTTP_NOT_FOUND, "⭐ globex's is 404 — a 409 would tell it the crew exists");
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_POST, _t_url(acme, "/cancel"), "", 0)),
      HTTP_NOT_FOUND, "and so is the default scope's");
    agnostic_authn_set_mode(AGNOSTIC_AUTH_REQUIRED);

    # ⭐ Listed unfiltered: a mask that stopped at UNKNOWN would hide it here.
    var la = _t_listed(_t_list(a, 0, _t_ctx(a, ta, 0)));
    assert_eq(bayan_json_v_arr_len(la), 1, "⭐ acme's unfiltered listing includes it");
    if (bayan_json_v_arr_len(la) == 1) {   # the reads below need it; the failure is named above
        var item = bayan_json_v_arr_get(la, 0);
        assert_eq(str_eq(agnostic_req_str(item, AGNOSTIC_JK_CREW_ID), acme), 1, "that crew");
        assert_eq(str_eq_cstr(agnostic_req_str(item, AGNOSTIC_JK_STATUS), "interrupted"), 1, "with status interrupted");
        assert_eq(bayan_json_v_obj_get_by_str(item, AGNOSTIC_JK_FINISHED_AT), 0, "no finished_at: it did not finish");
        assert_eq(bayan_json_v_obj_get_by_str(item, AGNOSTIC_JK_TOTAL_TOK), 0, "no total_tokens: nothing was metered");
        assert_eq(bayan_json_v_obj_get_by_str(item, AGNOSTIC_JK_COST_MICRO), 0,
          "no cost_micro_usd: nothing was priced");
        assert_eq(agnostic_req_int(item, AGNOSTIC_JK_TASKS_SUB, 0 - 1), 1, "and its task count");
    }
    assert_eq(_t_count(a, "status=interrupted", _t_ctx(a, ta, 0)), 1, "status=interrupted finds it");
    assert_eq(_t_count(a, "status=active", _t_ctx(a, ta, 0)), 0, "active does not: it will never run");
    assert_eq(_t_count(a, 0, _t_ctx(a, tg, 0)), 0, "and globex lists nothing");
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
}

# A crew document persisted before 0.1.9 has no scope: it is the default scope's.
fn test_legacy_document_is_the_default_scope() {
    test_group("tenancy/legacy");
    _t_open();
    var a = arena_allocator(1048576);
    var id = str_from("0e0e0e0e-1111-4222-8333-444444444444");
    agnostic_crews_save(id, str_from("old"), AGNOSTIC_CREW_COMPLETED,
      str_from("{\"crew_id\":\"0e0e0e0e-1111-4222-8333-444444444444\",\"status\":\"completed\",\"task_count\":0,\"results\":[]}")); #skip-lint
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(id, ""), "", 0)), HTTP_OK,
      "with authentication off a legacy crew still reads");
    assert_eq(bayan_json_v_arr_len(_t_listed(_t_list(a, 0, 0))), 0,
      "but it has no index row, so it is not listed — said in the CHANGELOG");

    # And it stays the default scope's: a tenant does not read it.
    var k = alloc(32);
    var i = 0;
    while (i < 32) { store8(k + i, 40 + i); i = i + 1; }
    agnostic_jwt_set_secret(k, 32);
    var ug = agnostic_users_create_a(a, str_from("op9@globex.example"), str_from("pw"), AGNOSTIC_ROLE_OPERATOR,
      str_from("globex"));
    var tg = agnostic_jwt_issue_a(a, ug, AGNOSTIC_ROLE_OPERATOR, str_from("globex"), 600);
    agnostic_authn_set_mode(AGNOSTIC_AUTH_REQUIRED);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_url(id, ""), "", _t_ctx(a, tg, 0))),
      HTTP_NOT_FOUND, "a tenant does not read a legacy crew");
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
}

# The bounds of what a client names: an Idempotency-Key, and a number in a query.
fn test_request_limits() {
    test_group("tenancy/limits");
    _t_open();
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    var a = arena_allocator(4194304);

    var longest = alloc(130);
    memset(longest, 107, 128);
    store8(longest + 128, 0);
    var r = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY, _t_ctx(a, 0, longest));
    assert_eq(agnostic_response_status(r), AGNOSTIC_HTTP_ACCEPTED, "a key of 128 is taken");
    memset(longest, 107, 129);
    store8(longest + 129, 0);
    r = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY, _t_ctx(a, 0, longest));
    assert_eq(agnostic_response_status(r), AGNOSTIC_HTTP_UNPROCESSABLE, "one of 129 is refused");

    var ok = _t_req(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/crews?limit=000000000000000050"), "", 0);
    assert_eq(agnostic_response_status(ok), HTTP_OK, "18 digits in a query is a number");
    var over = _t_req(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/crews?limit=0000000000000000050"), "", 0);
    assert_eq(agnostic_response_status(over), AGNOSTIC_HTTP_UNPROCESSABLE, "19 is refused");
}

fn test_idempotency_key() {
    test_group("tenancy/idempotency");
    _t_open();
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    var a = arena_allocator(4194304);

    var r1 = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY, _t_ctx(a, 0, "retry-key-0001"));
    assert_eq(agnostic_response_status(r1), AGNOSTIC_HTTP_ACCEPTED, "a keyed submit is accepted");
    var id1 = agnostic_req_str(agnostic_response_body(r1), AGNOSTIC_JK_CREW_ID);
    var r2 = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY, _t_ctx(a, 0, "retry-key-0001"));
    assert_eq(agnostic_response_status(r2), AGNOSTIC_HTTP_ACCEPTED, "the same key and body is accepted again");
    assert_eq(str_eq(agnostic_req_str(agnostic_response_body(r2), AGNOSTIC_JK_CREW_ID), id1), 1,
      "⭐ as the SAME crew — the retry started nothing");
    assert_eq(bayan_json_v_bool(bayan_json_v_obj_get_by_str(agnostic_response_body(r2), AGNOSTIC_JK_REPLAYED)), 1,
      "and says it is a replay");
    assert_eq(agnostic_ledger_count(), 1, "one crew in the ledger, not two");

    var r3 = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY2, _t_ctx(a, 0, "retry-key-0001"));
    assert_eq(agnostic_response_status(r3), AGNOSTIC_HTTP_UNPROCESSABLE, "the same key with another body is 422");
    assert_eq(agnostic_ledger_count(), 1, "and starts nothing");

    var r4 = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY, _t_ctx(a, 0, "short"));
    assert_eq(agnostic_response_status(r4), AGNOSTIC_HTTP_UNPROCESSABLE, "a key under 8 characters is 422");
    var r5 = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY, _t_ctx(a, 0, "bad key with spaces"));
    assert_eq(agnostic_response_status(r5), AGNOSTIC_HTTP_UNPROCESSABLE, "a key with spaces is 422");

    var r6 = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY, 0);
    assert_eq(agnostic_response_status(r6), AGNOSTIC_HTTP_ACCEPTED, "without a key, a submit is a new crew");
    assert_eq(agnostic_ledger_count(), 2, "every time");
    assert_eq(bayan_json_v_obj_get_by_str(agnostic_response_body(r6), AGNOSTIC_JK_REPLAYED), 0,
      "and is not a replay");

    # Keys do not cross scopes: acme's key is acme's.
    agnostic_argon_pool_init();
    var k = alloc(32);
    var i = 0;
    while (i < 32) { store8(k + i, 90 + i); i = i + 1; }
    agnostic_jwt_set_secret(k, 32);
    var ua = agnostic_users_create_a(a, str_from("op2@acme.example"), str_from("pw"), AGNOSTIC_ROLE_OPERATOR,
      str_from("acme"));
    var ta = agnostic_jwt_issue_a(a, ua, AGNOSTIC_ROLE_OPERATOR, str_from("acme"), 600);
    agnostic_authn_set_mode(AGNOSTIC_AUTH_REQUIRED);
    var r7 = _t_req(a, AGNOSTIC_METHOD_POST, str_from("/api/v1/crews"), _T_BODY, _t_ctx(a, ta, "retry-key-0001"));
    assert_eq(agnostic_response_status(r7), AGNOSTIC_HTTP_ACCEPTED, "the same key in another tenant is accepted");
    assert_eq(str_eq(agnostic_req_str(agnostic_response_body(r7), AGNOSTIC_JK_CREW_ID), id1), 0,
      "⭐ as a new crew of its own — never the other tenant's");
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
}

# A finished crew stored in `scope`, id `n` in octal at the end of the id, submitted at `at`.
fn _t_stored(a, n, scope, status, at, doc: Str) {
    var id = alloc_via(a, 37);
    memcpy(id, "00000000-0000-4000-8000-000000000000", 37);
    var i = 0;
    while (i < 4) {
        store8(id + 35 - i, 48 + ((n >> (i * 3)) & 7));
        i = i + 1;
    }
    var row = agnostic_crew_row_new_a(a);
    agnostic_crew_row_set(row, AGNOSTIC_CR_CREW_ID, str_new_a(a, id, 36));
    agnostic_crew_row_set(row, AGNOSTIC_CR_SCOPE, str_from_a(a, scope));
    agnostic_crew_row_set(row, AGNOSTIC_CR_STATUS, status);
    agnostic_crew_row_set(row, AGNOSTIC_CR_SUBMITTED, at);
    agnostic_crews_save_row(row, doc);
    return row;
}

# Walk every page of the listing `query`: how many crews it listed, or -1 when one came twice.
fn _t_walk(a, query) {
    var seen = vec_new_a(a);
    var next = 0;
    while (1) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, query);
        if (next != 0) { str_builder_add_cstr(sb, "&before="); str_builder_add(sb, next); }
        var r = _t_list(a, str_data(str_builder_build(sb)), 0);
        if (agnostic_response_status(r) != HTTP_OK) { return 0 - 1; }
        var arr = _t_listed(r);
        var i = 0;
        while (i < bayan_json_v_arr_len(arr)) {
            var id = agnostic_req_str(bayan_json_v_arr_get(arr, i), AGNOSTIC_JK_CREW_ID);
            var j = 0;
            while (j < vec_len(seen)) {
                if (str_eq(vec_get(seen, j), id) == 1) { return 0 - 1; }
                j = j + 1;
            }
            vec_push_a(a, seen, id);
            i = i + 1;
        }
        var nv = bayan_json_v_obj_get_by_str(agnostic_response_body(r), AGNOSTIC_JK_NEXT);
        if (nv == 0) { return vec_len(seen); }
        next = bayan_json_v_str(nv);
    }
}

# ⭐ 0.2.3: the listing asks the store for only what can reach the page. A limit decides which
# crews come back, so it has to agree with the cursor about their order, or a crew falls between
# two pages for good; and rows the cursor steps over must not stand in for rows the limit cut.
fn test_list_read_is_cut() {
    test_group("tenancy/list-read-cut");
    _t_open();
    var a = arena_allocator(16777216);
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    var doc = str_from("{\"status\":\"completed\"}");
    var i = 0;
    # Thirty crews in one millisecond, so the walk's limit always falls inside the tie, and not
    # stored in id order, or the store's own order could pass for the listing's.
    while (i < 30) {
        _t_stored(a, (i * 7) % 30, "_", AGNOSTIC_CREW_COMPLETED, 1700000000000, doc);
        i = i + 1;
    }
    while (i < 36) {
        _t_stored(a, i, "_", AGNOSTIC_CREW_FAILED, 1699999999000 - i, doc);
        i = i + 1;
    }
    assert_eq(_t_walk(a, "limit=2"), 36, "⭐ two at a time, every crew is listed exactly once");
    assert_eq(_t_walk(a, "limit=7"), 36, "seven at a time, the same");
    assert_eq(_t_walk(a, "limit=200"), 36, "and one page holds them all");
    assert_eq(_t_walk(a, "limit=2&status=failed"), 6, "a filtered walk lists its six");
    assert_eq(_t_walk(a, "limit=2&status=completed"), 30, "and the thirty in one millisecond");
    assert_eq(_t_walk(a, "limit=5&status=active"), 0, "nothing stored is in flight");
    var r = _t_list(a, "limit=3", 0);
    var arr = _t_listed(r);
    assert_eq(str_eq_cstr(agnostic_req_str(bayan_json_v_arr_get(arr, 0), AGNOSTIC_JK_CREW_ID),
        "00000000-0000-4000-8000-000000000035"), 1, "the page starts at the highest id of the newest tie");

    var some = agnostic_crews_index_page_a(a, str_from("_"), 0 - 1, 0 - 1, 3);
    assert_eq(vec_len(some), 3, "a read of 3 is 3 rows");
    assert_eq(vec_len(agnostic_crews_index_page_a(a, str_from("_"), AGNOSTIC_CREW_FAILED, 0 - 1, 0)), 6,
      "a read narrows to one status");
    assert_eq(vec_len(agnostic_crews_index_page_a(a, str_from("_"), 0 - 1, 1699999999000 - 31, 0)), 5,
      "and to crews at or before a time");
    assert_eq(vec_len(agnostic_crews_index_page_a(a, str_from("nobody"), 0 - 1, 0 - 1, 3)), 0,
      "and to the scope");
    return 0;
}

# ⭐ 0.2.3: a stored crew goes out as the bytes it was stored as, and belongs to its scope with
# or without a parse.
fn test_stored_bytes() {
    test_group("tenancy/stored-bytes");
    _t_open();
    var a = arena_allocator(4194304);
    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
    var doc = str_from("{\"status\":\"completed\",\"a\":{\"scope\":\"nested\"},\"z\":1.50,\"scope\":\"_\"}");
    var row = _t_stored(a, 1, "_", AGNOSTIC_CREW_COMPLETED, 1700000000000, doc);
    var id = agnostic_crew_row_get(row, AGNOSTIC_CR_CREW_ID);
    var g = _t_req(a, AGNOSTIC_METHOD_GET, _t_url(id, ""), "", 0);
    assert_eq(agnostic_response_status(g), HTTP_OK, "a stored crew reads back");
    assert_eq(str_eq(agnostic_response_body(g), doc), 1, "⭐ byte for byte: no key moved, 1.50 stayed 1.50");
    assert_eq(str_eq_cstr(str_from(agnostic_response_ctype(g)), "application/json"), 1, "as JSON");

    var other = _t_stored(a, 2, "acme", AGNOSTIC_CREW_COMPLETED, 1700000000000, doc);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET,
          _t_url(agnostic_crew_row_get(other, AGNOSTIC_CR_CREW_ID), ""), "", 0)), HTTP_OK,
      "a document's own scope field decides, not the row it came with");

    var nested = str_from("{\"status\":\"completed\",\"a\":{\"scope\":\"_\"},\"scope\":\"acme\"}");
    var nr = _t_stored(a, 3, "acme", AGNOSTIC_CREW_COMPLETED, 1700000000000, nested);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET,
          _t_url(agnostic_crew_row_get(nr, AGNOSTIC_CR_CREW_ID), ""), "", 0)), HTTP_NOT_FOUND,
      "⭐ a nested scope is not the document's: acme's crew is not `_`'s");

    var old = str_from("{\"status\":\"completed\"}");
    var or = _t_stored(a, 4, "_", AGNOSTIC_CREW_COMPLETED, 1700000000000, old);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET,
          _t_url(agnostic_crew_row_get(or, AGNOSTIC_CR_CREW_ID), ""), "", 0)), HTTP_OK,
      "a document from before 0.1.9 has no scope, and is the default scope's");

    # What the engine reported is stored as it came, and bayan reads what the strict walk refuses.
    var text = "{\"output\":\"xZy\",\"scope\":\"_\"}";
    var raw = alloc_via(a, strlen(text));
    memcpy(raw, text, strlen(text));
    store8(raw + 12, 255);
    var bad = str_new_a(a, raw, strlen(text));
    assert_eq(agnostic_json_kind(bad), AGNOSTIC_JSON_MALFORMED, "the strict walk refuses a byte that is not UTF-8");
    var br = _t_stored(a, 5, "_", AGNOSTIC_CREW_COMPLETED, 1700000000000, bad);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET,
          _t_url(agnostic_crew_row_get(br, AGNOSTIC_CR_CREW_ID), ""), "", 0)), HTTP_OK,
      "⭐ and that crew stays readable, through the parse");

    var broken = _t_stored(a, 6, "_", AGNOSTIC_CREW_COMPLETED, 1700000000000, str_from("{\"status\":"));
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET,
          _t_url(agnostic_crew_row_get(broken, AGNOSTIC_CR_CREW_ID), ""), "", 0)), HTTP_NOT_FOUND,
      "a document neither can read is not sent");
    return 0;
}

fn _t_def_url(key) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/api/v1/agents/definitions/");
    str_builder_add_cstr(sb, key);
    return str_builder_build(sb);
}

fn _t_def_total(a, ctx) {
    var r = _t_req(a, AGNOSTIC_METHOD_GET, str_from("/api/v1/agents/definitions"), "", ctx);
    return bayan_json_v_int(bayan_json_v_obj_get_by_cstr(agnostic_response_body(r), "total"));
}

# Audit S3, as reproduced: a tenant-b OPERATOR listed, read, replaced and deleted tenant-a's
# definition through the real dispatcher.
fn test_definitions_are_per_tenant() {
    test_group("tenancy/definitions");

    _t_open();
    agnostic_store_ensure(AGNOSTIC_DEF_TABLE_SQL);
    agnostic_store_ensure(AGNOSTIC_DEF_INDEX_SQL);
    agnostic_definitions_reset();
    agnostic_authn_set_mode(AGNOSTIC_AUTH_REQUIRED);
    agnostic_jwt_init_random();
    agnostic_argon_pool_init();

    var a = arena_allocator(4194304);
    var ua = agnostic_users_create_a(a, str_from("d-a@example.com"), str_from("pw"),
      AGNOSTIC_ROLE_OPERATOR, str_from("tenant-a"));
    var ub = agnostic_users_create_a(a, str_from("d-b@example.com"), str_from("pw"),
      AGNOSTIC_ROLE_OPERATOR, str_from("tenant-b"));
    var ud = agnostic_users_create_a(a, str_from("d-d@example.com"), str_from("pw"),
      AGNOSTIC_ROLE_OPERATOR, 0);
    var ca = _t_ctx(a, agnostic_jwt_issue_a(a, ua, AGNOSTIC_ROLE_OPERATOR, 0, 600), 0);
    var cb = _t_ctx(a, agnostic_jwt_issue_a(a, ub, AGNOSTIC_ROLE_OPERATOR, 0, 600), 0);
    var cd = _t_ctx(a, agnostic_jwt_issue_a(a, ud, AGNOSTIC_ROLE_OPERATOR, 0, 600), 0);

    var doc = "{\"key\":\"shared\",\"name\":\"A\",\"role\":\"r\",\"goal\":\"g\"}";
    var edit = "{\"key\":\"shared\",\"name\":\"B\",\"role\":\"r\",\"goal\":\"g\"}";
    var url = _t_def_url("shared");
    var coll = str_from("/api/v1/agents/definitions");

    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_POST, coll, doc, ca)),
      AGNOSTIC_HTTP_CREATED, "tenant-a creates a definition");
    assert_eq(_t_def_total(a, ca), 1, "and lists it");

    assert_eq(_t_def_total(a, cb), 0, "tenant-b's listing does not hold it");
    assert_eq(_t_def_total(a, cd), 0, "nor does the default scope's");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, url, "", cb)), HTTP_NOT_FOUND,
      "tenant-b reads 404, not 403");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_PUT, url, edit, cb)), HTTP_NOT_FOUND,
      "tenant-b cannot replace it");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_DELETE, url, "", cb)), HTTP_NOT_FOUND,
      "tenant-b cannot delete it");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, url, "", ca)), HTTP_OK,
      "and it is still tenant-a's");

    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_POST, coll, edit, cb)),
      AGNOSTIC_HTTP_CREATED, "the same key is free in tenant-b");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_POST, coll, doc, ca)),
      AGNOSTIC_HTTP_CONFLICT, "and still taken in tenant-a");
    var got = agnostic_response_body(_t_req(a, AGNOSTIC_METHOD_GET, url, "", ca));
    assert_eq(str_eq_cstr(agnostic_req_str(bayan_json_v_obj_get_by_cstr(got, "definition"),
          AGNOSTIC_JK_NAME), "A"), 1, "tenant-b's write did not touch tenant-a's document");

    # A row written before 0.3.0 has no colon: it needs no migration, and it is the default
    # scope's, as a crew stored before 0.1.9 is.
    var rej: i64[1];
    store64(&rej, 0);
    var old_row = agnostic_agent_def_decode_a(a, agnostic_decode_a(a,
        str_from("{\"key\":\"older\",\"name\":\"O\",\"role\":\"r\",\"goal\":\"g\"}")), 0 - 1, &rej);
    agnostic_definitions_create(str_from("older"), old_row);
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_def_url("older"), "", cd)),
      HTTP_OK, "a row from before 0.3.0 reads in the default scope");
    assert_eq(agnostic_response_status(_t_req(a, AGNOSTIC_METHOD_GET, _t_def_url("older"), "", ca)),
      HTTP_NOT_FOUND, "and in no tenant");
    assert_eq(_t_def_total(a, cd), 1, "and is listed there");

    agnostic_authn_set_mode(AGNOSTIC_AUTH_OFF);
}

fn main() {
    alloc_init();
    thread_local_init();
    agnostic_crypto_main_init();
    test_crews_belong_to_their_tenant();
    test_listing_pages_by_cursor();
    test_listing_filters_by_status();
    test_an_interrupted_crew_stays_its_tenants();
    test_legacy_document_is_the_default_scope();
    test_idempotency_key();
    test_request_limits();
    test_list_read_is_cut();
    test_stored_bytes();
    test_definitions_are_per_tenant();
    agnostic_store_close();
    _tt_unlink_store(_T_DB);
    return assert_summary();
}

