# --- rng.cyr ---

# tyche — sovereign deterministic statistical PRNG
#
# ┌───────────────────────────────────────────────────────────────────────────┐
# │  ⚠  STATISTICAL, NOT CRYPTOGRAPHIC.                                        │
# │  Reproducible-by-seed sampling for simulation, ML weight init, Monte       │
# │  Carlo, dropout — anywhere you want the SAME stream from the SAME seed.    │
# │  xorshift64 is trivially predictable: from one output an attacker          │
# │  recovers all past and future outputs. Do NOT use for keys, nonces,        │
# │  session tokens, salts, or provable fairness — use sigil's CSPRNG.         │
# └───────────────────────────────────────────────────────────────────────────┘
#
# Cyrius has no float type: an f64 is its 64-bit IEEE-754 bit pattern carried in
# an i64. The f64_* operations here are compiler builtins acting on those
# patterns. Integer multiply wraps mod 2^64 (used by the seed finalizer).
#
# Every stream is bit-identical on every target because only IEEE-754 basic
# operations touch an f64 here: add, sub, mul, div and sqrt, each correctly
# rounded (SSE2 on x86_64, scalar FP on aarch64, never fused), plus exact
# integer conversions and comparisons. No transcendental
# builtin is used — f64_ln is x87 on x86_64 but a looser software polyfill on
# aarch64 — so rng_normal carries its own logarithm, _rng_ln, below.
#
# Algorithms (see docs/development/sources.md):
#   * xorshift64 stream — Marsaglia, G. (2003), "Xorshift RNGs", J. Stat. Soft.
#     8(14): the (13, 7, 17) shift triple below.
#   * splitmix64 seed finalizer — Steele, Lea & Flood (2014), "Fast Splittable
#     PRNGs", OOPSLA 2014: the finalizer constants below.
#   * standard normal via Marsaglia polar — Marsaglia & Bray (1964), "A
#     Convenient Method for Generating Normal Variables", SIAM Review 6(3).
#     Chosen over Box-Muller: no sin/cos required.
#   * _rng_ln — double-double arithmetic after Dekker (1971), "A floating-point
#     technique for extending the available precision", Numer. Math. 18(3).

# Process-global xorshift state. A SINGLE stream: the single-threaded sovereign
# execution model relies on this. The coming multi-threading / SMP arc will need
# per-stream handles (a seeded state struct passed explicitly) to stay
# reproducible across threads — flagged here as the unwind point.
var _rng_state = 88172645463325252;

# Seed the stream. Scrambles the seed with a splitmix64 finalizer so small or
# sequential seeds don't produce correlated or near-zero first outputs. A seed
# that finalizes to 0 is bumped to 1 (xorshift's fixed point is 0 — it would
# emit a constant zero stream).
fn rng_seed(s): i64 {
    s = s + 0x9E3779B97F4A7C15;
    var z = s;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    z = z ^ (z >> 31);
    if (z == 0) { z = 1; }
    _rng_state = z;
    return 0;
}

# Next raw 64-bit value from the xorshift64 stream.
fn rng_u64(): i64 {
    var x = _rng_state;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    _rng_state = x;
    return x;
}

# Uniform f64 in [0,1): take the top 53 bits and scale by 2^-53. The logical
# shift keeps the value non-negative, so the result is always in [0,1). Both
# steps are exact (m < 2^53 converts exactly; scaling by a power of two only
# moves the exponent), so this equals m / 2^53 bit for bit.
fn rng_uniform(): i64 {
    var u = rng_u64();
    var m = u >> 11;                  # logical shift -> top 53 bits, always >= 0
    return f64_mul(f64_from(m), 0x3CA0000000000000);            # * 2^-53
}

# ---- _rng_ln: a portable natural logarithm --------------------------------
#
# Natural log of a positive normal f64. Internal, with a precondition rather than
# guards: no 0, subnormal, negative, infinite or NaN input. Its one caller,
# rng_normal, passes s in [2^-104, 1).
#
# x = 2^k * m with m in [sqrt(1/2), sqrt(2)], then ln x = k ln 2 + 2 atanh(t),
# t = (m - 1)/(m + 1), |t| <= 3 - 2 sqrt(2) = 0.1716. With T = t^2:
#   2 atanh(t) = 2t + t^3 Q(T),  Q(T) = 2/3 + (2/5)T + (2/7)T^2 + ... + (2/27)T^10
# t, T, the 2/3 and 2/5 terms and every product are carried as double-doubles
# (a value hi + lo worth ~106 bits); only the (2/7 ...) tail is plain f64, where
# its rounding costs < 2^-70 of the result. Truncation after (2/27)T^10 costs
# < 2^-72. The last f64_add rounds a value within ~2^-70 of ln x, so the result
# is the correctly rounded ln x unless ln x lies within ~2^-70 of a rounding
# midpoint. Against a 50-digit reference it was correct on all 1,294,808 test
# inputs and on all but one of the 10,000,000 values of s behind a 10M-draw
# rng_normal run; that one lies 2^-74.2 from a midpoint and came out 1 ulp the
# other way. So the stream is defined by these exact operations, which
# scripts/kat_reference.py ports one for one.
#
# The double-double steps are written out inline (no helper calls) and each
# value is split once. Building blocks, all exact for IEEE-754 binary64:
#   split(a):         c = (2^27 + 1) a;  a_h = c - (c - a);  a_l = a - a_h
#   two_prod(a, b):   p = a b;  e = ((a_h b_h - p) + a_h b_l + a_l b_h) + a_l b_l
#                     then p + e == a * b exactly (Dekker 1971; no FMA)
#   fast_two_sum:     s = a + b;  e = b - (s - a)            (needs |a| >= |b|)
#   two_sum:          s = a + b;  bb = s - a;  e = (a - (s - bb)) + (b - bb)
fn _rng_ln(x): i64 {
    var split = 0x41A0000002000000;                              # 2^27 + 1
    var one = 0x3FF0000000000000;
    var k = ((x >> 52) & 0x7FF) - 1023;
    var mb = (x & 0x000FFFFFFFFFFFFF) | one;                     # m in [1, 2)
    if (mb > 0x3FF6A09E667F3BCD) {                              # m > sqrt(2)
        mb = mb - 0x0010000000000000;                           # m / 2, exactly
        k = k + 1;
    }
    var fm = f64_sub(mb, one);                                  # m - 1, exact
    var d_hi = f64_add(one, mb);                                # m + 1 = d_hi + d_lo
    var d_lo = f64_sub(mb, f64_sub(d_hi, one));

    # t = fm / (d_hi + d_lo) = t_hi + t_lo, from the exact residual of t_hi d_hi.
    var t_hi = f64_div(fm, d_hi);
    var sp = f64_mul(split, t_hi);
    var t_h = f64_sub(sp, f64_sub(sp, t_hi));
    var t_l = f64_sub(t_hi, t_h);
    sp = f64_mul(split, d_hi);
    var d_h = f64_sub(sp, f64_sub(sp, d_hi));
    var d_l = f64_sub(d_hi, d_h);
    var p = f64_mul(t_hi, d_hi);
    var e = f64_add(f64_add(f64_add(f64_sub(f64_mul(t_h, d_h), p), f64_mul(t_h, d_l)),
        f64_mul(t_l, d_h)), f64_mul(t_l, d_l));
    var t_lo = f64_div(f64_sub(f64_sub(f64_sub(fm, p), e), f64_mul(t_hi, d_lo)), d_hi);

    # T = t^2 = tt_hi + tt_lo.
    p = f64_mul(t_hi, t_hi);
    e = f64_add(f64_add(f64_add(f64_sub(f64_mul(t_h, t_h), p), f64_mul(t_h, t_l)),
        f64_mul(t_l, t_h)), f64_mul(t_l, t_l));
    e = f64_add(e, f64_add(f64_mul(t_hi, t_lo), f64_mul(t_lo, t_hi)));
    var tt_hi = f64_add(p, e);
    var tt_lo = f64_sub(e, f64_sub(tt_hi, p));
    sp = f64_mul(split, tt_hi);
    var tt_h = f64_sub(sp, f64_sub(sp, tt_hi));
    var tt_l = f64_sub(tt_hi, tt_h);

    # (2/7)T^0 ... (2/27)T^10 in plain f64, Horner from the top.
    var q = 0x3FB2F684BDA12F68;                                     # 2/27
    q = f64_add(0x3FB47AE147AE147B, f64_mul(tt_hi, q));             # 2/25
    q = f64_add(0x3FB642C8590B2164, f64_mul(tt_hi, q));             # 2/23
    q = f64_add(0x3FB8618618618618, f64_mul(tt_hi, q));             # 2/21
    q = f64_add(0x3FBAF286BCA1AF28, f64_mul(tt_hi, q));             # 2/19
    q = f64_add(0x3FBE1E1E1E1E1E1E, f64_mul(tt_hi, q));             # 2/17
    q = f64_add(0x3FC1111111111111, f64_mul(tt_hi, q));             # 2/15
    q = f64_add(0x3FC3B13B13B13B14, f64_mul(tt_hi, q));             # 2/13
    q = f64_add(0x3FC745D1745D1746, f64_mul(tt_hi, q));             # 2/11
    q = f64_add(0x3FCC71C71C71C71C, f64_mul(tt_hi, q));             # 2/9
    q = f64_add(0x3FD2492492492492, f64_mul(tt_hi, q));             # 2/7

    # a = T q (double-double times f64; q has no low word, hence the tt_hi * 0 term
    # that keeps the general double-double product's exact operation sequence).
    sp = f64_mul(split, q);
    var q_h = f64_sub(sp, f64_sub(sp, q));
    var q_l = f64_sub(q, q_h);
    p = f64_mul(tt_hi, q);
    e = f64_add(f64_add(f64_add(f64_sub(f64_mul(tt_h, q_h), p), f64_mul(tt_h, q_l)),
        f64_mul(tt_l, q_h)), f64_mul(tt_l, q_l));
    e = f64_add(e, f64_add(f64_mul(tt_hi, 0), f64_mul(tt_lo, q)));
    var a_hi = f64_add(p, e);
    var a_lo = f64_sub(e, f64_sub(a_hi, p));

    # a = 2/5 + a, with 2/5 as the pair 0x3FD999999999999A + 0xBC7999999999999A.
    var s = f64_add(0x3FD999999999999A, a_hi);
    var bb = f64_sub(s, 0x3FD999999999999A);
    e = f64_add(f64_add(f64_sub(0x3FD999999999999A, f64_sub(s, bb)), f64_sub(a_hi, bb)),
      f64_add(0xBC7999999999999A, a_lo));
    a_hi = f64_add(s, e);
    a_lo = f64_sub(e, f64_sub(a_hi, s));

    # a = T a.
    sp = f64_mul(split, a_hi);
    var a_h = f64_sub(sp, f64_sub(sp, a_hi));
    var a_l = f64_sub(a_hi, a_h);
    p = f64_mul(tt_hi, a_hi);
    e = f64_add(f64_add(f64_add(f64_sub(f64_mul(tt_h, a_h), p), f64_mul(tt_h, a_l)),
        f64_mul(tt_l, a_h)), f64_mul(tt_l, a_l));
    e = f64_add(e, f64_add(f64_mul(tt_hi, a_lo), f64_mul(tt_lo, a_hi)));
    a_hi = f64_add(p, e);
    a_lo = f64_sub(e, f64_sub(a_hi, p));

    # Q = 2/3 + a, with 2/3 as the pair 0x3FE5555555555555 + 0x3C85555555555555.
    s = f64_add(0x3FE5555555555555, a_hi);
    bb = f64_sub(s, 0x3FE5555555555555);
    e = f64_add(f64_add(f64_sub(0x3FE5555555555555, f64_sub(s, bb)), f64_sub(a_hi, bb)),
      f64_add(0x3C85555555555555, a_lo));
    a_hi = f64_add(s, e);
    a_lo = f64_sub(e, f64_sub(a_hi, s));

    # c = t T = t^3.
    p = f64_mul(t_hi, tt_hi);
    e = f64_add(f64_add(f64_add(f64_sub(f64_mul(t_h, tt_h), p), f64_mul(t_h, tt_l)),
        f64_mul(t_l, tt_h)), f64_mul(t_l, tt_l));
    e = f64_add(e, f64_add(f64_mul(t_hi, tt_lo), f64_mul(t_lo, tt_hi)));
    var c_hi = f64_add(p, e);
    var c_lo = f64_sub(e, f64_sub(c_hi, p));

    # c = c Q = t^3 Q.
    sp = f64_mul(split, c_hi);
    var c_h = f64_sub(sp, f64_sub(sp, c_hi));
    var c_l = f64_sub(c_hi, c_h);
    sp = f64_mul(split, a_hi);
    a_h = f64_sub(sp, f64_sub(sp, a_hi));
    a_l = f64_sub(a_hi, a_h);
    p = f64_mul(c_hi, a_hi);
    e = f64_add(f64_add(f64_add(f64_sub(f64_mul(c_h, a_h), p), f64_mul(c_h, a_l)),
        f64_mul(c_l, a_h)), f64_mul(c_l, a_l));
    e = f64_add(e, f64_add(f64_mul(c_hi, a_lo), f64_mul(c_lo, a_hi)));
    var cq_hi = f64_add(p, e);
    var cq_lo = f64_sub(e, f64_sub(cq_hi, p));

    # ln m = 2t + t^3 Q. For k == 0 that is ln x, and its rounding is l_hi.
    var u_hi = f64_mul(0x4000000000000000, t_hi);
    var u_lo = f64_mul(0x4000000000000000, t_lo);
    s = f64_add(u_hi, cq_hi);
    bb = f64_sub(s, u_hi);
    e = f64_add(f64_add(f64_sub(u_hi, f64_sub(s, bb)), f64_sub(cq_hi, bb)), f64_add(u_lo, cq_lo));
    var l_hi = f64_add(s, e);
    if (k == 0) { return l_hi; }
    var l_lo = f64_sub(e, f64_sub(l_hi, s));

    # + k ln 2: ln 2 = 0x3FE62E42FEFA39EF + 0x3C7ABC9E3B39803F, and k * ln2_hi is
    # formed exactly (ln2_hi's split halves are the two constants below).
    var kf = f64_from(k);
    sp = f64_mul(split, kf);
    var k_h = f64_sub(sp, f64_sub(sp, kf));
    var k_l = f64_sub(kf, k_h);
    p = f64_mul(kf, 0x3FE62E42FEFA39EF);
    e = f64_add(f64_add(f64_add(f64_sub(f64_mul(k_h, 0x3FE62E4300000000), p),
          f64_mul(k_h, 0xBE205C6110000000)), f64_mul(k_l, 0x3FE62E4300000000)),
      f64_mul(k_l, 0xBE205C6110000000));
    e = f64_add(e, f64_mul(kf, 0x3C7ABC9E3B39803F));

    # ln x = (p + e) + (l_hi + l_lo), rounded once.
    s = f64_add(p, l_hi);
    bb = f64_sub(s, p);
    e = f64_add(f64_add(f64_sub(p, f64_sub(s, bb)), f64_sub(l_hi, bb)), f64_add(e, l_lo));
    return f64_add(s, e);
}

# Standard normal (mean 0, variance 1) via the Marsaglia polar method. Rejection
# loop: draw points in the square [-1,1)^2 until one lands strictly inside the
# unit circle, then scale by sqrt(-2 ln(s) / s). The ln is tyche's own _rng_ln,
# not the f64_ln builtin, so the stream is the same bits on every target.
fn rng_normal(): i64 {
    var s = 0;                                          # +0.0
    var v1 = 0;
    var one = 0x3FF0000000000000;
    var two = 0x4000000000000000;
    while (1 == 1) {
        v1 = f64_sub(f64_mul(two, rng_uniform()), one);   # in [-1,1)
        var v2 = f64_sub(f64_mul(two, rng_uniform()), one);
        s = f64_add(f64_mul(v1, v1), f64_mul(v2, v2));
        if ((f64_lt(s, one) == 1) && (f64_gt(s, 0) == 1)) { break; }
    }
    var factor = f64_sqrt(f64_div(f64_mul(0xC000000000000000, _rng_ln(s)), s));   # -2
    return f64_mul(v1, factor);
}
