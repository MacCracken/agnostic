# agnosai.cyr -- bundled distribution
# Version: 2.1.0
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib

# --- units.cyr ---

# =========================================================================
# units — the shared time-unit constants.
#
# No oracle module. Rust gets these from `std::time::Duration`'s constructors;
# the port carries durations as plain i64 nanoseconds (see learning_profile for
# why), so the scale factors have to live somewhere.
#
# Extracted once three groups needed them — `learning_profile` and `core_error`
# had each grown its own, under two different names for the same value
# (learning_profile called it `AGNOSAI_NANOS_PER_MILLI`, core_error
# `AGNOSAI_NS_PER_MS`), and `llm_retry` would have been the third. One
# definition each, `AGNOSAI_NS_PER_*`, is now the canonical spelling.
#
# This module must be included before any group that measures time.
# =========================================================================

# Nanoseconds in one second.
var AGNOSAI_NS_PER_SEC = 1000000000;

# Nanoseconds in one millisecond.
var AGNOSAI_NS_PER_MS = 1000000;

# Nanoseconds in one microsecond.
var AGNOSAI_NS_PER_US = 1000;

# --- shared byte predicates ------------------------------------------------

# Whether a byte is an ASCII digit.
#
# Hoisted here from `server_ssrf` and `server_output_filter`, which had grown
# byte-identical copies. Cyrius has one flat namespace, so the two definitions
# were a silent last-definition-wins pair — benign while the bodies agreed, and
# exactly the condition ADR 007 was written about. `units` is included first, so
# every consumer sees the same one.
fn _agnosai_is_digit(b): i64 {
    if (b >= 48 && b <= 57) { return 1; }
    return 0;
}

# A lowercased copy of `s`, ASCII only — the oracle's `to_ascii_lowercase`.
#
# ⚠ Lives HERE, not in llm/retry.cyr where it was written, since 2.0.7. It is a generic ASCII helper with
# no LLM content, and `src/server/output_filter.cyr` also calls it — which meant the `[lib.guard]` profile
# could not close without dragging the entire LLM retry module (and its rng_uniform dep on tyche) into a
# bundle whose whole point is to carry no engine surface. Cyrius has ONE flat namespace, so every existing
# caller is unaffected by the move.
fn _agnosai_to_ascii_lower(s: Str): i64 {
    var len = str_len(s);
    var src = str_data(s);
    var buf = alloc(len + 1);
    for (var i = 0; i < len; i = i + 1) {
        var c = load8(src + i);
        if (c >= 65 && c <= 90) { c = c + 32; }
        store8(buf + i, c);
    }
    store8(buf + len, 0);
    return str_new(buf, len);
}

# --- order.cyr ---

# =========================================================================
# order — O(n log n) sorting and selection.
#
# No oracle module: Rust got these from `slice::sort_unstable` and
# `select_nth_unstable`. Cyrius's stdlib has neither, which is **port plan
# blocker #8** — and it is not a theoretical gap. Measured on this box at
# cyrius 6.4.83, an itihas-style insertion sort over agnosai's 100k-entry
# percentile vector (builtin/load_testing.rs) costs **52.6 seconds**; heapsort
# costs 87 ms, and three quickselects cost ~21 ms. Percentiles never needed a
# full sort in the first place.
#
# **The algorithms are no longer vendored here.** `vec_sort_by` and
# `vec_select_nth` shipped in cyrius **6.5.4**, closing agnosai's own filing
# (`2026-07-28-agnosai-no-nlogn-sort-in-stdlib`). This module keeps its public
# API and delegates. Measured on this box, 100k elements:
#
# | benchmark | vendored | stdlib | |
# |---|---|---|---|
# | `sort_100k` | 79.6 ms | **20.4 ms** | 3.90x |
# | `sort_10k` | 6.30 ms | **1.71 ms** | 3.69x |
# | `sort_100k_already_sorted` | 79.1 ms | **3.35 ms** | **23.6x** |
# | `three_percentiles_100k` | 10.7 ms | **7.88 ms** | 1.35x |
# | `select_nth_100k` | 6.89 ms | **5.18 ms** | 1.33x |
#
# The already-sorted row is the big one and it is a real difference in kind:
# heapsort's worst case equals its average, so it had no fast path. The stdlib
# introsort checks for pre-sorted input first. A latency vector that arrives
# roughly ordered — which is common — now costs a scan instead of a full sort.
#
# **What does NOT delegate is the guard set**, and that is deliberate:
# `vec_select_nth` **aborts the process** (`_vec_die()`) on `k < 0` or
# `k >= len`, where this module's contract — pinned by three assertions in
# `tests/order.tcyr` — is to return 0. An empty latency vector is an ordinary
# state for a load test that recorded no samples, not a reason to kill the
# server, so the wrappers keep their bounds checks and only the sorting is
# delegated.
#
# Comparators are `fn(a, b): i64`, negative / zero / positive like C's qsort.
# =========================================================================

# Ascending order for plain i64 elements.
fn agnosai_cmp_i64_asc(a, b): i64 {
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 0;
}

# Descending order for plain i64 elements.
fn agnosai_cmp_i64_desc(a, b): i64 {
    if (a < b) { return 1; }
    if (a > b) { return 0 - 1; }
    return 0;
}

# Byte-wise lexicographic order for two `Str`s: <0, 0 or >0.
#
# Rust's `String: Ord` is a byte-wise compare of the UTF-8 encoding, so a
# shorter string sorts first only when it is a **prefix** of the longer one.
# `"Z" < "a"` and `"ab" < "b"`; case is not folded. Every oracle `Vec<String>`
# sort in the port means exactly this.
#
# The bytes must compare **unsigned**, or everything above 0x7F would sort
# before every ASCII byte and non-ASCII ids would order differently from Rust.
# They already do: `load8` is zero-extending by definition of the language —
# `movzx rax, byte [rcx]` on x86-64 (`backend/x86/emit.cyr:467`) and `ldrb w0`
# on aarch64 (`backend/aarch64/emit.cyr:365`), which zeroes the upper half.
# The two copies this was extracted from each carried an `& 255` that masked
# nothing; dropping it leaves all 64 assertions in `tests/order.tcyr` green,
# including the 0xFF one written specifically to catch a signed read.
#
# Lives here rather than in a caller because `orchestrator/scheduler`,
# `orchestrator/plan_cache` and `fleet/federation` all need it — the third
# instance, which is when CLAUDE.md says to extract. `src/order.cyr` already
# precedes every one of them in `src/main.cyr`'s single-pass include order.
fn agnosai_order_str_cmp(a: Str, b: Str): i64 {
    var la = str_len(a);
    var lb = str_len(b);
    var n = la;
    if (lb < n) { n = lb; }
    var da = str_data(a);
    var db = str_data(b);
    for (var i = 0; i < n; i = i + 1) {
        var ca = load8(da + i);
        var cb = load8(db + i);
        if (ca != cb) { return ca - cb; }
    }
    return la - lb;
}

# Sort a vec in place with `cmp`.
#
# Delegates to the stdlib `vec_sort_by` (cyrius 6.5.4+): introsort with a
# pre-sorted fast path. Not stable — no call site needs stability.
fn agnosai_sort(v, cmp): i64 {
    return vec_sort_by(v, cmp);
}
# Sort a vec of plain i64 ascending.
fn agnosai_sort_i64(v): i64 {
    return agnosai_sort(v, &agnosai_cmp_i64_asc);
}

# The k-th smallest element (0-based) under `cmp`, partially reordering the vec.
#
# Delegates to the stdlib `vec_select_nth` **behind this module's bounds
# contract**: 0 for an empty vec or an out-of-range k, where the stdlib aborts.
# Average O(n) — the reason percentiles do not need a full sort.
fn agnosai_select_nth(v, k, cmp): i64 {
    var n = vec_len(v);
    if (n == 0) { return 0; }
    if (k < 0) { return 0; }
    if (k >= n) { return 0; }
    return vec_select_nth(v, k, cmp);
}
# The k-th smallest plain i64 (0-based).
fn agnosai_select_nth_i64(v, k): i64 {
    return agnosai_select_nth(v, k, &agnosai_cmp_i64_asc);
}

# The `p_milli`-th percentile of a vec of plain i64, where `p_milli` is
# thousandths of a percent-point — 95000 is p95, 99900 is p99.9.
#
# Integer milli-percent for the same reason money is micro-USD: p99.9 is a real
# SLO target and a float percentile argument would make the index computation
# depend on rounding. The index is `floor(p * (n - 1) / 100000)`, the standard
# nearest-rank-on-a-0-based-vector convention.
#
# Uses selection, not a sort — the vec is left partially reordered, which is
# fine for a latency sample and is what makes this O(n) instead of O(n log n).
# Returns 0 for an empty vec.
fn agnosai_percentile_i64(v, p_milli): i64 {
    var n = vec_len(v);
    if (n == 0) { return 0; }
    if (n == 1) { return vec_get(v, 0); }

    var p = p_milli;
    if (p < 0) { p = 0; }
    if (p > 100000) { p = 100000; }

    var idx = (p * (n - 1)) / 100000;
    return agnosai_select_nth_i64(v, idx);
}

# --- id.cyr ---

# =========================================================================
# id — UUID v4 and v5.
#
# Origin: the `uuid` crate's `Uuid::new_v4` / `Uuid::new_v5`, as used by
# rust-old/src/core/{message,agent}.rs. RFC 4122 layout.
#
# Why this exists rather than a dependency: **mneme cannot be used.** It has no
# lib block, ships no `dist/` bundle, and is AGPL-3.0 against agnosai's
# GPL-3.0-only. The port plan's Phase 0 calls for reimplementing v4/v5 over the
# stdlib's `random_bytes` + `sha1` instead, which is what this is. No mneme text
# was copied.
#
# A UUID is a bare 16-byte heap buffer — there is no wrapper struct, so it
# passes to memcpy/memeq directly. Render with `agnosai_uuid_to_str`.
#
# v4 draws from `random_bytes`, which is kernel entropy (getrandom), NOT tyche.
# tyche is a statistical PRNG and would make ids predictable.
# =========================================================================

# A UUID is 16 bytes.
var AGNOSAI_UUID_BYTES = 16;

# A rendered UUID is 36 characters: 32 hex digits plus 4 hyphens.
var AGNOSAI_UUID_STR_LEN = 36;

# Apply the RFC 4122 version and variant bits in place: the high nibble of byte
# 6 becomes `version`, and the top two bits of byte 8 become 0b10.
fn _agnosai_uuid_stamp(u, version): i64 {
    store8(u + 6, (load8(u + 6) & 0x0F) | (version << 4));
    store8(u + 8, (load8(u + 8) & 0x3F) | 0x80);
    return 0;
}

# The lowercase hex digit for a nibble.
fn _agnosai_hex_digit(n): i64 {
    if (n < 10) { return 48 + n; }
    return 87 + n;
}

# Generate a random (version 4) UUID.
fn agnosai_uuid_v4(): i64 {
    var u = alloc(AGNOSAI_UUID_BYTES);
    random_bytes(u, AGNOSAI_UUID_BYTES);
    _agnosai_uuid_stamp(u, 4);
    return u;
}

# Generate a name-based (version 5, SHA-1) UUID: SHA-1 over the 16-byte
# namespace UUID followed by `name`, truncated to 16 bytes and stamped.
# Deterministic — the same namespace and name always yield the same UUID.
fn agnosai_uuid_v5(namespace, name: Str): i64 {
    var name_len = str_len(name);
    var buf = alloc(AGNOSAI_UUID_BYTES + name_len);
    memcpy(buf, namespace, AGNOSAI_UUID_BYTES);
    memcpy(buf + AGNOSAI_UUID_BYTES, str_data(name), name_len);

    var digest = alloc(20);
    sha1(buf, AGNOSAI_UUID_BYTES + name_len, digest);

    var u = alloc(AGNOSAI_UUID_BYTES);
    memcpy(u, digest, AGNOSAI_UUID_BYTES);
    _agnosai_uuid_stamp(u, 5);
    return u;
}

# The all-zero (nil) UUID.
fn agnosai_uuid_nil(): i64 {
    var u = alloc(AGNOSAI_UUID_BYTES);
    memset(u, 0, AGNOSAI_UUID_BYTES);
    return u;
}

# Whether two UUIDs hold the same 16 bytes.
fn agnosai_uuid_eq(a, b): i64 {
    return memeq(a, b, AGNOSAI_UUID_BYTES);
}

# The RFC 4122 version nibble — 4 for v4, 5 for v5, 0 for nil.
fn agnosai_uuid_version(u): i64 {
    return (load8(u + 6) >> 4) & 0x0F;
}

# Render a UUID in the canonical lowercase 8-4-4-4-12 hyphenated form.
fn agnosai_uuid_to_str(u): i64 {
    var out = alloc(AGNOSAI_UUID_STR_LEN + 1);
    var pos = 0;
    for (var i = 0; i < AGNOSAI_UUID_BYTES; i = i + 1) {
        if (i == 4) { store8(out + pos, 45); pos = pos + 1; }
        if (i == 6) { store8(out + pos, 45); pos = pos + 1; }
        if (i == 8) { store8(out + pos, 45); pos = pos + 1; }
        if (i == 10) { store8(out + pos, 45); pos = pos + 1; }
        var b = load8(u + i);
        store8(out + pos, _agnosai_hex_digit((b >> 4) & 0x0F));
        store8(out + pos + 1, _agnosai_hex_digit(b & 0x0F));
        pos = pos + 2;
    }
    store8(out + pos, 0);
    return str_new(out, AGNOSAI_UUID_STR_LEN);
}

# Walk a canonical hyphenated UUID string, writing the decoded bytes through
# `out` when it is non-zero and validating only when it is 0. Answers 1 for a
# well-formed input, 0 otherwise.
#
# One scan, two callers, so `agnosai_uuid_is_valid` cannot drift from what
# `agnosai_uuid_parse` accepts — which matters because the routes decide **404
# versus 422** on the validator and the oracle's `Path<Uuid>` extractor decided
# it on the parser.
#
# Four spellings are accepted, as the `uuid` crate's parser accepts them:
# hyphenated (36), simple — 32 hex digits with no hyphens —, braced
# `{hyphenated}` (38) and `urn:uuid:hyphenated` (45, prefix in either case).
fn _agnosai_uuid_scan(s: Str, out): i64 {
    var data = str_data(s);
    var len = str_len(s);
    var hy = 1;
    if (len == 38) {
        if (load8(data) != 123 || load8(data + 37) != 125) { return 0; }
        data = data + 1;
        len = AGNOSAI_UUID_STR_LEN;
    } elif (len == 45) {
        for (var k = 0; k < 9; k = k + 1) {
            var pc = load8(data + k) & 255;
            if (pc >= 65 && pc <= 90) { pc = pc + 32; }
            if (pc != load8("urn:uuid:" + k)) { return 0; }
        }
        data = data + 9;
        len = AGNOSAI_UUID_STR_LEN;
    } elif (len == 32) {
        hy = 0;
    }
    if (hy == 1 && len != AGNOSAI_UUID_STR_LEN) { return 0; }
    var pos = 0;
    for (var i = 0; i < AGNOSAI_UUID_BYTES; i = i + 1) {
        if (hy == 1 && (i == 4 || i == 6 || i == 8 || i == 10)) {
            if (load8(data + pos) != 45) { return 0; }
            pos = pos + 1;
        }
        # **Inlined rather than two calls to `_agnosai_hex_value`.** This runs
        # 32 times per validation, and at 36 bytes the call/return overhead was
        # most of the cost — 219 ns to scan 36 bytes, ~6 ns/byte. Still one
        # decoder: `_agnosai_hex_value` had no other caller, so there is no
        # second implementation to drift from.
        var hc = load8(data + pos) & 255;
        var hi = 0 - 1;
        if (hc >= 48 && hc <= 57) { hi = hc - 48; }
        elif (hc >= 97 && hc <= 102) { hi = hc - 87; }
        elif (hc >= 65 && hc <= 70) { hi = hc - 55; }
        if (hi < 0) { return 0; }

        var lc = load8(data + pos + 1) & 255;
        var lo = 0 - 1;
        if (lc >= 48 && lc <= 57) { lo = lc - 48; }
        elif (lc >= 97 && lc <= 102) { lo = lc - 87; }
        elif (lc >= 65 && lc <= 70) { lo = lc - 55; }
        if (lo < 0) { return 0; }
        if (out != 0) { store8(out + i, (hi << 4) | lo); }
        pos = pos + 2;
    }
    return 1;
}

# Whether `s` is a canonical hyphenated UUID. **Allocates nothing.**
#
# Every caller of `agnosai_uuid_parse` in `src/` was throwing the parsed buffer
# away — all five were `if (agnosai_uuid_parse(x) == 0)`, a validity test — so a
# request carrying an id paid 16 bytes of garbage on the no-free global bump,
# on the 404 arm as much as the 200 one. This is that test without the buffer.
fn agnosai_uuid_is_valid(s: Str): i64 {
    return _agnosai_uuid_scan(s, 0);
}

# Parse a canonical hyphenated UUID string. Returns the 16-byte UUID, or 0 when
# the input is not 36 characters of the expected shape.
#
# **Decodes into a stack buffer and allocates only on success**, which is a fix
# rather than a tidy-up: the previous shape allocated first and returned 0 from
# inside the loop, leaking the buffer on every rejection.
# `agnosai_uuid_canonical` is called from the `*_from_json` deserialisers and
# from `routes/sse.cyr`, so those rejections are attacker-controlled and
# unauthenticated — a body full of malformed ids leaked 16 bytes each with
# nothing to reclaim them.
#
# **The obvious spelling — validate with one scan, then decode with a second —
# was measured and rejected at 258 → 472 ns (+83%).** `agnosai_uuid_canonical`
# runs on every id in a deserialised crew, so that is not free. One scan into
# `tmp` plus a 16-byte `memcpy` keeps the leak fixed and the cost flat.
fn agnosai_uuid_parse(s: Str): i64 {
    # **16, not `AGNOSAI_UUID_BYTES`** — an array size must be a compile-time
    # literal or an enum constant, and that name is a `var`. `tests/id.tcyr`
    # asserts the two agree so the duplication cannot drift silently.
    var tmp[16];
    if (_agnosai_uuid_scan(s, &tmp) == 0) { return 0; }
    var u = alloc(AGNOSAI_UUID_BYTES);
    memcpy(u, &tmp, AGNOSAI_UUID_BYTES);
    return u;
}

# A fresh v4 identifier in canonical string form.
#
# This is what every `*_id` field in the port stores. See the note on
# `agnosai_uuid_canonical` for why ids are strings rather than the 16-byte
# buffers `agnosai_uuid_v4` returns.
fn agnosai_uuid_v4_str(): i64 {
    return agnosai_uuid_to_str(agnosai_uuid_v4());
}

# Validate and canonicalise a UUID string, or 0 when it is not a UUID.
#
# **Identifiers are stored as canonical strings, not as raw 16-byte buffers.**
# The buffer form is the natural one — it is what `uuid::Uuid` is in the oracle,
# it is half the size, and `agnosai_uuid_eq` is a 16-byte memcmp. It was also a
# standing trap: Cyrius has no types to stop a buffer reaching `str_eq` or a
# `map_new_str` key, where its first eight bytes are read as a string length.
# That is not a compile error and not a clean crash — it is a segfault three
# call layers away, and it cost a real debugging session in `orch_scheduler`.
#
# Storing the canonical string removes the trap rather than documenting it: ids
# compare with `str_eq`, key a `map_new_str` directly, and serialise without a
# conversion. The wire form is unchanged, because that was already the canonical
# string. The byte-level verbs remain for callers who genuinely want bytes.
#
# Parsing and re-rendering also normalises case, which matches the oracle: the
# `uuid` crate parses hex of either case into bytes and its Display always emits
# lowercase.
# The lookup key for a UUID arriving off the wire — validated AND case-folded.
#
# ⚠ **`agnosai_uuid_is_valid` is not enough at a route boundary, and using it
# alone was a silent 404.** The oracle's `Path<Uuid>` extractor parses the
# segment into a `Uuid` and looks the entity up **by value**, and the uuid crate
# accepts hex in either case — so `GET /api/v1/crews/6BA7B810-…` finds the crew.
# The port validated (which also accepts uppercase, `id.cyr:127,134`) and then
# used the RAW segment as a `map_get` key. Ids are minted lowercase by
# `agnosai_uuid_v4_str`, so an uppercase id passed validation and then missed:
# 404 for a crew that exists, and on `submit_approval` a 200 carrying
# `delivered: false` on a human-in-the-loop gate.
#
# Returns 0 when `s` is not a UUID at all, which callers map to 422.
#
# **Allocates nothing on the common path.** A key that is already canonical
# lowercase — every id this server mints — is returned as-is; only a request
# that actually used uppercase pays for a copy, through `a`.
fn _agnosai_uuid_key_a(a, s: Str): i64 {
    if (agnosai_uuid_is_valid(s) == 0) { return 0; }
    var d = str_data(s);
    var n = str_len(s);
    # A simple, braced or URN spelling is re-rendered hyphenated, since that is
    # the form every map is keyed by. Rare, so it takes the plain allocator.
    if (n != AGNOSAI_UUID_STR_LEN) {
        var tmp[16];
        _agnosai_uuid_scan(s, &tmp);
        return agnosai_uuid_to_str(&tmp);
    }
    var upper = 0;
    for (var i = 0; i < n; i = i + 1) {
        var c = load8(d + i) & 255;
        if (c >= 65 && c <= 70) { upper = 1; }
    }
    if (upper == 0) { return s; }

    var out = alloc_via(a, n);
    if (out == 0) { return 0; }
    for (var j = 0; j < n; j = j + 1) {
        var b = load8(d + j) & 255;
        if (b >= 65 && b <= 70) { b = b + 32; }
        store8(out + j, b);
    }
    return str_new_a(a, out, n);
}

# Global-allocator form of `_agnosai_uuid_key_a`.
fn _agnosai_uuid_key(s: Str): i64 {
    return _agnosai_uuid_key_a(default_alloc(), s);
}

# The canonical lowercase spelling of `s`, or 0 when it is not a UUID.
#
# Parses and re-emits, so any accepted spelling normalises. Callers keying a map
# off a wire UUID want `_agnosai_uuid_key_a`, which avoids the copy when the
# input is already canonical.
fn agnosai_uuid_canonical(s: Str): i64 {
    var u = agnosai_uuid_parse(s);
    if (u == 0) { return 0; }
    return agnosai_uuid_to_str(u);
}

# --- strcase.cyr ---

# =========================================================================
# strcase — ASCII case-insensitive string search and comparison.
#
# No oracle module. Rust gets these from `str::to_lowercase()` and
# `eq_ignore_ascii_case`; the stdlib has `str_contains` and `str_eq` but nothing
# case-folding (`lib/str.cyr` and `lib/string.cyr` both checked), so every
# consumer grew its own.
#
# Extracted at the third instance, which is when CLAUDE.md says to:
# `server/prompt_guard` had the Str/Str contains, `fleet/cost_planning` the
# cstring-needle variant, and `definitions/assembler` would have been the third.
# `telemetry/mod` carries a fourth shape (`data`/`len` against a literal) that
# stays where it is — it compares a raw byte range, not a `Str`.
#
# ## Nothing here allocates
#
# That is the point, and it is why `str_lower_cstr` is not the answer: it
# allocates per call, and every caller here is inside a per-candidate loop —
# cost_planning scans model names per candidate, prompt_guard scans a prompt
# against 31 patterns. Folding in place copies nothing.
#
# ## ASCII only, deliberately
#
# The fold is `A-Z` → `a-z` and nothing else. Rust's `to_lowercase()` is full
# Unicode, so a non-ASCII pattern behaves differently — but every caller here
# matches against ASCII literals (tool names, model families, injection
# patterns), and a Unicode fold would need a case-mapping table for no reachable
# gain. Stated rather than implied.
# =========================================================================

# Fold one byte from ASCII upper case to lower case, leaving everything else.
#
# The `& 255` is redundant — `load8` zero-extends (see `agnosai_order_str_cmp`'s
# note) — so callers pass an already-unsigned byte.
fn _agnosai_fold_ascii(b): i64 {
    if (b >= 65) { if (b <= 90) { return b + 32; } }
    return b;
}

# Whether `a` and `b` are equal ignoring ASCII case.
fn agnosai_str_eq_ci(a: Str, b: Str): i64 {
    var n = str_len(a);
    if (n != str_len(b)) { return 0; }
    var ad = str_data(a);
    var bd = str_data(b);
    for (var i = 0; i < n; i = i + 1) {
        if (_agnosai_fold_ascii(load8(ad + i)) != _agnosai_fold_ascii(load8(bd + i))) {
            return 0;
        }
    }
    return 1;
}

# Whether `haystack` contains `needle`, ignoring ASCII case.
#
# ⚠ An EMPTY needle is contained in anything, matching Rust's
# `"abc".contains("")`. Several callers rely on it: a `TeamMember` with no role
# would otherwise match nothing rather than everything.
#
# The needle's folded first byte is hoisted out of the loop — the guard tests it
# at every offset and only walks the rest on a hit. Carried over from
# `prompt_guard`, where it is the difference between one comparison per byte and
# `nlen` of them.
fn agnosai_str_contains_ci(haystack: Str, needle: Str): i64 {
    var nlen = str_len(needle);
    if (nlen == 0) { return 1; }
    var hlen = str_len(haystack);
    if (nlen > hlen) { return 0; }

    var hd = str_data(haystack);
    var nd = str_data(needle);
    var last = hlen - nlen;
    var n0 = _agnosai_fold_ascii(load8(nd));

    for (var i = 0; i <= last; i = i + 1) {
        if (_agnosai_fold_ascii(load8(hd + i)) == n0) {
            var matched = 1;
            for (var j = 1; j < nlen; j = j + 1) {
                if (_agnosai_fold_ascii(load8(hd + i + j))
                  != _agnosai_fold_ascii(load8(nd + j))) {
                    matched = 0;
                    break;
                }
            }
            if (matched == 1) { return 1; }
        }
    }
    return 0;
}

# The same against a NUL-terminated literal needle.
#
# ⚠ Separate rather than `agnosai_str_contains_ci(hay, str_from(needle))`,
# because `str_from` allocates a 16-byte header and every caller is inside a
# per-candidate loop. `fleet/cost_planning`'s comment says exactly this.
fn agnosai_str_contains_ci_cstr(haystack: Str, needle_cstr): i64 {
    var nlen = strlen(needle_cstr);
    if (nlen == 0) { return 1; }
    var hlen = str_len(haystack);
    if (nlen > hlen) { return 0; }

    var hd = str_data(haystack);
    var last = hlen - nlen;
    var n0 = _agnosai_fold_ascii(load8(needle_cstr));

    for (var i = 0; i <= last; i = i + 1) {
        if (_agnosai_fold_ascii(load8(hd + i)) == n0) {
            var matched = 1;
            for (var j = 1; j < nlen; j = j + 1) {
                if (_agnosai_fold_ascii(load8(hd + i + j))
                  != _agnosai_fold_ascii(load8(needle_cstr + j))) {
                    matched = 0;
                    break;
                }
            }
            if (matched == 1) { return 1; }
        }
    }
    return 0;
}

# --- arena_pool.cyr ---

# =========================================================================
# arena_pool — a bounded pool of reusable arenas.
#
# **Port-local. No oracle counterpart**, and there cannot be one: Rust frees on
# drop, so `rust-old/` never needed to think about arena ownership at all. Lives
# at `src/` root per CLAUDE.md's rule for modules that do not mirror `rust-old/`.
#
# ## The defect this exists to close
#
# Five sites created a FRESH arena per operation and never got the memory back:
#
#   src/tools/agnos.cyr                5 MiB, per outbound HTTP request
#   src/tools/remote_registry.cyr     12 MiB, per remote package fetch
#   src/tools/builtin/security_audit  2.5 MiB, per audit
#   src/tools/builtin/load_testing     1 MiB + persistent, PER USER
#   src/server/serve.cyr              64 KiB, per a2a callback
#
# `arena_allocator(n)` is `alloc(56)` + `alloc(n + 16)` (`lib/alloc.cyr:745,370`)
# plus `allocator_new`'s `alloc(40)` — all on the **global bump, which has no
# free**. `reset_via` dispatches to `arena_reset` (`lib/alloc.cyr:493`), which
# only rewinds `base`/`ptr`/`end`; the chunk is never returned and the next call
# builds a new one. Measured: **2,621,552 bytes** charged per
# `arena_allocator(2.5 MiB) + reset_via`, every iteration.
#
# The cost is virtual address space — chunks are anonymous overcommitted mmaps
# and only touched pages count against RSS (`lib/alloc.cyr:150`) — but it grows
# monotonically for process lifetime, and VMAs are a finite resource.
#
# ## Why a pool, and not the three obvious alternatives
#
# An escape analysis over all five sites (2026-08-12) found that **nothing
# escapes any of them** — every site already deep-copies before its `reset_via`.
# So the defect is ownership and reuse, not lifetime, and the fixes that address
# lifetime do not apply:
#
# * **A thread-local arena is unavailable.** `thread_local_get` faults on the
#   main thread, and `thread_local_init` on a worker orphans the block
#   `thread_create` installed — taking sandhi's request-arena slot with it.
#   Measured; recorded at `src/orchestrator/audit.cyr:386`.
# * **sandhi's per-request arena is the wrong tool**, though it is reachable on a
#   pool worker. It is 64 KiB with `ARENA_FULL_SPILL`, and sandhi allocates its
#   receive buffer eagerly at the FULL `max_response_bytes` cap before a byte
#   arrives (`lib/sandhi.cyr:4644`). Every spilled byte is a permanent global-bump
#   `alloc`, so pointing agnos at it converts 5 MiB of untouched VA into ~4 MiB of
#   RSS-charged permanent bump **per call** — strictly worse. It is also reset by
#   sandhi between requests, which would rewind a caller's live state at the
#   sites that reset mid-operation (`security_audit` does so three times).
# * **A process-wide arena under one mutex** would serialize outbound HTTP across
#   all pool workers — a worse defect than the leak.
#
# ## The design
#
# A `chan_new(slots)` channel prefilled with `slots` growable arenas. Acquire is
# `chan_try_recv`; release is `reset_via` then `chan_try_send`. The channel is
# already mutex-guarded (`lib/thread.cyr:694,617`), so the pool adds no
# synchronisation of its own — one uncontended futex mutex per operation, against
# the millisecond-scale HTTP exchange it wraps.
#
# ⚠ **Acquire NEVER blocks.** `chan_recv` blocks and there is no `mutex_trylock`,
# so a blocking acquire would turn pool pressure into a hung request on a sandhi
# worker — and `load_testing` holds TWO arenas per worker, which is a textbook
# two-resource deadlock. An empty pool mints a fallback arena instead: slower and
# unpooled, but never stuck.
#
# ⚠ **No "is this one mine" marker, deliberately.** Release just tries to send;
# a full channel means the arena is surplus and is dropped. Pooled and fallback
# arenas are interchangeable — both are growable arenas over the same initial
# size — so which one ends up parked is irrelevant, and the channel's capacity is
# what bounds the pool. This is why the pool needs no ownership bookkeeping.
#
# ⚠ **Arenas are GROWABLE, not fixed.** `arena_allocator_growable` chains a new
# chunk instead of failing, and `arena_reset` retains the chain — so a slot
# converges on its site's true high-water mark and then allocates nothing at all.
# A fixed arena would have to choose between wasting its ceiling and returning 0
# on an oversized request; the sites that took the latter are exactly where the
# null-body class of defect came from.
#
# ⚠ **Build the pool EAGERLY on the main thread.** A lazy `if (pool == 0)` double
# constructs when two spawned threads race it, and the loser's arenas leak — the
# very thing this module exists to stop.
# =========================================================================

# Pool layout — 32 bytes.
enum AgnosaiArenaPoolOff {
    AGN_AP_CHAN = 0;
    AGN_AP_INITIAL = 8;
    # Arenas ever minted, pooled and fallback together.
    AGN_AP_MINTED = 16;
    # Acquisitions that found the pool empty and had to mint. A steady rise here
    # means `slots` is below the real concurrency and the pool is not doing its
    # job — it is the number to watch, not `minted`.
    AGN_AP_FALLBACKS = 24;
    AGN_AP_SIZE = 32;
}

# A pool of `slots` reusable arenas, each starting at `initial_bytes` and growing
# to its own high-water mark. Returns 0 if the channel or any arena cannot be
# built.
#
# `slots` bounds memory at roughly `slots x high_water`, replacing an unbounded
# per-operation cost. Pick it from the real concurrency at the call site, not
# from the worker count: an operation holds its arena only for its own duration.
fn agnosai_arena_pool_new(slots, initial_bytes): i64 {
    if (slots <= 0) { return 0; }
    var ch = chan_new(slots);
    if (ch == 0) { return 0; }

    var p = alloc(AGN_AP_SIZE);
    if (p == 0) { return 0; }
    store64(p + AGN_AP_CHAN, ch);
    store64(p + AGN_AP_INITIAL, initial_bytes);
    store64(p + AGN_AP_MINTED, 0);
    store64(p + AGN_AP_FALLBACKS, 0);

    for (var i = 0; i < slots; i = i + 1) {
        var a = arena_allocator_growable(initial_bytes);
        if (a == 0) { return 0; }
        atomic_fetch_add(p + AGN_AP_MINTED, 1);
        # Cannot be full — the channel was sized for exactly `slots`.
        chan_try_send(ch, a);
    }
    return p;
}

# Take an arena from the pool, or mint one when it is empty. Never blocks, never
# returns 0 unless the process is out of memory entirely.
#
# ⚠ The returned arena is **already reset** — release does that, so the hot path
# does not pay for it and a caller cannot forget. A freshly minted one is empty
# by construction.
fn agnosai_arena_pool_acquire(p): i64 {
    if (p == 0) { return 0; }
    var a = chan_try_recv(load64(p + AGN_AP_CHAN));
    if (a != 0) { return a; }

    # Empty. Mint rather than block — see the header on why blocking here
    # deadlocks `load_testing` and hangs a sandhi worker.
    atomic_fetch_add(p + AGN_AP_FALLBACKS, 1);
    atomic_fetch_add(p + AGN_AP_MINTED, 1);
    return arena_allocator_growable(load64(p + AGN_AP_INITIAL));
}

# Give an arena back, resetting it first. Safe to call with 0.
#
# ⚠ **Reset happens HERE, not on acquire**, so an arena parked in the pool holds
# no live bytes — its chunks stay mapped and reusable, which is the whole point,
# but nothing in them is retained. A caller that hands back an arena whose
# contents are still referenced has a use-after-reset, exactly as with a bare
# `reset_via`; the escape analysis in the header is what establishes that none of
# the five sites does.
fn agnosai_arena_pool_release(p, a): i64 {
    if (p == 0 || a == 0) { return 0; }
    reset_via(a);
    # A full channel means this one is surplus — drop it. See the header: pooled
    # and fallback arenas are interchangeable, so no marker is needed.
    chan_try_send(load64(p + AGN_AP_CHAN), a);
    return 0;
}

# ⚠ There is deliberately **no `available()`**. `lib/thread.cyr` exposes no
# `chan_len`, and the count lives at a bare `ch + 32` that only the channel's own
# functions should know about — reaching in would couple this module to another's
# layout for a diagnostic. `minted` and `fallbacks` below are this module's own
# and are exact; they also express the property that actually matters, which is
# whether acquires are being SERVED rather than how many are parked at an instant.

# Total arenas ever minted, pooled and fallback together.
fn agnosai_arena_pool_minted(p): i64 {
    if (p == 0) { return 0; }
    return atomic_load(p + AGN_AP_MINTED);
}

# Acquisitions that found the pool empty. A steady rise means `slots` is too low.
fn agnosai_arena_pool_fallbacks(p): i64 {
    if (p == 0) { return 0; }
    return atomic_load(p + AGN_AP_FALLBACKS);
}

# --- genai.cyr ---

# =========================================================================
# telemetry/genai — OpenTelemetry GenAI semantic-convention span helpers.
#
# Origin: rust-old/src/telemetry/genai.rs
#
# Standard attribute names per the OTel GenAI Semantic Conventions (v1.37+), so
# an OTLP backend (Datadog, Grafana, Arize) can categorise agent and inference
# operations rather than seeing opaque span names.
#
# ## `tracing::Span` becomes a held attribute record
#
# The oracle's helpers return a `tracing::Span` — a handle whose attributes the
# subscriber reads when the span closes, and which `record_usage` writes into
# later. sakshi's spans are a fixed-depth **stack of name + timing** with no
# attribute channel at all, so the two halves are split:
#
# * the **attributes** live in a heap record this module owns, which is what
#   the OTLP exporter will encode (roadmap M9's remaining half);
# * the **scope** is sakshi's stack, entered and exited explicitly.
#
# ## Creating a span does NOT enter it
#
# `tracing::info_span!` builds a span; entering is a separate `.entered()`. The
# oracle's doc comment says "the span will be active until dropped", but its own
# example is `let _span = inference_span(..)`, which never enters — so the
# comment is wrong about its own code. The port follows the **code**:
# `agnosai_genai_span_enter` / `_exit` are explicit, which also keeps sakshi's
# stack strictly LIFO (it is 16 deep and pops blindly).
#
# ## Attributes are read by key, not by field
#
# Cyrius has no field access, so rather than a dozen accessors this exposes
# `agnosai_genai_span_attr_str` / `_attr_int` keyed by the very constants above.
# That makes the constants load-bearing — the oracle's tests only ever check
# their *shape* — and it is the shape an OTLP attribute encoder wants anyway.
# =========================================================================

# --- attribute keys (the oracle's `pub mod attrs`) -----------------------

# The name of the GenAI operation (e.g. "invoke_agent", "execute_tool").
var AGNOSAI_GENAI_OPERATION_NAME = "gen_ai.operation.name";
# The GenAI system/provider (e.g. "openai", "anthropic", "ollama").
var AGNOSAI_GENAI_SYSTEM = "gen_ai.system";
# The model requested for inference.
var AGNOSAI_GENAI_REQUEST_MODEL = "gen_ai.request.model";
# The model that actually responded (may differ from requested).
var AGNOSAI_GENAI_RESPONSE_MODEL = "gen_ai.response.model";
# Number of input/prompt tokens.
var AGNOSAI_GENAI_USAGE_INPUT_TOKENS = "gen_ai.usage.input_tokens";
# Number of output/completion tokens.
var AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS = "gen_ai.usage.output_tokens";
# The reason the model stopped generating (e.g. "stop", "length").
var AGNOSAI_GENAI_RESPONSE_FINISH_REASON = "gen_ai.response.finish_reason";
# Agent name.
var AGNOSAI_GENAI_AGENT_NAME = "gen_ai.agent.name";
# Agent identifier.
var AGNOSAI_GENAI_AGENT_ID = "gen_ai.agent.id";
# Tool name. ⚠ AgnosAI-specific — deliberately NOT in the OTel GenAI spec, so
# it carries the `agnosai.` prefix rather than `gen_ai.`.
var AGNOSAI_GENAI_TOOL_NAME = "agnosai.tool.name";
# Crew identifier. AgnosAI-specific.
var AGNOSAI_GENAI_CREW_ID = "agnosai.crew.id";
# Crew name. AgnosAI-specific.
var AGNOSAI_GENAI_CREW_NAME = "agnosai.crew.name";
# Task identifier. AgnosAI-specific.
var AGNOSAI_GENAI_TASK_ID = "agnosai.task.id";
# Inference temperature.
var AGNOSAI_GENAI_REQUEST_TEMPERATURE = "gen_ai.request.temperature";
# Maximum tokens requested.
var AGNOSAI_GENAI_REQUEST_MAX_TOKENS = "gen_ai.request.max_tokens";
# Task count on a crew span. ⚠ The oracle spells this one inline rather than in
# `attrs`, which is why it has no `attrs::` counterpart to mirror.
var AGNOSAI_GENAI_CREW_TASK_COUNT = "agnosai.crew.task_count";

# --- span names ----------------------------------------------------------

# The oracle's `info_span!("gen_ai.invoke_agent", ..)`.
var AGNOSAI_GENAI_SPAN_INVOKE_AGENT = "gen_ai.invoke_agent";
# The oracle's `info_span!("gen_ai.execute_tool", ..)`.
var AGNOSAI_GENAI_SPAN_EXECUTE_TOOL = "gen_ai.execute_tool";
# The oracle's `info_span!("agnosai.crew.run", ..)`.
var AGNOSAI_GENAI_SPAN_CREW_RUN = "agnosai.crew.run";

# GenAiSpan heap layout — 104 bytes (13 slots x 8). Str fields are 0 when the
# span does not carry that attribute; integer fields are -1.
#
# ⚠ Said "112 bytes" until 2026-08-11 while `AGN_GAS_SIZE` was 104 — a field was
# removed and the prose was not. `alloc(AGN_GAS_SIZE)` always used the enum, so
# nothing was over- or under-allocated; the comment was simply wrong. Read the
# enum, not this line.
enum AgnosaiGenAiSpanOff {
    # The span name, a cstring from the three constants above.
    AGN_GAS_NAME = 0;
    AGN_GAS_OPERATION = 8;
    AGN_GAS_SYSTEM = 16;
    AGN_GAS_REQUEST_MODEL = 24;
    # 0 until `record_usage` — the oracle's `tracing::field::Empty`.
    AGN_GAS_RESPONSE_MODEL = 32;
    AGN_GAS_AGENT_NAME = 40;
    AGN_GAS_TASK_ID = 48;
    AGN_GAS_TOOL_NAME = 56;
    AGN_GAS_CREW_ID = 64;
    AGN_GAS_CREW_NAME = 72;
    AGN_GAS_CREW_TASK_COUNT = 80;
    # -1 until `record_usage` — also `Empty`.
    AGN_GAS_INPUT_TOKENS = 88;
    AGN_GAS_OUTPUT_TOKENS = 96;
    AGN_GAS_SIZE = 104;
}

# An empty span record with `name`. Every attribute starts unset.
fn _agnosai_genai_span_new(name): i64 {
    var s = alloc(AGN_GAS_SIZE);
    store64(s + AGN_GAS_NAME, name);
    store64(s + AGN_GAS_OPERATION, 0);
    store64(s + AGN_GAS_SYSTEM, 0);
    store64(s + AGN_GAS_REQUEST_MODEL, 0);
    store64(s + AGN_GAS_RESPONSE_MODEL, 0);
    store64(s + AGN_GAS_AGENT_NAME, 0);
    store64(s + AGN_GAS_TASK_ID, 0);
    store64(s + AGN_GAS_TOOL_NAME, 0);
    store64(s + AGN_GAS_CREW_ID, 0);
    store64(s + AGN_GAS_CREW_NAME, 0);
    store64(s + AGN_GAS_CREW_TASK_COUNT, 0 - 1);
    store64(s + AGN_GAS_INPUT_TOKENS, 0 - 1);
    store64(s + AGN_GAS_OUTPUT_TOKENS, 0 - 1);
    return s;
}

# --- the three span constructors -----------------------------------------

# A span for an agent inference call.
#
# ⚠ `response_model`, `input_tokens` and `output_tokens` are declared but unset,
# matching the oracle's three `tracing::field::Empty` fields — `record_usage`
# fills them. An unrecorded span is therefore distinguishable from one recorded
# with zero tokens, which a 0 default would have collapsed.
fn agnosai_genai_inference_span(model: Str, system: Str, agent_name: Str, task_id: Str): i64 {
    var s = _agnosai_genai_span_new(AGNOSAI_GENAI_SPAN_INVOKE_AGENT);
    store64(s + AGN_GAS_OPERATION, str_from("invoke_agent"));
    store64(s + AGN_GAS_SYSTEM, system);
    store64(s + AGN_GAS_REQUEST_MODEL, model);
    store64(s + AGN_GAS_AGENT_NAME, agent_name);
    store64(s + AGN_GAS_TASK_ID, task_id);
    return s;
}

# A span for a tool execution.
#
# ⚠ Carries no token or model fields at all — not even empty ones. In the
# oracle a declared-but-`Empty` field and an undeclared one are both absent from
# the emitted span, so the two collapse here and both read back unset.
fn agnosai_genai_tool_span(tool_name: Str, agent_name: Str, task_id: Str): i64 {
    var s = _agnosai_genai_span_new(AGNOSAI_GENAI_SPAN_EXECUTE_TOOL);
    store64(s + AGN_GAS_OPERATION, str_from("execute_tool"));
    store64(s + AGN_GAS_TOOL_NAME, tool_name);
    store64(s + AGN_GAS_AGENT_NAME, agent_name);
    store64(s + AGN_GAS_TASK_ID, task_id);
    return s;
}

# A span for a crew execution.
#
# ⚠ Sets **no** `gen_ai.operation.name`. The oracle's `crew_span!` omits it
# while the other two set it, so a backend grouping by operation sees crew runs
# as unclassified. Reproduced rather than filled in.
fn agnosai_genai_crew_span(crew_id: Str, crew_name: Str, task_count): i64 {
    var s = _agnosai_genai_span_new(AGNOSAI_GENAI_SPAN_CREW_RUN);
    store64(s + AGN_GAS_CREW_ID, crew_id);
    store64(s + AGN_GAS_CREW_NAME, crew_name);
    store64(s + AGN_GAS_CREW_TASK_COUNT, task_count);
    return s;
}

# Record token usage and the responding model on an existing span.
#
# The oracle's `record_usage`. Overwrites unconditionally, as `Span::record`
# does — calling it twice keeps the second set.
fn agnosai_genai_record_usage(span, input_tokens, output_tokens, model: Str): i64 {
    store64(span + AGN_GAS_INPUT_TOKENS, input_tokens);
    store64(span + AGN_GAS_OUTPUT_TOKENS, output_tokens);
    store64(span + AGN_GAS_RESPONSE_MODEL, model);
    return 0;
}

# --- scope ---------------------------------------------------------------

# Push the span's name onto sakshi's span stack.
#
# Separate from construction because `info_span!` builds without entering — see
# the module header. ⚠ sakshi's stack is 16 deep and `sakshi_span_exit` pops
# blindly, so enter/exit must be balanced and LIFO.
fn agnosai_genai_span_enter(span): i64 {
    var n = load64(span + AGN_GAS_NAME);
    sakshi_span_enter(n, strlen(n));
    return 0;
}

# Pop the innermost span. Pairs with `agnosai_genai_span_enter`.
fn agnosai_genai_span_exit(): i64 {
    sakshi_span_exit();
    return 0;
}

# --- attribute access ----------------------------------------------------

# The span's name.
fn agnosai_genai_span_name(span): i64 {
    return load64(span + AGN_GAS_NAME);
}

# The Str-valued attribute `key`, or 0 when this span does not carry it.
#
# Keyed by the `AGNOSAI_GENAI_*` constants rather than by field, because Cyrius
# has no field access and because an OTLP encoder wants key/value anyway.
# ⚠ An unknown key answers 0, the same as a known-but-unset one: "absent" is
# absent either way, which is exactly what the wire carries.
fn agnosai_genai_span_attr_str(span, key): i64 {
    if (streq(key, AGNOSAI_GENAI_OPERATION_NAME) == 1) {
        return load64(span + AGN_GAS_OPERATION);
    }
    if (streq(key, AGNOSAI_GENAI_SYSTEM) == 1) { return load64(span + AGN_GAS_SYSTEM); }
    if (streq(key, AGNOSAI_GENAI_REQUEST_MODEL) == 1) {
        return load64(span + AGN_GAS_REQUEST_MODEL);
    }
    if (streq(key, AGNOSAI_GENAI_RESPONSE_MODEL) == 1) {
        return load64(span + AGN_GAS_RESPONSE_MODEL);
    }
    if (streq(key, AGNOSAI_GENAI_AGENT_NAME) == 1) { return load64(span + AGN_GAS_AGENT_NAME); }
    if (streq(key, AGNOSAI_GENAI_TASK_ID) == 1) { return load64(span + AGN_GAS_TASK_ID); }
    if (streq(key, AGNOSAI_GENAI_TOOL_NAME) == 1) { return load64(span + AGN_GAS_TOOL_NAME); }
    if (streq(key, AGNOSAI_GENAI_CREW_ID) == 1) { return load64(span + AGN_GAS_CREW_ID); }
    if (streq(key, AGNOSAI_GENAI_CREW_NAME) == 1) { return load64(span + AGN_GAS_CREW_NAME); }
    return 0;
}

# The integer-valued attribute `key`, or -1 when unset or unknown.
fn agnosai_genai_span_attr_int(span, key): i64 {
    if (streq(key, AGNOSAI_GENAI_USAGE_INPUT_TOKENS) == 1) {
        return load64(span + AGN_GAS_INPUT_TOKENS);
    }
    if (streq(key, AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS) == 1) {
        return load64(span + AGN_GAS_OUTPUT_TOKENS);
    }
    if (streq(key, AGNOSAI_GENAI_CREW_TASK_COUNT) == 1) {
        return load64(span + AGN_GAS_CREW_TASK_COUNT);
    }
    return 0 - 1;
}

# --- otlp.cyr ---

# =========================================================================
# telemetry/otlp — OTLP/HTTP+JSON span encoding.
#
# No oracle module. `rust-old` gets OTLP from `hoosh::telemetry::init_otel`,
# which is an OpenTelemetry SDK behind a Rust crate; there is no Cyrius OTel
# SDK, so the encoding is written here. The shape follows hoosh's own
# `src/lib/otlp.cyr` (199 lines), which solved the same problem for the same
# collector — **this is the one place ADR 003's remote-HTTP seam does not
# apply**, because export is in-process and there is nothing to call hoosh
# *for*. Copying its proven encoder is not linking hoosh.
#
# ## Why JSON and not protobuf
#
# OTLP defines both. protobuf needs a wire-format library Cyrius does not have;
# OTLP/HTTP+JSON is a first-class transport that every collector accepts, and it
# is `str_builder` all the way down. hoosh made the same call for the same
# reason.
#
# ⚠ **This file is the SECOND hand-rolled OTLP subset in the ecosystem**, after
# hoosh's. If you are about to write a third, don't — read
# `docs/development/roadmap.md`'s note *"an OpenTelemetry library repo"* first.
# That library is a **sibling repo consumed through `[deps]`**, like sakshi or
# majra — not a cyrius stdlib module and not a language feature. It would own
# the protobuf codec, a general span model, W3C context propagation with a
# **thread-local** current-span (the one thing neither hand-roll solves), and a
# batching exporter. When it lands, this file collapses to a thin adapter, the
# way `fleet/relay` did onto majra.
#
# ## The JSON mapping is NOT "just JSON"
#
# Two rules bite, and both are silent failures rather than errors:
#
# * **64-bit integers are encoded as STRINGS.** `"intValue":"42"`, not `42`, and
#   likewise every `*TimeUnixNano`. The protobuf JSON mapping requires it
#   because IEEE-754 doubles cannot hold the full int64 range, and a collector
#   fed a bare number either rejects the batch or silently truncates past 2^53.
# * **Ids are lowercase hex of a FIXED width** — 32 for a trace id, 16 for a
#   span id, zero-padded. A short id is not "close enough": the collector parses
#   by length.
#
# ## This module encodes only
#
# The ring buffer, the batch thread and the POST are the next bite. Everything
# here is a pure function over a span record, which is what makes the wire
# format testable byte-for-byte without a collector.
# =========================================================================

# The default path when the endpoint carries none, per the OTLP/HTTP spec.
var AGNOSAI_OTLP_DEFAULT_PATH = "/v1/traces";

# OTel `SpanKind`. INTERNAL is 1 and CLIENT is 3 — the numbers are the wire
# values, not an ordering.
enum AgnosaiOtlpSpanKind {
    AGNOSAI_OTLP_KIND_UNSPECIFIED = 0;
    AGNOSAI_OTLP_KIND_INTERNAL = 1;
    AGNOSAI_OTLP_KIND_SERVER = 2;
    AGNOSAI_OTLP_KIND_CLIENT = 3;
    AGNOSAI_OTLP_KIND_PRODUCER = 4;
    AGNOSAI_OTLP_KIND_CONSUMER = 5;
}

# OTel `Status.code`. ⚠ UNSET is 0 and is NOT the same as OK — a collector
# treats UNSET as "no opinion" and OK as an explicit success assertion.
enum AgnosaiOtlpStatusCode {
    AGNOSAI_OTLP_STATUS_UNSET = 0;
    AGNOSAI_OTLP_STATUS_OK = 1;
    AGNOSAI_OTLP_STATUS_ERROR = 2;
}

# Export context heap layout — 48 bytes. The identity and timing a span record
# does not carry: the exporter supplies them at enqueue time.
enum AgnosaiOtlpCtxOff {
    AGN_OTC_TRACE_HI = 0;
    AGN_OTC_TRACE_LO = 8;
    AGN_OTC_SPAN_ID = 16;
    AGN_OTC_START_NS = 24;
    AGN_OTC_END_NS = 32;
    AGN_OTC_STATUS = 40;
    AGN_OTC_SIZE = 48;
}

# The identity and timing for one exported span.
#
# `trace_hi`/`trace_lo` are the two halves of the W3C 128-bit trace id, which is
# exactly what `sakshi_trace_id_hi` / `_lo` hold.
fn agnosai_otlp_ctx_new(trace_hi, trace_lo, span_id, start_ns, end_ns, status): i64 {
    var c = alloc(AGN_OTC_SIZE);
    store64(c + AGN_OTC_TRACE_HI, trace_hi);
    store64(c + AGN_OTC_TRACE_LO, trace_lo);
    store64(c + AGN_OTC_SPAN_ID, span_id);
    store64(c + AGN_OTC_START_NS, start_ns);
    store64(c + AGN_OTC_END_NS, end_ns);
    store64(c + AGN_OTC_STATUS, status);
    return c;
}

# The context's status code.
fn agnosai_otlp_ctx_status(c): i64 {
    return load64(c + AGN_OTC_STATUS);
}

# Whether a trace id is the all-zero id, which the W3C spec declares INVALID.
#
# Worth its own check because `sakshi_trace_id_hi`/`_lo` answer 0/0 when nothing
# ever called `sakshi_trace_set_128` — so an un-instrumented process would
# otherwise export a batch every collector drops, with no local symptom.
fn agnosai_otlp_trace_id_is_zero(hi, lo): i64 {
    if (hi != 0) { return 0; }
    if (lo != 0) { return 0; }
    return 1;
}

# --- arena-threaded builder primitives -------------------------------------
#
# ⚠ **A `str_builder` does NOT remember its allocator.** The header is 24 bytes
# — `{buf, len, cap}` (`lib/str.cyr:428`) — so `str_builder_new_a(arena)` charges
# the arena the 88-byte header and NOTHING else: every bare `str_builder_add*`
# grows through `_sb_grow` → `default_alloc()`, and bare `str_builder_build`
# builds there too. `lib/str.cyr:433` states the contract outright — *"Subsequent
# grows must use the `_a` add variants to keep the same allocator threaded
# through."*
#
# This module violated that from the start: it constructed with `_a` and then
# made 29 bare `add` calls and 4 bare `build` calls, so both 256 KiB ring arenas
# held only builder headers and every span fragment and batch document went to
# the no-free global bump — ~3.9 KB per exported span, on a 1000 ms loop, for
# process lifetime. Fixed 2026-08-12.
#
# `str_builder_putc` and `str_builder_add_json_str` have **no `_a` form**
# upstream, so the two below are port-local stand-ins. They are the only reason
# this section exists; delete them if `putc_a` / `add_json_str_a` ever land.

# One byte, through the threaded allocator. `str_builder_add_cstr_a` copies
# immediately, so the 2-byte NUL-terminated stack buffer is safe.
fn _agnosai_otlp_putc_a(a, sb, ch): i64 {
    var b[2];
    var p = &b;
    store8(p, ch & 0xFF);
    store8(p + 1, 0);
    return str_builder_add_cstr_a(a, sb, p);
}

# `str_builder_add_json_str` with the allocator threaded.
#
# ⚠ **Byte-for-byte identical to `lib/str.cyr:114` and must stay so** — the
# suites assert the encoded wire, so any divergence here is a wire change. Same
# escape set: `"`→`\"`, `\`→`\\`, the five named control escapes, `\u00XX` for
# the remaining controls, and everything >= 0x20 verbatim (RFC 8259 §8.1).
fn _agnosai_otlp_json_str_a(a, sb, s: Str): i64 {
    _agnosai_otlp_putc_a(a, sb, 34);
    var data = str_data(s);
    var slen = str_len(s);
    var ji = 0;
    while (ji < slen) {
        var bc = load8(data + ji);
        if (bc == 34) {
            _agnosai_otlp_putc_a(a, sb, 92);
            _agnosai_otlp_putc_a(a, sb, 34);
        } else { if (bc == 92) {
                _agnosai_otlp_putc_a(a, sb, 92);
                _agnosai_otlp_putc_a(a, sb, 92);
            } else { if (bc == 8) {
                    _agnosai_otlp_putc_a(a, sb, 92);
                    _agnosai_otlp_putc_a(a, sb, 98);
                } else { if (bc == 9) {
                        _agnosai_otlp_putc_a(a, sb, 92);
                        _agnosai_otlp_putc_a(a, sb, 116);
                    } else { if (bc == 10) {
                            _agnosai_otlp_putc_a(a, sb, 92);
                            _agnosai_otlp_putc_a(a, sb, 110);
                        } else { if (bc == 12) {
                                _agnosai_otlp_putc_a(a, sb, 92);
                                _agnosai_otlp_putc_a(a, sb, 102);
                            } else { if (bc == 13) {
                                    _agnosai_otlp_putc_a(a, sb, 92);
                                    _agnosai_otlp_putc_a(a, sb, 114);
                                } else { if (bc < 32) {
                                        _agnosai_otlp_putc_a(a, sb, 92);
                                        _agnosai_otlp_putc_a(a, sb, 117);
                                        _agnosai_otlp_putc_a(a, sb, 48);
                                        _agnosai_otlp_putc_a(a, sb, 48);
                                        var hi = (bc >> 4) & 0xF;
                                        var lo = bc & 0xF;
                                        if (hi < 10) { _agnosai_otlp_putc_a(a, sb, 48 + hi); }
                                        else { _agnosai_otlp_putc_a(a, sb, 87 + hi); }
                                        if (lo < 10) { _agnosai_otlp_putc_a(a, sb, 48 + lo); }
                                        else { _agnosai_otlp_putc_a(a, sb, 87 + lo); }
                                    } else {
                                        _agnosai_otlp_putc_a(a, sb, bc);
                                    } } } } } } } }
        ji = ji + 1;
    }
    _agnosai_otlp_putc_a(a, sb, 34);
    return 0;
}

# --- hex ------------------------------------------------------------------

# Append `n` as exactly `width` lowercase hex digits, most significant first.
#
# ⚠ Zero-padded and fixed-width: the collector parses ids by length, so a
# 15-digit span id is not a span id. `_agnosai_hex_digit` is `src/id.cyr`'s —
# `id` precedes `telemetry` in `src/main.cyr`, so this is a reuse, not a copy.
fn _agnosai_otlp_add_hex_a(a, sb, n, width): i64 {
    for (var i = width - 1; i >= 0; i = i - 1) {
        _agnosai_otlp_putc_a(a, sb, _agnosai_hex_digit((n >> (i * 4)) & 15));
    }
    return 0;
}

# Append a W3C trace id: 32 lowercase hex digits, high half first.
fn agnosai_otlp_add_trace_id_a(a, sb, hi, lo): i64 {
    _agnosai_otlp_add_hex_a(a, sb, hi, 16);
    _agnosai_otlp_add_hex_a(a, sb, lo, 16);
    return 0;
}

# Global-allocator form. Kept because the encoder tests build against a bare
# `str_builder_new()`, where threading would be a lie.
fn agnosai_otlp_add_trace_id(sb, hi, lo): i64 {
    return agnosai_otlp_add_trace_id_a(default_alloc(), sb, hi, lo);
}

# Append a span id: 16 lowercase hex digits.
fn agnosai_otlp_add_span_id_a(a, sb, id): i64 {
    _agnosai_otlp_add_hex_a(a, sb, id, 16);
    return 0;
}

# Global-allocator form of `agnosai_otlp_add_span_id_a`, for a builder that was
# constructed with a bare `str_builder_new()`.
fn agnosai_otlp_add_span_id(sb, id): i64 {
    return agnosai_otlp_add_span_id_a(default_alloc(), sb, id);
}

# --- attributes -----------------------------------------------------------

# One string attribute: `{"key":"k","value":{"stringValue":"v"}}`.
#
# The value goes through `str_builder_add_json_str` (`lib/str.cyr:114`), which
# emits its own quotes and escapes — a model name or tool name is caller data
# and can carry a quote or a control byte.
fn _agnosai_otlp_attr_str_a(a, sb, k, v: Str): i64 {
    str_builder_add_cstr_a(a, sb, "{\"key\":\"");
    str_builder_add_cstr_a(a, sb, k);
    str_builder_add_cstr_a(a, sb, "\",\"value\":{\"stringValue\":");
    _agnosai_otlp_json_str_a(a, sb, v);
    str_builder_add_cstr_a(a, sb, "}}");
    return 0;
}

fn _agnosai_otlp_attr_str(sb, k, v: Str): i64 {
    return _agnosai_otlp_attr_str_a(default_alloc(), sb, k, v);
}

# One integer attribute: `{"key":"k","value":{"intValue":"42"}}`.
#
# ⚠ The value is QUOTED. See the module header — a bare number is the silent
# failure the JSON mapping exists to prevent.
fn _agnosai_otlp_attr_int_a(a, sb, k, v): i64 {
    str_builder_add_cstr_a(a, sb, "{\"key\":\"");
    str_builder_add_cstr_a(a, sb, k);
    str_builder_add_cstr_a(a, sb, "\",\"value\":{\"intValue\":\"");
    str_builder_add_int_a(a, sb, v);
    str_builder_add_cstr_a(a, sb, "\"}}");
    return 0;
}

fn _agnosai_otlp_attr_int(sb, k, v): i64 {
    return _agnosai_otlp_attr_int_a(default_alloc(), sb, k, v);
}

# Append one string attribute from the span, with a leading comma when anything
# has already been written. Returns the updated "have written one" flag.
fn _agnosai_otlp_emit_str_a(a, sb, span, key, wrote): i64 {
    var v = agnosai_genai_span_attr_str(span, key);
    if (v == 0) { return wrote; }
    if (wrote == 1) { str_builder_add_cstr_a(a, sb, ","); }
    _agnosai_otlp_attr_str_a(a, sb, key, v);
    return 1;
}

# The same for an integer attribute. -1 means unset and emits nothing.
fn _agnosai_otlp_emit_int_a(a, sb, span, key, wrote): i64 {
    var v = agnosai_genai_span_attr_int(span, key);
    if (v < 0) { return wrote; }
    if (wrote == 1) { str_builder_add_cstr_a(a, sb, ","); }
    _agnosai_otlp_attr_int_a(a, sb, key, v);
    return 1;
}

# --- span kind ------------------------------------------------------------

# The OTel `SpanKind` for a genai span, from its name.
#
# An inference call leaves the process for a model provider, so it is CLIENT;
# a tool execution and a crew run are local work, so INTERNAL. ⚠ Getting this
# wrong is not cosmetic — a backend's service-dependency graph is built from
# CLIENT/SERVER pairs, so a mislabelled inference span drops the provider edge.
fn agnosai_otlp_span_kind(span): i64 {
    var n = agnosai_genai_span_name(span);
    if (streq(n, AGNOSAI_GENAI_SPAN_INVOKE_AGENT) == 1) { return AGNOSAI_OTLP_KIND_CLIENT; }
    return AGNOSAI_OTLP_KIND_INTERNAL;
}

# --- encoding -------------------------------------------------------------

# Encode one genai span as an OTLP/JSON `Span` object.
#
# Only attributes the span actually carries are emitted — an absent attribute is
# omitted rather than sent as null, because OTLP has no null attribute value and
# a collector reading one drops the whole span.
fn agnosai_otlp_span_json(span, ctx): i64 {
    var a = default_alloc();
    var sb = str_builder_new_a(a);
    _agnosai_otlp_span_json_into_a(a, sb, span, ctx);
    return str_builder_build_a(a, sb);
}

# The body of `agnosai_otlp_span_json`, writing into a caller-supplied builder.
#
# Split out so the ring can encode straight into its fragment arena — the
# convenience wrapper above allocates on the global, which is exactly what the
# ring exists to avoid.
fn _agnosai_otlp_span_json_into_a(a, sb, span, ctx): i64 {
    str_builder_add_cstr_a(a, sb, "{\"traceId\":\"");
    agnosai_otlp_add_trace_id_a(a, sb, load64(ctx + AGN_OTC_TRACE_HI),
      load64(ctx + AGN_OTC_TRACE_LO));
    str_builder_add_cstr_a(a, sb, "\",\"spanId\":\"");
    agnosai_otlp_add_span_id_a(a, sb, load64(ctx + AGN_OTC_SPAN_ID));
    str_builder_add_cstr_a(a, sb, "\",\"name\":");
    # ⚠ `str_from_a`, not `str_from`. A bare `str_from` here was the LAST
    # per-span allocation on the no-free global bump after the arena threading
    # landed — 16 bytes of Str header per span, measured, and the only thing
    # standing between a 1-span cycle and 0 global bytes.
    _agnosai_otlp_json_str_a(a, sb, str_from_a(a, agnosai_genai_span_name(span)));
    str_builder_add_cstr_a(a, sb, ",\"kind\":");
    str_builder_add_int_a(a, sb, agnosai_otlp_span_kind(span));
    str_builder_add_cstr_a(a, sb, ",\"startTimeUnixNano\":\"");
    str_builder_add_int_a(a, sb, load64(ctx + AGN_OTC_START_NS));
    str_builder_add_cstr_a(a, sb, "\",\"endTimeUnixNano\":\"");
    str_builder_add_int_a(a, sb, load64(ctx + AGN_OTC_END_NS));
    str_builder_add_cstr_a(a, sb, "\",\"attributes\":[");

    var wrote = 0;
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_OPERATION_NAME, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_SYSTEM, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_REQUEST_MODEL, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_RESPONSE_MODEL, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_AGENT_NAME, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_TASK_ID, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_TOOL_NAME, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_CREW_ID, wrote);
    wrote = _agnosai_otlp_emit_str_a(a, sb, span, AGNOSAI_GENAI_CREW_NAME, wrote);
    wrote = _agnosai_otlp_emit_int_a(a, sb, span, AGNOSAI_GENAI_USAGE_INPUT_TOKENS, wrote);
    wrote = _agnosai_otlp_emit_int_a(a, sb, span, AGNOSAI_GENAI_USAGE_OUTPUT_TOKENS, wrote);
    wrote = _agnosai_otlp_emit_int_a(a, sb, span, AGNOSAI_GENAI_CREW_TASK_COUNT, wrote);

    str_builder_add_cstr_a(a, sb, "],\"status\":{\"code\":");
    str_builder_add_int_a(a, sb, load64(ctx + AGN_OTC_STATUS));
    str_builder_add_cstr_a(a, sb, "}}");
    return 0;
}

# Wrap `n` encoded spans (oldest first) in an OTLP `ResourceSpans` document.
#
# `frags` is an array of `n` Str pointers. The `service.name` resource attribute
# is what a backend groups by, so it is the one attribute the resource carries.
fn agnosai_otlp_build_batch_a(a, service_name: Str, frags, n): i64 {
    var sb = str_builder_new_a(a);
    str_builder_add_cstr_a(a, sb, "{\"resourceSpans\":[{\"resource\":{\"attributes\":[");
    _agnosai_otlp_attr_str_a(a, sb, "service.name", service_name);
    str_builder_add_cstr_a(a, sb, "]},\"scopeSpans\":[{\"scope\":{\"name\":\"agnosai\"},\"spans\":[");
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_add_cstr_a(a, sb, ","); }
        str_builder_add_a(a, sb, load64(frags + i * 8));
    }
    str_builder_add_cstr_a(a, sb, "]}]}]}");
    return str_builder_build_a(a, sb);
}

# Global-allocator form of `agnosai_otlp_build_batch_a`.
#
# ⚠ The ring does NOT use this — `agnosai_otlp_ring_drain` builds the same
# document straight into its `doc_arena`. This form exists for the encoder tests,
# which assert the wire bytes without standing up a ring.
fn agnosai_otlp_build_batch(service_name: Str, frags, n): i64 {
    return agnosai_otlp_build_batch_a(default_alloc(), service_name, frags, n);
}

# --- endpoint parsing -----------------------------------------------------

# Whether the endpoint is an `https://` collector.
fn agnosai_otlp_is_https(url): i64 {
    if (url == 0) { return 0; }
    if (strlen(url) < 8) { return 0; }
    return memeq(url, "https://", 8);
}

# The path component of `http://host:port/path`, or `/v1/traces` when the URL
# carries none.
#
# ⚠ The scan starts after the scheme so the `//` in `http://` cannot be mistaken
# for the path. hoosh hardcodes 7 because it only ever sees `http://`; an
# `https://` URL is one longer, and starting at 7 would land on the second `/`
# of `//` and answer `/` — a POST to the collector's root, which 404s. So the
# offset comes from the scheme.
fn agnosai_otlp_path(url): i64 {
    var i = 7;
    if (agnosai_otlp_is_https(url) == 1) { i = 8; }
    while (load8(url + i) != 0) {
        if (load8(url + i) == 47) { return url + i; }
        i = i + 1;
    }
    return AGNOSAI_OTLP_DEFAULT_PATH;
}

# --- the export ring ------------------------------------------------------
#
# ## Identity is the CALLER's, never sakshi's
#
# The decision this bite owed. sakshi's trace id and span stack are process
# globals (`sakshi_trace_id_hi` / `_lo`), so under `sandhi_server_run_pooled`
# two concurrent requests share one trace id and the traces interleave into
# nonsense. There is no thread-local to reach for — that is the gap the roadmap
# note asks a real OTel library to close.
#
# So **the export path never reads sakshi's trace context at all.** `enqueue`
# takes an `agnosai_otlp_ctx_new(..)` the caller built, and correlation is the
# caller's job: mint one trace id per request (`agnosai_uuid_v4` is already a
# random 128-bit value) and pass it into every span's context. That is
# reentrant by construction, needs no upstream change, and is honest about
# where the responsibility sits.
#
# ## Two arenas, with single-owner rules
#
# Every span fragment is a fresh allocation, and the default allocator never
# frees — at ten spans a second that is ~14 MB an hour that never comes back.
# hoosh accepts this; agnosai's own principle ("thread the `_a` variants") does
# not. So:
#
# * **`frag_arena`** holds the encoded fragments and is written **only under the
#   ring lock** — by `enqueue` on worker threads and by nothing else. `drain`
#   resets it while still holding the lock, so a fragment never outlives the
#   batch that carried it.
# * **`doc_arena`** holds the batch document and is **private to the draining
#   thread**. It is reset at the top of each drain, which makes the lifetime
#   rule a single sentence: *a batch document is valid until the next drain*.
#   That is exactly the POST window.
#
# Encoding happens inside the critical section. It is pure string work with no
# I/O, and doing it there is what lets the fragment arena be reset safely.

# Ring capacity. hoosh uses the same 256 — a second of spans at any rate a
# single process can actually produce.
var AGNOSAI_OTLP_RING_MAX = 256;

# Per-arena capacity in bytes, sized from the RING's capacity so a full ring
# never spills.
#
# ⚠ **Size this against amplified cost, not final size.** `str_builder` starts
# at a 64-byte inline buffer and doubles, and an arena has no free — so every
# intermediate buffer stays. Measured 2026-08-12: a span fragment of ~700 bytes
# costs **2,736 bytes** of arena (64+128+256+512+1024 of abandoned grows, plus
# the built copy). Flat across 1, 10, 32 and 64 spans.
#
# 256 slots x 2,736 B = ~700 KB, so 768 KiB covers a completely full ring with
# headroom. The previous 256 KiB held ~95 spans and then spilled — and
# ARENA_FULL_SPILL spills to the **no-free global bump**, which is the leak this
# module was fixed for. Measured at 128 spans on the old size: 180,928 bytes
# spilled to the global in a single cycle.
#
# ⚠ The cost is VIRTUAL, not resident: arena chunks are anonymous overcommitted
# mmaps and only touched pages count against RSS (`lib/alloc.cyr:150-155`). Two
# arenas at 768 KiB is 1.5 MB of address space reserved once at startup, against
# the per-operation global-bump growth it removes.
var AGNOSAI_OTLP_ARENA_BYTES = 786432;

# Ring heap layout — 56 bytes.
enum AgnosaiOtlpRingOff {
    AGN_OTR_SLOTS = 0;
    AGN_OTR_HEAD = 8;
    AGN_OTR_COUNT = 16;
    # Spans discarded because the ring was full. Never silently zero — see
    # `agnosai_otlp_ring_dropped`.
    AGN_OTR_DROPPED = 24;
    AGN_OTR_LOCK = 32;
    AGN_OTR_FRAG_ARENA = 40;
    AGN_OTR_DOC_ARENA = 48;
    AGN_OTR_SIZE = 56;
}

# How many spans the ring holds before it starts dropping.
fn agnosai_otlp_ring_capacity(): i64 {
    return AGNOSAI_OTLP_RING_MAX;
}

# A new export ring with its lock and both arenas.
#
# Both arenas are `ARENA_FULL_SPILL`: an oversized batch is served from the
# global allocator rather than returning 0, because a dropped *allocation*
# inside the encoder would produce a truncated JSON document — malformed output
# is worse than an unbounded byte.
fn agnosai_otlp_ring_new(): i64 {
    var r = alloc(AGN_OTR_SIZE);
    var slots = alloc(AGNOSAI_OTLP_RING_MAX * 8);
    for (var i = 0; i < AGNOSAI_OTLP_RING_MAX; i = i + 1) { store64(slots + i * 8, 0); }
    store64(r + AGN_OTR_SLOTS, slots);
    store64(r + AGN_OTR_HEAD, 0);
    store64(r + AGN_OTR_COUNT, 0);
    store64(r + AGN_OTR_DROPPED, 0);
    store64(r + AGN_OTR_LOCK, mutex_new());
    var fa = arena_allocator(AGNOSAI_OTLP_ARENA_BYTES);
    arena_allocator_set_on_full(fa, ARENA_FULL_SPILL);
    store64(r + AGN_OTR_FRAG_ARENA, fa);
    var da = arena_allocator(AGNOSAI_OTLP_ARENA_BYTES);
    arena_allocator_set_on_full(da, ARENA_FULL_SPILL);
    store64(r + AGN_OTR_DOC_ARENA, da);
    return r;
}

# Spans currently waiting to be exported.
fn agnosai_otlp_ring_count(r): i64 {
    return load64(r + AGN_OTR_COUNT);
}

# The arena holding encoded fragments. Written only under the ring lock.
#
# Exposed because the separation from `doc_arena` is a **correctness property,
# not an implementation detail**: if the two were the same allocator, `drain`
# would reset the arena holding the fragments it is about to read.
#
# ⚠ Arena lifetime bugs are **not observable by assertion** in a bump allocator
# — a reset rewinds an offset and leaves the bytes intact, so use-after-reset
# reads correct data in a single-threaded test. The accessor pins that two
# arenas exist; that enqueue targets the right one is correct by construction
# only. Recorded in `roadmap.md` section E.
fn agnosai_otlp_ring_frag_arena(r): i64 {
    return load64(r + AGN_OTR_FRAG_ARENA);
}

# The arena holding the batch document. Private to the draining thread.
fn agnosai_otlp_ring_doc_arena(r): i64 {
    return load64(r + AGN_OTR_DOC_ARENA);
}

# Spans discarded because the ring was full, cumulative.
#
# ⚠ hoosh's ring drops the oldest and counts nothing, so loss is invisible. The
# port's standing rule is no silent truncation: this is the number an operator
# checks when a trace has holes in it.
fn agnosai_otlp_ring_dropped(r): i64 {
    return load64(r + AGN_OTR_DROPPED);
}

# Encode `span` under `ctx` and queue it. Returns 1 when queued, 0 when the ring
# was full and the OLDEST span was discarded to make room.
#
# ⚠ Drop-oldest, not drop-newest: a full ring means the exporter is behind, and
# the newest spans are the ones an operator is looking at. Matches hoosh.
fn agnosai_otlp_ring_enqueue(r, span, ctx): i64 {
    var lock = load64(r + AGN_OTR_LOCK);
    mutex_lock(lock);

    var fa = load64(r + AGN_OTR_FRAG_ARENA);
    var sb = str_builder_new_a(fa);
    _agnosai_otlp_span_json_into_a(fa, sb, span, ctx);
    var frag = str_builder_build_a(fa, sb);

    var head = load64(r + AGN_OTR_HEAD);
    store64(load64(r + AGN_OTR_SLOTS) + (head % AGNOSAI_OTLP_RING_MAX) * 8, frag);
    store64(r + AGN_OTR_HEAD, head + 1);

    var count = load64(r + AGN_OTR_COUNT);
    var queued = 1;
    if (count >= AGNOSAI_OTLP_RING_MAX) {
        store64(r + AGN_OTR_DROPPED, load64(r + AGN_OTR_DROPPED) + 1);
        queued = 0;
    } else {
        store64(r + AGN_OTR_COUNT, count + 1);
    }
    mutex_unlock(lock);
    return queued;
}

# Drain everything queued into one OTLP batch document, or 0 when empty.
#
# The returned Str lives in the ring's `doc_arena` and is **valid until the next
# drain** — POST it before draining again. See the header.
fn agnosai_otlp_ring_drain(r, service_name: Str): i64 {
    var lock = load64(r + AGN_OTR_LOCK);
    mutex_lock(lock);
    var n = load64(r + AGN_OTR_COUNT);
    if (n == 0) {
        mutex_unlock(lock);
        return 0;
    }

    # Oldest first. `head` has already advanced past the newest, so the oldest
    # live slot is `head - n`.
    var head = load64(r + AGN_OTR_HEAD);
    var slots = load64(r + AGN_OTR_SLOTS);
    var doc_arena = load64(r + AGN_OTR_DOC_ARENA);
    reset_via(doc_arena);

    var sb = str_builder_new_a(doc_arena);
    str_builder_add_cstr_a(doc_arena, sb, "{\"resourceSpans\":[{\"resource\":{\"attributes\":[");
    _agnosai_otlp_attr_str_a(doc_arena, sb, "service.name", service_name);
    str_builder_add_cstr_a(doc_arena, sb,
      "]},\"scopeSpans\":[{\"scope\":{\"name\":\"agnosai\"},\"spans\":[");
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_add_cstr_a(doc_arena, sb, ","); }
        str_builder_add_a(doc_arena, sb,
          load64(slots + ((head - n + i) % AGNOSAI_OTLP_RING_MAX) * 8));
    }
    str_builder_add_cstr_a(doc_arena, sb, "]}]}]}");
    var doc = str_builder_build_a(doc_arena, sb);

    # The fragments are copied into `doc` now, so the arena that held them can
    # go back to zero before any other thread gets the lock.
    store64(r + AGN_OTR_COUNT, 0);
    reset_via(load64(r + AGN_OTR_FRAG_ARENA));
    mutex_unlock(lock);
    return doc;
}

# --- the exporter ---------------------------------------------------------
#
# ## The POST goes through sandhi, not a raw socket
#
# hoosh opens a raw TCP socket for `http://` and only routes `https://` through
# sandhi, because its exporter thread owns no sigil crypto bank and TLS needs
# one. agnosai has no such constraint, so both schemes go through
# `sandhi_http_post` — which brings DNS, timeouts and TLS with it and deletes
# the hand-rolled HTTP/1.0 request builder hoosh had to write.
#
# ## The SSRF guard is deliberately NOT applied
#
# `src/guarded_fetch.cyr` exists because a *user* can influence the URLs the
# tool layer fetches. The collector endpoint is operator configuration read from
# `OTEL_EXPORTER_OTLP_ENDPOINT`, and the standard deployment is a sidecar on
# `http://localhost:4318` — which the SSRF guard blocks by design. Routing this
# through it would break the normal case to defend against a threat that does
# not exist here. Stated rather than silently bypassed.
#
# ## Export is best-effort
#
# A collector that is down must never fail a request or block a worker. The
# POST's result is ignored, the thread is detached, and the ring drops the
# oldest span when it is full. Telemetry loss is preferable to backpressure on
# the work the telemetry describes.

# The oracle has no equivalent; hoosh batches every 1000 ms and so does this.
var AGNOSAI_OTLP_BATCH_MS = 1000;

# Exporter heap layout — 48 bytes.
enum AgnosaiOtlpExporterOff {
    AGN_OTE_RING = 0;
    # 0 when no endpoint is configured — the exporter still drains, so a
    # disabled collector does not grow the ring without bound.
    AGN_OTE_ENDPOINT = 8;
    AGN_OTE_SERVICE = 16;
    AGN_OTE_INTERVAL_MS = 24;
    AGN_OTE_STOP = 32;
    AGN_OTE_EXPORTED = 40;
    AGN_OTE_SIZE = 48;
}

# An exporter over its own ring. `endpoint` may be 0 (drain and discard).
fn agnosai_otlp_exporter_new(endpoint, service_name: Str, interval_ms): i64 {
    var e = alloc(AGN_OTE_SIZE);
    store64(e + AGN_OTE_RING, agnosai_otlp_ring_new());
    store64(e + AGN_OTE_ENDPOINT, endpoint);
    store64(e + AGN_OTE_SERVICE, service_name);
    store64(e + AGN_OTE_INTERVAL_MS, interval_ms);
    store64(e + AGN_OTE_STOP, 0);
    store64(e + AGN_OTE_EXPORTED, 0);
    return e;
}

# The exporter's ring — what a caller enqueues into.
fn agnosai_otlp_exporter_ring(e): i64 {
    return load64(e + AGN_OTE_RING);
}

# Spans successfully handed to a batch, cumulative.
fn agnosai_otlp_exporter_exported(e): i64 {
    return load64(e + AGN_OTE_EXPORTED);
}

# Whether the exporter has been asked to stop.
fn agnosai_otlp_exporter_stopping(e): i64 {
    return load64(e + AGN_OTE_STOP);
}

# POST one batch document. Best-effort — the result is deliberately ignored.
#
# ⚠ Not reachable from the suite: it needs a listening collector. Everything
# that decides *what* to send is in `drain` and the encoder, which are tested
# byte-for-byte; this function only moves bytes. Recorded in roadmap section E.
# --- OTEL_EXPORTER_OTLP_HEADERS -------------------------------------------
#
# ⚠ **Without this, no hosted collector is reachable.** Honeycomb, Grafana Cloud
# and Datadog all authenticate through a header carried in this variable, and
# the module read only `OTEL_EXPORTER_OTLP_ENDPOINT` — so the exporter worked
# against an unauthenticated local sidecar and against nothing else.
#
# ⚠ There is **no oracle counterpart to port from**:
# `rust-old/src/telemetry/mod.rs:50` hands the whole transport to
# `hoosh::telemetry::init_otel`, so the oracle never implements headers, paths
# or retry — it inherits them from an SDK. ADR 003 keeps hoosh as a remote seam
# rather than linking it, so this file is port-original and its bar is the
# OTLP/HTTP spec, not a Rust line.
#
# Format is the spec's: `key1=value1,key2=value2`. Whitespace around either side
# is trimmed; an entry with no `=` is skipped.
var AGNOSAI_OTLP_HDR_MAX = 16;
var AGNOSAI_OTLP_HDR_KEY_MAX = 128;
var AGNOSAI_OTLP_HDR_VAL_MAX = 512;

# Parse `OTEL_EXPORTER_OTLP_HEADERS` onto `h`. Returns the number added.
#
# ⚠ An over-long key or value is **SKIPPED, never truncated**. These carry API
# tokens: a truncated token authenticates as nothing and fails at the collector
# with a 401 that looks like a credential problem rather than a parser one.
fn _agnosai_otlp_add_env_headers(h): i64 {
    var raw = getenv("OTEL_EXPORTER_OTLP_HEADERS");
    if (raw == 0) { return 0; }

    var kbuf[128];
    var vbuf[512];
    var kp = &kbuf;
    var vp = &vbuf;
    var i = 0;
    var n = 0;

    while (load8(raw + i) != 0 && n < AGNOSAI_OTLP_HDR_MAX) {
        while (load8(raw + i) == 32 || load8(raw + i) == 44) { i = i + 1; }
        if (load8(raw + i) == 0) { return n; }

        var kl = 0;
        var kover = 0;
        while (load8(raw + i) != 0 && load8(raw + i) != 61 && load8(raw + i) != 44) {
            if (kl < AGNOSAI_OTLP_HDR_KEY_MAX - 1) {
                store8(kp + kl, load8(raw + i));
                kl = kl + 1;
            } else { kover = 1; }
            i = i + 1;
        }
        while (kl > 0 && load8(kp + kl - 1) == 32) { kl = kl - 1; }
        store8(kp + kl, 0);

        if (load8(raw + i) == 61) {
            i = i + 1;
            while (load8(raw + i) == 32) { i = i + 1; }

            var vl = 0;
            var vover = 0;
            while (load8(raw + i) != 0 && load8(raw + i) != 44) {
                if (vl < AGNOSAI_OTLP_HDR_VAL_MAX - 1) {
                    store8(vp + vl, load8(raw + i));
                    vl = vl + 1;
                } else { vover = 1; }
                i = i + 1;
            }
            while (vl > 0 && load8(vp + vl - 1) == 32) { vl = vl - 1; }
            store8(vp + vl, 0);

            if (kl > 0 && vl > 0 && kover == 0 && vover == 0) {
                sandhi_headers_add(h, kp, vp);
                n = n + 1;
            }
        }
    }
    return n;
}

# The URL to POST to: the configured endpoint, with `/v1/traces` appended when
# it carries no path of its own.
#
# ⚠ **`agnosai_otlp_path` existed for this and had ZERO production callers** —
# only five assertions in `tests/telemetry_otlp.tcyr`. `_agnosai_otlp_post`
# posted `str_cstr(endpoint)` raw, so the documented deployment
# (`OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318`, the sidecar form this
# module's own header describes) sent `POST /` and every collector answered 404.
# The whole telemetry tier was silently non-functional. Fixed 2026-08-12.
#
# An endpoint that already names a path is passed through untouched — the OTLP
# spec treats `OTEL_EXPORTER_OTLP_TRACES_ENDPOINT` as complete, and appending to
# it would produce `/v1/traces/v1/traces`.
fn _agnosai_otlp_post_url(a, endpoint: Str): Str {
    var raw = str_cstr(endpoint);
    if (agnosai_otlp_path(raw) != AGNOSAI_OTLP_DEFAULT_PATH) { return endpoint; }
    var sb = str_builder_new_a(a);
    str_builder_add_a(a, sb, endpoint);
    str_builder_add_cstr_a(a, sb, AGNOSAI_OTLP_DEFAULT_PATH);
    return str_builder_build_a(a, sb);
}

fn _agnosai_otlp_post(endpoint: Str, doc: Str): i64 {
    var a = default_alloc();
    var url = _agnosai_otlp_post_url(a, endpoint);
    var h = sandhi_headers_new();
    sandhi_headers_add(h, "Content-Type", "application/json");
    _agnosai_otlp_add_env_headers(h);
    sandhi_http_post(str_cstr(url), h, str_data(doc), str_len(doc));
    return 0;
}

# Drain the ring once and POST whatever came out. Returns the number of spans
# in the batch, or 0 when there was nothing to send.
#
# The testable half of the exporter: it decides *whether* and *what*, and only
# the final byte-moving step needs a collector.
fn agnosai_otlp_exporter_flush(e): i64 {
    var ring = load64(e + AGN_OTE_RING);
    var n = agnosai_otlp_ring_count(ring);
    if (n == 0) { return 0; }
    var doc = agnosai_otlp_ring_drain(ring, load64(e + AGN_OTE_SERVICE));
    if (doc == 0) { return 0; }
    store64(e + AGN_OTE_EXPORTED, load64(e + AGN_OTE_EXPORTED) + n);
    var endpoint = load64(e + AGN_OTE_ENDPOINT);
    # ⚠ The drain happens even with no endpoint. Skipping it would let the ring
    # fill and every span report as dropped, which reads like a bug in the
    # exporter rather than an absent collector.
    if (endpoint != 0) { _agnosai_otlp_post(endpoint, doc); }
    return n;
}

# How often the sleeping exporter checks whether it has been asked to stop.
var AGNOSAI_OTLP_STOP_POLL_MS = 25;

# The background loop: flush every `interval_ms` until asked to stop.
#
# ⚠ The sleep is **sliced**, not one `sleep_ms(interval_ms)`. A single sleep
# means `stop` is not noticed for up to a full interval, and the process cannot
# exit in the meantime — `.tcyr` epilogues and `_agnosai_exit_process`'s agnos
# path both end with `syscall(60, ..)`, which exits one *thread*, so a detached
# thread still sleeping holds the whole process open. Measured: one second of
# dead wait on every shutdown, and on `tests/telemetry_mod.tcyr`. Slicing turns
# that into at most `AGNOSAI_OTLP_STOP_POLL_MS`.
#
# ⚠ The loop does NOT flush on the way out. `agnosai_otlp_exporter_stop` does
# the final flush on the caller's thread, so exiting here would double it.
fn _agnosai_otlp_exporter_thread(e): i64 {
    while (load64(e + AGN_OTE_STOP) == 0) {
        var interval = load64(e + AGN_OTE_INTERVAL_MS);
        var slept = 0;
        while (slept < interval) {
            if (load64(e + AGN_OTE_STOP) != 0) { break; }
            var slice = AGNOSAI_OTLP_STOP_POLL_MS;
            if (interval - slept < slice) { slice = interval - slept; }
            sleep_ms(slice);
            slept = slept + slice;
        }
        if (load64(e + AGN_OTE_STOP) != 0) { break; }
        agnosai_otlp_exporter_flush(e);
    }
    return 0;
}

# Start the background exporter. Detached — nothing ever joins it.
#
# `thread_create_detached` rather than `thread_create`: a joinable thread nobody
# joins leaks its 2 MiB stack for the life of the process (cyrius 6.5.8's own
# filing from this repo).
fn agnosai_otlp_exporter_start(e): i64 {
    thread_create_detached(&_agnosai_otlp_exporter_thread, e);
    return 0;
}

# Stop the loop and flush what is left. Returns the spans in the final batch.
#
# ⚠ Racy with a flush already in flight on the exporter thread, and benignly so:
# the drain itself is under the ring lock, so the two threads split the pending
# spans between two batches rather than duplicating or losing any. The only
# casualty is `AGN_OTE_EXPORTED`, a diagnostic counter whose increment is not
# atomic and can lose an update under that race. Not worth a second lock.
#
# ⚠ The final flush is the point. The oracle's `TracingGuard` exports pending
# spans when it drops; without this, every span queued in the last interval is
# lost on a clean shutdown — the batch most likely to explain why the process
# is shutting down.
fn agnosai_otlp_exporter_stop(e): i64 {
    store64(e + AGN_OTE_STOP, 1);
    return agnosai_otlp_exporter_flush(e);
}

# --- mod.cyr ---

# =========================================================================
# telemetry/mod — OpenTelemetry integration and the JSON log formatter.
#
# Origin: rust-old/src/telemetry/mod.rs (plus the logging init at
# rust-old/src/main.rs:69-72, which is the same subscriber built inline).
#
# ## The "sakshi has no JSON output mode" divergence was FALSE
#
# `src/main.cyr` carried it as stated divergence #3 and `roadmap.md` M9 planned
# to open a sakshi filing for it. Neither survives contact with the library:
# **`sakshi_set_emit_hook` (`lib/sakshi.cyr:1038`) routes every event through a
# caller-supplied `fn(ts, level, category, msg, msg_len, elapsed_ns)`**, and its
# own doc comment names this exact use — "downstream consumers (OTel, custom
# aggregators, in-memory sinks) ... without sakshi knowing their format". The
# formatter belongs here, not upstream, and nothing had to be filed for it.
#
# ## Structured fields, consumed from sakshi 2.4.10
#
# The gap this port reported — `sakshi_log_kv` flattening `key=val` into the
# message before the hook could see it — is **fixed upstream and consumed here**
# as of the 6.5.16 bump. For a log event the hook's sixth argument is 0 or a
# count-prefixed fields block of `{key, key_len, val, val_len}` records, and
# `msg` arrives without the ` key=value` tail. `level` discriminates: 0-5 are
# log events, 10-11 are spans (where the sixth argument is still a duration).
#
# ⚠ **Consuming it was mandatory, not optional.** On 2.4.10 a hook that ignores
# the sixth argument does not merely fail to structure the fields — it drops
# them entirely, because they are no longer in `msg`. Verified against the real
# binary in both directions before and after this change.
#
# What is still not reachable through the hook, and stated at each site below:
# the `span` / `spans` objects, and per-module `target` values.
#
# ## The hook must not allocate, and must be reentrant
#
# It runs once per log line on every worker thread. The default allocator is a
# no-free bump, so a single `alloc` here grows the process without bound over a
# server's lifetime — which rules out `iso8601()` and `epoch_to_date()`
# (`lib/chrono.cyr:263`, `:227`), both of which allocate. Everything below
# formats into a stack buffer and exits through one `write(2)`, which is also
# what sakshi's own stderr path does.
#
# ## Two clocks, again
#
# The hook's `ts` argument is **monotonic** (`_sk_now_ns`), and the oracle's
# JSON `timestamp` is wall clock. So `ts` is deliberately ignored and the
# formatter reads `clock_epoch_ns()` itself. On agnos that has whole-second
# granularity (`lib/chrono.cyr:85`), so the microsecond field reads `.000000`
# there — stated rather than hidden.
#
# ## RUST_LOG means different things in the oracle's two paths
#
# - `main.rs`'s non-otel branch is `from_default_env().add_directive("agnosai=info")`.
#   The added directive wins for the `agnosai` target, so **the port's own level
#   is pinned at INFO and `RUST_LOG` cannot change it** — it can only reach
#   dependency targets, which this binary does not have.
# - `init_tracing`'s is `try_from_default_env().unwrap_or_else(|| "agnosai=info")`.
#   A set `RUST_LOG` **replaces** the default outright, so it does control the
#   level there.
#
# Both are reproduced. `agnosai_telemetry_env_filter_level` is only consulted on
# the `init_tracing` path, which is why `main` does not call it.
# =========================================================================

# `pub mod genai;` — the oracle declares it before its own code, and it depends
# on nothing here, so it leads the single-pass include order too.

# The OTLP encoder. No oracle module — see its header. It reads genai spans, so
# it follows genai and precedes `init_tracing`, which will drive it.

# The oracle's `DEFAULT_SERVICE_NAME`.
fn agnosai_telemetry_default_service_name(): i64 {
    return str_from("agnosai");
}

# The service name reported to the collector: `OTEL_SERVICE_NAME`, else the
# default. ⚠ An **empty** `OTEL_SERVICE_NAME` is honoured as an empty name, not
# treated as unset — `std::env::var` returns `Ok("")` and `unwrap_or_else` does
# not fire. `otlp_endpoint_from_env` filters empties; this does not, and the
# asymmetry is the oracle's.
fn agnosai_telemetry_service_name(): i64 {
    var v = getenv("OTEL_SERVICE_NAME");
    if (v == 0) { return agnosai_telemetry_default_service_name(); }
    return str_from(v);
}

# The OTLP endpoint from `OTEL_EXPORTER_OTLP_ENDPOINT`, or 0 for the oracle's
# `None`. An empty value is `None`, matching the oracle's `.filter(|s| !s.is_empty())`.
fn agnosai_otlp_endpoint_from_env(): i64 {
    var v = getenv("OTEL_EXPORTER_OTLP_ENDPOINT");
    if (v == 0) { return 0; }
    if (strlen(v) == 0) { return 0; }
    return str_from(v);
}

# --- the env filter ------------------------------------------------------

# ASCII case-insensitive compare of `data[0..len]` against a NUL-terminated
# literal. Local because this is the first *equality* of this shape in the tree
# — `cost_planning` and `prompt_guard` each own a case-insensitive **contains**,
# which is a different operation.
fn _agnosai_telemetry_eq_ci(data, len, lit): i64 {
    if (len != strlen(lit)) { return 0; }
    for (var i = 0; i < len; i = i + 1) {
        var a = load8(data + i);
        if (a >= 65) { if (a <= 90) { a = a + 32; } }
        var b = load8(lit + i);
        if (b >= 65) { if (b <= 90) { b = b + 32; } }
        if (a != b) { return 0; }
    }
    return 1;
}

# Map one level word — `data[0..len]` — to its `SK_*` value, or -1 if it is not
# a level.
#
# ⚠ Case-insensitive, as `tracing`'s directive parser is. `warning` is NOT
# accepted — `tracing` takes `warn`.
fn _agnosai_telemetry_level_of(data, len): i64 {
    if (_agnosai_telemetry_eq_ci(data, len, "trace") == 1) { return SK_TRACE; }
    if (_agnosai_telemetry_eq_ci(data, len, "debug") == 1) { return SK_DEBUG; }
    if (_agnosai_telemetry_eq_ci(data, len, "info") == 1) { return SK_INFO; }
    if (_agnosai_telemetry_eq_ci(data, len, "warn") == 1) { return SK_WARN; }
    if (_agnosai_telemetry_eq_ci(data, len, "error") == 1) { return SK_ERROR; }
    return 0 - 1;
}

# The decision half: the level `data[0..len]` asks for, or -1.
#
# ⚠ **A reduction, and a stated one.** `EnvFilter` supports per-target
# directives, spans, and field predicates; sakshi has a single process-wide
# level (`lib/sakshi.cyr:1284`). So only two forms are honoured — a bare level
# (`RUST_LOG=debug`) and a directive naming this crate (`RUST_LOG=agnosai=debug`)
# — and anything else falls back to the default. A multi-target `RUST_LOG` is
# **not** partially applied: applying one directive globally would silently
# raise verbosity for targets the operator excluded, which is worse than
# ignoring it.
#
# Split from the environment read under the port's standing rule 8, and for the
# same reason `fleet/environment` splits its cgroup parsers — `getenv` reads
# `/proc/self/environ` (`lib/io.cyr:757`) and there is no `setenv`, so a test
# that went through the variable could only observe whatever the CI runner
# happened to export. The oracle's own test is vacuous for exactly this reason.
fn agnosai_telemetry_parse_directive(data, len): i64 {
    if (len == 0) { return 0 - 1; }

    var bare = _agnosai_telemetry_level_of(data, len);
    if (bare >= 0) { return bare; }

    # `agnosai=<level>` — the only target this binary emits under. Scanned by
    # hand rather than through `str_split`, which allocates a vec and two Str
    # headers to answer a question about one byte.
    var eq = 0 - 1;
    for (var i = 0; i < len; i = i + 1) {
        if (load8(data + i) == 61) {
            # A second `=` means a multi-directive filter — not honourable.
            if (eq >= 0) { return 0 - 1; }
            eq = i;
        }
        # A comma likewise: `RUST_LOG=a=info,b=warn` is more than one target.
        if (load8(data + i) == 44) { return 0 - 1; }
    }
    if (eq < 0) { return 0 - 1; }
    if (_agnosai_telemetry_eq_ci(data, eq, "agnosai") == 0) { return 0 - 1; }
    return _agnosai_telemetry_level_of(data + eq + 1, len - eq - 1);
}

# The level `RUST_LOG` asks for, or -1 when it is unset or names nothing this
# binary can honour. Thin: every decision lives in `parse_directive`.
fn agnosai_telemetry_env_filter_level(): i64 {
    var v = getenv("RUST_LOG");
    if (v == 0) { return 0 - 1; }
    return agnosai_telemetry_parse_directive(v, strlen(v));
}

# --- the JSON formatter --------------------------------------------------

# The smallest buffer `agnosai_telemetry_format_json` will write into.
#
# The fixed part of a line is 14 (`{"timestamp":"`) + 27 (RFC 3339) + 11
# (`","level":"`) + at most 7 (`UNKNOWN`) + 22 (`","fields":{"message":""},`
# through `"target":"agnosai"}`) + 1 newline = 82, plus the 32 bytes of
# headroom the message bound reserves. 128 rounds that up and leaves room for a
# byte of message.
var AGNOSAI_TELEMETRY_MIN_CAP = 128;

# The buffer the hook formats into, and **not an arbitrary number**: `PIPE_BUF`
# is 4096 on Linux, and a `write(2)` of at most `PIPE_BUF` to a pipe is atomic.
# Since a supervised server's stderr is normally a pipe, this is what keeps two
# worker threads from interleaving halves of a line. A larger buffer would
# silently give that up.
var AGNOSAI_TELEMETRY_LINE_CAP = 4096;

# Days in each month, non-leap. Index 0 is January.
var _agnosai_telemetry_mdays[96];
var _agnosai_telemetry_mdays_ready = 0;

# Fill the month table once. Idempotent, and called before any thread starts.
fn _agnosai_telemetry_init_mdays(): i64 {
    if (_agnosai_telemetry_mdays_ready == 1) { return 0; }
    store64(&_agnosai_telemetry_mdays + 0, 31);
    store64(&_agnosai_telemetry_mdays + 8, 28);
    store64(&_agnosai_telemetry_mdays + 16, 31);
    store64(&_agnosai_telemetry_mdays + 24, 30);
    store64(&_agnosai_telemetry_mdays + 32, 31);
    store64(&_agnosai_telemetry_mdays + 40, 30);
    store64(&_agnosai_telemetry_mdays + 48, 31);
    store64(&_agnosai_telemetry_mdays + 56, 31);
    store64(&_agnosai_telemetry_mdays + 64, 30);
    store64(&_agnosai_telemetry_mdays + 72, 31);
    store64(&_agnosai_telemetry_mdays + 80, 30);
    store64(&_agnosai_telemetry_mdays + 88, 31);
    _agnosai_telemetry_mdays_ready = 1;
    return 0;
}

# Split epoch seconds into civil fields, written into a caller-supplied
# 48-byte buffer as {year, month, day, hour, min, sec}.
#
# The same loops as `lib/chrono.cyr`'s `epoch_to_date`, so the two agree — but
# writing into the caller's buffer rather than allocating one. See the module
# header for why that matters here and nowhere else.
#
# ⚠ Undefined before 1970, exactly as the oracle helper is: the year loop only
# counts forward. Log timestamps are never negative.
fn _agnosai_telemetry_civil(epoch_secs, out): i64 {
    var days = epoch_secs / 86400;
    var rem = epoch_secs % 86400;
    store64(out + 24, rem / 3600);
    rem = rem % 3600;
    store64(out + 32, rem / 60);
    store64(out + 40, rem % 60);

    var y = 1970;
    var yd = 365;
    while (days >= yd) {
        days = days - yd;
        y = y + 1;
        yd = 365;
        if (is_leap_year(y) == 1) { yd = 366; }
    }
    store64(out, y);

    var m = 0;
    while (m < 12) {
        var md = load64(&_agnosai_telemetry_mdays + m * 8);
        if (m == 1) { if (is_leap_year(y) == 1) { md = 29; } }
        if (days < md) { break; }
        days = days - md;
        m = m + 1;
    }
    store64(out + 8, m + 1);
    store64(out + 16, days + 1);
    return 0;
}

# Write `val` zero-padded to `width` digits at `buf + pos`. Returns the new pos.
fn _agnosai_telemetry_wpad(buf, pos, val, width): i64 {
    var scale = 1;
    for (var i = 1; i < width; i = i + 1) { scale = scale * 10; }
    while (scale > 0) {
        store8(buf + pos, 48 + (val / scale) % 10);
        pos = pos + 1;
        scale = scale / 10;
    }
    return pos;
}

# Write the oracle's RFC 3339 timestamp — `YYYY-MM-DDTHH:MM:SS.uuuuuuZ` — at
# `buf + pos`. Returns the new pos. Always 27 bytes.
fn _agnosai_telemetry_write_ts(buf, pos, epoch_ns): i64 {
    var civ[48];
    _agnosai_telemetry_civil(epoch_ns / 1000000000, &civ);
    pos = _agnosai_telemetry_wpad(buf, pos, load64(&civ), 4);
    store8(buf + pos, 45);
    pos = _agnosai_telemetry_wpad(buf, pos + 1, load64(&civ + 8), 2);
    store8(buf + pos, 45);
    pos = _agnosai_telemetry_wpad(buf, pos + 1, load64(&civ + 16), 2);
    store8(buf + pos, 84);
    pos = _agnosai_telemetry_wpad(buf, pos + 1, load64(&civ + 24), 2);
    store8(buf + pos, 58);
    pos = _agnosai_telemetry_wpad(buf, pos + 1, load64(&civ + 32), 2);
    store8(buf + pos, 58);
    pos = _agnosai_telemetry_wpad(buf, pos + 1, load64(&civ + 40), 2);
    store8(buf + pos, 46);
    pos = _agnosai_telemetry_wpad(buf, pos + 1, (epoch_ns / 1000) % 1000000, 6);
    store8(buf + pos, 90);
    return pos + 1;
}

# Copy `src[0..len]` into `buf` at `pos` as JSON string content, escaping what
# RFC 8259 requires. Returns the new pos, stopping short rather than running
# past `cap`.
#
# ⚠ Bytes below 0x20 become a `\u00xx` escape, so a log line carrying a newline
# stays one JSON line. Non-ASCII is passed through unescaped — sakshi messages
# are UTF-8 and RFC 8259 permits raw UTF-8 in a string.
fn _agnosai_telemetry_write_escaped(buf, cap, pos, src, len): i64 {
    for (var i = 0; i < len; i = i + 1) {
        if (pos + 6 > cap) { return pos; }
        var c = load8(src + i);
        if (c == 34) {
            store8(buf + pos, 92);
            store8(buf + pos + 1, 34);
            pos = pos + 2;
        } else {
            if (c == 92) {
                store8(buf + pos, 92);
                store8(buf + pos + 1, 92);
                pos = pos + 2;
            } else {
                if (c == 10) {
                    store8(buf + pos, 92);
                    store8(buf + pos + 1, 110);
                    pos = pos + 2;
                } else {
                    if (c == 13) {
                        store8(buf + pos, 92);
                        store8(buf + pos + 1, 114);
                        pos = pos + 2;
                    } else {
                        if (c == 9) {
                            store8(buf + pos, 92);
                            store8(buf + pos + 1, 116);
                            pos = pos + 2;
                        } else {
                            if (c < 32) {
                                pos = _agnosai_telemetry_write_u_escape(buf, pos, c);
                            } else {
                                store8(buf + pos, c);
                                pos = pos + 1;
                            }
                        }
                    }
                }
            }
        }
    }
    return pos;
}

# Write one `\u00XX` escape. Split out because the escape ladder above is
# already at the nesting Cyrius makes comfortable.
fn _agnosai_telemetry_write_u_escape(buf, pos, c): i64 {
    store8(buf + pos, 92);
    store8(buf + pos + 1, 117);
    store8(buf + pos + 2, 48);
    store8(buf + pos + 3, 48);
    # `src/id.cyr`'s, not a second copy — `id` precedes `telemetry` in
    # `src/main.cyr`, and lowercase is what `tracing` emits.
    store8(buf + pos + 4, _agnosai_hex_digit((c / 16) % 16));
    store8(buf + pos + 5, _agnosai_hex_digit(c % 16));
    return pos + 6;
}

# Copy a NUL-free literal into `buf` at `pos`. Returns the new pos.
fn _agnosai_telemetry_write_lit(buf, pos, s): i64 {
    var n = strlen(s);
    for (var i = 0; i < n; i = i + 1) { store8(buf + pos + i, load8(s + i)); }
    return pos + n;
}

# The level name as `tracing` spells it.
#
# ⚠ `SK_FATAL` has **no `tracing` counterpart** — its levels stop at ERROR. It
# is emitted as `FATAL` rather than folded into ERROR, because collapsing it
# would make a process-ending event indistinguishable from a handled one.
fn _agnosai_telemetry_level_name(level): i64 {
    if (level == SK_FATAL) { return "FATAL"; }
    if (level == SK_ERROR) { return "ERROR"; }
    if (level == SK_WARN) { return "WARN"; }
    if (level == SK_INFO) { return "INFO"; }
    if (level == SK_DEBUG) { return "DEBUG"; }
    if (level == SK_TRACE) { return "TRACE"; }
    return "UNKNOWN";
}

# The `target` every line carries.
#
# ⚠ `tracing` derives `target` from the emitting **module path**
# (`agnosai::server::serve`), and sakshi has no target concept at all. The crate
# name is what a top-level `tracing::info!` in `main.rs` produces, so top-level
# lines match exactly and nested ones are coarser. Stated, not hidden.
fn agnosai_telemetry_log_target(): i64 {
    return "agnosai";
}

# Append sakshi's fields block as JSON members, each preceded by a comma so it
# slots in after `"message":"..."`. Returns the new pos.
#
# `fields` layout (sakshi 2.4.10): count at offset 0, then 32-byte
# `{key, key_len, val, val_len}` records. 0 means the event carried none.
#
# ⚠ Bounded against `cap` the same way the message is, and it stops on the
# first field that will not fit rather than writing a truncated member — a
# half-written `"key":"va` is unparseable JSON, where a dropped field is merely
# incomplete.
fn _agnosai_telemetry_write_fields(buf, cap, pos, fields): i64 {
    if (fields == 0) { return pos; }
    var n = load64(fields);
    for (var i = 0; i < n; i = i + 1) {
        var rec = fields + 8 + i * 32;
        var klen = load64(rec + 8);
        var vlen = load64(rec + 16 + 8);
        # `,"":""` is 6 bytes of framing; escaping can double each byte.
        if (pos + 6 + klen * 6 + vlen * 6 + 32 > cap) { return pos; }
        pos = _agnosai_telemetry_write_lit(buf, pos, ",\"");
        pos = _agnosai_telemetry_write_escaped(buf, cap - 32, pos, load64(rec), klen);
        pos = _agnosai_telemetry_write_lit(buf, pos, "\":\"");
        pos = _agnosai_telemetry_write_escaped(buf, cap - 32, pos, load64(rec + 16), vlen);
        pos = _agnosai_telemetry_write_lit(buf, pos, "\"");
    }
    return pos;
}

# Render one event as the oracle's JSON line into `buf`, returning its length.
#
# The key order is `tracing_subscriber`'s: timestamp, level, fields, target.
# `fields` is an object because `tracing` nests every event field under it, and
# since sakshi 2.4.10 that is literal rather than aspirational: `fields` carries
# `message` plus one member per `sakshi_log_kv` pair, which is what the oracle's
# subscriber emits.
#
# `fields` is 0 for an event with none, or sakshi's block — see the header.
#
# Split from the hook so it is testable: the hook itself writes to fd 2.
#
# ⚠ The fixed part of the line — prefix, timestamp, level, tail — is at most
# `AGNOSAI_TELEMETRY_MIN_CAP` bytes, and only the *message* is bounded against
# `cap`. A caller passing a smaller buffer would therefore overrun it before
# the first bound is checked, so that case is refused outright rather than
# half-written. Returns 0 for a buffer too small to hold any line at all.
fn agnosai_telemetry_format_json(buf, cap, epoch_ns, level, msg, msg_len): i64 {
    return agnosai_telemetry_format_json_f(buf, cap, epoch_ns, level, msg, msg_len, 0);
}

# The same, plus sakshi's fields block — 0, or `{count}{key,key_len,val,val_len}*`.
#
# ⚠ Each field's value is emitted as a JSON **string**, because sakshi carries
# every value as bytes and has no type tag. `tracing` would render an integer
# field unquoted; that distinction is not recoverable here, and inventing it by
# sniffing digits would mis-type an id like `007` or a version like `1.2.3`.
fn agnosai_telemetry_format_json_f(buf, cap, epoch_ns, level, msg, msg_len, fields): i64 {
    if (cap < AGNOSAI_TELEMETRY_MIN_CAP) { return 0; }
    var pos = _agnosai_telemetry_write_lit(buf, 0, "{\"timestamp\":\"");
    pos = _agnosai_telemetry_write_ts(buf, pos, epoch_ns);
    pos = _agnosai_telemetry_write_lit(buf, pos, "\",\"level\":\"");
    pos = _agnosai_telemetry_write_lit(buf, pos, _agnosai_telemetry_level_name(level));
    pos = _agnosai_telemetry_write_lit(buf, pos, "\",\"fields\":{\"message\":\"");
    # Leave room for the fixed tail plus the closing quote.
    pos = _agnosai_telemetry_write_escaped(buf, cap - 32, pos, msg, msg_len);
    pos = _agnosai_telemetry_write_lit(buf, pos, "\"");
    pos = _agnosai_telemetry_write_fields(buf, cap, pos, fields);
    pos = _agnosai_telemetry_write_lit(buf, pos, "},\"target\":\"");
    pos = _agnosai_telemetry_write_lit(buf, pos, agnosai_telemetry_log_target());
    pos = _agnosai_telemetry_write_lit(buf, pos, "\"}");
    store8(buf + pos, 10);
    return pos + 1;
}

# The sakshi emit hook: format each event as JSON and write it to fd 2.
#
# ⚠ **Span events are dropped.** `fmt::layer().json()` emits nothing on span
# enter/exit unless `with_span_events` is configured, and the oracle does not
# configure it — so forwarding sakshi's `SK_SPAN_ENTER` / `SK_SPAN_EXIT` would
# add lines the oracle never produces.
#
# ⚠ `ts` and `elapsed_ns` are unused: see the module header on the two clocks.
#
# One `write(2)` per line, matching sakshi's own stderr path
# (`lib/sakshi.cyr:604`) — the best interleaving guarantee available to a
# multi-threaded writer, and no worse than what it replaces.
fn _agnosai_telemetry_json_hook(ts, level, category, msg, msg_len, sixth): i64 {
    if (level == SK_SPAN_ENTER) { return 0; }
    if (level == SK_SPAN_EXIT) { return 0; }
    var buf[4096];
    var n = agnosai_telemetry_format_json_f(&buf, AGNOSAI_TELEMETRY_LINE_CAP,
      clock_epoch_ns(), level, msg, msg_len, sixth);
    # The return is ignored, as sakshi's own stderr writer does
    # (`lib/sakshi.cyr:610`). At `PIPE_BUF` or less this cannot short-write to a
    # pipe, which is the case that matters.
    syscall(SYS_WRITE, 2, &buf, n);
    return 0;
}

# Route sakshi through the JSON formatter. Idempotent.
fn agnosai_telemetry_init_json_logging(): i64 {
    _agnosai_telemetry_init_mdays();
    sakshi_set_emit_hook(&_agnosai_telemetry_json_hook);
    return 0;
}

# --- TracingGuard --------------------------------------------------------

# TracingGuard heap layout — 16 bytes.
enum AgnosaiTracingGuardOff {
    # 1 when OTLP export is running, the oracle's `Some(OtelGuard)`.
    AGN_TG_OTEL = 0;
    AGN_TG_SERVICE_NAME = 8;
    # The live exporter, or 0. The oracle's `OtelGuard` itself.
    AGN_TG_EXPORTER = 16;
    AGN_TG_SIZE = 24;
}

# Whether this guard holds a live OTLP exporter.
fn agnosai_tracing_guard_otel_active(g): i64 {
    return load64(g + AGN_TG_OTEL);
}

# The service name the guard was initialised with.
fn agnosai_tracing_guard_service_name(g): i64 {
    return load64(g + AGN_TG_SERVICE_NAME);
}

# Initialise logging, and OTLP export when `otlp_endpoint` is non-zero.
#
# ⚠ **stderr is JSON only when OTLP is OFF.** The oracle's OTLP branch builds
# `fmt::layer().with_writer(stderr)` — the *text* formatter — and only its
# non-OTLP branch calls `.json()`. So turning OTLP on silently changes the
# stderr format. Reproduced rather than smoothed over: an operator whose log
# shipper parses JSON needs to know that enabling the collector breaks it.
#
# Returns a guard the caller must keep for the process lifetime.
fn agnosai_telemetry_init_tracing(otlp_endpoint): i64 {
    var service_name = agnosai_telemetry_service_name();

    # Here — unlike `main`'s path — a set RUST_LOG replaces the default.
    var lvl = agnosai_telemetry_env_filter_level();
    if (lvl < 0) { lvl = SK_INFO; }
    sakshi_set_level(lvl);

    var g = alloc(AGN_TG_SIZE);
    store64(g + AGN_TG_SERVICE_NAME, service_name);
    store64(g + AGN_TG_EXPORTER, 0);

    if (otlp_endpoint == 0) {
        agnosai_telemetry_init_json_logging();
        store64(g + AGN_TG_OTEL, 0);
        return g;
    }

    # Text stderr, as the oracle's OTLP branch uses.
    sakshi_clear_emit_hook();
    var exporter = agnosai_otlp_exporter_new(otlp_endpoint, service_name,
      AGNOSAI_OTLP_BATCH_MS);
    agnosai_otlp_exporter_start(exporter);
    store64(g + AGN_TG_EXPORTER, exporter);
    _agnosai_telemetry_exporter = exporter;
    store64(g + AGN_TG_OTEL, 1);
    # ⚠ **The oracle logs `endpoint` and `service_name` as structured fields**,
    # and the port emitted the bare message — so the JSON line its own formatter
    # produces carried neither key, and an operator diagnosing a collector that
    # is not receiving spans could not see which endpoint was actually used.
    # sakshi carries one key/value per record, so both are packed into one.
    _agnosai_telemetry_init_log(otlp_endpoint, service_name);
    return g;
}

fn _agnosai_telemetry_init_log(endpoint: Str, service_name: Str): i64 {
    if (sakshi_get_level() < SK_INFO) { return 0; }
    var sb = str_builder_new();
    str_builder_add(sb, endpoint);
    str_builder_add_cstr(sb, " service_name=");
    str_builder_add(sb, service_name);
    var line = str_builder_build(sb);
    sakshi_log_kv(SK_INFO, "OpenTelemetry OTLP export initialised", 37, "endpoint", 8,
      str_data(line), str_len(line));
    return 0;
}

# The guard's live exporter, or 0 when OTLP is off. This is what a caller
# enqueues spans into — `agnosai_otlp_exporter_ring(..)` gives it the ring.
fn agnosai_tracing_guard_exporter(g): i64 {
    return load64(g + AGN_TG_EXPORTER);
}

# The process-wide exporter, or 0 when OTLP is off.
#
# ⚠ A **global**, deliberately, and it mirrors the oracle: `tracing`'s
# subscriber is installed with `set_global_default` and every `info_span!` in a
# Rust program reaches it without being threaded through anything. The span call
# sites here — `llm/hoosh`, `tools/native`, `orchestrator/crew_runner` — are
# deep in the tree, and threading an exporter handle from `main` down to each
# would be a far larger and less faithful change than one global set at init.
#
# See ADR 017 for why those call sites exist at all: the oracle defines the
# genai span helpers and never calls them, and this port must.
var _agnosai_telemetry_exporter = 0;

# The exporter every span call site enqueues into, or 0 when OTLP is off.
#
# Callers must treat 0 as "telemetry disabled, do nothing" — it is the normal
# state, not an error.
fn agnosai_telemetry_exporter(): i64 {
    return _agnosai_telemetry_exporter;
}

# Flush and stop the exporter. The oracle's `Drop`, which Cyrius has no
# equivalent for, so the caller runs it — `main` does, on the shutdown path.
fn agnosai_telemetry_shutdown(g): i64 {
    if (load64(g + AGN_TG_OTEL) == 0) { return 0; }
    var e = load64(g + AGN_TG_EXPORTER);
    # ⚠ Stop BEFORE clearing the flag, so the final flush actually runs. The
    # oracle's guard flushes pending spans on drop; the last interval's batch is
    # the one most likely to explain the shutdown, and losing it is the whole
    # reason `Drop` exists there.
    if (e != 0) { agnosai_otlp_exporter_stop(e); }
    store64(g + AGN_TG_OTEL, 0);
    store64(g + AGN_TG_EXPORTER, 0);
    # ⚠ Clear the global too, or a span created during shutdown enqueues into a
    # stopped exporter and is never drained.
    _agnosai_telemetry_exporter = 0;
    return 0;
}

# --- the span call sites' entry point ------------------------------------

# Record a finished genai span, if telemetry is on. Returns 1 if it was queued.
#
# The single call every span site uses, so instrumenting a call path is two
# lines — build the span, then hand it here with its timing — rather than
# twenty of exporter lookup, identity minting and context construction. See
# ADR 017.
#
# ⚠ **Identity is minted per span, not read from sakshi.** sakshi's trace id is
# a process global and two concurrent requests would share it; a fresh
# `agnosai_uuid_v4` per span is 128 random bits, which is exactly a trace id.
# The cost is that spans do not correlate into one trace yet — see ADR 017 and
# the roadmap's OpenTelemetry-library note, where the thread-local current-span
# that would fix it belongs.
#
# ⚠ Returns 0 immediately when OTLP is off, which is the common case. Nothing
# above this line allocates in that path.
fn agnosai_telemetry_record_span(span, start_ns, end_ns, status): i64 {
    var e = agnosai_telemetry_exporter();
    if (e == 0) { return 0; }
    var u = agnosai_uuid_v4();
    var ctx = agnosai_otlp_ctx_new(load64(u), load64(u + 8), load64(u),
      start_ns, end_ns, status);
    return agnosai_otlp_ring_enqueue(agnosai_otlp_exporter_ring(e), span, ctx);
}

# `AGNOSAI_OTLP_STATUS_OK` when `ok` is 1, else ERROR — the mapping every call
# site needs and none should re-derive.
fn agnosai_telemetry_status_of(ok): i64 {
    if (ok == 1) { return AGNOSAI_OTLP_STATUS_OK; }
    return AGNOSAI_OTLP_STATUS_ERROR;
}

# --- error.cyr ---

# =========================================================================
# core/error — the top-level AgnosAI error type.
#
# Origin: rust-old/src/core/error.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * `thiserror`'s derived `Display` becomes `agnosai_error_message`, which
#     builds the same text. The strings are log- and wire-visible, so they are
#     held byte-for-byte to the oracle's `#[error("...")]` attributes.
#   * The `#[from]` conversions for `serde_json::Error` and `std::io::Error`
#     become explicit constructors taking the already-rendered detail string:
#     Cyrius has no trait-based conversion, and both foreign errors reach us as
#     text anyway (bayan's parse error, the syscall errno).
#   * `Timeout(Duration)` carries an i64 **nanosecond** count, matching the
#     representation learning_profile established. Its rendering reproduces
#     Rust's `Duration` `Debug` output — see `_agnosai_fmt_duration_debug`.
#   * `Result<T, AgnosaiError>` has no direct analogue here. Callers return 0
#     for "no error" or an error pointer; the stdlib `Result`/`?` machinery
#     stays available for the modules that want it.
# =========================================================================

# Error kinds, in the oracle's declaration order.
enum AgnosaiErrorKind {
    AGNOSAI_ERR_AGENT_NOT_FOUND = 0;
    AGNOSAI_ERR_TASK_NOT_FOUND = 1;
    AGNOSAI_ERR_CREW_NOT_FOUND = 2;
    AGNOSAI_ERR_INVALID_DEFINITION = 3;
    AGNOSAI_ERR_CYCLIC_DAG = 4;
    AGNOSAI_ERR_SCHEDULING = 5;
    AGNOSAI_ERR_LLM_PROVIDER = 6;
    AGNOSAI_ERR_TOOL_EXECUTION = 7;
    AGNOSAI_ERR_SANDBOX = 8;
    AGNOSAI_ERR_FLEET = 9;
    AGNOSAI_ERR_IPC = 10;
    AGNOSAI_ERR_SERIALIZATION = 11;
    AGNOSAI_ERR_IO = 12;
    AGNOSAI_ERR_TIMEOUT = 13;
    AGNOSAI_ERR_OTHER = 14;
}

# AgnosaiError heap layout — 24 bytes.
# `detail` carries the String payload every variant but CyclicDAG and Timeout
# has; `timeout_ns` carries Timeout's Duration.
enum AgnosaiErrorOff {
    AGN_ERR_KIND = 0;
    AGN_ERR_DETAIL = 8;
    AGN_ERR_TIMEOUT_NS = 16;
    AGN_ERR_SIZE = 24;
}

# Allocate an error of `kind` carrying `detail`. `detail` may be 0 for the
# variants that have no String payload.
fn _agnosai_error_new(kind, detail: Str): i64 {
    var e = alloc(AGN_ERR_SIZE);
    store64(e + AGN_ERR_KIND, kind);
    store64(e + AGN_ERR_DETAIL, detail);
    store64(e + AGN_ERR_TIMEOUT_NS, 0);
    return e;
}

# Append `value` to `sb` with `frac_digits` of fractional part, trailing zeros
# trimmed and the point omitted entirely when the fraction is zero. This is the
# shape Rust's `Duration` Debug uses to turn 1_500_000_000 ns into "1.5s" and
# 30_000_000_000 ns into "30s" rather than "30.000000000s".
fn _agnosai_append_fract(sb, fract, frac_digits): i64 {
    if (fract == 0) { return 0; }

    # Render the fraction zero-padded to frac_digits, then trim the tail.
    var digits[24];
    var n = fract;
    for (var i = frac_digits - 1; i >= 0; i = i - 1) {
        store8(&digits + i, 48 + (n % 10));
        n = n / 10;
    }
    var last = frac_digits - 1;
    while (last >= 0) {
        if (load8(&digits + last) != 48) { break; }
        last = last - 1;
    }
    if (last < 0) { return 0; }

    str_builder_putc(sb, 46);
    for (var j = 0; j <= last; j = j + 1) {
        str_builder_putc(sb, load8(&digits + j));
    }
    return 0;
}

# Render `ns` the way Rust's `Duration` `Debug` does: the largest unit whose
# integer part is non-zero, with a trimmed fractional tail. 30_000_000_000 ->
# "30s", 1_500_000_000 -> "1.5s", 100_000_000 -> "100ms", 1_500 -> "1.5µs",
# 100 -> "100ns".
fn _agnosai_fmt_duration_debug(sb, ns): i64 {
    if (ns >= AGNOSAI_NS_PER_SEC) {
        str_builder_add_int(sb, ns / AGNOSAI_NS_PER_SEC);
        _agnosai_append_fract(sb, ns % AGNOSAI_NS_PER_SEC, 9);
        str_builder_add_cstr(sb, "s");
        return 0;
    }
    if (ns >= AGNOSAI_NS_PER_MS) {
        str_builder_add_int(sb, ns / AGNOSAI_NS_PER_MS);
        _agnosai_append_fract(sb, ns % AGNOSAI_NS_PER_MS, 6);
        str_builder_add_cstr(sb, "ms");
        return 0;
    }
    if (ns >= AGNOSAI_NS_PER_US) {
        str_builder_add_int(sb, ns / AGNOSAI_NS_PER_US);
        _agnosai_append_fract(sb, ns % AGNOSAI_NS_PER_US, 3);
        str_builder_add_cstr(sb, "\u{b5}s");
        return 0;
    }
    str_builder_add_int(sb, ns);
    str_builder_add_cstr(sb, "ns");
    return 0;
}

# The `#[error("...")]` prefix for a kind, including its trailing ": " where
# the oracle has one. CyclicDAG and Other render without a detail, so they
# return their whole text and 0 respectively.
fn _agnosai_error_prefix(kind): i64 {
    if (kind == AGNOSAI_ERR_AGENT_NOT_FOUND) { return str_from("agent not found: "); }
    if (kind == AGNOSAI_ERR_TASK_NOT_FOUND) { return str_from("task not found: "); }
    if (kind == AGNOSAI_ERR_CREW_NOT_FOUND) { return str_from("crew not found: "); }
    if (kind == AGNOSAI_ERR_INVALID_DEFINITION) { return str_from("invalid definition: "); }
    if (kind == AGNOSAI_ERR_CYCLIC_DAG) { return str_from("task DAG contains a cycle"); }
    if (kind == AGNOSAI_ERR_SCHEDULING) { return str_from("scheduling error: "); }
    if (kind == AGNOSAI_ERR_LLM_PROVIDER) { return str_from("LLM provider error: "); }
    if (kind == AGNOSAI_ERR_TOOL_EXECUTION) { return str_from("tool execution error: "); }
    if (kind == AGNOSAI_ERR_SANDBOX) { return str_from("sandbox error: "); }
    if (kind == AGNOSAI_ERR_FLEET) { return str_from("fleet error: "); }
    if (kind == AGNOSAI_ERR_IPC) { return str_from("IPC error: "); }
    if (kind == AGNOSAI_ERR_SERIALIZATION) { return str_from("serialization error: "); }
    if (kind == AGNOSAI_ERR_IO) { return str_from("I/O error: "); }
    if (kind == AGNOSAI_ERR_TIMEOUT) { return str_from("timeout after "); }
    return str_from("");
}

# The requested agent was not found.
fn agnosai_error_agent_not_found(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_AGENT_NOT_FOUND, detail);
}

# The requested task was not found.
fn agnosai_error_task_not_found(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_TASK_NOT_FOUND, detail);
}

# The requested crew was not found.
fn agnosai_error_crew_not_found(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_CREW_NOT_FOUND, detail);
}

# An agent or crew definition failed validation.
fn agnosai_error_invalid_definition(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_INVALID_DEFINITION, detail);
}

# The task dependency graph contains a cycle. Carries no detail.
fn agnosai_error_cyclic_dag(): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_CYCLIC_DAG, 0);
}

# An error occurred during task scheduling.
fn agnosai_error_scheduling(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_SCHEDULING, detail);
}

# An LLM provider returned an error.
fn agnosai_error_llm_provider(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_LLM_PROVIDER, detail);
}

# A tool failed during execution.
fn agnosai_error_tool_execution(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_TOOL_EXECUTION, detail);
}

# A sandbox operation failed.
fn agnosai_error_sandbox(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_SANDBOX, detail);
}

# A fleet/cluster operation failed.
fn agnosai_error_fleet(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_FLEET, detail);
}

# An inter-process communication error.
fn agnosai_error_ipc(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_IPC, detail);
}

# JSON serialization or deserialization failed. Replaces the oracle's
# `#[from] serde_json::Error`; pass the already-rendered parser message.
fn agnosai_error_serialization(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_SERIALIZATION, detail);
}

# An I/O operation failed. Replaces the oracle's `#[from] std::io::Error`;
# pass the already-rendered errno message.
fn agnosai_error_io(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_IO, detail);
}

# An operation exceeded its time limit, after `ns` nanoseconds.
fn agnosai_error_timeout(ns): i64 {
    var e = _agnosai_error_new(AGNOSAI_ERR_TIMEOUT, 0);
    store64(e + AGN_ERR_TIMEOUT_NS, ns);
    return e;
}

# Catch-all for errors that don't fit other variants. Renders as the bare
# detail, with no prefix.
fn agnosai_error_other(detail: Str): i64 {
    return _agnosai_error_new(AGNOSAI_ERR_OTHER, detail);
}

# Which variant this error is.
fn agnosai_error_kind(e): i64 {
    return load64(e + AGN_ERR_KIND);
}

# The String payload, or 0 for the variants that carry none.
fn agnosai_error_detail(e): i64 {
    return load64(e + AGN_ERR_DETAIL);
}

# The timeout duration in nanoseconds. 0 for every kind but Timeout.
fn agnosai_error_timeout_ns(e): i64 {
    return load64(e + AGN_ERR_TIMEOUT_NS);
}

# The rendered error text — the oracle's `Display`.
fn agnosai_error_message(e): i64 {
    var kind = load64(e + AGN_ERR_KIND);
    var sb = str_builder_new();
    str_builder_add(sb, _agnosai_error_prefix(kind));

    if (kind == AGNOSAI_ERR_TIMEOUT) {
        _agnosai_fmt_duration_debug(sb, load64(e + AGN_ERR_TIMEOUT_NS));
        return str_builder_build(sb);
    }

    var detail = load64(e + AGN_ERR_DETAIL);
    if (detail != 0) { str_builder_add(sb, detail); }
    return str_builder_build(sb);
}

# --- json.cyr ---

# =========================================================================
# core/json — shared JSON field helpers for the core group.
#
# No oracle module. The Rust side gets these from serde derives; Cyrius has to
# spell them out, and by the third module needing them (task, resource, agent)
# the duplication had earned an extraction.
#
# Everything here is `_`-prefixed except the shared sentinel, so these stay out
# of the coverage denominator — they are plumbing, exercised through the
# modules that use them.
#
# Two bayan API hazards these encapsulate, both easy to get wrong:
#   * `bayan_json_v_obj_set` takes a **Str** key; `bayan_json_v_obj_get` takes
#     a **C string**. Mixing them up reads a Str header as text, or text as a
#     pointer — a segfault, not a clean error.
#   * A `_str`-suffixed name is a reserved overload slot (see the bayan 1.3.0
#     note in core_message.cyr), so nothing here is named `X_str`.
# =========================================================================

# The shared "absent" sentinel for optional numeric fields across core. Every
# such field is a non-negative count, limit or amount, so -1 is unambiguous and
# keeps the structs allocation-free where a tagged Option would not.
var AGNOSAI_NO_LIMIT = 0 - 1;

# --- Hoisted wire vocabulary ------------------------------------------------
#
# The enum spellings and object keys that more than one core serialiser emits,
# minted **once at startup** instead of once per serialisation.
#
# Measured, not assumed. `alloc_via` costs 15.1 ns whatever it is handed, so a
# `str_from_a(a, "completed")` inside a per-item loop costs one allocation per
# item on top of the JSON node it wraps. `GET /crews/{id}` makes 62 allocations
# and `GET /api/v1/dashboard/crews` makes 160; the literals reached from a loop
# body were a measurable share of both.
#
# **This is not the constant-return hoist state.md declines.** That proposal was
# 149 sites judged on *bytes* — 2.5% — against 121 new symbols. These are judged
# on *time*, and only where `benches/server.bcyr` shows the path is hot. The
# error-arm literals beside them stay as they are: a 400's message is built at
# most once per request, and only for a request that already failed.
#
# They live **here** rather than beside their serialisers because Cyrius resolves
# in a single pass and `core/json.cyr` is the first of the group's includes —
# `task`, `agent` and `crew` all spell the same statuses, and a global defined in
# any one of them would be invisible to the ones included earlier. One literal,
# one `Str`, one place to look.
#
# Safe to share: nothing mutates a wire string. Every consumer either `str_eq`s
# it or wraps it in a JSON value, and a process-lifetime `Str` is strictly safer
# than an arena one — it cannot dangle when the arena resets.
var AGN_JV_PENDING = str_from("pending");
var AGN_JV_QUEUED = str_from("queued");
var AGN_JV_RUNNING = str_from("running");
var AGN_JV_COMPLETED = str_from("completed");
var AGN_JV_FAILED = str_from("failed");
var AGN_JV_CANCELLED = str_from("cancelled");
var AGN_JV_IDLE = str_from("idle");
var AGN_JV_ASSIGNED = str_from("assigned");
var AGN_JV_WORKING = str_from("working");
var AGN_JV_BLOCKED = str_from("blocked");

var AGN_JK_ID = str_from("id");
var AGN_JK_NAME = str_from("name");
var AGN_JK_TASKS = str_from("tasks");
var AGN_JK_PROCESS = str_from("process");

# An Option<String> as a JSON value: the string, or null when unset.
#
# **The `_a` form is the real body throughout this file; the bare name delegates
# with `default_alloc()`.** bayan 1.4.0 (cyrius 6.5.5) completed the `_a` JSON
# surface, so a caller holding a per-request arena can now build a whole
# response tree on it — before that, every cell landed on the no-free global
# bump and stayed there for the life of the process.
fn _agnosai_opt_str_to_value_a(a, s): i64 {
    if (s == 0) { return bayan_json_v_null_a(a); }
    return bayan_json_v_str_new_a(a, s);
}

fn _agnosai_opt_str_to_value(s): i64 {
    return _agnosai_opt_str_to_value_a(default_alloc(), s);
}

# An optional count as a JSON value: the integer, or null when unset.
fn _agnosai_opt_int_to_value_a(a, n): i64 {
    if (n == AGNOSAI_NO_LIMIT) { return bayan_json_v_null_a(a); }
    return bayan_json_v_int_new_a(a, n);
}

fn _agnosai_opt_int_to_value(n): i64 {
    return _agnosai_opt_int_to_value_a(default_alloc(), n);
}

# Read an integer field, falling back to `fallback` when missing or non-integer.
fn _agnosai_int_field(v, key, fallback): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return fallback; }
    if (bayan_json_v_is_int(f) == 0) { return fallback; }
    return bayan_json_v_int(f);
}

# Read an optional count, mapping a missing or null field to AGNOSAI_NO_LIMIT.
fn _agnosai_opt_int_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return AGNOSAI_NO_LIMIT; }
    if (bayan_json_v_is_int(f) == 0) { return AGNOSAI_NO_LIMIT; }
    return bayan_json_v_int(f);
}

# A bool as the JSON literal serde emits.
fn _agnosai_bool_to_value_a(a, b): i64 {
    if (b == 1) { return bayan_json_v_bool_new_a(a, 1); }
    return bayan_json_v_bool_new_a(a, 0);
}

fn _agnosai_bool_to_value(b): i64 {
    return _agnosai_bool_to_value_a(default_alloc(), b);
}

# Read a bool field, defaulting to 0 when missing or non-bool.
fn _agnosai_bool_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (bayan_json_v_is_bool(f) == 0) { return 0; }
    return bayan_json_v_bool(f);
}

# Read a Str field, or 0 when missing or non-string.
fn _agnosai_str_field(v, key): i64 {
    var f = bayan_json_v_obj_get(v, key);
    if (f == 0) { return 0; }
    if (bayan_json_v_is_str(f) == 0) { return 0; }
    return bayan_json_v_str(f);
}

# Serialize a Str-keyed map of JSON values into a bayan object.
#
# The VALUES are borrowed from the map, not copied — they are already JSON
# values. Only the object shell and its pair cells come from `a`, so a caller
# arena-ing this must not `reset_via` while the source map is still live.
# Number of SLOTS in a Str/cstr-keyed map — the walk bound, not the entry count.
#
# `map_keys` is the obvious way to iterate a map and it is wrong on an arena
# path: it materialises a key vec through `vec_new()` on the no-free GLOBAL bump
# and has no `_a` form to thread. Walking slots avoids the vec entirely, so it is
# both allocation-free and cheaper.
#
# These three wrap the **documented public layout** (`lib/hashmap.cyr:22-35`) —
# header `{entries_ptr, capacity, count, key_type}`, slot `{key_ptr, value,
# state}` at 24 bytes, `state == 1` occupied. They exist rather than being
# inlined at each call site because that layout belongs to **another module**: if
# hashmap ever changes its slot size, one wrong constant here is a silent
# mis-read, and it should have exactly one place to be wrong.
#
# **key_type 2 (u64) is a different, 16-byte slot with no state field.** The
# hashmap header says `map_keys` / `map_values` / `map_iter` do not work on it
# either; `_agnosai_map_slots` returns 0 for it so every walk is empty rather
# than reading values as states.
fn _agnosai_map_slots(m): i64 {
    if (load64(m + 24) == 2) { return 0; }
    return load64(m + 8);
}

# Is slot `i` occupied?
fn _agnosai_map_slot_live(m, i): i64 {
    if (load64(load64(m) + i * 24 + 16) == 1) { return 1; }
    return 0;
}

# The key Str at slot `i`. Only meaningful when `_agnosai_map_slot_live` is 1.
fn _agnosai_map_slot_key(m, i): i64 { return load64(load64(m) + i * 24); }

# The value at slot `i`. Only meaningful when `_agnosai_map_slot_live` is 1.
fn _agnosai_map_slot_val(m, i): i64 { return load64(load64(m) + i * 24 + 8); }

fn _agnosai_map_to_value_a(a, m): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    var n = _agnosai_map_slots(m);
    # **Stop once every live entry is out.** A slot walk is over *capacity*, not
    # size, and `map_new_str` starts at 16 — a task result's metadata is
    # typically one or two entries, so the loop was scanning 16 slots to emit
    # one. Measured at 195 ns for a single-entry map.
    var live = map_size(m);
    var emitted = 0;
    for (var i = 0; i < n && emitted < live; i = i + 1) {
        if (_agnosai_map_slot_live(m, i) == 1) {
            bayan_json_v_obj_set_a(a, obj, _agnosai_map_slot_key(m, i),
              _agnosai_map_slot_val(m, i));
            emitted = emitted + 1;
        }
    }
    return obj;
}

fn _agnosai_map_to_value(m): i64 {
    return _agnosai_map_to_value_a(default_alloc(), m);
}

# Rebuild a Str-keyed map of JSON values from a bayan object. A missing or
# non-object value yields an empty map, matching `#[serde(default)]`.
fn _agnosai_map_from_value(v): i64 {
    var m = map_new_str();
    if (v == 0) { return m; }
    if (bayan_json_v_is_obj(v) == 0) { return m; }
    for (var i = 0; i < bayan_json_v_obj_len(v); i = i + 1) {
        map_set(m, str_clone(bayan_json_v_obj_key(v, i)), bayan_json_v_obj_val(v, i));
    }
    return m;
}

# Serialize a vec of Str into a JSON array.
fn _agnosai_str_vec_to_value_a(a, v): i64 {
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(v); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, bayan_json_v_str_new_a(a, vec_get(v, i)));
    }
    return arr;
}

fn _agnosai_str_vec_to_value(v): i64 {
    return _agnosai_str_vec_to_value_a(default_alloc(), v);
}

# Append every string element of a JSON array onto `dst`. A missing or
# non-array value appends nothing, matching `#[serde(default)]`.
fn _agnosai_str_vec_from_value(dst, v): i64 {
    if (v == 0) { return dst; }
    if (bayan_json_v_is_arr(v) == 0) { return dst; }
    for (var i = 0; i < bayan_json_v_arr_len(v); i = i + 1) {
        var e = bayan_json_v_arr_get(v, i);
        if (bayan_json_v_is_str(e) == 1) { vec_push(dst, bayan_json_v_str(e)); }
    }
    return dst;
}

# --- message.cyr ---

# =========================================================================
# core/message — inter-agent messaging.
#
# Origin: rust-old/src/core/message.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * `serde_json::Value` becomes a bayan JSON value tree (`bayan_json_v_*`) —
#     the same shape, built and serialized through bayan rather than serde.
#   * `Uuid` becomes a 16-byte buffer from src/id.cyr (`AgentId` is a Uuid in
#     the oracle, so `from` is one too).
#   * `chrono::DateTime<Utc>` becomes an i64 **nanosecond** epoch count. The
#     wire form is held to chrono's serde output exactly — RFC3339 with
#     `SecondsFormat::AutoSi`, which emits 0, 3, 6 or 9 fractional digits
#     depending on what is non-zero. `lib/chrono.cyr`'s `iso8601` is
#     second-precision only, so the fraction is spliced in here; without it a
#     `Utc::now()` timestamp would not survive a round trip.
#
# The JSON field order matches serde's, which emits struct fields in
# declaration order — bayan's object preserves insertion order, so the emitted
# bytes line up with the oracle's.
# =========================================================================

# Where a message should be delivered. Values are the oracle's declaration
# order; the wire names are its `rename_all = "snake_case"` spellings.
enum AgnosaiMessageTargetKind {
    AGNOSAI_TARGET_AGENT = 0;
    AGNOSAI_TARGET_TOPIC = 1;
    AGNOSAI_TARGET_BROADCAST = 2;
}

# MessageTarget heap layout — 24 bytes.
enum AgnosaiMessageTargetOff {
    AGN_TGT_KIND = 0;
    AGN_TGT_AGENT = 8;
    AGN_TGT_TOPIC = 16;
    AGN_TGT_SIZE = 24;
}

# Message heap layout — 40 bytes.
enum AgnosaiMessageOff {
    AGN_MSG_ID = 0;
    AGN_MSG_FROM = 8;
    AGN_MSG_TO = 16;
    AGN_MSG_PAYLOAD = 24;
    AGN_MSG_TIMESTAMP_NS = 32;
    AGN_MSG_SIZE = 40;
}

# Send to a specific agent by ID.
fn agnosai_message_target_agent(agent_id): i64 {
    var t = alloc(AGN_TGT_SIZE);
    store64(t + AGN_TGT_KIND, AGNOSAI_TARGET_AGENT);
    store64(t + AGN_TGT_AGENT, agent_id);
    store64(t + AGN_TGT_TOPIC, 0);
    return t;
}

# Publish to a named topic.
fn agnosai_message_target_topic(topic: Str): i64 {
    var t = alloc(AGN_TGT_SIZE);
    store64(t + AGN_TGT_KIND, AGNOSAI_TARGET_TOPIC);
    store64(t + AGN_TGT_AGENT, 0);
    store64(t + AGN_TGT_TOPIC, topic);
    return t;
}

# Send to all agents.
fn agnosai_message_target_broadcast(): i64 {
    var t = alloc(AGN_TGT_SIZE);
    store64(t + AGN_TGT_KIND, AGNOSAI_TARGET_BROADCAST);
    store64(t + AGN_TGT_AGENT, 0);
    store64(t + AGN_TGT_TOPIC, 0);
    return t;
}

# Which variant a target is.
fn agnosai_message_target_kind(t): i64 {
    return load64(t + AGN_TGT_KIND);
}

# The destination agent id, or 0 unless this is an Agent target.
fn agnosai_message_target_agent_id(t): i64 {
    return load64(t + AGN_TGT_AGENT);
}

# The destination topic, or 0 unless this is a Topic target.
fn agnosai_message_target_topic_name(t): i64 {
    return load64(t + AGN_TGT_TOPIC);
}

# A target as a bayan JSON value, in serde's externally-tagged form:
# `{"agent":"<uuid>"}`, `{"topic":"<name>"}`, or the bare string `"broadcast"`.
fn agnosai_message_target_to_value_a(a, t): i64 {
    var kind = load64(t + AGN_TGT_KIND);
    if (kind == AGNOSAI_TARGET_BROADCAST) {
        return bayan_json_v_str_new_a(a, str_from_a(a, "broadcast"));
    }
    var obj = bayan_json_v_obj_new_a(a);
    if (kind == AGNOSAI_TARGET_AGENT) {
        var id_str = load64(t + AGN_TGT_AGENT);
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "agent"), bayan_json_v_str_new_a(a, id_str));
        return obj;
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "topic"), bayan_json_v_str_new_a(a, load64(t + AGN_TGT_TOPIC)));
    return obj;
}

# Global-allocator form of `agnosai_message_target_to_value_a`.
fn agnosai_message_target_to_value(t): i64 {
    return agnosai_message_target_to_value_a(default_alloc(), t);
}

# Rebuild a target from its JSON value. Returns 0 when the value is not one of
# the three known shapes.
fn agnosai_message_target_from_value(v): i64 {
    if (bayan_json_v_is_str(v) == 1) {
        if (str_eq_cstr(bayan_json_v_str(v), "broadcast") == 1) {
            return agnosai_message_target_broadcast();
        }
        return 0;
    }
    if (bayan_json_v_is_obj(v) == 0) { return 0; }

    var agent = bayan_json_v_obj_get(v, "agent");
    if (agent != 0 && bayan_json_v_is_str(agent) == 1) {
        var id = agnosai_uuid_canonical(bayan_json_v_str(agent));
        if (id == 0) { return 0; }
        return agnosai_message_target_agent(id);
    }

    var topic = bayan_json_v_obj_get(v, "topic");
    if (topic != 0 && bayan_json_v_is_str(topic) == 1) {
        return agnosai_message_target_topic(bayan_json_v_str(topic));
    }
    return 0;
}

# Append `fract` nanoseconds as chrono's `SecondsFormat::AutoSi` fraction: an
# empty string when zero, otherwise the fewest of 3, 6 or 9 digits that keeps
# every non-zero digit.
fn _agnosai_msg_append_subsec(sb, fract): i64 {
    if (fract == 0) { return 0; }

    var digits = 9;
    var value = fract;
    if (fract % 1000000 == 0) {
        digits = 3;
        value = fract / 1000000;
    } elif (fract % 1000 == 0) {
        digits = 6;
        value = fract / 1000;
    }

    str_builder_putc(sb, 46);
    var scale = 1;
    for (var i = 1; i < digits; i = i + 1) { scale = scale * 10; }
    while (scale > 0) {
        str_builder_putc(sb, 48 + ((value / scale) % 10));
        scale = scale / 10;
    }
    return 0;
}

# Render epoch nanoseconds the way chrono's serde does: RFC3339, UTC, with an
# AutoSi sub-second fraction. 0 nanos -> "2026-07-28T22:00:00Z".
fn _agnosai_msg_fmt_rfc3339(ns): i64 {
    var secs = ns / AGNOSAI_NS_PER_SEC;
    var fract = ns % AGNOSAI_NS_PER_SEC;
    var base = iso8601(secs);

    var sb = str_builder_new();
    # iso8601 is "....SSZ"; take everything up to the seconds, splice the
    # fraction in, then re-attach the zone.
    str_builder_add(sb, str_new(base, 19));
    _agnosai_msg_append_subsec(sb, fract);
    str_builder_add_cstr(sb, "Z");
    return str_builder_build(sb);
}

# Two ASCII digits at `p` as a number, or -1 if either is not a digit.
fn _agnosai_msg_2digits(p): i64 {
    var a = load8(p);
    var b = load8(p + 1);
    if (a < 48 || a > 57 || b < 48 || b > 57) { return 0 - 1; }
    return (a - 48) * 10 + (b - 48);
}

# Parse an RFC3339 timestamp to epoch nanoseconds, accepting any number of
# fractional digits and a zone of `Z`, `±HH:MM` or none (read as UTC). An offset
# is applied — `02:00:00+02:00` is `00:00:00Z` — where it used to be ignored,
# which made a non-UTC timestamp silently wrong by its offset. Returns -1 when
# the seconds part or the zone is malformed.
fn _agnosai_msg_parse_rfc3339(s: Str): i64 {
    var cstr = str_cstr(s);
    var secs = iso8601_parse(cstr);
    if (secs < 0) { return 0 - 1; }

    var ns = secs * AGNOSAI_NS_PER_SEC;
    var len = str_len(s);
    var i = 19;
    if (i < len && load8(cstr + i) == 46) {
        var fract = 0;
        var scale = AGNOSAI_NS_PER_SEC / 10;
        i = i + 1;
        while (i < len) {
            var c = load8(cstr + i);
            if (c < 48 || c > 57) { break; }
            if (scale > 0) {
                fract = fract + (c - 48) * scale;
                scale = scale / 10;
            }
            i = i + 1;
        }
        ns = ns + fract;
    }

    if (i >= len) { return ns; }
    var z = load8(cstr + i);
    if ((z == 90 || z == 122) && i + 1 == len) { return ns; }
    if (z != 43 && z != 45) { return 0 - 1; }
    if (len - i != 6 || load8(cstr + i + 3) != 58) { return 0 - 1; }
    var hh = _agnosai_msg_2digits(cstr + i + 1);
    var mm = _agnosai_msg_2digits(cstr + i + 4);
    if (hh < 0 || mm < 0 || hh > 23 || mm > 59) { return 0 - 1; }
    var off = (hh * 3600 + mm * 60) * AGNOSAI_NS_PER_SEC;
    if (z == 43) { return ns - off; }
    return ns + off;
}

# Create a new message with an auto-generated v4 id and the current timestamp.
fn agnosai_message_new(from, to, payload): i64 {
    var m = alloc(AGN_MSG_SIZE);
    store64(m + AGN_MSG_ID, agnosai_uuid_v4_str());
    store64(m + AGN_MSG_FROM, from);
    store64(m + AGN_MSG_TO, to);
    store64(m + AGN_MSG_PAYLOAD, payload);
    store64(m + AGN_MSG_TIMESTAMP_NS, clock_epoch_ns());
    return m;
}

# Unique message identifier.
fn agnosai_message_id(m): i64 {
    return load64(m + AGN_MSG_ID);
}

# Sender agent ID.
fn agnosai_message_from(m): i64 {
    return load64(m + AGN_MSG_FROM);
}

# Destination target.
fn agnosai_message_to(m): i64 {
    return load64(m + AGN_MSG_TO);
}

# Arbitrary JSON payload, as a bayan value.
fn agnosai_message_payload(m): i64 {
    return load64(m + AGN_MSG_PAYLOAD);
}

# When the message was created, as nanoseconds since the Unix epoch.
fn agnosai_message_timestamp_ns(m): i64 {
    return load64(m + AGN_MSG_TIMESTAMP_NS);
}

# The message as a bayan JSON value. Field order matches serde's, which emits
# struct fields in declaration order.
fn agnosai_message_to_value_a(a, m): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    var id_str = load64(m + AGN_MSG_ID);
    var from_str = load64(m + AGN_MSG_FROM);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "id"), bayan_json_v_str_new_a(a, id_str));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "from"), bayan_json_v_str_new_a(a, from_str));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "to"), agnosai_message_target_to_value_a(a, load64(m + AGN_MSG_TO)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "payload"), load64(m + AGN_MSG_PAYLOAD));
    var ts = _agnosai_msg_fmt_rfc3339(load64(m + AGN_MSG_TIMESTAMP_NS));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "timestamp"), bayan_json_v_str_new_a(a, ts));
    return obj;
}

# Global-allocator form of `agnosai_message_to_value_a`.
fn agnosai_message_to_value(m): i64 {
    return agnosai_message_to_value_a(default_alloc(), m);
}

# The message serialized to JSON text.
fn agnosai_message_to_json_a(a, m): i64 {
    return bayan_json_v_build_a(a, agnosai_message_to_value_a(a, m));
}

# Global-allocator form of `agnosai_message_to_json_a`.
fn agnosai_message_to_json(m): i64 {
    return agnosai_message_to_json_a(default_alloc(), m);
}

# Rebuild a message from a bayan JSON value. Returns 0 when a required field is
# missing or malformed.
fn agnosai_message_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }

    var id_v = bayan_json_v_obj_get(v, "id");
    var from_v = bayan_json_v_obj_get(v, "from");
    var to_v = bayan_json_v_obj_get(v, "to");
    var ts_v = bayan_json_v_obj_get(v, "timestamp");
    if (id_v == 0 || from_v == 0 || to_v == 0 || ts_v == 0) { return 0; }
    if (bayan_json_v_is_str(id_v) == 0 || bayan_json_v_is_str(from_v) == 0) { return 0; }
    if (bayan_json_v_is_str(ts_v) == 0) { return 0; }

    var id = agnosai_uuid_canonical(bayan_json_v_str(id_v));
    var from = agnosai_uuid_canonical(bayan_json_v_str(from_v));
    var to = agnosai_message_target_from_value(to_v);
    var ts = _agnosai_msg_parse_rfc3339(bayan_json_v_str(ts_v));
    if (id == 0 || from == 0 || to == 0 || ts < 0) { return 0; }

    var payload = bayan_json_v_obj_get(v, "payload");
    if (payload == 0) { payload = bayan_json_v_null(); }

    var m = alloc(AGN_MSG_SIZE);
    store64(m + AGN_MSG_ID, id);
    store64(m + AGN_MSG_FROM, from);
    store64(m + AGN_MSG_TO, to);
    store64(m + AGN_MSG_PAYLOAD, payload);
    store64(m + AGN_MSG_TIMESTAMP_NS, ts);
    return m;
}

# Parse a message from JSON text. Returns 0 on a parse error or a malformed
# message.
#
# Two bayan API hazards are load-bearing here, both verified by probe against
# cyrius 6.4.86:
#
#   1. The key types are asymmetric. `bayan_json_v_obj_get` (used above) takes
#      a **C string**; `bayan_json_v_obj_set` and `bayan_json_v_parse` take a
#      **Str**. Passing the wrong one reads a Str header as text, or text as a
#      pointer — a segfault, not a clean error.
#   2. **`bayan_json_v_parse` is unusable in the vendored bayan.** Cyrius routes
#      a call `X(a, …)` to `X_str` when `a` is Str-typed and `X_str` exists (the
#      same overload dispatch that routes `&IDENT` to `_ptr`). Because the
#      cstr+len form was named `bayan_json_v_parse_buf`, the bare call was
#      rewritten into a 1-arg call to a 2-arg fn and returned 0 for valid JSON.
#      **Fixed upstream in bayan 1.3.0** (cstr+len forms renamed `_str` →
#      `_buf`), but the fold into cyrius has not landed yet, so we still call
#      `bayan_json_v_parse_buf` here. **At the next bayan fold-in, switch this
#      to the bare `bayan_json_v_parse(src)`** — and note `_str` will no longer
#      exist, so this line is a compile error until it is updated.
fn agnosai_message_from_json(src: Str): i64 {
    var v = bayan_json_v_parse_buf(str_data(src), str_len(src));
    if (v == 0) { return 0; }
    return agnosai_message_from_value(v);
}

# --- resource.cyr ---

# =========================================================================
# core/resource — hardware devices, requirements, inventories and budgets.
#
# Origin: rust-old/src/core/resource.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * **Money is integer micro-USD** (user decision, 2026-07-28). The oracle's
#     `max_cost_usd: Option<f64>` becomes an i64 count of millionths of a
#     dollar, so a crew's cost path accumulates exactly with no float drift.
#     Serialization still goes out through an f64 under the *same* wire name
#     `max_cost_usd`, so bayan's Grisu2 emits the shortest round-tripping form —
#     `0.0025`, byte-identical to serde. (The port plan predicted a `0.002500`
#     divergence; routing through f64 only at the boundary avoids it while
#     keeping arithmetic exact.)
#   * `Option<u64>` / `Option<usize>` fields use **-1 for None**. Every one of
#     them is a non-negative count or limit, so the sentinel is unambiguous and
#     keeps these structs allocation-free.
#   * The `#[cfg(feature = "hwaccel")]` half of the oracle is **ported**, at the
#     bottom of this file: `AcceleratorType::from_hwaccel`,
#     `HardwareInventory::detect` / `from_hwaccel`, and `TrainingMemoryEstimate`
#     with its three methods. A cargo feature gate is not a scope boundary, and
#     `[deps.ai-hwaccel]` was already vendored.
#
#     ⚠ The oracle's ten `pub use ai_hwaccel::{...}` **re-exports have no
#     counterpart and need none.** They exist so a Rust caller can name
#     `QuantizationLevel` without depending on ai-hwaccel directly; Cyrius has
#     ONE flat namespace, so `QUANT_FP16`, `TRAIN_LORA`, `est_total_x1000` and
#     the rest are already visible to every consumer. Re-exporting would mean
#     defining duplicate symbols, which is the one thing the flat namespace
#     punishes.
# =========================================================================

# Broad accelerator family for requirement matching.
enum AgnosaiAcceleratorFamily {
    AGNOSAI_FAMILY_CPU = 0;
    AGNOSAI_FAMILY_GPU = 1;
    AGNOSAI_FAMILY_NPU = 2;
    AGNOSAI_FAMILY_TPU = 3;
    AGNOSAI_FAMILY_AI_ASIC = 4;
}

# Hardware accelerator type — the oracle's 6 broad categories.
enum AgnosaiAcceleratorType {
    AGNOSAI_ACCEL_CPU = 0;
    AGNOSAI_ACCEL_CUDA = 1;
    AGNOSAI_ACCEL_ROCM = 2;
    AGNOSAI_ACCEL_METAL = 3;
    AGNOSAI_ACCEL_VULKAN = 4;
    AGNOSAI_ACCEL_TPU = 5;
}

# Micro-USD per whole dollar — the money scale factor.
var AGNOSAI_MICRO_USD_PER_USD = 1000000;

# ComputeDevice heap layout — 40 bytes.
enum AgnosaiComputeDeviceOff {
    AGN_DEV_INDEX = 0;
    AGN_DEV_NAME = 8;
    AGN_DEV_ACCELERATOR = 16;
    AGN_DEV_MEMORY_TOTAL_MB = 24;
    AGN_DEV_MEMORY_AVAILABLE_MB = 32;
    AGN_DEV_SIZE = 40;
}

# HardwareRequirement heap layout — 40 bytes.
enum AgnosaiHwRequirementOff {
    AGN_REQ_ACCELERATORS = 0;
    AGN_REQ_MIN_MEMORY_MB = 8;
    AGN_REQ_MIN_DEVICE_COUNT = 16;
    AGN_REQ_MIN_CPU_CORES = 24;
    AGN_REQ_REQUIRED_FAMILY = 32;
    AGN_HW_REQ_SIZE = 40;
}

# HardwareInventory heap layout — 24 bytes.
enum AgnosaiHwInventoryOff {
    AGN_INV_CPU_CORES = 0;
    AGN_INV_MEMORY_TOTAL_MB = 8;
    AGN_INV_DEVICES = 16;
    AGN_INV_SIZE = 24;
}

# ResourceBudget heap layout — 32 bytes.
enum AgnosaiResourceBudgetOff {
    AGN_BUD_MAX_TOKENS = 0;
    AGN_BUD_MAX_COST_MICRO_USD = 8;
    AGN_BUD_MAX_DURATION_SECS = 16;
    AGN_BUD_MAX_CONCURRENT_TASKS = 24;
    AGN_BUD_SIZE = 32;
}

# GpuDevice heap layout — 32 bytes.
enum AgnosaiGpuDeviceOff {
    AGN_GPU_INDEX = 0;
    AGN_GPU_NAME = 8;
    AGN_GPU_VRAM_TOTAL_MB = 16;
    AGN_GPU_VRAM_AVAILABLE_MB = 24;
    AGN_GPU_SIZE = 32;
}

# The snake_case wire spelling of an accelerator family.
fn agnosai_accelerator_family_to_wire_a(a, family): i64 {
    if (family == AGNOSAI_FAMILY_GPU) { return str_from_a(a, "gpu"); }
    if (family == AGNOSAI_FAMILY_NPU) { return str_from_a(a, "npu"); }
    if (family == AGNOSAI_FAMILY_TPU) { return str_from_a(a, "tpu"); }
    if (family == AGNOSAI_FAMILY_AI_ASIC) { return str_from_a(a, "ai_asic"); }
    return str_from_a(a, "cpu");
}

# Global-allocator form of `agnosai_accelerator_family_to_wire_a`.
fn agnosai_accelerator_family_to_wire(family): i64 {
    return agnosai_accelerator_family_to_wire_a(default_alloc(), family);
}

# An accelerator family from its wire spelling. Unknown spellings read as Cpu.
fn agnosai_accelerator_family_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "gpu") == 1) { return AGNOSAI_FAMILY_GPU; }
    if (str_eq_cstr(s, "npu") == 1) { return AGNOSAI_FAMILY_NPU; }
    if (str_eq_cstr(s, "tpu") == 1) { return AGNOSAI_FAMILY_TPU; }
    if (str_eq_cstr(s, "ai_asic") == 1) { return AGNOSAI_FAMILY_AI_ASIC; }
    return AGNOSAI_FAMILY_CPU;
}

# The snake_case wire spelling of an accelerator type.
fn agnosai_accelerator_type_to_wire_a(a, accel): i64 {
    if (accel == AGNOSAI_ACCEL_CUDA) { return str_from_a(a, "cuda"); }
    if (accel == AGNOSAI_ACCEL_ROCM) { return str_from_a(a, "rocm"); }
    if (accel == AGNOSAI_ACCEL_METAL) { return str_from_a(a, "metal"); }
    if (accel == AGNOSAI_ACCEL_VULKAN) { return str_from_a(a, "vulkan"); }
    if (accel == AGNOSAI_ACCEL_TPU) { return str_from_a(a, "tpu"); }
    return str_from_a(a, "cpu");
}

# Global-allocator form of `agnosai_accelerator_type_to_wire_a`.
fn agnosai_accelerator_type_to_wire(accel): i64 {
    return agnosai_accelerator_type_to_wire_a(default_alloc(), accel);
}

# An accelerator type from its wire spelling. Unknown spellings read as Cpu.
fn agnosai_accelerator_type_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "cuda") == 1) { return AGNOSAI_ACCEL_CUDA; }
    if (str_eq_cstr(s, "rocm") == 1) { return AGNOSAI_ACCEL_ROCM; }
    if (str_eq_cstr(s, "metal") == 1) { return AGNOSAI_ACCEL_METAL; }
    if (str_eq_cstr(s, "vulkan") == 1) { return AGNOSAI_ACCEL_VULKAN; }
    if (str_eq_cstr(s, "tpu") == 1) { return AGNOSAI_ACCEL_TPU; }
    return AGNOSAI_ACCEL_CPU;
}

# Broad family an accelerator belongs to.
fn agnosai_accelerator_family_of(accel): i64 {
    if (accel == AGNOSAI_ACCEL_CPU) { return AGNOSAI_FAMILY_CPU; }
    if (accel == AGNOSAI_ACCEL_TPU) { return AGNOSAI_FAMILY_TPU; }
    return AGNOSAI_FAMILY_GPU;
}

# Whether this is a GPU variant.
fn agnosai_accelerator_is_gpu(accel): i64 {
    if (agnosai_accelerator_family_of(accel) == AGNOSAI_FAMILY_GPU) { return 1; }
    return 0;
}

# Whether this is a TPU variant.
fn agnosai_accelerator_is_tpu(accel): i64 {
    if (agnosai_accelerator_family_of(accel) == AGNOSAI_FAMILY_TPU) { return 1; }
    return 0;
}

# Create a new compute device. Available memory starts equal to total.
fn agnosai_compute_device_new(index, name: Str, accelerator, memory_total_mb): i64 {
    var d = alloc(AGN_DEV_SIZE);
    store64(d + AGN_DEV_INDEX, index);
    store64(d + AGN_DEV_NAME, name);
    store64(d + AGN_DEV_ACCELERATOR, accelerator);
    store64(d + AGN_DEV_MEMORY_TOTAL_MB, memory_total_mb);
    store64(d + AGN_DEV_MEMORY_AVAILABLE_MB, memory_total_mb);
    return d;
}

# Set the device's available memory. Returns the device so calls chain.
fn agnosai_compute_device_with_available(d, memory_available_mb): i64 {
    store64(d + AGN_DEV_MEMORY_AVAILABLE_MB, memory_available_mb);
    return d;
}

# Zero-based device index.
fn agnosai_compute_device_index(d): i64 {
    return load64(d + AGN_DEV_INDEX);
}

# Human-readable device name.
fn agnosai_compute_device_name(d): i64 {
    return load64(d + AGN_DEV_NAME);
}

# Accelerator type of this device.
fn agnosai_compute_device_accelerator(d): i64 {
    return load64(d + AGN_DEV_ACCELERATOR);
}

# Total device memory in megabytes.
fn agnosai_compute_device_memory_total_mb(d): i64 {
    return load64(d + AGN_DEV_MEMORY_TOTAL_MB);
}

# Available (free) device memory in megabytes.
fn agnosai_compute_device_memory_available_mb(d): i64 {
    return load64(d + AGN_DEV_MEMORY_AVAILABLE_MB);
}

# A compute device as a bayan JSON value.
fn agnosai_compute_device_to_value_a(a, d): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "index"), bayan_json_v_int_new_a(a, load64(d + AGN_DEV_INDEX)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "name"), bayan_json_v_str_new_a(a, load64(d + AGN_DEV_NAME)));
    var accel = agnosai_accelerator_type_to_wire_a(a, load64(d + AGN_DEV_ACCELERATOR));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "accelerator"), bayan_json_v_str_new_a(a, accel));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "memory_total_mb"),
      bayan_json_v_int_new_a(a, load64(d + AGN_DEV_MEMORY_TOTAL_MB)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "memory_available_mb"),
      bayan_json_v_int_new_a(a, load64(d + AGN_DEV_MEMORY_AVAILABLE_MB)));
    return obj;
}

# Global-allocator form of `agnosai_compute_device_to_value_a`.
fn agnosai_compute_device_to_value(d): i64 {
    return agnosai_compute_device_to_value_a(default_alloc(), d);
}

# Rebuild a compute device from a bayan JSON value, or 0 when not an object.
fn agnosai_compute_device_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var name = str_from("");
    var nv = bayan_json_v_obj_get(v, "name");
    if (nv != 0 && bayan_json_v_is_str(nv) == 1) { name = bayan_json_v_str(nv); }

    var accel = AGNOSAI_ACCEL_CPU;
    var av = bayan_json_v_obj_get(v, "accelerator");
    if (av != 0 && bayan_json_v_is_str(av) == 1) {
        accel = agnosai_accelerator_type_from_wire(bayan_json_v_str(av));
    }

    var d = agnosai_compute_device_new(_agnosai_int_field(v, "index", 0), name, accel,
      _agnosai_int_field(v, "memory_total_mb", 0));
    store64(d + AGN_DEV_MEMORY_AVAILABLE_MB,
      _agnosai_int_field(v, "memory_available_mb", load64(d + AGN_DEV_MEMORY_TOTAL_MB)));
    return d;
}

# An empty hardware requirement — matches anything, including CPU-only.
fn agnosai_hw_requirement_new_a(a): i64 {
    var r = alloc_via(a, AGN_HW_REQ_SIZE);
    store64(r + AGN_REQ_ACCELERATORS, vec_new_a(a));
    store64(r + AGN_REQ_MIN_MEMORY_MB, 0);
    store64(r + AGN_REQ_MIN_DEVICE_COUNT, 0);
    store64(r + AGN_REQ_MIN_CPU_CORES, 0);
    store64(r + AGN_REQ_REQUIRED_FAMILY, AGNOSAI_NO_LIMIT);
    return r;
}

# Global-allocator form of `agnosai_hw_requirement_new_a`.
fn agnosai_hw_requirement_new(): i64 {
    return agnosai_hw_requirement_new_a(default_alloc());
}

# A requirement for specific accelerator types. `accelerators` is a vec.
fn agnosai_hw_requirement_for_accelerators(accelerators): i64 {
    var r = agnosai_hw_requirement_new();
    store64(r + AGN_REQ_ACCELERATORS, accelerators);
    return r;
}

# Set minimum device memory in MB. Returns the requirement.
fn agnosai_hw_requirement_with_min_memory(r, mb): i64 {
    store64(r + AGN_REQ_MIN_MEMORY_MB, mb);
    return r;
}

# Set minimum device count. Returns the requirement.
fn agnosai_hw_requirement_with_min_devices(r, count): i64 {
    store64(r + AGN_REQ_MIN_DEVICE_COUNT, count);
    return r;
}

# Set minimum CPU cores. Returns the requirement.
fn agnosai_hw_requirement_with_min_cpu_cores(r, cores): i64 {
    store64(r + AGN_REQ_MIN_CPU_CORES, cores);
    return r;
}

# Set the required accelerator family. Returns the requirement.
fn agnosai_hw_requirement_with_family(r, family): i64 {
    store64(r + AGN_REQ_REQUIRED_FAMILY, family);
    return r;
}

# Vec of acceptable accelerator types (empty = any).
fn agnosai_hw_requirement_accelerators(r): i64 {
    return load64(r + AGN_REQ_ACCELERATORS);
}

# Minimum device memory in MB (0 = no requirement).
fn agnosai_hw_requirement_min_memory_mb(r): i64 {
    return load64(r + AGN_REQ_MIN_MEMORY_MB);
}

# Minimum number of devices needed (0 = no requirement).
fn agnosai_hw_requirement_min_device_count(r): i64 {
    return load64(r + AGN_REQ_MIN_DEVICE_COUNT);
}

# Minimum CPU cores (0 = no requirement).
fn agnosai_hw_requirement_min_cpu_cores(r): i64 {
    return load64(r + AGN_REQ_MIN_CPU_CORES);
}

# Required accelerator family, or AGNOSAI_NO_LIMIT when unset.
fn agnosai_hw_requirement_required_family(r): i64 {
    return load64(r + AGN_REQ_REQUIRED_FAMILY);
}

# A hardware requirement as a bayan JSON value. `required_family` is **omitted**
# rather than emitted as null when unset — the oracle marks that one field
# `skip_serializing_if = "Option::is_none"`.
fn agnosai_hw_requirement_to_value_a(a, r): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    var accels = load64(r + AGN_REQ_ACCELERATORS);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(accels); i = i + 1) {
        var w = agnosai_accelerator_type_to_wire_a(a, vec_get(accels, i));
        bayan_json_v_arr_push_a(a, arr, bayan_json_v_str_new_a(a, w));
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "accelerators"), arr);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "min_memory_mb"),
      bayan_json_v_int_new_a(a, load64(r + AGN_REQ_MIN_MEMORY_MB)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "min_device_count"),
      bayan_json_v_int_new_a(a, load64(r + AGN_REQ_MIN_DEVICE_COUNT)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "min_cpu_cores"),
      bayan_json_v_int_new_a(a, load64(r + AGN_REQ_MIN_CPU_CORES)));

    var fam = load64(r + AGN_REQ_REQUIRED_FAMILY);
    if (fam != AGNOSAI_NO_LIMIT) {
        bayan_json_v_obj_set_a(a, obj, str_from_a(a, "required_family"),
          bayan_json_v_str_new_a(a, agnosai_accelerator_family_to_wire_a(a, fam)));
    }
    return obj;
}

# Global-allocator form of `agnosai_hw_requirement_to_value_a`.
fn agnosai_hw_requirement_to_value(r): i64 {
    return agnosai_hw_requirement_to_value_a(default_alloc(), r);
}

# Rebuild a hardware requirement from a bayan JSON value. Every field is
# `#[serde(default)]` in the oracle, so missing ones take their defaults.
fn agnosai_hw_requirement_from_value_a(a, v): i64 {
    var r = agnosai_hw_requirement_new_a(a);
    if (bayan_json_v_is_obj(v) == 0) { return r; }

    var av = bayan_json_v_obj_get(v, "accelerators");
    if (av != 0 && bayan_json_v_is_arr(av) == 1) {
        var accels = load64(r + AGN_REQ_ACCELERATORS);
        for (var i = 0; i < bayan_json_v_arr_len(av); i = i + 1) {
            var e = bayan_json_v_arr_get(av, i);
            if (bayan_json_v_is_str(e) == 1) {
                vec_push_a(a, accels, agnosai_accelerator_type_from_wire(bayan_json_v_str(e)));
            }
        }
    }
    store64(r + AGN_REQ_MIN_MEMORY_MB, _agnosai_int_field(v, "min_memory_mb", 0));
    store64(r + AGN_REQ_MIN_DEVICE_COUNT, _agnosai_int_field(v, "min_device_count", 0));
    store64(r + AGN_REQ_MIN_CPU_CORES, _agnosai_int_field(v, "min_cpu_cores", 0));

    var fv = bayan_json_v_obj_get(v, "required_family");
    if (fv != 0 && bayan_json_v_is_str(fv) == 1) {
        store64(r + AGN_REQ_REQUIRED_FAMILY, agnosai_accelerator_family_from_wire(bayan_json_v_str(fv)));
    }
    return r;
}

# Global-allocator form of `agnosai_hw_requirement_from_value_a`.
#
# **This one borrows nothing from `v`.** Both string-valued members go through
# `agnosai_accelerator_type_from_wire` / `_family_from_wire`, which answer enum
# ints — so the requirement is self-contained however `v` was allocated, and the
# allocator here is only for its own struct and vec.
fn agnosai_hw_requirement_from_value(v): i64 {
    return agnosai_hw_requirement_from_value_a(default_alloc(), v);
}

# Create a hardware inventory. `devices` is a vec of compute devices.
fn agnosai_hw_inventory_new(cpu_cores, memory_total_mb, devices): i64 {
    var inv = alloc(AGN_INV_SIZE);
    store64(inv + AGN_INV_CPU_CORES, cpu_cores);
    store64(inv + AGN_INV_MEMORY_TOTAL_MB, memory_total_mb);
    store64(inv + AGN_INV_DEVICES, devices);
    return inv;
}

# Number of CPU cores available.
fn agnosai_hw_inventory_cpu_cores(inv): i64 {
    return load64(inv + AGN_INV_CPU_CORES);
}

# Total system memory in megabytes.
fn agnosai_hw_inventory_memory_total_mb(inv): i64 {
    return load64(inv + AGN_INV_MEMORY_TOTAL_MB);
}

# Vec of accelerator devices present on this node.
fn agnosai_hw_inventory_devices(inv): i64 {
    return load64(inv + AGN_INV_DEVICES);
}

# Vec of devices of a specific accelerator type.
fn agnosai_hw_inventory_devices_of_type(inv, accel): i64 {
    var out = vec_new();
    var devices = load64(inv + AGN_INV_DEVICES);
    for (var i = 0; i < vec_len(devices); i = i + 1) {
        var d = vec_get(devices, i);
        if (load64(d + AGN_DEV_ACCELERATOR) == accel) { vec_push(out, d); }
    }
    return out;
}

# Total device memory in MB across all devices of a type.
fn agnosai_hw_inventory_total_memory_mb(inv, accel): i64 {
    var total = 0;
    var matching = agnosai_hw_inventory_devices_of_type(inv, accel);
    for (var i = 0; i < vec_len(matching); i = i + 1) {
        total = total + load64(vec_get(matching, i) + AGN_DEV_MEMORY_TOTAL_MB);
    }
    return total;
}

# Whether any device in `matching` has at least `min_memory_mb` total memory.
fn _agnosai_any_device_meets_memory(matching, min_memory_mb): i64 {
    for (var i = 0; i < vec_len(matching); i = i + 1) {
        if (load64(vec_get(matching, i) + AGN_DEV_MEMORY_TOTAL_MB) >= min_memory_mb) { return 1; }
    }
    return 0;
}

# Whether this inventory satisfies a hardware requirement.
#
# The branch order is the oracle's and is observable: CPU cores first, then
# family-based matching (which returns outright), then specific-type matching.
# An empty `accelerators` list with no family means "anything satisfies".
fn agnosai_hw_inventory_satisfies(inv, req): i64 {
    var min_cores = load64(req + AGN_REQ_MIN_CPU_CORES);
    if (min_cores > 0 && load64(inv + AGN_INV_CPU_CORES) < min_cores) { return 0; }

    var min_count = load64(req + AGN_REQ_MIN_DEVICE_COUNT);
    var min_mem = load64(req + AGN_REQ_MIN_MEMORY_MB);
    var devices = load64(inv + AGN_INV_DEVICES);

    var family = load64(req + AGN_REQ_REQUIRED_FAMILY);
    if (family != AGNOSAI_NO_LIMIT) {
        var fam_match = vec_new();
        for (var i = 0; i < vec_len(devices); i = i + 1) {
            var d = vec_get(devices, i);
            if (agnosai_accelerator_family_of(load64(d + AGN_DEV_ACCELERATOR)) == family) {
                vec_push(fam_match, d);
            }
        }
        if (vec_len(fam_match) == 0) { return 0; }
        if (min_count > 0 && vec_len(fam_match) < min_count) { return 0; }
        if (min_mem > 0 && _agnosai_any_device_meets_memory(fam_match, min_mem) == 0) { return 0; }
        return 1;
    }

    var accels = load64(req + AGN_REQ_ACCELERATORS);
    if (vec_len(accels) == 0) { return 1; }

    var type_match = vec_new();
    for (var j = 0; j < vec_len(devices); j = j + 1) {
        var dev = vec_get(devices, j);
        if (vec_find(accels, load64(dev + AGN_DEV_ACCELERATOR)) >= 0) { vec_push(type_match, dev); }
    }
    if (min_count > 0 && vec_len(type_match) < min_count) { return 0; }
    if (min_mem > 0 && _agnosai_any_device_meets_memory(type_match, min_mem) == 0) { return 0; }
    if (vec_len(type_match) == 0) { return 0; }
    return 1;
}

# Create a resource budget. Pass AGNOSAI_NO_LIMIT for any unset field.
# `max_cost_micro_usd` is millionths of a dollar.
fn agnosai_resource_budget_new(max_tokens, max_cost_micro_usd, max_duration_secs,
  max_concurrent_tasks): i64 {
    var b = alloc(AGN_BUD_SIZE);
    store64(b + AGN_BUD_MAX_TOKENS, max_tokens);
    store64(b + AGN_BUD_MAX_COST_MICRO_USD, max_cost_micro_usd);
    store64(b + AGN_BUD_MAX_DURATION_SECS, max_duration_secs);
    store64(b + AGN_BUD_MAX_CONCURRENT_TASKS, max_concurrent_tasks);
    return b;
}

# The oracle's `Default`: no token, cost or duration ceiling, but at most 10
# concurrent tasks.
fn agnosai_resource_budget_default(): i64 {
    return agnosai_resource_budget_new(AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT, AGNOSAI_NO_LIMIT, 10);
}

# Maximum total LLM tokens, or AGNOSAI_NO_LIMIT.
fn agnosai_resource_budget_max_tokens(b): i64 {
    return load64(b + AGN_BUD_MAX_TOKENS);
}

# Maximum total cost in micro-USD, or AGNOSAI_NO_LIMIT.
fn agnosai_resource_budget_max_cost_micro_usd(b): i64 {
    return load64(b + AGN_BUD_MAX_COST_MICRO_USD);
}

# Maximum wall-clock seconds for the crew run, or AGNOSAI_NO_LIMIT.
fn agnosai_resource_budget_max_duration_secs(b): i64 {
    return load64(b + AGN_BUD_MAX_DURATION_SECS);
}

# Maximum number of concurrent crew executions, or AGNOSAI_NO_LIMIT.
fn agnosai_resource_budget_max_concurrent_tasks(b): i64 {
    return load64(b + AGN_BUD_MAX_CONCURRENT_TASKS);
}

# Micro-USD as the f64 dollar amount the wire carries.
fn agnosai_micro_usd_to_f64(micro): i64 {
    return f64_div(f64_from(micro), f64_from(AGNOSAI_MICRO_USD_PER_USD));
}

# An f64 dollar amount as micro-USD, rounded to the nearest millionth.
fn agnosai_f64_to_micro_usd(usd): i64 {
    return f64_to(f64_round(f64_mul(usd, f64_from(AGNOSAI_MICRO_USD_PER_USD))));
}

# A resource budget as a bayan JSON value. `max_cost_usd` keeps the oracle's
# wire name and goes out as a JSON number in dollars — bayan's Grisu2 emits the
# shortest round-tripping form, so 2500 micro-USD renders as `0.0025`, exactly
# as serde rendered the f64.
fn agnosai_resource_budget_to_value_a(a, b): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_tokens"),
      _agnosai_opt_int_to_value_a(a, load64(b + AGN_BUD_MAX_TOKENS)));

    var micro = load64(b + AGN_BUD_MAX_COST_MICRO_USD);
    var cost_v = bayan_json_v_null_a(a);
    if (micro != AGNOSAI_NO_LIMIT) {
        cost_v = bayan_json_v_float_new_a(a, agnosai_micro_usd_to_f64(micro));
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_cost_usd"), cost_v);

    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_duration_secs"),
      _agnosai_opt_int_to_value_a(a, load64(b + AGN_BUD_MAX_DURATION_SECS)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "max_concurrent_tasks"),
      _agnosai_opt_int_to_value_a(a, load64(b + AGN_BUD_MAX_CONCURRENT_TASKS)));
    return obj;
}

# Global-allocator form of `agnosai_resource_budget_to_value_a`.
fn agnosai_resource_budget_to_value(b): i64 {
    return agnosai_resource_budget_to_value_a(default_alloc(), b);
}

# Rebuild a resource budget from a bayan JSON value. `max_cost_usd` is accepted
# as either a JSON float or a whole-dollar integer.
fn agnosai_resource_budget_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return agnosai_resource_budget_default(); }

    var micro = AGNOSAI_NO_LIMIT;
    var cv = bayan_json_v_obj_get(v, "max_cost_usd");
    if (cv != 0) {
        if (bayan_json_v_is_float(cv) == 1) {
            micro = agnosai_f64_to_micro_usd(bayan_json_v_float(cv));
        } elif (bayan_json_v_is_int(cv) == 1) {
            micro = bayan_json_v_int(cv) * AGNOSAI_MICRO_USD_PER_USD;
        }
    }

    return agnosai_resource_budget_new(_agnosai_opt_int_field(v, "max_tokens"), micro,
      _agnosai_opt_int_field(v, "max_duration_secs"),
      _agnosai_opt_int_field(v, "max_concurrent_tasks"));
}

# Create a GPU device with VRAM capacity information.
fn agnosai_gpu_device_new(index, name: Str, vram_total_mb, vram_available_mb): i64 {
    var g = alloc(AGN_GPU_SIZE);
    store64(g + AGN_GPU_INDEX, index);
    store64(g + AGN_GPU_NAME, name);
    store64(g + AGN_GPU_VRAM_TOTAL_MB, vram_total_mb);
    store64(g + AGN_GPU_VRAM_AVAILABLE_MB, vram_available_mb);
    return g;
}

# Zero-based GPU index.
fn agnosai_gpu_device_index(g): i64 {
    return load64(g + AGN_GPU_INDEX);
}

# GPU device name.
fn agnosai_gpu_device_name(g): i64 {
    return load64(g + AGN_GPU_NAME);
}

# Total VRAM in megabytes.
fn agnosai_gpu_device_vram_total_mb(g): i64 {
    return load64(g + AGN_GPU_VRAM_TOTAL_MB);
}

# Available (free) VRAM in megabytes.
fn agnosai_gpu_device_vram_available_mb(g): i64 {
    return load64(g + AGN_GPU_VRAM_AVAILABLE_MB);
}

# A GPU device as a bayan JSON value.
fn agnosai_gpu_device_to_value_a(a, g): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "index"), bayan_json_v_int_new_a(a, load64(g + AGN_GPU_INDEX)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "name"), bayan_json_v_str_new_a(a, load64(g + AGN_GPU_NAME)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "vram_total_mb"),
      bayan_json_v_int_new_a(a, load64(g + AGN_GPU_VRAM_TOTAL_MB)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "vram_available_mb"),
      bayan_json_v_int_new_a(a, load64(g + AGN_GPU_VRAM_AVAILABLE_MB)));
    return obj;
}

# Global-allocator form of `agnosai_gpu_device_to_value_a`.
fn agnosai_gpu_device_to_value(g): i64 {
    return agnosai_gpu_device_to_value_a(default_alloc(), g);
}

# Rebuild a GPU device from a bayan JSON value, or 0 when not an object.
fn agnosai_gpu_device_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var name = str_from("");
    var nv = bayan_json_v_obj_get(v, "name");
    if (nv != 0 && bayan_json_v_is_str(nv) == 1) { name = bayan_json_v_str(nv); }
    return agnosai_gpu_device_new(_agnosai_int_field(v, "index", 0), name,
      _agnosai_int_field(v, "vram_total_mb", 0), _agnosai_int_field(v, "vram_available_mb", 0));
}

# A hardware inventory as a bayan JSON value.
fn agnosai_hw_inventory_to_value_a(a, inv): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "cpu_cores"),
      bayan_json_v_int_new_a(a, load64(inv + AGN_INV_CPU_CORES)));
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "memory_total_mb"),
      bayan_json_v_int_new_a(a, load64(inv + AGN_INV_MEMORY_TOTAL_MB)));
    var devices = load64(inv + AGN_INV_DEVICES);
    var arr = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(devices); i = i + 1) {
        bayan_json_v_arr_push_a(a, arr, agnosai_compute_device_to_value_a(a, vec_get(devices, i)));
    }
    bayan_json_v_obj_set_a(a, obj, str_from_a(a, "devices"), arr);
    return obj;
}

# Global-allocator form of `agnosai_hw_inventory_to_value_a`.
fn agnosai_hw_inventory_to_value(inv): i64 {
    return agnosai_hw_inventory_to_value_a(default_alloc(), inv);
}

# Rebuild a hardware inventory from a bayan JSON value.
fn agnosai_hw_inventory_from_value(v): i64 {
    var devices = vec_new();
    if (bayan_json_v_is_obj(v) == 0) { return agnosai_hw_inventory_new(0, 0, devices); }
    var dv = bayan_json_v_obj_get(v, "devices");
    if (dv != 0 && bayan_json_v_is_arr(dv) == 1) {
        for (var i = 0; i < bayan_json_v_arr_len(dv); i = i + 1) {
            var d = agnosai_compute_device_from_value(bayan_json_v_arr_get(dv, i));
            if (d != 0) { vec_push(devices, d); }
        }
    }
    return agnosai_hw_inventory_new(_agnosai_int_field(v, "cpu_cores", 0),
      _agnosai_int_field(v, "memory_total_mb", 0), devices);
}

# --- hwaccel -------------------------------------------------------------
#
# The oracle's `#[cfg(feature = "hwaccel")]` half. Every body here is an
# ADAPTER over ai-hwaccel, never an implementation — the detection, the
# quantization policy and the training-memory model all live in the vendored
# library, and a second copy would drift from it silently. Same call
# `fleet/coordinator` made for `plan_sharding`.

# Bytes in a mebibyte and a gibibyte. ai-hwaccel reports device memory in bytes
# and the oracle's `ComputeDevice` carries megabytes, so the conversion is the
# oracle's `/ (1024 * 1024)` — MiB, not decimal MB.
var AGNOSAI_BYTES_PER_MB = 1048576;
var AGNOSAI_BYTES_PER_GB = 1073741824;

# One `cpu_set_t`, in bytes — 1024 CPUs, glibc's default ceiling.
var AGNOSAI_CPU_SET_BYTES = 128;

# Bits set in a 64-bit word.
fn _agnosai_popcount64(x): i64 {
    var n = 0;
    for (var i = 0; i < 64; i = i + 1) {
        if (((x >> i) & 1) == 1) { n = n + 1; }
    }
    return n;
}

# The oracle's `std::thread::available_parallelism().map(|p| p.get()).unwrap_or(1)`.
#
# ⚠ **The AFFINITY mask, not the machine's core count**, because that is what
# std answers on Linux: a process under `taskset -c 0-3` on a 64-core box gets
# 4, and so does one in a cgroup pinned the same way. Counting
# `/sys/devices/system/cpu/online` instead would answer 64 and over-provision
# every placement decision that reads `min_cpu_cores` — and it would look right
# on an unconstrained developer box, which is where it would be tested.
#
# ⚠ Falls back to **1**, never 0, matching `unwrap_or(1)`. A zero would make
# `agnosai_hw_inventory_satisfies` reject every requirement that names any CPU
# cores at all.
#
# `sched_getaffinity` is Linux-only and its number differs per ABI — x86-64 is
# 204, aarch64 is 123 — and a raw `syscall()` is NOT renumbered by the backend
# the way the `sys_*` wrappers are, so the number is selected here. Every other
# target takes the fallback, which is a real residual and not a silent one: the
# inventory reports one core rather than a wrong number.
# Bits set across the first `rc` BYTES of an affinity mask, or 1 when the
# syscall failed — the oracle's `unwrap_or(1)`.
#
# ⚠ Split out because the fallback is otherwise **unreachable on the platform
# that runs the tests**: this box is Linux x86, `sched_getaffinity` always
# succeeds, and a mutant changing the fallback from 1 to 0 survives every
# assertion. Taking `rc` and the mask as data makes both arms testable.
#
# ⚠ `rc` is a BYTE count, not a word count. Reading the whole 128-byte buffer
# regardless would count whatever the kernel did not write.
fn _agnosai_cores_from_affinity(rc, mask): i64 {
    if (rc > 0) {
        var cores = 0;
        for (var w = 0; w < rc / 8; w = w + 1) {
            cores = cores + _agnosai_popcount64(load64(mask + w * 8));
        }
        if (cores > 0) { return cores; }
    }
    return 1;
}

fn _agnosai_available_parallelism(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    # ⚠ The size is a LITERAL 128, not `AGNOSAI_CPU_SET_BYTES` — a `var buf[N]`
    # needs a compile-time constant and a `var` will not do. Keep the two in step.
    var mask[128];
    for (var z = 0; z < AGNOSAI_CPU_SET_BYTES / 8; z = z + 1) {
        store64(&mask + z * 8, 0);
    }

    var rc = 0 - 1;
    #ifdef CYRIUS_ARCH_X86
    rc = syscall(204, 0, AGNOSAI_CPU_SET_BYTES, &mask);
    #endif
    #ifdef CYRIUS_ARCH_AARCH64
    rc = syscall(123, 0, AGNOSAI_CPU_SET_BYTES, &mask);
    #endif

    return _agnosai_cores_from_affinity(rc, &mask);
    #endif
    return 1;
}

# Narrow ai-hwaccel's accelerator type to the oracle's six.
#
# ⚠ **This is NOT a pass-through, and it looks like one.** ai-hwaccel numbers
# `ACCEL_TPU = 8` while `AGNOSAI_ACCEL_TPU = 5`; CPU/CUDA/ROCM/METAL/VULKAN are
# 0-4 on both sides and would survive a bare cast, so five of six values are
# right by coincidence and a TPU silently becomes an Intel NPU. ai-hwaccel has
# nineteen variants against these six.
#
# ⚠ Everything unmapped falls back to **CPU**, which is the oracle's choice and
# a deliberate one: an NPU or an ASIC is still usable, and answering `Cpu` keeps
# it from matching a GPU or TPU placement requirement it cannot serve. Answering
# some "other" value would make it match nothing at all, including CPU work.
fn agnosai_accelerator_type_from_hwaccel(hw): i64 {
    if (hw == ACCEL_CPU) { return AGNOSAI_ACCEL_CPU; }
    if (hw == ACCEL_CUDA) { return AGNOSAI_ACCEL_CUDA; }
    if (hw == ACCEL_ROCM) { return AGNOSAI_ACCEL_ROCM; }
    if (hw == ACCEL_METAL) { return AGNOSAI_ACCEL_METAL; }
    if (hw == ACCEL_VULKAN) { return AGNOSAI_ACCEL_VULKAN; }
    if (hw == ACCEL_TPU) { return AGNOSAI_ACCEL_TPU; }
    return AGNOSAI_ACCEL_CPU;
}

# Build a `HardwareInventory` from an ai-hwaccel registry.
#
# ⚠ The CPU profile is **not a device**. It is diverted into the inventory's
# `memory_total_mb` and `cpu_cores` and then `continue`d past, so a registry of
# one CPU profile yields an inventory with ZERO devices. Pushing it as a device
# instead would make `total_memory_mb` double-count and let a CPU satisfy a
# `devices_of_type` query for accelerators.
#
# ⚠ `index` is the position in the registry's profile list, NOT a count of
# devices pushed. The oracle enumerates before it filters, so a CPU profile at
# position 0 leaves the first real device with index 1 and a gap at 0.
#
# ⚠ `memory_free_bytes` is an Option upstream and `PROFILE_NONE` (-1) here;
# absent means "fall back to the total", not "zero available".
fn agnosai_hw_inventory_from_hwaccel(registry): i64 {
    var cpu_cores = 0;
    var memory_total_mb = 0;
    var devices = vec_new();

    var profiles = reg_profiles(registry);
    for (var i = 0; i < vec_len(profiles); i = i + 1) {
        var p = vec_get(profiles, i);
        var atype = profile_accel_type(p);
        var mem_mb = profile_memory_bytes(p) / AGNOSAI_BYTES_PER_MB;

        var free_bytes = profile_mem_free(p);
        if (free_bytes == PROFILE_NONE) { free_bytes = profile_memory_bytes(p); }
        var avail_mb = free_bytes / AGNOSAI_BYTES_PER_MB;

        if (atype == ACCEL_CPU) {
            memory_total_mb = mem_mb;
            cpu_cores = _agnosai_available_parallelism();
            continue;
        }

        vec_push(devices, agnosai_compute_device_with_available(
            agnosai_compute_device_new(i, str_from(accel_name(atype)),
              agnosai_accelerator_type_from_hwaccel(atype), mem_mb), avail_mb));
    }

    return agnosai_hw_inventory_new(cpu_cores, memory_total_mb, devices);
}

# Detect the host's hardware — the oracle's `HardwareInventory::detect`.
#
# ⚠ `registry_detect` shells out to `nvidia-smi` and friends. The oracle's
# `detect()` has **no test at all**, gated or otherwise, and neither does this:
# what it answers depends on the box. `from_hwaccel` above is the testable half
# and is where every assertion goes.
fn agnosai_hw_inventory_detect(): i64 {
    return agnosai_hw_inventory_from_hwaccel(registry_detect());
}

# TrainingMemoryEstimate heap layout — 32 bytes, four f64 bit patterns in GB.
#
# ⚠ GB as **f64**, matching the oracle's four `f64` fields — ai-hwaccel answers
# in x1000 fixed-point integers (`est_model_x1000` and friends), and storing
# those raw would make `total_gb` read 14000 for a 14 GB model. The conversion
# is one divide and it happens once, at construction.
enum AgnosaiTrainingMemOff {
    AGN_TRAINMEM_MODEL_GB = 0;
    AGN_TRAINMEM_OPTIMIZER_GB = 8;
    AGN_TRAINMEM_ACTIVATION_GB = 16;
    AGN_TRAINMEM_TOTAL_GB = 24;
    AGN_TRAINMEM_BYTES = 32;
}

# Estimate training memory — the oracle's `TrainingMemoryEstimate::estimate`.
#
# `model_params_millions` is millions (7000 for a 7B model), `method` is one of
# ai-hwaccel's `TRAIN_*` and `target` one of its `TARGET_*`.
fn agnosai_training_memory_estimate(model_params_millions, method, target): i64 {
    var e = estimate_training_memory(model_params_millions, method, target);
    var thousand = f64_from(1000);
    var t = alloc(AGN_TRAINMEM_BYTES);
    store64(t + AGN_TRAINMEM_MODEL_GB,
      f64_div(f64_from(est_model_x1000(e)), thousand));
    store64(t + AGN_TRAINMEM_OPTIMIZER_GB,
      f64_div(f64_from(est_optimizer_x1000(e)), thousand));
    store64(t + AGN_TRAINMEM_ACTIVATION_GB,
      f64_div(f64_from(est_activation_x1000(e)), thousand));
    store64(t + AGN_TRAINMEM_TOTAL_GB,
      f64_div(f64_from(est_total_x1000(e)), thousand));
    return t;
}

# Model weights, in GB.
fn agnosai_training_memory_model_gb(t): i64 {
    return load64(t + AGN_TRAINMEM_MODEL_GB);
}

# Optimizer state, in GB.
fn agnosai_training_memory_optimizer_gb(t): i64 {
    return load64(t + AGN_TRAINMEM_OPTIMIZER_GB);
}

# Activations, in GB.
fn agnosai_training_memory_activation_gb(t): i64 {
    return load64(t + AGN_TRAINMEM_ACTIVATION_GB);
}

# The three summed, in GB.
fn agnosai_training_memory_total_gb(t): i64 {
    return load64(t + AGN_TRAINMEM_TOTAL_GB);
}

# Whether the estimate fits in an inventory's total accelerator VRAM.
#
# ⚠ **DEVICE VRAM ONLY.** The sum walks `devices`, and the CPU profile never
# becomes a device — so an inventory with 512 GB of system RAM and no GPU fits
# nothing at all. That is the oracle's arithmetic and the right one for a
# training estimate, but `memory_total_mb` sitting right there makes the wrong
# version easy to write.
#
# ⚠ `<=`, so an estimate exactly equal to available VRAM FITS.
fn agnosai_training_memory_fits_in(t, inventory): i64 {
    var total_vram_gb = f64_from(0);
    var devices = agnosai_hw_inventory_devices(inventory);
    var mb_per_gb = f64_from(1024);
    for (var i = 0; i < vec_len(devices); i = i + 1) {
        total_vram_gb = f64_add(total_vram_gb, f64_div(
            f64_from(agnosai_compute_device_memory_total_mb(vec_get(devices, i))), mb_per_gb));
    }
    return f64_le(load64(t + AGN_TRAINMEM_TOTAL_GB), total_vram_gb);
}

# The total in bytes — GB x 1024^3, truncated, as the oracle's `as u64` is.
fn agnosai_training_memory_total_bytes(t): i64 {
    return f64_to(f64_mul(load64(t + AGN_TRAINMEM_TOTAL_GB),
        f64_from(AGNOSAI_BYTES_PER_GB)));
}

# --- task.cyr ---

# =========================================================================
# core/task — tasks, priorities, statuses, results and the task DAG.
#
# Origin: rust-old/src/core/task.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * The four enums keep the oracle's **explicit discriminants**. For
#     TaskPriority that is load-bearing: the oracle derives `Ord`, so
#     `Critical > High > Normal > Low > Background` is observable behaviour and
#     falls out of plain integer comparison here.
#   * `Option<T>` fields are 0 when absent. On the wire they emit `null`, which
#     is what serde does for an `Option` without `skip_serializing_if`.
#   * The `with_*` builders mutate in place and return the task pointer, so they
#     still chain. The oracle's take-by-value/return-Self form has no Cyrius
#     equivalent and would copy the struct on every call.
#   * `Vec<(String, String)>` edges become a vec of 2-slot heap pairs, emitted
#     as JSON arrays `[["t1","t2"]]` exactly as serde emits a tuple.
#
# Every wire spelling below is the oracle's `rename_all = "snake_case"` form.
# Unit variants serialize as bare strings; the two ProcessMode struct variants
# are externally tagged, e.g. `{"parallel":{"max_concurrency":8}}`.
# =========================================================================

# Risk level for human-in-the-loop approval gating.
enum AgnosaiTaskRisk {
    AGNOSAI_RISK_LOW = 0;
    AGNOSAI_RISK_MEDIUM = 1;
    AGNOSAI_RISK_HIGH = 2;
}

# Priority tier for task scheduling (higher = more urgent).
enum AgnosaiTaskPriority {
    AGNOSAI_PRIORITY_BACKGROUND = 0;
    AGNOSAI_PRIORITY_LOW = 1;
    AGNOSAI_PRIORITY_NORMAL = 2;
    AGNOSAI_PRIORITY_HIGH = 3;
    AGNOSAI_PRIORITY_CRITICAL = 4;
}

# Lifecycle status of a task.
enum AgnosaiTaskStatus {
    AGNOSAI_STATUS_PENDING = 0;
    AGNOSAI_STATUS_QUEUED = 1;
    AGNOSAI_STATUS_RUNNING = 2;
    AGNOSAI_STATUS_COMPLETED = 3;
    AGNOSAI_STATUS_FAILED = 4;
    AGNOSAI_STATUS_CANCELLED = 5;
}

# How tasks within a crew should be executed.
enum AgnosaiProcessKind {
    AGNOSAI_PROCESS_SEQUENTIAL = 0;
    AGNOSAI_PROCESS_HIERARCHICAL = 1;
    AGNOSAI_PROCESS_DAG = 2;
    AGNOSAI_PROCESS_PARALLEL = 3;
}

# Task heap layout — 80 bytes.
enum AgnosaiTaskOff {
    AGN_TASK_ID = 0;
    AGN_TASK_DESCRIPTION = 8;
    AGN_TASK_EXPECTED_OUTPUT = 16;
    AGN_TASK_ASSIGNED_AGENT = 24;
    AGN_TASK_PRIORITY = 32;
    AGN_TASK_STATUS = 40;
    AGN_TASK_DEPENDENCIES = 48;
    AGN_TASK_CONTEXT = 56;
    AGN_TASK_RISK = 64;
    AGN_TASK_OUTPUT_SCHEMA = 72;
    AGN_TASK_SIZE = 80;
}

# TaskResult heap layout — 32 bytes.
enum AgnosaiTaskResultOff {
    AGN_TRES_TASK_ID = 0;
    AGN_TRES_OUTPUT = 8;
    AGN_TRES_STATUS = 16;
    AGN_TRES_METADATA = 24;
    AGN_TRES_SIZE = 32;
}

# ProcessMode heap layout — 24 bytes.
enum AgnosaiProcessModeOff {
    AGN_PROC_KIND = 0;
    AGN_PROC_MANAGER = 8;
    AGN_PROC_MAX_CONCURRENCY = 16;
    AGN_PROC_SIZE = 24;
}

# TaskDAG heap layout — 24 bytes.
enum AgnosaiTaskDagOff {
    AGN_DAG_TASKS = 0;
    AGN_DAG_EDGES = 8;
    AGN_DAG_PROCESS = 16;
    AGN_DAG_SIZE = 24;
}

# Edge heap layout — a (from, to) pair of Str, 16 bytes.
enum AgnosaiEdgeOff {
    AGN_EDGE_FROM = 0;
    AGN_EDGE_TO = 8;
    AGN_EDGE_SIZE = 16;
}

# The wire vocabulary only the task serialisers emit. The statuses this file
# shares with `agent` and `crew` — and the keys it shares with `crew` — live in
# `core/json.cyr`, which is included first; see the banner there for why they
# are hoisted at all and why the error-arm literals are not.
var AGN_JV_LOW = str_from("low");
var AGN_JV_MEDIUM = str_from("medium");
var AGN_JV_HIGH = str_from("high");
var AGN_JV_BACKGROUND = str_from("background");
var AGN_JV_NORMAL = str_from("normal");
var AGN_JV_CRITICAL = str_from("critical");
var AGN_JV_DAG = str_from("dag");
var AGN_JV_HIERARCHICAL = str_from("hierarchical");
var AGN_JV_PARALLEL = str_from("parallel");
var AGN_JV_SEQUENTIAL = str_from("sequential");

# **A key is a compile-time constant, so allocating one per serialised object is
# pure overhead.** Measured on `agnosai_task_result_to_value_a`: four keys were
# ~29% of a four-field object's build time — 430 ns against 314 hoisted.
#
# These sit here, above every serialiser in the file, because Cyrius resolves in
# a single pass: a global defined after its first use does not exist yet.
var AGN_JK_TASK_ID = str_from("task_id");
var AGN_JK_OUTPUT = str_from("output");
var AGN_JK_STATUS = str_from("status");
var AGN_JK_METADATA = str_from("metadata");
var AGN_JK_MANAGER = str_from("manager");
var AGN_JK_MAX_CONCURRENCY = str_from("max_concurrency");
var AGN_JK_DESCRIPTION = str_from("description");
var AGN_JK_EXPECTED_OUTPUT = str_from("expected_output");
var AGN_JK_ASSIGNED_AGENT = str_from("assigned_agent");
var AGN_JK_PRIORITY = str_from("priority");
var AGN_JK_DEPENDENCIES = str_from("dependencies");
var AGN_JK_CONTEXT = str_from("context");
var AGN_JK_RISK = str_from("risk");
var AGN_JK_OUTPUT_SCHEMA = str_from("output_schema");
var AGN_JK_EDGES = str_from("edges");

# The snake_case wire spelling of a risk level.
#
# `a` is unused — the answer is a process-lifetime `Str`, not a fresh
# allocation. The parameter stays because the signature is the API and the bare
# form below delegates through it.
fn agnosai_task_risk_to_wire_a(a, risk): i64 {
    if (risk == AGNOSAI_RISK_MEDIUM) { return AGN_JV_MEDIUM; }
    if (risk == AGNOSAI_RISK_HIGH) { return AGN_JV_HIGH; }
    return AGN_JV_LOW;
}

# The snake_case wire spelling of a risk level (global-allocator form).
fn agnosai_task_risk_to_wire(risk): i64 {
    return agnosai_task_risk_to_wire_a(default_alloc(), risk);
}

# A risk level from its wire spelling. Unknown spellings fall back to the
# oracle's default, Low.
fn agnosai_task_risk_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "medium") == 1) { return AGNOSAI_RISK_MEDIUM; }
    if (str_eq_cstr(s, "high") == 1) { return AGNOSAI_RISK_HIGH; }
    return AGNOSAI_RISK_LOW;
}

# The snake_case wire spelling of a priority tier.
fn agnosai_task_priority_to_wire_a(a, priority): i64 {
    if (priority == AGNOSAI_PRIORITY_BACKGROUND) { return AGN_JV_BACKGROUND; }
    if (priority == AGNOSAI_PRIORITY_LOW) { return AGN_JV_LOW; }
    if (priority == AGNOSAI_PRIORITY_HIGH) { return AGN_JV_HIGH; }
    if (priority == AGNOSAI_PRIORITY_CRITICAL) { return AGN_JV_CRITICAL; }
    return AGN_JV_NORMAL;
}

# The snake_case wire spelling of a priority tier (global-allocator form).
fn agnosai_task_priority_to_wire(priority): i64 {
    return agnosai_task_priority_to_wire_a(default_alloc(), priority);
}

# A priority tier from its wire spelling. Unknown spellings fall back to the
# oracle's default, Normal.
fn agnosai_task_priority_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "background") == 1) { return AGNOSAI_PRIORITY_BACKGROUND; }
    if (str_eq_cstr(s, "low") == 1) { return AGNOSAI_PRIORITY_LOW; }
    if (str_eq_cstr(s, "high") == 1) { return AGNOSAI_PRIORITY_HIGH; }
    if (str_eq_cstr(s, "critical") == 1) { return AGNOSAI_PRIORITY_CRITICAL; }
    return AGNOSAI_PRIORITY_NORMAL;
}

# The snake_case wire spelling of a lifecycle status.
fn agnosai_task_status_to_wire_a(a, status): i64 {
    if (status == AGNOSAI_STATUS_QUEUED) { return AGN_JV_QUEUED; }
    if (status == AGNOSAI_STATUS_RUNNING) { return AGN_JV_RUNNING; }
    if (status == AGNOSAI_STATUS_COMPLETED) { return AGN_JV_COMPLETED; }
    if (status == AGNOSAI_STATUS_FAILED) { return AGN_JV_FAILED; }
    if (status == AGNOSAI_STATUS_CANCELLED) { return AGN_JV_CANCELLED; }
    return AGN_JV_PENDING;
}

# The snake_case wire spelling of a lifecycle status (global-allocator form).
fn agnosai_task_status_to_wire(status): i64 {
    return agnosai_task_status_to_wire_a(default_alloc(), status);
}

# A lifecycle status from its wire spelling. Unknown spellings fall back to the
# oracle's default, Pending.
fn agnosai_task_status_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "queued") == 1) { return AGNOSAI_STATUS_QUEUED; }
    if (str_eq_cstr(s, "running") == 1) { return AGNOSAI_STATUS_RUNNING; }
    if (str_eq_cstr(s, "completed") == 1) { return AGNOSAI_STATUS_COMPLETED; }
    if (str_eq_cstr(s, "failed") == 1) { return AGNOSAI_STATUS_FAILED; }
    if (str_eq_cstr(s, "cancelled") == 1) { return AGNOSAI_STATUS_CANCELLED; }
    return AGNOSAI_STATUS_PENDING;
}

# Execute tasks one after another in order.
fn agnosai_process_sequential(): i64 {
    var p = alloc(AGN_PROC_SIZE);
    store64(p + AGN_PROC_KIND, AGNOSAI_PROCESS_SEQUENTIAL);
    store64(p + AGN_PROC_MANAGER, 0);
    store64(p + AGN_PROC_MAX_CONCURRENCY, 0);
    return p;
}

# A manager agent delegates and coordinates sub-tasks.
fn agnosai_process_hierarchical(manager): i64 {
    var p = alloc(AGN_PROC_SIZE);
    store64(p + AGN_PROC_KIND, AGNOSAI_PROCESS_HIERARCHICAL);
    store64(p + AGN_PROC_MANAGER, manager);
    store64(p + AGN_PROC_MAX_CONCURRENCY, 0);
    return p;
}

# Execute respecting a directed acyclic graph of dependencies.
fn agnosai_process_dag(): i64 {
    var p = alloc(AGN_PROC_SIZE);
    store64(p + AGN_PROC_KIND, AGNOSAI_PROCESS_DAG);
    store64(p + AGN_PROC_MANAGER, 0);
    store64(p + AGN_PROC_MAX_CONCURRENCY, 0);
    return p;
}

# Execute tasks concurrently up to a concurrency limit.
fn agnosai_process_parallel(max_concurrency): i64 {
    var p = alloc(AGN_PROC_SIZE);
    store64(p + AGN_PROC_KIND, AGNOSAI_PROCESS_PARALLEL);
    store64(p + AGN_PROC_MANAGER, 0);
    store64(p + AGN_PROC_MAX_CONCURRENCY, max_concurrency);
    return p;
}

# Which execution mode this is.
fn agnosai_process_kind(p): i64 {
    return load64(p + AGN_PROC_KIND);
}

# The delegating manager's agent id, or 0 unless this is Hierarchical.
fn agnosai_process_manager(p): i64 {
    return load64(p + AGN_PROC_MANAGER);
}

# The concurrency ceiling, or 0 unless this is Parallel.
fn agnosai_process_max_concurrency(p): i64 {
    return load64(p + AGN_PROC_MAX_CONCURRENCY);
}

# A process mode as a bayan JSON value. Unit variants are bare snake_case
# strings; the two data-carrying variants are externally tagged.
fn agnosai_process_to_value_a(a, p): i64 {
    var kind = load64(p + AGN_PROC_KIND);
    if (kind == AGNOSAI_PROCESS_DAG) { return bayan_json_v_str_new_a(a, AGN_JV_DAG); }
    if (kind == AGNOSAI_PROCESS_HIERARCHICAL) {
        var inner = bayan_json_v_obj_new_a(a);
        var mgr = load64(p + AGN_PROC_MANAGER);
        bayan_json_v_obj_set_a(a, inner, AGN_JK_MANAGER, bayan_json_v_str_new_a(a, mgr));
        var outer = bayan_json_v_obj_new_a(a);
        bayan_json_v_obj_set_a(a, outer, AGN_JV_HIERARCHICAL, inner);
        return outer;
    }
    if (kind == AGNOSAI_PROCESS_PARALLEL) {
        var pinner = bayan_json_v_obj_new_a(a);
        var cap = bayan_json_v_int_new_a(a, load64(p + AGN_PROC_MAX_CONCURRENCY));
        bayan_json_v_obj_set_a(a, pinner, AGN_JK_MAX_CONCURRENCY, cap);
        var pouter = bayan_json_v_obj_new_a(a);
        bayan_json_v_obj_set_a(a, pouter, AGN_JV_PARALLEL, pinner);
        return pouter;
    }
    return bayan_json_v_str_new_a(a, AGN_JV_SEQUENTIAL);
}

# Global-allocator form of `agnosai_process_to_value_a`.
fn agnosai_process_to_value(p): i64 {
    return agnosai_process_to_value_a(default_alloc(), p);
}

# Rebuild a process mode from its JSON value. Anything unrecognized falls back
# to the oracle's default, Sequential.
fn agnosai_process_from_value(v): i64 {
    if (bayan_json_v_is_str(v) == 1) {
        if (str_eq_cstr(bayan_json_v_str(v), "dag") == 1) { return agnosai_process_dag(); }
        return agnosai_process_sequential();
    }
    if (bayan_json_v_is_obj(v) == 0) { return agnosai_process_sequential(); }

    var h = bayan_json_v_obj_get(v, "hierarchical");
    if (h != 0 && bayan_json_v_is_obj(h) == 1) {
        var m = bayan_json_v_obj_get(h, "manager");
        if (m != 0 && bayan_json_v_is_str(m) == 1) {
            var id = agnosai_uuid_canonical(bayan_json_v_str(m));
            if (id != 0) { return agnosai_process_hierarchical(id); }
        }
        return agnosai_process_sequential();
    }

    var par = bayan_json_v_obj_get(v, "parallel");
    if (par != 0 && bayan_json_v_is_obj(par) == 1) {
        var mc = bayan_json_v_obj_get(par, "max_concurrency");
        if (mc != 0 && bayan_json_v_is_int(mc) == 1) {
            return agnosai_process_parallel(bayan_json_v_int(mc));
        }
    }
    return agnosai_process_sequential();
}

# Create a new task with a description. Every other field takes the oracle's
# default: no expected output, unassigned, Normal priority, Pending, Low risk.
fn agnosai_task_new(description: Str): i64 {
    var t = alloc(AGN_TASK_SIZE);
    store64(t + AGN_TASK_ID, agnosai_uuid_v4_str());
    store64(t + AGN_TASK_DESCRIPTION, description);
    store64(t + AGN_TASK_EXPECTED_OUTPUT, 0);
    store64(t + AGN_TASK_ASSIGNED_AGENT, 0);
    store64(t + AGN_TASK_PRIORITY, AGNOSAI_PRIORITY_NORMAL);
    store64(t + AGN_TASK_STATUS, AGNOSAI_STATUS_PENDING);
    store64(t + AGN_TASK_DEPENDENCIES, vec_new());
    store64(t + AGN_TASK_CONTEXT, map_new_str());
    store64(t + AGN_TASK_RISK, AGNOSAI_RISK_LOW);
    store64(t + AGN_TASK_OUTPUT_SCHEMA, 0);
    return t;
}

# Set the expected output. Returns the task so calls chain.
fn agnosai_task_with_expected_output(t, output: Str): i64 {
    store64(t + AGN_TASK_EXPECTED_OUTPUT, output);
    return t;
}

# Set the risk level for human-in-the-loop gating. Returns the task.
fn agnosai_task_with_risk(t, risk): i64 {
    store64(t + AGN_TASK_RISK, risk);
    return t;
}

# Set a JSON Schema for output validation with retry. Returns the task.
fn agnosai_task_with_output_schema(t, schema): i64 {
    store64(t + AGN_TASK_OUTPUT_SCHEMA, schema);
    return t;
}

# Set the task priority. Returns the task.
fn agnosai_task_with_priority(t, priority): i64 {
    store64(t + AGN_TASK_PRIORITY, priority);
    return t;
}

# Assign an agent to execute this task. Returns the task.
fn agnosai_task_with_agent(t, agent_id): i64 {
    store64(t + AGN_TASK_ASSIGNED_AGENT, agent_id);
    return t;
}

# Set the lifecycle status. Returns the task.
fn agnosai_task_with_status(t, status): i64 {
    store64(t + AGN_TASK_STATUS, status);
    return t;
}

# Add a dependency on another task. Returns the task.
fn agnosai_task_with_dependency(t, dep): i64 {
    vec_push(load64(t + AGN_TASK_DEPENDENCIES), dep);
    return t;
}

# Add a context key-value pair. `value` is a bayan JSON value. Returns the task.
fn agnosai_task_with_context(t, key: Str, value): i64 {
    map_set(load64(t + AGN_TASK_CONTEXT), str_clone(key), value);
    return t;
}

# Unique task identifier.
fn agnosai_task_id(t): i64 {
    return load64(t + AGN_TASK_ID);
}

# Human-readable description of the task.
fn agnosai_task_description(t): i64 {
    return load64(t + AGN_TASK_DESCRIPTION);
}

# Description of the expected output format, or 0 when unset.
fn agnosai_task_expected_output(t): i64 {
    return load64(t + AGN_TASK_EXPECTED_OUTPUT);
}

# Agent assigned to execute this task, or 0 when unassigned.
fn agnosai_task_assigned_agent(t): i64 {
    return load64(t + AGN_TASK_ASSIGNED_AGENT);
}

# Execution priority tier.
fn agnosai_task_priority(t): i64 {
    return load64(t + AGN_TASK_PRIORITY);
}

# Current execution status.
fn agnosai_task_status(t): i64 {
    return load64(t + AGN_TASK_STATUS);
}

# Vec of task ids that must complete before this one.
fn agnosai_task_dependencies(t): i64 {
    return load64(t + AGN_TASK_DEPENDENCIES);
}

# Str-keyed map of arbitrary context passed to the executing agent.
fn agnosai_task_context(t): i64 {
    return load64(t + AGN_TASK_CONTEXT);
}

# Risk level for human-in-the-loop approval gating.
fn agnosai_task_risk(t): i64 {
    return load64(t + AGN_TASK_RISK);
}

# JSON Schema the task output must conform to, or 0 when unset.
fn agnosai_task_output_schema(t): i64 {
    return load64(t + AGN_TASK_OUTPUT_SCHEMA);
}

# The task as a bayan JSON value, fields in the oracle's declaration order.
# Serialize a task to a bayan JSON value.
#
# The `_a` form is the real body: every cell, every key Str and every wire
# spelling comes from `a`, so a per-request arena reclaims the entire tree on
# `reset_via`. Complete only since bayan 1.4.0 / cyrius 6.5.5 — before that
# `obj_set`, the parse and the serializer had no `_a`, so an arena covered part
# of a response and the rest leaked.
fn agnosai_task_to_value_a(a, t): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, AGN_JK_ID,
      bayan_json_v_str_new_a(a, load64(t + AGN_TASK_ID)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_DESCRIPTION,
      bayan_json_v_str_new_a(a, load64(t + AGN_TASK_DESCRIPTION)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_EXPECTED_OUTPUT,
      _agnosai_opt_str_to_value_a(a, load64(t + AGN_TASK_EXPECTED_OUTPUT)));

    var agent = load64(t + AGN_TASK_ASSIGNED_AGENT);
    var agent_v = bayan_json_v_null_a(a);
    if (agent != 0) { agent_v = bayan_json_v_str_new_a(a, agent); }
    bayan_json_v_obj_set_a(a, obj, AGN_JK_ASSIGNED_AGENT, agent_v);

    bayan_json_v_obj_set_a(a, obj, AGN_JK_PRIORITY,
      bayan_json_v_str_new_a(a, agnosai_task_priority_to_wire_a(a, load64(t + AGN_TASK_PRIORITY))));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_STATUS,
      bayan_json_v_str_new_a(a, agnosai_task_status_to_wire_a(a, load64(t + AGN_TASK_STATUS))));

    var deps = load64(t + AGN_TASK_DEPENDENCIES);
    var deps_v = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(deps); i = i + 1) {
        bayan_json_v_arr_push_a(a, deps_v, bayan_json_v_str_new_a(a, vec_get(deps, i)));
    }
    bayan_json_v_obj_set_a(a, obj, AGN_JK_DEPENDENCIES, deps_v);

    bayan_json_v_obj_set_a(a, obj, AGN_JK_CONTEXT, _agnosai_map_to_value_a(a, load64(t + AGN_TASK_CONTEXT)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_RISK,
      bayan_json_v_str_new_a(a, agnosai_task_risk_to_wire_a(a, load64(t + AGN_TASK_RISK))));

    var schema = load64(t + AGN_TASK_OUTPUT_SCHEMA);
    if (schema == 0) { schema = bayan_json_v_null_a(a); }
    bayan_json_v_obj_set_a(a, obj, AGN_JK_OUTPUT_SCHEMA, schema);
    return obj;
}

# Back-compat wrapper — allocates the whole tree on the global bump.
fn agnosai_task_to_value(t): i64 {
    return agnosai_task_to_value_a(default_alloc(), t);
}

# Rebuild a task from a bayan JSON value. Every field but `id` and
# `description` is `#[serde(default)]` in the oracle, so a missing one takes
# the default rather than failing. Returns 0 when the value is not an object or
# `id` is missing or malformed.
fn agnosai_task_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var id_v = bayan_json_v_obj_get(v, "id");
    if (id_v == 0 || bayan_json_v_is_str(id_v) == 0) { return 0; }
    var id = agnosai_uuid_canonical(bayan_json_v_str(id_v));
    if (id == 0) { return 0; }

    # ⚠ **`description` is REQUIRED.** `Task.description: String` carries no
    # `#[serde(default)]` (`rust-old/src/core/task.rs:17`), so serde_json fails
    # the whole value with `missing field "description"`. The port substituted an
    # empty string and returned a valid task, which turns a malformed persisted
    # record — or a malformed request body — into a task that silently does
    # nothing, instead of an error the caller can see. `id` is already required
    # for the same reason; this makes the two agree.
    var desc_v = bayan_json_v_obj_get(v, "description");
    if (desc_v == 0 || bayan_json_v_is_str(desc_v) == 0) { return 0; }
    var desc = bayan_json_v_str(desc_v);

    var t = agnosai_task_new(desc);
    store64(t + AGN_TASK_ID, id);

    var eo = bayan_json_v_obj_get(v, "expected_output");
    if (eo != 0 && bayan_json_v_is_str(eo) == 1) {
        store64(t + AGN_TASK_EXPECTED_OUTPUT, bayan_json_v_str(eo));
    }

    # ⚠ A present-but-unparseable `assigned_agent` is an ERROR, not "unassigned".
    # The oracle types it `Option<Uuid>`, so serde rejects a string that is not a
    # UUID; the port stored `agnosai_uuid_canonical`'s 0 and later read it as
    # unassigned, silently detaching a task from the agent the record named.
    var aa = bayan_json_v_obj_get(v, "assigned_agent");
    if (aa != 0 && bayan_json_v_is_str(aa) == 1) {
        var agent_id = agnosai_uuid_canonical(bayan_json_v_str(aa));
        if (agent_id == 0) { return 0; }
        store64(t + AGN_TASK_ASSIGNED_AGENT, agent_id);
    }

    var pr = bayan_json_v_obj_get(v, "priority");
    if (pr != 0 && bayan_json_v_is_str(pr) == 1) {
        store64(t + AGN_TASK_PRIORITY, agnosai_task_priority_from_wire(bayan_json_v_str(pr)));
    }

    var st = bayan_json_v_obj_get(v, "status");
    if (st != 0 && bayan_json_v_is_str(st) == 1) {
        store64(t + AGN_TASK_STATUS, agnosai_task_status_from_wire(bayan_json_v_str(st)));
    }

    var dv = bayan_json_v_obj_get(v, "dependencies");
    if (dv != 0 && bayan_json_v_is_arr(dv) == 1) {
        var deps = load64(t + AGN_TASK_DEPENDENCIES);
        for (var i = 0; i < bayan_json_v_arr_len(dv); i = i + 1) {
            var e = bayan_json_v_arr_get(dv, i);
            if (bayan_json_v_is_str(e) == 1) {
                var did = agnosai_uuid_canonical(bayan_json_v_str(e));
                if (did != 0) { vec_push(deps, did); }
            }
        }
    }

    store64(t + AGN_TASK_CONTEXT, _agnosai_map_from_value(bayan_json_v_obj_get(v, "context")));

    var rk = bayan_json_v_obj_get(v, "risk");
    if (rk != 0 && bayan_json_v_is_str(rk) == 1) {
        store64(t + AGN_TASK_RISK, agnosai_task_risk_from_wire(bayan_json_v_str(rk)));
    }

    var os = bayan_json_v_obj_get(v, "output_schema");
    if (os != 0 && bayan_json_v_is_null(os) == 0) {
        store64(t + AGN_TASK_OUTPUT_SCHEMA, os);
    }
    return t;
}

# The task serialized to JSON text.
# Serialize a task to JSON text.
#
# `_a` routes BOTH halves through the arena — the value tree and the serializer's
# builder. `bayan_json_v_build_a` is new in bayan 1.4.0; before it the tree could
# be arena'd but the text could not, which is why the residual was 36% rather
# than zero.
fn agnosai_task_to_json_a(a, t): i64 {
    return bayan_json_v_build_a(a, agnosai_task_to_value_a(a, t));
}

# Serialize a task to JSON text on the global allocator (back-compat form).
fn agnosai_task_to_json(t): i64 {
    return bayan_json_v_build(agnosai_task_to_value(t));
}

# Parse a task from JSON text. Returns 0 on a parse error or a malformed task.
# See core_message.cyr for why this calls `bayan_json_v_parse_buf` rather than
# the bare entry — it switches at the next bayan fold-in.
fn agnosai_task_from_json(src: Str): i64 {
    var v = bayan_json_v_parse_buf(str_data(src), str_len(src));
    if (v == 0) { return 0; }
    return agnosai_task_from_value(v);
}

# Create a result produced by executing a task.
fn agnosai_task_result_new(task_id, output: Str, status): i64 {
    var r = alloc(AGN_TRES_SIZE);
    store64(r + AGN_TRES_TASK_ID, task_id);
    store64(r + AGN_TRES_OUTPUT, output);
    store64(r + AGN_TRES_STATUS, status);
    store64(r + AGN_TRES_METADATA, map_new_str());
    return r;
}

# ID of the task that produced this result.
fn agnosai_task_result_task_id(r): i64 {
    return load64(r + AGN_TRES_TASK_ID);
}

# Output text or data from execution.
fn agnosai_task_result_output(r): i64 {
    return load64(r + AGN_TRES_OUTPUT);
}

# Final status of the task.
fn agnosai_task_result_status(r): i64 {
    return load64(r + AGN_TRES_STATUS);
}

# Str-keyed map of metadata attached to the result.
fn agnosai_task_result_metadata(r): i64 {
    return load64(r + AGN_TRES_METADATA);
}

# Attach a metadata key-value pair. `value` is a bayan JSON value.
fn agnosai_task_result_with_metadata(r, key: Str, value): i64 {
    map_set(load64(r + AGN_TRES_METADATA), str_clone(key), value);
    return r;
}

# The result as a bayan JSON value, fields in declaration order.
fn agnosai_task_result_to_value_a(a, r): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, AGN_JK_TASK_ID,
      bayan_json_v_str_new_a(a, load64(r + AGN_TRES_TASK_ID)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_OUTPUT,
      bayan_json_v_str_new_a(a, load64(r + AGN_TRES_OUTPUT)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_STATUS,
      bayan_json_v_str_new_a(a, agnosai_task_status_to_wire_a(a, load64(r + AGN_TRES_STATUS))));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_METADATA,
      _agnosai_map_to_value_a(a, load64(r + AGN_TRES_METADATA)));
    return obj;
}

# Global-allocator form of `agnosai_task_result_to_value_a`.
fn agnosai_task_result_to_value(r): i64 {
    return agnosai_task_result_to_value_a(default_alloc(), r);
}

# Rebuild a result from a bayan JSON value. Returns 0 when `task_id` is missing
# or malformed.
fn agnosai_task_result_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var tid_v = bayan_json_v_obj_get(v, "task_id");
    if (tid_v == 0 || bayan_json_v_is_str(tid_v) == 0) { return 0; }
    var tid = agnosai_uuid_canonical(bayan_json_v_str(tid_v));
    if (tid == 0) { return 0; }

    # ⚠ **`output` and `status` are REQUIRED.** Only `metadata` carries
    # `#[serde(default)]` on `TaskResult` (`task.rs:169`), so serde rejects a
    # record missing either of the other two. Defaulting `status` to Pending was
    # the worse half: a completed result whose status field was lost on the wire
    # came back as still-pending, which reads as work that never finished.
    var ov = bayan_json_v_obj_get(v, "output");
    if (ov == 0 || bayan_json_v_is_str(ov) == 0) { return 0; }
    var output = bayan_json_v_str(ov);

    var sv = bayan_json_v_obj_get(v, "status");
    if (sv == 0 || bayan_json_v_is_str(sv) == 0) { return 0; }
    var status = agnosai_task_status_from_wire(bayan_json_v_str(sv));

    var r = agnosai_task_result_new(tid, output, status);
    store64(r + AGN_TRES_METADATA, _agnosai_map_from_value(bayan_json_v_obj_get(v, "metadata")));
    return r;
}

# Create a new DAG. `tasks` is a Str-keyed map of task pointers, `edges` a vec
# of (from, to) pairs, `process` a process mode.
fn agnosai_task_dag_new(tasks, edges, process): i64 {
    var d = alloc(AGN_DAG_SIZE);
    store64(d + AGN_DAG_TASKS, tasks);
    store64(d + AGN_DAG_EDGES, edges);
    store64(d + AGN_DAG_PROCESS, process);
    return d;
}

# A (from, to) edge pair.
fn agnosai_edge_new(from: Str, to: Str): i64 {
    var e = alloc(AGN_EDGE_SIZE);
    store64(e + AGN_EDGE_FROM, from);
    store64(e + AGN_EDGE_TO, to);
    return e;
}

# The source end of an edge.
fn agnosai_edge_from(e): i64 {
    return load64(e + AGN_EDGE_FROM);
}

# The destination end of an edge.
fn agnosai_edge_to(e): i64 {
    return load64(e + AGN_EDGE_TO);
}

# Str-keyed map of the DAG's tasks.
fn agnosai_task_dag_tasks(d): i64 {
    return load64(d + AGN_DAG_TASKS);
}

# Vec of the DAG's (from, to) edges.
fn agnosai_task_dag_edges(d): i64 {
    return load64(d + AGN_DAG_EDGES);
}

# The DAG's execution mode.
fn agnosai_task_dag_process(d): i64 {
    return load64(d + AGN_DAG_PROCESS);
}

# The DAG as a bayan JSON value. Edges emit as two-element arrays, matching
# serde's rendering of a `(String, String)` tuple.
fn agnosai_task_dag_to_value_a(a, d): i64 {
    var obj = bayan_json_v_obj_new_a(a);

    var tasks = load64(d + AGN_DAG_TASKS);
    var tasks_v = bayan_json_v_obj_new_a(a);
    # Slot walk, not map_keys — see _agnosai_map_slots in src/core/json.cyr.
    var tn = _agnosai_map_slots(tasks);
    for (var i = 0; i < tn; i = i + 1) {
        if (_agnosai_map_slot_live(tasks, i) == 1) {
            bayan_json_v_obj_set_a(a, tasks_v, _agnosai_map_slot_key(tasks, i),
              agnosai_task_to_value_a(a, _agnosai_map_slot_val(tasks, i)));
        }
    }
    bayan_json_v_obj_set_a(a, obj, AGN_JK_TASKS, tasks_v);

    var edges = load64(d + AGN_DAG_EDGES);
    var edges_v = bayan_json_v_arr_new_a(a);
    for (var j = 0; j < vec_len(edges); j = j + 1) {
        var e = vec_get(edges, j);
        var pair = bayan_json_v_arr_new_a(a);
        bayan_json_v_arr_push_a(a, pair, bayan_json_v_str_new_a(a, load64(e + AGN_EDGE_FROM)));
        bayan_json_v_arr_push_a(a, pair, bayan_json_v_str_new_a(a, load64(e + AGN_EDGE_TO)));
        bayan_json_v_arr_push_a(a, edges_v, pair);
    }
    bayan_json_v_obj_set_a(a, obj, AGN_JK_EDGES, edges_v);

    bayan_json_v_obj_set_a(a, obj, AGN_JK_PROCESS,
      agnosai_process_to_value_a(a, load64(d + AGN_DAG_PROCESS)));
    return obj;
}

# Global-allocator form of `agnosai_task_dag_to_value_a`.
fn agnosai_task_dag_to_value(d): i64 {
    return agnosai_task_dag_to_value_a(default_alloc(), d);
}

# Rebuild a DAG from a bayan JSON value. Returns 0 when the value is not an
# object; missing `tasks`/`edges`/`process` take empty/default values.
fn agnosai_task_dag_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }

    var tasks = map_new_str();
    var tv = bayan_json_v_obj_get(v, "tasks");
    if (tv != 0 && bayan_json_v_is_obj(tv) == 1) {
        for (var i = 0; i < bayan_json_v_obj_len(tv); i = i + 1) {
            var t = agnosai_task_from_value(bayan_json_v_obj_val(tv, i));
            if (t != 0) { map_set(tasks, str_clone(bayan_json_v_obj_key(tv, i)), t); }
        }
    }

    var edges = vec_new();
    var ev = bayan_json_v_obj_get(v, "edges");
    if (ev != 0 && bayan_json_v_is_arr(ev) == 1) {
        for (var j = 0; j < bayan_json_v_arr_len(ev); j = j + 1) {
            var pair = bayan_json_v_arr_get(ev, j);
            if (bayan_json_v_is_arr(pair) == 1 && bayan_json_v_arr_len(pair) == 2) {
                var a = bayan_json_v_arr_get(pair, 0);
                var b = bayan_json_v_arr_get(pair, 1);
                if (bayan_json_v_is_str(a) == 1 && bayan_json_v_is_str(b) == 1) {
                    vec_push(edges, agnosai_edge_new(bayan_json_v_str(a), bayan_json_v_str(b)));
                }
            }
        }
    }

    var pv = bayan_json_v_obj_get(v, "process");
    var process = agnosai_process_sequential();
    if (pv != 0) { process = agnosai_process_from_value(pv); }

    return agnosai_task_dag_new(tasks, edges, process);
}

# --- agent.cyr ---

# =========================================================================
# core/agent — agent definitions and runtime state.
#
# Origin: rust-old/src/core/agent.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * **`personality` is not ported yet.** It needs bhava, which has no Cyrius
#     port yet (roadmap B5), so there is no field and no `with_personality`. The
#     wire form still emits
#     `"personality": null`, which is exactly what the default Rust build
#     emitted (bhava is a hard dep there, so the `Option` was always present
#     and always `None` unless explicitly set). Incoming `personality` is
#     accepted and ignored. This keeps the default-build wire shape byte-exact
#     rather than changing the shape — port plan open question 2, resolved the
#     conservative way; say so if you want the field dropped from the wire.
#   * `Option<String>` fields are 0 when absent; `gpu_memory_min_mb` uses
#     AGNOSAI_NO_LIMIT, matching core_resource's convention.
#   * `from_json` returns 0 rather than a `Result`. The four required fields
#     (`agent_key`, `name`, `role`, `goal`) are genuinely required — the oracle
#     has no `#[serde(default)]` on them, so a missing one is a parse failure.
# =========================================================================

# Runtime state of an agent instance.
enum AgnosaiAgentState {
    AGNOSAI_AGENT_IDLE = 0;
    AGNOSAI_AGENT_ASSIGNED = 1;
    AGNOSAI_AGENT_WORKING = 2;
    AGNOSAI_AGENT_BLOCKED = 3;
    AGNOSAI_AGENT_COMPLETED = 4;
    AGNOSAI_AGENT_FAILED = 5;
}

# AgentDefinition heap layout — 104 bytes.
enum AgnosaiAgentDefOff {
    AGN_AGENT_KEY = 0;
    AGN_AGENT_NAME = 8;
    AGN_AGENT_ROLE = 16;
    AGN_AGENT_GOAL = 24;
    AGN_AGENT_BACKSTORY = 32;
    AGN_AGENT_DOMAIN = 40;
    AGN_AGENT_TOOLS = 48;
    AGN_AGENT_COMPLEXITY = 56;
    AGN_AGENT_LLM_MODEL = 64;
    AGN_AGENT_GPU_REQUIRED = 72;
    AGN_AGENT_GPU_PREFERRED = 80;
    AGN_AGENT_GPU_MEMORY_MIN_MB = 88;
    AGN_AGENT_HARDWARE = 96;
    AGN_AGENT_SIZE = 104;
}

# The oracle's `default_complexity()`.
fn agnosai_default_complexity(): i64 {
    return str_from("medium");
}

# The snake_case wire spelling of an agent state.
fn agnosai_agent_state_to_wire_a(a, state): i64 {
    if (state == AGNOSAI_AGENT_ASSIGNED) { return AGN_JV_ASSIGNED; }
    if (state == AGNOSAI_AGENT_WORKING) { return AGN_JV_WORKING; }
    if (state == AGNOSAI_AGENT_BLOCKED) { return AGN_JV_BLOCKED; }
    if (state == AGNOSAI_AGENT_COMPLETED) { return AGN_JV_COMPLETED; }
    if (state == AGNOSAI_AGENT_FAILED) { return AGN_JV_FAILED; }
    return AGN_JV_IDLE;
}

# Global-allocator form of `agnosai_agent_state_to_wire_a`.
fn agnosai_agent_state_to_wire(state): i64 {
    return agnosai_agent_state_to_wire_a(default_alloc(), state);
}

# An agent state from its wire spelling. Unknown spellings fall back to the
# oracle's default, Idle.
fn agnosai_agent_state_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "assigned") == 1) { return AGNOSAI_AGENT_ASSIGNED; }
    if (str_eq_cstr(s, "working") == 1) { return AGNOSAI_AGENT_WORKING; }
    if (str_eq_cstr(s, "blocked") == 1) { return AGNOSAI_AGENT_BLOCKED; }
    if (str_eq_cstr(s, "completed") == 1) { return AGNOSAI_AGENT_COMPLETED; }
    if (str_eq_cstr(s, "failed") == 1) { return AGNOSAI_AGENT_FAILED; }
    return AGNOSAI_AGENT_IDLE;
}

# Create a minimal agent definition. `name` defaults to `agent_key`, matching
# the oracle's `Self { name: key.clone(), agent_key: key, .. }`.
fn agnosai_agent_new_a(al, agent_key: Str, role: Str, goal: Str): i64 {
    var a = alloc_via(al, AGN_AGENT_SIZE);
    store64(a + AGN_AGENT_KEY, agent_key);
    store64(a + AGN_AGENT_NAME, agent_key);
    store64(a + AGN_AGENT_ROLE, role);
    store64(a + AGN_AGENT_GOAL, goal);
    store64(a + AGN_AGENT_BACKSTORY, 0);
    store64(a + AGN_AGENT_DOMAIN, 0);
    store64(a + AGN_AGENT_TOOLS, vec_new_a(al));
    store64(a + AGN_AGENT_COMPLEXITY, agnosai_default_complexity());
    store64(a + AGN_AGENT_LLM_MODEL, 0);
    store64(a + AGN_AGENT_GPU_REQUIRED, 0);
    store64(a + AGN_AGENT_GPU_PREFERRED, 0);
    store64(a + AGN_AGENT_GPU_MEMORY_MIN_MB, AGNOSAI_NO_LIMIT);
    store64(a + AGN_AGENT_HARDWARE, 0);
    return a;
}

# Global-allocator form of `agnosai_agent_new_a`.
#
# **The three Strs are stored, not copied** — the agent borrows whatever the
# caller passed. That is right for a constructor and is why
# `agnosai_agent_from_value_a` exists separately: deserialisation is the one
# caller whose inputs belong to a parse tree it does not control.
fn agnosai_agent_new(agent_key: Str, role: Str, goal: Str): i64 {
    return agnosai_agent_new_a(default_alloc(), agent_key, role, goal);
}

# Set the agent's tool list (a vec of Str). Returns the agent.
fn agnosai_agent_with_tools(a, tools): i64 {
    store64(a + AGN_AGENT_TOOLS, tools);
    return a;
}

# Set the agent's domain. Returns the agent.
fn agnosai_agent_with_domain(a, domain: Str): i64 {
    store64(a + AGN_AGENT_DOMAIN, domain);
    return a;
}

# Set the agent's display name (defaults to agent_key). Returns the agent.
fn agnosai_agent_with_name(a, name: Str): i64 {
    store64(a + AGN_AGENT_NAME, name);
    return a;
}

# Set hardware requirements. Returns the agent.
fn agnosai_agent_with_hardware(a, hw): i64 {
    store64(a + AGN_AGENT_HARDWARE, hw);
    return a;
}

# Set the narrative backstory used for prompt context. Returns the agent.
fn agnosai_agent_with_backstory(a, backstory: Str): i64 {
    store64(a + AGN_AGENT_BACKSTORY, backstory);
    return a;
}

# Set the complexity tier ("low" / "medium" / "high"). Returns the agent.
fn agnosai_agent_with_complexity(a, complexity: Str): i64 {
    store64(a + AGN_AGENT_COMPLEXITY, complexity);
    return a;
}

# Set an override LLM model identifier. Returns the agent.
fn agnosai_agent_with_llm_model(a, model: Str): i64 {
    store64(a + AGN_AGENT_LLM_MODEL, model);
    return a;
}

# Set the legacy GPU hints. Prefer agnosai_agent_with_hardware.
fn agnosai_agent_with_gpu(a, required, preferred, memory_min_mb): i64 {
    store64(a + AGN_AGENT_GPU_REQUIRED, required);
    store64(a + AGN_AGENT_GPU_PREFERRED, preferred);
    store64(a + AGN_AGENT_GPU_MEMORY_MIN_MB, memory_min_mb);
    return a;
}

# Unique key identifying this agent type.
fn agnosai_agent_key(a): i64 {
    return load64(a + AGN_AGENT_KEY);
}

# Display name of the agent.
fn agnosai_agent_name(a): i64 {
    return load64(a + AGN_AGENT_NAME);
}

# Role the agent fulfils within a crew.
fn agnosai_agent_role(a): i64 {
    return load64(a + AGN_AGENT_ROLE);
}

# High-level objective for the agent.
fn agnosai_agent_goal(a): i64 {
    return load64(a + AGN_AGENT_GOAL);
}

# Narrative backstory for prompt context, or 0 when unset.
fn agnosai_agent_backstory(a): i64 {
    return load64(a + AGN_AGENT_BACKSTORY);
}

# Domain of expertise, or 0 when unset.
fn agnosai_agent_domain(a): i64 {
    return load64(a + AGN_AGENT_DOMAIN);
}

# Vec of tool names this agent is allowed to use.
fn agnosai_agent_tools(a): i64 {
    return load64(a + AGN_AGENT_TOOLS);
}

# Complexity tier ("low", "medium", "high").
fn agnosai_agent_complexity(a): i64 {
    return load64(a + AGN_AGENT_COMPLEXITY);
}

# Override LLM model identifier, or 0 when unset.
fn agnosai_agent_llm_model(a): i64 {
    return load64(a + AGN_AGENT_LLM_MODEL);
}

# Legacy GPU-required flag. Prefer the hardware field.
fn agnosai_agent_gpu_required(a): i64 {
    return load64(a + AGN_AGENT_GPU_REQUIRED);
}

# Legacy GPU-preferred flag. Prefer the hardware field.
fn agnosai_agent_gpu_preferred(a): i64 {
    return load64(a + AGN_AGENT_GPU_PREFERRED);
}

# Legacy minimum GPU memory in MB, or AGNOSAI_NO_LIMIT when unset.
fn agnosai_agent_gpu_memory_min_mb(a): i64 {
    return load64(a + AGN_AGENT_GPU_MEMORY_MIN_MB);
}

# Explicit hardware requirement, or 0 when unset.
fn agnosai_agent_hardware(a): i64 {
    return load64(a + AGN_AGENT_HARDWARE);
}

# The agent's hardware requirement.
#
# Prefers the explicit `hardware` field; otherwise falls back to the legacy GPU
# fields. The fallback is the oracle's exactly: a `gpu_required` agent asks for
# Cuda **or** Rocm, and `gpu_memory_min_mb` only applies inside that branch —
# a min-memory hint on an agent that does not require a GPU is ignored.
fn agnosai_agent_hardware_requirement(a): i64 {
    var hw = load64(a + AGN_AGENT_HARDWARE);
    if (hw != 0) { return hw; }

    var req = agnosai_hw_requirement_new();
    if (load64(a + AGN_AGENT_GPU_REQUIRED) == 1) {
        var accels = load64(req + AGN_REQ_ACCELERATORS);
        vec_push(accels, AGNOSAI_ACCEL_CUDA);
        vec_push(accels, AGNOSAI_ACCEL_ROCM);
        var min_mb = load64(a + AGN_AGENT_GPU_MEMORY_MIN_MB);
        if (min_mb != AGNOSAI_NO_LIMIT) { store64(req + AGN_REQ_MIN_MEMORY_MB, min_mb); }
    }
    return req;
}

# The agent definition as a bayan JSON value, fields in declaration order.
# `personality` is emitted as null — see the module note.
fn agnosai_agent_to_value_a(_al, a): i64 {
    var obj = bayan_json_v_obj_new_a(_al);
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "agent_key"),
      bayan_json_v_str_new_a(_al, load64(a + AGN_AGENT_KEY)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "name"), bayan_json_v_str_new_a(_al, load64(a + AGN_AGENT_NAME)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "role"), bayan_json_v_str_new_a(_al, load64(a + AGN_AGENT_ROLE)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "goal"), bayan_json_v_str_new_a(_al, load64(a + AGN_AGENT_GOAL)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "backstory"),
      _agnosai_opt_str_to_value_a(_al, load64(a + AGN_AGENT_BACKSTORY)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "domain"),
      _agnosai_opt_str_to_value_a(_al, load64(a + AGN_AGENT_DOMAIN)));

    var tools = load64(a + AGN_AGENT_TOOLS);
    var tools_v = bayan_json_v_arr_new_a(_al);
    for (var i = 0; i < vec_len(tools); i = i + 1) {
        bayan_json_v_arr_push_a(_al, tools_v, bayan_json_v_str_new_a(_al, vec_get(tools, i)));
    }
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "tools"), tools_v);

    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "complexity"),
      bayan_json_v_str_new_a(_al, load64(a + AGN_AGENT_COMPLEXITY)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "llm_model"),
      _agnosai_opt_str_to_value_a(_al, load64(a + AGN_AGENT_LLM_MODEL)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "gpu_required"),
      _agnosai_bool_to_value_a(_al, load64(a + AGN_AGENT_GPU_REQUIRED)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "gpu_preferred"),
      _agnosai_bool_to_value_a(_al, load64(a + AGN_AGENT_GPU_PREFERRED)));
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "gpu_memory_min_mb"),
      _agnosai_opt_int_to_value_a(_al, load64(a + AGN_AGENT_GPU_MEMORY_MIN_MB)));

    var hw = load64(a + AGN_AGENT_HARDWARE);
    var hw_v = bayan_json_v_null_a(_al);
    if (hw != 0) { hw_v = agnosai_hw_requirement_to_value_a(_al, hw); }
    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "hardware"), hw_v);

    bayan_json_v_obj_set_a(_al, obj, str_from_a(_al, "personality"), bayan_json_v_null_a(_al));
    return obj;
}

# Global-allocator form of `agnosai_agent_to_value_a`.
fn agnosai_agent_to_value(a): i64 {
    return agnosai_agent_to_value_a(default_alloc(), a);
}

# Rebuild an agent definition from a bayan JSON value. Returns 0 when the value
# is not an object or any of the four required fields is missing.
fn agnosai_agent_from_value_a(al, v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }

    var key_v = bayan_json_v_obj_get(v, "agent_key");
    var name_v = bayan_json_v_obj_get(v, "name");
    var role_v = bayan_json_v_obj_get(v, "role");
    var goal_v = bayan_json_v_obj_get(v, "goal");
    if (key_v == 0 || name_v == 0 || role_v == 0 || goal_v == 0) { return 0; }
    if (bayan_json_v_is_str(key_v) == 0 || bayan_json_v_is_str(name_v) == 0) { return 0; }
    if (bayan_json_v_is_str(role_v) == 0 || bayan_json_v_is_str(goal_v) == 0) { return 0; }

    var a = agnosai_agent_new_a(al, str_clone_a(al, bayan_json_v_str(key_v)),
      str_clone_a(al, bayan_json_v_str(role_v)), str_clone_a(al, bayan_json_v_str(goal_v)));
    store64(a + AGN_AGENT_NAME, str_clone_a(al, bayan_json_v_str(name_v)));

    var bs = bayan_json_v_obj_get(v, "backstory");
    if (bs != 0 && bayan_json_v_is_str(bs) == 1) {
        store64(a + AGN_AGENT_BACKSTORY, str_clone_a(al, bayan_json_v_str(bs)));
    }

    var dm = bayan_json_v_obj_get(v, "domain");
    if (dm != 0 && bayan_json_v_is_str(dm) == 1) {
        store64(a + AGN_AGENT_DOMAIN, str_clone_a(al, bayan_json_v_str(dm)));
    }

    var tv = bayan_json_v_obj_get(v, "tools");
    if (tv != 0 && bayan_json_v_is_arr(tv) == 1) {
        var tools = load64(a + AGN_AGENT_TOOLS);
        for (var i = 0; i < bayan_json_v_arr_len(tv); i = i + 1) {
            var e = bayan_json_v_arr_get(tv, i);
            if (bayan_json_v_is_str(e) == 1) {
                vec_push_a(al, tools, str_clone_a(al, bayan_json_v_str(e)));
            }
        }
    }

    var cx = bayan_json_v_obj_get(v, "complexity");
    if (cx != 0 && bayan_json_v_is_str(cx) == 1) {
        store64(a + AGN_AGENT_COMPLEXITY, str_clone_a(al, bayan_json_v_str(cx)));
    }

    var lm = bayan_json_v_obj_get(v, "llm_model");
    if (lm != 0 && bayan_json_v_is_str(lm) == 1) {
        store64(a + AGN_AGENT_LLM_MODEL, str_clone_a(al, bayan_json_v_str(lm)));
    }

    store64(a + AGN_AGENT_GPU_REQUIRED, _agnosai_bool_field(v, "gpu_required"));
    store64(a + AGN_AGENT_GPU_PREFERRED, _agnosai_bool_field(v, "gpu_preferred"));
    store64(a + AGN_AGENT_GPU_MEMORY_MIN_MB, _agnosai_opt_int_field(v, "gpu_memory_min_mb"));

    var hv = bayan_json_v_obj_get(v, "hardware");
    if (hv != 0 && bayan_json_v_is_obj(hv) == 1) {
        store64(a + AGN_AGENT_HARDWARE, agnosai_hw_requirement_from_value_a(al, hv));
    }
    return a;
}

# Global-allocator form of `agnosai_agent_from_value_a`.
#
# **Every Str is cloned into `al`; nothing is borrowed from `v`.** That is the
# whole point of the `_a` split here, and it is a correctness fix rather than an
# allocation tidy-up.
#
# Before it, this stored `bayan_json_v_str(key_v)` directly — so an agent
# deserialised from a request body *pointed into that body's parse tree*. With
# the parse tree on the no-free global bump that was invisible; with it on a
# per-request arena, `reset_via` reclaims the strings at end of request and the
# next request is handed the same bytes. A definition stored in
# `AppState.definitions` would silently take on whatever the next caller posted.
# It corrupts rather than crashing, which is why it needed a fix and not a
# comment.
#
# So callers now choose the lifetime explicitly:
#
#   * retaining the agent — `agnosai_route_create_definition` storing into
#     `AppState` — passes `default_alloc()`, and the agent outlives the request;
#   * using it and dropping it passes the request arena, and it is freed with
#     everything else.
#
# `tests/server_routes_agents.tcyr` pins both directions.
fn agnosai_agent_from_value(v): i64 {
    return agnosai_agent_from_value_a(default_alloc(), v);
}

# The agent definition serialized to JSON text.
fn agnosai_agent_to_json_a(_al, a): i64 {
    return bayan_json_v_build_a(_al, agnosai_agent_to_value_a(_al, a));
}

# Global-allocator form of `agnosai_agent_to_json_a`.
fn agnosai_agent_to_json(a): i64 {
    return agnosai_agent_to_json_a(default_alloc(), a);
}

# Deserialize an agent definition from JSON text. Returns 0 on a parse error or
# a missing required field — the oracle's `Result` `Err` arm.
# See core_message.cyr for why this calls `bayan_json_v_parse_buf`.
fn agnosai_agent_from_json(src: Str): i64 {
    var v = bayan_json_v_parse_buf(str_data(src), str_len(src));
    if (v == 0) { return 0; }
    return agnosai_agent_from_value(v);
}

# --- crew.cyr ---

# =========================================================================
# core/crew — crew specifications, runtime state and execution profiles.
#
# Origin: rust-old/src/core/crew.rs
#
# Port notes (divergences from the Rust shape, all deliberate):
#   * **Every cost field is integer micro-USD**, matching core_resource: the
#     oracle's `cost_usd: f64` and the two `HashMap<_, f64>` breakdowns become
#     i64 millionths of a dollar. They still serialize under their original
#     `*_usd` names as JSON numbers in dollars, so the wire is unchanged.
#   * The oracle's `skip_serializing_if` markers are honoured exactly, because
#     they are wire-visible: `profile`, `sandbox_strength` and the two cost maps
#     are **omitted** when empty/absent, and `cost_usd` is omitted when zero.
#     That last one also swallowed NaN and infinities in the oracle (`is_zero`
#     returns true for any non-finite value); integer micro-USD has no such
#     values, so the guard reduces to `== 0`.
#   * `HashMap<TaskId, _>` keys become the task's canonical UUID string, which
#     is what serde emitted for a Uuid map key.
# =========================================================================

# Lifecycle status of a crew execution.
enum AgnosaiCrewStatus {
    AGNOSAI_CREW_PENDING = 0;
    AGNOSAI_CREW_RUNNING = 1;
    AGNOSAI_CREW_COMPLETED = 2;
    AGNOSAI_CREW_FAILED = 3;
    AGNOSAI_CREW_CANCELLED = 4;
}

# CrewSpec heap layout — 56 bytes.
enum AgnosaiCrewSpecOff {
    AGN_CREW_ID = 0;
    AGN_CREW_NAME = 8;
    AGN_CREW_AGENTS = 16;
    AGN_CREW_TASKS = 24;
    AGN_CREW_PROCESS = 32;
    AGN_CREW_METADATA = 40;
    AGN_CREW_TRUST_LEVEL = 48;
    AGN_CREW_SIZE = 56;
}

# CrewState heap layout — 32 bytes.
enum AgnosaiCrewStateOff {
    AGN_CSTATE_CREW_ID = 0;
    AGN_CSTATE_STATUS = 8;
    AGN_CSTATE_RESULTS = 16;
    AGN_CSTATE_PROFILE = 24;
    AGN_CSTATE_SIZE = 32;
}

# CrewProfile heap layout — 56 bytes.
enum AgnosaiCrewProfileOff {
    AGN_PROF_WALL_MS = 0;
    AGN_PROF_TASK_MS = 8;
    AGN_PROF_TASK_COUNT = 16;
    AGN_PROF_COST_MICRO_USD = 24;
    AGN_PROF_AGENT_COST = 32;
    AGN_PROF_TASK_COST = 40;
    AGN_PROF_SANDBOX_STRENGTH = 48;
    AGN_PROF_SIZE = 56;
}

# The oracle's `default_trust_level()`.
fn agnosai_default_trust_level(): i64 {
    return str_from("basic");
}

# The two crew-spec keys no other module emits. The rest of this file's wire
# vocabulary is shared and lives in `core/json.cyr` — see the banner there.
var AGN_JK_AGENTS = str_from("agents");
var AGN_JK_TRUST_LEVEL = str_from("trust_level");

# The snake_case wire spelling of a crew status.
#
# `a` is unused: the answer is one of five process-lifetime `Str`s rather than a
# fresh allocation. The parameter stays because every `_a` caller passes it and
# because the bare form below must keep delegating — the signature is the API.
fn agnosai_crew_status_to_wire_a(a, status): i64 {
    if (status == AGNOSAI_CREW_RUNNING) { return AGN_JV_RUNNING; }
    if (status == AGNOSAI_CREW_COMPLETED) { return AGN_JV_COMPLETED; }
    if (status == AGNOSAI_CREW_FAILED) { return AGN_JV_FAILED; }
    if (status == AGNOSAI_CREW_CANCELLED) { return AGN_JV_CANCELLED; }
    return AGN_JV_PENDING;
}

# Global-allocator form of `agnosai_crew_status_to_wire_a`.
fn agnosai_crew_status_to_wire(status): i64 {
    return agnosai_crew_status_to_wire_a(default_alloc(), status);
}

# A crew status from its wire spelling. Unknown spellings fall back to the
# oracle's default, Pending.
fn agnosai_crew_status_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "running") == 1) { return AGNOSAI_CREW_RUNNING; }
    if (str_eq_cstr(s, "completed") == 1) { return AGNOSAI_CREW_COMPLETED; }
    if (str_eq_cstr(s, "failed") == 1) { return AGNOSAI_CREW_FAILED; }
    if (str_eq_cstr(s, "cancelled") == 1) { return AGNOSAI_CREW_CANCELLED; }
    return AGNOSAI_CREW_PENDING;
}

# Create a new crew spec with the given name and default settings.
fn agnosai_crew_new(name: Str): i64 {
    var c = alloc(AGN_CREW_SIZE);
    store64(c + AGN_CREW_ID, agnosai_uuid_v4_str());
    store64(c + AGN_CREW_NAME, name);
    store64(c + AGN_CREW_AGENTS, vec_new());
    store64(c + AGN_CREW_TASKS, vec_new());
    store64(c + AGN_CREW_PROCESS, agnosai_process_sequential());
    store64(c + AGN_CREW_METADATA, map_new_str());
    store64(c + AGN_CREW_TRUST_LEVEL, agnosai_default_trust_level());
    return c;
}

# Set the crew's agent roster (a vec of agent definitions). Returns the crew.
fn agnosai_crew_with_agents(c, agents): i64 {
    store64(c + AGN_CREW_AGENTS, agents);
    return c;
}

# Set the crew's task list (a vec of tasks). Returns the crew.
fn agnosai_crew_with_tasks(c, tasks): i64 {
    store64(c + AGN_CREW_TASKS, tasks);
    return c;
}

# Set the crew's execution mode. Returns the crew.
fn agnosai_crew_with_process(c, process): i64 {
    store64(c + AGN_CREW_PROCESS, process);
    return c;
}

# Set the crew's trust level ("minimal", "basic", "strict"). Returns the crew.
fn agnosai_crew_with_trust_level(c, level: Str): i64 {
    store64(c + AGN_CREW_TRUST_LEVEL, level);
    return c;
}

# Attach a metadata key-value pair. `value` is a bayan JSON value.
fn agnosai_crew_with_metadata(c, key: Str, value): i64 {
    map_set(load64(c + AGN_CREW_METADATA), str_clone(key), value);
    return c;
}

# Unique crew identifier.
fn agnosai_crew_id(c): i64 {
    return load64(c + AGN_CREW_ID);
}

# Human-readable crew name.
fn agnosai_crew_name(c): i64 {
    return load64(c + AGN_CREW_NAME);
}

# Vec of agent definitions participating in this crew.
fn agnosai_crew_agents(c): i64 {
    return load64(c + AGN_CREW_AGENTS);
}

# Vec of tasks to be executed by the crew.
fn agnosai_crew_tasks(c): i64 {
    return load64(c + AGN_CREW_TASKS);
}

# The crew's execution mode.
fn agnosai_crew_process(c): i64 {
    return load64(c + AGN_CREW_PROCESS);
}

# Str-keyed map of arbitrary crew metadata.
fn agnosai_crew_metadata(c): i64 {
    return load64(c + AGN_CREW_METADATA);
}

# Trust level for sandbox isolation policy.
fn agnosai_crew_trust_level(c): i64 {
    return load64(c + AGN_CREW_TRUST_LEVEL);
}

# The crew spec as a bayan JSON value, fields in declaration order.
fn agnosai_crew_to_value_a(a, c): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, AGN_JK_ID,
      bayan_json_v_str_new_a(a, load64(c + AGN_CREW_ID)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_NAME, bayan_json_v_str_new_a(a, load64(c + AGN_CREW_NAME)));

    var agents = load64(c + AGN_CREW_AGENTS);
    var agents_v = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(agents); i = i + 1) {
        bayan_json_v_arr_push_a(a, agents_v, agnosai_agent_to_value_a(a, vec_get(agents, i)));
    }
    bayan_json_v_obj_set_a(a, obj, AGN_JK_AGENTS, agents_v);

    var tasks = load64(c + AGN_CREW_TASKS);
    var tasks_v = bayan_json_v_arr_new_a(a);
    for (var j = 0; j < vec_len(tasks); j = j + 1) {
        bayan_json_v_arr_push_a(a, tasks_v, agnosai_task_to_value_a(a, vec_get(tasks, j)));
    }
    bayan_json_v_obj_set_a(a, obj, AGN_JK_TASKS, tasks_v);

    bayan_json_v_obj_set_a(a, obj, AGN_JK_PROCESS,
      agnosai_process_to_value_a(a, load64(c + AGN_CREW_PROCESS)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_METADATA,
      _agnosai_map_to_value_a(a, load64(c + AGN_CREW_METADATA)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_TRUST_LEVEL,
      bayan_json_v_str_new_a(a, load64(c + AGN_CREW_TRUST_LEVEL)));
    return obj;
}

# Global-allocator form of `agnosai_crew_to_value_a`.
fn agnosai_crew_to_value(c): i64 {
    return agnosai_crew_to_value_a(default_alloc(), c);
}

# Rebuild a crew spec from a bayan JSON value. Returns 0 when the value is not
# an object or `id` is missing or malformed; every other field is
# `#[serde(default)]` or required-with-a-default in the oracle.
fn agnosai_crew_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var id_v = bayan_json_v_obj_get(v, "id");
    if (id_v == 0 || bayan_json_v_is_str(id_v) == 0) { return 0; }
    var id = agnosai_uuid_canonical(bayan_json_v_str(id_v));
    if (id == 0) { return 0; }

    var name = _agnosai_str_field(v, "name");
    if (name == 0) { name = str_from(""); }

    var c = agnosai_crew_new(name);
    store64(c + AGN_CREW_ID, id);

    var av = bayan_json_v_obj_get(v, "agents");
    if (av != 0 && bayan_json_v_is_arr(av) == 1) {
        var agents = load64(c + AGN_CREW_AGENTS);
        for (var i = 0; i < bayan_json_v_arr_len(av); i = i + 1) {
            var a = agnosai_agent_from_value(bayan_json_v_arr_get(av, i));
            if (a != 0) { vec_push(agents, a); }
        }
    }

    var tv = bayan_json_v_obj_get(v, "tasks");
    if (tv != 0 && bayan_json_v_is_arr(tv) == 1) {
        var tasks = load64(c + AGN_CREW_TASKS);
        for (var j = 0; j < bayan_json_v_arr_len(tv); j = j + 1) {
            var t = agnosai_task_from_value(bayan_json_v_arr_get(tv, j));
            if (t != 0) { vec_push(tasks, t); }
        }
    }

    var pv = bayan_json_v_obj_get(v, "process");
    if (pv != 0) { store64(c + AGN_CREW_PROCESS, agnosai_process_from_value(pv)); }

    store64(c + AGN_CREW_METADATA, _agnosai_map_from_value(bayan_json_v_obj_get(v, "metadata")));

    var tl = _agnosai_str_field(v, "trust_level");
    if (tl != 0) { store64(c + AGN_CREW_TRUST_LEVEL, tl); }
    return c;
}

# The crew spec serialized to JSON text.
fn agnosai_crew_to_json_a(a, c): i64 {
    return bayan_json_v_build_a(a, agnosai_crew_to_value_a(a, c));
}

# Global-allocator form of `agnosai_crew_to_json_a`.
fn agnosai_crew_to_json(c): i64 {
    return agnosai_crew_to_json_a(default_alloc(), c);
}

# Parse a crew spec from JSON text. Returns 0 on a parse error or a malformed
# crew. See core_message.cyr for why this calls `bayan_json_v_parse_buf`.
fn agnosai_crew_from_json(src: Str): i64 {
    var v = bayan_json_v_parse_buf(str_data(src), str_len(src));
    if (v == 0) { return 0; }
    return agnosai_crew_from_value(v);
}

# Create an empty execution profile.
fn agnosai_crew_profile_new(): i64 {
    var p = alloc(AGN_PROF_SIZE);
    store64(p + AGN_PROF_WALL_MS, 0);
    store64(p + AGN_PROF_TASK_MS, map_new_str());
    store64(p + AGN_PROF_TASK_COUNT, 0);
    store64(p + AGN_PROF_COST_MICRO_USD, 0);
    store64(p + AGN_PROF_AGENT_COST, map_new_str());
    store64(p + AGN_PROF_TASK_COST, map_new_str());
    store64(p + AGN_PROF_SANDBOX_STRENGTH, AGNOSAI_NO_LIMIT);
    return p;
}

# Total wall-clock time in milliseconds.
fn agnosai_crew_profile_wall_ms(p): i64 {
    return load64(p + AGN_PROF_WALL_MS);
}

# Set the total wall-clock time in milliseconds. Returns the profile.
fn agnosai_crew_profile_with_wall_ms(p, ms): i64 {
    store64(p + AGN_PROF_WALL_MS, ms);
    return p;
}

# Str-keyed map of per-task durations in milliseconds, keyed by task UUID.
fn agnosai_crew_profile_task_ms(p): i64 {
    return load64(p + AGN_PROF_TASK_MS);
}

# Record a task's duration in milliseconds. Returns the profile.
fn agnosai_crew_profile_record_task_ms(p, task_id, ms): i64 {
    map_set(load64(p + AGN_PROF_TASK_MS), task_id, ms);
    return p;
}

# Number of tasks that ran.
fn agnosai_crew_profile_task_count(p): i64 {
    return load64(p + AGN_PROF_TASK_COUNT);
}

# Set the number of tasks that ran. Returns the profile.
fn agnosai_crew_profile_with_task_count(p, count): i64 {
    store64(p + AGN_PROF_TASK_COUNT, count);
    return p;
}

# Total estimated inference cost in micro-USD.
fn agnosai_crew_profile_cost_micro_usd(p): i64 {
    return load64(p + AGN_PROF_COST_MICRO_USD);
}

# Set the total estimated inference cost in micro-USD. Returns the profile.
fn agnosai_crew_profile_with_cost(p, micro_usd): i64 {
    store64(p + AGN_PROF_COST_MICRO_USD, micro_usd);
    return p;
}

# Str-keyed map of per-agent cost in micro-USD, keyed by agent_key.
fn agnosai_crew_profile_agent_cost(p): i64 {
    return load64(p + AGN_PROF_AGENT_COST);
}

# Record an agent's cost in micro-USD. Returns the profile.
fn agnosai_crew_profile_record_agent_cost(p, agent_key: Str, micro_usd): i64 {
    map_set(load64(p + AGN_PROF_AGENT_COST), str_clone(agent_key), micro_usd);
    return p;
}

# Str-keyed map of per-task cost in micro-USD, keyed by task UUID.
fn agnosai_crew_profile_task_cost(p): i64 {
    return load64(p + AGN_PROF_TASK_COST);
}

# Record a task's cost in micro-USD. Returns the profile.
fn agnosai_crew_profile_record_task_cost(p, task_id, micro_usd): i64 {
    map_set(load64(p + AGN_PROF_TASK_COST), task_id, micro_usd);
    return p;
}

# Kavach sandbox strength score (0-100), or AGNOSAI_NO_LIMIT when unset.
fn agnosai_crew_profile_sandbox_strength(p): i64 {
    return load64(p + AGN_PROF_SANDBOX_STRENGTH);
}

# Set the kavach sandbox strength score. Returns the profile.
fn agnosai_crew_profile_with_sandbox_strength(p, strength): i64 {
    store64(p + AGN_PROF_SANDBOX_STRENGTH, strength);
    return p;
}

# Serialize a Str-keyed map of micro-USD amounts as a JSON object of dollar
# numbers — the shape the oracle's `HashMap<_, f64>` emitted.
fn _agnosai_cost_map_to_value_a(a, m): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    # Slot walk, not map_keys — see _agnosai_map_slots in src/core/json.cyr.
    var n = _agnosai_map_slots(m);
    for (var i = 0; i < n; i = i + 1) {
        if (_agnosai_map_slot_live(m, i) == 1) {
            bayan_json_v_obj_set_a(a, obj, _agnosai_map_slot_key(m, i),
              bayan_json_v_float_new_a(a, agnosai_micro_usd_to_f64(_agnosai_map_slot_val(m, i))));
        }
    }
    return obj;
}

# Global-allocator form of `_agnosai_cost_map_to_value_a`.
fn _agnosai_cost_map_to_value(m): i64 {
    return _agnosai_cost_map_to_value_a(default_alloc(), m);
}

# Rebuild a Str-keyed map of micro-USD amounts from a JSON object of dollar
# numbers. Integers and floats are both accepted.
fn _agnosai_cost_map_from_value(v): i64 {
    var m = map_new_str();
    if (v == 0) { return m; }
    if (bayan_json_v_is_obj(v) == 0) { return m; }
    for (var i = 0; i < bayan_json_v_obj_len(v); i = i + 1) {
        var val = bayan_json_v_obj_val(v, i);
        var micro = 0;
        if (bayan_json_v_is_float(val) == 1) {
            micro = agnosai_f64_to_micro_usd(bayan_json_v_float(val));
        } elif (bayan_json_v_is_int(val) == 1) {
            micro = bayan_json_v_int(val) * AGNOSAI_MICRO_USD_PER_USD;
        }
        map_set(m, str_clone(bayan_json_v_obj_key(v, i)), micro);
    }
    return m;
}

# Serialize a Str-keyed map of plain integers as a JSON object.
fn _agnosai_int_map_to_value_a(a, m): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    # Slot walk, not map_keys — see _agnosai_map_slots in src/core/json.cyr.
    var n = _agnosai_map_slots(m);
    for (var i = 0; i < n; i = i + 1) {
        if (_agnosai_map_slot_live(m, i) == 1) {
            bayan_json_v_obj_set_a(a, obj, _agnosai_map_slot_key(m, i),
              bayan_json_v_int_new_a(a, _agnosai_map_slot_val(m, i)));
        }
    }
    return obj;
}

# Global-allocator form of `_agnosai_int_map_to_value_a`.
fn _agnosai_int_map_to_value(m): i64 {
    return _agnosai_int_map_to_value_a(default_alloc(), m);
}

# Rebuild a Str-keyed map of plain integers from a JSON object.
fn _agnosai_int_map_from_value(v): i64 {
    var m = map_new_str();
    if (v == 0) { return m; }
    if (bayan_json_v_is_obj(v) == 0) { return m; }
    for (var i = 0; i < bayan_json_v_obj_len(v); i = i + 1) {
        var val = bayan_json_v_obj_val(v, i);
        if (bayan_json_v_is_int(val) == 1) {
            map_set(m, str_clone(bayan_json_v_obj_key(v, i)), bayan_json_v_int(val));
        }
    }
    return m;
}

# The profile as a bayan JSON value.
#
# `cost_usd` is omitted when zero and the two cost maps are omitted when empty,
# matching the oracle's `skip_serializing_if`. Those omissions are wire-visible,
# so they are held exactly.
fn agnosai_crew_profile_to_value_a(a, p): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, AGN_JK_WALL_MS, bayan_json_v_int_new_a(a, load64(p + AGN_PROF_WALL_MS)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_TASK_MS,
      _agnosai_int_map_to_value_a(a, load64(p + AGN_PROF_TASK_MS)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_TASK_COUNT,
      bayan_json_v_int_new_a(a, load64(p + AGN_PROF_TASK_COUNT)));

    var cost = load64(p + AGN_PROF_COST_MICRO_USD);
    if (cost != 0) {
        bayan_json_v_obj_set_a(a, obj, AGN_JK_COST_USD,
          bayan_json_v_float_new_a(a, agnosai_micro_usd_to_f64(cost)));
    }

    var agent_cost = load64(p + AGN_PROF_AGENT_COST);
    if (map_size(agent_cost) > 0) {
        bayan_json_v_obj_set_a(a, obj, AGN_JK_AGENT_COST, _agnosai_cost_map_to_value_a(a, agent_cost));
    }

    var task_cost = load64(p + AGN_PROF_TASK_COST);
    if (map_size(task_cost) > 0) {
        bayan_json_v_obj_set_a(a, obj, AGN_JK_TASK_COST, _agnosai_cost_map_to_value_a(a, task_cost));
    }

    var strength = load64(p + AGN_PROF_SANDBOX_STRENGTH);
    if (strength != AGNOSAI_NO_LIMIT) {
        bayan_json_v_obj_set_a(a, obj, AGN_JK_SANDBOX_STR, bayan_json_v_int_new_a(a, strength));
    }
    return obj;
}

# Global-allocator form of `agnosai_crew_profile_to_value_a`.
fn agnosai_crew_profile_to_value(p): i64 {
    return agnosai_crew_profile_to_value_a(default_alloc(), p);
}

# Rebuild a profile from a bayan JSON value, or 0 when a required field is
# missing.
#
# ⚠ **Only FOUR of the seven fields are `#[serde(default)]`** — `cost_usd`,
# `agent_cost_usd`, `task_cost_usd` and `sandbox_strength` (`crew.rs:106-118`).
# `wall_ms`, `task_ms` and `task_count` are required, so serde rejects a profile
# object missing any of them. This function's own comment used to claim every
# field was defaulted, and it defaulted all three — so a truncated record came
# back as a plausible-looking profile reporting a zero-length run of zero tasks
# rather than as an error.
fn agnosai_crew_profile_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var wall_v = bayan_json_v_obj_get(v, "wall_ms");
    if (wall_v == 0 || bayan_json_v_is_int(wall_v) == 0) { return 0; }
    var count_v = bayan_json_v_obj_get(v, "task_count");
    if (count_v == 0 || bayan_json_v_is_int(count_v) == 0) { return 0; }
    var ms_v = bayan_json_v_obj_get(v, "task_ms");
    if (ms_v == 0 || bayan_json_v_is_obj(ms_v) == 0) { return 0; }

    var p = agnosai_crew_profile_new();
    store64(p + AGN_PROF_WALL_MS, bayan_json_v_int(wall_v));
    store64(p + AGN_PROF_TASK_MS, _agnosai_int_map_from_value(ms_v));
    store64(p + AGN_PROF_TASK_COUNT, bayan_json_v_int(count_v));

    var cv = bayan_json_v_obj_get(v, "cost_usd");
    if (cv != 0) {
        if (bayan_json_v_is_float(cv) == 1) {
            store64(p + AGN_PROF_COST_MICRO_USD, agnosai_f64_to_micro_usd(bayan_json_v_float(cv)));
        } elif (bayan_json_v_is_int(cv) == 1) {
            store64(p + AGN_PROF_COST_MICRO_USD, bayan_json_v_int(cv) * AGNOSAI_MICRO_USD_PER_USD);
        }
    }

    store64(p + AGN_PROF_AGENT_COST, _agnosai_cost_map_from_value(bayan_json_v_obj_get(v, "agent_cost_usd")));
    store64(p + AGN_PROF_TASK_COST, _agnosai_cost_map_from_value(bayan_json_v_obj_get(v, "task_cost_usd")));
    store64(p + AGN_PROF_SANDBOX_STRENGTH, _agnosai_opt_int_field(v, "sandbox_strength"));
    return p;
}

# Create a crew execution state.
fn agnosai_crew_state_new(crew_id, status): i64 {
    var s = alloc(AGN_CSTATE_SIZE);
    store64(s + AGN_CSTATE_CREW_ID, crew_id);
    store64(s + AGN_CSTATE_STATUS, status);
    store64(s + AGN_CSTATE_RESULTS, vec_new());
    store64(s + AGN_CSTATE_PROFILE, 0);
    return s;
}

# ID of the crew this state belongs to.
fn agnosai_crew_state_crew_id(s): i64 {
    return load64(s + AGN_CSTATE_CREW_ID);
}

# Current overall status of the crew run.
fn agnosai_crew_state_status(s): i64 {
    return load64(s + AGN_CSTATE_STATUS);
}

# Vec of task results collected so far.
fn agnosai_crew_state_results(s): i64 {
    return load64(s + AGN_CSTATE_RESULTS);
}

# Execution profile, or 0 when unset.
fn agnosai_crew_state_profile(s): i64 {
    return load64(s + AGN_CSTATE_PROFILE);
}

# Attach an execution profile. Returns the state.
# Set the crew's status. Returns the state.
#
# The oracle mutates `crew.status` directly through the registry's write lock;
# the port needs a setter because `orch_orchestrator`'s `cancel_crew` marks a
# registered crew Cancelled in place.
fn agnosai_crew_state_with_status(s, status): i64 {
    store64(s + AGN_CSTATE_STATUS, status);
    return s;
}

# Attach a resource profile to a crew state, returning it for chaining.
fn agnosai_crew_state_with_profile(s, profile): i64 {
    store64(s + AGN_CSTATE_PROFILE, profile);
    return s;
}

# Append a task result. Returns the state.
fn agnosai_crew_state_with_result(s, result): i64 {
    vec_push(load64(s + AGN_CSTATE_RESULTS), result);
    return s;
}

# JSON keys for the crew serialisers, minted once at startup — see the banner on
# `AGN_JK_TASK_ID` in `core/task.cyr` for why, and for why this is not the
# constant-return hoist state.md declines.
var AGN_JK_CREW_ID = str_from("crew_id");
var AGN_JK_RESULTS = str_from("results");
var AGN_JK_PROFILE = str_from("profile");
var AGN_JK_WALL_MS = str_from("wall_ms");
var AGN_JK_TASK_MS = str_from("task_ms");
var AGN_JK_TASK_COUNT = str_from("task_count");
var AGN_JK_COST_USD = str_from("cost_usd");
var AGN_JK_AGENT_COST = str_from("agent_cost_usd");
var AGN_JK_TASK_COST = str_from("task_cost_usd");
var AGN_JK_SANDBOX_STR = str_from("sandbox_strength");

# The crew state as a bayan JSON value. `profile` is **omitted** when unset,
# matching the oracle's `skip_serializing_if = "Option::is_none"`.
fn agnosai_crew_state_to_value_a(a, s): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    bayan_json_v_obj_set_a(a, obj, AGN_JK_CREW_ID,
      bayan_json_v_str_new_a(a, load64(s + AGN_CSTATE_CREW_ID)));
    bayan_json_v_obj_set_a(a, obj, AGN_JK_STATUS,
      bayan_json_v_str_new_a(a, agnosai_crew_status_to_wire_a(a, load64(s + AGN_CSTATE_STATUS))));

    var results = load64(s + AGN_CSTATE_RESULTS);
    var results_v = bayan_json_v_arr_new_a(a);
    for (var i = 0; i < vec_len(results); i = i + 1) {
        bayan_json_v_arr_push_a(a, results_v, agnosai_task_result_to_value_a(a, vec_get(results, i)));
    }
    bayan_json_v_obj_set_a(a, obj, AGN_JK_RESULTS, results_v);

    var profile = load64(s + AGN_CSTATE_PROFILE);
    if (profile != 0) {
        bayan_json_v_obj_set_a(a, obj, AGN_JK_PROFILE, agnosai_crew_profile_to_value_a(a, profile));
    }
    return obj;
}

# Global-allocator form of `agnosai_crew_state_to_value_a`.
fn agnosai_crew_state_to_value(s): i64 {
    return agnosai_crew_state_to_value_a(default_alloc(), s);
}

# Rebuild a crew state from a bayan JSON value. Returns 0 when `crew_id` is
# missing or malformed.
fn agnosai_crew_state_from_value(v): i64 {
    if (bayan_json_v_is_obj(v) == 0) { return 0; }
    var id_v = bayan_json_v_obj_get(v, "crew_id");
    if (id_v == 0 || bayan_json_v_is_str(id_v) == 0) { return 0; }
    var id = agnosai_uuid_canonical(bayan_json_v_str(id_v));
    if (id == 0) { return 0; }

    var status = AGNOSAI_CREW_PENDING;
    var sv = bayan_json_v_obj_get(v, "status");
    if (sv != 0 && bayan_json_v_is_str(sv) == 1) {
        status = agnosai_crew_status_from_wire(bayan_json_v_str(sv));
    }

    var s = agnosai_crew_state_new(id, status);

    var rv = bayan_json_v_obj_get(v, "results");
    if (rv != 0 && bayan_json_v_is_arr(rv) == 1) {
        var results = load64(s + AGN_CSTATE_RESULTS);
        for (var i = 0; i < bayan_json_v_arr_len(rv); i = i + 1) {
            var r = agnosai_task_result_from_value(bayan_json_v_arr_get(rv, i));
            if (r != 0) { vec_push(results, r); }
        }
    }

    var pv = bayan_json_v_obj_get(v, "profile");
    if (pv != 0 && bayan_json_v_is_obj(pv) == 1) {
        # 0 means a required field was missing; leave the slot unset rather than
        # storing a null the accessors would dereference.
        var prof = agnosai_crew_profile_from_value(pv);
        if (prof != 0) { store64(s + AGN_CSTATE_PROFILE, prof); }
    }
    return s;
}

# --- mod.cyr ---

# =========================================================================
# core/mod — core types and error handling for AgnosAI.
#
# Origin: rust-old/src/core/mod.rs
#
# The foundational types shared across every other group: agents, tasks, crews,
# messages, resources, and errors. No I/O — pure data, with JSON support via
# bayan where the oracle used serde.
#
# This module is the hub mirroring mod.rs: it carries no logic of its own, only
# the include order. That order IS a dependency constraint (unlike the learning
# hub's) and Cyrius resolution is single-pass, so callees must precede callers:
#
#   core_error     — standalone
#   core_json      — shared JSON field helpers (no oracle module; extracted once
#                    task, resource and agent all needed them)
#   core_message   — needs src/id.cyr and core_error
#   core_resource  — needs core_json
#   core_task      — needs core_json and src/id.cyr
#   core_agent     — needs core_json and core_resource
#   core_crew      — needs all of the above
#
# `src/id.cyr` must be included before this hub; src/main.cyr does that.
#
# ✅ **The `#[cfg(feature = "hwaccel")]` half of resource.rs is PORTED** — M11,
# 2026-08-10. `agnosai_accelerator_type_from_hwaccel` (:773),
# `agnosai_hw_inventory_from_hwaccel` (:797) and the whole
# `TrainingMemoryEstimate` set (:854-910) are in `core/resource.cyr`. This note
# used to list it as owed, and before that as "outside the v2.0.0 scope" —
# a framing that was self-issued, never a user decision, and is retired: a cargo
# feature gate is not a scope boundary.
#
# One carve-out remains, and it is the ONE the user actually set:
#   * `AgentDefinition::personality` — deferred; see docs/development/roadmap.md:43
#     for why and for the exit condition. bhava has no Cyrius port, so there is
#     nothing to depend on. The field serializes as null meanwhile, which is
#     exactly what the default Rust build emits, so the wire form matches. It is
#     the only item the user ever set aside.
#
# ## The oracle's doctest
#
# `core/mod.rs` carries the one real doctest under `rust-old/src/` — the other
# three ` ``` ` blocks are `text`, `ignore` and `yaml`, none of which `cargo test`
# compiles. It parses an `AgentDefinition` from JSON, makes a `Task` and a
# `CrewSpec`; a doctest asserts that the documented example still runs at all,
# which is a promise to the reader that outlives any given release.
#
#   agnosai_agent_from_json("{\"agent_key\":\"analyst\", \"name\":\"Analyst\",
#                            \"role\":\"data analyst\", \"goal\":\"analyze data\"}")
#   agnosai_task_new("Analyze quarterly revenue trends")
#   agnosai_crew_new("analysis-crew")
#
# ⚠ **`cyrius doctest src/core/mod.cyr` runs the block below.** An earlier draft
# of this note said "Cyrius has no doctest runner" and pinned the example as
# assertions instead. That was **wrong** — `cyrius doctest <file.cyr>` exists and
# executes the `# >>>` lines, checking the result against `# ===`. Verify a
# claimed toolchain gap against bare `cyrius` before writing around it.
#
# ⚠ **`cyrius doctest` auto-prepends NOTHING** — not `[deps].stdlib`, not the
# `[deps.NAME]` bundles, not even `lib/str.cyr`. Measured: a doctest calling
# `str_from` in this project reports `undefined function 'str_from'`. That is why
# 24 `include` lines precede two lines of actual example. `cyrius tests` and
# `cyrius bench` DO prepend, so the habit built on `.tcyr` files does not carry
# over, and the failure is a compile error rather than anything that names the
# real cause. cyrius's own `lib/hashmap.cyr` doctest is broken by exactly this —
# it includes `lib/string.cyr` where it needs `lib/str.cyr` — and is filed
# upstream.
#
# **Keep the include list in step with `src/main.cyr`.** If a new `[deps]` entry
# becomes reachable from `core/`, this block breaks and `check-clean.sh` will say
# so. `tests/core_mod_doctest.tcyr` remains alongside it: a doctest can only
# check an exit code, and the suite checks the fields.
#
# >>> include "lib/syscalls.cyr"
# >>> include "lib/alloc.cyr"
# >>> include "lib/result.cyr"
# >>> include "lib/fmt.cyr"
# >>> include "lib/io.cyr"
# >>> include "lib/str.cyr"
# >>> include "lib/string.cyr"
# >>> include "lib/vec.cyr"
# >>> include "lib/slice.cyr"
# >>> include "lib/hashmap.cyr"
# >>> include "lib/chrono.cyr"
# >>> include "lib/args.cyr"
# >>> include "lib/fs.cyr"
# >>> include "lib/process.cyr"
# >>> include "lib/atomic.cyr"
# >>> include "lib/sync.cyr"
# >>> include "lib/thread.cyr"
# >>> include "lib/random.cyr"
# >>> include "lib/sha1.cyr"
# >>> include "lib/math.cyr"
# >>> include "lib/bayan.cyr"
# >>> include "lib/sakshi.cyr"
# >>> include "lib/ai-hwaccel.cyr"
# >>> include "src/units.cyr"
# >>> include "src/order.cyr"
# >>> include "src/id.cyr"
# >>> include "src/core/mod.cyr"
# >>> var _J = "{\"agent_key\":\"analyst\",\"name\":\"Analyst\",";
# >>> var _K = "\"role\":\"data analyst\",\"goal\":\"analyze data\"}";
# >>> fn main() {
# >>>     alloc_init();
# >>>     var j = str_cat(str_from(_J), str_from(_K));
# >>>     if (agnosai_agent_from_json(j) == 0) { return 1; }
# >>>     if (agnosai_task_new(str_from("Analyze quarterly revenue trends")) == 0) { return 2; }
# >>>     if (agnosai_crew_new(str_from("analysis-crew")) == 0) { return 3; }
# >>>     return 0;
# >>> }
# >>> var r = main(); syscall(60, r);
# === 0
# =========================================================================

# --- versioning.cyr ---

# =========================================================================
# definitions/versioning — versioned agent definitions with rollback.
#
# Origin: rust-old/src/definitions/versioning.rs
#
# An in-memory store of `AgentDefinition` snapshots keyed by `agent_key`, each
# with an auto-incrementing version number, a timestamp and an optional message.
# The first module of the `definitions` group and the only one with no
# dependency on the preset loader, which is why it lands first.
#
# ## Version numbers are monotonic ACROSS eviction
#
# The cap is per agent and eviction drops the OLDEST, but the next number comes
# from `history.last()` — the newest survivor — not from the length. So a store
# that has evicted 300 versions still hands out 501, 502, … and never reuses a
# number. That is the oracle's own test (`latest.version == MAX + 1` after
# filling past capacity) and it is the property a rollback target depends on:
# if numbers restarted, "rollback to version 3" would be ambiguous.
#
# It also means `get` must **search** by version rather than index into the vec.
# After one eviction, version N is no longer at index N-1, and an indexed
# lookup would silently return the wrong definition — a rollback to the wrong
# agent config, with no error.
#
# ## `rollback` goes through `save`
#
# It does not splice the old snapshot in; it copies it forward as a NEW version,
# so history is append-only and the rollback itself is auditable. That also
# means a rollback is subject to eviction and numbering like any other save.
# =========================================================================

# The oracle's `MAX_VERSIONS_PER_AGENT`.
var AGNOSAI_MAX_VERSIONS_PER_AGENT = 500;

# DefinitionVersion heap layout — 32 bytes.
enum AgnosaiDefinitionVersionOff {
    AGN_DV_VERSION = 0;
    AGN_DV_DEFINITION = 8;
    # Wall-clock seconds — the oracle's `DateTime<Utc>`.
    AGN_DV_CREATED_AT = 16;
    # 0 for the oracle's `None`.
    AGN_DV_MESSAGE = 24;
    AGN_DV_SIZE = 32;
}

# VersionStore heap layout — 8 bytes. A map from agent_key to a vec of versions.
enum AgnosaiVersionStoreOff {
    AGN_VS_VERSIONS = 0;
    AGN_VS_SIZE = 8;
}

# --- DefinitionVersion ---------------------------------------------------

# The version number.
fn agnosai_definition_version_number(v): i64 {
    return load64(v + AGN_DV_VERSION);
}

# The agent definition at this version.
fn agnosai_definition_version_definition(v): i64 {
    return load64(v + AGN_DV_DEFINITION);
}

# Wall-clock seconds when this version was saved.
fn agnosai_definition_version_created_at(v): i64 {
    return load64(v + AGN_DV_CREATED_AT);
}

# The commit message, or 0 for the oracle's `None`.
fn agnosai_definition_version_message(v): i64 {
    return load64(v + AGN_DV_MESSAGE);
}

# --- VersionStore --------------------------------------------------------

# An empty store. The oracle's `new` and `Default` are the same thing.
fn agnosai_version_store_new(): i64 {
    var s = alloc(AGN_VS_SIZE);
    store64(s + AGN_VS_VERSIONS, map_new_str());
    return s;
}

# Save a new version of `definition`. `message` may be 0. Returns the number.
#
# ⚠ Eviction happens BEFORE the number is chosen, and the number comes from the
# last surviving entry — so it stays monotonic across eviction. Computing it
# from `vec_len(history) + 1` instead would reuse numbers the moment anything
# was dropped, and a rollback target would then be ambiguous.
#
# ⚠ The `>=` and the `- MAX + 1` together hold the history at exactly MAX: at
# len == MAX one entry is dropped, leaving MAX-1, and the push brings it back.
fn agnosai_version_store_save(s, definition, message): i64 {
    var versions = load64(s + AGN_VS_VERSIONS);
    var key = agnosai_agent_key(definition);
    var history = map_get(versions, key);
    if (history == 0) {
        history = vec_new();
        map_set(versions, key, history);
    }

    if (vec_len(history) >= AGNOSAI_MAX_VERSIONS_PER_AGENT) {
        var drop = vec_len(history) - AGNOSAI_MAX_VERSIONS_PER_AGENT + 1;
        _agnosai_version_drain_front(history, drop);
    }

    var number = 1;
    if (vec_len(history) > 0) {
        number = load64(vec_get(history, vec_len(history) - 1) + AGN_DV_VERSION) + 1;
    }

    var v = alloc(AGN_DV_SIZE);
    store64(v + AGN_DV_VERSION, number);
    store64(v + AGN_DV_DEFINITION, definition);
    store64(v + AGN_DV_CREATED_AT, clock_epoch_secs());
    store64(v + AGN_DV_MESSAGE, message);
    vec_push(history, v);
    return number;
}

# Drop the first `n` entries, shifting the rest down — the oracle's
# `history.drain(..n)`.
#
# `lib/vec.cyr` has no drain, and compacting in place beats allocating a new vec
# on a path that runs once per save at capacity.
fn _agnosai_version_drain_front(history, n): i64 {
    var len = vec_len(history);
    if (n >= len) {
        # `lib/vec.cyr` has no `vec_clear` either — pop it empty.
        for (var i = 0; i < len; i = i + 1) { vec_pop(history); }
        return 0;
    }
    for (var i = 0; i < len - n; i = i + 1) {
        vec_set(history, i, vec_get(history, i + n));
    }
    for (var i = 0; i < n; i = i + 1) { vec_pop(history); }
    return 0;
}

# A specific version, or 0 for the oracle's `None`.
#
# ⚠ A linear search by version number, NOT an index. After any eviction the
# version at index k is not version k+1, and indexing would hand back the wrong
# definition with no error — a rollback to the wrong agent config.
fn agnosai_version_store_get(s, agent_key: Str, version): i64 {
    var history = map_get(load64(s + AGN_VS_VERSIONS), agent_key);
    if (history == 0) { return 0; }
    for (var i = 0; i < vec_len(history); i = i + 1) {
        var v = vec_get(history, i);
        if (load64(v + AGN_DV_VERSION) == version) { return v; }
    }
    return 0;
}

# The newest version, or 0 for an unknown agent.
fn agnosai_version_store_latest(s, agent_key: Str): i64 {
    var history = map_get(load64(s + AGN_VS_VERSIONS), agent_key);
    if (history == 0) { return 0; }
    if (vec_len(history) == 0) { return 0; }
    return vec_get(history, vec_len(history) - 1);
}

# Every retained version, oldest first. An unknown agent gives an EMPTY vec,
# not 0 — the oracle's `map_or_else(Vec::new, ..)`.
fn agnosai_version_store_list(s, agent_key: Str): i64 {
    var history = map_get(load64(s + AGN_VS_VERSIONS), agent_key);
    if (history == 0) { return vec_new(); }
    var out = vec_new();
    for (var i = 0; i < vec_len(history); i = i + 1) { vec_push(out, vec_get(history, i)); }
    return out;
}

# Roll back to `version` by copying it forward as a new latest version.
# Returns the old definition, or 0 when the agent or version is unknown.
#
# ⚠ Append-only: the old snapshot is re-saved rather than spliced in, so the
# rollback is itself a version and the history stays auditable. It therefore
# obeys eviction and numbering like any other save.
#
# ⚠ Returns the DEFINITION, not the new version number — the oracle discards
# the number (`let _ = new_version;`).
fn agnosai_version_store_rollback(s, agent_key: Str, version): i64 {
    var target = agnosai_version_store_get(s, agent_key, version);
    if (target == 0) { return 0; }
    var old_def = load64(target + AGN_DV_DEFINITION);

    var sb = str_builder_new();
    str_builder_add_cstr(sb, "Rollback to version ");
    str_builder_add_int(sb, version);
    agnosai_version_store_save(s, old_def, str_builder_build(sb));
    return old_def;
}

# --- assembler.cyr ---

# =========================================================================
# definitions/assembler — crew assembly from team specs.
#
# Origin: rust-old/src/definitions/assembler.rs
#
# Matches requested roles against available agent definitions by score, and
# builds a `CrewSpec` from the winners.
#
# ## `max_by` returns the LAST maximum, and nothing in the oracle tests it
#
# Rust's `Iterator::max_by` documents that "if several elements are equally
# maximum, the last element is returned". Every one of the oracle's seven tests
# has a single clear winner, so the tie rule is invisible there — and ties are
# not exotic: two agents with the same role and no tools score identically, which
# is the default shape of a preset team. Reproduced with `>=` in the scan, and
# pinned by a test the oracle does not have. Same trap as `fleet/gpu`'s
# `max_by_key`.
#
# ## A zero score is not a match
#
# `max_by` always returns *something* from a non-empty list, so the filter after
# it is what stops an unrelated agent being drafted. Drop the filter and a crew
# asking for a "designer" gets handed the developer — silently, because the
# scorer answers 0 rather than failing.
#
# ## Scores are f64
#
# Every weight is a whole number (10, 5, 3, 2), so integers would order
# identically today. They stay f64 because the oracle's are, and because a
# fractional weight added later would be silently truncated by an i64 score.
# Same call `fleet/placement` made.
#
# ## ⚠ `_agnosai_assembler_best` scores each agent ONCE; the oracle scores it 39 times
#
# A divergence in work done, not in result, recorded here because the three traps
# above are all subtler than this one and it went undocumented until 2026-08-11.
#
# `rust-old/src/definitions/assembler.rs:34-47` is
# `.max_by(|a, b| match_score(member, a).partial_cmp(&match_score(member, b)))`
# followed by `.filter(|agent| match_score(member, agent) > 0.0)`.
# `Iterator::max_by` invokes the comparator n-1 times and the comparator scores
# **both** sides, so 20 agents cost 19 x 2 = 38 evaluations, plus one more in the
# filter — **39 per member, 195 per 5-member call**. It then `.cloned()`s each
# pick, deep-copying the whole `AgentDefinition`.
#
# The scan below evaluates `match_score` once per agent, keeps it in
# `best_score`, and reuses that same value for the `> 0.0` filter — **20 per
# member, 100 per call**, and it returns borrowed pointers rather than clones.
#
# **The result is identical because `match_score` is pure**, which is why this is
# a note and not an ADR: there is no behavioural difference to record a decision
# about. It is here so nobody reads `benches/definitions.bcyr`'s
# `assemble_team_5m_20a` figure as the oracle's cost — it is roughly half of it,
# before the clones.
# =========================================================================

# TeamMember heap layout — 24 bytes.
#
# ⚠ `AGN_TMEM_`, not `AGN_TM_`: `src/orchestrator/pubsub.cyr:50`'s
# `AgnosaiTopicMsgOff` already owns `AGN_TM_SIZE`. Cyrius has ONE flat
# namespace and is **silent** on a duplicate enum member — only
# `scripts/check-symbols.sh` caught it, exactly as it caught
# `AgnosaiCostTier` and `AGN_CKPT_*` before.
enum AgnosaiTeamMemberOff {
    AGN_TMEM_ROLE = 0;
    AGN_TMEM_TOOLS = 8;
    # 0 for the oracle's `None`.
    AGN_TMEM_COMPLEXITY = 16;
    AGN_TMEM_SIZE = 24;
}

# The oracle's `TeamMember::new`. `complexity` may be 0.
fn agnosai_team_member_new(role: Str, tools, complexity): i64 {
    var m = alloc(AGN_TMEM_SIZE);
    store64(m + AGN_TMEM_ROLE, role);
    store64(m + AGN_TMEM_TOOLS, tools);
    store64(m + AGN_TMEM_COMPLEXITY, complexity);
    return m;
}

# The requested role.
fn agnosai_team_member_role(m): i64 {
    return load64(m + AGN_TMEM_ROLE);
}

# The requested tools.
fn agnosai_team_member_tools(m): i64 {
    return load64(m + AGN_TMEM_TOOLS);
}

# The requested complexity, or 0 for the oracle's `None`.
fn agnosai_team_member_complexity(m): i64 {
    return load64(m + AGN_TMEM_COMPLEXITY);
}

# Score how well `agent` matches `member`. Higher is better; 0 is no match.
#
# The weights are the oracle's, and the order they accumulate in does not
# matter — but which branch fires does:
#
#   * exact role (case-insensitive) → 10, and it is `else if`, so an exact match
#     does NOT also collect the containment 5;
#   * either role containing the other → 5. **Bidirectional**: "tester" matches
#     an agent whose role is "lead tester", and an agent whose role is "test"
#     matches a member asking for "integration test" — the second direction is
#     the one a one-way `contains` would silently drop;
#   * the agent's NAME containing the role → 2, on top of either of the above;
#   * 3 per overlapping tool, case-insensitive;
#   * 2 for a matching complexity, only when one was requested.
fn agnosai_assembler_match_score(member, agent): i64 {
    var score = f64_from(0);

    var member_role = load64(member + AGN_TMEM_ROLE);
    var agent_role = agnosai_agent_role(agent);
    if (agnosai_str_eq_ci(agent_role, member_role) == 1) {
        score = f64_add(score, f64_from(10));
    } else {
        if (agnosai_str_contains_ci(agent_role, member_role) == 1) {
            score = f64_add(score, f64_from(5));
        } else {
            if (agnosai_str_contains_ci(member_role, agent_role) == 1) {
                score = f64_add(score, f64_from(5));
            }
        }
    }

    if (agnosai_str_contains_ci(agnosai_agent_name(agent), member_role) == 1) {
        score = f64_add(score, f64_from(2));
    }

    var want = load64(member + AGN_TMEM_TOOLS);
    var have = agnosai_agent_tools(agent);
    for (var i = 0; i < vec_len(want); i = i + 1) {
        for (var j = 0; j < vec_len(have); j = j + 1) {
            if (agnosai_str_eq_ci(vec_get(have, j), vec_get(want, i)) == 1) {
                score = f64_add(score, f64_from(3));
                # ⚠ One point per REQUESTED tool, not per matching pair. The
                # oracle's `.any()` short-circuits, so an agent listing the same
                # tool twice scores it once.
                break;
            }
        }
    }

    var complexity = load64(member + AGN_TMEM_COMPLEXITY);
    if (complexity != 0) {
        if (agnosai_str_eq_ci(agnosai_agent_complexity(agent), complexity) == 1) {
            score = f64_add(score, f64_from(2));
        }
    }

    return score;
}

# Pick the best agent for `member`, or 0 when nothing scores above zero.
#
# ⚠ `>=` so the LAST maximum wins, reproducing Rust's `max_by`. A `>` here
# quietly picks the first instead, and every oracle test still passes.
fn _agnosai_assembler_best(member, available): i64 {
    var best = 0;
    var best_score = f64_from(0);
    for (var i = 0; i < vec_len(available); i = i + 1) {
        var agent = vec_get(available, i);
        var s = agnosai_assembler_match_score(member, agent);
        if (best == 0) {
            best = agent;
            best_score = s;
        } else {
            if (f64_ge(s, best_score) == 1) {
                best = agent;
                best_score = s;
            }
        }
    }
    if (best == 0) { return 0; }
    # The oracle's `.filter(|a| match_score(..) > 0.0)` — without it an
    # unrelated agent is drafted rather than the member being skipped.
    if (f64_gt(best_score, f64_from(0)) == 0) { return 0; }
    return best;
}

# Assemble a team: one agent per member, skipping members nothing matches.
#
# ⚠ The result may contain the SAME agent twice. The oracle does not dedupe, so
# two members asking for "tester" against one tester both get it — and a caller
# reading `agents.len()` as "distinct people" is wrong. Reproduced as-is.
fn agnosai_assemble_team(members, available): i64 {
    var out = vec_new();
    for (var i = 0; i < vec_len(members); i = i + 1) {
        var pick = _agnosai_assembler_best(vec_get(members, i), available);
        if (pick != 0) { vec_push(out, pick); }
    }
    return out;
}

# Build a complete `CrewSpec` from members, available definitions and tasks.
fn agnosai_build_crew(name: Str, members, available, tasks): i64 {
    var crew = agnosai_crew_new(name);
    agnosai_crew_with_agents(crew, agnosai_assemble_team(members, available));
    agnosai_crew_with_tasks(crew, tasks);
    return crew;
}

# --- k8s_crd.cyr ---

# =========================================================================
# definitions/k8s_crd — Kubernetes CustomResourceDefinition types.
#
# Origin: rust-old/src/definitions/k8s_crd.rs
#
# serde-shaped structs matching the K8s CRD format for `Crew` and agent
# resources, so a cluster can apply an AgnosAI crew as a manifest. No
# Kubernetes client — type definitions and their wire form, nothing else.
#
# ## The wire contract IS the module
#
# There is no behaviour here to get wrong, only bytes. `#[serde(rename_all =
# "camelCase")]` means the JSON keys are `apiVersion`, `processMode`,
# `trustLevel`, `agentKey`, `expectedOutput` — **not** the snake_case field
# names every other struct in this port serialises with. A single key spelled
# the Rust way and `kubectl apply` rejects the manifest, or worse silently
# drops the field into `unknown fields` and applies a default.
#
# So every key is asserted literally in the suite, and the camelCase set is
# listed here for a reader who edits one:
#
#   api_version → apiVersion      process_mode    → processMode
#   trust_level → trustLevel      agent_key       → agentKey
#   expected_output → expectedOutput
#
# Everything else is already one word and unchanged.
#
# ## Five defaults, applied on DESERIALIZE only
#
# `process_mode` "sequential", `trust_level` "basic", `complexity` "medium",
# `priority` "normal", `risk` "low". They fill an absent key when reading; they
# are not "the value a new struct starts with", and the oracle's
# `defaults_applied` test reads a minimal manifest to prove it.
#
# ## `Option` serialises as `null`, not as an absent key
#
# Neither `domain` nor `expected_output` carries `skip_serializing_if`, so the
# oracle emits `"domain": null`. A port that omitted the key would produce a
# manifest that round-trips through serde but differs on the wire — and k8s
# compares manifests.
# =========================================================================

# The CRD API group and version. `agnosai.io/v1` is what `apiVersion` carries.
fn agnosai_crd_api_group(): i64 {
    return str_from("agnosai.io");
}

# The full `apiVersion` value — group and version, slash-separated.
fn agnosai_crd_api_version(): i64 {
    return str_from("agnosai.io/v1");
}

# The `kind` every Crew CRD carries.
fn agnosai_crd_kind_crew(): i64 {
    return str_from("Crew");
}

# ObjectMeta heap layout — 32 bytes.
enum AgnosaiObjectMetaOff {
    AGN_OM_NAME = 0;
    AGN_OM_NAMESPACE = 8;
    AGN_OM_LABELS = 16;
    AGN_OM_ANNOTATIONS = 24;
    AGN_OM_SIZE = 32;
}

# CrewCrd heap layout — 32 bytes.
enum AgnosaiCrewCrdOff {
    AGN_CCRD_API_VERSION = 0;
    AGN_CCRD_KIND = 8;
    AGN_CCRD_METADATA = 16;
    AGN_CCRD_SPEC = 24;
    AGN_CCRD_SIZE = 32;
}

# CrewCrdSpec heap layout — 40 bytes.
enum AgnosaiCrewCrdSpecOff {
    AGN_CSPC_NAME = 0;
    AGN_CSPC_AGENTS = 8;
    AGN_CSPC_TASKS = 16;
    AGN_CSPC_PROCESS_MODE = 24;
    AGN_CSPC_TRUST_LEVEL = 32;
    AGN_CSPC_SIZE = 40;
}

# AgentCrdSpec heap layout — 56 bytes.
enum AgnosaiAgentCrdSpecOff {
    AGN_ACRD_AGENT_KEY = 0;
    AGN_ACRD_NAME = 8;
    AGN_ACRD_ROLE = 16;
    AGN_ACRD_GOAL = 24;
    AGN_ACRD_TOOLS = 32;
    AGN_ACRD_COMPLEXITY = 40;
    # 0 for the oracle's `None`.
    AGN_ACRD_DOMAIN = 48;
    AGN_ACRD_SIZE = 56;
}

# TaskCrdSpec heap layout — 40 bytes.
enum AgnosaiTaskCrdSpecOff {
    AGN_TCRD_DESCRIPTION = 0;
    # 0 for the oracle's `None`.
    AGN_TCRD_EXPECTED_OUTPUT = 8;
    AGN_TCRD_PRIORITY = 16;
    AGN_TCRD_RISK = 24;
    AGN_TCRD_DEPENDENCIES = 32;
    AGN_TCRD_SIZE = 40;
}

# --- the five serde defaults ---------------------------------------------

# `default_process_mode()`.
fn agnosai_crd_default_process_mode(): i64 {
    return str_from("sequential");
}

# `default_trust()`.
fn agnosai_crd_default_trust(): i64 {
    return str_from("basic");
}

# `default_complexity()`. ⚠ Deliberately its own fn rather than reusing
# `agnosai_default_complexity` from `core/agent`: they agree on "medium" today
# and are independent knobs — the CRD's is a wire default, core's is a struct
# default, and folding them would couple two contracts that can diverge.
fn agnosai_crd_default_complexity(): i64 {
    return str_from("medium");
}

# `default_priority()`.
fn agnosai_crd_default_priority(): i64 {
    return str_from("normal");
}

# `default_risk()`.
fn agnosai_crd_default_risk(): i64 {
    return str_from("low");
}

# --- ObjectMeta ----------------------------------------------------------

# The oracle's `ObjectMeta::default()` — empty strings and empty maps.
fn agnosai_object_meta_new(): i64 {
    var m = alloc(AGN_OM_SIZE);
    store64(m + AGN_OM_NAME, str_from(""));
    store64(m + AGN_OM_NAMESPACE, str_from(""));
    store64(m + AGN_OM_LABELS, map_new_str());
    store64(m + AGN_OM_ANNOTATIONS, map_new_str());
    return m;
}

# The resource name.
fn agnosai_object_meta_name(m): i64 {
    return load64(m + AGN_OM_NAME);
}

# The namespace.
fn agnosai_object_meta_namespace(m): i64 {
    return load64(m + AGN_OM_NAMESPACE);
}

# The labels map.
fn agnosai_object_meta_labels(m): i64 {
    return load64(m + AGN_OM_LABELS);
}

# The annotations map.
fn agnosai_object_meta_annotations(m): i64 {
    return load64(m + AGN_OM_ANNOTATIONS);
}

# Set the name. Mutates and returns, as Cyrius has no struct update syntax.
fn agnosai_object_meta_with_name(m, name: Str): i64 {
    store64(m + AGN_OM_NAME, name);
    return m;
}

# Set the namespace.
fn agnosai_object_meta_with_namespace(m, ns: Str): i64 {
    store64(m + AGN_OM_NAMESPACE, ns);
    return m;
}

# --- AgentCrdSpec --------------------------------------------------------

# An agent spec. `domain` may be 0.
fn agnosai_agent_crd_spec_new(agent_key: Str, name: Str, role: Str, goal: Str): i64 {
    var a = alloc(AGN_ACRD_SIZE);
    store64(a + AGN_ACRD_AGENT_KEY, agent_key);
    store64(a + AGN_ACRD_NAME, name);
    store64(a + AGN_ACRD_ROLE, role);
    store64(a + AGN_ACRD_GOAL, goal);
    store64(a + AGN_ACRD_TOOLS, vec_new());
    store64(a + AGN_ACRD_COMPLEXITY, agnosai_crd_default_complexity());
    store64(a + AGN_ACRD_DOMAIN, 0);
    return a;
}

