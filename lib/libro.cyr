# ================================================================
# Length-prefixed field hashing
# ================================================================
# Feeds 8-byte little-endian u64 length, then the raw data.
# On x86_64, store64 is natively LE — matches Rust to_le_bytes().

# 2.8.11 — the length prefix is staged on the STACK, not in a process-global
# 8-byte buffer.
#
# The old `_hf_lebuf` global (an alloc(8)) was shared by every caller in the
# process.
# hash_field is called eight times per entry_compute_hash, and
# entry_compute_hash runs on whatever thread verifies — PatraStore reads from
# a worker thread are a supported shape since 2.8.9, and libro is consumed by
# servers (Agnostic). Two threads hashing concurrently interleave
# the length write with the other's 8-byte hasher_update of that buffer, so an
# entry gets hashed with another entry's field length and its digest comes out
# wrong — silently, as a false integrity violation, with no crash to point at.
# Same class as the 2.8.9 cross-thread prepared-statement crash.
#
# A stack slot is per-thread by construction and no slower.
fn hash_field(h, data, len) {
    var lebuf[8];
    store64(&lebuf, len);
    hasher_update(h, &lebuf, 8);
    if (len > 0) {
        hasher_update(h, data, len);
    }
    return 0;
}

