# regression.cyr — testing-stdlib primitives carved from
# `programs/checks/` at v5.9.42.
#
# Usage: include "lib/regression.cyr"
# Requires: string.cyr, syscalls.cyr (host arch variant),
#           io.cyr, alloc.cyr, str.cyr, fmt.cyr,
#           net.cyr (v5.10.11 — `regression_network_probe`
#           composes on `net_connect_nb`).
#
# What this module provides — ~22 reusable primitives that
# accumulated through cyrius's v5.9.6 → v5.9.41 dispatcher
# work, generalized so downstream test runners (yantra,
# agnosys/mabda smoke suites, future runners) can reach for
# the same shapes via a single include rather than re-rolling
# fork/exec/SSH/timeout boilerplate.
#
# Surface groups:
#   - **Display**: section header, pass/fail line, terse print,
#     ANSI-color constants.
#   - **Buffer scan**: prefix compare, substring count,
#     file-contains-substring.
#   - **Process**: pipe-stdin-to-binary (capture / discard),
#     fork+exec with bounded timeout, exec-and-capture,
#     exec-and-discard, exec-with-arg variants for both
#     stdout-only and combined stdout+stderr capture,
#     exec-in-cwd with up-to-3 args ± env-extras.
#   - **Network**: TCP probe (non-blocking connect + poll
#     timeout) — replaces bash `/dev/tcp` pattern.
#   - **SSH cluster**: target resolver (env override + default),
#     reachability skip-check, remote-exit, remote-exec-capture,
#     scp-to, macOS codesign-remote.
#   - Compile-shaped helpers (`pipe-to-compiler-and-run`,
#     `compile-capture-stderr`) live in `programs/checks/`
#     because they wrap `_self_host_pipe`'s 2 MB source-cap +
#     raw-status return convention; the lib's
#     `regression_pipe_to_bin*` use a 1 MB cap and WEXITSTATUS,
#     which are right for arbitrary binaries but not for cyrius
#     source. Callers that need both: compose
#     `regression_pipe_to_bin_capture` + `regression_exec_run`
#     manually.
#
# What this module does NOT provide — explicit non-goals:
#   - A test framework with assert macros / fixture discovery /
#     parallel runners. That's `lib/test.cyr` material; the
#     decision (memory pin 2026-04-30) is to keep the framework
#     surface narrow + earn it on consumer ask, not bundle here.
#   - cyrius-specific gate dispatchers (`_tcyr_relay_gate` /
#     `_expected_output_gate` shapes). Those live in
#     `programs/checks/` because they use audit-internal
#     accounting (`_check`, ROOT_PATH, etc.); generalizing them
#     would need parametrizing call shapes that are dispatcher-
#     idiosyncratic.
#   - Cyrius-specific tool integration (`_cyrlint_count_marker`
#     uses `CYRLINT_PATH`, `_ts_mode_run` uses cycc mode flags).
#     Those stay in their dispatchers as thin wrappers over the
#     primitives this module exports.
#
# Calling conventions:
#   - All `regression_*` verbs that fork+exec take an explicit
#     `envp` arg (a pointer to a null-terminated array of
#     "KEY=VAL" cstrings). Caller passes their own envp; the
#     module never invents one. Use a 1-element array of `0` for
#     "empty environment".
#   - Functions returning exit codes use the stdlib convention:
#     0..127 normal exit; 128+sig on signal; -1 on
#     fork/exec/syscall failure; -2 specifically for timeout.

# v6.2.7: AGNOS has no fork/dup2/execve/chdir/wait4 — the POSIX fork+exec model
# the process/SSH verbs below use can't map onto agnos's in-memory-ELF SYS_SPAWN.
# Route those verbs to a fail-closed peer (mirrors process.cyr → process_agnos.cyr,
# v6.0.51). The PORTABLE verbs (display, buffer-scan, regression_network_probe,
# regression_ssh_target) stay shared. Resolves the regression.cyr cascade layer of
# docs/development/issues/2026-06-15-cyrius-thread-agnos-clone-dispatch.md.
#ifdef CYRIUS_TARGET_AGNOS
include "lib/regression_agnos.cyr"
#endif

# ── Display ───────────────────────────────

var REGRESSION_ANSI_RED   = "\x1b[31m";
var REGRESSION_ANSI_GREEN = "\x1b[32m";
var REGRESSION_ANSI_RESET = "\x1b[0m";

# Print with no trailing newline.
fn regression_print(s): i64 {
    var n = strlen(s);
    syscall(SYS_WRITE, 1, s, n);
    return 0;
}

# Section header: "── name ──\n".
fn regression_section(name): i64 {
    regression_print("── ");
    regression_print(name);
    regression_print(" ──");
    regression_print("\n");
    return 0;
}

# Record + print a PASS/FAIL line for `name` based on `exit_code`
# (0 = PASS, anything else = FAIL). Returns the exit code so
# callers can chain `if (regression_check(...) != 0) { ... }`.
fn regression_check(name, exit_code): i64 {
    regression_print("  ");
    if (exit_code == 0) {
        regression_print(REGRESSION_ANSI_GREEN);
        regression_print("PASS");
    } else {
        regression_print(REGRESSION_ANSI_RED);
        regression_print("FAIL");
    }
    regression_print(REGRESSION_ANSI_RESET);
    regression_print(": ");
    regression_print(name);
    regression_print("\n");
    return exit_code;
}

# ── Buffer scan ───────────────────────────

# Returns 1 if buffer at `p` starts with cstring `s` for n bytes;
# 0 otherwise. The byte-level prefix compare every other scan
# helper composes on top of.
fn regression_buf_eq(p, s, n): i64 {
    var i = 0;
    while (i < n) {
        if (load8(p + i) != load8(s + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Count occurrences of cstring `needle` in `buf[0..n]`. Skips
# past each match (no overlap counting). Empty needle returns 0.
fn regression_count_substr(buf, n, needle): i64 {
    var nlen = strlen(needle);
    if (nlen == 0) { return 0; }
    var count = 0;
    var i = 0;
    while (i + nlen <= n) {
        if (regression_buf_eq(buf + i, needle, nlen) == 1) {
            count = count + 1;
            i = i + nlen;
        } else {
            i = i + 1;
        }
    }
    return count;
}

# Read `path`'s contents into a fresh buffer; return 1 if the
# cstring `substr` appears anywhere in those bytes, else 0.
# Returns 0 also on read failure (the only file-not-readable
# distinction the audit shape needs). Uses `strstr` from
# `lib/string.cyr` for the actual scan.
fn regression_file_contains_substr(path, substr): i64 {
    var cap = 524288;
    var buf = alloc(cap + 1);
    var n = file_read_all(path, buf, cap);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    if (strstr(buf, substr) >= 0) { return 1; }
    return 0;
}

# ── Process: pipe-source-to-binary ──────────────────────────

#ifndef CYRIUS_TARGET_AGNOS
# ⛔ v6.6.6 — EVERY CHILD THIS MODULE SPAWNS IS BOUNDED, AND NONE OUTLIVES ITS PARENT.
#
# Every fork+exec verb below waited with a BLOCKING `sys_waitpid(pid, &st, 0)` and no
# deadline, and set no death signal. So ONE hung child hung the caller for ever —
# measured in the 6.6.6 repair release: a single .tcyr wedged `check.sh` (the check
# driver runs each test through `regression_exec_capture_status` -> `_exec_capture_clean`)
# with no output and no way out but killing the run, which then REPARENTED the test to
# PID 1 where it kept burning a core. That is exactly the defect
# `tests/gates/toolchain/test_runner_bounded.sh` has pinned for the `cyrius test` runner
# since v6.5.19; the check driver never got the same treatment.
#
# Two halves, and the second is the one a timeout alone cannot buy: a DEADLINE (poll
# WNOHANG, then SIGKILL) and PR_SET_PDEATHSIG in the child so the KERNEL reaps it when
# the parent dies — a SIGKILLed parent runs no cleanup, ever, so nothing parent-side can
# reach the child. CHANGELOG [6.6.6]

# Deadline in MILLISECONDS for a child this module spawns. `CYRIUS_CHECK_TIMEOUT` is in
# SECONDS, mirroring `CYRIUS_TEST_TIMEOUT` for the `cyrius test` runner. Default 120 s:
# three orders of magnitude above a .tcyr and well over an order above the slowest compile
# in the suite, so it can only fire on something genuinely stuck. Set it to 0 to disable
# the deadline (then a hang is a hang again — which is what this exists to stop).
fn _regression_timeout_ms(): i64 {
    var v = getenv("CYRIUS_CHECK_TIMEOUT");
    if (v == 0) { return 120000; }
    var s = atoi(v);
    if (s < 0) { return 120000; }
    return s * 1000;
}

# The LONG bound, for children whose runtime is not this process's business: ssh/scp
# (network, minutes for a Windows self-host) and externally-driven gate scripts. BOUNDED
# is the property, not "fast"; 900 s is the bound, and the whole of check.sh runs in ~13
# minutes, so nothing legitimate is near it. `CYRIUS_CHECK_LONG_TIMEOUT` overrides, in
# seconds.
fn _regression_long_timeout_ms(): i64 {
    var v = getenv("CYRIUS_CHECK_LONG_TIMEOUT");
    if (v == 0) { return 900000; }
    var s = atoi(v);
    if (s < 0) { return 900000; }
    return s * 1000;
}

# Called in the CHILD, between fork and execve. PR_SET_PDEATHSIG = 1, SIGKILL = 9; it
# survives execve for a non-setuid binary, so the exec'd program inherits it. Linux only —
# prctl is not a Darwin/BSD syscall and is not routed on PE. The getppid re-check closes
# the race where the parent died between the fork and the prctl, in which case the death
# signal has already been delivered to nobody and will never fire.
fn _regression_child_guard(ppid_before): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    sys_prctl(1, 9, 0, 0, 0);
    if (syscall(SYS_GETPPID) != ppid_before) { sys_exit(1); }
    #endif
    return 0;
}

# ⛔ v6.6.6 — AND THE RUNNER ARMS ONE FOR ITSELF, which is the case the guard above cannot
# reach. `_regression_child_guard` protects every child THIS module forks. Nothing
# protected the check DRIVER, because this module does not fork it: `scripts/check.sh`
# spawns `build/cyrius_check`, and a POSIX shell cannot set PR_SET_PDEATHSIG for a child it
# is about to exec. So a SIGKILLed check.sh left the driver running — OBSERVED at PPID=1,
# nine minutes old, still grinding through a suite nobody was watching.
#
# ⭐ WHY SELF-ARMING AND NOT A WATCHDOG. A watchdog is another process, and another process
# can be SIGKILLed too — the failure mode is identical one level up, and the whole reason
# this defect exists is that a SIGKILLed process runs no cleanup, ever. Self-arming asks
# the KERNEL to deliver SIGKILL when this process's parent dies, however it dies; nothing
# in user space has to survive for it to work. Same reasoning as the child guard, applied
# to a process nobody forked on our behalf.
#
# ⚠ Residual, and it is inherent: if the parent is already gone before this runs, there is
# no death to signal. The getppid re-check catches the parent dying DURING the call (the
# signal was delivered to nobody and will never fire again, so exit now); it cannot catch a
# parent that died before the first getppid. The window is a few instructions at startup.
# Linux only — prctl is not a Darwin/BSD syscall and is not routed on PE. CHANGELOG [6.6.6]
fn _regression_die_with_parent(): i64 {
    #ifdef CYRIUS_TARGET_LINUX
    var ppid0 = syscall(SYS_GETPPID);
    sys_prctl(1, 9, 0, 0, 0);
    if (syscall(SYS_GETPPID) != ppid0) { sys_exit(1); }
    #endif
    return 0;
}

# Wait for `pid`, but not for ever. Returns 1 if the child was reaped normally, 0 if the
# deadline (or a waitpid error) forced a SIGKILL; `stbuf` holds the status either way.
# A waitpid error KILLS rather than returning: a bare return there is an ABANDONMENT path,
# the very thing a deadline exists to prevent — the correction cbt/build.cyr's
# `run_binary_timed` took at v6.5.51 after it was measured leaking children under load.
fn _regression_wait_deadline(pid, stbuf, timeout_ms): i64 {
    if (timeout_ms <= 0) { sys_waitpid(pid, stbuf, 0); return 1; }
    var waited = 0;
    var slice = 1;
    while (waited < timeout_ms) {
        var w = sys_waitpid(pid, stbuf, 1);
        if (w == pid) { return 1; }
        if (w < 0) { sys_kill(pid, 9); sys_waitpid(pid, stbuf, 0); return 0; }
        syscall(7, 0, 0, slice);
        waited = waited + slice;
        if (waited >= 50) { slice = 10; }
        if (waited >= 2000) { slice = 50; }
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, stbuf, 0);
    return 0;
}

# ⛔ v6.6.6 — THE PIPE, NOT ONLY THE WAIT. `_regression_wait_deadline` bounds the WAIT; the
# verbs below reach it only AFTER they have finished pumping the child's pipe, and those
# pumps were unbounded `while` loops. A child that holds its end open and neither reads nor
# writes therefore blocked the runner BEFORE the deadline could run — the write side on the
# ~1 MB `src/main.cyr` pipes as soon as the 64 KB pipe buffer fills, the read side for ever.
# Found by the review of bite 8c, which is why this landed a commit later than the wait.
#
# Both helpers take the deadline as an IDLE one: no progress for `timeout_ms` and they give
# up, leaving the caller's bounded wait to kill the child. That is the right shape here —
# a compiler still emitting bytes is working, and the total is bounded anyway because the
# read side stops at `cap` and the write side at `n`. `timeout_ms <= 0` is the historical
# unbounded pump. CHANGELOG [6.6.6]

# poll(2) one fd. `events` is POLLIN (1) or POLLOUT (4). >0 ready (POLLHUP/POLLERR come back
# whether or not you asked, which is what ends a drain when the child exits), 0 timed out,
# <0 syscall error. syscall 7 is translated by the backend (Darwin poll, aarch64 ppoll).
fn _regression_poll_fd(fd, events, timeout_ms): i64 {
    var pfd[8];
    store32(&pfd,     fd);
    store16(&pfd + 4, events);
    store16(&pfd + 6, 0);
    return syscall(7, &pfd, 1, timeout_ms);
}

# Write all `n` bytes of `buf` to `fd`, waiting at most `timeout_ms` for the child to make
# room each time. Returns the bytes actually written — short means the child stopped
# draining (the caller then closes the fd and its bounded wait deals with the child).
#
# ⚠ THE CHUNK IS THE WHOLE TRICK, AND THE FIRST CUT OF THIS FUNCTION DID NOT HAVE IT — it
# polled and then wrote all `n` remaining bytes, which STILL BLOCKS FOR EVER: a blocking
# write of more than the pipe can hold does not come back with a short count, it waits until
# the whole thing is delivered. POLLOUT on a pipe promises only PIPE_BUF (4096) bytes of
# room, so after a ready poll a chunk of at most 4096 cannot block — and a 1 MB write after
# the same ready poll blocks on byte 65537. Axis 2d of
# tests/gates/toolchain/check_driver_bounded.sh caught exactly that and is the reason the
# axis exists. The unbounded path (`timeout_ms <= 0`) keeps writing in one go, as before.
fn regression_pipe_write_all(fd, buf, n, timeout_ms): i64 {
    var written = 0;
    var chunk_cap = n;
    if (timeout_ms > 0) { chunk_cap = 4096; }   # PIPE_BUF — what POLLOUT actually promises
    while (written < n) {
        if (timeout_ms > 0) {
            if (_regression_poll_fd(fd, 4, timeout_ms) <= 0) { return written; }
        }
        var chunk = n - written;
        if (chunk > chunk_cap) { chunk = chunk_cap; }
        var w = sys_write(fd, buf + written, chunk);
        if (w <= 0) { return written; }
        written = written + w;
    }
    return written;
}

# Drain `fd` into `buf` (at most `cap`), waiting at most `timeout_ms` for each next chunk.
# Returns the bytes read.
fn regression_pipe_read_all(fd, buf, cap, timeout_ms): i64 {
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        if (timeout_ms > 0) {
            if (_regression_poll_fd(fd, 1, timeout_ms) <= 0) { rgo = 0; }
        }
        if (rgo == 1) {
            var n = sys_read(fd, buf + total, cap - total);
            if (n <= 0) { rgo = 0; }
            else {
                total = total + n;
                if (total >= cap) { rgo = 0; }
            }
        }
    }
    return total;
}

# Pipe `src_path`'s bytes to `bin_path`'s stdin. Captures stdout
# to `out_path` (pass 0 for /dev/null) and discards stderr.
# Returns WEXITSTATUS or 128+sig on signal; -1 on syscall
# failure. Fork+exec with explicit envp (caller supplies; pass
# `0`-terminated array for empty env).
fn regression_pipe_to_bin_capture(bin_path, src_path, out_path, envp): i64 {
    var src_cap = 1048576;
    var src_buf = alloc(src_cap);
    var src_n = file_read_all(src_path, src_buf, src_cap);
    if (src_n < 0) { src_n = 0; }

    var out_fd = 0 - 1;
    if (out_path == 0) {
        out_fd = sys_open("/dev/null", 1, 0);
    } else {
        out_fd = sys_open(out_path, 577, 420);
    }
    if (out_fd < 0) { return 0 - 1; }

    var pipefd[16];
    var pr = sys_pipe(&pipefd);
    if (pr < 0) { sys_close(out_fd); return 0 - 1; }
    var rfd = load32(&pipefd);
    var wfd = load32(&pipefd + 4);

    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(rfd); sys_close(wfd); sys_close(out_fd);
        return 0 - 1;
    }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        sys_close(wfd);
        sys_dup2(rfd, 0);
        sys_close(rfd);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[24];   # N BYTES (CLAUDE.md buffer contract): cmd + NUL = 16 B
        store64(&argv,     bin_path);
        store64(&argv + 8, 0);
        sys_execve(bin_path, &argv, envp);
        sys_exit(127);
    }
    sys_close(rfd);
    sys_close(out_fd);
    regression_pipe_write_all(wfd, src_buf, src_n, _regression_timeout_ms());
    sys_close(wfd);
    var stbuf[4];
    # v6.6.6: -2 is the module's documented TIMEOUT code (see the calling conventions at
    # the top). Without this the deadline's SIGKILL is indistinguishable from a genuine
    # one — both read 137 — and "the test crashed" is a very different report from "the
    # test never finished".
    var reaped = _regression_wait_deadline(pid, &stbuf, _regression_timeout_ms());
    if (reaped == 0) { return 0 - 2; }
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
    return 0 - 1;
}

# Pipe `src_path`'s bytes to `bin_path`'s stdin; discard stdout +
# stderr; return WEXITSTATUS or 128+sig. Thin wrapper over
# `regression_pipe_to_bin_capture` with /dev/null output.
fn regression_pipe_to_bin(bin_path, src_path, envp): i64 {
    return regression_pipe_to_bin_capture(bin_path, src_path, 0, envp);
}

# ── Process: bounded run ──────────────────

# Fork + exec with wall-clock timeout. Polls
# `waitpid(WNOHANG)` every 100 ms; on timeout SIGKILLs the
# child + reaps. Replaces the bash `timeout N binary` pattern.
#
# Returns:
#   0..127     normal exit code
#   128..192   128 + WTERMSIG (signal-killed)
#   -1         fork/exec failure
#   -2         timeout (child SIGKILL'd)
fn regression_run_with_timeout(bin_path, timeout_ms, envp): i64 {
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        var dn1 = sys_open("/dev/null", 1, 0);
        if (dn1 >= 0) { sys_dup2(dn1, 1); sys_close(dn1); }
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[24];   # N BYTES (CLAUDE.md buffer contract): cmd + NUL = 16 B
        store64(&argv,     bin_path);
        store64(&argv + 8, 0);
        sys_execve(bin_path, &argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    var elapsed = 0;
    while (elapsed < timeout_ms) {
        var w = sys_waitpid(pid, &stbuf, 1);
        if (w == pid) {
            var status = load32(&stbuf);
            if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
            if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
            return 0 - 1;
        }
        syscall(7, 0, 0, 100);          # poll(NULL,0,100ms) — portable 100ms sleep
        elapsed = elapsed + 100;        # (was nanosleep 35; faults off Linux). v6.0.65
    }
    sys_kill(pid, 9);
    sys_waitpid(pid, &stbuf, 0);
    return 0 - 2;
}

# ── Process: exec + capture ───────────────

# Run `bin_path` (no args), capture stdout into `buf[0..buflen)`,
# discard stderr. Returns bytes captured (>= 0) or 0 on
# fork/open failure. envp threaded through.
# v6.1.35 (CO-02): the exit-status-aware core. `status_out` points to TWO i64
# slots: [0] = exit code (stdlib convention: 0..127 normal, 128+sig on signal,
# -1 on fork/open/exec failure), [1] = 1 if the child was killed by a signal
# (a crash), else 0. The split lets a caller distinguish a normal nonzero exit
# (an output-only fixture returning its last value, e.g. 152) from a crash —
# a single 128+sig code can't (exit(152) aliases signal 24). This closes
# CO-02: the check.sh tcyr gate waited but never read status, so a tcyr that
# crashed before its summary, or exited nonzero after "0 failed", was recorded
# as PASS. `regression_exec_capture` keeps its bytes-only public contract below.
fn regression_exec_capture_status(bin_path, buf, buflen, envp, status_out): i64 {
    var out_path = _regression_tmp_path("audit_xc_");
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { store64(status_out, 0 - 1); store64(status_out + 8, 0); return 0; }
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(out_fd); sys_unlink(out_path);
        store64(status_out, 0 - 1); store64(status_out + 8, 0);
        return 0;
    }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var dn_r = sys_open("/dev/null", 0, 0);
        if (dn_r >= 0) { sys_dup2(dn_r, 0); sys_close(dn_r); }
        var dn_e = sys_open("/dev/null", 1, 0);
        if (dn_e >= 0) { sys_dup2(dn_e, 2); sys_close(dn_e); }
        var argv[24];   # N BYTES (CLAUDE.md buffer contract): cmd + NUL = 16 B
        store64(&argv,     bin_path);
        store64(&argv + 8, 0);
        sys_execve(bin_path, &argv, envp);
        sys_exit(127);
    }
    sys_close(out_fd);
    var stbuf[4];
    var reaped = _regression_wait_deadline(pid, &stbuf, _regression_timeout_ms());
    var status = load32(&stbuf);
    var code = 0 - 1;
    var sig = 0;
    if (WIFEXITED(status) == 1) { code = WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { code = 128 + WTERMSIG(status); sig = 1; }
    # v6.6.6: the DEADLINE, reported as the module's -2, not as the 137 its own SIGKILL
    # produces. A caller must be able to say "it never finished" rather than "it crashed".
    if (reaped == 0) { code = 0 - 2; sig = 0; }
    store64(status_out, code);
    store64(status_out + 8, sig);
    var total = file_read_all(out_path, buf, buflen);
    sys_unlink(out_path);
    if (total < 0) { return 0; }
    return total;
}

# Run `bin_path` (no args), capture stdout into `buf[0..buflen)`, discard
# stderr. Returns bytes captured (>= 0) or 0 on fork/open failure; the exit
# status is discarded (use regression_exec_capture_status to observe it).
fn regression_exec_capture(bin_path, buf, buflen, envp): i64 {
    var _st[16];
    return regression_exec_capture_status(bin_path, buf, buflen, envp, &_st);
}

# Run `bin_path` (no args), discard stdout + stderr. Returns
# WEXITSTATUS or 128+sig.
fn regression_exec_run(bin_path, envp): i64 {
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        var dn1 = sys_open("/dev/null", 1, 0);
        if (dn1 >= 0) { sys_dup2(dn1, 1); sys_close(dn1); }
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[24];   # N BYTES (CLAUDE.md buffer contract): cmd + NUL = 16 B
        store64(&argv,     bin_path);
        store64(&argv + 8, 0);
        sys_execve(bin_path, &argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    # v6.6.6: -2 is the module's documented TIMEOUT code (see the calling conventions at
    # the top). Without this the deadline's SIGKILL is indistinguishable from a genuine
    # one — both read 137 — and "the test crashed" is a very different report from "the
    # test never finished".
    var reaped = _regression_wait_deadline(pid, &stbuf, _regression_timeout_ms());
    if (reaped == 0) { return 0 - 2; }
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    if (WIFSIGNALED(status) == 1) { return 128 + WTERMSIG(status); }
    return 0 - 1;
}

# Run `bin_path arg`, capture stdout into `buf[0..buflen)`,
# discard stderr. Returns bytes captured or 0 on failure.
fn regression_exec_with_arg_capture(bin_path, arg, buf, buflen, envp): i64 {
    var out_path = _regression_tmp_path("audit_xa_");
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0; }
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { sys_close(out_fd); sys_unlink(out_path); return 0; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var dn_r = sys_open("/dev/null", 0, 0);
        if (dn_r >= 0) { sys_dup2(dn_r, 0); sys_close(dn_r); }
        var dn_e = sys_open("/dev/null", 1, 0);
        if (dn_e >= 0) { sys_dup2(dn_e, 2); sys_close(dn_e); }
        var argv[40];   # N BYTES (CLAUDE.md buffer contract): cmd + arg + NUL = 24 B
        store64(&argv,     bin_path);
        store64(&argv + 8, arg);
        store64(&argv + 16, 0);
        sys_execve(bin_path, &argv, envp);
        sys_exit(127);
    }
    sys_close(out_fd);
    var stbuf[4];
    _regression_wait_deadline(pid, &stbuf, _regression_timeout_ms());
    var total = file_read_all(out_path, buf, buflen);
    sys_unlink(out_path);
    if (total < 0) { return 0; }
    return total;
}

# Variant of `regression_exec_with_arg_capture` that captures
# BOTH stdout and stderr into the same buffer. Used when the
# tool emits diagnostics to stderr but the gate wants to scan
# them (e.g. cyrlint warnings).
fn regression_exec_with_arg_capture_both(bin_path, arg, buf, buflen, envp): i64 {
    var out_path = _regression_tmp_path("audit_xa_");
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0; }
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { sys_close(out_fd); sys_unlink(out_path); return 0; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        sys_dup2(out_fd, 1);
        sys_dup2(out_fd, 2);
        sys_close(out_fd);
        var dn_r = sys_open("/dev/null", 0, 0);
        if (dn_r >= 0) { sys_dup2(dn_r, 0); sys_close(dn_r); }
        var argv[40];   # N BYTES (CLAUDE.md buffer contract): cmd + arg + NUL = 24 B
        store64(&argv,     bin_path);
        store64(&argv + 8, arg);
        store64(&argv + 16, 0);
        sys_execve(bin_path, &argv, envp);
        sys_exit(127);
    }
    sys_close(out_fd);
    var stbuf[4];
    _regression_wait_deadline(pid, &stbuf, _regression_timeout_ms());
    var total = file_read_all(out_path, buf, buflen);
    sys_unlink(out_path);
    if (total < 0) { return 0; }
    return total;
}
#endif

# ── Network ───────────────────────────────

# TCP probe — "is `addr_ipv4`:`port` reachable within
# `timeout_ms`?". Replaces the bash `/dev/tcp` trick.
# Returns 1 on reachable, 0 otherwise.
#
# `addr_ipv4` is a network-byte-order packed uint32 (e.g.
# `1 | (1 << 8) | (1 << 16) | (1 << 24)` for 1.1.1.1 — same
# shape `lib/net.cyr` uses).
#
# v5.10.11: factored to compose on `lib/net.cyr::net_connect_nb`.
# Pre-v5.10.11 the syscall sequence (socket / fcntl O_NONBLOCK /
# connect / poll / getsockopt SO_ERROR) was inlined here AND
# in sandhi's `_sandhi_conn_connect_nb` — same shape twice
# with subtly different blocking-mode restore behavior.
# Both now compose on the stdlib primitive (sandhi's
# switchover is sandhi-side per ADR 0001).
fn regression_network_probe(addr_ipv4, port, timeout_ms): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    # AGNOS: raw syscall(41) is SYS_SLEEP_MS (mis-dispatch). Use the portable
    # net.cyr socket adapter (tcp_socket reserves a conn slot, net_connect_nb is
    # agnos-guarded to the blocking #47 connect). v6.2.7.
    var sr_tag, sr = tcp_socket();
    if (is_err_result(sr_tag) == 1) { return 0; }
    var afd = sr;
    var arc = net_connect_nb(afd, addr_ipv4, port, timeout_ms);
    sock_close(afd);
    if (arc == 0) { return 1; }
    return 0;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var fd = syscall(41, 2, 1, 0);                          # socket(AF_INET, SOCK_STREAM)
    if (fd < 0) { return 0; }
    var rc = net_connect_nb(fd, addr_ipv4, port, timeout_ms);
    sys_close(fd);
    if (rc == 0) { return 1; }
    return 0;
    #endif
}

# ── SSH cluster ───────────────────────────

# Resolve an SSH target name. Honors env override
# (`getenv(env_name)` if set), else returns `default_name`.
# Used for the cyrius cross-host verification cluster (pi /
# cass / ecb wired in `~/.ssh/config`).
fn regression_ssh_target(env_name, default_name): i64 {
    var v = getenv(env_name);
    if (v == 0) { return default_name; }
    return v;
}

# Probe whether `target` is reachable via
# `ssh -o BatchMode=yes -o ConnectTimeout=2 target "echo alive"`.
# Returns 1 if reachable, 0 otherwise. Used by SSH-cluster gates
# to skip cleanly when a host isn't currently connectable.
#
# `echo alive` (not `true`) — v5.9.32 portability fix: `true` is
# a Unix builtin missing on Windows PowerShell remotes (cass);
# `echo alive` works on Linux + macOS + Windows-PowerShell.
#ifndef CYRIUS_TARGET_AGNOS
fn regression_ssh_skip_check(target): i64 {
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        var dn1 = sys_open("/dev/null", 1, 0);
        if (dn1 >= 0) { sys_dup2(dn1, 1); sys_close(dn1); }
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[72];   # N BYTES (CLAUDE.md buffer contract): 8 ptrs + NUL = 72 B.
        store64(&argv,      "ssh");      # was argv[8]/envp[1] = 8 B each: the 8
        store64(&argv + 8,  "-o");       # arg writes overran by 56 B and envp[0]
        store64(&argv + 16, "BatchMode=yes");  # aliased argv[1] → ssh got no args.
        store64(&argv + 24, "-o");
        store64(&argv + 32, "ConnectTimeout=2");
        store64(&argv + 40, target);
        store64(&argv + 48, "echo alive");
        store64(&argv + 56, 0);
        var envp[16];
        store64(&envp, 0);
        sys_execve("/usr/bin/ssh", &argv, &envp);
        sys_execve("/bin/ssh",     &argv, &envp);
        sys_exit(127);
    }
    var stbuf[4];
    _regression_wait_deadline(pid, &stbuf, _regression_long_timeout_ms());
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) {
        if (WEXITSTATUS(status) == 0) { return 1; }
    }
    return 0;
}

# `scp -q local_path target:remote_path`. Returns 0 on success,
# non-zero on failure. Honors caller-supplied envp (for any
# proxy-jump / agent-forwarding environment threading).
# `-q` for quiet (suppresses progress meter on stderr).
fn regression_scp_to(target, local_path, remote_path, envp): i64 {
    var dest = _regression_join3(target, ":", remote_path);
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        var dn = sys_open("/dev/null", 1, 0);
        if (dn >= 0) { sys_dup2(dn, 1); sys_close(dn); }
        var argv[48];   # N BYTES (CLAUDE.md buffer contract): 5 ptrs = 40 B
        store64(&argv,      "scp");
        store64(&argv + 8,  "-q");
        store64(&argv + 16, local_path);
        store64(&argv + 24, dest);
        store64(&argv + 32, 0);
        sys_execve("/usr/bin/scp", &argv, envp);
        sys_execve("/bin/scp",     &argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    _regression_wait_deadline(pid, &stbuf, _regression_long_timeout_ms());
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# `ssh target command` — discard stdout/stderr; return
# `command`'s exit status (or 128+sig on signal, -1 on any
# failure). Used by SSH-cluster gates that only care about the
# exit code.
fn regression_ssh_remote_exit(target, command, envp): i64 {
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { return 0 - 1; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        var dn1 = sys_open("/dev/null", 1, 0);
        if (dn1 >= 0) { sys_dup2(dn1, 1); sys_close(dn1); }
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[40];   # N BYTES (CLAUDE.md buffer contract): 4 ptrs = 32 B
        store64(&argv,      "ssh");
        store64(&argv + 8,  target);
        store64(&argv + 16, command);
        store64(&argv + 24, 0);
        sys_execve("/usr/bin/ssh", &argv, envp);
        sys_execve("/bin/ssh",     &argv, envp);
        sys_exit(127);
    }
    var stbuf[4];
    _regression_wait_deadline(pid, &stbuf, _regression_long_timeout_ms());
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# `ssh target command > out_path` — capture stdout into the
# given file (stderr to /dev/null). Returns the command's
# exit status (or -1 on failure).
fn regression_ssh_remote_exec_capture(target, command, out_path, envp): i64 {
    var out_fd = sys_open(out_path, 577, 420);
    if (out_fd < 0) { return 0 - 1; }
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { sys_close(out_fd); return 0 - 1; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        var argv[40];   # N BYTES (CLAUDE.md buffer contract): 4 ptrs = 32 B
        store64(&argv,      "ssh");
        store64(&argv + 8,  target);
        store64(&argv + 16, command);
        store64(&argv + 24, 0);
        sys_execve("/usr/bin/ssh", &argv, envp);
        sys_execve("/bin/ssh",     &argv, envp);
        sys_exit(127);
    }
    sys_close(out_fd);
    var stbuf[4];
    _regression_wait_deadline(pid, &stbuf, _regression_long_timeout_ms());
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# `ssh target chmod +x remote_path && codesign -s - remote_path` —
# adhoc-codesign a Mach-O binary on a remote macOS host (required
# after `scp` since the kernel rejects unsigned new files on
# Apple Silicon, and `scp -p` doesn't always preserve the +x
# bit). Returns the chained exit code; the `2>/dev/null`
# swallows codesign's "not yet signed" pre-warning.
fn regression_codesign_remote(target, remote_path, envp): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "chmod +x ");
    str_builder_add_cstr(sb, remote_path);
    str_builder_add_cstr(sb, " && codesign -s - ");
    str_builder_add_cstr(sb, remote_path);
    str_builder_add_cstr(sb, " 2>/dev/null");
    var cmd = str_data(str_builder_build(sb));
    return regression_ssh_remote_exit(target, cmd, envp);
}

# ── Process: exec-in-cwd with up to 3 args ─────────────────

# Run `bin_path arg1 arg2 arg3` with cwd changed to `work_dir`.
# Capture stdout to `out_path` (pass 0 for /dev/null). Trailing
# `0` args are skipped (so 1-arg / 2-arg invocations don't need
# distinct fns). Returns exit status.
fn regression_exec_in_dir3(work_dir, bin_path, arg1, arg2, arg3, out_path, envp): i64 {
    var out_fd = 0 - 1;
    if (out_path == 0) {
        out_fd = sys_open("/dev/null", 1, 0);
    } else {
        out_fd = sys_open(out_path, 577, 420);
    }
    if (out_fd < 0) { return 0 - 1; }
    var _rg_ppid = sys_getpid();
    var pid = sys_fork();
    if (pid < 0) { sys_close(out_fd); return 0 - 1; }
    if (pid == 0) {
        _regression_child_guard(_rg_ppid);
        var dn0 = sys_open("/dev/null", 0, 0);
        if (dn0 >= 0) { sys_dup2(dn0, 0); sys_close(dn0); }
        sys_dup2(out_fd, 1);
        sys_close(out_fd);
        var dn2 = sys_open("/dev/null", 1, 0);
        if (dn2 >= 0) { sys_dup2(dn2, 2); sys_close(dn2); }
        sys_chdir(work_dir);
        var argv[48];   # N BYTES (CLAUDE.md buffer contract): cmd + 3 args + NUL = 40 B
        var ai = 0;
        store64(&argv + ai * 8, bin_path); ai = ai + 1;
        if (arg1 != 0) { store64(&argv + ai * 8, arg1); ai = ai + 1; }
        if (arg2 != 0) { store64(&argv + ai * 8, arg2); ai = ai + 1; }
        if (arg3 != 0) { store64(&argv + ai * 8, arg3); ai = ai + 1; }
        store64(&argv + ai * 8, 0);
        sys_execve(bin_path, &argv, envp);
        sys_exit(127);
    }
    sys_close(out_fd);
    var stbuf[4];
    _regression_wait_deadline(pid, &stbuf, _regression_timeout_ms());
    var status = load32(&stbuf);
    if (WIFEXITED(status) == 1) { return WEXITSTATUS(status); }
    return 0 - 1;
}

# Variant of `regression_exec_in_dir3` that prepends extra
# "KEY=VAL" cstrings to the inherited envp. `env_extras_vec` is
# a `lib/vec.cyr`-style vector of cstrings; pass 0 for "no
# extras". Used by gates that need to inject CYRIUS_HOME=… etc.
# without baking it into the global ENVP.
fn regression_exec_in_dir3_env(work_dir, bin_path, arg1, arg2, arg3, env_extras_vec, out_path, envp): i64 {
    if (env_extras_vec == 0) {
        return regression_exec_in_dir3(work_dir, bin_path, arg1, arg2, arg3, out_path, envp);
    }
    # Count base envp entries.
    var base_n = 0;
    if (envp != 0) {
        while (load64(envp + base_n * 8) != 0) { base_n = base_n + 1; }
    }
    var extra_n = vec_len(env_extras_vec);
    var merged = alloc((base_n + extra_n + 1) * 8);
    var mi = 0;
    var ei = 0;
    while (ei < extra_n) {
        store64(merged + mi * 8, vec_get(env_extras_vec, ei));
        mi = mi + 1; ei = ei + 1;
    }
    var bi = 0;
    while (bi < base_n) {
        store64(merged + mi * 8, load64(envp + bi * 8));
        mi = mi + 1; bi = bi + 1;
    }
    store64(merged + mi * 8, 0);
    return regression_exec_in_dir3(work_dir, bin_path, arg1, arg2, arg3, out_path, merged);
}
#endif

# ── Internal helpers (underscore prefix; not part of the
# public surface but consistent within this module) ────────

# Build "/tmp/<prefix><pid>" — used by the *_capture variants
# for their scratch files. Same shape as `programs/checks/`'s
# `_tmp_path` so cleanup behavior + collision properties are
# identical.
fn _regression_tmp_path(prefix): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/tmp/");
    str_builder_add_cstr(sb, prefix);
    str_builder_add_int(sb, sys_getpid());
    var s = str_builder_build(sb);
    return str_data(s);
}

# Build "<a><b><c>" as a single cstring. Used by the SSH
# helpers to produce the "target:remote_path" form scp wants.
fn _regression_join3(a, b, c): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, a);
    str_builder_add_cstr(sb, b);
    str_builder_add_cstr(sb, c);
    return str_data(str_builder_build(sb));
}
