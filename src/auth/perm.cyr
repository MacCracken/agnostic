# agnostic/auth/perm — the static role→permission table.
#
# ## Why a table and not a comparison
#
# The tempting shape is `if (role >= AGNOSTIC_ROLE_ADMIN)`. It reads well and it
# is a latent privilege escalation: it makes the *numeric order* of the role enum
# load-bearing, so inserting a role in the middle silently re-grants everything
# above it, and a role that arrives as an out-of-range integer passes every
# `>=` test for the roles below it. `ORACLE-AUDIT.md` records the Python tier
# shipping with everyone a VIEWER and no role assignment at all, which is the
# same class of accident from the other direction.
#
# An explicit bitmask per role has neither property. Adding a role means adding a
# row and deciding what it may do; a value with no row grants **nothing**.
#
# ## ⚠ Fail closed, and prove it
#
# `agnostic_role_can` returns 0 for any role it does not recognise, including
# negative ones — which matters because `agnostic_users_role` and
# `agnostic_jwt_claim_role` both answer **-1** for "no such identity". A caller
# that forgets to check for -1 still gets a refusal rather than a grant.

# ## ⚠ This module is included BEFORE `src/http/router.cyr`, and that is safe
#
# It reads `AGNOSTIC_ROUTE_*`, which `router.cyr` defines further down
# `src/app.cyr`. That is fine — and the reason is worth knowing, because the
# neighbouring comments in `app.cyr` warn about exactly the opposite case.
#
# **enum members are compile-time constants** and resolve across the whole unit
# regardless of include order. **`var` globals are not**: they are initialised in
# include order, so a `var` read from a module included earlier is 0. The audit
# chain's placement note in `app.cyr` is about that second case.
#
# Verified rather than assumed: a probe asserting `AGNOSTIC_ROUTE_CREW_GET == 4`
# and the route mapping from this position passes. If a future refactor turns any
# `AGNOSTIC_ROUTE_*` into a `var`, this module has to move below `router.cyr`.

# What a caller may do. Bit values, so a role is one mask.
enum AgnosticPerm {
    AGNOSTIC_PERM_READ  = 1;
    AGNOSTIC_PERM_WRITE = 2;
    AGNOSTIC_PERM_ADMIN = 4;
    AGNOSTIC_PERM_SUPER = 8;
}

# The name of permission `p` — "read", "write", "admin" or "super", a C string — or 0
# for anything that is not exactly one defined bit. The vocabulary the API schema (H5)
# emits, as `agnostic_role_name` is for roles; nothing authorises by name.
fn agnostic_perm_name(p): i64 {
    if (p == AGNOSTIC_PERM_READ) { return "read"; }
    if (p == AGNOSTIC_PERM_WRITE) { return "write"; }
    if (p == AGNOSTIC_PERM_ADMIN) { return "admin"; }
    if (p == AGNOSTIC_PERM_SUPER) { return "super"; }
    return 0;
}

# The mask for a role, or 0 for anything unrecognised.
#
# ⚠ The masks are written out in full rather than accumulated (`VIEWER | WRITE`)
# so that reading one row tells you the whole grant. A reader should never have
# to compose two rows in their head to answer "can an operator do X".
fn agnostic_role_perms(role): i64 {
    if (role == AGNOSTIC_ROLE_VIEWER) {
        return AGNOSTIC_PERM_READ;
    }
    if (role == AGNOSTIC_ROLE_OPERATOR) {
        return AGNOSTIC_PERM_READ | AGNOSTIC_PERM_WRITE;
    }
    if (role == AGNOSTIC_ROLE_ADMIN) {
        return AGNOSTIC_PERM_READ | AGNOSTIC_PERM_WRITE | AGNOSTIC_PERM_ADMIN;
    }
    if (role == AGNOSTIC_ROLE_SUPER_ADMIN) {
        return AGNOSTIC_PERM_READ | AGNOSTIC_PERM_WRITE | AGNOSTIC_PERM_ADMIN
        | AGNOSTIC_PERM_SUPER;
    }
    return 0;
}

# Whether `role` is within `ceiling`: every permission it holds, `ceiling` holds too. 1 or 0, and
# 0 for an unknown role on either side. What "nobody grants a role above their own" means.
#
# ⚠ **Masks, not `role <= ceiling`**, for the reason at the top of this module: comparing the
# numbers would make the enum's order load-bearing.
fn agnostic_role_within(role, ceiling): i64 {
    var held = agnostic_role_perms(role);
    if (held == 0) { return 0; }
    if ((held & agnostic_role_perms(ceiling)) == held) { return 1; }
    return 0;
}

# Whether `role` holds `perm`. 0 for an unknown role, an unknown permission, or
# a request for more than one bit at a time.
#
# ⚠ **A multi-bit `perm` is refused rather than treated as "any of these".** An
# `&` test against a mask would answer 1 when the caller holds *one* of several
# asked-for rights, which is the opposite of what a permission check means.
fn agnostic_role_can(role, perm): i64 {
    if (perm <= 0) { return 0; }
    if ((perm & (perm - 1)) != 0) { return 0; }
    if (perm > AGNOSTIC_PERM_SUPER) { return 0; }
    if ((agnostic_role_perms(role) & perm) == perm) { return 1; }
    return 0;
}

# The permission a route id requires, or 0 when the route needs no auth.
#
# ⚠ **Anything unclassified falls through to SUPER**, mirroring
# `agnostic_route_needs_auth`'s reasoning (`src/http/router.cyr`): the
# default is what protects a route someone forgets to classify. A new route
# nobody listed here is refused to everyone below a super administrator rather
# than served on a READ check. It was ADMIN until 0.3.0, when a tenant's own
# administrator became a thing that can exist.
#
# ⚠ **ADMIN runs a tenant; SUPER runs the deployment** (0.3.0). Audit S4 found a
# tenant-c ADMIN reading tenant-a's entries from the trail and switching a plugin
# for everyone, against ADR 0008.
#
# ⚠ The audit trail is **SUPER**, not READ or ADMIN. It records who did what across
# the whole deployment and its entries carry no scope to filter by, so anyone below
# SUPER holding it would read activity they cannot otherwise see, including in other
# tenants.
fn agnostic_perm_for_route(id): i64 {
    if (agnostic_route_needs_auth(id) == 0) { return 0; }

    if (id == AGNOSTIC_ROUTE_CREW_SUBMIT) { return AGNOSTIC_PERM_WRITE; }
    if (id == AGNOSTIC_ROUTE_CREW_CANCEL) { return AGNOSTIC_PERM_WRITE; }
    if (id == AGNOSTIC_ROUTE_CREW_GET) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_CREW_EVENTS) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_CREW_PLAN) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_CREW_LIST) { return AGNOSTIC_PERM_READ; }

    if (id == AGNOSTIC_ROUTE_PRESET_LIST) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_TOOLS) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_GPU) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_PRESET_GET) { return AGNOSTIC_PERM_READ; }

    if (id == AGNOSTIC_ROUTE_DEF_LIST) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_DEF_GET) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_DEF_CREATE) { return AGNOSTIC_PERM_WRITE; }
    if (id == AGNOSTIC_ROUTE_DEF_REPLACE) { return AGNOSTIC_PERM_WRITE; }
    if (id == AGNOSTIC_ROUTE_DEF_DELETE) { return AGNOSTIC_PERM_WRITE; }

    # Counts across every tenant, so SUPER for the audit trail's reason. A scraper has a credential
    # of its own that the ladder takes in place of this (`src/routes/metrics.cyr`).
    if (id == AGNOSTIC_ROUTE_METRICS) { return AGNOSTIC_PERM_SUPER; }

    if (id == AGNOSTIC_ROUTE_AUDIT) { return AGNOSTIC_PERM_SUPER; }
    if (id == AGNOSTIC_ROUTE_AUDIT_ENTRIES) { return AGNOSTIC_PERM_SUPER; }

    # ⚠ Switching a plugin is SUPER, not WRITE or ADMIN. It is a setting of the
    # DEPLOYMENT — turning a view on adds its tab for every user, in every tenant — and
    # a tenant's administrator runs their own tenant, not what everyone else is shown.
    if (id == AGNOSTIC_ROUTE_PLUGIN_LIST) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_PLUGIN_SET) { return AGNOSTIC_PERM_SUPER; }

    # A plugin's documents live in the caller's own tenant, so they are ordinary
    # READ and WRITE — unlike the switch above, which changes everyone's view.
    if (id == AGNOSTIC_ROUTE_PDATA_LIST) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_PDATA_GET) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_PDATA_PUT) { return AGNOSTIC_PERM_WRITE; }
    if (id == AGNOSTIC_ROUTE_PDATA_DELETE) { return AGNOSTIC_PERM_WRITE; }

    # Login needs no permission — `agnostic_route_needs_auth` already answered 0
    # for it, so this is unreachable and present only so a reader looking for the
    # route in this table finds it rather than assuming an omission.
    if (id == AGNOSTIC_ROUTE_AUTH_LOGIN) { return 0; }

    # ⚠ READ here means "any user": your own credentials are yours whatever your role, and a
    # viewer can reach nothing else through these. They are never a plugin's to ask for.
    if (id == AGNOSTIC_ROUTE_AUTH_ME) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_AUTH_PASSWORD) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_AUTH_KEYS) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_AUTH_KEY_NEW) { return AGNOSTIC_PERM_READ; }
    if (id == AGNOSTIC_ROUTE_AUTH_KEY_DEL) { return AGNOSTIC_PERM_READ; }

    # An ADMIN runs a tenant's users. Which users is the handler's to decide: the ladder sees a
    # role, and the rule depends on the target (`src/routes/identity.cyr`).
    if (id == AGNOSTIC_ROUTE_USER_LIST) { return AGNOSTIC_PERM_ADMIN; }
    if (id == AGNOSTIC_ROUTE_USER_CREATE) { return AGNOSTIC_PERM_ADMIN; }
    if (id == AGNOSTIC_ROUTE_USER_GET) { return AGNOSTIC_PERM_ADMIN; }
    if (id == AGNOSTIC_ROUTE_USER_UPDATE) { return AGNOSTIC_PERM_ADMIN; }
    if (id == AGNOSTIC_ROUTE_USER_DELETE) { return AGNOSTIC_PERM_ADMIN; }
    if (id == AGNOSTIC_ROUTE_USER_PASSWORD) { return AGNOSTIC_PERM_ADMIN; }
    if (id == AGNOSTIC_ROUTE_USER_KEYS) { return AGNOSTIC_PERM_ADMIN; }
    if (id == AGNOSTIC_ROUTE_USER_KEY_DEL) { return AGNOSTIC_PERM_ADMIN; }

    # Tenants are the deployment's. These four fall through to SUPER as well, and are listed so a
    # reader looking for them finds them.
    if (id == AGNOSTIC_ROUTE_TENANT_LIST) { return AGNOSTIC_PERM_SUPER; }
    if (id == AGNOSTIC_ROUTE_TENANT_CREATE) { return AGNOSTIC_PERM_SUPER; }
    if (id == AGNOSTIC_ROUTE_TENANT_GET) { return AGNOSTIC_PERM_SUPER; }
    if (id == AGNOSTIC_ROUTE_TENANT_DELETE) { return AGNOSTIC_PERM_SUPER; }
    if (id == AGNOSTIC_ROUTE_TENANT_UPDATE) { return AGNOSTIC_PERM_SUPER; }

    return AGNOSTIC_PERM_SUPER;
}
