# agnostic/auth/tenant — tenants, and the key prefix that separates them.
#
# ## ⚠ The separator is only safe because the charset excludes it
#
# Scoping is `"<tenant>:<key>"`. That is a **cross-tenant collision primitive**
# unless the tenant key cannot itself contain the separator: with a free-form
# charset, tenant `a` holding key `b:c` and tenant `a:b` holding key `c` both
# produce `a:b:c`, so one tenant reads and overwrites the other's object with no
# error anywhere.
#
# Tenant keys are therefore `[a-z0-9][a-z0-9-]*` — the same restriction
# `state.md` records for agent keys, and for the same reason: an identifier that
# cannot contain a separator can never be re-parsed as two. `:` is outside the
# set, so a scoped key splits at its first colon and only there.
#
# Validation runs at **creation and at every scope call**, not only at creation.
# A key that reached the database before this rule existed, or through a direct
# SQL path, must not be able to produce an ambiguous scope later.
#
# ## Lookup is a bucket, like every other table here
#
# `tid` is a 63-bit truncated hash in column 0, auto-indexed by patra. The
# `WHERE tid = ?` hit is a candidate; the full key compare is what decides. See
# `src/auth/store.cyr`'s header — the reasoning and the risk are identical.

var AGNOSTIC_TENANT_KEY_MAX = 64;

# A tenant as a listing shows it.
enum AgnosticTenantRowOff {
    AGNOSTIC_TR_KEY     = 0;
    AGNOSTIC_TR_NAME    = 8;
    AGNOSTIC_TR_CREATED = 16;
    AGNOSTIC_TR_RATE    = 24;   # crews a minute, 0 for the server's default (0.3.1)
    AGNOSTIC_TR_CREWS   = 32;   # unfinished crews, 0 for the server's default (0.3.1)
    AGNOSTIC_TR_SIZE    = 40;
}

# What deleting a tenant reports.
enum AgnosticTenantResult {
    AGNOSTIC_TENANT_OK      = 0;
    AGNOSTIC_TENANT_MISSING = 1;
    AGNOSTIC_TENANT_IN_USE  = 2;   # it still has users
    AGNOSTIC_TENANT_FAILED  = 3;
}

# The tenant's key.
fn agnostic_tenant_row_key(r): i64 { return load64(r + AGNOSTIC_TR_KEY); }
# The tenant's display name.
fn agnostic_tenant_row_name(r): i64 { return load64(r + AGNOSTIC_TR_NAME); }
# When the tenant was created, in epoch seconds.
fn agnostic_tenant_row_created(r): i64 { return load64(r + AGNOSTIC_TR_CREATED); }
# The tenant's crews a minute, 0 for the server's default.
fn agnostic_tenant_row_rate(r): i64 { return load64(r + AGNOSTIC_TR_RATE); }
# The tenant's unfinished crews, 0 for the server's default.
fn agnostic_tenant_row_crews(r): i64 { return load64(r + AGNOSTIC_TR_CREWS); }

var AGNOSTIC_TENANTS_TABLE_SQL =
"CREATE TABLE agnostic_tenants (tid INT, tkey STR, tname STR, created INT)";

# The limits (0.3.1, `src/auth/tenantlimit.cyr`). A row from before them reads 0, the server's default.
var AGNOSTIC_TENANTS_RATE_SQL = "ALTER TABLE agnostic_tenants ADD COLUMN rate_limit INT";
var AGNOSTIC_TENANTS_CREWS_SQL = "ALTER TABLE agnostic_tenants ADD COLUMN max_crews INT";

# The most either limit takes.
var AGNOSTIC_TENANT_LIMIT_MAX = 1000000;

# Ensure the tenant table. Mount time only.
fn agnostic_tenants_ensure(): i64 {
    if (agnostic_store_ensure(AGNOSTIC_TENANTS_TABLE_SQL) == 0) { return 0; }
    if (agnostic_store_ensure(AGNOSTIC_TENANTS_RATE_SQL) == 0) { return 0; }
    return agnostic_store_ensure(AGNOSTIC_TENANTS_CREWS_SQL);
}

# Whether `k` is a legal tenant key: `[a-z0-9][a-z0-9-]*`, at most
# `AGNOSTIC_TENANT_KEY_MAX` bytes.
#
# ⚠ Lower case only, not case-folded. Folding here would mean `Acme` and `acme`
# scope to different prefixes unless every caller remembered to fold first —
# refusing the upper-case form removes the chance to forget.
fn agnostic_tenant_key_valid(k: Str): i64 {
    if (k == 0) { return 0; }
    var n = str_len(k);
    if (n == 0 || n > AGNOSTIC_TENANT_KEY_MAX) { return 0; }
    var p = str_data(k);
    var first = load8(p) & 255;
    var ok_first = 0;
    if (first >= 97) { if (first <= 122) { ok_first = 1; } }
    if (first >= 48) { if (first <= 57) { ok_first = 1; } }
    if (ok_first == 0) { return 0; }

    var i = 0;
    while (i < n) {
        var c = load8(p + i) & 255;
        var ok = 0;
        if (c >= 97) { if (c <= 122) { ok = 1; } }
        if (c >= 48) { if (c <= 57) { ok = 1; } }
        if (c == 45) { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# The bucket key for a tenant key. 0 when the key is not legal.
fn agnostic_tenant_tid(key: Str): i64 {
    if (agnostic_tenant_key_valid(key) == 0) { return 0; }
    var tid = agnostic_key64(key);
    if (tid == 0) { return 1; }
    return tid;
}

# Create a tenant. Returns its `tid`, or 0.
fn agnostic_tenant_create_a(a, key: Str, name: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenant_create_locked_a(a, key, name);
    agnostic_store_unlock();
    return r;
}

# `agnostic_tenant_create_a`'s body. The caller holds the store lock, so the
# existence check and the insert are one step.
fn _agnostic_tenant_create_locked_a(a, key: Str, name: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    if (agnostic_tenant_key_valid(key) == 0) { return 0; }
    if (agnostic_tenant_find_a(a, key) != 0) { return 0; }

    var tid = agnostic_tenant_tid(key);
    if (tid == 0) { return 0; }
    var nm = name;
    if (nm == 0) { nm = key; }
    if (str_len(nm) > AGNOSTIC_EMAIL_MAX) { return 0; }

    var st = patra_prepare(db,
      "INSERT INTO agnostic_tenants (tid, tkey, tname, created) VALUES (?, ?, ?, ?)");
    if (st == 0) { return 0; }
    patra_bind_int(st, 0, tid);
    patra_bind_text(st, 1, str_data(key), str_len(key));
    patra_bind_text(st, 2, str_data(nm), str_len(nm));
    patra_bind_int(st, 3, clock_epoch_secs());
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return 0; }
    return tid;
}

# The `tid` for a tenant key, or 0 when there is no such tenant.
#
# ⚠ The full-key re-check is the security boundary, exactly as in
# `agnostic_users_find_a`. A bucket hit alone would let a colliding key address
# another tenant's rows.
fn agnostic_tenant_find_a(a, key: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenant_find_locked_a(a, key);
    agnostic_store_unlock();
    return r;
}

# `agnostic_tenant_find_a`'s body. The caller holds the store lock.
fn _agnostic_tenant_find_locked_a(a, key: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    if (agnostic_tenant_key_valid(key) == 0) { return 0; }
    var tid = agnostic_tenant_tid(key);
    if (tid == 0) { return 0; }

    var st = patra_prepare(db, "SELECT tid, tkey FROM agnostic_tenants WHERE tid = ?");
    if (st == 0) { return 0; }
    patra_bind_int(st, 0, tid);
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }

    var n = patra_result_count(rs);
    var i = 0;
    var found = 0;
    while (i < n) {
        var got = _agnostic_auth_str_a(a, rs, i, 1);
        if (got != 0) {
            if (ct_eq_bytes_lens(str_data(got), str_len(got),
                str_data(key), str_len(key)) == 1) {
                found = patra_result_get_int(rs, i, 0);
                i = n;
            }
        }
        i = i + 1;
    }
    patra_result_free(rs);
    return found;
}

# A tenant's display name, or 0.
fn agnostic_tenant_name_a(a, tid): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenant_name_locked_a(a, tid);
    agnostic_store_unlock();
    return r;
}

# `agnostic_tenant_name_a`'s body. The caller holds the store lock.
fn _agnostic_tenant_name_locked_a(a, tid): i64 {
    var db = agnostic_store_db();
    if (db == 0 || tid == 0) { return 0; }
    var st = patra_prepare(db, "SELECT tname FROM agnostic_tenants WHERE tid = ?");
    if (st == 0) { return 0; }
    patra_bind_int(st, 0, tid);
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    if (patra_result_count(rs) == 0) { patra_result_free(rs); return 0; }
    var out = _agnostic_auth_str_a(a, rs, 0, 0);
    patra_result_free(rs);
    return out;
}

# Delete a tenant. Returns 1 when one went, 0 otherwise.
#
# ⚠ **Deletes the tenant row only.** Objects scoped to it are NOT swept, on
# purpose: a cascade across every scoped table is a data-loss primitive behind a
# single call, and the audit trail must outlive the tenant it describes. An
# operator removing a tenant's data does it deliberately, per table.
fn agnostic_tenant_delete_a(a, key: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenant_delete_locked_a(a, key);
    agnostic_store_unlock();
    return r;
}

# `agnostic_tenant_delete_a`'s body. The caller holds the store lock, so the
# lookup and the delete are one step.
fn _agnostic_tenant_delete_locked_a(a, key: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var tid = agnostic_tenant_find_a(a, key);
    if (tid == 0) { return 0; }
    var st = patra_prepare(db, "DELETE FROM agnostic_tenants WHERE tid = ?");
    if (st == 0) { return 0; }
    patra_bind_int(st, 0, tid);
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return 0; }
    return 1;
}

# Delete tenant `key` if no user belongs to it: an `AGNOSTIC_TENANT_*`.
#
# ⚠ **Refused while it has users, in one critical section with the delete.** A user whose tenant
# is gone would keep a scope nobody can administer. Its stored objects stay, as above, and a tenant
# created later with the same key reads them.
fn agnostic_tenant_delete_empty_a(a, key: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenant_delete_empty_locked_a(a, key);
    agnostic_store_unlock();
    return r;
}

# `agnostic_tenant_delete_empty_a`'s body. The caller holds the store lock.
fn _agnostic_tenant_delete_empty_locked_a(a, key: Str): i64 {
    if (agnostic_tenant_find_a(a, key) == 0) { return AGNOSTIC_TENANT_MISSING; }
    if (_agnostic_users_in_tenant_locked(key) > 0) { return AGNOSTIC_TENANT_IN_USE; }
    if (_agnostic_tenant_delete_locked_a(a, key) == 0) { return AGNOSTIC_TENANT_FAILED; }
    return AGNOSTIC_TENANT_OK;
}

# Row `i` of `SELECT tkey, tname, created, rate_limit, max_crews`, in `a`. 0 on exhaustion.
fn _agnostic_tenants_row_a(a, rs, i): i64 {
    var r = alloc_via(a, AGNOSTIC_TR_SIZE);
    if (r == 0) { return 0; }
    store64(r + AGNOSTIC_TR_KEY, _agnostic_auth_str_a(a, rs, i, 0));
    store64(r + AGNOSTIC_TR_NAME, _agnostic_auth_str_a(a, rs, i, 1));
    store64(r + AGNOSTIC_TR_CREATED, patra_result_get_int(rs, i, 2));
    store64(r + AGNOSTIC_TR_RATE, patra_result_get_int(rs, i, 3));
    store64(r + AGNOSTIC_TR_CREWS, patra_result_get_int(rs, i, 4));
    return r;
}

# Every tenant, by key, as a vec of rows in `a`. 0 when `a` is exhausted or the store cannot answer.
fn agnostic_tenants_list_a(a): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenants_list_locked_a(a);
    agnostic_store_unlock();
    return r;
}

# `agnostic_tenants_list_a`'s body. The caller holds the store lock.
fn _agnostic_tenants_list_locked_a(a): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var rs = patra_query(db,
      "SELECT tkey, tname, created, rate_limit, max_crews FROM agnostic_tenants ORDER BY tkey");
    if (rs == 0) { return 0; }
    var out = vec_new_a(a);
    var i = 0;
    while (out != 0 && i < patra_result_count(rs)) {
        var row = _agnostic_tenants_row_a(a, rs, i);
        if (row == 0) { out = 0; }
        else { vec_push_a(a, out, row); }
        i = i + 1;
    }
    patra_result_free(rs);
    return out;
}

# One tenant as a row in `a`, or 0. Its key is checked in full, as `agnostic_tenant_find_a` does.
fn agnostic_tenant_get_a(a, key: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenant_get_locked_a(a, key);
    agnostic_store_unlock();
    return r;
}

# Change a tenant's name and limits. `name` 0 and a limit of -1 keep what it has. 1, or 0 when there
# is no such tenant or the store refused. The read and the write are one step under the lock, so two
# updates of different fields cannot undo each other.
fn agnostic_tenant_update_a(a, key: Str, name: Str, rate, crews): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenant_update_locked_a(a, key, name, rate, crews);
    agnostic_store_unlock();
    return r;
}

# `agnostic_tenant_update_a`'s body. The caller holds the store lock.
fn _agnostic_tenant_update_locked_a(a, key: Str, name: Str, rate, crews): i64 {
    var row = _agnostic_tenant_get_locked_a(a, key);
    if (row == 0) { return 0; }
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var nm = name;
    if (nm == 0) { nm = agnostic_tenant_row_name(row); }
    var r = rate;
    if (r < 0) { r = agnostic_tenant_row_rate(row); }
    var c = crews;
    if (c < 0) { c = agnostic_tenant_row_crews(row); }
    var st = patra_prepare(db, "UPDATE agnostic_tenants SET tname = ?, rate_limit = ?, max_crews = ? WHERE tid = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(nm), str_len(nm));
    patra_bind_int(st, 1, r);
    patra_bind_int(st, 2, c);
    patra_bind_int(st, 3, agnostic_tenant_tid(key));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return 0; }
    return 1;
}

# `agnostic_tenant_get_a`'s body. The caller holds the store lock.
fn _agnostic_tenant_get_locked_a(a, key: Str): i64 {
    var tid = agnostic_tenant_find_a(a, key);
    if (tid == 0) { return 0; }
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db,
      "SELECT tkey, tname, created, rate_limit, max_crews FROM agnostic_tenants WHERE tid = ?");
    if (st == 0) { return 0; }
    patra_bind_int(st, 0, tid);
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    var out = 0;
    var i = 0;
    while (i < patra_result_count(rs)) {
        var row = _agnostic_tenants_row_a(a, rs, i);
        if (row != 0 && str_eq(agnostic_tenant_row_key(row), key) == 1) { out = row; }
        i = i + 1;
    }
    patra_result_free(rs);
    return out;
}

# How many tenants exist.
fn agnostic_tenants_count(): i64 {
    agnostic_store_lock();
    var r = _agnostic_tenants_count_locked();
    agnostic_store_unlock();
    return r;
}

# `agnostic_tenants_count`'s body. The caller holds the store lock.
fn _agnostic_tenants_count_locked(): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var rs = patra_query(db, "SELECT tid FROM agnostic_tenants");
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    patra_result_free(rs);
    return n;
}

# --- key prefixing --------------------------------------------------------

# `"<tenant>:<key>"` in arena `a`, or 0 when the tenant key is not legal.
#
# ⚠ **Validates the tenant key on every call**, not only at creation. This is the
# function that makes the separator unambiguous, so it cannot assume an earlier
# check happened — a key that reached the row through a direct SQL path would
# otherwise produce a scope that splits two ways.
#
# The object key is NOT restricted: it may contain colons freely. Only the
# tenant half has to be unambiguous for `agnostic_tenant_unscope_a` to split
# correctly, because the split is at the FIRST colon.
fn agnostic_tenant_scope_a(a, tenant: Str, key: Str): i64 {
    if (agnostic_tenant_key_valid(tenant) == 0) { return 0; }
    if (key == 0) { return 0; }
    var tn = str_len(tenant);
    var kn = str_len(key);
    var buf = alloc_via(a, tn + 1 + kn);
    if (buf == 0) { return 0; }
    memcpy(buf, str_data(tenant), tn);
    store8(buf + tn, 58);
    if (kn > 0) { memcpy(buf + tn + 1, str_data(key), kn); }
    return str_new_a(a, buf, tn + 1 + kn);
}

# The object half of a scoped key, or 0 when `scoped` is not in `tenant`'s scope.
#
# ⚠ **Confirms the prefix rather than trusting it.** Splitting at the first colon
# and returning the tail regardless would let `other:secret` be read as
# tenant `other`'s object by anyone who asked for it under their own tenant.
fn agnostic_tenant_unscope_a(a, tenant: Str, scoped: Str): i64 {
    if (agnostic_tenant_key_valid(tenant) == 0) { return 0; }
    if (scoped == 0) { return 0; }
    var tn = str_len(tenant);
    var sn = str_len(scoped);
    if (sn < tn + 1) { return 0; }
    var p = str_data(scoped);
    if ((load8(p + tn) & 255) != 58) { return 0; }
    if (ct_eq_bytes_lens(p, tn, str_data(tenant), tn) != 1) { return 0; }
    return str_new_a(a, p + tn + 1, sn - tn - 1);
}
