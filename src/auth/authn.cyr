# agnostic/auth/authn — turning an Authorization header into a principal.
#
# ## Two schemes, named explicitly, never guessed
#
#   Authorization: Bearer <jwt>
#   Authorization: ApiKey <hex>
#
# The scheme selects the verification path. Sniffing the credential's shape
# instead — "64 hex characters, must be an API key" — would let an attacker pick
# which verifier runs by formatting their input, and the cheaper verifier is
# always the one they would pick.
#
# ## ⚠ The token's role claim is NOT trusted
#
# A verified JWT proves *who* the caller is. The role and tenant are then read
# **from the user row**, not from the claim. That costs one indexed lookup per
# request and buys instant revocation: deleting a user or demoting them takes
# effect on the next request rather than whenever their token happens to expire.
#
# So `agnostic_jwt_claim_role` exists and is deliberately not used here. A token
# whose subject no longer resolves to a user is refused outright — a live token
# for a deleted account is exactly the case a claims-only verifier gets wrong.
#
# ## What a failure does and does not say
#
# Every failure returns 0 and the ladder answers a bare 401. No distinction
# between "no header", "bad scheme", "bad signature", "expired", and "user
# deleted" reaches the client, because each of those is a probe an attacker can
# run cheaply and the differences are all information.

# What the dispatch ladder knows about the transport a request arrived on.
#
# ⚠ Both fields are **transport facts, not claims**: the header as received and
# the peer address as the kernel reports it. Nothing here is trusted as identity
# — `agnostic_authn_resolve_a` is what turns the credential into a principal, and
# the address is used only for rate accounting.
#
# ⚠ **`peer_ip` is the socket peer, deliberately not `X-Forwarded-For`.** Behind
# a proxy every request shares one address and the bucket becomes a global rate
# limit — which is a real deployment problem, but the alternative is worse:
# `X-Forwarded-For` is caller-supplied, so honouring it lets an attacker mint a
# fresh bucket per request and removes the control entirely. A deployment that
# needs per-client buckets behind a proxy has to establish which hop is trusted,
# which is trusted-proxy configuration this does not carry — see CHANGELOG,
# M5 (part 3). #skip-lint
#
# Since 0.1.8 the context also carries what the ladder LEARNS — the principal the
# auth rung resolved, which tenant-scoped handlers read — and two more transport
# facts the ladder checks: the `Content-Type` and `Host` headers. Those two rules bind
# only a context marked as having arrived over a socket (`TRANSPORT`), which only
# `agnostic_serve_handler` sets: an in-process caller such as a suite passes a bare
# context, exactly as it did before the rules existed.
enum AgnosticReqCtxOff {
    AGNOSTIC_REQCTX_AUTHZ     = 0;
    AGNOSTIC_REQCTX_PEER      = 8;
    AGNOSTIC_REQCTX_PRINCIPAL = 16;
    AGNOSTIC_REQCTX_CTYPE     = 24;
    AGNOSTIC_REQCTX_HOST      = 32;
    AGNOSTIC_REQCTX_TRANSPORT = 40;
    AGNOSTIC_REQCTX_IDEM      = 48;   # `Idempotency-Key`, or 0 (0.1.9)
    AGNOSTIC_REQCTX_PLUGIN    = 56;   # `X-Agnostic-Plugin`, or 0 (0.1.9)
    AGNOSTIC_REQCTX_IFMATCH   = 64;   # `If-Match`, or 0 (0.1.9)
    AGNOSTIC_REQCTX_IFNONE    = 72;   # `If-None-Match`, or 0 (0.1.9)
    AGNOSTIC_REQCTX_SIZE      = 80;
}

# Build a request context in `a`. 0 on exhaustion.
fn agnostic_reqctx_new_a(a, authz, peer_ip): i64 {
    var c = alloc_via(a, AGNOSTIC_REQCTX_SIZE);
    if (c == 0) { return 0; }
    store64(c + AGNOSTIC_REQCTX_AUTHZ, authz);
    store64(c + AGNOSTIC_REQCTX_PEER, peer_ip);
    store64(c + AGNOSTIC_REQCTX_PRINCIPAL, 0);
    store64(c + AGNOSTIC_REQCTX_CTYPE, 0);
    store64(c + AGNOSTIC_REQCTX_HOST, 0);
    store64(c + AGNOSTIC_REQCTX_TRANSPORT, 0);
    store64(c + AGNOSTIC_REQCTX_IDEM, 0);
    store64(c + AGNOSTIC_REQCTX_PLUGIN, 0);
    store64(c + AGNOSTIC_REQCTX_IFMATCH, 0);
    store64(c + AGNOSTIC_REQCTX_IFNONE, 0);
    return c;
}

# Mark a context as a socket request and record its `Content-Type` and `Host`
# headers (each a `Str`, or 0 when absent). Only the serve adapter calls this.
fn agnostic_reqctx_set_transport(ctx, ctype, host): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + AGNOSTIC_REQCTX_CTYPE, ctype);
    store64(ctx + AGNOSTIC_REQCTX_HOST, host);
    store64(ctx + AGNOSTIC_REQCTX_TRANSPORT, 1);
    return ctx;
}

# Record the four request headers handlers read (0.1.9), each a `Str` or 0 when absent:
# `Idempotency-Key` (crew submit), `X-Agnostic-Plugin` (the plugin rung, ADR 0007),
# `If-Match` and `If-None-Match` (plugin documents). Unlike `Content-Type` and `Host`
# these are not transport rules — an in-process caller may set them too.
fn agnostic_reqctx_set_headers(ctx, idem, plugin, if_match, if_none): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + AGNOSTIC_REQCTX_IDEM, idem);
    store64(ctx + AGNOSTIC_REQCTX_PLUGIN, plugin);
    store64(ctx + AGNOSTIC_REQCTX_IFMATCH, if_match);
    store64(ctx + AGNOSTIC_REQCTX_IFNONE, if_none);
    return ctx;
}

# The `Idempotency-Key` header as a Str, or 0.
fn agnostic_reqctx_idem(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_IDEM);
}

# The `X-Agnostic-Plugin` header — the plugin a bridged request is made for — or 0.
fn agnostic_reqctx_plugin(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_PLUGIN);
}

# The `If-Match` header as a Str, or 0.
fn agnostic_reqctx_if_match(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_IFMATCH);
}

# The `If-None-Match` header as a Str, or 0.
fn agnostic_reqctx_if_none_match(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_IFNONE);
}

# 1 when the request arrived over a socket, 0 for an in-process caller.
fn agnostic_reqctx_is_transport(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_TRANSPORT);
}

# The `Content-Type` header as a Str, or 0.
fn agnostic_reqctx_ctype(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_CTYPE);
}

# The `Host` header as a Str, or 0.
fn agnostic_reqctx_host(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_HOST);
}

# Record the principal the auth rung resolved. The ladder calls this; a handler
# only reads it.
fn agnostic_reqctx_set_principal(ctx, p): i64 {
    if (ctx == 0) { return 0; }
    store64(ctx + AGNOSTIC_REQCTX_PRINCIPAL, p);
    return p;
}

# The principal the auth rung resolved, or 0 — no context, authentication off, or
# a route that needs none.
fn agnostic_reqctx_principal(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_PRINCIPAL);
}

# The raw Authorization header, or 0. A null context has none.
fn agnostic_reqctx_authz(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_AUTHZ);
}

# The peer address, or 0 when unknown.
#
# ⚠ 0 is a legal bucket key and every context lacking an address shares it. That
# is the correct direction: unknown callers are rate-limited together rather than
# each getting their own allowance.
fn agnostic_reqctx_peer(ctx): i64 {
    if (ctx == 0) { return 0; }
    return load64(ctx + AGNOSTIC_REQCTX_PEER);
}

enum AgnosticPrincipalOff {
    AGNOSTIC_PR_UID    = 0;
    AGNOSTIC_PR_ROLE   = 8;
    AGNOSTIC_PR_TENANT = 16;
    AGNOSTIC_PR_SIZE   = 24;
}

# Whether the ladder enforces identity. Set once at mount from config.
var _agnostic_authn_mode = 0;

# An optional external validator: `fn(a, token) -> uid`. 0 when unset.
var _agnostic_authn_external = 0;

# Install the mode. Mount time only.
fn agnostic_authn_set_mode(m): i64 {
    if (m == AGNOSTIC_AUTH_REQUIRED) { _agnostic_authn_mode = AGNOSTIC_AUTH_REQUIRED; }
    else { _agnostic_authn_mode = AGNOSTIC_AUTH_OFF; }
    return _agnostic_authn_mode;
}

# The current mode.
fn agnostic_authn_mode(): i64 {
    return _agnostic_authn_mode;
}

# Whether identity is enforced right now.
fn agnostic_authn_required(): i64 {
    if (_agnostic_authn_mode == AGNOSTIC_AUTH_REQUIRED) { return 1; }
    return 0;
}

# Install an external token validator, or 0 to remove one. Mount time only.
#
# The validator is `fn(a, token: Str) -> uid` and is the roadmap's external-IdP
# mode. Three properties make it **additive** rather than a second front door,
# and all three are enforced here rather than left to the validator:
#
#   1. It runs **only after local verification has already failed**, so it can
#      never override or weaken an HS256 result.
#   2. Its answer is a **uid, not a principal**. The role and tenant still come
#      from the user row, so an external IdP cannot grant a role this deployment
#      did not assign.
#   3. A uid that does not resolve to a row is refused. An IdP that authenticates
#      somebody unknown here authenticates nobody.
fn agnostic_authn_set_external(fp): i64 {
    _agnostic_authn_external = fp;
    return 1;
}

# The installed external validator, or 0.
fn agnostic_authn_external(): i64 {
    return _agnostic_authn_external;
}

# Build a principal in `a`. 0 on exhaustion.
fn agnostic_principal_new_a(a, uid, role, tenant): i64 {
    var p = alloc_via(a, AGNOSTIC_PR_SIZE);
    if (p == 0) { return 0; }
    store64(p + AGNOSTIC_PR_UID, uid);
    store64(p + AGNOSTIC_PR_ROLE, role);
    store64(p + AGNOSTIC_PR_TENANT, tenant);
    return p;
}

# The authenticated uid, or 0.
fn agnostic_principal_uid(p): i64 {
    if (p == 0) { return 0; }
    return load64(p + AGNOSTIC_PR_UID);
}

# The authenticated role, or -1.
#
# ⚠ -1 for a null principal, matching `agnostic_users_role`. The permission
# table holds nothing for -1, so an unchecked null still cannot act.
fn agnostic_principal_role(p): i64 {
    if (p == 0) { return 0 - 1; }
    return load64(p + AGNOSTIC_PR_ROLE);
}

# The principal's tenant, or 0.
fn agnostic_principal_tenant(p): i64 {
    if (p == 0) { return 0; }
    return load64(p + AGNOSTIC_PR_TENANT);
}

# The scope of a request with no tenant — authentication off, or a user without one.
# Outside the tenant-key charset (`[a-z0-9][a-z0-9-]*`), so it can never be a tenant.
var AGNOSTIC_SCOPE_DEFAULT = str_from("_");

# The scope a principal acts in (0.1.9): its tenant key when that is a legal one, else
# `_`. A principal of 0 — authentication off — is in `_`. Everything tenant-scoped reads
# this one function: plugin documents since 0.1.8, crews since 0.1.9.
fn agnostic_principal_scope(p): i64 {
    var t = agnostic_principal_tenant(p);
    if (t != 0) {
        if (agnostic_tenant_key_valid(t) == 1) { return t; }
    }
    return AGNOSTIC_SCOPE_DEFAULT;
}

# The scope of the request `ctx` carries — its principal's, once the auth rung has run.
fn agnostic_reqctx_scope(ctx): i64 {
    return agnostic_principal_scope(agnostic_reqctx_principal(ctx));
}

# Whether `header` begins with `scheme` followed by exactly one space.
fn _agnostic_authn_scheme_is(header: Str, scheme): i64 {
    var n = strlen(scheme);
    if (str_len(header) < n + 1) { return 0; }
    var p = str_data(header);
    var i = 0;
    while (i < n) {
        if (_agnostic_fold_ascii(load8(p + i) & 255) != _agnostic_fold_ascii(load8(scheme + i) & 255)) {
            return 0;
        }
        i = i + 1;
    }
    if ((load8(p + n) & 255) != 32) { return 0; }
    return 1;
}

# The credential after `scheme `, as a Str in `a`. 0 when empty.
fn _agnostic_authn_credential_a(a, header: Str, scheme): i64 {
    var n = strlen(scheme) + 1;
    var len = str_len(header) - n;
    if (len <= 0) { return 0; }
    return str_new_a(a, str_data(header) + n, len);
}

# Build a principal for `uid` by reading the CURRENT role and tenant from the
# user row. 0 when the uid no longer resolves.
fn _agnostic_authn_principal_for_a(a, uid): i64 {
    if (uid == 0) { return 0; }
    var role = agnostic_users_role(uid);
    if (role < 0) { return 0; }
    var tenant = agnostic_users_tenant_a(a, uid);
    if (tenant == 0) { tenant = str_from_a(a, ""); }
    return agnostic_principal_new_a(a, uid, role, tenant);
}

# Resolve an Authorization header to a principal, or 0.
#
# ⚠ Returns 0 for every failure without distinguishing them — see the module
# header. The caller answers 401 and says nothing more.
fn agnostic_authn_resolve_a(a, header: Str): i64 {
    if (header == 0) { return 0; }
    if (str_len(header) == 0) { return 0; }

    if (_agnostic_authn_scheme_is(header, "Bearer") == 1) {
        var tok = _agnostic_authn_credential_a(a, header, "Bearer");
        if (tok == 0) { return 0; }
        var claims = agnostic_jwt_verify_a(a, tok);
        if (claims == 0) {
            # Local verification failed. Only now may an external IdP be asked,
            # and only for a uid — see `agnostic_authn_set_external`.
            if (_agnostic_authn_external == 0) { return 0; }
            return _agnostic_authn_principal_for_a(a,
              fncall2(_agnostic_authn_external, a, tok));
        }
        # The subject is trusted because the MAC covered it. The ROLE is not —
        # it is re-read from the row below.
        return _agnostic_authn_principal_for_a(a, agnostic_jwt_claim_uid(claims));
    }

    if (_agnostic_authn_scheme_is(header, "ApiKey") == 1) {
        var key = _agnostic_authn_credential_a(a, header, "ApiKey");
        if (key == 0) { return 0; }
        return _agnostic_authn_principal_for_a(a, agnostic_apikey_resolve_a(a, key));
    }

    return 0;
}
