# agnostic/server/serve — the sandhi adapter.
#
# The only module that touches a socket. Handlers return a response record and
# never write bytes, which is what keeps them testable without a server and what
# keeps the route table separable from handler logic.
#
# ## The per-request arena, and why SPILL
#
# `lib/alloc.cyr` is a bump allocator with **no `free()`**. Without a per-request
# arena every `_a` call falls through to that global bump and the process grows
# in proportion to requests served — forever.
#
# `sandhi_server_options_req_arena` defaults to **0, meaning DISABLED**. Not
# calling that setter leaves `sandhi_server_request_arena()` returning 0 for the
# life of the process, so the leak is the default rather than the exception.
#
# The arena is wrapped in `ARENA_FULL_SPILL` because a full arena answers **0**,
# and a `Str` of 0 is indistinguishable from a valid one — there is no option
# type and no error channel through the `_a` families. Without SPILL an oversized
# response is not an error, it is a segfault several frames later.
#
# ⚠ SPILL, not GROW, deliberately. GROW retains its chunks across `arena_reset`,
# so each worker would converge on its worst-ever request and hold that forever,
# times the worker count. Spilled bytes come from the global bump and are not
# reclaimed — the pre-arena cost, applied to the overflow alone.
#
# ## Only run_pooled populates the arena
#
# `thread_local_set` appears exactly once in sandhi's 15,000 lines, inside
# `_sandhi_server_pool_worker`. `run`, `run_opts` and `run_async` have no worker
# to own an arena, and `run_pooled_tls` claims the slot but never allocates one.
# So every `_a` site needs a bare-form fallback; `a != 0` is not defensive
# paranoia, it is the documented contract.
#
# ⛔ **The handler did not keep it** — until 0.1.5 it passed the arena straight
# into `agnostic_reqctx_new_a`, the header read and the whole dispatch, so a
# request without one was a segfault that killed the process. Rather than audit
# every `_a` function below the router for a null, the handler now substitutes the
# global allocator when sandhi gives it none (`_agnostic_serve_fallback_alloc`):
# everything downstream always receives a usable allocator. The cost is the one
# SPILL already accepts — bytes that are not reclaimed — and it is logged once.

var AGNOSTIC_SERVE_ARENA_BYTES = 65536;

# Set once a request has had to run without a per-request arena.
var _agnostic_serve_no_arena_seen = 0;

# The allocator for a request that arrived with no per-request arena: the global
# heap, whose bytes are not reclaimed. Warns the first time, so a deployment that
# is leaking this way is told rather than left to find it in its memory graph.
fn _agnostic_serve_fallback_alloc(): i64 {
    if (atomic_cas(&_agnostic_serve_no_arena_seen, 0, 1) == 1) {
        sakshi_warn(
          "request arrived with no per-request arena; allocating from the global heap, which is not reclaimed",
          98);
    }
    return default_alloc();
}

# SIGINT(2) | SIGTERM(15) as a sigset word: bit (signo - 1).
var AGNOSTIC_SHUTDOWN_SIGMASK = 0x4002;

var _agnostic_serve_cfg = 0;
var _agnostic_serve_stop = 0;

# A fresh arena with the SPILL exhaustion policy.
fn agnostic_spill_arena(capacity): i64 {
    var a = arena_allocator(capacity);
    if (a == 0) { return 0; }
    arena_allocator_set_on_full(a, ARENA_FULL_SPILL);
    return a;
}

# Apply SPILL to sandhi's own request arena.
#
# sandhi owns the arena and resets it between requests, so this does not create
# one — it sets the policy on the existing one. Idempotent, so no thread-local
# flag is needed to remember whether this worker has already done it.
fn _agnostic_spill_for(sandhi_arena): i64 {
    if (sandhi_arena == 0) { return 0; }
    arena_allocator_set_on_full(sandhi_arena, ARENA_FULL_SPILL);
    return sandhi_arena;
}

# 1 once a shutdown signal has been seen.
fn agnostic_serve_stop_requested(): i64 {
    return _agnostic_serve_stop;
}

# Blocks on the signal fd and sets the stop flag. One read is enough — the flag
# is one-way, and a second signal should not be swallowed by this thread.
fn _agnostic_serve_signal_thread(arg): i64 {
    var buf[128];
    var n = sys_read(arg, &buf, 128);
    if (n > 0) { sakshi_info("received shutdown signal, draining", 34); }
    _agnostic_serve_stop = 1;
    return 0;
}

# Block SIGINT/SIGTERM process-wide and watch them on a dedicated thread.
#
# ⚠ **Order matters.** `sigprocmask` must run BEFORE any worker is spawned:
# the mask is inherited, so blocking first is what stops a signal being delivered
# to an arbitrary worker and killing it mid-request. Returns 0 if either syscall
# fails, so the caller can decide whether to serve without graceful shutdown.
fn agnostic_serve_install_signals(): i64 {
    var mask[8];
    store64(&mask, AGNOSTIC_SHUTDOWN_SIGMASK);
    if (sys_sigprocmask(SIG_BLOCK, &mask, 0) < 0) { return 0; }
    var sfd = sys_signalfd(0 - 1, &mask, SFD_CLOEXEC);
    if (sfd < 0) { return 0; }
    thread_create(&_agnostic_serve_signal_thread, sfd);
    return 1;
}

# Write a response record to the connection, and answer the status it sent — the record's,
# or 500 when there was no record or its body would not encode (0.1.16: what the server span
# reports).
#
# Errors from the send are not propagated: the client is already gone in every case that
# produces one, and sandhi closes the connection regardless.
fn _agnostic_serve_send(a, cfd, resp): i64 {
    var status = agnostic_response_status(resp);
    var reason = agnostic_http_reason(status);

    var ctype = "application/json";
    # Every branch below sets it. Until 0.1.16 it started as `str_from("")`, a Str header on
    # the no-free global heap per request that nothing read.
    var body: i64 = 0;
    # Extra header lines, CRLF-terminated, or 0: the WebGUI's pages carry their
    # Content-Security-Policy, a plugin document its ETag, and a 405 its `Allow` — a JSON
    # body, which is why this is read for both kinds (0.1.15).
    var extra = 0;

    if (resp != 0) {
        extra = agnostic_response_headers(resp);
        if (agnostic_response_is_text(resp) == 1) {
            ctype = "text/plain; charset=utf-8";
            if (agnostic_response_ctype(resp) != 0) { ctype = agnostic_response_ctype(resp); }
            body = agnostic_response_body(resp);
        } else {
            var rendered = 0;
            if (a != 0) { rendered = agnostic_encode_a(a, agnostic_response_body(resp)); }
            else { rendered = bayan_json_v_build(agnostic_response_body(resp)); }
            # A render failure means the arena died mid-response. Say 500 rather
            # than sending an empty 200, which a client would treat as success.
            if (rendered == 0) {
                status = HTTP_INTERNAL;
                reason = agnostic_http_reason(status);
                body = str_from("{\"error\":\"response encoding failed\"}");
                extra = 0;   # the headers belonged to the answer this replaces
            } else {
                body = rendered;
            }
        }
    } else {
        # A null response is the handler reporting arena exhaustion. Answer 500
        # with a fixed literal — allocating here would fail for the same reason.
        body = str_from("{\"error\":\"internal error\"}");
    }

    if (a != 0) {
        sandhi_server_send_response_a(a, cfd, status, reason, ctype,
          str_data(body), str_len(body), extra);
    } else {
        sandhi_server_send_response(cfd, status, reason, ctype,
          str_data(body), str_len(body), extra);
    }
    return status;
}

# The OTLP status of a server span for HTTP status `code`: ERROR for a 5xx, and UNSET for
# everything else — a 4xx is the client's error, not the server's, and the HTTP semantic
# conventions leave a SERVER span's status unset for it.
fn _agnostic_serve_span_status(code): i64 {
    if (code >= 500) { return AGNOSAI_OTLP_STATUS_ERROR; }
    return AGNOSAI_OTLP_STATUS_UNSET;
}

# Record this request's HTTP SERVER span through agnosai's exporter (0.1.16, ADR 0020).
#
# Its identity is the request's trace id (`agnostic_trace_current`) — the span id the crews
# it submits name as their parent, and its log lines carry — under the inbound traceparent
# when there was one (`agnostic_trace_parent`). Named `<method> <route>`; a method agnostic
# does not serve is `_OTHER`, so a client cannot mint span names, and a request no route
# matched is named by its method alone. `url.path` drops the query, which can carry
# anything.
#
# ⚠ **Off costs one load.** Nothing is built unless an exporter is running, and with one
# everything is built in `a`, the request's arena: the ring encodes the span into its own
# arena and keeps nothing (agnosai ADR 024), so a recorded request costs the global heap
# nothing more (`tests/server_span.tcyr`). An unsampled trace (`-00`) records nothing.
fn _agnostic_serve_record_span_a(a, method, path: Str, rctx, status, start_ns): i64 {
    if (agnosai_telemetry_exporter() == 0) { return 0; }
    if (a == 0) { return 0; }
    var self_sc = agnosai_otlp_span_context_parse_a(a, agnostic_trace_current());
    if (self_sc == 0) { return 0; }
    var parent_sc = 0;
    var parent = agnostic_trace_parent();
    if (parent != 0) { parent_sc = agnosai_otlp_span_context_parse_a(a, parent); }

    var name = agnostic_method_name(method);
    if (name == 0) { name = "_OTHER"; }
    var route = 0;
    var pattern = agnostic_reqctx_route(rctx);
    if (pattern != 0) { route = str_from_a(a, pattern); }
    var span = agnosai_http_server_span_a(a, str_from_a(a, name), route,
      agnostic_path_only_a(a, path), str_from_a(a, "http"), status);
    return agnosai_telemetry_record_span_in(span, self_sc, parent_sc, start_ns, clock_epoch_ns(),
      _agnostic_serve_span_status(status));
}

# A request header as a `Str` in `a`, or 0 when the request does not carry it. `name` is
# lower-case; sandhi matches header names case-insensitively.
fn _agnostic_serve_header_a(a, buf, blen, name): i64 {
    var raw = sandhi_server_find_header_a(a, buf, blen, name);
    if (raw == 0) { return 0; }
    return str_from_a(a, raw);
}

# sandhi's handler: `fn(ctx, cfd, buf, blen)`.
#
# ⚠ **sandhi's accessors return NUL-terminated cstrings, not `Str`.** Passing one
# straight through reads its pointer as a `Str` header: the method compare
# answers "no method" and `str_len(path)` returns garbage, so every request 404s
# or faults. `str_from_a` wraps without copying the bytes — it is not optional.
fn agnostic_serve_handler(ctx, cfd, buf, blen): i64 {
    # When the request arrived: its server span's start (0.1.16).
    var start_ns = clock_epoch_ns();
    var a = _agnostic_spill_for(sandhi_server_request_arena());
    # Never 0 past this line — see the module header and 0.1.5.
    if (a == 0) { a = _agnostic_serve_fallback_alloc(); }

    # Establish the trace id first so every log line from this request carries it,
    # including ones emitted while the request is still being parsed.
    if (a != 0) { agnostic_trace_begin_a(a, buf, blen); }

    var method_s = 0;
    var raw_path = 0;
    if (a != 0) {
        method_s = sandhi_server_get_method_a(a, buf, blen);
        raw_path = sandhi_server_get_path_a(a, buf, blen);
    } else {
        method_s = sandhi_server_get_method(buf, blen);
        raw_path = sandhi_server_get_path(buf, blen);
    }

    var method = AGNOSTIC_METHOD_NONE;
    if (method_s != 0) {
        if (a != 0) { method = agnostic_method_from(str_from_a(a, method_s)); }
        else { method = agnostic_method_from(str_from(method_s)); }
    }

    # A request with no parseable path is malformed, not a 404 — but answering
    # 400 for it is indistinguishable to a client from a bad route, and sandhi
    # has already accepted the connection. Route "/" so it lands on the normal
    # not-found path rather than a special case.
    #
    # ⚠ In the arena, like everything else here (0.1.16): the two defaults below were
    # `str_from` literals, 16 B each on the no-free global heap per request.
    var path = 0;
    var body = 0;
    if (a != 0) {
        path = str_from_a(a, "/");
        body = str_from_a(a, "");
    } else {
        path = str_from("/");
        body = str_from("");
    }
    if (raw_path != 0) {
        if (a != 0) { path = str_from_a(a, raw_path); }
        else { path = str_from(raw_path); }
    }

    var off = sandhi_server_body_offset(buf, blen);
    if (off > 0) {
        if (off < blen) {
            if (a != 0) { body = str_new_a(a, buf + off, blen - off); }
            else { body = str_new(buf + off, blen - off); }
        }
    }

    var max_body = agnostic_config_max_body(_agnostic_serve_cfg);
    if (max_body <= 0) { max_body = AGNOSTIC_DEFAULT_MAX_BODY; }

    # The credential, read from the raw request rather than reconstructed — the
    # same accessor `agnostic_trace_begin_a` uses for `traceparent`. 0 when the
    # request carried no Authorization header, which the ladder treats as "no
    # credential" rather than as an error.
    var authz = 0;
    var raw_authz = sandhi_server_find_header_a(a, buf, blen, "authorization");
    if (raw_authz != 0) { authz = str_from_a(a, raw_authz); }

    # The peer address is the SOCKET peer, not `X-Forwarded-For` — see
    # `agnostic_reqctx_new_a`. A caller-supplied address would let an attacker
    # mint a fresh rate bucket per request.
    # ⚠ Not named `ctx` — the handler's first PARAMETER is already `ctx` (sandhi's
    # server context), and shadowing it is a compile error whose diagnostic
    # points at an unrelated file.
    var rctx = agnostic_reqctx_new_a(a, authz, sandhi_server_peer_ip(cfd));

    # The two headers the ladder's transport rules read (0.1.8), and the mark that
    # makes those rules apply: this request came over a socket. Same accessor, and the
    # same cstring-to-Str wrap, as the Authorization header above.
    var ctype = 0;
    var raw_ctype = sandhi_server_find_header_a(a, buf, blen, "content-type");
    if (raw_ctype != 0) { ctype = str_from_a(a, raw_ctype); }
    var host = 0;
    var raw_host = sandhi_server_find_header_a(a, buf, blen, "host");
    if (raw_host != 0) { host = str_from_a(a, raw_host); }
    agnostic_reqctx_set_transport(rctx, ctype, host);
    # The four headers handlers read (0.1.9) — see `agnostic_reqctx_set_headers`.
    agnostic_reqctx_set_headers(rctx,
      _agnostic_serve_header_a(a, buf, blen, "idempotency-key"),
      _agnostic_serve_header_a(a, buf, blen, "x-agnostic-plugin"),
      _agnostic_serve_header_a(a, buf, blen, "if-match"),
      _agnostic_serve_header_a(a, buf, blen, "if-none-match"));

    # ⚠ Fail CLOSED without a context. A null `rctx` reads to the ladder as an
    # in-process caller, which skips the transport rules — so a request whose
    # context could not be built is refused, never dispatched without them.
    var resp = 0;
    if (rctx != 0) { resp = agnostic_route_dispatch_a(a, method, path, body, max_body, rctx); }
    var sent = _agnostic_serve_send(a, cfd, resp);
    # After the send, so the span covers the whole answer; before the clear below, which
    # takes the trace id with it.
    _agnostic_serve_record_span_a(a, method, path, rctx, sent, start_ns);

    # Clear the trace id so a worker cannot leak the previous request's id onto
    # the next one if that request never sets one.
    agnostic_trace_clear();
    return 0;
}

# Build sandhi server options from config.
#
# ⚠ `sandhi_server_options_idle_ms` and `_max_conns` have no `opts == 0` guard —
# they store through the pointer unconditionally. Check once here rather than
# relying on every setter.
fn agnostic_serve_options(cfg): i64 {
    var o = sandhi_server_options_new();
    if (o == 0) { return 0; }

    var workers = agnostic_config_workers(cfg);
    if (workers <= 0) { workers = AGNOSTIC_DEFAULT_WORKERS; }
    sandhi_server_options_max_conns(o, workers);

    var idle = agnostic_config_idle_ms(cfg);
    if (idle <= 0) { idle = AGNOSTIC_DEFAULT_IDLE_MS; }
    sandhi_server_options_idle_ms(o, idle);

    var backlog = agnostic_config_backlog(cfg);
    if (backlog <= 0) { backlog = AGNOSTIC_DEFAULT_BACKLOG; }
    sandhi_server_options_backlog(o, backlog);

    # The setter that must not be forgotten — see the module header.
    var arena = agnostic_config_arena_bytes(cfg);
    if (arena <= 0) { arena = AGNOSTIC_SERVE_ARENA_BYTES; }
    sandhi_server_options_req_arena(o, arena);

    var max_body = agnostic_config_max_body(cfg);
    if (max_body > 0) { sandhi_server_options_max_request(o, max_body); }

    sandhi_server_options_stop_flag(o, &_agnostic_serve_stop);
    return o;
}

# Everything that must happen before workers exist.
#
# ⚠ Registration order is a correctness requirement, not tidiness. The readiness
# registry and the config pointer are read lock-free by every worker;
# `run_pooled` spawns those workers, so anything registered after it is a data
# race. Mount, then run.
fn agnostic_serve_mount(cfg): i64 {
    # ⛔ FIRST, before anything else touches thread-local state on this thread:
    # sigil's crypto thread state, on the MAIN thread. Left lazy, the first hash
    # ran it on a pool worker and wiped that worker's request arena — see
    # `agnostic_crypto_main_init`, which also says why it must come first.
    agnostic_crypto_main_init();

    _agnostic_serve_cfg = cfg;
    _agnostic_serve_stop = 0;

    # ⚠ **One process per database file** (0.1.15). The start-up sweep below would interrupt
    # another process's live crews, so the file is claimed before anything else: a second
    # process refused here has started no engine and opened nothing. `src/engine/store.cyr`
    # says why the claim is a sidecar's `flock` and not the database's.
    var db_path = agnostic_config_db_path(cfg);
    var claim = agnostic_store_claim(db_path);
    if (claim == AGNOSTIC_CLAIM_HELD) {
        agnostic_log_kv_str(SK_ERROR, "another agnostic process holds this database; refusing to start", 63,
          "path", 4, db_path);
        return 0;
    }
    if (claim != AGNOSTIC_CLAIM_OK) {
        agnostic_log_kv_str(SK_ERROR, "could not claim the database (its .owner file); refusing to start", 65,
          "path", 4, db_path);
        return 0;
    }

    # ⚠ **A shortfall here refuses to start.** The library is compiled in, so a
    # document that fails to parse is a build-time fault, not a runtime one —
    # and silently serving 17 presets when 18 were embedded is exactly the
    # "smaller result set reported as success" shape this port refuses. The
    # count is the generator's, so the two cannot drift without the gate noticing.
    # --- identity, before anything can serve a request ---------------------
    #
    # ⚠ **Auth off on a non-loopback bind REFUSES TO START.** The default mode is
    # `off` because nothing can authenticate before an operator has provisioned a
    # user and there is no bootstrap route yet — but "unauthenticated" and
    # "reachable from the network" together is not a configuration this binary
    # will run. `state.md` recorded loopback as the only thing standing in front
    # of the crew routes; this makes that structural rather than incidental.
    var auth_mode = agnostic_config_auth_mode(cfg);
    agnostic_authn_set_mode(auth_mode);
    if (auth_mode != AGNOSTIC_AUTH_REQUIRED) {
        if (agnostic_config_addr(cfg) != INADDR_LOOPBACK()) {
            sakshi_error(
              "AGNOSTIC_AUTH is off and the bind is not loopback; refusing to start", 68);
            return 0;
        }
        # Loopback and unauthenticated is allowed, and said out loud. Disclosure
        # is the same mechanism placeholder LLM mode uses — the operator is told
        # what this process is rather than left to infer it.
        sakshi_warn("authentication is OFF; every route is open on loopback", 54);
    }

    # The identity tables share the definition store's handle, so they are
    # created after it opens — see below. The signing secret does not, and a
    # server that cannot sign cannot issue a token, so it is fatal here.
    if (auth_mode == AGNOSTIC_AUTH_REQUIRED) {
        if (agnostic_argon_pool_init() == 0) {
            sakshi_error("could not allocate the Argon2 pool; refusing to start", 53);
            return 0;
        }
        agnostic_log_kv_int(SK_INFO, "argon2 scratch pool", 19,
          "bytes", 5, agnostic_argon_pool_bytes());
        if (agnostic_rl_init() == 0) {
            sakshi_error("could not allocate the login rate table; refusing to start", 58);
            return 0;
        }
        if (agnostic_jwt_ready() == 0) {
            if (agnostic_jwt_init_random() == 0) {
                sakshi_error("could not generate a JWT secret; refusing to start", 50);
                return 0;
            }
            # ⚠ Ephemeral: every restart invalidates every outstanding token.
            # Said plainly rather than discovered when clients start getting 401s.
            sakshi_warn("JWT secret generated; tokens do not survive a restart", 53);
        }
    }

    var presets = agnostic_presets_init();
    if (presets != AGNOSTIC_PRESET_JSON_COUNT) {
        agnostic_log_kv_int(SK_ERROR,
          "compiled-in preset library failed to parse; refusing to start", 61,
          "parsed", 6, presets);
        return 0;
    }

    # ⚠ **Before `run_pooled`, without exception.** The orchestrator, the event
    # bus and the ledger are read lock-free by every worker; `run_pooled` spawns
    # those workers, so building them afterwards is a data race. Same rule, same
    # reason as the readiness registry below.
    if (agnostic_engine_init(cfg) == 0) {
        sakshi_error("could not initialise the engine", 31);
        return 0;
    }

    # A process whose engine is not up cannot do the one thing it exists for, so
    # `/ready` answers 503 and an orchestrator holds traffic off it. `/health`
    # stays 200 — the process is alive, and restarting it would not help. That
    # split is ADR 0001.
    # ⚠ **A store that cannot open is a startup failure, not a degraded mode.**
    # Serving `POST /api/v1/agents/definitions` against a database that is not
    # there would accept a definition and lose it, which is worse than refusing
    # to start. The M3 WARN that said definitions do not survive restart is gone
    # because they now do.
    if (agnostic_definitions_open(db_path) == 0) {
        agnostic_log_kv_str(SK_ERROR, "could not open the database; refusing to start", 46,
          "path", 4, db_path);
        return 0;
    }
    if (agnostic_crews_ensure() == 0) {
        sakshi_error("could not create the crew table; refusing to start", 50);
        return 0;
    }
    # Identity shares this handle — one database, one backup surface.
    if (agnostic_auth_ensure() == 0) {
        sakshi_error("could not create the identity tables; refusing to start", 55);
        return 0;
    }
    if (agnostic_tenants_ensure() == 0) {
        sakshi_error("could not create the tenant table; refusing to start", 52);
        return 0;
    }
    if (agnostic_settings_ensure() == 0) {
        sakshi_error("could not create the settings table; refusing to start", 54);
        return 0;
    }
    if (agnostic_plugindata_ensure() == 0) {
        sakshi_error("could not create the plugin data table; refusing to start", 57);
        return 0;
    }

    # --- the WebGUI (0.1.7) ------------------------------------------------
    #
    # ⚠ **A shortfall refuses to start**, for the preset library's reason: the pages
    # and manifests are compiled in, so one that fails to load is a build fault, and
    # quietly serving fewer plugins than were built is the "smaller result reported
    # as success" shape this port refuses. Read here, after the store opens, because
    # each plugin's switch lives in the settings table.
    var plugins = agnostic_webgui_init();
    if (plugins != AGNOSTIC_WEBGUI_PLUGIN_COUNT) {
        agnostic_log_kv_int(SK_ERROR,
          "compiled-in WebGUI failed to load; refusing to start", 52,
          "plugins", 7, plugins);
        return 0;
    }
    var plugins_on = 0;
    var pi = 0;
    while (pi < plugins) {
        if (agnostic_plugin_enabled(agnostic_plugin_at(pi)) == 1) { plugins_on = plugins_on + 1; }
        pi = pi + 1;
    }
    agnostic_log_kv_int(SK_INFO, "webgui at /ui; plugins switched on", 34,
      "enabled", 7, plugins_on);

    # --- first administrator ----------------------------------------------
    #
    # ⚠ **Auth required with no users and no bootstrap credential REFUSES TO
    # START.** The alternative is a server that is up, enforcing, and impossible
    # to authenticate against — locked shut with no way in and no message saying
    # why. Refusing at mount says it once, loudly, at the moment it can be fixed.
    if (auth_mode == AGNOSTIC_AUTH_REQUIRED) {
        if (agnostic_users_count() == 0) {
            var be = agnostic_config_bootstrap_email(cfg);
            var bp = agnostic_config_bootstrap_password(cfg);
            if (be == 0 || bp == 0) {
                sakshi_error(
                  "AGNOSTIC_AUTH=required, no users exist, and no bootstrap credential is set; refusing to start",
                  93);
                return 0;
            }
            var ba = arena_allocator(1048576);
            if (ba == 0) {
                sakshi_error("could not allocate for bootstrap; refusing to start", 51);
                return 0;
            }
            var buid = agnostic_auth_bootstrap_a(ba, be, bp);
            if (buid == 0) {
                # The only reachable causes here are a refused password (the
                # Argon2 pool is up by now, so this is a CSPRNG or arena fault)
                # or an email the store would truncate. Both are fatal: starting
                # with an unusable identity surface is the case above.
                sakshi_error("could not create the bootstrap administrator; refusing to start", 63);
                return 0;
            }
            # ⚠ The email and uid are logged; the password is NOT.
            agnostic_log_kv_str(SK_INFO, "bootstrap administrator created", 31,
              "email", 5, be);
            sakshi_warn(
              "rotate the bootstrap credential and unset AGNOSTIC_BOOTSTRAP_PASSWORD", 69);
        }
    }
    agnostic_log_kv_str(SK_INFO, "database open", 13, "path", 4, db_path);

    # ⚠ Also fatal. A trail that silently stops recording is worse than a
    # startup that refuses — the whole value of a tamper-evident chain is that
    # its absence is noticed.
    var audit_path = agnostic_config_audit_path(cfg);
    if (agnostic_audit_open(audit_path) == 0) {
        agnostic_log_kv_str(SK_ERROR, "could not open the audit store; refusing to start", 49,
          "path", 4, audit_path);
        return 0;
    }
    agnostic_log_kv_str(SK_INFO, "audit chain open", 16, "path", 4, audit_path);

    # --- crews the last process never finished (0.1.13, ADR 0013) -------------
    #
    # Every crew still recorded as in flight was accepted before this start and has no
    # outcome: its thread died with that process. Each becomes a terminal
    # `interrupted` outcome, listed and audited, so its id answers 200 rather than 404.
    # After the audit chain opens, so each one is recorded; before `run_pooled`, so no
    # request — `/ready` (ADR 0001) included — is answered until it is done, and no
    # readiness check is needed. ⚠ Not fatal: a crew it cannot write keeps its row and
    # is retried at the next start, and nothing else reads that row meanwhile.
    var interrupted = agnostic_crews_interrupt_inflight();
    if (interrupted > 0) {
        agnostic_log_kv_int(SK_WARN, "crews in flight at the last stop are now interrupted", 52,
          "crews", 5, interrupted);
    }

    agnostic_ready_register(str_from("engine"), &agnostic_engine_is_ready);

    # ⚠ **The two size ceilings interact, and the interaction leaks.** A request
    # body is parsed into the per-request arena, and the arena's exhaustion
    # policy is `ARENA_FULL_SPILL` — an overflow is satisfied from the global
    # bump, which has no `free()`. So every body larger than the arena leaks its
    # overflow permanently, in proportion to traffic.
    #
    # The defaults make this reachable: 64 KiB arena against a 1 MiB body limit.
    # The crew routes make it easy to hit — the engine's own caps admit 1000
    # tasks of 10000 characters, several megabytes of entirely legal request.
    #
    # Not a startup failure: the safe configuration depends on the deployment,
    # and refusing to start would be worse than serving with a warning an
    # operator can act on. Raise AGNOSTIC_REQUEST_ARENA_BYTES or lower
    # AGNOSTIC_MAX_BODY_BYTES; note the arena cost is per worker.
    if (agnostic_config_max_body(cfg) > agnostic_config_arena_bytes(cfg)) {
        agnostic_log_kv_int(SK_WARN,
          "max body exceeds the request arena; oversized bodies spill to the global allocator and are not reclaimed",
          104, "arena_bytes", 11, agnostic_config_arena_bytes(cfg));
    }
    return agnostic_serve_options(cfg);
}

# Start OTLP span export when `OTEL_EXPORTER_OTLP_ENDPOINT` is set (0.1.14, ADR 0018), and
# return the guard `agnostic_serve_telemetry_stop` flushes — a guard with export off when it
# is not, so the stop is unconditional.
#
# `agnosai_telemetry_init_export`, not `agnosai_telemetry_init_tracing`: the latter also sets
# sakshi's level and REPLACES its emit hook, and agnostic installs its own JSON hook
# (`src/log.cyr`) and level from AGNOSTIC_LOG_*. This one starts the exporter and touches
# nothing else; it logs the endpoint and service name it exports to at INFO.
#
# ⚠ **After the signal mask**, like the collector: the exporter is a thread, and a thread
# created before `agnostic_serve_install_signals` would take SIGTERM itself and the server
# would never see its shutdown.
fn agnostic_serve_telemetry_start(cfg): i64 {
    if (agnostic_config_otlp_as_is(cfg) == 1) {
        return agnosai_telemetry_init_export_traces(agnostic_config_otlp_endpoint(cfg),
          agnostic_config_otel_service(cfg));
    }
    return agnosai_telemetry_init_export(agnostic_config_otlp_endpoint(cfg),
      agnostic_config_otel_service(cfg));
}

# Flush the spans still queued and stop the exporter — the guard from
# `agnostic_serve_telemetry_start`. A no-op when export is off.
fn agnostic_serve_telemetry_stop(g): i64 {
    if (g == 0) { return 0; }
    return agnosai_telemetry_shutdown(g);
}

# Bind and serve until the stop flag is set. Returns 0 on a graceful stop.
#
# `run_pooled` and not `run`/`run_async`: only the pooled worker populates the
# per-request arena, and without it every allocation goes to the no-free global
# bump.
fn agnostic_serve(cfg): i64 {
    var o = agnostic_serve_mount(cfg);
    if (o == 0) {
        sakshi_error("could not build server options", 30);
        return 1;
    }
    agnostic_serve_install_signals();
    # After the signal mask, which every thread inherits — see `collector.cyr`. A
    # collector that cannot start is survivable: crews are then refreshed only when
    # polled, which is how every release before 0.1.9 ran.
    agnostic_collector_start(&_agnostic_serve_stop);
    # OTLP span export, when configured (0.1.14, ADR 0018) — after the mask, for the same reason.
    var telemetry = agnostic_serve_telemetry_start(cfg);

    var port = agnostic_config_port(cfg);
    var addr = agnostic_config_addr(cfg);
    agnostic_log_kv_int(SK_INFO, "listening", 9, "port", 4, port);

    var rc = sandhi_server_run_pooled(addr, port, &agnostic_serve_handler, 0, o);
    # The last batch is the one most likely to explain the stop: flush it, whatever rc says.
    agnostic_serve_telemetry_stop(telemetry);
    if (rc == 0) { sakshi_info("server shut down gracefully", 27); }
    return rc;
}
