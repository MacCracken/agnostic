# agnostic/config — server configuration, read once from the environment.
#
# ## Why the readers and the interpreters are separate functions
#
# `lib/` has no `setenv`, so nothing can drive an env branch from a `.tcyr`.
# If `agnostic_config_from_env` both read the variable AND interpreted it, the
# interpretation would be untestable — which is how a parser acquires a silent
# divergence and keeps it. So every value is read by a one-line getter and
# interpreted by a pure function that takes the string; the pure half is what
# tests/config.tcyr exercises.
#
# ## The config block
#
# A plain `alloc()`ed block with an enum offset table, not a struct. That is the
# house idiom — AgnosAI declares zero structs and 182 enums for exactly this.

# Whether the dispatch ladder enforces identity.
#
# ⚠ Defined HERE rather than beside the rest of the auth surface in
# `src/auth/authn.cyr`, deliberately: `agnostic_config_from_env` reads it, and
# several suites compile a narrow unit that includes `src/config.cyr` WITHOUT
# the auth modules. Declaring it there made nine of them fail to compile. The
# mode is configuration; its enforcement is not.
enum AgnosticAuthMode {
    AGNOSTIC_AUTH_OFF      = 0;
    AGNOSTIC_AUTH_REQUIRED = 1;
}

enum AgnosticConfigOff {
    AGNOSTIC_CFG_PORT      = 0;
    AGNOSTIC_CFG_ADDR      = 8;
    AGNOSTIC_CFG_WORKERS   = 16;
    AGNOSTIC_CFG_ARENA     = 24;
    AGNOSTIC_CFG_MAX_BODY  = 32;
    AGNOSTIC_CFG_IDLE_MS   = 40;
    AGNOSTIC_CFG_BACKLOG   = 48;
    AGNOSTIC_CFG_LOG_LEVEL = 56;
    AGNOSTIC_CFG_LOG_JSON  = 64;
    AGNOSTIC_CFG_CREW_SECS = 72;
    AGNOSTIC_CFG_LLM_URL   = 80;
    AGNOSTIC_CFG_LLM_KEY   = 88;
    AGNOSTIC_CFG_DB_PATH   = 96;
    AGNOSTIC_CFG_AUDIT_PATH = 104;
    AGNOSTIC_CFG_AUTH_MODE = 112;
    AGNOSTIC_CFG_BOOT_EMAIL = 120;
    AGNOSTIC_CFG_BOOT_PW   = 128;
    AGNOSTIC_CFG_OTLP      = 136;   # OTLP endpoint Str, 0 for off, -1 when malformed (0.1.14)
    AGNOSTIC_CFG_OTEL_SVC  = 144;   # the service name spans are exported as (0.1.14)
    AGNOSTIC_CFG_OTLP_AS_IS = 152;  # 1 when the endpoint is the per-signal traces URL (0.1.14)
    AGNOSTIC_CFG_LLM_SECS  = 160;   # the inference call's ceiling, s; 0 = agnosai's own (0.1.14)
    AGNOSTIC_CFG_REQUEST_MS = 168;  # accept to a complete request, ms (0.2.2)
    AGNOSTIC_CFG_JWT_SECRET = 176;  # the operator's signing secret, a Str, 0 unset, -1 refused
    AGNOSTIC_CFG_PROXIES   = 184;   # the trusted proxies, a table, 0 for none, -1 refused (0.3.1)
    AGNOSTIC_CFG_TENANT_RATE = 192;  # a tenant's crews a minute, 0 for no limit (0.3.1)
    AGNOSTIC_CFG_TENANT_CREWS = 200; # a tenant's unfinished crews, 0 for no limit (0.3.1)
    AGNOSTIC_CFG_METRICS_TOKEN = 208; # the scraper's bearer token, a Str, 0 unset, -1 refused (0.3.1)
    AGNOSTIC_CFG_TARGET_HOSTS = 216; # the hosts a target may name, a vec, 0 for none, -1 refused (0.4.0)
    AGNOSTIC_CFG_SIZE      = 224;
}

# The service name agnostic's spans are exported under when `OTEL_SERVICE_NAME` is unset or
# empty (0.1.14, ADR 0018). agnosai's own default is `agnosai`, which would file every span
# of this process under the library instead of the program.
var AGNOSTIC_DEFAULT_OTEL_SERVICE = "agnostic";

# The longest OTLP endpoint accepted. A URL past this is an operator mistake, not an
# endpoint.
var AGNOSTIC_OTLP_ENDPOINT_MAX = 2048;

# Defaults. The port matches the oracle's uvicorn default so an existing
# deployment's health checks keep pointing at the right place.
var AGNOSTIC_DEFAULT_PORT     = 8000;
var AGNOSTIC_DEFAULT_WORKERS  = 16;
var AGNOSTIC_DEFAULT_ARENA    = 65536;
var AGNOSTIC_DEFAULT_MAX_BODY = 1048576;
var AGNOSTIC_DEFAULT_IDLE_MS  = 30000;

# How long a connection has from accept to a complete request. Each connection holds a pool
# worker while it is read, so this is how long a client that sends nothing can hold one. It is
# the only bound on that: sandhi's read waits on this deadline, not on `AGNOSTIC_IDLE_MS`.
var AGNOSTIC_DEFAULT_REQUEST_MS = 15000;
var AGNOSTIC_DEFAULT_BACKLOG  = 128;

# The crew wall-clock ceiling, added at M2. Matches AgnosAI's own fallback, so an
# unconfigured Agnostic behaves exactly as the engine would alone.
#
# Naming it here rather than leaving the budget unset is what makes it
# *tunable*: `AGNOSAI_NO_LIMIT` in the duration slot makes
# `agnosai_orchestrator_timeout_secs` substitute 3600 silently, so an operator
# lowering the ceiling would have nothing to lower.
#
# ⚠ **There is deliberately no `AGNOSTIC_CREW_MAX_CONCURRENT_TASKS`**, even
# though `ResourceBudget` has a slot for it. Verified against the bundle:
# `agnosai_resource_budget_max_concurrent_tasks` has no reader outside its own
# accessor and the budget serialiser, and `agnosai_orchestrator_budget` has
# **zero** call sites — the field is stored, rendered, and enforced by nothing.
# Exposing it would sell an operator a concurrency ceiling that does not exist,
# which is the precise failure mode `agnostic_config_parse_bounded`'s own comment
# was written about. The ceiling that *does* work is per-request
# `max_concurrency` on process `parallel`, which `src/engine/request.cyr` accepts.
var AGNOSTIC_DEFAULT_CREW_SECS = 3600;

# Where the patra database lives, when AGNOSTIC_DB_PATH says nothing.
#
# ⚠ Relative to the working directory, deliberately. An absolute default under
# /var or $HOME would be wrong for at least one deployment shape and silently
# surprising in the others; a relative default is obviously the operator's to
# set, and mount logs the resolved path so it is never a guess.
var AGNOSTIC_DEFAULT_DB_PATH = "agnostic.patra";

# The audit chain's own database.
#
# ⚠ **A SEPARATE file from AGNOSTIC_DB_PATH, and it has to be.** `patrastore_open`
# calls `patra_open` itself, so pointing both at one path would put two handles
# on one flock-arbitrated file from inside the same process. Two files, two
# handles, no contention.
var AGNOSTIC_DEFAULT_AUDIT_PATH = "agnostic-audit.patra";

# What the budget's unenforced concurrency slot is filled with. The engine's own
# `ResourceBudget::default()` value, so the record serialises identically to one
# the engine built. Not configurable — see above.
var AGNOSTIC_ENGINE_BUDGET_CONC = 10;

# Strict u16 port parse. Returns the port, or -1 for anything malformed.
#
# ⚠ The sentinel is -1, not 0, because **0 is a legal port** — it asks the
# kernel to assign one. A 0 sentinel would make `AGNOSTIC_PORT=0` mean "use the
# default", which is a different behaviour from what the string says.
#
# Accepts one leading `+` and no `-`, matching `u16::from_str`. Transcribed from
# `agnosai_serve_parse_port` (agnosai/src/server/serve.cyr).
fn agnostic_config_parse_port(v: Str): i64 {
    var n = str_len(v);
    var d = str_data(v);
    var i = 0;
    if (n > 0) { if ((load8(d) & 0xFF) == 43) { i = 1; } }
    # An empty string, or a lone "+", is an error — never the default.
    if (i >= n) { return 0 - 1; }
    var acc = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        acc = acc * 10 + (c - 48);
        if (acc > 65535) { return 0 - 1; }
        i = i + 1;
    }
    return acc;
}

# Strict non-negative integer parse bounded by `max`. Returns -1 when malformed
# or out of range.
#
# ⚠ **This is deliberately NOT `parse_port` with a different ceiling**, and the
# duplication is the point. AgnosAI reused its port parser for
# `AGNOSAI_RATE_LIMIT`, so every value above 65535 failed the `acc > 65535`
# check and silently fell back to the default — a rate limit of 200000 became
# whatever the default was, with no error. Any bound other than u16 needs a
# parser whose ceiling is the caller's.
fn agnostic_config_parse_bounded(v: Str, max): i64 {
    var n = str_len(v);
    var d = str_data(v);
    var i = 0;
    if (n > 0) { if ((load8(d) & 0xFF) == 43) { i = 1; } }
    if (i >= n) { return 0 - 1; }
    var acc = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c < 48) { return 0 - 1; }
        if (c > 57) { return 0 - 1; }
        acc = acc * 10 + (c - 48);
        if (acc > max) { return 0 - 1; }
        i = i + 1;
    }
    return acc;
}

# Truthiness for a NUL-terminated cstring, as `getenv` hands it back.
# 1 for "1" or a case-insensitive "true"; everything else, including 0, is 0.
fn agnostic_config_parse_bool(v): i64 {
    if (v == 0) { return 0; }
    var c0 = load8(v) & 0xFF;
    if (c0 == 0) { return 0; }
    # "1" exactly — not "1x".
    if (c0 == 49) { if ((load8(v + 1) & 0xFF) == 0) { return 1; } return 0; }
    # ASCII-case-insensitive "true".
    var want = "true";
    var i = 0;
    while (i < 4) {
        var a = load8(v + i) & 0xFF;
        var b = load8(want + i) & 0xFF;
        if (a >= 65) { if (a <= 90) { a = a + 32; } }
        if (a != b) { return 0; }
        i = i + 1;
    }
    if ((load8(v + 4) & 0xFF) != 0) { return 0; }
    return 1;
}

# Whether the `n` bytes at `d` start with lowercase C string `lit`, ignoring ASCII case.
fn _agnostic_config_ci_prefix(d, n, lit): i64 {
    var m = strlen(lit);
    if (n < m) { return 0; }
    var i = 0;
    while (i < m) {
        var c = load8(d + i) & 0xFF;
        if (c >= 65 && c <= 90) { c = c + 32; }
        if (c != (load8(lit + i) & 0xFF)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Whether `v` is an OTLP endpoint agnostic will export to (0.1.14, ADR 0018): 1, or 0 for a
# malformed one, which refuses to start.
#
# The OpenTelemetry generic form: a BASE URL, `http://` or `https://` (the scheme in any
# case), to which agnosai appends `v1/traces` (`/v1/traces` when the base has no trailing
# `/`), as the OTel exporter specification has it. Refused:
#   * a byte that is a control character or a space anywhere, or more than
#     `AGNOSTIC_OTLP_ENDPOINT_MAX` bytes;
#   * userinfo (`user:pass@`) — sandhi cannot send it, and a credential in a URL reaches
#     the log; a collector's token goes in `OTEL_EXPORTER_OTLP_HEADERS`;
#   * a query or a fragment — appending `v1/traces` after one makes a different URL;
#   * anything sandhi's own URL parser (`sandhi_url_parse_a`) refuses — no host, a port that
#     is not a number, another scheme. The exporter posts through that parser, so asking it
#     here is what makes "agnostic started" and "the exporter can post" one fact.
#
# ⚠ **Checked here because the exporter checks nothing.** agnosai's exporter posts each batch
# with the result ignored — export is best-effort by design, so a collector that is down
# never fails a request — which means a typo'd endpoint loses every span in silence, forever.
# A process that refuses to start names the mistake; the same rule every AGNOSTIC_* value
# follows.
fn agnostic_config_parse_otlp_endpoint(v: Str): i64 {
    var n = str_len(v);
    if (n == 0 || n > AGNOSTIC_OTLP_ENDPOINT_MAX) { return 0; }
    var d = str_data(v);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c <= 32 || c == 127) { return 0; }
        if (c == 64 || c == 63 || c == 35) { return 0; }   # '@' userinfo, '?' query, '#' fragment
        i = i + 1;
    }
    var host = 0;
    if (_agnostic_config_ci_prefix(d, n, "http://") == 1) { host = 7; }
    if (_agnostic_config_ci_prefix(d, n, "https://") == 1) { host = 8; }
    if (host == 0 || host >= n) { return 0; }
    if ((load8(d + host) & 0xFF) == 47) { return 0; }
    # Once, at start-up: the parse allocates on the global bump, a few dozen bytes.
    if (sandhi_url_parse_a(default_alloc(), str_cstr(v)) == 0) { return 0; }
    return 1;
}

# `AGNOSTIC_AUTH` as a mode: `off` (or empty) and `required`, in any case. -1 for anything
# else, which the caller refuses.
fn agnostic_config_parse_auth(v: Str): i64 {
    if (str_len(v) == 0) { return AGNOSTIC_AUTH_OFF; }
    if (agnostic_str_eq_cstr_ci(v, "off") == 1) { return AGNOSTIC_AUTH_OFF; }
    if (agnostic_str_eq_cstr_ci(v, "required") == 1) { return AGNOSTIC_AUTH_REQUIRED; }
    return 0 - 1;
}

# The most entries `AGNOSTIC_TRUSTED_PROXIES` takes. Rules are walked per request, and a deployment
# has a handful of proxies or one network.
var AGNOSTIC_PROXIES_MAX = 32;

# The table `agnostic_config_parse_proxies` builds: a count, then that many (net, mask) pairs, each
# a 32-bit address in big-endian order, so that a mask reads from the top.
enum AgnosticProxyTableOff {
    AGNOSTIC_PXT_COUNT = 0;
    AGNOSTIC_PXT_RULES = 8;
    AGNOSTIC_PXR_NET   = 0;
    AGNOSTIC_PXR_MASK  = 8;
    AGNOSTIC_PXR_SIZE  = 16;
}

# A packed address (`net_parse_ipv4`'s and `sandhi_server_peer_ip`'s form) as a big-endian integer.
fn agnostic_ip_order(packed): i64 {
    return ((packed & 0xFF) << 24) | ((packed & 0xFF00) << 8)
    | ((packed >> 8) & 0xFF00) | ((packed >> 24) & 0xFF);
}

# Parse one `a.b.c.d` or `a.b.c.d/n` of `n` bytes into `rule`. 1, or 0 when it is malformed.
#
# ⚠ **`/0` and host bits are refused.** `/0` trusts every caller, which hands each of them a fresh
# login bucket: the setting would remove the control it exists to keep working. `10.1.2.3/8` is
# almost always a typo for a host or a narrower network, and guessing which is how a proxy ends up
# untrusted or a network trusted.
fn _agnostic_config_proxy_rule(d, n, rule): i64 {
    var addr_n = 0;
    while (addr_n < n && load8(d + addr_n) != 47) { addr_n = addr_n + 1; }
    if (addr_n == 0 || addr_n > 15) { return 0; }
    var text[16];
    memcpy(&text, d, addr_n);
    store8(&text + addr_n, 0);
    var packed = net_parse_ipv4(&text);
    if (packed < 0) { return 0; }

    var prefix = 32;
    if (addr_n < n) {
        var digits = n - addr_n - 1;
        if (digits < 1 || digits > 2) { return 0; }
        # A leading zero. That is `/08`, and it is also how `/0` goes.
        if (load8(d + addr_n + 1) == 48) { return 0; }
        prefix = 0;
        var i = addr_n + 1;
        while (i < n) {
            var c = load8(d + i);
            if (c < 48 || c > 57) { return 0; }
            prefix = prefix * 10 + (c - 48);
            i = i + 1;
        }
        if (prefix > 32) { return 0; }
    }
    var mask = (0xFFFFFFFF << (32 - prefix)) & 0xFFFFFFFF;
    var net = agnostic_ip_order(packed);
    if ((net & mask) != net) { return 0; }
    store64(rule + AGNOSTIC_PXR_NET, net);
    store64(rule + AGNOSTIC_PXR_MASK, mask);
    return 1;
}

# `AGNOSTIC_TRUSTED_PROXIES`, a comma-separated list of IPv4 addresses and networks, as a table:
# 0 when it is empty, or -1 when any entry is malformed or there are too many.
#
# IPv4 only, because the socket peer it is compared with is: sandhi's server binds AF_INET.
fn agnostic_config_parse_proxies(v: Str): i64 {
    var n = str_len(v);
    if (n == 0) { return 0; }
    var d = str_data(v);
    var t = alloc(AGNOSTIC_PXT_RULES + AGNOSTIC_PROXIES_MAX * AGNOSTIC_PXR_SIZE);
    if (t == 0) { return 0 - 1; }
    var count = 0;
    var i = 0;
    while (i <= n) {
        var e = i;
        while (e < n && load8(d + e) != 44) { e = e + 1; }
        var s = i;
        var f = e;
        while (s < f && load8(d + s) == 32) { s = s + 1; }
        while (f > s && load8(d + f - 1) == 32) { f = f - 1; }
        if (count >= AGNOSTIC_PROXIES_MAX) { return 0 - 1; }
        var rule = t + AGNOSTIC_PXT_RULES + count * AGNOSTIC_PXR_SIZE;
        if (_agnostic_config_proxy_rule(d + s, f - s, rule) == 0) { return 0 - 1; }
        count = count + 1;
        i = e + 1;
    }
    store64(t + AGNOSTIC_PXT_COUNT, count);
    return t;
}

# Whether packed address `ip` is covered by table `t`. 1 or 0, and 0 for no table.
fn agnostic_proxy_trusted(t, ip): i64 {
    if (t == 0) { return 0; }
    var be = agnostic_ip_order(ip);
    var n = load64(t + AGNOSTIC_PXT_COUNT);
    var i = 0;
    while (i < n) {
        var r = t + AGNOSTIC_PXT_RULES + i * AGNOSTIC_PXR_SIZE;
        if ((be & load64(r + AGNOSTIC_PXR_MASK)) == load64(r + AGNOSTIC_PXR_NET)) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The most entries `AGNOSTIC_TARGET_HOSTS` takes. A target is checked against each one.
var AGNOSTIC_TARGET_HOSTS_MAX = 64;

# The longest host name DNS can answer.
var AGNOSTIC_HOST_MAX = 253;

# Whether `d` to `d + n` is a bracketed IPv6 address's text: hex digits, colons and dots.
fn _agnostic_host_v6(d, n): i64 {
    if (n < 4 || (load8(d + n - 1) & 255) != 93) { return 0; }
    var colons = 0;
    var i = 1;
    while (i < n - 1) {
        var c = load8(d + i) & 255;
        var ok = 0;
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c >= 97 && c <= 102) { ok = 1; }
        if (c >= 65 && c <= 70) { ok = 1; }
        if (c == 46) { ok = 1; }
        if (c == 58) { ok = 1; colons = colons + 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    if (colons < 2) { return 0; }
    return 1;
}

# Whether `d` to `d + n` is a host as a target URL and `AGNOSTIC_TARGET_HOSTS` may spell one: a name
# or IPv4 address of dot-separated labels of letters, digits, `-` and `_`, or a bracketed IPv6
# address. No port, no trailing dot, no percent-encoding and nothing outside ASCII: two hosts are
# compared as text, so each host has one spelling (`src/engine/target.cyr`).
fn agnostic_host_valid(d, n): i64 {
    if (n < 1 || n > AGNOSTIC_HOST_MAX) { return 0; }
    if ((load8(d) & 255) == 91) { return _agnostic_host_v6(d, n); }
    var label = 0;
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 255;
        if (c == 46) {
            if (label == 0) { return 0; }
            label = 0;
        } else {
            var ok = 0;
            if (c >= 97 && c <= 122) { ok = 1; }
            if (c >= 65 && c <= 90) { ok = 1; }
            if (c >= 48 && c <= 57) { ok = 1; }
            if (c == 45 || c == 95) { ok = 1; }
            if (ok == 0) { return 0; }
            label = label + 1;
        }
        i = i + 1;
    }
    if (label == 0) { return 0; }
    return 1;
}

# `AGNOSTIC_TARGET_HOSTS`, a comma-separated list of hosts, as a vec of lowercase Strs: 0 when it is
# empty, or -1 for an entry `agnostic_host_valid` refuses, a port among them, or too many. A list the
# server cannot read refuses to start, rather than run with fewer hosts than its operator wrote.
fn agnostic_config_parse_target_hosts(v: Str): i64 {
    var n = str_len(v);
    if (n == 0) { return 0; }
    var d = str_data(v);
    var hosts = vec_new();
    var i = 0;
    while (i <= n) {
        var e = i;
        while (e < n && load8(d + e) != 44) { e = e + 1; }
        var s = i;
        var f = e;
        while (s < f && load8(d + s) == 32) { s = s + 1; }
        while (f > s && load8(d + f - 1) == 32) { f = f - 1; }
        if (vec_len(hosts) >= AGNOSTIC_TARGET_HOSTS_MAX) { return 0 - 1; }
        if (agnostic_host_valid(d + s, f - s) == 0) { return 0 - 1; }
        var h = alloc(f - s + 1);
        var k = 0;
        while (k < f - s) {
            var c = load8(d + s + k) & 255;
            if (c >= 65 && c <= 90) { c = c + 32; }
            store8(h + k, c);
            k = k + 1;
        }
        store8(h + k, 0);
        vec_push(hosts, str_new(h, k));
        i = e + 1;
    }
    return hosts;
}

# The shortest `AGNOSTIC_JWT_SECRET`. This module is included on its own by `tests/config.tcyr`, so
# it cannot read `AGNOSTIC_JWT_SECRET_MIN`; `tests/authn.tcyr` holds the two equal.
var AGNOSTIC_CONFIG_JWT_SECRET_MIN = 32;

# `AGNOSTIC_JWT_SECRET` as a secret: the value itself, 0 when it is empty, or -1 when it is
# shorter than `agnostic_jwt_set_secret` takes. Measured in bytes, as the HMAC reads it.
fn agnostic_config_parse_jwt_secret(v: Str): i64 {
    if (str_len(v) == 0) { return 0; }
    if (str_len(v) < AGNOSTIC_CONFIG_JWT_SECRET_MIN) { return 0 - 1; }
    return v;
}

# `AGNOSTIC_ADDR` as an address: `any`, or loopback spelled `loopback`, `localhost`,
# `127.0.0.1` or left empty. -1 for anything else, which the caller refuses.
fn agnostic_config_parse_addr(v: Str): i64 {
    if (str_len(v) == 0) { return INADDR_LOOPBACK(); }
    if (agnostic_str_eq_cstr_ci(v, "any") == 1) { return INADDR_ANY(); }
    if (agnostic_str_eq_cstr_ci(v, "loopback") == 1) { return INADDR_LOOPBACK(); }
    if (agnostic_str_eq_cstr_ci(v, "localhost") == 1) { return INADDR_LOOPBACK(); }
    if (agnostic_str_eq_cstr_ci(v, "127.0.0.1") == 1) { return INADDR_LOOPBACK(); }
    return 0 - 1;
}

# 1 when URL `v` holds userinfo: an `@` between `://` and the path.
fn agnostic_config_url_has_userinfo(v: Str): i64 {
    var n = str_len(v);
    var d = str_data(v);
    var i = 0;
    while (i + 2 < n) {
        if (load8(d + i) == 58 && load8(d + i + 1) == 47 && load8(d + i + 2) == 47) { break; }
        i = i + 1;
    }
    if (i + 2 >= n) { return 0; }
    i = i + 3;
    while (i < n) {
        var c = load8(d + i) & 0xFF;
        if (c == 47 || c == 63 || c == 35) { return 0; }
        if (c == 64) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Map a log-level name to its sakshi constant. -1 for an unknown name, so the
# caller can reject rather than silently pick a level the operator did not ask
# for. Case-insensitive.
fn agnostic_config_parse_level(v: Str): i64 {
    if (agnostic_str_eq_cstr_ci(v, "error") == 1) { return SK_ERROR; }
    if (agnostic_str_eq_cstr_ci(v, "warn") == 1)  { return SK_WARN; }
    if (agnostic_str_eq_cstr_ci(v, "info") == 1)  { return SK_INFO; }
    if (agnostic_str_eq_cstr_ci(v, "debug") == 1) { return SK_DEBUG; }
    if (agnostic_str_eq_cstr_ci(v, "trace") == 1) { return SK_TRACE; }
    return 0 - 1;
}

# `getenv(primary)`, falling back to `fallback` only when primary is UNSET.
#
# ⚠ Unset, not empty. `AGNOSTIC_PORT=""` is an operator explicitly clearing the
# value and must not silently inherit `PORT` — it should fail the strict parse
# and be reported, which is what an empty string does.
fn _agnostic_config_env2(primary, fallback): i64 {
    var v = getenv(primary);
    if (v != 0) { return v; }
    return getenv(fallback);
}

# Read one bounded integer from the environment, or return `dflt`.
# A malformed value is NOT silently defaulted — it returns -1 so the caller can
# refuse to start. Starting on a misread config is how an operator discovers in
# production that their setting never applied.
fn _agnostic_config_int_env(name, dflt, max): i64 {
    var raw = getenv(name);
    if (raw == 0) { return dflt; }
    return agnostic_config_parse_bounded(str_from(raw), max);
}

# Build the config block from the environment. Returns 0 on allocation failure,
# or a block whose integer fields are -1 where the environment was malformed.
fn agnostic_config_from_env(): i64 {
    var c = alloc(AGNOSTIC_CFG_SIZE);
    if (c == 0) { return 0; }

    var port = AGNOSTIC_DEFAULT_PORT;
    var raw_port = _agnostic_config_env2("AGNOSTIC_PORT", "PORT");
    if (raw_port != 0) { port = agnostic_config_parse_port(str_from(raw_port)); }
    store64(c + AGNOSTIC_CFG_PORT, port);

    # Loopback by default, and `any` for 0.0.0.0. Loopback is the safe direction: a service
    # that is unreachable is a visible failure, one that is reachable from the whole network
    # by accident is not. Anything else is refused, not read as loopback: `10.1.2.3` used to
    # start on 127.0.0.1 and answer no one, with nothing saying why.
    var raw_addr = getenv("AGNOSTIC_ADDR");
    var addr = INADDR_LOOPBACK();
    if (raw_addr != 0) { addr = agnostic_config_parse_addr(str_from(raw_addr)); }
    store64(c + AGNOSTIC_CFG_ADDR, addr);

    store64(c + AGNOSTIC_CFG_WORKERS,
      _agnostic_config_int_env("AGNOSTIC_WORKERS", AGNOSTIC_DEFAULT_WORKERS, 1024));
    store64(c + AGNOSTIC_CFG_ARENA,
      _agnostic_config_int_env("AGNOSTIC_REQUEST_ARENA_BYTES", AGNOSTIC_DEFAULT_ARENA, 268435456));
    store64(c + AGNOSTIC_CFG_MAX_BODY,
      _agnostic_config_int_env("AGNOSTIC_MAX_BODY_BYTES", AGNOSTIC_DEFAULT_MAX_BODY, 268435456));
    store64(c + AGNOSTIC_CFG_IDLE_MS,
      _agnostic_config_int_env("AGNOSTIC_IDLE_MS", AGNOSTIC_DEFAULT_IDLE_MS, 3600000));
    store64(c + AGNOSTIC_CFG_REQUEST_MS,
      _agnostic_config_int_env("AGNOSTIC_REQUEST_MS", AGNOSTIC_DEFAULT_REQUEST_MS, 3600000));
    store64(c + AGNOSTIC_CFG_BACKLOG,
      _agnostic_config_int_env("AGNOSTIC_BACKLOG", AGNOSTIC_DEFAULT_BACKLOG, 65535));

    var level = SK_INFO;
    var raw_level = getenv("AGNOSTIC_LOG_LEVEL");
    if (raw_level != 0) { level = agnostic_config_parse_level(str_from(raw_level)); }
    store64(c + AGNOSTIC_CFG_LOG_LEVEL, level);

    # AGNOSTIC_LOG_FORMAT=json selects structured output; anything else is text.
    var as_json = 0;
    var raw_fmt = getenv("AGNOSTIC_LOG_FORMAT");
    if (raw_fmt != 0) {
        if (agnostic_str_eq_cstr_ci(str_from(raw_fmt), "json") == 1) { as_json = 1; }
    }
    store64(c + AGNOSTIC_CFG_LOG_JSON, as_json);

    store64(c + AGNOSTIC_CFG_CREW_SECS,
      _agnostic_config_int_env("AGNOSTIC_CREW_TIMEOUT_SECS", AGNOSTIC_DEFAULT_CREW_SECS, 86400));
    # The LLM gateway is OPTIONAL. Unset means the engine takes its placeholder
    # path — crews orchestrate, tasks produce placeholder output — which is a
    # legitimate configuration for a deployment exercising orchestration alone.
    # `engine_mode` on every crew response (not `/ready`) says which of the two this
    # process is, so the distinction is visible rather than inferred from output
    # that looks oddly synthetic.
    #
    # ⚠ **A URL holding userinfo is refused.** The key has its own variable, and a variable named
    # for a URL ends up in unit files and logs. agnosai 2.2.3 also put this URL in a transport
    # error, which reached a response body and a stored outcome; 2.2.4 stopped.
    var url = 0;
    var raw_url = getenv("AGNOSTIC_LLM_URL");
    if (raw_url != 0) {
        var u = str_from(raw_url);
        if (str_len(u) > 0) {
            url = u;
            if (agnostic_config_url_has_userinfo(u) == 1) { url = 0 - 1; }
        }
    }
    store64(c + AGNOSTIC_CFG_LLM_URL, url);

    # ⚠ Read, stored, and never logged. `agnostic_log_kv_str` is never called
    # with this value, and no accessor for it appears in any response body.
    var key = str_from("");
    var raw_key = getenv("AGNOSTIC_LLM_API_KEY");
    if (raw_key != 0) { key = str_from(raw_key); }
    store64(c + AGNOSTIC_CFG_LLM_KEY, key);

    # The database path is OPERATOR config, not request input — it never comes
    # from a client, so it is not the path-traversal surface M4's audit bullet
    # is about. That surface is the identifiers which become row keys, and they
    # are validated by `agnostic_key_is_valid`.
    var db = str_from(AGNOSTIC_DEFAULT_DB_PATH);
    var raw_db = getenv("AGNOSTIC_DB_PATH");
    if (raw_db != 0) {
        var p = str_from(raw_db);
        if (str_len(p) > 0) { db = p; }
    }
    store64(c + AGNOSTIC_CFG_DB_PATH, db);

    var audit = str_from(AGNOSTIC_DEFAULT_AUDIT_PATH);
    var raw_audit = getenv("AGNOSTIC_AUDIT_PATH");
    if (raw_audit != 0) {
        var ap = str_from(raw_audit);
        if (str_len(ap) > 0) { audit = ap; }
    }
    store64(c + AGNOSTIC_CFG_AUDIT_PATH, audit);

    # AGNOSTIC_AUTH selects whether the dispatch ladder enforces identity.
    #
    # ⚠ **The default is `off`, and that is a deliberate, bounded exception.**
    # Nothing can be authenticated before an operator has provisioned a user,
    # and there is no bootstrap route yet — so defaulting to `required` would
    # ship a server nobody can use or provision. What stops that being a
    # fail-open hole is `agnostic_serve_mount`: with auth off it REFUSES TO
    # START on any bind but loopback. Unauthenticated and reachable is not a
    # configuration this binary will run.
    #
    # ⚠ **Only `off` and `required` are values.** Anything else is refused, so a typo such
    # as `AGNOSTIC_AUTH=requred` stops the server rather than leaving it open.
    var auth = AGNOSTIC_AUTH_OFF;
    var raw_auth = getenv("AGNOSTIC_AUTH");
    if (raw_auth != 0) { auth = agnostic_config_parse_auth(str_from(raw_auth)); }
    store64(c + AGNOSTIC_CFG_AUTH_MODE, auth);

    # The first-administrator credential, used exactly once — see
    # `agnostic_auth_bootstrap_a`, which refuses if any user already exists.
    #
    # ⚠ **Read here and never logged.** `AGNOSTIC_BOOTSTRAP_PASSWORD` is treated
    # like `AGNOSTIC_LLM_API_KEY`: stored, never passed to `agnostic_log_kv_str`,
    # never in a response body.
    var boot_email = 0;
    var raw_be = getenv("AGNOSTIC_BOOTSTRAP_EMAIL");
    if (raw_be != 0) {
        var be = str_from(raw_be);
        if (str_len(be) > 0) { boot_email = be; }
    }
    store64(c + AGNOSTIC_CFG_BOOT_EMAIL, boot_email);

    var boot_pw = 0;
    var raw_bp = getenv("AGNOSTIC_BOOTSTRAP_PASSWORD");
    if (raw_bp != 0) {
        var bp = str_from(raw_bp);
        if (str_len(bp) > 0) { boot_pw = bp; }
    }
    store64(c + AGNOSTIC_CFG_BOOT_PW, boot_pw);

    # The JWT signing secret (0.3.0). Unset, every process signs with a random one and a restart
    # ends every session. Too short refuses to start rather than falling back to that: an operator
    # who set one expects tokens to survive a restart, and one who set a weak one must be told.
    #
    # ⚠ **Read here and never logged**, like `AGNOSTIC_BOOTSTRAP_PASSWORD`. Anyone who holds it can
    # forge a token for any user.
    var jwt_secret = 0;
    var raw_js = getenv("AGNOSTIC_JWT_SECRET");
    if (raw_js != 0) { jwt_secret = agnostic_config_parse_jwt_secret(str_from(raw_js)); }
    store64(c + AGNOSTIC_CFG_JWT_SECRET, jwt_secret);

    # ⚠ **Unset trusts nobody, and `X-Forwarded-For` stays ignored.** Set, it is honoured only from
    # a socket peer on this list: `src/http/forwarded.cyr`.
    var proxies = 0;
    var raw_px = getenv("AGNOSTIC_TRUSTED_PROXIES");
    if (raw_px != 0) { proxies = agnostic_config_parse_proxies(str_from(raw_px)); }
    store64(c + AGNOSTIC_CFG_PROXIES, proxies);

    # A credential for one route, so that a scraper's config does not hold a super admin's key:
    # `src/routes/metrics.cyr`. Held to the signing secret's length, for the same reason.
    var metrics_token = 0;
    var raw_mt = getenv("AGNOSTIC_METRICS_TOKEN");
    if (raw_mt != 0) { metrics_token = agnostic_config_parse_jwt_secret(str_from(raw_mt)); }
    store64(c + AGNOSTIC_CFG_METRICS_TOKEN, metrics_token);

    # ⚠ **Unset, no crew may name a target.** A target is where load and security tools point, so
    # the hosts are the operator's to name, and WRITE alone chooses none: `src/engine/target.cyr`.
    var target_hosts = 0;
    var raw_th = getenv("AGNOSTIC_TARGET_HOSTS");
    if (raw_th != 0) { target_hosts = agnostic_config_parse_target_hosts(str_from(raw_th)); }
    store64(c + AGNOSTIC_CFG_TARGET_HOSTS, target_hosts);

    # A tenant's limits, when its row sets none: `src/auth/tenantlimit.cyr`. 0 is no limit.
    store64(c + AGNOSTIC_CFG_TENANT_RATE, _agnostic_config_int_env("AGNOSTIC_TENANT_RATE_LIMIT", 0, 1000000));
    store64(c + AGNOSTIC_CFG_TENANT_CREWS, _agnostic_config_int_env("AGNOSTIC_TENANT_MAX_CREWS", 0, 1000000));

    # OTLP span export (0.1.14, ADR 0018) — the OpenTelemetry SDK's own variables, so a
    # deployment configures agnostic as it configures everything else it runs. Unset or
    # empty means off, as the OTel specification reads an empty variable. A malformed
    # endpoint refuses to start. `OTEL_EXPORTER_OTLP_HEADERS` is read by agnosai's exporter
    # itself, on every batch.
    # The per-signal `OTEL_EXPORTER_OTLP_TRACES_ENDPOINT`, a complete URL used as-is, wins over
    # the generic base — the order the OTel specification gives them. Both are checked by the
    # same parser; an empty one is unset.
    var otlp = 0;
    var as_is = 0;
    var raw_otlp = getenv("OTEL_EXPORTER_OTLP_TRACES_ENDPOINT");
    if (raw_otlp != 0) {
        if (strlen(raw_otlp) > 0) { as_is = 1; } else { raw_otlp = 0; }
    }
    if (raw_otlp == 0) { raw_otlp = getenv("OTEL_EXPORTER_OTLP_ENDPOINT"); }
    if (raw_otlp != 0) {
        var oe = str_from(raw_otlp);
        if (str_len(oe) > 0) {
            if (agnostic_config_parse_otlp_endpoint(oe) == 1) { otlp = oe; } else { otlp = 0 - 1; }
        }
    }
    store64(c + AGNOSTIC_CFG_OTLP, otlp);
    store64(c + AGNOSTIC_CFG_OTLP_AS_IS, as_is);

    # The ceiling on one inference call to the LLM gateway, in seconds (0.1.14). Unset keeps
    # agnosai's defaults (600 s for the whole exchange). ⚠ 0 is refused, not read as "no
    # timeout": a call with no ceiling is what a hung gateway turns into a stuck task.
    var llm_secs = 0;
    var raw_llm = getenv("AGNOSTIC_LLM_TIMEOUT_SECS");
    if (raw_llm != 0) {
        llm_secs = agnostic_config_parse_bounded(str_from(raw_llm), 86400);
        if (llm_secs == 0) { llm_secs = 0 - 1; }
    }
    store64(c + AGNOSTIC_CFG_LLM_SECS, llm_secs);

    var svc = str_from(AGNOSTIC_DEFAULT_OTEL_SERVICE);
    var raw_svc = getenv("OTEL_SERVICE_NAME");
    if (raw_svc != 0) {
        var sn = str_from(raw_svc);
        if (str_len(sn) > 0) { svc = sn; }
    }
    store64(c + AGNOSTIC_CFG_OTEL_SVC, svc);

    return c;
}

# Each accessor returns 0 for a null block, so a caller that skipped the
# allocation check gets a benign value rather than a fault at offset 0.

# The TCP port to bind. 0 is legal and means "let the kernel choose".
fn agnostic_config_port(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_PORT); }

# Whether the dispatch ladder enforces identity: AGNOSTIC_AUTH_OFF or
# AGNOSTIC_AUTH_REQUIRED.
#
# ⚠ 0 for a null block is `AGNOSTIC_AUTH_OFF`, which is the LESS safe value —
# unusual for this file, where every other accessor's zero is benign. It is safe
# here only because a null config never reaches a bound listener: mount refuses
# a non-loopback bind with auth off, and a null config cannot bind at all.
fn agnostic_config_auth_mode(c): i64 {
    if (c == 0) { return AGNOSTIC_AUTH_OFF; }
    return load64(c + AGNOSTIC_CFG_AUTH_MODE);
}

# The first-administrator email, or 0 when unset.
fn agnostic_config_bootstrap_email(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_BOOT_EMAIL);
}

# The first-administrator password, or 0 when unset.
#
# ⚠ Never log this value. It is a credential, and it is the ONE credential that
# can create every other identity in the deployment.
fn agnostic_config_bootstrap_password(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_BOOT_PW);
}

# The operator's JWT signing secret, or 0 when unset.
#
# ⚠ Never log this value. Anyone holding it can forge a token for any user.
fn agnostic_config_jwt_secret(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_JWT_SECRET);
}

# The crews a tenant may submit in a minute, when its row does not say. 0 for no limit.
fn agnostic_config_tenant_rate(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_TENANT_RATE);
}

# The unfinished crews a tenant may hold, when its row does not say. 0 for no limit.
fn agnostic_config_tenant_crews(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_TENANT_CREWS);
}

# The scraper's bearer token, or 0 when unset. ⚠ Never log this value.
fn agnostic_config_metrics_token(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_METRICS_TOKEN);
}

# The hosts a crew's target may name, a vec of lowercase Strs, or 0 for none.
fn agnostic_config_target_hosts(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_TARGET_HOSTS);
}

# The trusted proxies, a table `agnostic_proxy_trusted` reads, or 0 for none.
fn agnostic_config_proxies(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_PROXIES);
}

# The bind address as a network-order packed IPv4 word, not a string.
fn agnostic_config_addr(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_ADDR); }

# Worker thread count for the pooled serve loop.
fn agnostic_config_workers(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_WORKERS); }

# Per-request arena size in bytes. Multiplied by the worker count for the
# real footprint, so raising it without lowering workers is how you run out
# of memory.
fn agnostic_config_arena_bytes(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_ARENA); }

# Largest request body accepted, in bytes.
fn agnostic_config_max_body(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_MAX_BODY); }

# Idle timeout in milliseconds before a kept connection is dropped.
fn agnostic_config_idle_ms(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_IDLE_MS); }
# How long a connection has from accept to a complete request, in ms.
fn agnostic_config_request_ms(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_REQUEST_MS); }

# Listen backlog depth.
fn agnostic_config_backlog(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_BACKLOG); }

# The sakshi level constant to log at.
fn agnostic_config_log_level(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_LOG_LEVEL); }

# 1 when log output should be structured JSON rather than text.
fn agnostic_config_log_json(c): i64 { if (c == 0) { return 0; } return load64(c + AGNOSTIC_CFG_LOG_JSON); }

# Wall-clock ceiling in seconds for one crew run.
#
# Handed to `agnosai_resource_budget_new`'s duration slot. A crew that exceeds it
# is reported FAILED with its partial results discarded — the engine's own
# behaviour, matched deliberately: a caller must not read a timed-out crew's
# partial output as if the crew had finished.
fn agnostic_config_crew_timeout_secs(c): i64 {
    if (c == 0) { return AGNOSTIC_DEFAULT_CREW_SECS; }
    return load64(c + AGNOSTIC_CFG_CREW_SECS);
}

# The hoosh gateway base URL as a Str, or 0 when none is configured.
fn agnostic_config_llm_url(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_LLM_URL);
}

# The gateway API key as a Str, empty when unset.
#
# ⚠ Never log this and never put it in a response body.
fn agnostic_config_llm_api_key(c): i64 {
    if (c == 0) { return str_from(""); }
    return load64(c + AGNOSTIC_CFG_LLM_KEY);
}

# The patra database path as a Str. Never 0 — an unset or empty value falls back
# to `AGNOSTIC_DEFAULT_DB_PATH`.
fn agnostic_config_db_path(c): i64 {
    if (c == 0) { return str_from(AGNOSTIC_DEFAULT_DB_PATH); }
    return load64(c + AGNOSTIC_CFG_DB_PATH);
}

# The OTLP endpoint spans are exported to, or 0 when export is off (0.1.14). A malformed
# value reads as 0 here; `agnostic_config_invalid` is what reports it.
fn agnostic_config_otlp_endpoint(c): i64 {
    if (c == 0) { return 0; }
    var v = load64(c + AGNOSTIC_CFG_OTLP);
    if (v < 0) { return 0; }
    return v;
}

# 1 when the OTLP endpoint is the per-signal traces URL, posted to as-is; 0 when it is the
# generic base, to which agnosai appends `v1/traces` (0.1.14).
fn agnostic_config_otlp_as_is(c): i64 {
    if (c == 0) { return 0; }
    return load64(c + AGNOSTIC_CFG_OTLP_AS_IS);
}

# The inference call's ceiling in seconds, or 0 for agnosai's own (0.1.14).
fn agnostic_config_llm_timeout_secs(c): i64 {
    if (c == 0) { return 0; }
    var v = load64(c + AGNOSTIC_CFG_LLM_SECS);
    if (v < 0) { return 0; }
    return v;
}

# The service name spans are exported under: `OTEL_SERVICE_NAME`, else `agnostic`. Never 0.
fn agnostic_config_otel_service(c): i64 {
    if (c == 0) { return str_from(AGNOSTIC_DEFAULT_OTEL_SERVICE); }
    return load64(c + AGNOSTIC_CFG_OTEL_SVC);
}

# The audit chain's database path as a Str. Never 0.
fn agnostic_config_audit_path(c): i64 {
    if (c == 0) { return str_from(AGNOSTIC_DEFAULT_AUDIT_PATH); }
    return load64(c + AGNOSTIC_CFG_AUDIT_PATH);
}

# Report the first malformed field, or 0 when every field parsed. The caller
# refuses to start on a non-zero answer.
fn agnostic_config_invalid(c): i64 {
    if (c == 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_PORT) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_WORKERS) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_ARENA) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_MAX_BODY) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_IDLE_MS) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_BACKLOG) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_LOG_LEVEL) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_CREW_SECS) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_OTLP) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_LLM_SECS) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_REQUEST_MS) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_AUTH_MODE) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_JWT_SECRET) == 0 - 1) { return 1; }
    if (load64(c + AGNOSTIC_CFG_PROXIES) == 0 - 1) { return 1; }
    if (load64(c + AGNOSTIC_CFG_METRICS_TOKEN) == 0 - 1) { return 1; }
    if (load64(c + AGNOSTIC_CFG_TARGET_HOSTS) == 0 - 1) { return 1; }
    if (load64(c + AGNOSTIC_CFG_TENANT_RATE) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_TENANT_CREWS) < 0) { return 1; }
    if (load64(c + AGNOSTIC_CFG_ADDR) == 0 - 1) { return 1; }
    if (load64(c + AGNOSTIC_CFG_LLM_URL) == 0 - 1) { return 1; }
    return 0;
}
