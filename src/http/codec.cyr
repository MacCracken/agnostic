# agnostic/http/codec — JSON decoding with an allow-list.
#
# ## The defect this module exists to prevent
#
# The Python oracle's request models are Pydantic classes with no `model_config`,
# so they inherit `extra='ignore'`. A client field the model does not declare is
# **silently discarded** — no error, no log line, no 4xx.
#
# `ORACLE-AUDIT.md` §2.2 records what that cost: fourteen fields dropped between
# the API and the engine, including `gpu_strict`. A caller asking for a hard-fail
# GPU requirement got a silent CPU fallback instead. §3.3 records the same
# mechanism eating an entire `tasks` array, so the two backends ran structurally
# different work for one request.
#
# The rule here: **an unlisted key is a 422, never a silent discard.**
#
# ## The decode contract
#
# Every `*_from_value_a` decoder follows this order, and the order matters:
#
#   1. `bayan_json_v_is_obj` — reject a non-object outright.
#   2. `agnostic_no_unknown_fields` — BEFORE reading any field. Validating the
#      shape first means a request is rejected whole rather than half-applied.
#   3. `agnostic_field_bad` — every field against its row: required, and of its kind.
#   4. What each field means.
#
# ## Why this ships in M1 with no route consumer
#
# M1 has no request bodies. This module is built now, under test, because M3's
# field-forwarding gate is built on it — and retrofitting an allow-list after
# decoders exist means auditing every one of them instead of writing them right.

# ## A row says what the field holds (0.4.0, ADR 0028)
#
# An allow-list row is a name, a kind and whether the field is required, and **one check reads
# them**: `agnostic_field_bad`. Every door calls it after the allow-list and before reading a
# field, so a decoder holds no type check of its own, and the API schema prints the same rows
# (`src/http/schema.cyr`). When types lived in decoder code the schema could say nothing about
# them, and M7's tools, which mirror the routes, would have had to hand-write a copy.
#
# JSON `null` in an optional field is the field left out, as `agnostic_opt_str` reads it. In a
# required field it is the field missing.

# What a field holds.
enum AgnosticFieldKind {
    AGNOSTIC_FK_STRING  = 1;
    AGNOSTIC_FK_INT     = 2;
    AGNOSTIC_FK_BOOL    = 3;
    AGNOSTIC_FK_OBJECT  = 4;
    AGNOSTIC_FK_ARRAY   = 5;    # an array whose elements its decoder walks: crews' agents and tasks
    AGNOSTIC_FK_STRINGS = 6;    # an array of strings
    AGNOSTIC_FK_INTS    = 7;    # an array of integers
}

# One row of an allow-list.
enum AgnosticFieldOff {
    AGNOSTIC_FD_NAME     = 0;
    AGNOSTIC_FD_KIND     = 8;
    AGNOSTIC_FD_REQUIRED = 16;
    AGNOSTIC_FD_SIZE     = 24;
}

# A new, empty allow-list, in arena `a`.
fn agnostic_fields_a(a): i64 {
    return vec_new_a(a);
}

# Add a row, answering the list for chaining.
fn _agnostic_field_add_a(a, allowed, name, kind, required): i64 {
    var r = alloc_via(a, AGNOSTIC_FD_SIZE);
    if (r == 0) { return allowed; }
    store64(r + AGNOSTIC_FD_NAME, str_from_a(a, name));
    store64(r + AGNOSTIC_FD_KIND, kind);
    store64(r + AGNOSTIC_FD_REQUIRED, required);
    vec_push_a(a, allowed, r);
    return allowed;
}

# Permit an optional field of `kind`.
fn agnostic_field_a(a, allowed, name, kind): i64 {
    return _agnostic_field_add_a(a, allowed, name, kind, 0);
}

# Permit a field of `kind` that a body must carry.
fn agnostic_field_req_a(a, allowed, name, kind): i64 {
    return _agnostic_field_add_a(a, allowed, name, kind, 1);
}

# A row's name.
fn agnostic_field_name(r): i64 { return load64(r + AGNOSTIC_FD_NAME); }

# A row's `AGNOSTIC_FK_*`.
fn agnostic_field_kind(r): i64 { return load64(r + AGNOSTIC_FD_KIND); }

# Whether a body must carry the row's field. 1 or 0.
fn agnostic_field_required(r): i64 { return load64(r + AGNOSTIC_FD_REQUIRED); }

# The kind's JSON type, as the API schema names it.
fn agnostic_field_kind_type(kind): i64 {
    if (kind == AGNOSTIC_FK_STRING) { return "string"; }
    if (kind == AGNOSTIC_FK_INT) { return "integer"; }
    if (kind == AGNOSTIC_FK_BOOL) { return "boolean"; }
    if (kind == AGNOSTIC_FK_OBJECT) { return "object"; }
    return "array";
}

# The type of an array kind's elements, or 0 when the kind names none.
fn agnostic_field_kind_items(kind): i64 {
    if (kind == AGNOSTIC_FK_STRINGS) { return "string"; }
    if (kind == AGNOSTIC_FK_INTS) { return "integer"; }
    return 0;
}

# The kind as a refusal says it.
fn _agnostic_field_kind_words(kind): i64 {
    if (kind == AGNOSTIC_FK_STRING) { return "a string"; }
    if (kind == AGNOSTIC_FK_INT) { return "an integer"; }
    if (kind == AGNOSTIC_FK_BOOL) { return "a boolean"; }
    if (kind == AGNOSTIC_FK_OBJECT) { return "an object"; }
    if (kind == AGNOSTIC_FK_STRINGS) { return "an array of strings"; }
    if (kind == AGNOSTIC_FK_INTS) { return "an array of integers"; }
    return "an array";
}

# Whether every element of the array `v` is a string.
fn _agnostic_field_all_strs(v): i64 {
    var i = 0;
    while (i < bayan_json_v_arr_len(v)) {
        if (bayan_json_v_is_str(bayan_json_v_arr_get(v, i)) != 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Whether every element of the array `v` is an integer.
fn _agnostic_field_all_ints(v): i64 {
    var i = 0;
    while (i < bayan_json_v_arr_len(v)) {
        if (bayan_json_v_is_int(bayan_json_v_arr_get(v, i)) != 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Whether the value `v` is what `kind` says.
#
# ⚠ `"true"` is not a boolean and `"7"` is not an integer: coercing either is how
# `{"gpu_required": "false"}` reads as true. bayan's float is not an integer, so `1.0` is refused
# where an integer is asked for.
fn _agnostic_field_kind_ok(kind, v): i64 {
    if (kind == AGNOSTIC_FK_STRING) { return bayan_json_v_is_str(v); }
    if (kind == AGNOSTIC_FK_INT) { return bayan_json_v_is_int(v); }
    if (kind == AGNOSTIC_FK_BOOL) { return bayan_json_v_is_bool(v); }
    if (kind == AGNOSTIC_FK_OBJECT) { return bayan_json_v_is_obj(v); }
    if (bayan_json_v_is_arr(v) != 1) { return 0; }
    if (kind == AGNOSTIC_FK_STRINGS) { return _agnostic_field_all_strs(v); }
    if (kind == AGNOSTIC_FK_INTS) { return _agnostic_field_all_ints(v); }
    return 1;
}

# The first row of `allowed` that the object `obj` does not satisfy, or 0: a required field
# missing or null, or a field of the wrong type. A body is checked against its row before a decoder
# reads a field.
fn agnostic_field_bad(obj, allowed): i64 {
    var i = 0;
    while (i < vec_len(allowed)) {
        var r = vec_get(allowed, i);
        var f = bayan_json_v_obj_get_by_str(obj, agnostic_field_name(r));
        if (f == 0 || bayan_json_v_is_null(f) == 1) {
            if (agnostic_field_required(r) == 1) { return r; }
        } elif (_agnostic_field_kind_ok(agnostic_field_kind(r), f) != 1) {
            return r;
        }
        i = i + 1;
    }
    return 0;
}

# What a refusal of row `r` says: `'x' is required and must be a string`, or `'x' must be a string`.
fn agnostic_field_refusal_a(a, r): i64 {
    var sb = str_builder_new_a(a);
    if (sb == 0) { return agnostic_field_name(r); }
    str_builder_add_cstr_a(a, sb, "'");
    str_builder_add_a(a, sb, agnostic_field_name(r));
    if (agnostic_field_required(r) == 1) {
        str_builder_add_cstr_a(a, sb, "' is required and must be ");
    } else {
        str_builder_add_cstr_a(a, sb, "' must be ");
    }
    str_builder_add_cstr_a(a, sb, _agnostic_field_kind_words(agnostic_field_kind(r)));
    return str_builder_build_a(a, sb);
}

# The status the crew, task and agent bodies refuse row `r` with: 400 for a required field, as
# every door here has answered since M2, and 422 for an optional field of the wrong type.
fn agnostic_field_status(r): i64 {
    if (agnostic_field_required(r) == 1) { return HTTP_BAD_REQUEST; }
    return AGNOSTIC_HTTP_UNPROCESSABLE;
}

# Whether `key` is a row of `allowed`.
fn _agnostic_field_listed(allowed, key: Str): i64 {
    var i = 0;
    while (i < vec_len(allowed)) {
        if (str_eq(key, agnostic_field_name(vec_get(allowed, i))) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when every key in `obj` appears in `allowed`; 0 when any key does not.
#
# This is the `deny_unknown_fields` equivalent. A caller that skips it inherits
# the oracle's defect exactly.
fn agnostic_no_unknown_fields(obj, allowed): i64 {
    if (obj == 0) { return 0; }
    if (allowed == 0) { return 0; }
    if (agnostic_unknown_field(obj, allowed) != 0) { return 0; }
    return 1;
}

# The first key in `obj` that is not in `allowed`, or 0 when all are permitted.
#
# Reporting *which* field was rejected is the difference between an error a
# caller can act on and one that sends them to read source. The oracle reported
# nothing at all.
fn agnostic_unknown_field(obj, allowed): i64 {
    if (obj == 0) { return 0; }
    if (allowed == 0) { return 0; }
    var n = bayan_json_v_obj_len(obj);
    var i = 0;
    while (i < n) {
        var key = bayan_json_v_obj_key(obj, i);
        if (_agnostic_field_listed(allowed, key) == 0) { return key; }
        i = i + 1;
    }
    return 0;
}

# Parse a request body into a bayan value in arena `a`. 0 on malformed JSON.
#
# ⚠ **Through `agnostic_json_kind` first (0.2.2).** bayan takes raw invalid UTF-8 and raw control
# bytes in a string. A crew named `a\xff\xfeb` was accepted, stored, and then made that tenant's
# `GET /crews` undecodable to any strict client, for good. The plugin document route has always
# refused such a body; this is the same check, at every door.
fn agnostic_decode_a(a, body: Str): i64 {
    if (str_len(body) == 0) { return 0; }
    if (agnostic_json_kind(body) == AGNOSTIC_JSON_MALFORMED) { return 0; }
    return bayan_json_v_parse_buf_a(a, str_data(body), str_len(body));
}

# Serialise a bayan value to a Str in arena `a`. 0 when the arena is exhausted.
fn agnostic_encode_a(a, v): i64 {
    return bayan_json_v_build_a(a, v);
}

# A required string field. Returns the Str, or 0 when absent or the wrong type.
#
# ⚠ Absent and wrong-type deliberately collapse to one signal. A caller that
# needs to tell them apart is doing something the allow-list should have caught
# first — and every field here has already passed the shape check.
fn agnostic_req_str(v, key: Str): i64 {
    if (v == 0) { return 0; }
    var f = bayan_json_v_obj_get_by_str(v, key);
    if (f == 0) { return 0; }
    if (bayan_json_v_is_str(f) != 1) { return 0; }
    return bayan_json_v_str(f);
}

# An optional string field. Returns the Str when present and a string, or
# `dflt` when absent or JSON null.
#
# ⚠ Returns 0 — distinct from `dflt` — when the field is present but the WRONG
# TYPE. `{"name": 42}` is a client error, not an omission, and collapsing it to
# the default is how a typo becomes a silent default in production.
fn agnostic_opt_str(v, key: Str, dflt): i64 {
    if (v == 0) { return dflt; }
    var f = bayan_json_v_obj_get_by_str(v, key);
    if (f == 0) { return dflt; }
    if (bayan_json_v_is_null(f) == 1) { return dflt; }
    if (bayan_json_v_is_str(f) != 1) { return 0; }
    return bayan_json_v_str(f);
}

# A required integer field. Returns `sentinel` when absent or the wrong type.
#
# The caller picks the sentinel because there is no value this can return that
# is universally invalid — 0 and -1 are both legitimate for some fields.
fn agnostic_req_int(v, key: Str, sentinel): i64 {
    if (v == 0) { return sentinel; }
    var f = bayan_json_v_obj_get_by_str(v, key);
    if (f == 0) { return sentinel; }
    if (bayan_json_v_is_int(f) != 1) { return sentinel; }
    return bayan_json_v_int(f);
}

# A required boolean field. Returns `sentinel` when absent or the wrong type.
#
# ⚠ A JSON string "true" is NOT a boolean and returns the sentinel. Coercing it
# would mean `{"gpu_strict": "false"}` reads as true — the string is non-empty —
# which is precisely the class of silent misreading this module exists to stop.
fn agnostic_req_bool(v, key: Str, sentinel): i64 {
    if (v == 0) { return sentinel; }
    var f = bayan_json_v_obj_get_by_str(v, key);
    if (f == 0) { return sentinel; }
    if (bayan_json_v_is_bool(f) != 1) { return sentinel; }
    return bayan_json_v_bool(f);
}

# ---------------------------------------------------------------------------
# Validating a JSON document without parsing it (0.1.8)
#
# The plugin data store keeps a client's document VERBATIM — the bytes it was sent
# are the bytes it serves back — so a PUT needs only to know the body is one
# well-formed JSON object. `bayan_json_v_parse_buf_a` would answer that by building
# the whole tree in the request arena, and a document near its size cap does not fit
# there: the overflow spills to the no-`free()` global allocator on every PUT. This
# scanner allocates nothing.
#
# Strict RFC 8259: no comments, no trailing commas, no leading zeros, no raw control
# bytes in strings, every escape legal, every string well-formed UTF-8 (no overlongs,
# no surrogates). Nesting is bounded by `AGNOSTIC_JSON_MAX_DEPTH`, so a hostile body
# cannot recurse the stack away.

var AGNOSTIC_JSON_MAX_DEPTH = 64;

# The index after any JSON whitespace at `i`.
fn _agnostic_jv_ws(d, n, i): i64 {
    while (i < n) {
        var c = load8(d + i) & 255;
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        i = i + 1;
    }
    return i;
}

# Whether `c` is a hex digit. 1 or 0.
fn _agnostic_jv_hex(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 97 && c <= 102) { return 1; }
    if (c >= 65 && c <= 70) { return 1; }
    return 0;
}

# The index after the string starting at `i` (which is its opening quote), or -1.
fn _agnostic_jv_string(d, n, i): i64 {
    i = i + 1;
    while (i < n) {
        var c = load8(d + i) & 255;
        if (c == 34) { return i + 1; }
        if (c < 32) { return 0 - 1; }
        if (c == 92) {
            if (i + 1 >= n) { return 0 - 1; }
            var e = load8(d + i + 1) & 255;
            if (e == 117) {                                   # \u, then four hex digits
                if (i + 5 >= n) { return 0 - 1; }
                var k = 2;
                while (k < 6) {
                    if (_agnostic_jv_hex(load8(d + i + k) & 255) == 0) { return 0 - 1; }
                    k = k + 1;
                }
                i = i + 6;
                continue;
            }
            # " \ / b f n r t
            if (e != 34 && e != 92 && e != 47 && e != 98 && e != 102 && e != 110 && e != 114 && e != 116) {
                return 0 - 1;
            }
            i = i + 2;
            continue;
        }
        if (c < 128) { i = i + 1; continue; }
        # A UTF-8 sequence: its length from the lead byte, then the continuation
        # bytes, with the second byte's range narrowed where RFC 3629 requires.
        var len = 0;
        var lo = 128;
        var hi = 191;
        # 0xE0 forbids overlongs, 0xED surrogates, 0xF0 overlongs, 0xF4 > U+10FFFF.
        if (c >= 194 && c <= 223) {
            len = 2;
        } elif (c >= 224 && c <= 239) {
            len = 3;
            if (c == 224) { lo = 160; }
            if (c == 237) { hi = 159; }
        } elif (c >= 240 && c <= 244) {
            len = 4;
            if (c == 240) { lo = 144; }
            if (c == 244) { hi = 143; }
        } else {
            return 0 - 1;
        }
        if (i + len > n) { return 0 - 1; }
        var b1 = load8(d + i + 1) & 255;
        if (b1 < lo || b1 > hi) { return 0 - 1; }
        var j = 2;
        while (j < len) {
            var b = load8(d + i + j) & 255;
            if (b < 128 || b > 191) { return 0 - 1; }
            j = j + 1;
        }
        i = i + len;
    }
    return 0 - 1;
}

# The index after the number starting at `i`, or -1.
fn _agnostic_jv_number(d, n, i): i64 {
    if (i < n && (load8(d + i) & 255) == 45) { i = i + 1; }              # '-'
    if (i >= n) { return 0 - 1; }
    var c = load8(d + i) & 255;
    # A lone 0, or a run of digits that does not start with one.
    if (c == 48) {
        i = i + 1;
    } elif (c >= 49 && c <= 57) {
        while (i < n) {
            c = load8(d + i) & 255;
            if (c < 48 || c > 57) { break; }
            i = i + 1;
        }
    } else {
        return 0 - 1;
    }
    if (i < n && (load8(d + i) & 255) == 46) {                            # '.'
        i = i + 1;
        var f = i;
        while (i < n) {
            c = load8(d + i) & 255;
            if (c < 48 || c > 57) { break; }
            i = i + 1;
        }
        if (i == f) { return 0 - 1; }
    }
    if (i < n) {
        c = load8(d + i) & 255;
        if (c == 101 || c == 69) {                                        # e E
            i = i + 1;
            if (i < n) {
                c = load8(d + i) & 255;
                if (c == 43 || c == 45) { i = i + 1; }
            }
            var x = i;
            while (i < n) {
                c = load8(d + i) & 255;
                if (c < 48 || c > 57) { break; }
                i = i + 1;
            }
            if (i == x) { return 0 - 1; }
        }
    }
    return i;
}

# The index after `lit` (a C string of length `ln`) at `i`, or -1.
fn _agnostic_jv_literal(d, n, i, lit, ln): i64 {
    if (i + ln > n) { return 0 - 1; }
    var k = 0;
    while (k < ln) {
        if ((load8(d + i + k) & 255) != (load8(lit + k) & 255)) { return 0 - 1; }
        k = k + 1;
    }
    return i + ln;
}

# The index after the value starting at or after `i`, or -1.
fn _agnostic_jv_value(d, n, i, depth): i64 {
    i = _agnostic_jv_ws(d, n, i);
    if (i >= n) { return 0 - 1; }
    var c = load8(d + i) & 255;
    if (c == 123) { return _agnostic_jv_object(d, n, i, depth + 1); }
    if (c == 91) { return _agnostic_jv_array(d, n, i, depth + 1); }
    if (c == 34) { return _agnostic_jv_string(d, n, i); }
    if (c == 116) { return _agnostic_jv_literal(d, n, i, "true", 4); }
    if (c == 102) { return _agnostic_jv_literal(d, n, i, "false", 5); }
    if (c == 110) { return _agnostic_jv_literal(d, n, i, "null", 4); }
    if (c == 45 || (c >= 48 && c <= 57)) { return _agnostic_jv_number(d, n, i); }
    return 0 - 1;
}

# The index after the object at `i` (its `{`), or -1.
fn _agnostic_jv_object(d, n, i, depth): i64 {
    if (depth > AGNOSTIC_JSON_MAX_DEPTH) { return 0 - 1; }
    i = _agnostic_jv_ws(d, n, i + 1);
    if (i < n && (load8(d + i) & 255) == 125) { return i + 1; }          # {}
    while (i < n) {
        if ((load8(d + i) & 255) != 34) { return 0 - 1; }                # a key
        i = _agnostic_jv_string(d, n, i);
        if (i < 0) { return 0 - 1; }
        i = _agnostic_jv_ws(d, n, i);
        if (i >= n || (load8(d + i) & 255) != 58) { return 0 - 1; }      # ':'
        i = _agnostic_jv_value(d, n, i + 1, depth);
        if (i < 0) { return 0 - 1; }
        i = _agnostic_jv_ws(d, n, i);
        if (i >= n) { return 0 - 1; }
        var c = load8(d + i) & 255;
        if (c == 125) { return i + 1; }                                   # '}'
        if (c != 44) { return 0 - 1; }                                    # ','
        i = _agnostic_jv_ws(d, n, i + 1);
    }
    return 0 - 1;
}

# The index after the array at `i` (its `[`), or -1.
fn _agnostic_jv_array(d, n, i, depth): i64 {
    if (depth > AGNOSTIC_JSON_MAX_DEPTH) { return 0 - 1; }
    i = _agnostic_jv_ws(d, n, i + 1);
    if (i < n && (load8(d + i) & 255) == 93) { return i + 1; }           # []
    while (i < n) {
        i = _agnostic_jv_value(d, n, i, depth);
        if (i < 0) { return 0 - 1; }
        i = _agnostic_jv_ws(d, n, i);
        if (i >= n) { return 0 - 1; }
        var c = load8(d + i) & 255;
        if (c == 93) { return i + 1; }                                    # ']'
        if (c != 44) { return 0 - 1; }
        i = i + 1;
    }
    return 0 - 1;
}

# What `agnostic_json_kind` found.
enum AgnosticJsonKind {
    AGNOSTIC_JSON_MALFORMED = 0;
    AGNOSTIC_JSON_OBJECT    = 1;
    AGNOSTIC_JSON_OTHER     = 2;
}

# Whether `body` is exactly one well-formed JSON value, optionally surrounded by
# whitespace, and whether that value is an object: AGNOSTIC_JSON_OBJECT,
# AGNOSTIC_JSON_OTHER (well-formed, but an array or a scalar), or
# AGNOSTIC_JSON_MALFORMED. The split is the API's 400-versus-422 split. Allocates
# nothing.
fn agnostic_json_kind(body: Str): i64 {
    if (body == 0) { return AGNOSTIC_JSON_MALFORMED; }
    var d = str_data(body);
    var n = str_len(body);
    var i = _agnostic_jv_ws(d, n, 0);
    if (i >= n) { return AGNOSTIC_JSON_MALFORMED; }
    var is_obj = 0;
    if ((load8(d + i) & 255) == 123) { is_obj = 1; }
    i = _agnostic_jv_value(d, n, i, 0);
    if (i < 0) { return AGNOSTIC_JSON_MALFORMED; }
    if (_agnostic_jv_ws(d, n, i) != n) { return AGNOSTIC_JSON_MALFORMED; }
    if (is_obj == 1) { return AGNOSTIC_JSON_OBJECT; }
    return AGNOSTIC_JSON_OTHER;
}

# The string at top-level key `key` (a C string) of the JSON object `body`, in one walk that
# allocates nothing (0.2.3): 1 with its raw bytes, unescaped no further, at `out_at` and
# `out_len`; 0 when the key is absent or its first value is not a string; -1 when `body` is not
# exactly one well-formed object. The whole of `body` is checked either way.
fn agnostic_json_top_str(body: Str, key, out_at, out_len): i64 {
    if (body == 0) { return 0 - 1; }
    var d = str_data(body);
    var n = str_len(body);
    var klen = strlen(key);
    var seen = 0;
    var found = 0;
    var i = _agnostic_jv_ws(d, n, 0);
    if (i >= n || (load8(d + i) & 255) != 123) { return 0 - 1; }
    i = _agnostic_jv_ws(d, n, i + 1);
    if (i < n && (load8(d + i) & 255) == 125) { return _agnostic_jv_tail(d, n, i + 1, 0); }
    while (i < n) {
        if ((load8(d + i) & 255) != 34) { return 0 - 1; }
        var ks = i + 1;
        i = _agnostic_jv_string(d, n, i);
        if (i < 0) { return 0 - 1; }
        var hit = 0;
        if (seen == 0 && i - 1 - ks == klen) {
            if (memeq(d + ks, key, klen) == 1) { hit = 1; }
        }
        i = _agnostic_jv_ws(d, n, i);
        if (i >= n || (load8(d + i) & 255) != 58) { return 0 - 1; }
        var vs = _agnostic_jv_ws(d, n, i + 1);
        i = _agnostic_jv_value(d, n, vs, 1);
        if (i < 0) { return 0 - 1; }
        if (hit == 1) {
            seen = 1;
            if ((load8(d + vs) & 255) == 34) {
                store64(out_at, d + vs + 1);
                store64(out_len, i - vs - 2);
                found = 1;
            }
        }
        i = _agnostic_jv_ws(d, n, i);
        if (i >= n) { return 0 - 1; }
        var c = load8(d + i) & 255;
        if (c == 125) { return _agnostic_jv_tail(d, n, i + 1, found); }
        if (c != 44) { return 0 - 1; }
        i = _agnostic_jv_ws(d, n, i + 1);
    }
    return 0 - 1;
}

# `answer` when only whitespace is left of `d` from `i`, or -1.
fn _agnostic_jv_tail(d, n, i, answer): i64 {
    if (_agnostic_jv_ws(d, n, i) != n) { return 0 - 1; }
    return answer;
}

# ## Query strings (0.1.9)
#
# The router matches on the path alone (`agnostic_path_only_a`), so a handler that takes a
# query parameter reads it from the raw request target here. Only what a handler asks for
# by name is read; nothing is percent-decoded, because nothing that takes a parameter yet
# accepts a character that would need it — a parameter is parsed into exactly the shape
# its handler wants (`agnostic_query_uint_a`) or refused.

# The raw value of query parameter `name` in `path`, as a `Str` in `a`, or 0 when the path
# has no such parameter. The first occurrence wins; a bare `name` (no `=`) is an empty
# value, which is present — not absent.
fn agnostic_query_get_a(a, path: Str, name): i64 {
    if (path == 0) { return 0; }
    var d = str_data(path);
    var n = str_len(path);
    var q = 0;
    while (q < n) {
        var c = load8(d + q) & 255;
        if (c == 35) { return 0; }   # '#' before any '?': no query
        if (c == 63) { break; }      # '?'
        q = q + 1;
    }
    if (q >= n) { return 0; }
    var nl = strlen(name);
    var i = q + 1;
    while (i < n) {
        # One `key[=value]` field, ending at `&`, `#` or the end.
        var fe = i;
        while (fe < n) {
            var fc = load8(d + fe) & 255;
            if (fc == 38 || fc == 35) { break; }
            fe = fe + 1;
        }
        var ke = i;
        while (ke < fe) {
            if ((load8(d + ke) & 255) == 61) { break; }
            ke = ke + 1;
        }
        if (ke - i == nl) {
            if (memeq(d + i, name, nl) == 1) {
                var vs = ke;
                if (vs < fe) { vs = vs + 1; }
                return str_sub_a(a, path, vs, fe - vs);
            }
        }
        if (fe >= n) { break; }
        if ((load8(d + fe) & 255) == 35) { break; }
        i = fe + 1;
    }
    return 0;
}

# Query parameter `name` as a non-negative integer: `dflt` when absent, the value when it
# is 1 to 18 decimal digits, and -1 when it is present and anything else — empty, signed,
# fractional, or too long to be a count. A malformed parameter is the handler's 422 to
# give, never a silent default.
fn agnostic_query_uint_a(a, path: Str, name, dflt): i64 {
    var v = agnostic_query_get_a(a, path, name);
    if (v == 0) { return dflt; }
    var n = str_len(v);
    if (n == 0 || n > 18) { return 0 - 1; }
    var d = str_data(v);
    var out = 0;
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 255;
        if (c < 48 || c > 57) { return 0 - 1; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out;
}
