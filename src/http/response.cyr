# agnostic/http/response — what a route handler returns.
#
# A response is `{status, body, is_text, ctype, headers}`. `body` is a bayan JSON
# value when `is_text` is 0, or a `Str` when it is 1. The serve adapter renders it; a
# handler never touches a socket, which is what keeps handlers testable without
# a server and keeps the route table separable from handler logic — the
# shim-ability the roadmap asks for.
#
# `ctype` and `headers` exist for the WebGUI (0.1.7): a page is a `Str` body whose
# media type is not `text/plain` and which carries its own Content-Security-Policy.
# Both are NUL-terminated C strings or 0, and 0 means exactly what it meant before
# they existed. Every constructor leaves `headers` 0 unless it takes them; since 0.1.15
# `agnostic_response_set_headers` adds them to any response — a 405's `Allow` is JSON.
#
# ## Every constructor has an `_a` twin
#
# The bare forms allocate from the process-wide bump allocator, which has no
# `free()`. Anything on a request path must use the `_a` form against the
# per-request arena or the server leaks for its whole lifetime, in proportion to
# requests served.
#
# ⚠ Including the error arms. It is tempting to let `agnostic_response_error`
# skip the arena "because errors are rare" — but the 404 arm is what an
# unauthenticated scanner hits hardest, so it is the single least affordable
# leak in the process.

enum AgnosticRespOff {
    AGNOSTIC_RESP_STATUS  = 0;
    AGNOSTIC_RESP_BODY    = 8;
    AGNOSTIC_RESP_IS_TEXT = 16;
    AGNOSTIC_RESP_CTYPE   = 24;
    AGNOSTIC_RESP_HEADERS = 32;
    AGNOSTIC_RESP_SIZE    = 40;
}

# A JSON response carrying an already-built bayan value, allocated in `a`.
# Returns 0 when the arena is exhausted.
#
# ⚠ Every constructor writes every field. An arena block is not zeroed, so a field
# left unwritten would carry the previous request's bytes into this one's headers.
fn agnostic_response_json_a(a, status, body): i64 {
    var r = alloc_via(a, AGNOSTIC_RESP_SIZE);
    if (r == 0) { return 0; }
    store64(r + AGNOSTIC_RESP_STATUS, status);
    store64(r + AGNOSTIC_RESP_BODY, body);
    store64(r + AGNOSTIC_RESP_IS_TEXT, 0);
    store64(r + AGNOSTIC_RESP_CTYPE, 0);
    store64(r + AGNOSTIC_RESP_HEADERS, 0);
    return r;
}

# A JSON response from the global allocator. Not for request paths.
fn agnostic_response_json(status, body): i64 {
    return agnostic_response_json_a(default_alloc(), status, body);
}

# A plain-text response, allocated in `a`. Returns 0 when the arena is exhausted.
fn agnostic_response_text_a(a, status, body: Str): i64 {
    var r = alloc_via(a, AGNOSTIC_RESP_SIZE);
    if (r == 0) { return 0; }
    store64(r + AGNOSTIC_RESP_STATUS, status);
    store64(r + AGNOSTIC_RESP_BODY, body);
    store64(r + AGNOSTIC_RESP_IS_TEXT, 1);
    store64(r + AGNOSTIC_RESP_CTYPE, 0);
    store64(r + AGNOSTIC_RESP_HEADERS, 0);
    return r;
}

# A `Str` body of media type `ctype`, sent with `headers` — each line ending CRLF, as
# sandhi's `extra_headers` takes them — allocated in `a`. Returns 0 when the arena is
# exhausted.
#
# Both strings are NUL-terminated and must outlive the response; the WebGUI passes
# generated literals and headers built once at mount, so they outlive everything.
fn agnostic_response_bytes_a(a, status, ctype, body: Str, headers): i64 {
    var r = alloc_via(a, AGNOSTIC_RESP_SIZE);
    if (r == 0) { return 0; }
    store64(r + AGNOSTIC_RESP_STATUS, status);
    store64(r + AGNOSTIC_RESP_BODY, body);
    store64(r + AGNOSTIC_RESP_IS_TEXT, 1);
    store64(r + AGNOSTIC_RESP_CTYPE, ctype);
    store64(r + AGNOSTIC_RESP_HEADERS, headers);
    return r;
}

# A plain-text response from the global allocator. Not for request paths.
fn agnostic_response_text(status, body: Str): i64 {
    return agnostic_response_text_a(default_alloc(), status, body);
}

# An error response shaped `{"error": "<message>"}`, allocated in `a`.
#
# One shape for every error the API emits. A client that can parse one failure
# can parse all of them, which is the difference between an API you can write a
# retry policy against and one you cannot.
fn agnostic_response_error_a(a, status, message: Str): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0; }
    var msg = bayan_json_v_str_new_a(a, message);
    if (msg == 0) { return 0; }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_ERROR, msg);
    return agnostic_response_json_a(a, status, obj);
}

# ## The error codes are a closed set (0.1.13)
#
# A refusal a client ACTS on, rather than shows, also names a machine-readable `code`.
# The codes are this enum and nothing else. `agnostic_response_error_code_a` takes a
# member, not a string, so no handler can send a code the catalogue does not list, and
# the API schema (H5) lists them from here. Until 0.1.13 each was a string literal at
# its call site, with its status beside it.
#
# Appended, never renumbered: the codes run 1, 2, 3 … with no gap, so a caller listing
# them stops at the first one `agnostic_error_code_name` answers 0 for. That is structural,
# not a convention: code `ec` is row `ec - 1` of the table below, a row is written only as
# the next one, and a lookup answers nothing below 1 or past the last row.
enum AgnosticErrorCode {
    AGNOSTIC_EC_PLUGIN_UNKNOWN   = 1;   # 403: no such plugin is built in (ADR 0007)
    AGNOSTIC_EC_PLUGIN_OFF       = 2;   # 403: the plugin is switched off; the shell leaves it
    AGNOSTIC_EC_PLUGIN_FORBIDDEN = 3;   # 403: the plugin is not granted this route
    AGNOSTIC_EC_REVISION         = 4;   # 412: a plugin document or agent definition changed since it was read
}

enum AgnosticErrorCodeRowOff {
    AGNOSTIC_ECROW_NAME        = 0;     # NUL-terminated cstring, the wire code
    AGNOSTIC_ECROW_STATUS      = 8;     # the HTTP status it is sent with
    AGNOSTIC_ECROW_SIZE        = 16;
    AGNOSTIC_ECROW_TABLE_BYTES = 128;   # the table's storage: 8 rows, 4 used
}

# The rows, AGNOSTIC_ECROW_SIZE bytes each: code `ec` is row `ec - 1`.
var _agnostic_ec_rows: u8[AGNOSTIC_ECROW_TABLE_BYTES];

# How many rows `_agnostic_ec_add` has refused: 0 after a correct build, which
# `http/error-codes` pins. Declared before the build below, or its initialiser would run
# after it and wipe the count.
var _agnostic_ec_refused = 0;

# Write code `ec` as row `n` and answer the next row's index. A code that is not the next
# one (`ec != n + 1`: a gap, a repeat, a renumbering) or that would not fit is refused — `n`
# comes back unchanged — so the table cannot hold a gap or a row past its storage. A
# refused code is neither listed nor sent (it answers 500, below), so it cannot be sent
# unlisted, and it is counted, so it cannot be refused silently either.
fn _agnostic_ec_add(n, ec, name, status): i64 {
    if ((ec != n + 1) || ((n + 1) * AGNOSTIC_ECROW_SIZE > AGNOSTIC_ECROW_TABLE_BYTES)) {
        _agnostic_ec_refused = _agnostic_ec_refused + 1;
        return n;
    }
    var r = &_agnostic_ec_rows + n * AGNOSTIC_ECROW_SIZE;
    store64(r + AGNOSTIC_ECROW_NAME, name);
    store64(r + AGNOSTIC_ECROW_STATUS, status);
    return n + 1;
}

# The catalogue. Answers the row count.
#
# Each code's name and status are defined here and nowhere else, on one line, so the two
# cannot drift apart.
fn _agnostic_ec_table_build(): i64 {
    var n = 0;
    n = _agnostic_ec_add(n, AGNOSTIC_EC_PLUGIN_UNKNOWN, "plugin_unknown", HTTP_FORBIDDEN);
    n = _agnostic_ec_add(n, AGNOSTIC_EC_PLUGIN_OFF, "plugin_off", HTTP_FORBIDDEN);
    n = _agnostic_ec_add(n, AGNOSTIC_EC_PLUGIN_FORBIDDEN, "plugin_forbidden", HTTP_FORBIDDEN);
    n = _agnostic_ec_add(n, AGNOSTIC_EC_REVISION, "revision", AGNOSTIC_HTTP_PRECONDITION_FAILED);
    return n;
}

# How many codes the table holds. Built at load, after the statuses it stores —
# `HTTP_FORBIDDEN` is sandhi's, prepended before `src/`, and `src/http/status.cyr` is
# included first — and never written again, so workers read it without a lock.
#
# ⚠ **At load means in include order.** A `var` initialiser in a module that `src/app.cyr`
# includes before this one would see an empty table and every code would answer 500. None
# builds a coded refusal at load today; keep it that way.
var _agnostic_ec_nrows = _agnostic_ec_table_build();

# Code `ec`'s row, or 0 for a value the catalogue does not list.
#
# The one bounds check every reader goes through. It holds whether `<` compares signed or
# unsigned: either way only 1 through the row count pass it.
fn _agnostic_error_code_row(ec): i64 {
    if (ec < 1 || ec > _agnostic_ec_nrows) { return 0; }
    return &_agnostic_ec_rows + (ec - 1) * AGNOSTIC_ECROW_SIZE;
}

# The wire name of error code `ec` — "plugin_off" and so on, a C string — or 0 for a
# value the catalogue does not list.
fn agnostic_error_code_name(ec): i64 {
    var r = _agnostic_error_code_row(ec);
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_ECROW_NAME);
}

# The HTTP status error code `ec` is sent with, or 0 for a value the catalogue does not list.
fn agnostic_error_code_status(ec): i64 {
    var r = _agnostic_error_code_row(ec);
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_ECROW_STATUS);
}

# An error response that also names a machine-readable `code` — for refusals a client acts
# on rather than shows, like the plugin rung's `plugin_off` (0.1.9) — allocated in `a`.
# `ec` is an `AgnosticErrorCode`; the status and the code both come from the catalogue.
#
# ⚠ **A value the catalogue does not list answers 500 "unknown error code", with no
# `code`**, rather than a refusal with an empty or invented one. It fails closed: a client
# switching on `code` never sees a value the catalogue does not list.
fn agnostic_response_error_code_a(a, ec, message: Str): i64 {
    var row = _agnostic_error_code_row(ec);
    if (row == 0) {
        return agnostic_response_error_a(a, HTTP_INTERNAL, str_from_a(a, "unknown error code"));
    }
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0; }
    var msg = bayan_json_v_str_new_a(a, message);
    if (msg == 0) { return 0; }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_ERROR, msg);
    var cv = bayan_json_v_str_new_a(a, str_from_a(a, load64(row + AGNOSTIC_ECROW_NAME)));
    if (cv == 0) { return 0; }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_CODE, cv);
    return agnostic_response_json_a(a, load64(row + AGNOSTIC_ECROW_STATUS), obj);
}

# An error response from the global allocator. Not for request paths.
fn agnostic_response_error(status, message: Str): i64 {
    return agnostic_response_error_a(default_alloc(), status, message);
}

# The HTTP status of a response, or 500 for a null response.
#
# A null response means the arena was exhausted mid-construction. Reporting it
# as 500 is correct — the server did fail — and it means the serve adapter can
# treat "handler returned 0" uniformly rather than special-casing it.
fn agnostic_response_status(r): i64 {
    if (r == 0) { return HTTP_INTERNAL; }
    return load64(r + AGNOSTIC_RESP_STATUS);
}

# The body of a response: a bayan value, or a Str when is_text is 1. 0 if null.
fn agnostic_response_body(r): i64 {
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_RESP_BODY);
}

# 1 when the body is a plain-text Str rather than a bayan JSON value.
fn agnostic_response_is_text(r): i64 {
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_RESP_IS_TEXT);
}

# The media type of a `Str` body as a C string, or 0 for the default (`text/plain`).
fn agnostic_response_ctype(r): i64 {
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_RESP_CTYPE);
}

# The extra header lines (each ending CRLF) as a C string, or 0 for none.
fn agnostic_response_headers(r): i64 {
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_RESP_HEADERS);
}

# Give response `r` extra header lines — each ending CRLF, one NUL-terminated C string, or 0
# for none — whatever its body (0.1.15: a 405's `Allow`, on a JSON error). The string must
# outlive the response; one built in the request's arena does. Answers `r`; a null `r` is
# left null, so a constructor's exhausted-arena 0 passes through.
fn agnostic_response_set_headers(r, headers): i64 {
    if (r == 0) { return 0; }
    store64(r + AGNOSTIC_RESP_HEADERS, headers);
    return r;
}
