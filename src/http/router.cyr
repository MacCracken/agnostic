# agnostic/http/router — the route table, the `:name` matcher, and dispatch.
#
# ## Kept separable from handler logic, on purpose
#
# The route table and request decoding stay independent of the handlers so an
# alternate surface can be mounted over the same handlers without touching
# either. That is the "keep the seam shim-able" obligation from
# `CYRIUS-PORT-BRIEF.md` §7.3: SecureYeoman consumes AgnosAI directly today, but
# if it is ever pointed at Agnostic the answer is an additive compatibility shim,
# not a core API bent to fit an existing client. Cheap to preserve now,
# expensive to retrofit.
#
# ## `:name` rather than `*`
#
# AgnosAI's matcher spells a path parameter `*`. This one spells it `:name`,
# which matches sandhi's own spelling — so if the table later moves to
# `sandhi_server_route_match` it is a rename rather than a rewrite — and carries
# the parameter's name as documentation at the point of use.
#
# ## A flat table, deliberately — and, since 0.1.13, literally one
#
# The routes are DATA: rows of a pattern and the route id it resolves to for each
# method, built once at load (`_agnostic_route_table_build`). The resolver walks the
# rows in order, and anything that has to list the API reads the same rows through
# `agnostic_route_row_pattern` / `agnostic_route_row_id`. Until 0.1.13 the resolver
# was an if-chain of literal patterns that this header already called a table, and
# nothing outside it could enumerate the routes.
#
# AgnosAI builds a two-level index (`_agnosai_path_prefix_end` / `_agnosai_seg_is`)
# to amortise sixteen table attempts. A flat scan in table order is correct,
# simpler, and faster at a small size.
#
# ⚠ **The table is 20 paths at 0.1.13 (21 rows: `/ui` is listed with and without
# its slash) — M1 had 2, M2 took it to 6, M3 to 11, the WebGUI to 16 (0.1.7, once
# miscounted as 15), plugin documents to 18, the crew plan to 19 (0.1.9), audit
# entries to 20 (0.1.10) — and the threshold at which the index becomes worth
# copying was always "roughly a dozen".** It is still flat, on a measurement rather
# than an estimate (`tests/agnostic.bcyr`, x86_64; re-measured at 0.1.13, when the
# if-chain became rows): resolving the first entry costs ~0.11 µs, the last
# ~0.87 µs, a miss that tries every row ~0.72 µs, and the one two-capture path
# ~2.2 µs — against ~48 µs for the per-request user lookup alone (ADR 0003). The
# index earns its complexity when that stops being true, or when the table stops
# fitting in a reader's head. The next change that adds a route should re-run
# `cyrius bench` rather than inherit this sentence.

enum AgnosticRouteId {
    AGNOSTIC_ROUTE_NONE         = 0;
    AGNOSTIC_ROUTE_HEALTH       = 1;
    AGNOSTIC_ROUTE_READY        = 2;
    AGNOSTIC_ROUTE_CREW_SUBMIT  = 3;
    AGNOSTIC_ROUTE_CREW_GET     = 4;
    AGNOSTIC_ROUTE_CREW_CANCEL  = 5;
    AGNOSTIC_ROUTE_CREW_EVENTS  = 6;
    AGNOSTIC_ROUTE_PRESET_LIST  = 7;
    AGNOSTIC_ROUTE_PRESET_GET   = 8;
    AGNOSTIC_ROUTE_DEF_LIST     = 9;
    AGNOSTIC_ROUTE_DEF_CREATE   = 10;
    AGNOSTIC_ROUTE_DEF_GET      = 11;
    AGNOSTIC_ROUTE_DEF_REPLACE  = 12;
    AGNOSTIC_ROUTE_DEF_DELETE   = 13;
    AGNOSTIC_ROUTE_AUDIT        = 14;
    AGNOSTIC_ROUTE_AUTH_LOGIN   = 15;
    AGNOSTIC_ROUTE_PLUGIN_LIST  = 16;
    AGNOSTIC_ROUTE_PLUGIN_SET   = 17;
    AGNOSTIC_ROUTE_UI_SHELL     = 18;
    AGNOSTIC_ROUTE_UI_PLUGIN    = 19;
    AGNOSTIC_ROUTE_PDATA_LIST   = 20;
    AGNOSTIC_ROUTE_PDATA_GET    = 21;
    AGNOSTIC_ROUTE_PDATA_PUT    = 22;
    AGNOSTIC_ROUTE_PDATA_DELETE = 23;
    AGNOSTIC_ROUTE_CREW_PLAN    = 24;
    AGNOSTIC_ROUTE_CREW_LIST    = 25;
    AGNOSTIC_ROUTE_AUDIT_ENTRIES = 26;
}

var AGNOSTIC_METHOD_NONE   = 0;
var AGNOSTIC_METHOD_GET    = 1;
var AGNOSTIC_METHOD_POST   = 2;
var AGNOSTIC_METHOD_PUT    = 3;
var AGNOSTIC_METHOD_DELETE = 4;

enum AgnosticRouteMatchOff {
    AGNOSTIC_RM_ID              = 0;
    AGNOSTIC_RM_PARAM           = 8;
    AGNOSTIC_RM_METHOD_MISMATCH = 16;
    AGNOSTIC_RM_PARAM2          = 24;
    AGNOSTIC_RM_ALLOW           = 32;   # a miss: the methods the matched path takes (0.1.15)
    AGNOSTIC_RM_PATTERN         = 40;   # a hit: the row's pattern, a cstring (0.1.16)
    AGNOSTIC_RM_SIZE            = 48;
}

# Map an HTTP method name to its constant. Unknown methods are NONE, which no row
# of the table has an arm for — so an exotic verb is never treated as GET: on a known
# path it answers 405, like any other method the path lacks, and on an unknown one 404.
fn agnostic_method_from(name: Str): i64 {
    if (str_eq_cstr(name, "GET") == 1) { return AGNOSTIC_METHOD_GET; }
    if (str_eq_cstr(name, "POST") == 1) { return AGNOSTIC_METHOD_POST; }
    if (str_eq_cstr(name, "PUT") == 1) { return AGNOSTIC_METHOD_PUT; }
    if (str_eq_cstr(name, "DELETE") == 1) { return AGNOSTIC_METHOD_DELETE; }
    return AGNOSTIC_METHOD_NONE;
}

# The name of method constant `m` — "GET", "POST", "PUT" or "DELETE", a C string — or 0
# for NONE and anything else. The inverse of `agnostic_method_from`, for whatever lists
# the routes: the API schema (H5).
fn agnostic_method_name(m): i64 {
    if (m == AGNOSTIC_METHOD_GET) { return "GET"; }
    if (m == AGNOSTIC_METHOD_POST) { return "POST"; }
    if (m == AGNOSTIC_METHOD_PUT) { return "PUT"; }
    if (m == AGNOSTIC_METHOD_DELETE) { return "DELETE"; }
    return 0;
}

# Build a match record in `a`.
fn _agnostic_rm_new_a(a, id, param, mismatch): i64 {
    return _agnostic_rm_new2_a(a, id, param, 0, mismatch);
}

# Build a match record carrying two captured segments, in `a`.
fn _agnostic_rm_new2_a(a, id, param, param2, mismatch): i64 {
    var m = alloc_via(a, AGNOSTIC_RM_SIZE);
    if (m == 0) { return 0; }
    store64(m + AGNOSTIC_RM_ID, id);
    store64(m + AGNOSTIC_RM_PARAM, param);
    store64(m + AGNOSTIC_RM_METHOD_MISMATCH, mismatch);
    store64(m + AGNOSTIC_RM_PARAM2, param2);
    store64(m + AGNOSTIC_RM_ALLOW, 0);
    store64(m + AGNOSTIC_RM_PATTERN, 0);
    return m;
}

# The matched route id, or AGNOSTIC_ROUTE_NONE.
fn agnostic_route_match_id(m): i64 {
    if (m == 0) { return AGNOSTIC_ROUTE_NONE; }
    return load64(m + AGNOSTIC_RM_ID);
}

# The captured `:name` segment as a Str, or 0 when the pattern had none.
fn agnostic_route_match_param(m): i64 {
    if (m == 0) { return 0; }
    return load64(m + AGNOSTIC_RM_PARAM);
}

# The SECOND captured `:name` segment as a Str, or 0 when the pattern had one or none.
fn agnostic_route_match_param2(m): i64 {
    if (m == 0) { return 0; }
    return load64(m + AGNOSTIC_RM_PARAM2);
}

# 1 when the path matched a known route but the method did not — the 405-vs-404
# split. Without it every wrong-method request 404s, which tells a client the
# resource does not exist when it does.
fn agnostic_route_match_method_mismatch(m): i64 {
    if (m == 0) { return 0; }
    return load64(m + AGNOSTIC_RM_METHOD_MISMATCH);
}

# On a method mismatch, the methods the matched path DOES take, as a mask with bit
# `1 << m` set for each method constant `m` — what the 405's `Allow` names (0.1.15).
# 0 on a hit and on a miss no row's path matched.
fn agnostic_route_match_allow(m): i64 {
    if (m == 0) { return 0; }
    return load64(m + AGNOSTIC_RM_ALLOW);
}

# On a hit, the pattern of the row that answered — `/api/v1/crews/:id`, a C string, `:name`
# segments kept — or 0 on any miss (0.1.16). What a server span names as `http.route`: the
# route, not the path, so ids stay out of the span name.
fn agnostic_route_match_pattern(m): i64 {
    if (m == 0) { return 0; }
    return load64(m + AGNOSTIC_RM_PATTERN);
}

# Whether `path`, starting at byte `start`, matches `pattern`.
#
# `pattern` is a NUL-terminated cstring; a segment beginning `:` matches any one
# non-empty segment and is captured into `out_param`.
#
# Transcribed from `_agnosai_path_matches_at` with the wildcard test changed from
# `*` to `:` — dropping the `qlen == 1` requirement so `:id` works — and the
# capture kept as remember-then-materialise.
#
# ⚠ **The capture is REMEMBERED, not materialised.** `str_sub_a` runs once, at
# the bottom, only if the whole pattern matched. Allocating at the capture site
# leaks a Str for every pattern that matches its parameter and then fails a later
# segment — `/health/x` tried against `/health/:id/detail` captures `x`, fails on
# the trailing segment, and allocates again on the next pattern.
#
# Up to TWO `:name` segments are captured (0.1.8 — `/api/v1/plugins/:id/data/:key`),
# the first into `out_param` and the second into `out_param2`, which may be 0 when
# the caller wants only one. A third `:name` matches but is not captured.
fn _agnostic_path_matches_at(a, path: Str, start, pattern, out_param, out_param2): i64 {
    var p = str_data(path);
    var n = str_len(path);
    store64(out_param, 0);
    if (out_param2 != 0) { store64(out_param2, 0); }

    # Skip exactly one leading `/` on each side.
    var pi = start;
    if (n > start) { if ((load8(p + start) & 255) == 47) { pi = start + 1; } }
    var qi = 0;
    if ((load8(pattern) & 255) == 47) { qi = 1; }

    # `has` is "there is another segment to read", which is NOT "there are bytes
    # left": after consuming a trailing separator there is one more, empty,
    # segment. Conflating them makes `/health/` match `/health`.
    var p_has = 0;
    if (pi < n) { p_has = 1; }
    var q_has = 0;
    if ((load8(pattern + qi) & 255) != 0) { q_has = 1; }

    var cap_at = 0 - 1;
    var cap_len = 0;
    var cap2_at = 0 - 1;
    var cap2_len = 0;

    while (1 == 1) {
        if (p_has == 0) {
            if (q_has == 0) {
                if (cap_at >= 0) { store64(out_param, str_sub_a(a, path, cap_at, cap_len)); }
                if (cap2_at >= 0 && out_param2 != 0) {
                    store64(out_param2, str_sub_a(a, path, cap2_at, cap2_len));
                }
                return 1;
            }
            return 0;
        }
        if (q_has == 0) { return 0; }

        var pe = pi;
        while (pe < n) {
            if ((load8(p + pe) & 255) == 47) { break; }
            pe = pe + 1;
        }
        var qe = qi;
        while ((load8(pattern + qe) & 255) != 0) {
            if ((load8(pattern + qe) & 255) == 47) { break; }
            qe = qe + 1;
        }
        var plen = pe - pi;
        var qlen = qe - qi;

        if ((load8(pattern + qi) & 255) == 58) {
            # `:name` — matches one non-empty segment. The first is captured into
            # `out_param`, the second into `out_param2`.
            if (plen == 0) { return 0; }
            if (cap_at < 0) {
                cap_at = pi;
                cap_len = plen;
            } elif (cap2_at < 0) {
                cap2_at = pi;
                cap2_len = plen;
            }
        } else {
            if (plen != qlen) { return 0; }
            var k = 0;
            while (k < plen) {
                if ((load8(p + pi + k) & 255) != (load8(pattern + qi + k) & 255)) { return 0; }
                k = k + 1;
            }
        }

        if (pe >= n) { p_has = 0; } else { pi = pe + 1; }
        if ((load8(pattern + qe) & 255) == 0) { q_has = 0; } else { qi = qe + 1; }
    }
    return 0;
}

# Whether `path` matches `pattern`, capturing any `:name` segment.
fn agnostic_path_matches_a(a, path: Str, pattern, out_param): i64 {
    return _agnostic_path_matches_at(a, path, 0, pattern, out_param, 0);
}

# Whether `path` matches `pattern`, capturing the first two `:name` segments.
fn agnostic_path_matches2_a(a, path: Str, pattern, out_param, out_param2): i64 {
    return _agnostic_path_matches_at(a, path, 0, pattern, out_param, out_param2);
}

# Strip a query string, returning the path alone.
#
# ⚠ Without this `GET /health?probe=1` does not match `/health` and 404s.
# AgnosAI never strips (`grep -rn path_only agnosai/src/` finds nothing), so its
# own health endpoint 404s for any caller that appends a cache-buster. bote does
# strip, and is the better precedent.
fn agnostic_path_only_a(a, path: Str): i64 {
    var n = str_len(path);
    var d = str_data(path);
    var i = 0;
    while (i < n) {
        var c = load8(d + i) & 255;
        if (c == 63) { return str_sub_a(a, path, 0, i); }   # '?'
        if (c == 35) { return str_sub_a(a, path, 0, i); }   # '#'
        i = i + 1;
    }
    return path;
}

# --- the route table (0.1.13) ------------------------------------------------
#
# One row per pattern: the pattern, then the route id it resolves to for each
# method — AGNOSTIC_ROUTE_NONE where the path has no arm for that method.
enum AgnosticRouteRowOff {
    AGNOSTIC_RR_PATTERN     = 0;    # NUL-terminated cstring, `:name` segments kept
    AGNOSTIC_RR_GET         = 8;
    AGNOSTIC_RR_POST        = 16;
    AGNOSTIC_RR_PUT         = 24;
    AGNOSTIC_RR_DELETE      = 32;
    AGNOSTIC_RR_SIZE        = 40;
    AGNOSTIC_RR_TABLE_BYTES = 1280; # the table's storage: 32 rows, 21 used
}

# The rows, AGNOSTIC_RR_SIZE bytes each, in resolution order.
var _agnostic_route_rows: u8[AGNOSTIC_RR_TABLE_BYTES];

# Write row `n` and answer the next row's index. A row that would not fit is refused
# — `n` comes back unchanged — rather than written past the storage; the
# `router/table` suite fails while the table is full, so a refused row cannot ship.
fn _agnostic_route_add(n, pattern, get_id, post_id, put_id, delete_id): i64 {
    if ((n + 1) * AGNOSTIC_RR_SIZE > AGNOSTIC_RR_TABLE_BYTES) { return n; }
    var r = &_agnostic_route_rows + n * AGNOSTIC_RR_SIZE;
    store64(r + AGNOSTIC_RR_PATTERN, pattern);
    store64(r + AGNOSTIC_RR_GET, get_id);
    store64(r + AGNOSTIC_RR_POST, post_id);
    store64(r + AGNOSTIC_RR_PUT, put_id);
    store64(r + AGNOSTIC_RR_DELETE, delete_id);
    return n + 1;
}

# The table, in resolution order. Answers the row count.
#
# Order is readability, not precedence: `_agnostic_path_matches_at` requires an
# exact segment count and every literal segment, so no two rows match one path and
# `/api/v1/crews/:id` cannot swallow `/api/v1/crews/:id/cancel`. It is still kept
# as it was, so the costs measured above stay comparable.
fn _agnostic_route_table_build(): i64 {
    var none = AGNOSTIC_ROUTE_NONE;
    var n = 0;
    # Each row: (n, pattern, GET, POST, PUT, DELETE).
    n = _agnostic_route_add(n, "/health", AGNOSTIC_ROUTE_HEALTH, none, none, none);
    n = _agnostic_route_add(n, "/ready", AGNOSTIC_ROUTE_READY, none, none, none);

    # The crew surface (M2). `GET /api/v1/crews` answered 405 until 0.1.9: a listing
    # needed pagination and a tenancy scope to be worth anything. It has both now — a
    # cursor, and crews that belong to the tenant that submitted them.
    n = _agnostic_route_add(n, "/api/v1/crews", AGNOSTIC_ROUTE_CREW_LIST, AGNOSTIC_ROUTE_CREW_SUBMIT, none, none);
    n = _agnostic_route_add(n, "/api/v1/crews/:id", AGNOSTIC_ROUTE_CREW_GET, none, none, none);
    n = _agnostic_route_add(n, "/api/v1/crews/:id/cancel", none, AGNOSTIC_ROUTE_CREW_CANCEL, none, none);
    n = _agnostic_route_add(n, "/api/v1/crews/:id/events", AGNOSTIC_ROUTE_CREW_EVENTS, none, none, none);
    # What a crew was asked to do (0.1.9): its agents and its tasks, with the engine's
    # ids — what a watcher binds progress events to.
    n = _agnostic_route_add(n, "/api/v1/crews/:id/plan", AGNOSTIC_ROUTE_CREW_PLAN, none, none, none);

    # Identity (M5). POST only: a GET earns a 405 naming the mismatch rather than a
    # 404, because the endpoint exists — it just is not readable.
    n = _agnostic_route_add(n, "/api/v1/auth/login", none, AGNOSTIC_ROUTE_AUTH_LOGIN, none, none);

    # The preset library (M3) — read-only. A POST to either path earns a 405 naming
    # the mismatch rather than a 404: the collection exists, the write surface does
    # not. Creating a preset is a durable object, which is M4's.
    n = _agnostic_route_add(n, "/api/v1/presets", AGNOSTIC_ROUTE_PRESET_LIST, none, none, none);
    n = _agnostic_route_add(n, "/api/v1/presets/:name", AGNOSTIC_ROUTE_PRESET_GET, none, none, none);

    # Agent definitions (M3). Two paths, five methods — the first rows where one path
    # carries more than one verb.
    n = _agnostic_route_add(n, "/api/v1/agents/definitions",
      AGNOSTIC_ROUTE_DEF_LIST, AGNOSTIC_ROUTE_DEF_CREATE, none, none);
    n = _agnostic_route_add(n, "/api/v1/agents/definitions/:key",
      AGNOSTIC_ROUTE_DEF_GET, none, AGNOSTIC_ROUTE_DEF_REPLACE, AGNOSTIC_ROUTE_DEF_DELETE);

    # The audit trail (M4), read-only. Nothing writes it over HTTP — entries come
    # from the operations they record, never from a client. Its newest entries
    # (0.1.10), by cursor.
    n = _agnostic_route_add(n, "/api/v1/audit", AGNOSTIC_ROUTE_AUDIT, none, none, none);
    n = _agnostic_route_add(n, "/api/v1/audit/entries", AGNOSTIC_ROUTE_AUDIT_ENTRIES, none, none, none);

    # WebGUI plugins (0.1.7). The collection is GET only — the set of plugins is fixed
    # by the build, so there is nothing to POST — and one plugin is PUT only: its
    # switch is the whole of its mutable state.
    n = _agnostic_route_add(n, "/api/v1/plugins", AGNOSTIC_ROUTE_PLUGIN_LIST, none, none, none);
    n = _agnostic_route_add(n, "/api/v1/plugins/:id", none, none, AGNOSTIC_ROUTE_PLUGIN_SET, none);

    # A plugin's own documents (0.1.8) — the only row with two path parameters; the
    # second is captured into the match record's `param2`.
    n = _agnostic_route_add(n, "/api/v1/plugins/:id/data", AGNOSTIC_ROUTE_PDATA_LIST, none, none, none);
    n = _agnostic_route_add(n, "/api/v1/plugins/:id/data/:key",
      AGNOSTIC_ROUTE_PDATA_GET, none, AGNOSTIC_ROUTE_PDATA_PUT, AGNOSTIC_ROUTE_PDATA_DELETE);

    # The WebGUI's pages (0.1.7). `/ui/` is a row beside `/ui` because the matcher
    # reads a trailing `/` as one more, empty, segment — and a person types either.
    n = _agnostic_route_add(n, "/ui", AGNOSTIC_ROUTE_UI_SHELL, none, none, none);
    n = _agnostic_route_add(n, "/ui/", AGNOSTIC_ROUTE_UI_SHELL, none, none, none);
    n = _agnostic_route_add(n, "/ui/plugins/:id", AGNOSTIC_ROUTE_UI_PLUGIN, none, none, none);
    return n;
}

# How many rows the table holds. Built at load, like the store lock, so the table is
# complete before any thread can read it; nothing writes it afterwards, so workers
# read it without a lock.
#
# ⚠ **At load means in include order.** A `var` initialiser in a module that
# `src/app.cyr` includes before this one runs while the table is still empty, and
# would see every path 404. None resolves a route at load today; keep it that way.
var _agnostic_route_nrows = _agnostic_route_table_build();

# The id `row` resolves to for `method`, or AGNOSTIC_ROUTE_NONE.
fn _agnostic_route_arm(row, method): i64 {
    if (method == AGNOSTIC_METHOD_GET) { return load64(row + AGNOSTIC_RR_GET); }
    if (method == AGNOSTIC_METHOD_POST) { return load64(row + AGNOSTIC_RR_POST); }
    if (method == AGNOSTIC_METHOD_PUT) { return load64(row + AGNOSTIC_RR_PUT); }
    if (method == AGNOSTIC_METHOD_DELETE) { return load64(row + AGNOSTIC_RR_DELETE); }
    return AGNOSTIC_ROUTE_NONE;
}

# The pattern of row `i` — a cstring, `:name` segments kept — or 0 past the last
# row, so a caller listing the routes needs no count of its own.
fn agnostic_route_row_pattern(i): i64 {
    if (i < 0 || i >= _agnostic_route_nrows) { return 0; }
    return load64(&_agnostic_route_rows + i * AGNOSTIC_RR_SIZE + AGNOSTIC_RR_PATTERN);
}

# The route id row `i` resolves to for `method`: AGNOSTIC_ROUTE_NONE when the row
# has no arm for that method, the method is unknown, or `i` is past the last row.
fn agnostic_route_row_id(i, method): i64 {
    if (i < 0 || i >= _agnostic_route_nrows) { return AGNOSTIC_ROUTE_NONE; }
    return _agnostic_route_arm(&_agnostic_route_rows + i * AGNOSTIC_RR_SIZE, method);
}

# Resolve a method and path to a route.
#
# Returns a match record. When no route matches, the id is AGNOSTIC_ROUTE_NONE
# and `method_mismatch` distinguishes 405 from 404: a row whose path matched but
# which has no arm for the method marks the miss as a mismatch, and the scan goes
# on — so a path is 405 only when no row answers its method.
#
# Every row goes through the two-capture matcher. It clears both out-params on
# entry and fills the second only for a pattern with two `:name` segments, so a
# one-parameter route's record carries `param2` = 0, exactly as before 0.1.13.
# The loop calls `_agnostic_path_matches_at` itself rather than through the
# `agnostic_path_matches2_a` wrapper: one call fewer per row is what keeps the
# walk at or below the if-chain's cost (measured, see the header).
fn agnostic_route_resolve_a(a, method, path: Str): i64 {
    var clean = agnostic_path_only_a(a, path);
    var param = 0;
    var param2 = 0;
    var path_hit = 0;
    var allow = 0;
    var row = &_agnostic_route_rows;
    var end = row + _agnostic_route_nrows * AGNOSTIC_RR_SIZE;
    while (row < end) {
        if (_agnostic_path_matches_at(a, clean, 0, load64(row + AGNOSTIC_RR_PATTERN), &param, &param2) == 1) {
            path_hit = 1;
            var id = _agnostic_route_arm(row, method);
            if (id != AGNOSTIC_ROUTE_NONE) {
                var hit = _agnostic_rm_new2_a(a, id, param, param2, 0);
                if (hit != 0) { store64(hit + AGNOSTIC_RM_PATTERN, load64(row + AGNOSTIC_RR_PATTERN)); }
                return hit;
            }
            allow = allow | _agnostic_route_row_mask(row);
        }
        row = row + AGNOSTIC_RR_SIZE;
    }
    var miss = _agnostic_rm_new_a(a, AGNOSTIC_ROUTE_NONE, 0, path_hit);
    if (miss != 0) { store64(miss + AGNOSTIC_RM_ALLOW, allow); }
    return miss;
}

# The methods `row` has an arm for, as a mask with bit `1 << m` set for each method `m`.
fn _agnostic_route_row_mask(row): i64 {
    var mask = 0;
    var m = AGNOSTIC_METHOD_GET;
    while (m <= AGNOSTIC_METHOD_DELETE) {
        if (_agnostic_route_arm(row, m) != AGNOSTIC_ROUTE_NONE) { mask = mask | (1 << m); }
        m = m + 1;
    }
    return mask;
}

# The `Allow` header line for method mask `allow` — `Allow: GET, POST` and CRLF, the methods
# in the table's column order — as a NUL-terminated C string in `a`, or 0 for an empty mask
# or an exhausted arena (0.1.15).
#
# RFC 9110 §15.5.6: a 405 MUST carry `Allow`. Until 0.1.15 it carried none.
fn agnostic_route_allow_header_a(a, allow): i64 {
    if (allow == 0) { return 0; }
    var sb = str_builder_new_a(a);
    if (sb == 0) { return 0; }
    str_builder_add_cstr_a(a, sb, "Allow: ");
    var first = 1;
    var m = AGNOSTIC_METHOD_GET;
    while (m <= AGNOSTIC_METHOD_DELETE) {
        if ((allow & (1 << m)) != 0) {
            if (first == 0) { str_builder_add_cstr_a(a, sb, ", "); }
            str_builder_add_cstr_a(a, sb, agnostic_method_name(m));
            first = 0;
        }
        m = m + 1;
    }
    str_builder_add_cstr_a(a, sb, "\r\n");
    var built = str_builder_build_a(a, sb);
    if (built == 0) { return 0; }
    return str_data(built);
}

# Whether a route requires authentication.
#
# The seam M5 fills. `/health` and `/ready` stay public — an orchestrator probe
# cannot present a credential, and a readiness check behind auth is a readiness
# check that fails closed for the wrong reason. Every future route defaults to
# requiring auth, so forgetting to classify one fails safe.
fn agnostic_route_needs_auth(id): i64 {
    if (id == AGNOSTIC_ROUTE_NONE) { return 0; }
    if (id == AGNOSTIC_ROUTE_HEALTH) { return 0; }
    if (id == AGNOSTIC_ROUTE_READY) { return 0; }
    # ⚠ **Login is exempt, necessarily.** It is how a caller OBTAINS a
    # credential, so requiring one would make the surface unreachable. This is
    # the only exemption on the authenticated side of the API, and it is not
    # unprotected: `agnostic_login_a` puts a per-IP token bucket and the Argon2
    # pool cap in front of it, which is the protection appropriate to an endpoint
    # that must accept anonymous requests.
    if (id == AGNOSTIC_ROUTE_AUTH_LOGIN) { return 0; }
    # ⚠ **The WebGUI's two page routes are public, necessarily** (0.1.7). A browser
    # cannot attach a bearer token to a navigation, so a page behind this rung could
    # never be opened — and a page holds no data: it is a compiled-in file, the same
    # bytes for every caller. Everything a page shows comes from API calls that carry
    # the caller's credential and are authorised like any other. The plugin API
    # itself is NOT exempt: listing is READ and switching is ADMIN.
    if (id == AGNOSTIC_ROUTE_UI_SHELL) { return 0; }
    if (id == AGNOSTIC_ROUTE_UI_PLUGIN) { return 0; }
    # Every crew route falls through to 1 — submitting work, reading its output
    # and cancelling it are all privileged. They are not listed individually,
    # deliberately: the default is what protects a route someone forgets to
    # classify, and enumerating them here would make the list the thing to
    # remember instead.
    return 1;
}

# Resolve and run a request, returning a response.
#
# The ladder order is load-bearing:
#   1. Body size, before routing — a 20 MB body to a bad path should be rejected
#      on size, not parsed to discover it has nowhere to go.
#   2. The Host rung (0.1.8): with authentication off, a socket request must name a
#      loopback host — 403 otherwise. `src/http/guard.cyr` says why.
#   3. Route resolution; 405 when the path matched but the method did not,
#      404 otherwise.
#   4. The plugin rung (0.1.9): a request made for a plugin (`X-Agnostic-Plugin`) must
#      be one its manifest's permissions grant, and the plugin switched on — 403 with a
#      `code` otherwise. ADR 0007.
#   5. Authentication and authorisation — after routing so a 401 does not leak
#      which paths exist, and before the handler so no privileged work runs for
#      an unidentified caller. The resolved principal is recorded on `ctx`.
#   6. The media-type rung (0.1.8): a socket POST or PUT must declare JSON — 415.
#   7. Dispatch.
#
# `ctx` is an `agnostic_reqctx_new_a` block carrying the request's credential and
# peer address, or 0 when neither is known. It is a parameter rather than a
# global because the ladder is called directly by `tests/router.tcyr`, and a
# global would let a test pass while the server path was unauthenticated.
#
# ⚠ A **context**, not a widening argument list: the ladder already needed the
# `Authorization` header, and the login route needs the peer address for its rate
# bucket. Threading each one separately is how a dispatch signature reaches nine
# parameters. `ctx == 0` means "no credential, no address", which is exactly what
# a unit test wants and what the earlier call sites already pass.
#
# ⚠ **401 and 403 are different answers and both are deliberate.** 401 means "I
# do not know who you are" — no credential, or one that did not verify. 403 means
# "I know who you are and you may not do this". Collapsing them into one status
# is a common hardening reflex and it is wrong here: it would tell a valid user
# with the wrong role to go and re-authenticate, which they cannot fix.
fn agnostic_route_dispatch_a(a, method, path: Str, body: Str, max_body, ctx): i64 {
    if (str_len(body) > max_body) {
        return agnostic_response_error_a(a, HTTP_PAYLOAD_TOO_LARGE, str_from_a(a, "request body too large"));
    }

    # --- the Host rung (0.1.8) ----------------------------------------------
    #
    # With authentication OFF, a socket request must name a loopback host — the
    # defence against DNS rebinding, `src/http/guard.cyr`. Before routing, like the
    # body size: it is a property of how the request arrived, not of what it asked.
    if (agnostic_reqctx_is_transport(ctx) == 1 && agnostic_authn_required() == 0) {
        if (agnostic_host_is_loopback(agnostic_reqctx_host(ctx)) == 0) {
            return agnostic_response_error_a(a, HTTP_FORBIDDEN,
              str_from_a(a, "AGNOSTIC_AUTH=off: only a loopback Host is answered (localhost, 127.0.0.1, [::1])"));
        }
    }

    var m = agnostic_route_resolve_a(a, method, path);
    var id = agnostic_route_match_id(m);
    # The matched route, for the server span the serve adapter records (0.1.16, ADR 0020):
    # known from here on, so a 401 or 403 on a real route is named by it too.
    agnostic_reqctx_set_route(ctx, agnostic_route_match_pattern(m));

    if (id == AGNOSTIC_ROUTE_NONE) {
        if (agnostic_route_match_method_mismatch(m) == 1) {
            var refused = agnostic_response_error_a(a, HTTP_METHOD_NOT_ALLOWED, str_from_a(a, "method not allowed"));
            # The methods the path takes (0.1.15) — RFC 9110 §15.5.6 makes it a MUST.
            agnostic_response_set_headers(refused,
              agnostic_route_allow_header_a(a, agnostic_route_match_allow(m)));
            return refused;
        }
        return agnostic_response_error_a(a, HTTP_NOT_FOUND, str_from_a(a, "not found"));
    }

    # --- the plugin rung (0.1.9, ADR 0007) ---------------------------------
    #
    # A request the shell's bridge made for a plugin carries `X-Agnostic-Plugin`. What that
    # plugin may ask for is settled BEFORE who is asking: outside its permissions, or with
    # the plugin switched off, it is refused here and never authenticates. A request without
    # the header — the shell itself, a script — is not a plugin's and passes untouched.
    var plugin_id = agnostic_reqctx_plugin(ctx);
    if (plugin_id != 0) {
        var refusal = agnostic_plugin_gate_a(a, plugin_id, method, path);
        if (refusal != 0) { return refusal; }
    }

    # --- the auth rung -----------------------------------------------------
    #
    # `agnostic_perm_for_route` answers 0 for the routes that need nothing, so
    # health and readiness fall straight through without a special case here.
    # A route nobody classified answers ADMIN, so forgetting one fails closed.
    if (agnostic_authn_required() == 1) {
        var need = agnostic_perm_for_route(id);
        if (need != 0) {
            var principal = agnostic_authn_resolve_a(a, agnostic_reqctx_authz(ctx));
            if (principal == 0) {
                return agnostic_response_error_a(a, HTTP_UNAUTHORIZED,
                  str_from_a(a, "authentication required"));
            }
            if (agnostic_role_can(agnostic_principal_role(principal), need) == 0) {
                return agnostic_response_error_a(a, HTTP_FORBIDDEN,
                  str_from_a(a, "insufficient permissions"));
            }
            # Handlers that scope by tenant read it from here (0.1.8).
            agnostic_reqctx_set_principal(ctx, principal);
        }
    }

    # --- the media-type rung (0.1.8) ------------------------------------------
    #
    # A socket POST or PUT must declare a JSON body, even an empty one — the defence
    # against a cross-site form post, `src/http/guard.cyr`. After authentication, so a
    # bad token is still 401 first; before the handler, so nothing runs for it.
    if (agnostic_reqctx_is_transport(ctx) == 1) {
        if (method == AGNOSTIC_METHOD_POST || method == AGNOSTIC_METHOD_PUT) {
            if (agnostic_content_type_is_json(agnostic_reqctx_ctype(ctx)) == 0) {
                return agnostic_response_error_a(a, AGNOSTIC_HTTP_UNSUPPORTED_MEDIA,
                  str_from_a(a, "POST and PUT need Content-Type: application/json"));
            }
        }
    }

    if (id == AGNOSTIC_ROUTE_HEALTH) { return agnostic_route_health_a(a); }
    if (id == AGNOSTIC_ROUTE_READY) { return agnostic_route_ready_a(a); }

    # The crew handlers take `ctx`: a crew belongs to the caller's tenant (0.1.9).
    if (id == AGNOSTIC_ROUTE_CREW_SUBMIT) { return agnostic_route_crew_submit_a(a, body, ctx); }
    if (id == AGNOSTIC_ROUTE_CREW_LIST) {
        # The raw path, query and all: `?limit=` and `?before=` (0.1.9).
        return agnostic_route_crews_list_a(a, path, ctx);
    }
    if (id == AGNOSTIC_ROUTE_CREW_GET) {
        return agnostic_route_crew_get_a(a, agnostic_route_match_param(m), ctx);
    }
    if (id == AGNOSTIC_ROUTE_CREW_CANCEL) {
        return agnostic_route_crew_cancel_a(a, agnostic_route_match_param(m), ctx);
    }
    if (id == AGNOSTIC_ROUTE_CREW_EVENTS) {
        # The raw path, query and all: `?after=` is the cursor (0.1.9).
        return agnostic_route_crew_events_a(a, agnostic_route_match_param(m), path, ctx);
    }
    if (id == AGNOSTIC_ROUTE_CREW_PLAN) {
        # The raw path, query and all: `?explain=selection` and `?task=` (0.1.14).
        return agnostic_route_crew_plan_a(a, agnostic_route_match_param(m), path, ctx);
    }

    if (id == AGNOSTIC_ROUTE_DEF_LIST) { return agnostic_route_definitions_list_a(a); }
    if (id == AGNOSTIC_ROUTE_DEF_CREATE) { return agnostic_route_definition_create_a(a, body); }
    if (id == AGNOSTIC_ROUTE_DEF_GET) {
        return agnostic_route_definition_get_a(a, agnostic_route_match_param(m));
    }
    if (id == AGNOSTIC_ROUTE_DEF_REPLACE) {
        return agnostic_route_definition_replace_a(a, agnostic_route_match_param(m), body, ctx);
    }
    if (id == AGNOSTIC_ROUTE_DEF_DELETE) {
        return agnostic_route_definition_delete_a(a, agnostic_route_match_param(m), ctx);
    }

    if (id == AGNOSTIC_ROUTE_AUTH_LOGIN) { return agnostic_route_login_a(a, body, ctx); }

    if (id == AGNOSTIC_ROUTE_AUDIT) { return agnostic_route_audit_a(a); }
    if (id == AGNOSTIC_ROUTE_AUDIT_ENTRIES) {
        # The raw path, query and all: `?limit=` and `?before=` (0.1.10).
        return agnostic_route_audit_entries_a(a, path);
    }

    if (id == AGNOSTIC_ROUTE_PRESET_LIST) { return agnostic_route_presets_list_a(a); }
    if (id == AGNOSTIC_ROUTE_PRESET_GET) {
        return agnostic_route_preset_get_a(a, agnostic_route_match_param(m));
    }

    if (id == AGNOSTIC_ROUTE_PLUGIN_LIST) { return agnostic_route_plugins_list_a(a); }
    if (id == AGNOSTIC_ROUTE_PLUGIN_SET) {
        return agnostic_route_plugin_set_a(a, agnostic_route_match_param(m), body);
    }
    if (id == AGNOSTIC_ROUTE_UI_SHELL) { return agnostic_route_ui_shell_a(a); }
    if (id == AGNOSTIC_ROUTE_UI_PLUGIN) {
        return agnostic_route_ui_plugin_a(a, agnostic_route_match_param(m));
    }

    # The plugin-data handlers take `ctx`: the documents live in the caller's tenant.
    if (id == AGNOSTIC_ROUTE_PDATA_LIST) {
        return agnostic_route_plugindata_list_a(a, agnostic_route_match_param(m), ctx);
    }
    if (id == AGNOSTIC_ROUTE_PDATA_GET) {
        return agnostic_route_plugindata_get_a(a, agnostic_route_match_param(m),
          agnostic_route_match_param2(m), ctx);
    }
    if (id == AGNOSTIC_ROUTE_PDATA_PUT) {
        return agnostic_route_plugindata_put_a(a, agnostic_route_match_param(m),
          agnostic_route_match_param2(m), body, ctx);
    }
    if (id == AGNOSTIC_ROUTE_PDATA_DELETE) {
        return agnostic_route_plugindata_delete_a(a, agnostic_route_match_param(m),
          agnostic_route_match_param2(m), ctx);
    }

    # A resolved id with no dispatch arm is a table/ladder mismatch, not a client
    # error — report it as one rather than as a 404.
    return agnostic_response_error_a(a, HTTP_INTERNAL, str_from_a(a, "route resolved with no handler"));
}
