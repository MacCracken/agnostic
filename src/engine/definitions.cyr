# agnostic/engine/definitions — agent definitions, durable in patra.
#
# ## The nine functions did not change; what is behind them did
#
# M3 backed these with a `map_new_str()` and told every response
# `"storage": "memory"`. M4 replaces the body of each with patra and flips the
# literal to `"patra"`. **`src/routes/definitions.cyr` was not touched** — it
# reaches the store only through the functions below, which is why that rule
# existed.
#
# ## ⚠ The document IS the wire form, and that is the point
#
# A definition is stored as the JSON `agnostic_agent_def_to_value_a` renders,
# and read back through `agnostic_agent_def_decode_a` — the same decoder that
# validates a client's request. Three consequences, all wanted:
#
#   * There is **no second serialiser** to drift from the first. A field added to
#     the wire form is stored without anyone remembering to add a column.
#   * A row that no longer decodes is **caught**, not silently mis-read. If a
#     future schema change makes an old document invalid, `get` answers 0 and the
#     key behaves as absent rather than returning a half-built record.
#   * The store never has to know what a definition contains. `focus` and
#     `allow_delegation` — the two fields the engine has no slot for — persist
#     for free, because they are in the wire form.
#
# ## ⚠ The decode cache exists because there is no `free()`
#
# `agnostic_definitions_get` must return a record the caller can hold for the
# request. Decoding one per call would allocate from the global bump on every
# `GET`, forever — a leak proportional to traffic, which is the same reasoning
# that put a per-request arena in `serve.cyr`. But the decoder allocates
# globally *by design*, because the crew path needs its records to outlive the
# request that made them.
#
# So decoding happens **once per key**, into a write-through cache. patra is the
# source of truth for existence and for `count`/`keys`; the cache only avoids
# re-decoding a document we have already read.
#
# ⚠ **The cache assumes this process is the only writer.** patra is
# flock-arbitrated and genuinely multi-process, so a second process writing the
# same file would leave this one's cache stale. Agnostic runs as a single server
# process and `patra_open` is called once at mount; if that ever stops being
# true, the cache has to go — not be patched.

# What a store operation reports. Unchanged from M3, so no caller moved.
enum AgnosticDefResult {
    AGNOSTIC_DEF_OK      = 0;
    AGNOSTIC_DEF_EXISTS  = 1;
    AGNOSTIC_DEF_MISSING = 2;
    AGNOSTIC_DEF_FULL    = 3;
}

# How many decoded definitions the cache holds before it stops caching.
#
# ⚠ **A cache bound, not a store bound.** M3's identically-named cap was a real
# ceiling — `create` refused past it. patra has no such limit, so creates are no
# longer refused; past this many distinct keys, `get` simply decodes each time
# and the process trades speed for memory it was going to spend anyway.
var AGNOSTIC_DEFINITIONS_MAX = 256;

# key -> decoded AgnosticAgentDef. Never authoritative; see the module header.
#
# ⚠ **Guarded by the STORE lock, since 0.1.4 — not by a lock of its own.** It had
# its own mutex, deliberately never held across a patra call on the premise that
# "patra does its own flock arbitration". flock arbitrates between PROCESSES; it
# does nothing for threads sharing one handle. And splitting the cache's lock from
# the row's let three sequences interleave:
#
#   * `get` misses, reads the row, and caches it AFTER a concurrent `replace` has
#     cached the new record — the stale one wins, and is served until restart;
#   * `get` re-caches a record a concurrent `remove` has just deleted, so a key
#     that is gone keeps answering 200;
#   * two `create`s both see "absent" and both insert — two rows, two 201s.
#
# Every function below that touches the cache or the table now runs as one
# critical section under `agnostic_store_lock()`, which covers both.
var _agnostic_def_cache = 0;

var AGNOSTIC_DEF_TABLE_SQL = "CREATE TABLE agnostic_definitions (dkey STR, doc TEXT)";
var AGNOSTIC_DEF_INDEX_SQL = "CREATE INDEX ON agnostic_definitions (dkey)";

# Open the database and ensure the schema. Mount time only, before any worker.
#
# Returns 1 on success, 0 when the database cannot be opened or the schema
# cannot be established — and the caller refuses to start on 0, because a
# product tier that cannot persist what a user creates should say so at startup
# rather than at the first `POST`.
#
# ⚠ `CREATE TABLE` on an existing table answers `PATRA_ERR_EXISTS`, which is the
# normal path on every start after the first. It is tolerated; any *other* error
# is fatal. Treating all errors as fine here would turn a corrupt file into an
# empty-looking store.
fn agnostic_definitions_open(path: Str): i64 {
    if (agnostic_store_open(path) == 0) { return 0; }
    if (agnostic_store_ensure(AGNOSTIC_DEF_TABLE_SQL) == 0) { return 0; }
    # patra allows exactly ONE index per table — `SCH_IDX_COL` is a single slot
    # in the schema page — so this is the one, and it is on the column every
    # lookup uses. A second `CREATE INDEX` would silently replace it.
    if (agnostic_store_ensure(AGNOSTIC_DEF_INDEX_SQL) == 0) { return 0; }

    agnostic_store_lock();
    _agnostic_def_cache = map_new_str();
    agnostic_store_unlock();
    return 1;
}

# Prepare the cache without a database. Kept so the M3-era call site compiles;
# real startup goes through `agnostic_definitions_open`.
fn agnostic_definitions_init(): i64 {
    agnostic_store_lock();
    if (_agnostic_def_cache == 0) { _agnostic_def_cache = map_new_str(); }
    agnostic_store_unlock();
    return 1;
}

# Drop every definition. For tests — the server opens once at mount.
#
# ⚠ Clears the **table** as well as the cache. A reset that emptied only the
# cache would leave a suite's rows behind for the next suite, which is the kind
# of shared state that makes a test pass alone and fail in a run.
fn agnostic_definitions_reset(): i64 {
    agnostic_store_lock();
    _agnostic_def_cache = map_new_str();
    var db = agnostic_store_db();
    if (db != 0) { patra_exec(db, "DELETE FROM agnostic_definitions"); }
    agnostic_store_unlock();
    return 0;
}

# Close the database. Flushes any batched writes.
fn agnostic_definitions_close(): i64 {
    return agnostic_store_close();
}

# How many definitions the store holds. Answered by patra, not by the cache.
fn agnostic_definitions_count(): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_count_locked();
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_count`'s body. The caller holds the store lock.
fn _agnostic_definitions_count_locked(): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var rs = patra_query(db, "SELECT dkey FROM agnostic_definitions");
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    patra_result_free(rs);
    return n;
}

# Whether a key has a row. patra is the authority on existence, never the cache.
# The caller holds the store lock.
fn _agnostic_def_row_exists_locked(key: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db,
      "SELECT dkey FROM agnostic_definitions WHERE dkey = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    patra_result_free(rs);
    if (n > 0) { return 1; }
    return 0;
}

# Render a definition to the JSON document that is stored.
#
# Global allocator: the bytes are handed to patra and copied into a page, so the
# buffer is short-lived — but there is no arena at mount time and `create` can
# be called from one. Bounded by writes, not by reads, which is the trade this
# module can afford.
fn _agnostic_def_document(d): i64 {
    var v = agnostic_agent_def_to_value_a(default_alloc(), d);
    if (v == 0) { return 0; }
    return bayan_json_v_build(v);
}

# Put a definition in the cache, if there is room. Never fails a caller.
# The caller holds the store lock, which is what guards the cache.
fn _agnostic_def_cache_put(key: Str, d): i64 {
    agnostic_definitions_init();
    if (map_size(_agnostic_def_cache) < AGNOSTIC_DEFINITIONS_MAX) {
        map_set(_agnostic_def_cache, str_clone(key), d);
    }
    return 0;
}

# Store a definition under a key that must not already exist.
#
# ⚠ **Never an upsert.** `POST` to an existing key is a 409, because an upsert
# turns a typo'd key into a second silently-created definition.
fn agnostic_definitions_create(key: Str, def): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_create_locked(key, def);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_create`'s body. The caller holds the store lock, so the
# existence check and the insert are one step: of two racing creates of one key,
# exactly one inserts and the other is told EXISTS.
fn _agnostic_definitions_create_locked(key: Str, def): i64 {
    if (key == 0 || def == 0) { return AGNOSTIC_DEF_MISSING; }
    var db = agnostic_store_db();
    if (db == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_row_exists_locked(key) == 1) { return AGNOSTIC_DEF_EXISTS; }

    var doc = _agnostic_def_document(def);
    if (doc == 0) { return AGNOSTIC_DEF_MISSING; }

    var st = patra_prepare(db,
      "INSERT INTO agnostic_definitions (dkey, doc) VALUES (?, ?)");
    if (st == 0) { return AGNOSTIC_DEF_MISSING; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    patra_bind_text(st, 1, str_data(doc), str_len(doc));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);

    # ⚠ A failed write must NOT be reported as success. patra answers a code;
    # ignoring it is how "created" goes out for a row that is not there — the
    # §3.1 shape, one layer down.
    if (rc == PATRA_ERR_FULL) { return AGNOSTIC_DEF_FULL; }
    if (rc != PATRA_OK) { return AGNOSTIC_DEF_MISSING; }

    _agnostic_def_cache_put(key, def);
    return AGNOSTIC_DEF_OK;
}

# Replace the definition under an existing key. Never creates.
fn agnostic_definitions_replace(key: Str, def): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_replace_locked(key, def);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_replace`'s body. The caller holds the store lock.
fn _agnostic_definitions_replace_locked(key: Str, def): i64 {
    if (key == 0 || def == 0) { return AGNOSTIC_DEF_MISSING; }
    var db = agnostic_store_db();
    if (db == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_row_exists_locked(key) == 0) { return AGNOSTIC_DEF_MISSING; }

    var doc = _agnostic_def_document(def);
    if (doc == 0) { return AGNOSTIC_DEF_MISSING; }

    var st = patra_prepare(db,
      "UPDATE agnostic_definitions SET doc = ? WHERE dkey = ?");
    if (st == 0) { return AGNOSTIC_DEF_MISSING; }
    patra_bind_text(st, 0, str_data(doc), str_len(doc));
    patra_bind_text(st, 1, str_data(key), str_len(key));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return AGNOSTIC_DEF_MISSING; }

    # The cached record is now wrong; replace it rather than evicting, since the
    # caller is about to render exactly this.
    agnostic_definitions_init();
    map_set(_agnostic_def_cache, str_clone(key), def);
    return AGNOSTIC_DEF_OK;
}

# The definition under this key, or 0.
#
# Cache first, then patra. A row whose document no longer decodes answers 0 —
# see the module header for why that is the right failure.
fn agnostic_definitions_get(key: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_get_locked(key);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_get`'s body. The caller holds the store lock.
#
# ⚠ **The decode runs under the lock too**, though it touches no handle. Releasing
# between the read and the cache write is exactly the window in which a `replace`
# or `remove` lands and this function then caches what they just superseded.
fn _agnostic_definitions_get_locked(key: Str): i64 {
    if (key == 0) { return 0; }
    var db = agnostic_store_db();
    if (db == 0) { return 0; }

    agnostic_definitions_init();
    var hit = map_get(_agnostic_def_cache, key);
    if (hit != 0) { return hit; }

    var st = patra_prepare(db,
      "SELECT doc FROM agnostic_definitions WHERE dkey = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    if (patra_result_count(rs) == 0) { patra_result_free(rs); return 0; }

    var len = patra_result_get_text_len(rs, 0, 0);
    if (len <= 0) { patra_result_free(rs); return 0; }
    var buf = alloc(len);
    if (buf == 0) { patra_result_free(rs); return 0; }
    if (patra_result_read_text(db, rs, 0, 0, buf) != PATRA_OK) {
        patra_result_free(rs);
        return 0;
    }
    patra_result_free(rs);

    var v = bayan_json_v_parse_buf(buf, len);
    if (v == 0) { return 0; }
    var reject: i64[1];
    store64(&reject, 0);
    # -1: not inside an `agents` array, so a rejection reads as a document
    # problem rather than as an array index nobody sent.
    var d = agnostic_agent_def_decode_a(default_alloc(), v, 0 - 1, &reject);
    if (d == 0) { return 0; }

    _agnostic_def_cache_put(key, d);
    return d;
}

# Remove a definition. Returns OK or MISSING.
fn agnostic_definitions_remove(key: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_remove_locked(key);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_remove`'s body. The caller holds the store lock, so no
# `get` can re-cache the record between the delete and the eviction.
fn _agnostic_definitions_remove_locked(key: Str): i64 {
    if (key == 0) { return AGNOSTIC_DEF_MISSING; }
    var db = agnostic_store_db();
    if (db == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_row_exists_locked(key) == 0) { return AGNOSTIC_DEF_MISSING; }

    var st = patra_prepare(db, "DELETE FROM agnostic_definitions WHERE dkey = ?");
    if (st == 0) { return AGNOSTIC_DEF_MISSING; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return AGNOSTIC_DEF_MISSING; }

    agnostic_definitions_init();
    map_delete(_agnostic_def_cache, key);
    return AGNOSTIC_DEF_OK;
}

# A snapshot of every key, as a vec of Str. Answered by patra.
fn agnostic_definitions_keys(): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_keys_locked();
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_keys`'s body. The caller holds the store lock.
fn _agnostic_definitions_keys_locked(): i64 {
    var out = vec_new();
    var db = agnostic_store_db();
    if (db == 0) { return out; }
    var rs = patra_query(db, "SELECT dkey FROM agnostic_definitions");
    if (rs == 0) { return out; }
    var n = patra_result_count(rs);
    var i = 0;
    while (i < n) {
        var p = patra_result_get_str(rs, i, 0);
        var l = patra_result_get_str_len(rs, i, 0);
        # ⛔ COPY, not `str_new` — which borrows. `p` points into `rs`, freed two
        # lines down. Until 0.1.5 every key here dangled: a large result set is
        # unmapped on free, so listing ~300 definitions segfaulted hashing the
        # first key, and a small one is recycled, so a short listing could read
        # another query's bytes and skip entries as "removed".
        if (p != 0 && l > 0) { vec_push(out, str_from_buf(p, l)); }
        i = i + 1;
    }
    patra_result_free(rs);
    return out;
}
