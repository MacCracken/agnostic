# agnostic/engine/definitions — agent definitions, durable in patra.
#
# ## The nine functions did not change; what is behind them did
#
# M3 backed these with a `map_new_str()` and told every response
# `"storage": "memory"`. M4 replaces the body of each with patra and flips the
# literal to `"patra"`. **`src/routes/definitions.cyr` was not touched** — it
# reaches the store only through the functions below, which is why that rule
# existed.
#
# ## ⚠ The document IS the wire form, and that is the point
#
# A definition is stored as the JSON `agnostic_agent_def_to_value_a` renders,
# and read back through `agnostic_agent_def_decode_a` — the same decoder that
# validates a client's request. Three consequences, all wanted:
#
#   * There is **no second serialiser** to drift from the first. A field added to
#     the wire form is stored without anyone remembering to add a column.
#   * A row that no longer decodes is **caught**, not silently mis-read. If a
#     future schema change makes an old document invalid, `get` answers 0 and the
#     key behaves as absent rather than returning a half-built record.
#   * The store never has to know what a definition contains. `focus` and
#     `allow_delegation` — the two fields the engine has no slot for — persist
#     for free, because they are in the wire form.
#
# ## ⚠ The decode cache exists because there is no `free()`
#
# `agnostic_definitions_get` must return a record the caller can hold for the
# request. Decoding one per call would allocate from the global bump on every
# `GET`, forever — a leak proportional to traffic, which is the same reasoning
# that put a per-request arena in `serve.cyr`. But the decoder allocates
# globally *by design*, because the crew path needs its records to outlive the
# request that made them.
#
# So decoding happens **once per key**, into a write-through cache. patra is the
# source of truth for existence and for `count`/`keys`; the cache only avoids
# re-decoding a document we have already read.
#
# ⚠ **The cache assumes this process is the only writer.** patra is
# flock-arbitrated and genuinely multi-process, so a second process writing the
# same file would leave this one's cache stale. Agnostic runs as a single server
# process and `patra_open` is called once at mount; if that ever stops being
# true, the cache has to go — not be patched.

# ## ⚠ A definition belongs to a tenant, and the row's key says which (0.3.0)
#
# Audit S3: a tenant-b OPERATOR listed, read, replaced and deleted tenant-a's definition. The
# store functions below stay key-agnostic. The routes turn `(scope, key)` into a row key with
# `agnostic_definition_dkey_a`, as plugin documents do, and pass that:
#
#   * In the default scope `_` the row key is the key itself.
#   * In a tenant it is `<tenant>:<key>`. Neither a tenant key nor a definition key can contain
#     `:` (`agnostic_tenant_key_valid`, `agnostic_key_is_valid`), so the two cannot collide.
#
# So **a row written before 0.3.0 needed no migration**: it has no colon, and it belongs to `_`,
# as a crew stored before 0.1.9 does (ADR 0008). The stored document still holds the bare key.

# What a store operation reports. Unchanged from M3, so no caller moved.
enum AgnosticDefResult {
    AGNOSTIC_DEF_OK           = 0;
    AGNOSTIC_DEF_EXISTS       = 1;
    AGNOSTIC_DEF_MISSING      = 2;
    AGNOSTIC_DEF_FULL         = 3;
    AGNOSTIC_DEF_PRECONDITION = 4;  # If-Match named another revision (0.1.15)
    AGNOSTIC_DEF_NO_VERSION   = 5;  # no such version: never saved, or past the cap (0.4.2)
    AGNOSTIC_DEF_UNFIT        = 6;  # a version the door would refuse today (0.4.2)
}

# How many decoded definitions the cache holds before it stops caching.
#
# ⚠ **A cache bound, not a store bound.** M3's identically-named cap was a real
# ceiling — `create` refused past it. patra has no such limit, so creates are no
# longer refused; past this many distinct keys, a read decodes each time, in the
# reader's own arena.
var AGNOSTIC_DEFINITIONS_MAX = 256;

# key -> decoded AgnosticAgentDef. Never authoritative; see the module header.
#
# ⚠ **Guarded by the STORE lock, since 0.1.4 — not by a lock of its own.** It had
# its own mutex, deliberately never held across a patra call on the premise that
# "patra does its own flock arbitration". flock arbitrates between PROCESSES; it
# does nothing for threads sharing one handle. And splitting the cache's lock from
# the row's let three sequences interleave:
#
#   * `get` misses, reads the row, and caches it AFTER a concurrent `replace` has
#     cached the new record — the stale one wins, and is served until restart;
#   * `get` re-caches a record a concurrent `remove` has just deleted, so a key
#     that is gone keeps answering 200;
#   * two `create`s both see "absent" and both insert — two rows, two 201s.
#
# Every function below that touches the cache or the table now runs as one
# critical section under `agnostic_store_lock()`, which covers both.
var _agnostic_def_cache = 0;

var AGNOSTIC_DEF_TABLE_SQL = "CREATE TABLE agnostic_definitions (dkey STR, doc TEXT)";
var AGNOSTIC_DEF_INDEX_SQL = "CREATE INDEX ON agnostic_definitions (dkey)";

# Every document a definition has held (0.4.2, ADR 0035).
var AGNOSTIC_DEF_VER_TABLE_SQL =
"CREATE TABLE agnostic_definition_versions (dkey STR, version INT, saved_at INT, doc TEXT)";
var AGNOSTIC_DEF_VER_INDEX_SQL = "CREATE INDEX ON agnostic_definition_versions (dkey)";

# Open the database and ensure the schema. Mount time only, before any worker.
#
# Returns 1 on success, 0 when the database cannot be opened or the schema
# cannot be established — and the caller refuses to start on 0, because a
# product tier that cannot persist what a user creates should say so at startup
# rather than at the first `POST`.
#
# ⚠ `CREATE TABLE` on an existing table answers `PATRA_ERR_EXISTS`, which is the
# normal path on every start after the first. It is tolerated; any *other* error
# is fatal. Treating all errors as fine here would turn a corrupt file into an
# empty-looking store.
fn agnostic_definitions_open(path: Str): i64 {
    if (agnostic_store_open(path) == 0) { return 0; }
    if (agnostic_store_ensure(AGNOSTIC_DEF_TABLE_SQL) == 0) { return 0; }
    # patra allows exactly ONE index per table — `SCH_IDX_COL` is a single slot
    # in the schema page — so this is the one, and it is on the column every
    # lookup uses. A second `CREATE INDEX` would silently replace it.
    if (agnostic_store_ensure(AGNOSTIC_DEF_INDEX_SQL) == 0) { return 0; }
    if (agnostic_store_ensure(AGNOSTIC_DEF_VER_TABLE_SQL) == 0) { return 0; }
    if (agnostic_store_ensure(AGNOSTIC_DEF_VER_INDEX_SQL) == 0) { return 0; }

    agnostic_store_lock();
    _agnostic_def_cache = map_new_str();
    agnostic_store_unlock();
    return 1;
}

# Prepare the cache without a database. Kept so the M3-era call site compiles;
# real startup goes through `agnostic_definitions_open`.
fn agnostic_definitions_init(): i64 {
    agnostic_store_lock();
    if (_agnostic_def_cache == 0) { _agnostic_def_cache = map_new_str(); }
    agnostic_store_unlock();
    return 1;
}

# Drop every definition. For tests — the server opens once at mount.
#
# ⚠ Clears the **table** as well as the cache. A reset that emptied only the
# cache would leave a suite's rows behind for the next suite, which is the kind
# of shared state that makes a test pass alone and fail in a run.
fn agnostic_definitions_reset(): i64 {
    agnostic_store_lock();
    _agnostic_def_cache = map_new_str();
    var db = agnostic_store_db();
    if (db != 0) {
        patra_exec(db, "DELETE FROM agnostic_definitions");
        patra_exec(db, "DELETE FROM agnostic_definition_versions");
    }
    agnostic_store_unlock();
    return 0;
}

# Close the database. Flushes any batched writes.
fn agnostic_definitions_close(): i64 {
    return agnostic_store_close();
}

# How many definitions the store holds. Answered by patra, not by the cache.
fn agnostic_definitions_count(): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_count_locked();
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_count`'s body. The caller holds the store lock.
fn _agnostic_definitions_count_locked(): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var rs = patra_query(db, "SELECT dkey FROM agnostic_definitions");
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    patra_result_free(rs);
    return n;
}

# Whether a key has a row. patra is the authority on existence, never the cache.
# The caller holds the store lock.
fn _agnostic_def_row_exists_locked(key: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db,
      "SELECT dkey FROM agnostic_definitions WHERE dkey = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    patra_result_free(rs);
    if (n > 0) { return 1; }
    return 0;
}

# The row key for definition `key` in `scope`, in `a` — see the module header. 0 for a scope
# that holds nothing (`AGNOSTIC_SCOPE_NONE`), or when `a` is exhausted.
fn agnostic_definition_dkey_a(a, scope: Str, key: Str): i64 {
    if (scope == 0 || key == 0) { return 0; }
    if (str_eq(scope, AGNOSTIC_SCOPE_DEFAULT) == 1) { return key; }
    if (agnostic_tenant_key_valid(scope) == 0) { return 0; }
    return agnostic_tenant_scope_a(a, scope, key);
}

# Whether row key `dkey` is in `scope`. 1 or 0.
fn _agnostic_definition_in_scope_a(a, dkey: Str, scope: Str): i64 {
    if (str_eq(scope, AGNOSTIC_SCOPE_DEFAULT) == 1) {
        var i = 0;
        while (i < str_len(dkey)) {
            if ((load8(str_data(dkey) + i) & 255) == 58) { return 0; }
            i = i + 1;
        }
        return 1;
    }
    if (agnostic_tenant_unscope_a(a, scope, dkey) != 0) { return 1; }
    return 0;
}

# Render a definition to the JSON document that is stored, in `a`: the bytes are handed to patra
# and copied into a page, so the buffer lasts no longer than the write.
fn _agnostic_def_document_a(a, d): i64 {
    var v = agnostic_agent_def_to_value_a(a, d);
    if (v == 0) { return 0; }
    return bayan_json_v_build_a(a, v);
}

# ## Versions (0.4.2, ADR 0035)
#
# Every document a definition takes is a row here, numbered from 1 per key and never reused. Nobody
# has to remember to save one: the former code had a route for it, and history held only what
# someone had thought to keep before they needed it.
#
# ⚠ **A rollback is a write, so it is a new version.** History only grows at the end, and a
# rollback can itself be undone.
#
# ⚠ **The version goes first, then the definition.** A stop between the two leaves a version that
# was never current, which a list shows and nothing else minds. The other order would leave a
# definition no version holds, which is the one thing this table exists to prevent. Not a
# transaction, as a crew's writes are not: one costs three times the separate writes, on a path
# that loses nothing without it.
#
# ⚠ **A definition from before 0.4.2 has no versions.** The first replace saves what the row held as
# version 1, with no `saved_at`, as nobody knows when it was written. So what is overwritten first
# can be got back.
#
# ⚠ **Deleting a definition keeps its versions**, so that a rollback can bring it back: that is the
# accident this exists for. It also means a delete does not erase what a definition said. To a
# tenant deleted and made again they read as stored objects do (`agnostic_tenant_delete_empty_a`).
#
# A write that changes nothing adds nothing: a client that PUTs what it read does not push a real
# version off the end. `AGNOSTIC_MAX_VERSIONS` keeps the newest of each key, 50 by default.

# The newest versions kept per definition. Mount time only.
var AGNOSTIC_DEF_VERSIONS_DEFAULT = 50;
var _agnostic_def_versions_max = 50;

# Set how many versions are kept per definition. Mount time only.
fn agnostic_definitions_set_versions_max(n): i64 {
    _agnostic_def_versions_max = n;
    return 0;
}

# Column `col` of row `row`, a TEXT, copied into `a`. 0 for an empty one, or when `a` ran out.
fn _agnostic_def_text_a(a, db, rs, row, col): i64 {
    var len = patra_result_get_text_len(rs, row, col);
    if (len <= 0) { return 0; }
    var buf = alloc_via(a, len);
    if (buf == 0) { return 0; }
    if (patra_result_read_text(db, rs, row, col, buf) != PATRA_OK) { return 0; }
    return str_new_a(a, buf, len);
}

# The stored document under `key`, in `a`, or 0. The caller holds the store lock.
fn _agnostic_def_row_doc_locked_a(a, key: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db, "SELECT doc FROM agnostic_definitions WHERE dkey = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    var doc = 0;
    if (patra_result_count(rs) > 0) { doc = _agnostic_def_text_a(a, db, rs, 0, 0); }
    patra_result_free(rs);
    return doc;
}

# The newest version of `dkey`, or 0 for none. The caller holds the store lock.
fn _agnostic_def_version_newest_locked(dkey: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db,
      "SELECT version FROM agnostic_definition_versions WHERE dkey = ? ORDER BY version DESC LIMIT 1");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(dkey), str_len(dkey));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    var v = 0;
    if (patra_result_count(rs) > 0) { v = patra_result_get_int(rs, 0, 0); }
    patra_result_free(rs);
    return v;
}

# Version `version` of `dkey`: its document, in `a`, or 0, and when it was saved through `out_at`
# when that is not 0. The caller holds the store lock.
fn _agnostic_def_version_doc_locked_a(a, dkey: Str, version, out_at): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db,
      "SELECT doc, saved_at FROM agnostic_definition_versions WHERE dkey = ? AND version = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(dkey), str_len(dkey));
    patra_bind_int(st, 1, version);
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    var doc = 0;
    if (patra_result_count(rs) > 0) {
        doc = _agnostic_def_text_a(a, db, rs, 0, 0);
        if (out_at != 0) { store64(out_at, patra_result_get_int(rs, 0, 1)); }
    }
    patra_result_free(rs);
    return doc;
}

# Write one version row. 1, or 0 when it was not written. The caller holds the store lock.
fn _agnostic_def_version_insert_locked(dkey: Str, version, at, doc: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db,
      "INSERT INTO agnostic_definition_versions (dkey, version, saved_at, doc) VALUES (?, ?, ?, ?)");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(dkey), str_len(dkey));
    patra_bind_int(st, 1, version);
    patra_bind_int(st, 2, at);
    patra_bind_text(st, 3, str_data(doc), str_len(doc));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return 0; }
    return 1;
}

# Keep `doc` as `dkey`'s newest version, unless it already is, and let the oldest go past the cap.
# 1, or 0 when it could not be kept, which refuses the write it was for. The caller holds the store
# lock.
fn _agnostic_def_version_keep_locked_a(a, dkey: Str, doc: Str): i64 {
    var newest = _agnostic_def_version_newest_locked(dkey);
    if (newest > 0) {
        var last = _agnostic_def_version_doc_locked_a(a, dkey, newest, 0);
        if (last != 0) {
            if (str_eq(last, doc) == 1) { return 1; }
        }
    }
    var next = newest + 1;
    if (_agnostic_def_version_insert_locked(dkey, next, agnostic_epoch_ms(), doc) == 0) { return 0; }
    var gone = next - _agnostic_def_versions_max;
    if (gone < 1) { return 1; }
    # A cap lowered between starts takes every version below it, so this is `<=` and not `=`.
    var db = agnostic_store_db();
    var st = patra_prepare(db, "DELETE FROM agnostic_definition_versions WHERE dkey = ? AND version <= ?");
    if (st == 0) { return 1; }
    patra_bind_text(st, 0, str_data(dkey), str_len(dkey));
    patra_bind_int(st, 1, gone);
    patra_exec_prepared(db, st);
    patra_finalize(st);
    return 1;
}

# What the row holds, as version 1, when `dkey` has no versions: a definition from before 0.4.2,
# about to be overwritten. 1, or 0 when it could not be kept. The caller holds the store lock.
fn _agnostic_def_version_seed_locked_a(a, dkey: Str): i64 {
    if (_agnostic_def_version_newest_locked(dkey) > 0) { return 1; }
    var doc = _agnostic_def_row_doc_locked_a(a, dkey);
    if (doc == 0) { return 1; }
    return _agnostic_def_version_insert_locked(dkey, 1, 0, doc);
}

# One row of `agnostic_definitions_versions_a`.
enum AgnosticDefVersionOff {
    AGNOSTIC_DV_VERSION = 0;
    AGNOSTIC_DV_AT      = 8;
    AGNOSTIC_DV_DOC     = 16;
    AGNOSTIC_DV_SIZE    = 24;
}

# The versions of `dkey`, newest first, as a vec of `AgnosticDefVersionOff` records in `a`. 0 when
# `a` ran out.
fn agnostic_definitions_versions_a(a, dkey: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_versions_locked_a(a, dkey);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_versions_a`'s body. The caller holds the store lock.
fn _agnostic_definitions_versions_locked_a(a, dkey: Str): i64 {
    var out = vec_new_a(a);
    if (out == 0) { return 0; }
    var db = agnostic_store_db();
    if (db == 0) { return out; }
    var st = patra_prepare(db,
      "SELECT version, saved_at, doc FROM agnostic_definition_versions WHERE dkey = ? ORDER BY version DESC");
    if (st == 0) { return out; }
    patra_bind_text(st, 0, str_data(dkey), str_len(dkey));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return out; }
    var n = patra_result_count(rs);
    var i = 0;
    while (i < n) {
        var r = alloc_via(a, AGNOSTIC_DV_SIZE);
        if (r == 0) { patra_result_free(rs); return 0; }
        store64(r + AGNOSTIC_DV_VERSION, patra_result_get_int(rs, i, 0));
        store64(r + AGNOSTIC_DV_AT, patra_result_get_int(rs, i, 1));
        store64(r + AGNOSTIC_DV_DOC, _agnostic_def_text_a(a, db, rs, i, 2));
        vec_push_a(a, out, r);
        i = i + 1;
    }
    patra_result_free(rs);
    return out;
}

# A row's version number.
fn agnostic_def_version_no(r): i64 { return load64(r + AGNOSTIC_DV_VERSION); }

# When a row was saved, in epoch ms, or 0 when nobody knows.
fn agnostic_def_version_at(r): i64 { return load64(r + AGNOSTIC_DV_AT); }

# A row's document.
fn agnostic_def_version_doc(r): i64 { return load64(r + AGNOSTIC_DV_DOC); }

# Version `version` of `dkey`: its document, in `a`, or 0. `out_at` as
# `_agnostic_def_version_doc_locked_a` has it.
fn agnostic_definitions_version_a(a, dkey: Str, version, out_at): i64 {
    agnostic_store_lock();
    var r = _agnostic_def_version_doc_locked_a(a, dkey, version, out_at);
    agnostic_store_unlock();
    return r;
}

# Stored document `doc` as a definition for a reader, in `a`, or 0 when it no longer decodes.
fn agnostic_definition_from_doc_a(a, doc: Str): i64 {
    if (doc == 0) { return 0; }
    var v = bayan_json_v_parse_buf_a(a, str_data(doc), str_len(doc));
    if (v == 0) { return 0; }
    var reject: i64[1];
    store64(&reject, 0);
    return agnostic_agent_def_decode_in_a(a, a, v, 0 - 1, &reject);
}

# Put a definition in the cache, if there is room. Never fails a caller.
# The caller holds the store lock, which is what guards the cache.
fn _agnostic_def_cache_put(key: Str, d): i64 {
    agnostic_definitions_init();
    if (map_size(_agnostic_def_cache) < AGNOSTIC_DEFINITIONS_MAX) {
        map_set(_agnostic_def_cache, str_clone(key), d);
    }
    return 0;
}

# Store a definition under a key that must not already exist.
#
# ⚠ **Never an upsert.** `POST` to an existing key is a 409, because an upsert
# turns a typo'd key into a second silently-created definition.
fn agnostic_definitions_create(key: Str, def): i64 {
    return agnostic_definitions_create_a(default_alloc(), key, def);
}

# `agnostic_definitions_create`, with what the write builds in `a`.
fn agnostic_definitions_create_a(a, key: Str, def): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_create_locked_a(a, key, def);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_create`'s body. The caller holds the store lock, so the
# existence check and the insert are one step: of two racing creates of one key,
# exactly one inserts and the other is told EXISTS.
fn _agnostic_definitions_create_locked_a(a, key: Str, def): i64 {
    if (key == 0 || def == 0) { return AGNOSTIC_DEF_MISSING; }
    var db = agnostic_store_db();
    if (db == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_row_exists_locked(key) == 1) { return AGNOSTIC_DEF_EXISTS; }

    var doc = _agnostic_def_document_a(a, def);
    if (doc == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_version_keep_locked_a(a, key, doc) == 0) { return AGNOSTIC_DEF_MISSING; }

    var st = patra_prepare(db,
      "INSERT INTO agnostic_definitions (dkey, doc) VALUES (?, ?)");
    if (st == 0) { return AGNOSTIC_DEF_MISSING; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    patra_bind_text(st, 1, str_data(doc), str_len(doc));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);

    # ⚠ A failed write must NOT be reported as success. patra answers a code;
    # ignoring it is how "created" goes out for a row that is not there — the
    # §3.1 shape, one layer down.
    if (rc == PATRA_ERR_FULL) { return AGNOSTIC_DEF_FULL; }
    if (rc != PATRA_OK) { return AGNOSTIC_DEF_MISSING; }

    _agnostic_def_cache_put(key, def);
    return AGNOSTIC_DEF_OK;
}

# Replace the definition under an existing key. Never creates.
fn agnostic_definitions_replace(key: Str, def): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_replace_locked_a(default_alloc(), key, def);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_replace`'s body, with what the write builds in `a`. The caller holds the
# store lock.
fn _agnostic_definitions_replace_locked_a(a, key: Str, def): i64 {
    if (key == 0 || def == 0) { return AGNOSTIC_DEF_MISSING; }
    var db = agnostic_store_db();
    if (db == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_row_exists_locked(key) == 0) { return AGNOSTIC_DEF_MISSING; }

    var doc = _agnostic_def_document_a(a, def);
    if (doc == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_version_seed_locked_a(a, key) == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_version_keep_locked_a(a, key, doc) == 0) { return AGNOSTIC_DEF_MISSING; }

    var st = patra_prepare(db,
      "UPDATE agnostic_definitions SET doc = ? WHERE dkey = ?");
    if (st == 0) { return AGNOSTIC_DEF_MISSING; }
    patra_bind_text(st, 0, str_data(doc), str_len(doc));
    patra_bind_text(st, 1, str_data(key), str_len(key));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return AGNOSTIC_DEF_MISSING; }

    # The cached record is now wrong; replace it rather than evicting, since the
    # caller is about to render exactly this.
    agnostic_definitions_init();
    map_set(_agnostic_def_cache, str_clone(key), def);
    return AGNOSTIC_DEF_OK;
}

# The definition under this key, or 0.
#
# Cache first, then patra. A row whose document no longer decodes answers 0 —
# see the module header for why that is the right failure.
fn agnostic_definitions_get(key: Str): i64 {
    return agnostic_definitions_get_a(default_alloc(), key);
}

# `agnostic_definitions_get` for a reader in a request. A definition past the cache is decoded
# in `a`, so it lives as long as the request. Each one used to be decoded on the global heap and
# dropped, which leaked 12.8 KB a GET and 778 KB a listing past 256 definitions, to anyone with
# READ permission.
fn agnostic_definitions_get_a(a, key: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_get_locked_a(a, key);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_get`'s body. The caller holds the store lock.
#
# ⚠ **The decode runs under the lock too**, though it touches no handle. Releasing
# between the read and the cache write is exactly the window in which a `replace`
# or `remove` lands and this function then caches what they just superseded.
fn _agnostic_definitions_get_locked_a(a, key: Str): i64 {
    if (key == 0) { return 0; }
    var db = agnostic_store_db();
    if (db == 0) { return 0; }

    agnostic_definitions_init();
    var hit = map_get(_agnostic_def_cache, key);
    if (hit != 0) { return hit; }

    var st = patra_prepare(db,
      "SELECT doc FROM agnostic_definitions WHERE dkey = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    if (patra_result_count(rs) == 0) { patra_result_free(rs); return 0; }

    var len = patra_result_get_text_len(rs, 0, 0);
    if (len <= 0) { patra_result_free(rs); return 0; }
    # The cache keeps what it is given for the life of the process, so a decode it will take goes
    # on the global heap. Past its bound the record is the reader's alone.
    var into = a;
    var cached = 0;
    if (map_size(_agnostic_def_cache) < AGNOSTIC_DEFINITIONS_MAX) {
        into = default_alloc();
        cached = 1;
    }
    var buf = alloc_via(into, len);
    if (buf == 0) { patra_result_free(rs); return 0; }
    if (patra_result_read_text(db, rs, 0, 0, buf) != PATRA_OK) {
        patra_result_free(rs);
        return 0;
    }
    patra_result_free(rs);

    var v = bayan_json_v_parse_buf_a(into, buf, len);
    if (v == 0) { return 0; }
    var reject: i64[1];
    store64(&reject, 0);
    # -1: not inside an `agents` array, so a rejection reads as a document
    # problem rather than as an array index nobody sent.
    var d = agnostic_agent_def_decode_in_a(into, into, v, 0 - 1, &reject);
    if (d == 0) { return 0; }

    if (cached == 1) { _agnostic_def_cache_put(key, d); }
    return d;
}

# ## Revisions (0.1.15)
#
# A definition's revision is its ETag: `"` and the first 16 hex digits of the SHA-256 of its
# canonical document — the rendering this store writes (`agnostic_agent_def_to_value_a`) — and
# `"`, the format plugin documents use, so the shell's bridge carries it unchanged. A `PUT` or
# `DELETE` that sends `If-Match` happens only if the definition is still that revision; `*`
# means "it exists". Until 0.1.15 the Library edited a definition with a last-writer-wins `PUT`,
# so of two editors the second silently undid the first.
#
# Defined over the canonical rendering, not the stored bytes, so a row an older release wrote
# with other spacing has the same revision as the same definition written today.

# The revision of definition `d`, as an ETag Str in `a`, or 0 when `a` is exhausted.
fn agnostic_definition_etag_a(a, d): i64 {
    if (d == 0) { return 0; }
    var v = agnostic_agent_def_to_value_a(a, d);
    if (v == 0) { return 0; }
    var doc = bayan_json_v_build_a(a, v);
    if (doc == 0) { return 0; }
    return agnostic_plugindata_etag_a(a, doc);
}

# Whether `if_match` — an ETag, `*`, or 0 for none — holds for current definition `cur`
# (0 when absent): 1 or 0. A value this server cannot meet does not hold.
fn agnostic_definition_precondition_a(a, cur, if_match: Str): i64 {
    if (if_match == 0) { return 1; }
    if (cur == 0) { return 0; }
    if (str_eq_cstr(if_match, "*") == 1) { return 1; }
    var tag = agnostic_definition_etag_a(a, cur);
    if (tag == 0) { return 0; }
    return str_eq(tag, if_match);
}

# `agnostic_definitions_replace`, only if `if_match` holds (0.1.15): MISSING, PRECONDITION or
# what the replace answers. The check and the write are one critical section, so a write that
# lands between a reader's GET and its PUT is never overwritten unseen.
fn agnostic_definitions_replace_if_a(a, key: Str, def, if_match: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_replace_if_locked_a(a, key, def, if_match);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_replace_if_a`'s body. The caller holds the store lock.
fn _agnostic_definitions_replace_if_locked_a(a, key: Str, def, if_match: Str): i64 {
    if (if_match != 0) {
        var cur = _agnostic_definitions_get_locked_a(a, key);
        if (cur == 0) { return AGNOSTIC_DEF_MISSING; }
        if (agnostic_definition_precondition_a(a, cur, if_match) == 0) { return AGNOSTIC_DEF_PRECONDITION; }
    }
    return _agnostic_definitions_replace_locked_a(a, key, def);
}

# Make version `version` of `dkey` current again, as a new version: `AGNOSTIC_DEF_*`, with the
# definition it wrote through `out_def`. With `if_match`, only if the definition is still that
# revision. A definition that was deleted comes back. Check, read and write are one critical section.
fn agnostic_definitions_rollback_a(a, dkey: Str, version, if_match: Str, out_def): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_rollback_locked_a(a, dkey, version, if_match, out_def);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_rollback_a`'s body. The caller holds the store lock.
#
# ⚠ **The door's check is made again.** A version was accepted under the rules of its day, and it
# is about to run crews under today's, as a definition saved before 0.1.15 with another `complexity`
# would. It answers UNFIT, and nothing changes.
fn _agnostic_definitions_rollback_locked_a(a, dkey: Str, version, if_match: Str, out_def): i64 {
    var cur = _agnostic_definitions_get_locked_a(a, dkey);
    if (if_match != 0 && cur != 0) {
        if (agnostic_definition_precondition_a(a, cur, if_match) == 0) { return AGNOSTIC_DEF_PRECONDITION; }
    }
    if (if_match != 0 && cur == 0) { return AGNOSTIC_DEF_PRECONDITION; }
    var doc = _agnostic_def_version_doc_locked_a(a, dkey, version, 0);
    if (doc == 0) { return AGNOSTIC_DEF_NO_VERSION; }
    var v = bayan_json_v_parse_buf_a(a, str_data(doc), str_len(doc));
    if (v == 0) { return AGNOSTIC_DEF_UNFIT; }
    var reject: i64[1];
    store64(&reject, 0);
    if (agnostic_agent_def_check_a(a, v, 0 - 1, &reject) == 0) { return AGNOSTIC_DEF_UNFIT; }
    # On the global heap, where the definition cache keeps what it is given.
    var d = agnostic_agent_def_decode_a(a, v, 0 - 1, &reject);
    if (d == 0) { return AGNOSTIC_DEF_MISSING; }
    var rc = 0;
    if (cur != 0) { rc = _agnostic_definitions_replace_locked_a(a, dkey, d); }
    else { rc = _agnostic_definitions_create_locked_a(a, dkey, d); }
    if (rc == AGNOSTIC_DEF_OK && out_def != 0) { store64(out_def, d); }
    return rc;
}

# `agnostic_definitions_remove`, only if `if_match` holds (0.1.15): MISSING, PRECONDITION or OK.
fn agnostic_definitions_remove_if_a(a, key: Str, if_match: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_remove_if_locked_a(a, key, if_match);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_remove_if_a`'s body. The caller holds the store lock.
fn _agnostic_definitions_remove_if_locked_a(a, key: Str, if_match: Str): i64 {
    if (if_match != 0) {
        var cur = _agnostic_definitions_get_locked_a(a, key);
        if (cur == 0) { return AGNOSTIC_DEF_MISSING; }
        if (agnostic_definition_precondition_a(a, cur, if_match) == 0) { return AGNOSTIC_DEF_PRECONDITION; }
    }
    return _agnostic_definitions_remove_locked(key);
}

# Remove a definition. Returns OK or MISSING.
fn agnostic_definitions_remove(key: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_remove_locked(key);
    agnostic_store_unlock();
    return r;
}

# `agnostic_definitions_remove`'s body. The caller holds the store lock, so no
# `get` can re-cache the record between the delete and the eviction.
fn _agnostic_definitions_remove_locked(key: Str): i64 {
    if (key == 0) { return AGNOSTIC_DEF_MISSING; }
    var db = agnostic_store_db();
    if (db == 0) { return AGNOSTIC_DEF_MISSING; }
    if (_agnostic_def_row_exists_locked(key) == 0) { return AGNOSTIC_DEF_MISSING; }

    var st = patra_prepare(db, "DELETE FROM agnostic_definitions WHERE dkey = ?");
    if (st == 0) { return AGNOSTIC_DEF_MISSING; }
    patra_bind_text(st, 0, str_data(key), str_len(key));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return AGNOSTIC_DEF_MISSING; }

    agnostic_definitions_init();
    map_delete(_agnostic_def_cache, key);
    return AGNOSTIC_DEF_OK;
}

# A snapshot of every key, as a vec of Str, from the global heap. Answered by patra. For
# callers with no request arena; the listing route uses `agnostic_definitions_keys_a`.
fn agnostic_definitions_keys(): i64 {
    return agnostic_definitions_keys_a(default_alloc());
}

# `agnostic_definitions_keys` in `a` — the vec and every key (0.1.15). The listing ran on
# the global heap, which never frees, so each `GET /api/v1/agents/definitions` kept the vec
# and a copy of every key for the life of the process. 0 when `a` is exhausted.
fn agnostic_definitions_keys_a(a): i64 {
    agnostic_store_lock();
    var r = _agnostic_definitions_keys_locked_a(a);
    agnostic_store_unlock();
    return r;
}

# The row keys of `scope`'s definitions, in `a`. 0 when `a` is exhausted.
#
# Filtered here: patra has one index on the table, and a tenant's keys share a prefix it cannot
# seek to. The whole key list is short, and only this listing reads it.
fn agnostic_definitions_keys_in_a(a, scope: Str): i64 {
    var all = agnostic_definitions_keys_a(a);
    if (all == 0) { return 0; }
    var out = vec_new_a(a);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < vec_len(all)) {
        var k = vec_get(all, i);
        if (_agnostic_definition_in_scope_a(a, k, scope) == 1) { vec_push_a(a, out, k); }
        i = i + 1;
    }
    return out;
}

# `agnostic_definitions_keys_a`'s body. The caller holds the store lock.
fn _agnostic_definitions_keys_locked_a(a): i64 {
    var out = vec_new_a(a);
    if (out == 0) { return 0; }
    var db = agnostic_store_db();
    if (db == 0) { return out; }
    var rs = patra_query(db, "SELECT dkey FROM agnostic_definitions");
    if (rs == 0) { return out; }
    var n = patra_result_count(rs);
    var i = 0;
    while (i < n) {
        var p = patra_result_get_str(rs, i, 0);
        var l = patra_result_get_str_len(rs, i, 0);
        # ⛔ COPY, not `str_new` — which borrows. `p` points into `rs`, freed two
        # lines down. Until 0.1.5 every key here dangled: a large result set is
        # unmapped on free, so listing ~300 definitions segfaulted hashing the
        # first key, and a small one is recycled, so a short listing could read
        # another query's bytes and skip entries as "removed".
        if (p != 0 && l > 0) {
            var c = alloc_via(a, l);
            if (c == 0) { patra_result_free(rs); return 0; }
            memcpy(c, p, l);
            vec_push_a(a, out, str_new_a(a, c, l));
        }
        i = i + 1;
    }
    patra_result_free(rs);
    return out;
}

# --- an agent named in a crew's body (0.4.0, ADR 0030) ------------------------------------------

# The fields of an element of `agents` that names a stored definition.
fn agnostic_agent_ref_fields_a(a): i64 {
    var f = agnostic_fields_a(a);
    agnostic_field_req_a(a, f, "definition", AGNOSTIC_FK_STRING);
    return f;
}

# The stored definition the reference `ag` names, as the JSON a crew's agent is decoded from. 0
# with a rejection stored.
#
# ⚠ **Read here, and copied into the crew.** From here the definition takes the same check and
# decoder as one spelled out, and a crew runs what its definition said when it was accepted: a
# later edit changes the next crew, not this one. A definition saved before 0.1.15 with another
# `complexity` is refused until it is given one of the three, as any door refuses it.
#
# Another tenant's definition is one that is not there, as every read of a definition answers it.
fn _agnostic_crew_agent_ref_a(a, ag, index, scope: Str, out): i64 {
    var allowed = agnostic_agent_ref_fields_a(a);
    var unknown = agnostic_unknown_field(ag, allowed);
    if (unknown != 0) {
        var sb = str_builder_new_a(a);
        if (sb == 0) { return _agnostic_ad_reject(a, out, index, AGNOSTIC_HTTP_UNPROCESSABLE, unknown); }
        str_builder_add_cstr_a(a, sb, "'definition' names a stored agent and takes no other field: '");
        str_builder_add_a(a, sb, unknown);
        str_builder_add_cstr_a(a, sb, "'");
        return _agnostic_ad_reject(a, out, index, AGNOSTIC_HTTP_UNPROCESSABLE, str_builder_build_a(a, sb));
    }
    var bad = agnostic_field_bad(ag, allowed);
    if (bad != 0) {
        return _agnostic_ad_reject(a, out, index, agnostic_field_status(bad), agnostic_field_refusal_a(a, bad));
    }
    var key = agnostic_req_str(ag, AGNOSTIC_JK_DEFINITION);
    if (agnostic_key_is_valid(key) == 0) {
        return _agnostic_ad_reject(a, out, index, HTTP_BAD_REQUEST,
          str_from_a(a, "'definition' must match [a-z0-9][a-z0-9-]* and be at most 100 characters"));
    }
    var dkey = agnostic_definition_dkey_a(a, scope, key);
    var d = 0;
    if (dkey != 0) { d = agnostic_definitions_get_a(a, dkey); }
    if (d == 0) {
        var sm = str_builder_new_a(a);
        if (sm == 0) { return _agnostic_ad_reject(a, out, index, AGNOSTIC_HTTP_UNPROCESSABLE, key); }
        str_builder_add_cstr_a(a, sm, "no agent definition is stored as '");
        str_builder_add_a(a, sm, key);
        str_builder_add_cstr_a(a, sm, "'");
        return _agnostic_ad_reject(a, out, index, AGNOSTIC_HTTP_UNPROCESSABLE, str_builder_build_a(a, sm));
    }
    return agnostic_agent_def_to_value_a(a, d);
}

# Whether element `ag` of a crew's `agents` names a stored definition.
fn _agnostic_crew_agent_is_ref(ag): i64 {
    if (bayan_json_v_is_obj(ag) != 1) { return 0; }
    if (bayan_json_v_obj_get_by_str(ag, AGNOSTIC_JK_DEFINITION) == 0) { return 0; }
    return 1;
}

# The `agents` the crew body `v` asks for, in `a`, with each `{"definition": "<key>"}` replaced by
# the stored definition it names in `scope` — what `agnostic_crew_req_from_value_a` reads. A crew
# names one so that a client does not read a definition to send it back.
#
# Answers 0 with nothing stored when no element is a reference, which leaves the decoder reading the
# body, as it does when `agents` is not an array it would accept: an array past the cap is the
# decoder's to refuse, and must not cost a read of the store per element first. 0 with a rejection
# stored when a reference is refused.
#
# A body with a `team` (0.4.2) answers what the team becomes.
fn agnostic_crew_agents_resolve_a(a, v, scope: Str, out): i64 {
    if (bayan_json_v_is_obj(v) != 1) { return 0; }
    var given = bayan_json_v_obj_get_by_cstr(v, "agents");
    var team = bayan_json_v_obj_get_by_str(v, AGNOSTIC_JK_TEAM);
    # Both, or a `team` that is not an object, are the decoder's to refuse, after its rows.
    if (given == 0 && bayan_json_v_is_obj(team) == 1) { return agnostic_crew_team_agents_a(a, team, scope, out); }
    if (given == 0 || bayan_json_v_is_arr(given) != 1) { return 0; }
    var n = bayan_json_v_arr_len(given);
    if (n > AGNOSTIC_REQ_MAX_AGENTS) { return 0; }
    var any = 0;
    var i = 0;
    while (i < n) {
        if (_agnostic_crew_agent_is_ref(bayan_json_v_arr_get(given, i)) == 1) { any = 1; }
        i = i + 1;
    }
    if (any == 0) { return 0; }
    var arr = bayan_json_v_arr_new_a(a);
    if (arr == 0) { return _agnostic_reject(a, out, HTTP_INTERNAL, str_from_a(a, "could not read the agents")); }
    i = 0;
    while (i < n) {
        var ag = bayan_json_v_arr_get(given, i);
        if (_agnostic_crew_agent_is_ref(ag) == 1) {
            ag = _agnostic_crew_agent_ref_a(a, ag, i, scope, out);
            if (ag == 0) { return 0; }
        }
        if (bayan_json_v_arr_push_a(a, arr, ag) < 0) {
            return _agnostic_reject(a, out, HTTP_INTERNAL, str_from_a(a, "could not read the agents"));
        }
        i = i + 1;
    }
    return arr;
}
