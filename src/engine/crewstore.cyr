# agnostic/engine/crewstore — crew outcomes that survive the process.
#
# ## ⚠ Only TERMINAL outcomes are written, and that is the whole design
#
# A crew runs on a detached thread. When the process dies, that thread dies with
# it — so a crew that was PENDING or RUNNING at the moment of death is not
# "resumable", it is simply **gone**. Persisting non-terminal state would mean
# loading, on the next start, a crew that claims to be running and never will be:
# a poller would wait on it forever, and the ledger's terminal latch could never
# correct it because the wrong value would be latched first.
#
# Writing only COMPLETED / FAILED / CANCELLED removes the problem rather than
# guarding it. There is no stale "running" to load because one is never written.
# What that costs is honest and small: a crew interrupted mid-flight answers 404
# after a restart, which is true — nothing ran it to completion and no outcome
# exists.
#
# ## The stored document is the wire form, served verbatim
#
# Same choice as `src/engine/definitions.cyr`, for the same reasons, plus one
# more: reconstructing an outcome record from JSON would mean rebuilding the
# engine's task-result objects, and a lossy rebuild of a *result* is worse than
# no rebuild at all. On a ledger miss the stored bytes go out as they were
# written — the response a caller would have got from the run that produced them.
#
# ## One table, one index, one database
#
# Shares `src/engine/store.cyr`'s handle with the definition table. patra allows
# 63 tables and exactly **one index each**, so `crew_id` gets it — the only
# column anything looks up by.

var AGNOSTIC_CREW_TABLE_SQL =
"CREATE TABLE agnostic_crews (crew_id STR, cname STR, cstatus INT, doc TEXT)";
var AGNOSTIC_CREW_INDEX_SQL = "CREATE INDEX ON agnostic_crews (crew_id)";

# ## The crew index — what the listing reads (0.1.9)
#
# `GET /api/v1/crews` lists a tenant's crews, and the outcome table cannot serve it: its
# one index is `crew_id`, and its rows hold the whole outcome document. So each terminal
# crew also gets one small row here — who it belongs to, its name and status, when it
# was accepted, started and finished, how many tasks, the engine mode, tokens and cost —
# indexed on `scope`, the column the listing selects by. patra answers an index lookup
# matching 1024 rows or more by scanning instead, so a tenant with many crews costs a
# scan, never a truncated answer.
#
# Written beside the outcome row, under the same lock, once. A crew persisted before
# 0.1.9 has no index row: it is not listed, though `GET /crews/{id}` still answers it.
# (The literal continues onto a second line; the newline it keeps is whitespace to SQL.)
var AGNOSTIC_CREW_IDX_TABLE_SQL =
"CREATE TABLE agnostic_crew_index (crew_id STR, scope STR, cname TEXT, cstatus INT, \
submitted INT, started INT, finished INT, ntasks INT, mode STR, tokens INT, cost INT)";
var AGNOSTIC_CREW_IDX_INDEX_SQL = "CREATE INDEX ON agnostic_crew_index (scope)";

# One crew as the listing shows it — a durable index row, or a ledger entry rendered the
# same way. Built by `agnostic_crew_row_new_a`.
enum AgnosticCrewRowOff {
    AGNOSTIC_CR_CREW_ID   = 0;
    AGNOSTIC_CR_SCOPE     = 8;
    AGNOSTIC_CR_NAME      = 16;
    AGNOSTIC_CR_STATUS    = 24;
    AGNOSTIC_CR_SUBMITTED = 32;   # epoch ms
    AGNOSTIC_CR_STARTED   = 40;   # epoch ms, or 0
    AGNOSTIC_CR_FINISHED  = 48;   # epoch ms, or 0
    AGNOSTIC_CR_NTASKS    = 56;   # tasks submitted, or -1 when not known
    AGNOSTIC_CR_MODE      = 64;   # Str, or 0
    AGNOSTIC_CR_TOKENS    = 72;   # total tokens metered, or -1 when not known
    AGNOSTIC_CR_COST      = 80;   # micro-USD, or -1 when no task was priced
    AGNOSTIC_CR_SIZE      = 88;
}

# A crew row in `a`, every field empty: times 0, counts -1.
fn agnostic_crew_row_new_a(a): i64 {
    var r = alloc_via(a, AGNOSTIC_CR_SIZE);
    if (r == 0) { return 0; }
    memset(r, 0, AGNOSTIC_CR_SIZE);
    store64(r + AGNOSTIC_CR_NTASKS, 0 - 1);
    store64(r + AGNOSTIC_CR_TOKENS, 0 - 1);
    store64(r + AGNOSTIC_CR_COST, 0 - 1);
    return r;
}

# A row's fields. Offsets are public so the listing can fill rows it builds itself.
fn agnostic_crew_row_get(r, off): i64 { return load64(r + off); }

# Set a row's field.
fn agnostic_crew_row_set(r, off, v): i64 { store64(r + off, v); return r; }

# Ensure the schema. Mount time only. Returns 1 when it is in place.
fn agnostic_crews_ensure(): i64 {
    if (agnostic_store_ensure(AGNOSTIC_CREW_TABLE_SQL) == 0) { return 0; }
    if (agnostic_store_ensure(AGNOSTIC_CREW_INDEX_SQL) == 0) { return 0; }
    if (agnostic_store_ensure(AGNOSTIC_CREW_IDX_TABLE_SQL) == 0) { return 0; }
    if (agnostic_store_ensure(AGNOSTIC_CREW_IDX_INDEX_SQL) == 0) { return 0; }
    return 1;
}

# Whether a crew already has a stored row. The caller holds the store lock.
fn _agnostic_crews_exists_locked(crew_id: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db, "SELECT crew_id FROM agnostic_crews WHERE crew_id = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(crew_id), str_len(crew_id));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    patra_result_free(rs);
    if (n > 0) { return 1; }
    return 0;
}

# Persist a terminal crew outcome. Returns 1 when it was written.
#
# ⚠ **Refuses a non-terminal status outright** rather than trusting the caller.
# `agnostic_ledger_latch` is the only caller today and only calls on a terminal
# latch, but the guard is what makes the module header's claim true for every
# future caller as well.
#
# ⚠ A row is written **once**. A crew reaching a terminal state twice is not a
# thing the latch permits, and re-writing would mean the second answer wins —
# which is the ordering `ORACLE-AUDIT.md` §3.4 got wrong. An existing row stands.
# (One exception, which changes no status: `agnostic_crews_resave_row`, 0.1.10.)
fn agnostic_crews_save(crew_id: Str, name: Str, status, doc: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_crews_save_locked(crew_id, name, status, doc);
    agnostic_store_unlock();
    return r;
}

# `agnostic_crews_save`'s body. The caller holds the store lock, so
# "already stored?" and the insert are one step — a row is written once even
# when two threads race to write it.
fn _agnostic_crews_save_locked(crew_id: Str, name: Str, status, doc: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    if (crew_id == 0 || doc == 0) { return 0; }
    if (agnostic_status_is_terminal(status) == 0) { return 0; }
    if (_agnostic_crews_exists_locked(crew_id) == 1) { return 0; }

    var nm = name;
    if (nm == 0) { nm = str_from(""); }

    var st = patra_prepare(db,
      "INSERT INTO agnostic_crews (crew_id, cname, cstatus, doc) VALUES (?, ?, ?, ?)");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(crew_id), str_len(crew_id));
    patra_bind_text(st, 1, str_data(nm), str_len(nm));
    patra_bind_int(st, 2, status);
    patra_bind_text(st, 3, str_data(doc), str_len(doc));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);

    # ⚠ A failed write must not read as success — the same rule the definition
    # store follows. The caller counts the failure; the outcome is simply not
    # durable, and a poll after a restart will 404 rather than lie.
    if (rc != PATRA_OK) { return 0; }
    return 1;
}

# Persist a terminal crew outcome AND its index row (0.1.9) — `row` carries the crew's
# id, scope, name, status, times, task count, mode, tokens and cost. One critical
# section, so a crew is never listed without its outcome or stored without its row.
# Returns 1 when written; 0 when the status is not terminal, the crew is already stored
# (a row is written once — see `agnostic_crews_save`), or a write failed.
fn agnostic_crews_save_row(row, doc: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_crews_save_row_locked(row, doc);
    agnostic_store_unlock();
    return r;
}

# `agnostic_crews_save_row`'s body. The caller holds the store lock.
fn _agnostic_crews_save_row_locked(row, doc: Str): i64 {
    if (row == 0) { return 0; }
    var crew_id = agnostic_crew_row_get(row, AGNOSTIC_CR_CREW_ID);
    var status = agnostic_crew_row_get(row, AGNOSTIC_CR_STATUS);
    if (_agnostic_crews_save_locked(crew_id, agnostic_crew_row_get(row, AGNOSTIC_CR_NAME), status, doc) == 0) {
        return 0;
    }
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var scope = agnostic_crew_row_get(row, AGNOSTIC_CR_SCOPE);
    if (scope == 0) { scope = AGNOSTIC_SCOPE_DEFAULT; }
    var nm = agnostic_crew_row_get(row, AGNOSTIC_CR_NAME);
    if (nm == 0) { nm = str_from(""); }
    var mode = agnostic_crew_row_get(row, AGNOSTIC_CR_MODE);
    if (mode == 0) { mode = str_from(""); }
    var st = patra_prepare(db, "INSERT INTO agnostic_crew_index \
(crew_id, scope, cname, cstatus, submitted, started, finished, ntasks, mode, tokens, cost) \
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(crew_id), str_len(crew_id));
    patra_bind_text(st, 1, str_data(scope), str_len(scope));
    patra_bind_text(st, 2, str_data(nm), str_len(nm));
    patra_bind_int(st, 3, status);
    patra_bind_int(st, 4, agnostic_crew_row_get(row, AGNOSTIC_CR_SUBMITTED));
    patra_bind_int(st, 5, agnostic_crew_row_get(row, AGNOSTIC_CR_STARTED));
    patra_bind_int(st, 6, agnostic_crew_row_get(row, AGNOSTIC_CR_FINISHED));
    patra_bind_int(st, 7, agnostic_crew_row_get(row, AGNOSTIC_CR_NTASKS));
    patra_bind_text(st, 8, str_data(mode), str_len(mode));
    patra_bind_int(st, 9, agnostic_crew_row_get(row, AGNOSTIC_CR_TOKENS));
    patra_bind_int(st, 10, agnostic_crew_row_get(row, AGNOSTIC_CR_COST));
    # The outcome is stored even if its row is not: the crew is durable and readable by
    # id, just not listed — the honest degradation, never a lost outcome. So the index
    # write's own result does not change the answer.
    patra_exec_prepared(db, st);
    patra_finalize(st);
    return 1;
}

# Rewrite a CANCELLED crew's stored outcome and its index row's tokens and cost, once its
# results have arrived (0.1.10) — the single exception to "a row is written once", and it
# exists for the single exception the ledger's latch makes: a crew cancelled while tasks
# ran is latched CANCELLED with no results, then takes the results of the tasks that
# finished (`agnostic_ledger_latch`). Its status does not change, so neither does the
# row's. A crew stored with no row yet (the first write failed) is written now instead.
# Returns 1 when written; 0 when the status is not CANCELLED or a write failed.
fn agnostic_crews_resave_row(row, doc: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_crews_resave_row_locked(row, doc);
    agnostic_store_unlock();
    return r;
}

# `agnostic_crews_resave_row`'s body. The caller holds the store lock.
fn _agnostic_crews_resave_row_locked(row, doc: Str): i64 {
    if (row == 0 || doc == 0) { return 0; }
    if (agnostic_crew_row_get(row, AGNOSTIC_CR_STATUS) != AGNOSTIC_CREW_CANCELLED) { return 0; }
    var crew_id = agnostic_crew_row_get(row, AGNOSTIC_CR_CREW_ID);
    if (crew_id == 0) { return 0; }
    if (_agnostic_crews_exists_locked(crew_id) == 0) { return _agnostic_crews_save_row_locked(row, doc); }
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var st = patra_prepare(db, "UPDATE agnostic_crews SET doc = ? WHERE crew_id = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(doc), str_len(doc));
    patra_bind_text(st, 1, str_data(crew_id), str_len(crew_id));
    var rc = patra_exec_prepared(db, st);
    patra_finalize(st);
    if (rc != PATRA_OK) { return 0; }
    # The listing's tokens and cost, as the outcome now has them. As in the first write,
    # the index row's own result does not change the answer.
    var si = patra_prepare(db, "UPDATE agnostic_crew_index SET tokens = ?, cost = ? WHERE crew_id = ?");
    if (si == 0) { return 1; }
    patra_bind_int(si, 0, agnostic_crew_row_get(row, AGNOSTIC_CR_TOKENS));
    patra_bind_int(si, 1, agnostic_crew_row_get(row, AGNOSTIC_CR_COST));
    patra_bind_text(si, 2, str_data(crew_id), str_len(crew_id));
    patra_exec_prepared(db, si);
    patra_finalize(si);
    return 1;
}

# Every durable crew row in `scope`, as a vec of crew rows in `a` — strings COPIED out of
# the result set (0.1.5), which is freed before this returns.
fn agnostic_crews_index_in_a(a, scope: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_crews_index_in_locked_a(a, scope);
    agnostic_store_unlock();
    return r;
}

# A STR column of `rs` copied into `a`, or 0.
fn _agnostic_crews_str_a(a, rs, row, col): i64 {
    var n = patra_result_get_str_len(rs, row, col);
    if (n < 0) { return 0; }
    var buf = alloc_via(a, n + 1);
    if (buf == 0) { return 0; }
    memcpy(buf, patra_result_get_str(rs, row, col), n);
    store8(buf + n, 0);
    return str_new_a(a, buf, n);
}

# `agnostic_crews_index_in_a`'s body. The caller holds the store lock.
fn _agnostic_crews_index_in_locked_a(a, scope: Str): i64 {
    var out = vec_new_a(a);
    if (out == 0 || scope == 0) { return out; }
    var db = agnostic_store_db();
    if (db == 0) { return out; }
    var st = patra_prepare(db, "SELECT crew_id, cname, cstatus, submitted, started, finished, \
ntasks, mode, tokens, cost FROM agnostic_crew_index WHERE scope = ?");
    if (st == 0) { return out; }
    patra_bind_text(st, 0, str_data(scope), str_len(scope));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return out; }
    var n = patra_result_count(rs);
    var i = 0;
    while (i < n) {
        var row = agnostic_crew_row_new_a(a);
        if (row == 0) { break; }
        agnostic_crew_row_set(row, AGNOSTIC_CR_CREW_ID, _agnostic_crews_str_a(a, rs, i, 0));
        agnostic_crew_row_set(row, AGNOSTIC_CR_SCOPE, scope);
        var nl = patra_result_get_text_len(rs, i, 1);
        if (nl > 0) {
            var nb = alloc_via(a, nl);
            if (nb != 0) {
                if (patra_result_read_text(db, rs, i, 1, nb) == PATRA_OK) {
                    agnostic_crew_row_set(row, AGNOSTIC_CR_NAME, str_new_a(a, nb, nl));
                }
            }
        }
        agnostic_crew_row_set(row, AGNOSTIC_CR_STATUS, patra_result_get_int(rs, i, 2));
        agnostic_crew_row_set(row, AGNOSTIC_CR_SUBMITTED, patra_result_get_int(rs, i, 3));
        agnostic_crew_row_set(row, AGNOSTIC_CR_STARTED, patra_result_get_int(rs, i, 4));
        agnostic_crew_row_set(row, AGNOSTIC_CR_FINISHED, patra_result_get_int(rs, i, 5));
        agnostic_crew_row_set(row, AGNOSTIC_CR_NTASKS, patra_result_get_int(rs, i, 6));
        var mode = _agnostic_crews_str_a(a, rs, i, 7);
        if (mode != 0) {
            if (str_len(mode) > 0) { agnostic_crew_row_set(row, AGNOSTIC_CR_MODE, mode); }
        }
        agnostic_crew_row_set(row, AGNOSTIC_CR_TOKENS, patra_result_get_int(rs, i, 8));
        agnostic_crew_row_set(row, AGNOSTIC_CR_COST, patra_result_get_int(rs, i, 9));
        if (agnostic_crew_row_get(row, AGNOSTIC_CR_CREW_ID) != 0) { vec_push_a(a, out, row); }
        i = i + 1;
    }
    patra_result_free(rs);
    return out;
}

# The stored outcome document for a crew, as a Str, or 0.
#
# Allocated in `a` — the bytes are rendered into this request's response and
# nothing holds them afterwards, which is the difference from the definition
# store's decode cache.
fn agnostic_crews_doc_a(a, crew_id: Str): i64 {
    agnostic_store_lock();
    var r = _agnostic_crews_doc_locked_a(a, crew_id);
    agnostic_store_unlock();
    return r;
}

# `agnostic_crews_doc_a`'s body. The caller holds the store lock.
fn _agnostic_crews_doc_locked_a(a, crew_id: Str): i64 {
    var db = agnostic_store_db();
    if (db == 0 || crew_id == 0) { return 0; }

    var st = patra_prepare(db, "SELECT doc FROM agnostic_crews WHERE crew_id = ?");
    if (st == 0) { return 0; }
    patra_bind_text(st, 0, str_data(crew_id), str_len(crew_id));
    var rs = patra_query_prepared(db, st);
    patra_finalize(st);
    if (rs == 0) { return 0; }
    if (patra_result_count(rs) == 0) { patra_result_free(rs); return 0; }

    var len = patra_result_get_text_len(rs, 0, 0);
    if (len <= 0) { patra_result_free(rs); return 0; }
    var buf = alloc_via(a, len);
    if (buf == 0) { patra_result_free(rs); return 0; }
    if (patra_result_read_text(db, rs, 0, 0, buf) != PATRA_OK) {
        patra_result_free(rs);
        return 0;
    }
    patra_result_free(rs);
    return str_new_a(a, buf, len);
}

# How many terminal outcomes are stored.
fn agnostic_crews_count(): i64 {
    agnostic_store_lock();
    var r = _agnostic_crews_count_locked();
    agnostic_store_unlock();
    return r;
}

# `agnostic_crews_count`'s body. The caller holds the store lock.
fn _agnostic_crews_count_locked(): i64 {
    var db = agnostic_store_db();
    if (db == 0) { return 0; }
    var rs = patra_query(db, "SELECT crew_id FROM agnostic_crews");
    if (rs == 0) { return 0; }
    var n = patra_result_count(rs);
    patra_result_free(rs);
    return n;
}

# Drop every stored outcome. For tests.
fn agnostic_crews_reset(): i64 {
    agnostic_store_lock();
    var db = agnostic_store_db();
    if (db != 0) {
        patra_exec(db, "DELETE FROM agnostic_crews");
        patra_exec(db, "DELETE FROM agnostic_crew_index");
    }
    agnostic_store_unlock();
    return 0;
}
