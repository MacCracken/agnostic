# agnostic/engine/ledger — what Agnostic remembers about the crews it submitted.
#
# ## Why a ledger exists at all
#
# 202-then-poll means the client asks about a crew *later*, and "later" is when
# two engine behaviours become visible that a blocking call never sees.
#
# **1. The engine forgets finished crews.** `_agnosai_orch_evict_locked`
# (`lib/agnosai.cyr:32110`) drops **every finished crew** from the registry once
# it holds `AGNOSAI_MAX_RETAINED_CREWS` (1000). After that
# `agnosai_orchestrator_crew` answers 0 — the same 0 it answers for an id that
# never existed. Without a ledger, a crew that completed successfully and a crew
# that was never submitted are the same 404, and the client cannot tell "your
# results expired" from "you typo'd the id".
#
# **2. One engine failure never reaches the registry at all.** When
# `agnosai_crew_runner_run` returns 0 — the cyclic-DAG arm —
# `_agnosai_orch_finish_err` deletes the cancel flag and returns without
# touching the crew map, which `_agnosai_orch_register` has already seeded with
# **PENDING**. On the blocking path the caller sees the 0 and reports a 500. On
# the *submit* path `_agnosai_orch_submit_thread` discards the return value, so
# the registry keeps saying `pending` for a crew that has definitively failed —
# forever. Agnostic closes that at the front door by rejecting a cyclic graph
# before submitting (see `agnostic_crew_submit`), and the ledger is the belt to
# that pair of braces.
#
# ## The latch, and why it is the whole point
#
# `ORACLE-AUDIT.md` §3.4: three failure paths wrote a terminal `failed` and then
# returned an empty sentinel, which the caller read as a result set, which the
# aggregator's vacuous `all()` turned back into `completed`. A terminal state was
# overwritten by a later, wronger one.
#
# `agnostic_ledger_latch` **refuses to write over a terminal status**. Not "is
# careful not to" — refuses, in one guard, at the only place a status is stored.
# Terminal states stay terminal because there is no code path that can move one.
#
# ## ⚠ Bounded, because `lib/alloc.cyr` has no `free()`
#
# Everything here is global-allocated and never released, so every collection is
# capped: `AGNOSTIC_LEDGER_MAX` entries, `AGNOSTIC_LEDGER_MAX_EVENTS` progress
# events per entry. The entry cap is deliberately **larger than the engine's
# 1000** — a ledger that evicted first would lose exactly the latched outcomes it
# exists to preserve, which is the one thing it must not do.

# One submitted crew — 64 bytes.
enum AgnosticLedgerEntryOff {
    AGNOSTIC_LE_CREW_ID = 0;
    AGNOSTIC_LE_NAME    = 8;
    AGNOSTIC_LE_STATUS  = 16;
    AGNOSTIC_LE_ERROR   = 24;
    AGNOSTIC_LE_RESULTS = 32;
    AGNOSTIC_LE_SUB     = 40;
    AGNOSTIC_LE_EVENTS  = 48;
    AGNOSTIC_LE_DROPPED = 56;
    AGNOSTIC_LE_SIZE    = 64;
}

# How many submitted crews the ledger retains.
#
# ⚠ **Must stay above `AGNOSAI_MAX_RETAINED_CREWS` (1000).** See the module
# header: the ledger's job is to still hold an outcome after the engine has
# dropped it, and a smaller cap would invert that.
var AGNOSTIC_LEDGER_MAX = 1024;

# How many progress events one crew retains. Beyond this the oldest are dropped
# and counted, never silently discarded — see `agnostic_ledger_dropped`.
var AGNOSTIC_LEDGER_MAX_EVENTS = 256;

# Str-keyed map of crew id to entry. Built at mount, mutated under the mutex.
var _agnostic_ledger = 0;

# The lock guarding `_agnostic_ledger` and every entry's mutable fields.
#
# ⚠ **Pool workers run handlers concurrently**, so submit and poll genuinely race
# — two clients polling the same crew, or a poll racing the submit that created
# it. One coarse lock is correct and, at a route table this size, cheap. It is
# never held across a call into the orchestrator, which takes a lock of its own;
# the engine never takes this one, so there is no cycle in either direction.
var _agnostic_ledger_mutex = 0;

# Prepare the ledger. Mount time only, before any worker exists.
fn agnostic_ledger_init(): i64 {
    if (_agnostic_ledger == 0) { _agnostic_ledger = map_new_str(); }
    if (_agnostic_ledger_mutex == 0) { _agnostic_ledger_mutex = mutex_new(); }
    return 1;
}

# Drop every entry. For tests — the server initialises once at mount.
fn agnostic_ledger_reset(): i64 {
    _agnostic_ledger = map_new_str();
    if (_agnostic_ledger_mutex == 0) { _agnostic_ledger_mutex = mutex_new(); }
    return 0;
}

# How many crews the ledger holds.
fn agnostic_ledger_count(): i64 {
    if (_agnostic_ledger == 0) { return 0; }
    mutex_lock(_agnostic_ledger_mutex);
    var n = map_size(_agnostic_ledger);
    mutex_unlock(_agnostic_ledger_mutex);
    return n;
}

# Whether a status is one the crew can never leave.
#
# Duplicated from `agnostic_outcome_is_terminal` rather than shared because that
# one takes an outcome record and this one takes a bare status — and the guard
# in `agnostic_ledger_latch` must read the *stored* status, before any outcome
# exists to wrap it.
fn agnostic_status_is_terminal(s): i64 {
    if (s == AGNOSTIC_CREW_COMPLETED) { return 1; }
    if (s == AGNOSTIC_CREW_FAILED)    { return 1; }
    if (s == AGNOSTIC_CREW_CANCELLED) { return 1; }
    return 0;
}

# Drop terminal entries when the ledger is at capacity. The caller holds the lock.
#
# Only **terminal** entries go, so a ledger full of running crews grows past the
# cap rather than forgetting live work — the same judgement
# `_agnosai_orch_evict_locked` makes, for the same reason: the cap bounds memory,
# not work.
#
# ⚠ This is the one place a latched outcome can be lost. A client that polls
# promptly always gets its answer; one that waits out 1024 further submissions
# gets `unknown`. That is a bounded, honest degradation — not a wrong answer.
fn _agnostic_ledger_evict_locked(): i64 {
    if (map_size(_agnostic_ledger) < AGNOSTIC_LEDGER_MAX) { return 0; }
    var keys = map_keys(_agnostic_ledger);
    var evicted = 0;
    var i = 0;
    while (i < vec_len(keys)) {
        var k = vec_get(keys, i);
        var e = map_get(_agnostic_ledger, k);
        if (e != 0) {
            if (agnostic_status_is_terminal(load64(e + AGNOSTIC_LE_STATUS)) == 1) {
                map_delete(_agnostic_ledger, k);
                evicted = evicted + 1;
            }
        }
        i = i + 1;
    }
    return evicted;
}

# Record a crew Agnostic has just submitted, and return its entry.
#
# `crew_id` must be the id the **engine** assigned — Agnostic mints none of its
# own, which is what makes `ORACLE-AUDIT.md` §3.2 unrepresentable here. `sub` is
# the event subscription taken *before* submission, or 0 when progress is not
# being collected.
#
# Global allocator, deliberately: the entry outlives the request that created it,
# which is the entire premise of polling for it later.
fn agnostic_ledger_record(crew_id: Str, name: Str, sub): i64 {
    agnostic_ledger_init();
    var e = alloc(AGNOSTIC_LE_SIZE);
    if (e == 0) { return 0; }
    store64(e + AGNOSTIC_LE_CREW_ID, crew_id);
    store64(e + AGNOSTIC_LE_NAME, name);
    store64(e + AGNOSTIC_LE_STATUS, AGNOSTIC_CREW_PENDING);
    store64(e + AGNOSTIC_LE_ERROR, 0);
    store64(e + AGNOSTIC_LE_RESULTS, 0);
    store64(e + AGNOSTIC_LE_SUB, sub);
    store64(e + AGNOSTIC_LE_EVENTS, vec_new());
    store64(e + AGNOSTIC_LE_DROPPED, 0);

    mutex_lock(_agnostic_ledger_mutex);
    _agnostic_ledger_evict_locked();
    map_set(_agnostic_ledger, str_clone(crew_id), e);
    mutex_unlock(_agnostic_ledger_mutex);
    return e;
}

# The entry for a crew id, or 0 when the ledger never saw it.
#
# ⚠ **0 here means "Agnostic never submitted this", which is a 404.** It does
# NOT mean "the crew finished and the engine forgot it" — that case has an entry
# with a latched terminal status, and the two must not be collapsed. Collapsing
# them is how a successful run becomes indistinguishable from a typo.
fn agnostic_ledger_entry(crew_id: Str): i64 {
    if (_agnostic_ledger == 0) { return 0; }
    mutex_lock(_agnostic_ledger_mutex);
    var e = map_get(_agnostic_ledger, crew_id);
    mutex_unlock(_agnostic_ledger_mutex);
    return e;
}

# The crew id an entry names.
fn agnostic_ledger_crew_id(e): i64 {
    if (e == 0) { return 0; }
    return load64(e + AGNOSTIC_LE_CREW_ID);
}

# The crew name an entry names.
fn agnostic_ledger_name(e): i64 {
    if (e == 0) { return 0; }
    return load64(e + AGNOSTIC_LE_NAME);
}

# The latched status. UNKNOWN for a null entry — never a happy value.
fn agnostic_ledger_status(e): i64 {
    if (e == 0) { return AGNOSTIC_CREW_UNKNOWN; }
    return load64(e + AGNOSTIC_LE_STATUS);
}

# The latched failure reason, or 0.
fn agnostic_ledger_error(e): i64 {
    if (e == 0) { return 0; }
    return load64(e + AGNOSTIC_LE_ERROR);
}

# The latched task results, or 0 when none has been observed.
fn agnostic_ledger_results(e): i64 {
    if (e == 0) { return 0; }
    return load64(e + AGNOSTIC_LE_RESULTS);
}

# How many progress events the bus dropped for this crew.
#
# Two sources, summed: the event bus is lossy under back-pressure (reported by
# `agnosai_event_sub_lagged`), and the retained window is capped. Both are real
# gaps in the stream and a client is told about them rather than shown a
# suspiciously tidy sequence.
fn agnostic_ledger_dropped(e): i64 {
    if (e == 0) { return 0; }
    return load64(e + AGNOSTIC_LE_DROPPED);
}

# The retained progress events as a vec of engine crew events.
fn agnostic_ledger_events(e): i64 {
    if (e == 0) { return 0; }
    return load64(e + AGNOSTIC_LE_EVENTS);
}

# Latch an observed status onto an entry.
#
# **The §3.4 guard, and the only writer of `AGNOSTIC_LE_STATUS` after
# `agnostic_ledger_record`.** Once the stored status is terminal this returns
# without writing anything — a later observation cannot move a `failed` to
# `completed`, because there is no code path that does.
#
# Returns 1 when the write happened, 0 when it was refused.
fn agnostic_ledger_latch(e, status, error, results): i64 {
    if (e == 0) { return 0; }
    mutex_lock(_agnostic_ledger_mutex);
    if (agnostic_status_is_terminal(load64(e + AGNOSTIC_LE_STATUS)) == 1) {
        mutex_unlock(_agnostic_ledger_mutex);
        return 0;
    }
    store64(e + AGNOSTIC_LE_STATUS, status);
    if (error != 0) { store64(e + AGNOSTIC_LE_ERROR, error); }
    if (results != 0) { store64(e + AGNOSTIC_LE_RESULTS, results); }
    mutex_unlock(_agnostic_ledger_mutex);

    # ⚠ **Persisted outside the lock, on the one transition that matters.** This
    # is the single point where a crew becomes terminal — the latch refuses every
    # later write — so it is exactly where durability belongs, and doing it here
    # means no caller has to remember.
    #
    # The patra call is deliberately NOT under `_agnostic_ledger_mutex`: holding
    # our lock across a library that takes its own is how a lock-order hazard
    # gets built. The entry is already updated and the latch is closed, so
    # nothing can change underneath this.
    if (agnostic_status_is_terminal(status) == 1) { _agnostic_ledger_persist(e); }
    return 1;
}

# Write a now-terminal entry to the durable store.
#
# Failure is logged and counted by the store, not raised: a crew that ran
# correctly should not be reported as failed because the disk was full. What it
# costs is that the outcome 404s after a restart, which is true rather than wrong.
fn _agnostic_ledger_persist(e): i64 {
    if (agnostic_store_is_open() == 0) { return 0; }
    var o = agnostic_ledger_outcome_a(default_alloc(), e);
    if (o == 0) { return 0; }
    var doc = bayan_json_v_build(agnostic_outcome_to_value_a(default_alloc(), o));
    if (doc == 0) { return 0; }
    return agnostic_crews_save(agnostic_ledger_crew_id(e), agnostic_ledger_name(e),
      agnostic_outcome_status(o), doc);
}

# Append one event to an entry's bounded window. The caller holds the lock.
#
# At the cap the **oldest** event is dropped and counted. Dropping the newest
# would be cheaper and is wrong: the newest events are the ones describing what
# the crew is doing now, which is what a progress reader is asking for.
fn _agnostic_ledger_push_event_locked(e, ev): i64 {
    var events = load64(e + AGNOSTIC_LE_EVENTS);
    if (vec_len(events) >= AGNOSTIC_LEDGER_MAX_EVENTS) {
        var trimmed = vec_new();
        var i = 1;
        while (i < vec_len(events)) {
            vec_push(trimmed, vec_get(events, i));
            i = i + 1;
        }
        store64(e + AGNOSTIC_LE_EVENTS, trimmed);
        store64(e + AGNOSTIC_LE_DROPPED, load64(e + AGNOSTIC_LE_DROPPED) + 1);
        events = trimmed;
    }
    vec_push(events, ev);
    return 0;
}

# Drain whatever the event bus has queued for this crew into its window.
#
# **Lazy, on demand, once per crew rather than once per request.** The
# subscription is taken at submit and drained here, so a poll costs one
# non-blocking sweep of an already-filled channel — no thread, no subscription
# per request, and no unbounded growth of the sender's subscriber list, which is
# what subscribing per request would produce.
#
# ⚠ `chan_try_recv` keeps draining a **closed** channel until it is empty, so the
# events published just before `agnosai_event_bus_remove` closed it are still
# collected. Only once the channel is closed *and* drained is the subscription
# released, so a finished crew stops being swept on every subsequent poll.
#
# Returns how many events were taken.
fn agnostic_ledger_drain(e): i64 {
    if (e == 0) { return 0; }
    mutex_lock(_agnostic_ledger_mutex);
    var sub = load64(e + AGNOSTIC_LE_SUB);
    if (sub == 0) {
        mutex_unlock(_agnostic_ledger_mutex);
        return 0;
    }

    # Taken before the sweep: the count is cleared by the read, and a gap that
    # opened before these events is still a gap in what the client will see.
    store64(e + AGNOSTIC_LE_DROPPED,
      load64(e + AGNOSTIC_LE_DROPPED) + agnosai_event_sub_lagged(sub));

    var taken = 0;
    while (1 == 1) {
        var ev = agnosai_event_sub_try_recv(sub);
        if (ev == 0) { break; }
        _agnostic_ledger_push_event_locked(e, ev);
        taken = taken + 1;
    }

    # Closed and drained — the crew has finished publishing. Release the
    # subscription so later polls skip the sweep entirely.
    if (agnosai_event_sub_closed(sub) == 1) { store64(e + AGNOSTIC_LE_SUB, 0); }
    mutex_unlock(_agnostic_ledger_mutex);
    return taken;
}

# Build an outcome from an entry's latched state, in `a`.
#
# The read half of the latch: whatever `agnostic_ledger_latch` last accepted,
# rendered as the record every handler branches on. Returns 0 for a null entry
# or an exhausted arena.
fn agnostic_ledger_outcome_a(a, e): i64 {
    if (e == 0) { return 0; }
    mutex_lock(_agnostic_ledger_mutex);
    var status = load64(e + AGNOSTIC_LE_STATUS);
    var error = load64(e + AGNOSTIC_LE_ERROR);
    var results = load64(e + AGNOSTIC_LE_RESULTS);
    var crew_id = load64(e + AGNOSTIC_LE_CREW_ID);
    mutex_unlock(_agnostic_ledger_mutex);
    return agnostic_outcome_new_a(a, crew_id, status, error, results);
}
