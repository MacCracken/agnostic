# agnostic/engine/request — what a crew submission is, and the only way to say it.
#
# ## ⚠ ONE task model — `ORACLE-AUDIT.md` §3.3
#
# The oracle had two. `_translate_crew_config` emitted a real task list only when
# `crew_config["tasks"]` existed, and it never could: `CrewRunRequest` declared no
# `tasks` field, Pydantic defaulted to `extra='ignore'`, and a client-supplied
# `tasks` array was **silently discarded**. So the single-task fallback fired
# every time — AgnosAI received one task holding the raw description with every
# agent attached, while the other backend built a per-agent task envelope. One
# request, two structurally different runs, no error anywhere.
#
# There is exactly one task model here, and three properties keep it that way:
#
#   * `tasks` is **required and non-empty**. A body without it is rejected, not
#     quietly rewritten into something else.
#   * There is **no fallback path**. No description-becomes-a-task, no
#     synthesise-from-agents. The code that would have to exist for a second
#     model does not exist.
#   * An **unlisted key is a 422 naming it** — `agnostic_no_unknown_fields` from
#     `src/http/codec.cyr`, which was built in M1 for precisely this milestone.
#     A client that sends `task` for `tasks` is told so, rather than having its
#     work silently replaced.
#
# ## The dependency graph is validated here, and that is load-bearing
#
# `agnostic_crew_req_has_cycle` is not politeness. `agnosai_crew_runner_run`
# returns 0 on its error arm — a cyclic DAG, or a dependency naming a task the spec
# does not hold — and on that arm `_agnosai_orch_finish_err` stores **no outcome**:
# since agnosai 2.1.5 (its ADR 022) it puts back the PENDING that
# `_agnosai_orch_register` seeded and the run had moved to RUNNING. The blocking
# caller sees the 0 and can report a 500; `_agnosai_orch_submit_thread` discards
# it. Submitting such a graph through the async path therefore produces a crew
# that reports `pending` forever.
#
# Rejecting the cycle here, with every dependency a range-checked index into the
# request's own tasks, makes that arm unreachable through Agnostic — since agnosai
# 2.1.6. Through 2.1.5 a failed branch beside a successful one reached it anyway
# (see `src/engine/ledger.cyr`). `src/engine/ledger.cyr` is the second line for the
# same failure.
#
# ## The agent model lives in `src/engine/agentdef.cyr`
#
# A crew's `agents` array and a stored agent definition are the **same model**,
# decoded by `agnostic_agent_def_decode_a` and by nothing else. This module used
# to carry a second copy; two decoders for one concept is how the two ends drift,
# which is §3.3 restated at the level of a field.
#
# ## Every field is forwarded, retained, or explicitly rejected — never dropped
#
# `ORACLE-AUDIT.md` §2.2 lists fourteen fields the oracle dropped in translation.
# The sharp one is `gpu_strict`, and it deserves care because it is easy to think
# it is covered here. It is not, and it is **not the same field as
# `gpu_required`**: the oracle declares both (`agents/base.py:61-62`) and hard-fails
# only on `gpu_required AND gpu_strict` (`config/gpu_scheduler.py:196`). `required`
# asks for a GPU; `strict` says fail rather than fall back to CPU. The oracle
# forwarded the first and dropped the second, so every hard-fail request became a
# silent CPU fallback.
#
# ⚠ **The Cyrius engine cannot express strictness at all** — `gpu_strict` appears
# zero times in `lib/agnosai.cyr`, `agnosai_agent_with_gpu` takes only
# (required, preferred, memory_min_mb), and `agnosai_agent_hardware_requirement`
# builds accelerators plus a memory floor with no fallback flag. So `gpu_required`,
# `gpu_preferred` and `gpu_memory_min_mb` are forwarded here, and `gpu_strict` is
# **refused** — see `agnostic_agent_def_decode_a` in `src/engine/agentdef.cyr`.
# a caller who needs hard-fail must not be told it was applied.

# The rejection record, the bounds and the typed-field readers this module uses
# all live in `src/engine/reject.cyr` — extracted at M3 so `agentdef.cyr` can
# share them without inverting the include order. See that file's header.

# A decoded crew submission — 40 bytes.
enum AgnosticCrewReqOff {
    AGNOSTIC_CQ_NAME        = 0;
    AGNOSTIC_CQ_PROCESS     = 8;
    AGNOSTIC_CQ_CONCURRENCY = 16;
    AGNOSTIC_CQ_AGENTS      = 24;
    AGNOSTIC_CQ_TASKS       = 32;
    AGNOSTIC_CQ_SIZE        = 40;
}

# A decoded task — 72 bytes. `dependencies` is a vec of **indices into the
# request's task list**, resolved to engine task ids only when the spec is built.
#
# The last four are the task's **selection hints** (0.1.14, ADR 0017): what the
# engine's selector scores each agent against. Each is optional — 0, or
# `AGNOSTIC_REQ_UNSET` for the two integers, when the request left it out.
enum AgnosticTaskReqOff {
    AGNOSTIC_TQ_DESCRIPTION     = 0;
    AGNOSTIC_TQ_EXPECTED_OUTPUT = 8;
    AGNOSTIC_TQ_PRIORITY        = 16;
    AGNOSTIC_TQ_RISK            = 24;
    AGNOSTIC_TQ_DEPENDENCIES    = 32;
    AGNOSTIC_TQ_REQ_TOOLS       = 40;   # vec of tool-name Strs, or 0
    AGNOSTIC_TQ_COMPLEXITY      = 48;   # AGNOSTIC_COMPLEXITY_*, or AGNOSTIC_REQ_UNSET
    AGNOSTIC_TQ_DOMAIN          = 56;   # Str, or 0
    AGNOSTIC_TQ_GPU_REQUIRED    = 64;   # 1, 0, or AGNOSTIC_REQ_UNSET
    AGNOSTIC_TQ_SIZE            = 72;
}

# A task's complexity, as the selector compares it with an agent's (0.1.14, ADR 0017).
var AGNOSTIC_COMPLEXITY_LOW    = 0;
var AGNOSTIC_COMPLEXITY_MEDIUM = 1;
var AGNOSTIC_COMPLEXITY_HIGH   = 2;

# The task-context keys the engine's selector reads (`agnosai_rank_agents`). They are
# the engine's names; agnostic sends them under no other.
var AGNOSTIC_JK_REQ_TOOLS = str_from("required_tools");

# The three spellings, interned at load: the plan renders them on a request path, and a
# `str_from` there kept a 16-byte header per hint on the global heap (0.1.15).
var _AGNOSTIC_CX_LOW    = str_from("low");
var _AGNOSTIC_CX_MEDIUM = str_from("medium");
var _AGNOSTIC_CX_HIGH   = str_from("high");

# The wire spelling of a task complexity. An unknown value answers `low`, the first,
# so the schema's vocabulary walk stops (`src/http/schema.cyr`).
fn agnostic_complexity_to_wire(c): i64 {
    if (c == AGNOSTIC_COMPLEXITY_MEDIUM) { return _AGNOSTIC_CX_MEDIUM; }
    if (c == AGNOSTIC_COMPLEXITY_HIGH)   { return _AGNOSTIC_CX_HIGH; }
    return _AGNOSTIC_CX_LOW;
}

# A task complexity from its wire spelling, or -1 for an unrecognised one.
#
# ⚠ **-1, not the engine's fallback.** agnosai reads any complexity it does not
# recognise as medium (`agnosai_complexity_level`), so a typo'd `"hihg"` would be
# scored as medium and nothing would say so. Here it is a 400 naming the three.
fn agnostic_complexity_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "low") == 1)    { return AGNOSTIC_COMPLEXITY_LOW; }
    if (str_eq_cstr(s, "medium") == 1) { return AGNOSTIC_COMPLEXITY_MEDIUM; }
    if (str_eq_cstr(s, "high") == 1)   { return AGNOSTIC_COMPLEXITY_HIGH; }
    return 0 - 1;
}

# 1 when definition `d`'s own `complexity` is one the selector tells apart — `low`, `medium` or
# `high` — or is unset; 0 for anything else (0.1.15, ADR 0017).
#
# ⚠ **Checked at the door, not in the decoder.** A task's hint has been refused outside the three
# since 0.1.14, but an agent's `complexity` stayed free text, which the engine reads as medium
# without a word. The doors — a crew's `agents` and a definition's `POST` and `PUT` — refuse
# anything else now. The decoder still accepts it, because stored definitions are decoded by the
# same path: one written before 0.1.15 with another value is read as it is, and must be given one
# of the three before it can be saved again or sent in a crew.
fn agnostic_agent_def_complexity_ok(d): i64 {
    var c = agnosai_agent_complexity(agnostic_agent_def_engine(d));
    if (c == 0) { return 1; }
    if (agnostic_complexity_from_wire(c) < 0) { return 0; }
    return 1;
}

# The refusal for an agent whose `complexity` is not one of the three, as `index`'s agent.
fn agnostic_agent_def_complexity_reject_a(a, out, index): i64 {
    return _agnostic_ad_reject(a, out, index, HTTP_BAD_REQUEST,
      str_from_a(a, "'complexity' must be one of low, medium, high"));
}

# The process modes Agnostic accepts on the wire.
var AGNOSTIC_PROCESS_SEQUENTIAL = 0;
var AGNOSTIC_PROCESS_PARALLEL   = 1;
var AGNOSTIC_PROCESS_DAG        = 2;

# The three spellings, interned at load (0.1.15), as the complexity names are.
var _AGNOSTIC_PW_SEQUENTIAL = str_from("sequential");
var _AGNOSTIC_PW_PARALLEL   = str_from("parallel");
var _AGNOSTIC_PW_DAG        = str_from("dag");

# The wire spelling of a process mode.
fn agnostic_process_to_wire(p): i64 {
    if (p == AGNOSTIC_PROCESS_PARALLEL) { return _AGNOSTIC_PW_PARALLEL; }
    if (p == AGNOSTIC_PROCESS_DAG)      { return _AGNOSTIC_PW_DAG; }
    return _AGNOSTIC_PW_SEQUENTIAL;
}

# A process mode from its wire spelling, or -1 for an unrecognised one.
#
# ⚠ **-1, not a default.** `_agnosai_route_process_for` falls back to sequential
# for anything it does not recognise, so a typo'd `"paralell"` runs sequentially
# and nothing says so. That is a silent default of exactly the kind this port
# refuses; an unrecognised mode is a 400 naming it.
#
# `hierarchical` is deliberately absent. The engine accepts the mode, warns
# "hierarchical mode not yet implemented", and runs sequentially  #skip-lint: quotes the engine's own warning
# — so accepting the word here would advertise a mode Agnostic does not have and
# silently give the caller a different one. Tracked as agnosai F2 (roadmap, "Waiting on
# agnosai"); it becomes acceptable the day the engine implements it.
fn agnostic_process_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "sequential") == 1) { return AGNOSTIC_PROCESS_SEQUENTIAL; }
    if (str_eq_cstr(s, "parallel") == 1)   { return AGNOSTIC_PROCESS_PARALLEL; }
    if (str_eq_cstr(s, "dag") == 1)        { return AGNOSTIC_PROCESS_DAG; }
    return 0 - 1;
}

# A task priority from its wire spelling, or -1 for an unrecognised one.
fn agnostic_priority_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "background") == 1) { return AGNOSAI_PRIORITY_BACKGROUND; }
    if (str_eq_cstr(s, "low") == 1)        { return AGNOSAI_PRIORITY_LOW; }
    if (str_eq_cstr(s, "normal") == 1)     { return AGNOSAI_PRIORITY_NORMAL; }
    if (str_eq_cstr(s, "high") == 1)       { return AGNOSAI_PRIORITY_HIGH; }
    if (str_eq_cstr(s, "critical") == 1)   { return AGNOSAI_PRIORITY_CRITICAL; }
    return 0 - 1;
}

# A task risk level from its wire spelling, or -1 for an unrecognised one.
fn agnostic_risk_from_wire(s: Str): i64 {
    if (str_eq_cstr(s, "low") == 1)    { return AGNOSAI_RISK_LOW; }
    if (str_eq_cstr(s, "medium") == 1) { return AGNOSAI_RISK_MEDIUM; }
    if (str_eq_cstr(s, "high") == 1)   { return AGNOSAI_RISK_HIGH; }
    return 0 - 1;
}

# The crew-level allow-list. Every key a submission may carry, and no others.
fn agnostic_crew_req_fields_a(a): i64 {
    var f = agnostic_fields_a(a);
    agnostic_field_a(a, f, "name");
    agnostic_field_a(a, f, "process");
    agnostic_field_a(a, f, "max_concurrency");
    agnostic_field_a(a, f, "agents");
    agnostic_field_a(a, f, "tasks");
    return f;
}

# The task allow-list.
fn agnostic_task_req_fields_a(a): i64 {
    var f = agnostic_fields_a(a);
    agnostic_field_a(a, f, "description");
    agnostic_field_a(a, f, "expected_output");
    agnostic_field_a(a, f, "priority");
    agnostic_field_a(a, f, "risk");
    agnostic_field_a(a, f, "dependencies");
    # The selection hints (0.1.14, ADR 0017).
    agnostic_field_a(a, f, "required_tools");
    agnostic_field_a(a, f, "complexity");
    agnostic_field_a(a, f, "domain");
    agnostic_field_a(a, f, "gpu_required");
    return f;
}

# Accessors for a decoded submission.

# The crew name.
fn agnostic_crew_req_name(r): i64 {
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_CQ_NAME);
}

# The requested process mode.
fn agnostic_crew_req_process(r): i64 {
    if (r == 0) { return AGNOSTIC_PROCESS_SEQUENTIAL; }
    return load64(r + AGNOSTIC_CQ_PROCESS);
}

# The requested parallel concurrency, or AGNOSTIC_REQ_UNSET.
fn agnostic_crew_req_concurrency(r): i64 {
    if (r == 0) { return AGNOSTIC_REQ_UNSET; }
    return load64(r + AGNOSTIC_CQ_CONCURRENCY);
}

# The vec of `AgnosticAgentDef` records the submission carries.
#
# ⚠ Agnostic records, not engine ones — `agnostic_agent_def_engine` unwraps.
# `agnostic_crew_spec_build` does that unwrapping, and it is the only place that
# should: the wrapper is what carries `focus` and `allow_delegation`, and code
# that reaches past it loses them.
fn agnostic_crew_req_agents(r): i64 {
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_CQ_AGENTS);
}

# The vec of decoded task requests.
fn agnostic_crew_req_tasks(r): i64 {
    if (r == 0) { return 0; }
    return load64(r + AGNOSTIC_CQ_TASKS);
}

# A task's description.
fn agnostic_task_req_description(t): i64 {
    if (t == 0) { return 0; }
    return load64(t + AGNOSTIC_TQ_DESCRIPTION);
}

# A task's expected output, or 0.
fn agnostic_task_req_expected_output(t): i64 {
    if (t == 0) { return 0; }
    return load64(t + AGNOSTIC_TQ_EXPECTED_OUTPUT);
}

# A task's priority, or AGNOSTIC_REQ_UNSET.
fn agnostic_task_req_priority(t): i64 {
    if (t == 0) { return AGNOSTIC_REQ_UNSET; }
    return load64(t + AGNOSTIC_TQ_PRIORITY);
}

# A task's risk level, or AGNOSTIC_REQ_UNSET.
fn agnostic_task_req_risk(t): i64 {
    if (t == 0) { return AGNOSTIC_REQ_UNSET; }
    return load64(t + AGNOSTIC_TQ_RISK);
}

# A task's dependency indices as a vec of integers.
fn agnostic_task_req_dependencies(t): i64 {
    if (t == 0) { return 0; }
    return load64(t + AGNOSTIC_TQ_DEPENDENCIES);
}

# A task's required tools as a vec of Strs, or 0 when it named none.
fn agnostic_task_req_required_tools(t): i64 {
    if (t == 0) { return 0; }
    return load64(t + AGNOSTIC_TQ_REQ_TOOLS);
}

# A task's complexity (`AGNOSTIC_COMPLEXITY_*`), or AGNOSTIC_REQ_UNSET.
fn agnostic_task_req_complexity(t): i64 {
    if (t == 0) { return AGNOSTIC_REQ_UNSET; }
    return load64(t + AGNOSTIC_TQ_COMPLEXITY);
}

# A task's domain, or 0.
fn agnostic_task_req_domain(t): i64 {
    if (t == 0) { return 0; }
    return load64(t + AGNOSTIC_TQ_DOMAIN);
}

# Whether a task needs a GPU: 1, 0, or AGNOSTIC_REQ_UNSET.
fn agnostic_task_req_gpu_required(t): i64 {
    if (t == 0) { return AGNOSTIC_REQ_UNSET; }
    return load64(t + AGNOSTIC_TQ_GPU_REQUIRED);
}

# Decode a task's four selection hints onto `t` (0.1.14, ADR 0017). Returns 1, or 0
# with a rejection stored.
#
# What the engine's selector scores each agent of the roster against
# (`agnosai_rank_agents`), and without which it cannot tell agents apart: tool
# coverage, complexity alignment, domain match and GPU capability. Every one is
# checked at the door, because the engine checks none in a way a caller would see:
#
#   * `required_tools`: an array of strings of 1 to `AGNOSTIC_REQ_MAX_HINT` bytes, at most
#     `AGNOSTIC_REQ_MAX_TOOLS` of them. The
#     engine reads an array holding anything but strings as **no requirement** and
#     scores every agent full coverage — a malformed list makes every agent look
#     MORE suitable. An empty array is accepted and means what it says: no
#     requirement. Names are carried verbatim, like an agent's `tools`: there is no
#     tool registry to check them against yet (M6).
#   * `complexity`: `low`, `medium` or `high`. The engine reads anything else as
#     medium, silently.
#   * `domain`: 1 to `AGNOSTIC_REQ_MAX_HINT` bytes, compared case-insensitively with each
#     agent's.
#
# And all four together, rendered as the engine renders a task's context, must fit the
# engine's prompt-input cap — past it the model would see them cut off.
#   * `gpu_required`: a boolean. `"true"` is a 422, as everywhere here.
#
# Global allocator: the hints become the engine task's context, which outlives the
# request.
fn _agnostic_task_req_hints_a(a, v, index, t, out): i64 {
    var tv = bayan_json_v_obj_get_by_str(v, AGNOSTIC_JK_REQ_TOOLS);
    if (tv != 0) {
        if (bayan_json_v_is_null(tv) != 1) {
            if (bayan_json_v_is_arr(tv) != 1) {
                _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
                  "tasks[", index, "]: 'required_tools' must be an array of strings");
                return 0;
            }
            var n = bayan_json_v_arr_len(tv);
            if (n > AGNOSTIC_REQ_MAX_TOOLS) {
                _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
                  "tasks[", index, "]: too many required_tools");
                return 0;
            }
            var tools = vec_new();
            var i = 0;
            while (i < n) {
                var e = bayan_json_v_arr_get(tv, i);
                if (bayan_json_v_is_str(e) != 1) {
                    _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
                      "tasks[", index, "]: 'required_tools' must be an array of strings");
                    return 0;
                }
                var name = bayan_json_v_str(e);
                if (str_len(name) == 0 || str_len(name) > AGNOSTIC_REQ_MAX_HINT) {
                    _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
                      "tasks[", index, "]: each of 'required_tools' must be 1 to 256 bytes");
                    return 0;
                }
                vec_push(tools, str_clone(name));
                i = i + 1;
            }
            store64(t + AGNOSTIC_TQ_REQ_TOOLS, tools);
        }
    }

    var cx = agnostic_opt_str(v, AGNOSTIC_JK_COMPLEXITY, 0 - 1);
    if (cx == 0) {
        _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          "tasks[", index, "]: 'complexity' must be a string");
        return 0;
    }
    if (cx != 0 - 1) {
        var level = agnostic_complexity_from_wire(cx);
        if (level < 0) {
            _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
              "tasks[", index, "]: 'complexity' must be one of low, medium, high");
            return 0;
        }
        store64(t + AGNOSTIC_TQ_COMPLEXITY, level);
    }

    var dom = agnostic_opt_str(v, AGNOSTIC_JK_DOMAIN, 0 - 1);
    if (dom == 0) {
        _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          "tasks[", index, "]: 'domain' must be a string");
        return 0;
    }
    if (dom != 0 - 1) {
        if (str_len(dom) == 0 || str_len(dom) > AGNOSTIC_REQ_MAX_HINT) {
            _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
              "tasks[", index, "]: 'domain' must be 1 to 256 bytes");
            return 0;
        }
        store64(t + AGNOSTIC_TQ_DOMAIN, str_clone(dom));
    }

    var gpu = _agnostic_opt_bool(v, "gpu_required");
    if (gpu == AGNOSTIC_REQ_UNSET - 1) {
        _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          "tasks[", index, "]: 'gpu_required' must be a boolean");
        return 0;
    }
    store64(t + AGNOSTIC_TQ_GPU_REQUIRED, gpu);

    # ⚠ **Measured as the engine will render them.** The hints are the task's context, and
    # agnosai renders the context into the prompt pretty-printed (`_agnosai_crew_build_request`)
    # and then cuts it at `AGNOSAI_MAX_INPUT_LENGTH` with a log warning only — selection would
    # use every hint while the model saw a JSON array cut in half. 64 names of 256 bytes fit
    # unless escaping inflates them, so the rendering itself is what is checked.
    var size = _agnostic_task_req_hints_rendered_len_a(a, t);
    if (size < 0) {
        _agnostic_reject_at(a, out, HTTP_INTERNAL,
          "tasks[", index, "]: could not measure the selection hints");
        return 0;
    }
    if (size > AGNOSAI_MAX_INPUT_LENGTH) {
        _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
          "tasks[", index, "]: the selection hints exceed the engine's 50000-byte context once rendered");
        return 0;
    }
    return 1;
}

# How long task `t`'s selection hints are once rendered as the engine renders a task's
# context — pretty JSON, indent 2 — or 0 when it has none. The JSON is built in `a`; key
# order may differ from the engine's map order, which changes no length.
#
# ⚠ **-1 when `a` ran out, never 0.** 0 means "nothing to render", which passes the cap; an
# exhausted arena reading as 0 would wave through exactly the oversized hints this measures.
fn _agnostic_task_req_hints_rendered_len_a(a, t): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0 - 1; }
    var any = 0;
    var tools = load64(t + AGNOSTIC_TQ_REQ_TOOLS);
    if (tools != 0) {
        var arr = bayan_json_v_arr_new_a(a);
        var i = 0;
        while (i < vec_len(tools)) {
            bayan_json_v_arr_push_a(a, arr, bayan_json_v_str_new_a(a, vec_get(tools, i)));
            i = i + 1;
        }
        bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_REQ_TOOLS, arr);
        any = 1;
    }
    var cx = load64(t + AGNOSTIC_TQ_COMPLEXITY);
    if (cx != AGNOSTIC_REQ_UNSET) {
        bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_COMPLEXITY,
          bayan_json_v_str_new_a(a, agnostic_complexity_to_wire(cx)));
        any = 1;
    }
    var dom = load64(t + AGNOSTIC_TQ_DOMAIN);
    if (dom != 0) {
        bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_DOMAIN, bayan_json_v_str_new_a(a, dom));
        any = 1;
    }
    var gpu = load64(t + AGNOSTIC_TQ_GPU_REQUIRED);
    if (gpu != AGNOSTIC_REQ_UNSET) {
        bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_GPU_REQ, bayan_json_v_bool_new_a(a, gpu));
        any = 1;
    }
    if (any == 0) { return 0; }
    var s = bayan_json_v_build_pretty_a(a, obj, 2);
    if (s == 0) { return 0 - 1; }
    return str_len(s);
}

# Decode one task object.
#
# Global allocator for the same reason `agnostic_agent_def_decode_a` uses it:
# the description and expected output are handed to engine tasks that outlive
# the request.
fn agnostic_task_req_decode_a(a, v, index, count, out): i64 {
    if (bayan_json_v_is_obj(v) != 1) {
        return _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          "tasks[", index, "] is not an object");
    }
    var allowed = agnostic_task_req_fields_a(a);
    var unknown = agnostic_unknown_field(v, allowed);
    if (unknown != 0) {
        var sb = str_builder_new_a(a);
        if (sb == 0) { return _agnostic_reject(a, out, AGNOSTIC_HTTP_UNPROCESSABLE, unknown); }
        str_builder_add_cstr_a(a, sb, "tasks[");
        str_builder_add_int_a(a, sb, index);
        str_builder_add_cstr_a(a, sb, "] has unknown field '");
        str_builder_add_a(a, sb, unknown);
        str_builder_add_cstr_a(a, sb, "'");
        return _agnostic_reject(a, out, AGNOSTIC_HTTP_UNPROCESSABLE, str_builder_build_a(a, sb));
    }

    var desc = agnostic_req_str(v, str_from_a(a, "description"));
    if (desc == 0) {
        return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
          "tasks[", index, "]: 'description' is required and must be a string");
    }
    if (str_len(desc) == 0) {
        return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
          "tasks[", index, "]: 'description' must not be empty");
    }
    if (_agnostic_str_field_ok(desc) < 0) {
        return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
          "tasks[", index, "]: 'description' exceeds the maximum length");
    }

    var t = alloc(AGNOSTIC_TQ_SIZE);
    if (t == 0) {
        return _agnostic_reject_at(a, out, HTTP_INTERNAL,
          "tasks[", index, "]: could not allocate task");
    }
    store64(t + AGNOSTIC_TQ_DESCRIPTION, str_clone(desc));
    store64(t + AGNOSTIC_TQ_EXPECTED_OUTPUT, 0);
    store64(t + AGNOSTIC_TQ_PRIORITY, AGNOSTIC_REQ_UNSET);
    store64(t + AGNOSTIC_TQ_RISK, AGNOSTIC_REQ_UNSET);
    store64(t + AGNOSTIC_TQ_DEPENDENCIES, vec_new());
    store64(t + AGNOSTIC_TQ_REQ_TOOLS, 0);
    store64(t + AGNOSTIC_TQ_COMPLEXITY, AGNOSTIC_REQ_UNSET);
    store64(t + AGNOSTIC_TQ_DOMAIN, 0);
    store64(t + AGNOSTIC_TQ_GPU_REQUIRED, AGNOSTIC_REQ_UNSET);

    var eo = agnostic_opt_str(v, str_from_a(a, "expected_output"), 0 - 1);
    if (eo == 0) {
        return _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          "tasks[", index, "]: 'expected_output' must be a string");
    }
    if (eo != 0 - 1) {
        if (_agnostic_str_field_ok(eo) < 0) {
            return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
              "tasks[", index, "]: 'expected_output' exceeds the maximum length");
        }
        store64(t + AGNOSTIC_TQ_EXPECTED_OUTPUT, str_clone(eo));
    }

    # Priority and risk arrive as wire names, never as raw integers. Accepting
    # the integer too would give two spellings for one value and make the
    # enum's numbering part of the public contract.
    var pri = agnostic_opt_str(v, str_from_a(a, "priority"), 0 - 1);
    if (pri == 0) {
        return _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          "tasks[", index, "]: 'priority' must be a string");
    }
    if (pri != 0 - 1) {
        var p = agnostic_priority_from_wire(pri);
        if (p < 0) {
            return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
              "tasks[", index, "]: 'priority' must be one of background, low, normal, high, critical");
        }
        store64(t + AGNOSTIC_TQ_PRIORITY, p);
    }

    var rk = agnostic_opt_str(v, str_from_a(a, "risk"), 0 - 1);
    if (rk == 0) {
        return _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          "tasks[", index, "]: 'risk' must be a string");
    }
    if (rk != 0 - 1) {
        var rv = agnostic_risk_from_wire(rk);
        if (rv < 0) {
            return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
              "tasks[", index, "]: 'risk' must be one of low, medium, high");
        }
        store64(t + AGNOSTIC_TQ_RISK, rv);
    }

    if (_agnostic_task_req_hints_a(a, v, index, t, out) == 0) { return 0; }

    var deps_v = bayan_json_v_obj_get_by_str(v, str_from_a(a, "dependencies"));
    if (deps_v != 0) {
        if (bayan_json_v_is_null(deps_v) != 1) {
            if (bayan_json_v_is_arr(deps_v) != 1) {
                return _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
                  "tasks[", index, "]: 'dependencies' must be an array of task indices");
            }
            var dn = bayan_json_v_arr_len(deps_v);
            if (dn > AGNOSTIC_REQ_MAX_DEPS) {
                return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
                  "tasks[", index, "]: too many dependencies");
            }
            var deps = load64(t + AGNOSTIC_TQ_DEPENDENCIES);
            var di = 0;
            while (di < dn) {
                var dv = bayan_json_v_arr_get(deps_v, di);
                if (bayan_json_v_is_int(dv) != 1) {
                    return _agnostic_reject_at(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
                      "tasks[", index, "]: 'dependencies' must be an array of task indices");
                }
                var d = bayan_json_v_int(dv);
                if (d < 0 || d >= count) {
                    return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
                      "tasks[", index, "]: dependency index out of range");
                }
                if (d == index) {
                    return _agnostic_reject_at(a, out, HTTP_BAD_REQUEST,
                      "tasks[", index, "]: a task cannot depend on itself");
                }
                vec_push(deps, d);
                di = di + 1;
            }
        }
    }
    return t;
}

# Whether the task list's dependency graph contains a cycle.
#
# Kahn's algorithm over the index-based edges, iterative — a recursive DFS would
# put a client-controlled 1000-deep chain on the C stack.
#
# **Why this must run before submission**: see the module header. A cyclic graph
# submitted asynchronously leaves a crew reporting `pending` forever, because the
# engine's error return is discarded on the submit thread and the registry keeps
# the PENDING entry `_agnosai_orch_register` seeded.
fn agnostic_crew_req_has_cycle(tasks): i64 {
    if (tasks == 0) { return 0; }
    var n = vec_len(tasks);
    if (n == 0) { return 0; }

    # indegree[i] = how many tasks task i waits on.
    var indegree = vec_new();
    var i = 0;
    while (i < n) {
        vec_push(indegree, vec_len(agnostic_task_req_dependencies(vec_get(tasks, i))));
        i = i + 1;
    }

    var queue = vec_new();
    var q = 0;
    while (q < n) {
        if (vec_get(indegree, q) == 0) { vec_push(queue, q); }
        q = q + 1;
    }

    var seen = 0;
    var head = 0;
    while (head < vec_len(queue)) {
        var node = vec_get(queue, head);
        head = head + 1;
        seen = seen + 1;
        # Every task that lists `node` among its dependencies loses one edge.
        var j = 0;
        while (j < n) {
            var deps = agnostic_task_req_dependencies(vec_get(tasks, j));
            var k = 0;
            while (k < vec_len(deps)) {
                if (vec_get(deps, k) == node) {
                    var left = vec_get(indegree, j) - 1;
                    vec_set(indegree, j, left);
                    if (left == 0) { vec_push(queue, j); }
                }
                k = k + 1;
            }
            j = j + 1;
        }
    }
    if (seen < n) { return 1; }
    return 0;
}

# Decode a crew submission from a parsed JSON body.
#
# Returns the request record, or 0 with a rejection stored through `out`.
#
# The order is the one `src/http/codec.cyr` documents and it matters: reject a
# non-object, then check the shape with the allow-list **before reading any
# field**, then required fields, then optional. Validating the shape first means
# a request is refused whole rather than half-applied.
fn agnostic_crew_req_from_value_a(a, v, out): i64 {
    if (bayan_json_v_is_obj(v) != 1) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "request body must be a JSON object"));
    }

    var allowed = agnostic_crew_req_fields_a(a);
    var unknown = agnostic_unknown_field(v, allowed);
    if (unknown != 0) {
        return _agnostic_reject_field(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          "unknown field '", unknown, "'");
    }

    var name = agnostic_req_str(v, str_from_a(a, "name"));
    if (name == 0) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "'name' is required and must be a string"));
    }
    if (str_len(name) == 0 || _agnostic_str_field_ok(name) < 0) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "'name' must be between 1 and 10000 characters"));
    }

    var process = AGNOSTIC_PROCESS_SEQUENTIAL;
    var pw = agnostic_opt_str(v, str_from_a(a, "process"), 0 - 1);
    if (pw == 0) {
        return _agnostic_reject(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          str_from_a(a, "'process' must be a string"));
    }
    if (pw != 0 - 1) {
        process = agnostic_process_from_wire(pw);
        if (process < 0) {
            return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
              str_from_a(a, "'process' must be one of sequential, parallel, dag"));
        }
    }

    var concurrency = _agnostic_opt_int(v, "max_concurrency");
    if (concurrency == AGNOSTIC_REQ_UNSET - 1) {
        return _agnostic_reject(a, out, AGNOSTIC_HTTP_UNPROCESSABLE,
          str_from_a(a, "'max_concurrency' must be an integer"));
    }
    if (concurrency != AGNOSTIC_REQ_UNSET) {
        if (concurrency < 1 || concurrency > AGNOSTIC_REQ_MAX_CONCURRENCY) {
            return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
              str_from_a(a, "'max_concurrency' must be between 1 and 64"));
        }
        # ⚠ Accepted only where it means something. The engine reads concurrency
        # from the process mode, so a `max_concurrency` sent alongside
        # `sequential` would be accepted and then have no effect — a field
        # silently doing nothing, which is the failure this milestone is about.
        if (process != AGNOSTIC_PROCESS_PARALLEL) {
            return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
              str_from_a(a, "'max_concurrency' applies only to process 'parallel'"));
        }
    }

    var agents_v = bayan_json_v_obj_get_by_str(v, str_from_a(a, "agents"));
    if (agents_v == 0 || bayan_json_v_is_arr(agents_v) != 1) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "'agents' is required and must be an array"));
    }
    var an = bayan_json_v_arr_len(agents_v);
    if (an == 0) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "at least one agent is required"));
    }
    if (an > AGNOSTIC_REQ_MAX_AGENTS) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "at most 100 agents are allowed"));
    }

    # ⚠ `tasks` is REQUIRED. `ORACLE-AUDIT.md` §3.3 is what a missing-but-ignored
    # `tasks` field cost: the array was dropped and a single-task fallback ran
    # instead, silently, on every request. There is no fallback to fall into here.
    var tasks_v = bayan_json_v_obj_get_by_str(v, str_from_a(a, "tasks"));
    if (tasks_v == 0 || bayan_json_v_is_arr(tasks_v) != 1) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "'tasks' is required and must be an array"));
    }
    var tn = bayan_json_v_arr_len(tasks_v);
    if (tn == 0) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "at least one task is required"));
    }
    if (tn > AGNOSTIC_REQ_MAX_TASKS) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "at most 1000 tasks are allowed"));
    }

    var agents = vec_new();
    var ai = 0;
    while (ai < an) {
        var def = agnostic_agent_def_decode_a(a, bayan_json_v_arr_get(agents_v, ai), ai, out);
        if (def == 0) { return 0; }
        if (agnostic_agent_def_complexity_ok(def) == 0) {
            return agnostic_agent_def_complexity_reject_a(a, out, ai);
        }
        vec_push(agents, def);
        ai = ai + 1;
    }

    var tasks = vec_new();
    var ti = 0;
    while (ti < tn) {
        var t = agnostic_task_req_decode_a(a, bayan_json_v_arr_get(tasks_v, ti), ti, tn, out);
        if (t == 0) { return 0; }
        vec_push(tasks, t);
        ti = ti + 1;
    }

    if (agnostic_crew_req_has_cycle(tasks) == 1) {
        return _agnostic_reject(a, out, HTTP_BAD_REQUEST,
          str_from_a(a, "task dependencies contain a cycle"));
    }

    var r = alloc(AGNOSTIC_CQ_SIZE);
    if (r == 0) {
        return _agnostic_reject(a, out, HTTP_INTERNAL,
          str_from_a(a, "could not allocate crew request"));
    }
    store64(r + AGNOSTIC_CQ_NAME, str_clone(name));
    store64(r + AGNOSTIC_CQ_PROCESS, process);
    store64(r + AGNOSTIC_CQ_CONCURRENCY, concurrency);
    store64(r + AGNOSTIC_CQ_AGENTS, agents);
    store64(r + AGNOSTIC_CQ_TASKS, tasks);
    return r;
}

# Which retained-but-unforwarded fields this submission's agents carry, as a
# JSON array of names.
#
# ⚠ The **union** across the roster, not per agent. A caller who sent `focus` on
# one of five agents needs to know it shaped nothing; which agent carried it is
# already visible in what they sent. Always present, even when empty, so
# `len(unforwarded)` is an unconditional read.
fn agnostic_crew_req_unforwarded_a(a, r): i64 {
    var arr = bayan_json_v_arr_new_a(a);
    if (arr == 0 || r == 0) { return arr; }
    var agents = agnostic_crew_req_agents(r);
    if (agents == 0) { return arr; }

    var focus = 0;
    var deleg = 0;
    var i = 0;
    while (i < vec_len(agents)) {
        var d = vec_get(agents, i);
        if (agnostic_agent_def_focus(d) != 0) { focus = 1; }
        if (agnostic_agent_def_delegation(d) != AGNOSTIC_REQ_UNSET) { deleg = 1; }
        i = i + 1;
    }
    if (focus == 1) {
        bayan_json_v_arr_push_a(a, arr, bayan_json_v_str_new_a(a, AGNOSTIC_JK_FOCUS));
    }
    if (deleg == 1) {
        bayan_json_v_arr_push_a(a, arr, bayan_json_v_str_new_a(a, AGNOSTIC_JK_DELEGATION));
    }
    return arr;
}

# Put a decoded task's selection hints into engine task `t`'s context (0.1.14, ADR 0017),
# under the selector's own keys and as the JSON values it reads (`agnosai_rank_agents`). A
# hint the request left out is not written, so the selector's default for an absent key
# applies: no tool requirement, complexity medium, any domain, no GPU needed.
#
# ⚠ **The context is the task's prompt preamble too.** agnosai renders every context key
# into the model request (`_agnosai_crew_build_request`), so a hinted task's prompt says
# what it was hinted with — and that request is also hoosh's cache key. ADR 0017 records it.
#
# Global allocator: the values are the engine task's, and outlive the request.
fn _agnostic_task_spec_hints(t, tr): i64 {
    var tools = agnostic_task_req_required_tools(tr);
    if (tools != 0) {
        var arr = bayan_json_v_arr_new();
        var i = 0;
        while (i < vec_len(tools)) {
            bayan_json_v_arr_push(arr, bayan_json_v_str_new(vec_get(tools, i)));
            i = i + 1;
        }
        agnosai_task_with_context(t, AGNOSTIC_JK_REQ_TOOLS, arr);
    }
    var cx = agnostic_task_req_complexity(tr);
    if (cx != AGNOSTIC_REQ_UNSET) {
        agnosai_task_with_context(t, AGNOSTIC_JK_COMPLEXITY,
          bayan_json_v_str_new(agnostic_complexity_to_wire(cx)));
    }
    var dom = agnostic_task_req_domain(tr);
    if (dom != 0) { agnosai_task_with_context(t, AGNOSTIC_JK_DOMAIN, bayan_json_v_str_new(dom)); }
    var gpu = agnostic_task_req_gpu_required(tr);
    if (gpu != AGNOSTIC_REQ_UNSET) {
        agnosai_task_with_context(t, AGNOSTIC_JK_GPU_REQ, bayan_json_v_bool_new(gpu));
    }
    return t;
}

# Build the engine crew spec a decoded submission describes.
#
# **Two passes over the task list, and the second one is not optional.**
# Dependencies are index-based on the wire and id-based in the spec, and a task's
# engine id does not exist until `agnosai_task_new` has built it — so every task
# must exist before any edge can be resolved.
#
# Global allocator throughout: `agnosai_orchestrator_submit_crew` registers this
# spec and a detached thread runs it, both of which outlive the request.
fn agnostic_crew_spec_build(r): i64 {
    if (r == 0) { return 0; }
    var spec = agnosai_crew_new(agnostic_crew_req_name(r));
    if (spec == 0) { return 0; }

    # Unwrap to the engine's records. The Agnostic wrapper carries `focus` and
    # `allow_delegation`, which the engine has no slot for — they stay on the
    # request record and are reported in `unforwarded` rather than being
    # silently handed to a constructor that would drop them.
    var wrapped = agnostic_crew_req_agents(r);
    var engine_agents = vec_new();
    var ai = 0;
    while (ai < vec_len(wrapped)) {
        vec_push(engine_agents, agnostic_agent_def_engine(vec_get(wrapped, ai)));
        ai = ai + 1;
    }
    agnosai_crew_with_agents(spec, engine_agents);

    var mode = agnostic_crew_req_process(r);
    if (mode == AGNOSTIC_PROCESS_DAG) {
        agnosai_crew_with_process(spec, agnosai_process_dag());
    } elif (mode == AGNOSTIC_PROCESS_PARALLEL) {
        var n = agnostic_crew_req_concurrency(r);
        if (n == AGNOSTIC_REQ_UNSET) { n = AGNOSTIC_REQ_DEFAULT_CONCURRENCY; }
        agnosai_crew_with_process(spec, agnosai_process_parallel(n));
    } else {
        agnosai_crew_with_process(spec, agnosai_process_sequential());
    }

    var reqs = agnostic_crew_req_tasks(r);
    var n2 = vec_len(reqs);
    var tasks = vec_new();
    var i = 0;
    while (i < n2) {
        var tr = vec_get(reqs, i);
        var t = agnosai_task_new(agnostic_task_req_description(tr));
        if (t == 0) { return 0; }
        var eo = agnostic_task_req_expected_output(tr);
        if (eo != 0) { agnosai_task_with_expected_output(t, eo); }
        # An absent priority leaves `agnosai_task_new`'s own default rather than
        # overwriting it with NORMAL — the two are not the same if the engine's
        # default ever moves.
        var p = agnostic_task_req_priority(tr);
        if (p != AGNOSTIC_REQ_UNSET) { agnosai_task_with_priority(t, p); }
        var rk = agnostic_task_req_risk(tr);
        if (rk != AGNOSTIC_REQ_UNSET) { agnosai_task_with_risk(t, rk); }
        _agnostic_task_spec_hints(t, tr);
        vec_push(tasks, t);
        i = i + 1;
    }

    var j = 0;
    while (j < n2) {
        var deps = agnostic_task_req_dependencies(vec_get(reqs, j));
        var k = 0;
        while (k < vec_len(deps)) {
            var idx = vec_get(deps, k);
            # Bounds already enforced at decode; re-checked because this function
            # is reachable from a caller that built the record another way.
            if (idx >= 0 && idx < n2) {
                agnosai_task_with_dependency(vec_get(tasks, j),
                  agnosai_task_id(vec_get(tasks, idx)));
            }
            k = k + 1;
        }
        j = j + 1;
    }

    agnosai_crew_with_tasks(spec, tasks);
    return spec;
}
