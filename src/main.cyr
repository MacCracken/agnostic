# agnostic — main entry point.
# Stdlib auto-included via cyrius.cyml.
#
# ⚠ **Thin on purpose, and it is the only file with an entry point.** The
# program's include order lives in `src/app.cyr` so that test suites can pull in
# the whole program without reproducing it — adding a route module used to break
# every suite that reached the router. The two top-level statements at the bottom
# of this file are why `app.cyr` cannot simply be this file: they run at include
# time and would start a server inside a suite.
include "src/app.cyr"

# Entry point. Reads its arguments, then config, wires logging, and serves until a shutdown
# signal — or runs the command the arguments name (`src/cli.cyr`). Returns the exit code.
fn main() {
    alloc_init();
    thread_local_init();

    # ⚠ **The command line BEFORE the environment** (0.1.13). `agnostic api schema` must not
    # depend on `AGNOSTIC_*`: an invalid AGNOSTIC_PORT must neither change the schema nor stop
    # it printing. No arguments serves, exactly as before.
    args_init();
    var cmd = agnostic_cli_command();
    if (cmd != AGNOSTIC_CLI_SERVE) { return agnostic_cli_run(cmd); }

    var cfg = agnostic_config_from_env();
    if (cfg == 0) {
        println("agnostic: could not allocate configuration");
        return 1;
    }

    # ⚠ A malformed environment value refuses to start rather than silently
    # falling back to a default. An operator discovering in production that
    # AGNOSTIC_PORT never applied is a worse outcome than a startup failure that
    # names the problem.
    if (agnostic_config_invalid(cfg) == 1) {
        println("agnostic: invalid configuration — check AGNOSTIC_* and OTEL_EXPORTER_OTLP_* values");
        return 1;
    }

    agnostic_log_init(cfg);

    # CYRIUS_PKG_VERSION resolves ONLY in this file — the entry text. cbt injects
    # `#@pkgver` at byte 0 and cycc replaces it here, but an included file
    # referencing the symbol fails to compile. Filed upstream as
    # cyrius 2026-08-20-pkgver-not-visible-in-included-files. So the version is
    # read here and handed to the modules that report it.
    agnostic_version_set(str_from(CYRIUS_PKG_VERSION));

    return agnostic_serve(cfg);
}

var _agnostic_exit_code = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(_agnostic_exit_code);
