.hp { height: 4px; background: #2a1414; border-radius: 2px; overflow: hidden; }
.hp i { display: block; height: 100%; background: var(--ok); }
.sel-side { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
.sel-log { flex: 1; font: 10.5px/1.5 var(--mono); color: var(--dim); overflow: hidden; background: #08101a; border: 1px solid var(--line); border-radius: 4px; padding: 5px 7px; }
.sel-log div { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sel-log .t { color: var(--faint); margin-right: 6px; }
.sel-log .err { color: #fca5a5; }
.sel-log .ok { color: #86efac; }
.timeline-wrap .panel-title { margin-bottom: 3px; }
canvas.timeline { width: 100%; height: 16px; display: block; border-radius: 3px; background: #08101a; }
.state-pill { display: inline-block; padding: 1px 6px; border-radius: 9px; font: 600 10px var(--mono); border: 1px solid; }
.sel-grid { display: grid; grid-template-columns: repeat(auto-fill, 38px); grid-auto-rows: 38px; gap: 4px; overflow: hidden; align-content: start; flex: 1; }
.sel-grid .pt { position: relative; background: #0a121b; border: 1px solid var(--line-2); border-radius: 4px; cursor: pointer; }
.sel-grid .pt canvas { width: 100%; height: 100%; display: block; }
.sel-grid .pt:hover { border-color: var(--accent); }
.sel-grid .more { display: flex; align-items: center; justify-content: center; color: var(--dim); font: 11px var(--mono); }
.sel-summary { width: 170px; flex: none; display: flex; flex-direction: column; gap: 4px; font-size: 11px; }
.sel-summary .big { font: 700 22px var(--mono); }
.bar { height: 6px; background: #142030; border-radius: 3px; overflow: hidden; }
.bar i { display: block; height: 100%; }

/* ---------- event feed ---------- */
#feed { position: absolute; top: calc(var(--top-h) + 8px); right: 8px; bottom: calc(var(--bottom-h) + 16px); width: 316px; display: flex; flex-direction: column; z-index: 9;
  transition: transform .2s ease; }
#feed.collapsed { transform: translateX(calc(100% - 30px)); }
#feed.collapsed .feed-filters, #feed.collapsed #feed-list { visibility: hidden; }
.feed-head { display: flex; align-items: center; gap: 8px; padding: 8px 10px 6px; }
.feed-head b { font: 700 9.5px var(--sans); letter-spacing: .16em; color: var(--dim); flex: 1; }
.feed-head span { font: 10px var(--mono); color: var(--faint); }
#feed-toggle { background: none; border: 1px solid var(--line-2); border-radius: 4px; width: 22px; height: 20px; padding: 0; color: var(--dim); order: -1; }
.feed-filters { padding: 0 10px 8px; display: flex; flex-direction: column; gap: 6px; border-bottom: 1px solid var(--line); }
.chips { display: flex; flex-wrap: wrap; gap: 4px; }
.chip { background: #0d1722; border: 1px solid var(--line-2); border-radius: 10px; padding: 2px 8px; font-size: 10.5px; color: var(--faint); }
.chip.on { color: var(--text); border-color: var(--c, var(--accent)); background: color-mix(in srgb, var(--c, #39d0ff) 14%, #0d1722); }
.feed-filters .frow { display: flex; gap: 6px; align-items: center; }
.feed-filters input[type=text] { flex: 1; min-width: 0; font-size: 11px; }
.feed-filters label { font-size: 10.5px; color: var(--dim); display: flex; align-items: center; gap: 4px; white-space: nowrap; }
#feed-list { list-style: none; margin: 0; padding: 4px 0; overflow-y: auto; flex: 1; font-size: 11px; }
#feed-list li { display: grid; grid-template-columns: 40px 14px 1fr; gap: 5px; padding: 3px 10px; cursor: pointer; border-left: 2px solid transparent; }
#feed-list li:hover { background: rgba(57,208,255,.06); border-left-color: var(--accent); }
#feed-list .t { font: 10px var(--mono); color: var(--faint); padding-top: 1px; }
#feed-list .i { font-size: 10px; text-align: center; padding-top: 1px; }
#feed-list .x { color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#feed-list .x b { color: var(--text); font-weight: 600; }
#feed-list li.error .x { color: #fca5a5; }
#feed-list li.ok .x { color: #a7f3d0; }
#feed ::-webkit-scrollbar { width: 6px; }
#feed ::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 3px; }

/* ---------- tooltip / toast ---------- */
#tooltip { position: absolute; z-index: 30; pointer-events: none; max-width: 300px; padding: 7px 9px; background: rgba(8,13,20,.97); border: 1px solid var(--line-2); border-radius: 5px; font-size: 11px; box-shadow: 0 6px 20px rgba(0,0,0,.55); }
#tooltip .tt-title { font: 700 12px var(--mono); margin-bottom: 3px; display: flex; align-items: center; gap: 6px; }
#tooltip .tt-row { color: var(--dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#tooltip .tt-row b { color: var(--text); font-weight: 500; }
#toast { position: absolute; left: 50%; bottom: calc(var(--bottom-h) + 22px); transform: translateX(-50%); z-index: 25; display: flex; flex-direction: column; align-items: center; gap: 6px; pointer-events: none; }
#toast div { background: rgba(10,18,27,.96); border: 1px solid var(--line-2); border-radius: 5px; padding: 6px 12px; font: 11.5px var(--mono); animation: toast 2.6s forwards; }
#toast div.bad { border-color: var(--err); color: #fecaca; }
#toast div.good { border-color: var(--accent); }
@keyframes toast { 0% { opacity: 0; transform: translateY(6px); } 8% { opacity: 1; transform: none; } 80% { opacity: 1; } 100% { opacity: 0; } }
#hint { position: absolute; left: 50%; top: calc(var(--top-h) + 10px); transform: translateX(-50%); z-index: 11; padding: 6px 12px; border-radius: 5px; background: rgba(40,30,4,.92); border: 1px solid var(--gold); color: var(--gold); font: 600 11px var(--mono); }

/* ---------- overlays ---------- */
.overlay { position: absolute; inset: 0; z-index: 40; display: flex; align-items: center; justify-content: center;
  background: radial-gradient(ellipse at 50% 35%, rgba(14,32,48,.86), rgba(3,6,10,.97) 70%); backdrop-filter: blur(3px); }
.ov-inner { width: min(1080px, 94vw); }
.ov-title { font: 800 34px/1 var(--sans); letter-spacing: .22em; color: var(--accent); text-align: center; }
.ov-title b { color: var(--text); }
.ov-sub { text-align: center; color: var(--dim); margin: 10px 0 26px; font-size: 13px; }
.cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
.card { background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 8px; padding: 18px; display: flex; flex-direction: column; gap: 10px; text-align: left; transition: border-color .15s, transform .15s; }
.card:hover { border-color: var(--accent); transform: translateY(-2px); }
.card h3 { margin: 0; font-size: 16px; display: flex; align-items: center; gap: 10px; }
.card .ico { font-size: 22px; }
.card p { margin: 0; color: var(--dim); font-size: 12px; line-height: 1.55; flex: 1; }
.card .tags { display: flex; flex-wrap: wrap; gap: 5px; }
.card .tags span { font: 10px var(--mono); padding: 2px 7px; border-radius: 9px; border: 1px solid var(--line-2); color: var(--dim); }
.card .go { margin-top: 4px; background: #0e3346; border: 1px solid var(--accent); color: var(--accent); border-radius: 5px; padding: 8px; font: 700 12px var(--mono); letter-spacing: .1em; }
.card .go:hover { background: #135070; color: #fff; }
.ov-opts { display: flex; justify-content: center; align-items: center; gap: 18px; margin-top: 22px; color: var(--dim); font-size: 12px; flex-wrap: wrap; }
.ov-opts label { display: flex; align-items: center; gap: 6px; }
.ov-opts input[type=number] { width: 90px; }
.ov-foot { text-align: center; color: var(--faint); font-size: 11px; margin-top: 18px; line-height: 1.8; }
.ov-foot kbd, .help kbd { font: 10px var(--mono); border: 1px solid var(--line-2); border-radius: 3px; padding: 0 4px; color: var(--dim); }
.filebtn { position: relative; overflow: hidden; background: #111a26; border: 1px solid var(--line-2); border-radius: 4px; padding: 4px 10px; color: var(--dim); }
.filebtn input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
.sum-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 8px 0 18px; }
.stat { background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 7px; padding: 14px; }
.stat label { display: block; font: 700 9.5px var(--sans); letter-spacing: .16em; color: var(--dim); margin-bottom: 6px; }
.stat .v { font: 700 24px var(--mono); }
.stat small { color: var(--dim); font: 11px var(--mono); }
.split-box { background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 7px; padding: 14px 16px; }
.split-row { display: grid; grid-template-columns: 90px 1fr 170px; align-items: center; gap: 12px; margin: 7px 0; font: 11px var(--mono); }
.split-row .bar { height: 10px; }
.sum-actions { display: flex; justify-content: center; gap: 12px; margin-top: 22px; }
.sum-actions button { background: #111c29; border: 1px solid var(--line-2); border-radius: 5px; padding: 9px 18px; font: 700 12px var(--mono); letter-spacing: .06em; }
.sum-actions button.primary { background: #0e3346; border-color: var(--accent); color: var(--accent); }
.sum-actions button:hover { border-color: var(--accent); color: #fff; }
.help { position: absolute; z-index: 35; top: calc(var(--top-h) + 8px); left: 204px; width: 330px; padding: 10px 12px; font-size: 11px; line-height: 1.75; }
.help .row { display: flex; justify-content: space-between; gap: 10px; color: var(--dim); }
.help .row span:last-child { color: var(--text); }

/* ---------- source tag / live controls ---------- */
.src-tag { display: inline-block; font: 700 8.5px/1.5 var(--mono); letter-spacing: .12em; padding: 0 5px; border-radius: 3px; margin-right: 5px; vertical-align: 1px; }
.src-tag.sim { color: #c4b5fd; background: #2a1d5c; }
.src-tag.live { color: #86efac; background: #12351f; }
.src-tag.replay { color: #fcd34d; background: #3a2c07; }
.tb-btn.danger { color: #fca5a5; border-color: #7f1d1d; }
.tb-btn.danger:hover { border-color: var(--err); color: #fff; }

/* ---------- launcher ---------- */
.overlay.scroll { align-items: flex-start; overflow-y: auto; padding: 26px 0 30px; }
.overlay.scroll .ov-inner { margin: auto 0; }
.ov-inner.launcher .ov-sub { margin-bottom: 18px; }
.lh-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
.lh-bar .spacer { flex: 1; }
.conn { font: 11px var(--mono); color: var(--dim); display: flex; align-items: center; gap: 7px; }
.conn i { width: 8px; height: 8px; border-radius: 50%; background: var(--faint); display: inline-block; }
.conn.ok i { background: var(--ok); box-shadow: 0 0 8px rgba(34,197,94,.6); }
.conn.warn i { background: var(--gold); }
.lbtn { background: #111c29; border: 1px solid var(--line-2); border-radius: 5px; padding: 6px 12px; font: 700 11px var(--mono); letter-spacing: .04em; color: var(--text); }
.lbtn:hover:not(:disabled) { border-color: var(--accent); color: #fff; }
.lbtn.primary { background: #0e3346; border-color: var(--accent); color: var(--accent); }
.lbtn.danger:hover:not(:disabled) { border-color: var(--err); color: #fecaca; }
.lbtn:disabled { opacity: .4; cursor: default; }
.lbtn.sm { padding: 3px 8px; font-size: 10.5px; }
.lsec { margin-bottom: 22px; }
.lsec-title { font: 700 10px var(--sans); letter-spacing: .18em; color: var(--dim); margin: 0 0 9px; display: flex; align-items: center; gap: 10px; }
.lsec-title small { font: 10.5px var(--mono); letter-spacing: 0; color: var(--faint); }
.swarm-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(310px, 1fr)); gap: 12px; }
.swarm-empty { color: var(--faint); font-size: 12px; line-height: 1.7; padding: 14px 16px; border: 1px dashed var(--line-2); border-radius: 8px; }
.swarm-empty b { color: var(--dim); }
.swarm { background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 8px; padding: 13px 14px 12px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.swarm:hover { border-color: #35506a; }
.sw-head { display: flex; align-items: flex-start; gap: 10px; }
.sw-head .ico { font-size: 18px; color: var(--accent); width: 24px; text-align: center; flex: none; }
.sw-name { flex: 1; min-width: 0; font: 700 13.5px var(--sans); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sw-name small { display: block; font: 11px/1.45 var(--sans); color: var(--dim); white-space: normal; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; margin-top: 2px; }
.sw-tools { display: flex; gap: 3px; flex: none; }
.sw-tools button { background: none; border: 1px solid transparent; border-radius: 4px; color: var(--faint); padding: 1px 5px; font-size: 12px; }
.sw-tools button:hover { border-color: var(--line-2); color: var(--text); }
.sw-tools button.del:hover { border-color: var(--err); color: #fca5a5; }
.sw-chips { display: flex; flex-wrap: wrap; gap: 4px; }
.sw-chips span { font: 10px var(--mono); padding: 1px 7px; border-radius: 9px; border: 1px solid var(--line-2); color: var(--dim); }
.sw-est { font: 11px var(--mono); color: var(--dim); background: #0a121b; border: 1px solid var(--line); border-radius: 5px; padding: 6px 8px; min-height: 30px; }
.sw-est b { color: var(--gold); font-size: 13px; }
.sw-est .stale { color: #fbbf24; }
.sw-est .bar { margin-top: 5px; height: 4px; }
.sw-est .bar i { background: var(--accent); }
.sw-runs { display: flex; flex-wrap: wrap; gap: 4px; min-height: 18px; }
.lsec-title { display: flex; align-items: center; gap: 8px; }
.lsec-title .spacer { flex: 1; }
.crew-list { display: flex; flex-direction: column; gap: 4px; }
.crew-row { display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto auto; gap: 10px; align-items: center; padding: 6px 10px; border: 1px solid var(--line-2); border-radius: 6px; background: rgba(12,19,28,.85); font-size: 12px; }
.crew-row .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.crew-row .nm small { color: var(--dim); margin-left: 6px; font: 11px var(--mono); }
.crew-row .st { font: 600 10.5px var(--mono); letter-spacing: .05em; }
.crew-row .st.bad { color: #fca5a5; } .crew-row .st.ok { color: #86efac; } .crew-row .st.run { color: #fcd34d; }
.crew-row .mt { color: var(--dim); font: 11px var(--mono); white-space: nowrap; }
.crew-empty { color: var(--dim); font-size: 12px; padding: 6px 2px; }
.modal-box.wide { width: min(920px, 94vw); max-height: 84vh; display: flex; flex-direction: column; }
.modal-box.wide .modal-body { overflow: auto; min-height: 0; }
.results { display: flex; flex-direction: column; gap: 10px; }
.res-item { border: 1px solid var(--line-2); border-radius: 6px; padding: 8px 10px; background: rgba(8,13,20,.6); }
.res-head { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
.res-head small { color: var(--dim); font: 11px var(--mono); }
.res-st { font: 600 10px var(--mono); letter-spacing: .05em; } .res-st.ok { color: #86efac; } .res-st.bad { color: #fca5a5; }
.res-out { margin: 6px 0 0; white-space: pre-wrap; word-break: break-word; font: 12px/1.45 var(--mono); color: var(--text); max-height: 320px; overflow: auto; }
.res-dl { display: flex; gap: 8px; justify-content: flex-end; margin-top: 10px; }
.ro-badge { font: 600 10px var(--mono); color: #fcd34d; border: 1px solid rgba(252,211,77,.45); border-radius: 8px; padding: 1px 6px; margin-left: 6px; }
.run-chip { font: 10px var(--mono); padding: 1px 7px; border-radius: 3px; border: 1px solid var(--line-2); color: var(--dim); background: #0b141e; white-space: nowrap; }
.run-chip.live { border-color: #1f5133; color: #a7f3d0; }
.run-chip.bad { border-color: #6b1f1f; color: #fca5a5; }
button.run-chip { cursor: pointer; }
button.run-chip:hover { border-color: var(--accent); color: #fff; }
.sw-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.sw-actions .lbtn { padding: 6px 6px; white-space: nowrap; }
.cards.templates { grid-template-columns: repeat(4, 1fr); gap: 12px; }
.cards.templates .card { padding: 14px; gap: 8px; }
.cards.templates .card p { font-size: 11.5px; }
.card .go-row { display: flex; gap: 6px; }
.card .go-row button { flex: 1; }
.card .go.alt { background: #111c29; border-color: var(--line-2); color: var(--dim); }
.card .go.alt:hover { border-color: var(--accent); color: #fff; }
@media (max-width: 1100px) { .cards.templates { grid-template-columns: repeat(2, 1fr); } }

/* ---------- editor ---------- */
.overlay.editor-ov { z-index: 45; }
.ov-inner.editor { width: min(1180px, 96vw); background: rgba(8,13,20,.97); border: 1px solid var(--line-2); border-radius: 10px; padding: 16px 18px 18px; box-shadow: 0 18px 60px rgba(0,0,0,.6); }
.ed-head { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
.ed-head .spacer { flex: 1; }
.ed-kicker { font: 700 9.5px var(--sans); letter-spacing: .18em; color: var(--dim); margin-bottom: 4px; }
.ed-name { font: 700 17px var(--sans); width: min(520px, 50vw); background: transparent; border: 1px solid transparent; padding: 3px 6px; margin-left: -6px; }
.ed-name:hover, .ed-name:focus { border-color: var(--line-2); background: #0b131c; outline: none; }
.ed-tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line-2); margin-bottom: 12px; flex-wrap: wrap; }
.ed-tabs button { background: none; border: 1px solid transparent; border-bottom: none; border-radius: 5px 5px 0 0; padding: 7px 12px; color: var(--dim); font: 600 11.5px var(--sans); margin-bottom: -1px; }
.ed-tabs button:hover { color: var(--text); }
.ed-tabs button.on { color: var(--accent); border-color: var(--line-2); background: rgba(8,13,20,1); }
.ed-tabs button .n { font: 9.5px var(--mono); color: var(--err); margin-left: 4px; }
.ed-body { display: flex; gap: 14px; align-items: flex-start; }
.ed-pane { flex: 1; min-width: 0; font-size: 12px; }
.ed-side { width: 270px; flex: none; display: flex; flex-direction: column; gap: 10px; position: sticky; top: 0; }
.ed-box { background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 7px; padding: 10px 11px; }
.ed-box .panel-title { margin-bottom: 8px; }
.ed-pane h4 { font: 700 9.5px var(--sans); letter-spacing: .16em; color: var(--dim); margin: 16px 0 7px; }
.ed-pane h4:first-child { margin-top: 2px; }
.ed-pane p.note { color: var(--faint); font-size: 11px; line-height: 1.55; margin: 6px 0 0; }
.ed-pane p.note b { color: var(--dim); font-weight: 600; }
.frm { display: grid; grid-template-columns: 170px 1fr; gap: 7px 12px; align-items: center; }
.frm > label { color: var(--dim); font-size: 11.5px; }
.frm .hint { color: var(--faint); font-size: 10.5px; margin-left: 8px; }
.ed-pane input[type=text], .ed-pane input[type=number], .ed-pane select, .ed-pane textarea { font-size: 11.5px; padding: 3px 6px; }
.ed-pane input[type=number] { width: 84px; }
.ed-pane input.w-sm { width: 62px; }
.ed-pane input.w-lg, .ed-pane textarea { width: 100%; }
.ed-pane textarea { resize: vertical; min-height: 54px; font-family: var(--sans); color: var(--text); background: #0b131c; border: 1px solid var(--line-2); border-radius: 4px; }
.ed-pane input.bad, .ed-pane select.bad { border-color: var(--err); }
.tbl-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 6px; }
table.etbl { border-collapse: collapse; width: 100%; font-size: 11.5px; }
table.etbl th { text-align: left; font: 700 9px var(--sans); letter-spacing: .12em; color: var(--dim); padding: 6px 7px; border-bottom: 1px solid var(--line-2); white-space: nowrap; background: #0b131c; }
table.etbl td { padding: 4px 7px; border-bottom: 1px solid var(--line); white-space: nowrap; vertical-align: middle; }
table.etbl tr:last-child td { border-bottom: none; }
table.etbl td.ro { color: var(--dim); font-family: var(--mono); font-size: 10.5px; }
table.etbl td.grow { width: 100%; }
table.etbl td.grow input { width: 100%; min-width: 150px; }
table.etbl .rl { display: flex; align-items: center; gap: 6px; font-weight: 600; }
table.etbl .rl i { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }
table.etbl.tasks td { padding: 3px 4px; }
table.etbl.tasks th { padding: 6px 4px; }
table.etbl.tasks input.w-sm { width: 52px; }
table.etbl.tasks td.grow input { min-width: 130px; }
table.etbl.tasks select { max-width: 104px; }
table.etbl button.x { background: none; border: 1px solid transparent; color: var(--faint); border-radius: 3px; padding: 0 5px; }
table.etbl button.x:hover { color: #fca5a5; border-color: #7f1d1d; }
.pair { display: inline-flex; align-items: center; gap: 3px; color: var(--faint); }
.pair input[type=number] { width: 66px; }
.ed-actions { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
.chk-list { font-size: 11px; line-height: 1.55; display: flex; flex-direction: column; gap: 5px; max-height: 220px; overflow-y: auto; }
.chk-list .e { color: #fca5a5; }
.chk-list .w { color: #fcd34d; }
.chk-list .ok { color: #86efac; }
.est-big { font: 700 22px var(--mono); color: var(--gold); }
.est-row { display: flex; justify-content: space-between; gap: 8px; font: 11px var(--mono); color: var(--dim); margin-top: 3px; }
.est-row b { color: var(--text); font-weight: 600; }
.est-stale { font: 10px var(--mono); color: #fbbf24; margin-top: 4px; }
pre.req { max-height: 260px; overflow: auto; background: #070c12; border: 1px solid var(--line); border-radius: 5px; padding: 8px; font: 10.5px/1.45 var(--mono); color: var(--dim); white-space: pre; user-select: text; -webkit-user-select: text; }
.radio-row { display: flex; flex-direction: column; gap: 6px; }
.radio-row label { display: flex; align-items: center; gap: 7px; color: var(--text); }

/* ---------- modal ---------- */
.modal { position: absolute; inset: 0; z-index: 60; display: flex; align-items: center; justify-content: center; background: rgba(2,5,9,.72); }
.modal-box { width: min(460px, 92vw); background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 8px; padding: 16px 18px; box-shadow: 0 18px 50px rgba(0,0,0,.6); }
.modal-title { font: 700 14px var(--sans); margin-bottom: 8px; }
.modal-body { color: var(--dim); font-size: 12px; line-height: 1.6; }
.modal-body b { color: var(--text); }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
</style>
</head>
<body>
<div id=\"app\">
  <canvas id=\"map\"></canvas>

  <header id=\"topbar\">
    <div class=\"brand\"><span>◈ SWARM<b>COMMAND</b></span><span class=\"mission\"><span id=\"src-tag\" class=\"src-tag sim\">SIM</span><span id=\"mission-title\"></span></span></div>
    <div class=\"res\" id=\"r-tps\" title=\"Token throughput across the swarm\"><label>TOKENS / S</label><div class=\"row\"><span class=\"v\">0</span><canvas class=\"spark\" width=\"128\" height=\"36\"></canvas></div></div>
    <div class=\"res\" id=\"r-tokens\" title=\"Total tokens consumed\"><label>TOTAL TOKENS</label><span class=\"v\">0</span></div>
    <div class=\"res\" id=\"r-cost\" title=\"Estimated spend: model tokens + per-second compute\"><label>EST. COST</label><span class=\"v\">$0.00</span><small>+$0.000/s</small></div>
    <div class=\"res\" id=\"r-budget\" title=\"Mission budget remaining (drains with cost)\"><label>BUDGET LEFT</label><div class=\"bar\"><i></i></div><small class=\"v2\">—</small></div>
    <div class=\"res\" id=\"r-agents\" title=\"Active agents / total unit cap (Local · Cloud)\"><label>AGENTS</label><span class=\"v\">0 / 0</span><small class=\"split\"><i class=\"l\">L 0/0</i> · <i class=\"c\">C 0/0</i></small></div>
    <div class=\"res\" id=\"r-tasks\" title=\"Tasks completed / total\"><label>TASKS</label><span class=\"v\">0 / 0</span><small>0 failed</small></div>
    <div class=\"res\" id=\"r-time\" title=\"Mission clock (sim time)\"><label>ELAPSED</label><span class=\"v\">00:00</span></div>
    <div class=\"spacer\"></div>
    <div class=\"speed\" id=\"speed\">
      <button data-speed=\"0\" title=\"Pause / resume (Space)\">❚❚</button>
      <button data-speed=\"1\" title=\"Real time\">1×</button>
      <button data-speed=\"2\">2×</button>
      <button data-speed=\"4\">4×</button>
    </div>
    <button id=\"btn-cancel\" class=\"tb-btn danger hidden\" title=\"Ask agnostic to cancel this crew\">✕<span class=\"tb-label\"> CANCEL CREW</span></button>
    <button id=\"btn-replay\" class=\"tb-btn\" title=\"Scrub through the recorded event log\">⟲<span class=\"tb-label\"> REPLAY</span></button>
    <button id=\"btn-help\" class=\"tb-btn\" title=\"Controls (?)\">?</button>
    <button id=\"btn-menu\" class=\"tb-btn\" title=\"Back to your swarms\">☰</button>
  </header>

  <div id=\"replay-bar\" class=\"hidden\">
    <span class=\"tag\">REPLAY</span>
    <button id=\"rp-play\" title=\"Play / pause\">❚❚</button>
    <input id=\"rp-scrub\" type=\"range\" min=\"0\" max=\"1000\" step=\"1\" value=\"0\">
    <span id=\"rp-time\">00:00 / 00:00</span>
    <button id=\"rp-export\" title=\"Download the event log as JSON\">Export</button>
    <button id=\"rp-exit\" title=\"Return to the live mission\">Exit ▸ LIVE</button>
  </div>

  <div id=\"legend\" class=\"panel\">
    <h4><span>LEGEND</span><span id=\"legend-toggle\">–</span></h4>
    <div class=\"body\" id=\"legend-body\"></div>
  </div>

  <div id=\"help\" class=\"panel help hidden\"></div>

  <aside id=\"feed\" class=\"panel\">
    <div class=\"feed-head\"><button id=\"feed-toggle\" title=\"Collapse / expand\">›</button><b>EVENT FEED</b><span id=\"feed-count\">0</span></div>
    <div class=\"feed-filters\">
      <div class=\"chips\" id=\"feed-chips\">
        <button class=\"chip on\" data-cat=\"agent\" style=\"--c:#39d0ff\">Agents</button>
        <button class=\"chip on\" data-cat=\"task\" style=\"--c:#f59e0b\">Tasks</button>
        <button class=\"chip on\" data-cat=\"tool\" style=\"--c:#a78bfa\">Tools</button>
        <button class=\"chip on\" data-cat=\"msg\" style=\"--c:#2dd4bf\">Messages</button>
        <button class=\"chip on\" data-cat=\"error\" style=\"--c:#ef4444\">Errors</button>
        <button class=\"chip\" data-cat=\"move\" style=\"--c:#3b82f6\">Moves</button>
      </div>
      <div class=\"frow\">
        <input id=\"feed-agent\" type=\"text\" placeholder=\"Filter by agent name or id…\" spellcheck=\"false\">
        <label title=\"Only show events for the current selection\"><input type=\"checkbox\" id=\"feed-selected\"> Selected</label>
      </div>
    </div>
    <ol id=\"feed-list\"></ol>
  </aside>

  <section id=\"bottom\">
    <div id=\"minimap-box\" class=\"panel\"><canvas id=\"minimap\"></canvas><div id=\"fps\">— fps</div></div>
    <div id=\"selection\" class=\"panel\"></div>
    <div id=\"commands\" class=\"panel\"></div>
  </section>

  <div id=\"tooltip\" class=\"hidden\"></div>
  <div id=\"toast\"></div>
  <div id=\"hint\" class=\"hidden\"></div>

  <div id=\"start-screen\" class=\"overlay scroll\">
    <div class=\"ov-inner launcher\">
      <div class=\"ov-title\">◈ SWARM<b>COMMAND</b></div>
      <div class=\"ov-sub\">An RTS command view for AI agent swarms — every unit is an agent, every objective a task, every structure a tool.</div>
      <div class=\"lh-bar\">
        <span id=\"conn\" class=\"conn\"><i></i><span>Connecting…</span></span>
        <span class=\"spacer\"></span>
        <span class=\"filebtn\" title=\"Add a swarm from a file exported here\">Import a swarm…<input id=\"opt-import\" type=\"file\" accept=\".json,application/json\"></span>
        <button id=\"btn-new\" class=\"lbtn primary\" type=\"button\">＋ NEW SWARM</button>
      </div>
      <div class=\"lsec\">
        <div class=\"lsec-title\">YOUR SWARMS <small id=\"lib-count\"></small></div>
        <div id=\"lib-list\" class=\"swarm-list\"></div>
      </div>
      <div class=\"lsec\" id=\"crews-sec\" hidden>
        <div class=\"lsec-title\">CREWS <small id=\"crews-count\">every crew this server has run for you, newest first — watch any of them</small>
          <span class=\"spacer\"></span><button id=\"crews-refresh\" class=\"lbtn\" type=\"button\" title=\"Ask agnostic again\">↻</button></div>
        <div id=\"crews-list\" class=\"crew-list\"></div>
      </div>
      <div class=\"lsec\">
        <div class=\"lsec-title\">TEMPLATES <small>a quick demo, or the starting point for a swarm of your own</small></div>
        <div class=\"cards templates\" id=\"scenario-cards\"></div>
      </div>
      <div class=\"ov-opts\">
        <label title=\"Quick demos only — a saved swarm keeps its own seed\">Demo seed <input id=\"opt-seed\" type=\"number\" value=\"1337\"></label>
        <label>Demo scale
          <select id=\"opt-scale\">
            <option value=\"1\">1× (normal)</option>
            <option value=\"2\">2× (large)</option>
            <option value=\"3\">3× (stress — 250+ concurrent agents)</option>
          </select>
        </label>
        <span class=\"filebtn\">Replay an event log (.json)…<input id=\"opt-load\" type=\"file\" accept=\".json,application/json\"></span>
      </div>
      <div class=\"ov-foot\">
        <kbd>Right-drag</kbd>/<kbd>WASD</kbd>/edge-scroll pan · <kbd>Wheel</kbd> zoom · <kbd>Click</kbd>/<kbd>Drag-box</kbd> select · <kbd>Right-click</kbd> order ·
        <kbd>Ctrl+1–9</kbd> set group · <kbd>1–9</kbd> recall · <kbd>Space</kbd> pause<br>
        Everything you see is driven by a typed event stream — the simulator and a live agnostic crew are each just one EventSource.
      </div>
    </div>
  </div>

  <div id=\"summary-screen\" class=\"overlay hidden\">
    <div class=\"ov-inner\" id=\"summary-inner\"></div>
  </div>

  <div id=\"editor\" class=\"overlay scroll editor-ov hidden\">
    <div class=\"ov-inner editor\">
      <div class=\"ed-head\">
        <div>
          <div class=\"ed-kicker\" id=\"ed-kicker\">EDIT SWARM</div>
          <input id=\"ed-name\" class=\"ed-name\" type=\"text\" maxlength=\"80\" spellcheck=\"false\" aria-label=\"Swarm name\">
        </div>
        <span class=\"spacer\"></span>
        <button id=\"ed-cancel\" class=\"lbtn\" type=\"button\">Cancel</button>
        <button id=\"ed-save\" class=\"lbtn primary\" type=\"button\">Save</button>
      </div>
      <div class=\"ed-tabs\" id=\"ed-tabs\"></div>
      <div class=\"ed-body\">
        <div id=\"ed-pane\" class=\"ed-pane\"></div>
        <aside id=\"ed-side\" class=\"ed-side\"></aside>
      </div>
    </div>
  </div>

  <div id=\"modal\" class=\"modal hidden\">
    <div class=\"modal-box\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-title\">
      <div class=\"modal-title\" id=\"modal-title\"></div>
      <div class=\"modal-body\" id=\"modal-body\"></div>
      <div class=\"modal-actions\"><button id=\"modal-no\" class=\"lbtn\" type=\"button\">Cancel</button><button id=\"modal-alt\" class=\"lbtn hidden\" type=\"button\"></button><button id=\"modal-yes\" class=\"lbtn primary\" type=\"button\">OK</button></div>
    </div>
  </div>
</div>

<script>
'use strict';
/* =====================================================================================
 *  SWARM COMMAND — an RTS-style command view for AI agent swarms
 *
 *  Data flow (one direction only):
 *
 *     ┌──────────┐  events   ┌────────────┐  apply   ┌────────┐  read   ┌──────────────┐
 *     │   Sim    │ ────────▶ │ EventSource│ ───────▶ │ Store  │ ──────▶ │ Renderer/HUD │
 *     └──────────┘           └────────────┘          └────────┘         └──────┬───────┘
 *          ▲                                                                    │ user input
 *          │                commands                ┌─────────────┐             │
 *          └─────────────────────────────────────── │ CommandSink │ ◀───────────┘
 *                                                   └─────────────┘
 *
 *  The renderer, HUD and input layers never touch the simulator. They only see the event
 *  stream (through the Store) and talk back through a CommandSink. Swap MockSource for
 *  LiveCrewSource (a real agnostic crew) and nothing on the view side changes.
 *
 *  What runs is a saved swarm — a spec (2b): its tasks, roles, models, tools, regions, caps,
 *  budget and failure model. The simulator compiles it; the estimator runs it headless over
 *  several seeds to price it; a live run submits its tasks to agnostic as a crew. Specs are kept
 *  on the agnostic server, per tenant, through the shell's host bridge (1b): this page cannot
 *  reach the network itself.
 *
 *  Sections:  0 Utilities · 1 Event schema & interfaces · 1b Host bridge · 2 Sim (scenarios +
 *             simulator) · 2b Swarm specs & the estimator · 3 EventSource implementations ·
 *             4 State Store · 5 Renderer · 6 HUD · 6b Launcher, editor & library · 7 Input · 8 App
 * ===================================================================================== */

/* =====================================================================================
 *  SECTION 0 · UTILITIES
 * ===================================================================================== */
const TAU = Math.PI * 2;
const clamp = (v, a, b) => (v < a ? a : v > b ? b : v);
const lerp = (a, b, t) => a + (b - a) * t;
const smoothstep = (t) => t * t * (3 - 2 * t);
const dist = (ax, ay, bx, by) => Math.hypot(bx - ax, by - ay);

/** Small, fast, seedable PRNG (mulberry32). Deterministic across runs for the same seed. */
class RNG {
  constructor(seed) { this.s = (seed >>> 0) || 0x9e3779b9; }
  next() {
    let t = (this.s = (this.s + 0x6d2b79f5) >>> 0);
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  }
  range(a, b) { return a + (b - a) * this.next(); }
  int(a, b) { return Math.floor(this.range(a, b + 1)); }
  chance(p) { return this.next() < p; }
  pick(arr) { return arr[Math.floor(this.next() * arr.length)]; }
  /** weighted pick from {key: weight} */
  weighted(obj) {
    let total = 0;
    for (const k in obj) total += obj[k];
    let r = this.next() * total;
    for (const k in obj) { r -= obj[k]; if (r <= 0) return k; }
    return Object.keys(obj)[0];
  }
  shuffle(arr) {
    for (let i = arr.length - 1; i > 0; i--) { const j = Math.floor(this.next() * (i + 1)); [arr[i], arr[j]] = [arr[j], arr[i]]; }
    return arr;
  }
}

/** FNV-1a string hash → uint32. Used by the view for stable per-entity jitter (never by the sim). */
function hashStr(str) {
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 0x01000193); }
  return h >>> 0;
}
const hash01 = (str, salt = 0) => (hashStr(str + ':' + salt) % 100000) / 100000;

function fmtTime(ms) {
  const s = Math.max(0, Math.floor(ms / 1000));
  return String(Math.floor(s / 60)).padStart(2, '0') + ':' + String(s % 60).padStart(2, '0');
}
function fmtTokens(n) {
  if (n >= 1e6) return (n / 1e6).toFixed(n >= 1e7 ? 1 : 2) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(n >= 1e5 ? 0 : 1) + 'k';
  return String(Math.round(n));
}
function fmtCost(x, digits = 2) { return '$' + (x || 0).toFixed(digits); }
function fmtPct(x) { return Math.round(x * 100) + '%'; }
/** A cost agnostic reported, in micro-USD, as dollars: exact to the cent, finer below a cent. */
function fmtMicro(m) { const d = (m || 0) / 1e6; return '$' + (d > 0 && d < 0.01 ? d.toFixed(4) : d.toFixed(2)); }
function escapeHtml(s) { return String(s).replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c])); }
function fmtKB(bytes) { return (bytes / 1024).toFixed(bytes < 10240 ? 1 : 0) + ' KB'; }
function fmtAgo(at) {
  const s = Math.max(0, (Date.now() - at) / 1000);
  if (s < 60) return 'just now';
  if (s < 3600) return Math.floor(s / 60) + 'm ago';
  if (s < 86400) return Math.floor(s / 3600) + 'h ago';
  return Math.floor(s / 86400) + 'd ago';
}
/** First line of `s`, squeezed to at most `n` characters. */
function oneLine(s, n) {
  const t = String(s || '').replace(/\\s+/g, ' ').trim();
  return t.length > n ? t.slice(0, n - 1) + '…' : t;
}
const deepCopy = (x) => JSON.parse(JSON.stringify(x));
const sleepMs = (ms) => new Promise((r) => setTimeout(r, ms));
/** `n` random characters of [a-z0-9] — request-id prefixes, idempotency keys. */
function randomToken(n) {
  const b = new Uint8Array(n);
  try { crypto.getRandomValues(b); } catch (err) { for (let i = 0; i < n; i++) b[i] = Math.floor(Math.random() * 256); }
  let s = '';
  for (const x of b) s += (x % 36).toString(36);
  return s;
}
/** Median / quantile of a numeric array (copied, not sorted in place). */
function quantile(xs, q) {
  if (!xs.length) return 0;
  const s = xs.slice().sort((a, b) => a - b);
  const i = (s.length - 1) * q, lo = Math.floor(i), hi = Math.ceil(i);
  return s[lo] + (s[hi] - s[lo]) * (i - lo);
}
/** Save `text` as a file — the iframe sandbox allows downloads. */
function downloadText(name, text) {
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([text], { type: 'application/json' }));
  a.download = name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 3000);
}
/** Read a user-picked file as text. */
function readFileText(file) {
  return new Promise((resolve, reject) => {
    const r = new FileReader();
    r.onload = () => resolve(String(r.result));
    r.onerror = () => reject(new Error('could not read the file'));
    r.readAsText(file);
  });
}

/* =====================================================================================
 *  SECTION 1 · EVENT SCHEMA & INTERFACES
 *
 *  Every event:  { id, type, timestamp, agentId?, taskId?, territory, payload }
 *    id         unique, monotonically increasing per source (\"e1042\")
 *    timestamp  ms since mission start (source clock)
 *    territory  compute location the event belongs to ('local', 'us-east', …, or 'global')
 *
 *  Payloads (all optional fields may be omitted by a real source; the Store degrades gracefully):
 *    agent.spawned        {name, role, model, parentId?, spawnAt:Ref, retryOf?, health, taskId?}
 *                         The orchestrator's own spawn event also carries {mission, world} — this is how the
 *                         view learns the map (territories + tool structures). Unknown territories/tools
 *                         seen later are auto-registered, so a source may skip `world` entirely.
 *    agent.moved          {to:Ref, durationMs, reason}      Ref = {kind:'hq'|'gateway'|'tool'|'task'|'agent'|'point', id?}
 *                         Semantic destinations only — the view owns all coordinates.
 *    agent.state_changed  {state:'idle'|'moving'|'working'|'error'|'paused'|'done', step, expectedMs?, taskId?, held?}
 *    agent.message        {to, kind, text, durationMs}
 *    agent.error          {code, message, damage, health, fatal, retryInMs?}
 *    agent.completed      {result, tokens, cost}            (orchestrator completing ⇒ mission over, + summary)
 *    agent.terminated     {reason:'user'|'crashed'|'released'|'budget', tokens, cost}
 *    task.created         {title, role, deps[], parentId?, index?, of?, depth?, work, kind, priority}
 *    task.assigned        {mode:'auto'|'user'|'fanout'|'retry'|'clone'}
 *    task.progress        {progress}                         0..1
 *    task.completed       {result, durationMs}
 *    task.failed          {reason, attempts}
 *    tool.called          {toolId, kind, op, expectedMs, slow}
 *    tool.returned        {toolId, kind, ok, latencyMs, result}
 *    resource.tick        {tokens, tokensPerSec, cost, costPerSec, budget, active, cap, byTerritory{}, agents{id:[tokens,cost]}}
 * ===================================================================================== */
const EVENT_TYPES = Object.freeze([
  'agent.spawned', 'agent.moved', 'agent.state_changed', 'agent.message', 'agent.error', 'agent.completed', 'agent.terminated',
  'task.created', 'task.assigned', 'task.progress', 'task.completed', 'task.failed',
  'tool.called', 'tool.returned', 'resource.tick',
]);
const EVENT_TYPE_SET = new Set(EVENT_TYPES);

/** Lightweight structural validation — used on untrusted input (WebSocket, imported logs). */
function validateEvent(e) {
  if (!e || typeof e !== 'object') return 'not an object';
  if (!EVENT_TYPE_SET.has(e.type)) return 'unknown type ' + e.type;
  if (typeof e.timestamp !== 'number' || !isFinite(e.timestamp)) return 'bad timestamp';
  if (e.id == null) return 'missing id';
  if (typeof e.territory !== 'string') return 'missing territory';
  if (e.type.startsWith('agent.') && !e.agentId) return 'agent event without agentId';
  if (e.type.startsWith('task.') && !e.taskId) return 'task event without taskId';
  if (e.payload == null) e.payload = {};
  return null;
}

/** Presentation metadata shared by view layers (not used by the sim's logic). */
const ROLES = {
  orchestrator: { label: 'Orchestrator', abbr: 'ORC', color: '#fcd34d', shape: 'hq' },
  planner:      { label: 'Planner',      abbr: 'PLN', color: '#a78bfa', shape: 'diamond' },
  researcher:   { label: 'Researcher',   abbr: 'RES', color: '#22d3ee', shape: 'triangle' },
  coder:        { label: 'Coder',        abbr: 'COD', color: '#a3e635', shape: 'square' },
  reviewer:     { label: 'Reviewer',     abbr: 'REV', color: '#f472b6', shape: 'pentagon' },
  runner:       { label: 'Tool-Runner',  abbr: 'RUN', color: '#fb923c', shape: 'hexagon' },
};
const ROLE_KEYS = ['planner', 'researcher', 'coder', 'reviewer', 'runner'];
const TOOL_KINDS = {
  llm:    { label: 'LLM Endpoint', color: '#c4b5fd' },
  search: { label: 'Web Search',   color: '#7dd3fc' },
  exec:   { label: 'Code Exec',    color: '#fde68a' },
  db:     { label: 'Database',     color: '#fda4af' },
  fs:     { label: 'File System',  color: '#99f6e4' },
};
const STATE_COLORS = {
  idle: '#6b7280', moving: '#3b82f6', working: '#f59e0b', error: '#ef4444', done: '#22c55e', paused: '#94a3b8', dead: '#3f3f46',
};
const TASK_COLORS = { locked: '#334155', pending: '#cbd5e1', active: '#f59e0b', done: '#22c55e', failed: '#ef4444' };

/**
 * interface EventSource {
 *   capabilities: { pause: boolean, speed: boolean, seek: boolean }
 *   subscribe(handler: (event) => void): () => void      // returns unsubscribe
 *   start(): void
 *   stop(): void
 *   update(realDtMs: number): void   // pumped every animation frame; pull-based sources advance here
 *   now(): number                    // current source clock (ms since mission start) — the renderer animates against this
 *   setPaused(paused: boolean): void // when capabilities.pause
 *   setSpeed(multiplier: number): void // when capabilities.speed
 *   seek?(ms: number): void          // when capabilities.seek (replay)
 * }
 * Base class: subscriber bookkeeping + defaults. Implementations: MockSource, ReplaySource, WebSocketSource.
 */
class EventSource {
  constructor() {
    this._subs = new Set();
    this.capabilities = { pause: false, speed: false, seek: false };
    this.paused = false;
    this.speed = 1;
    this.ended = false;
  }
  subscribe(fn) { this._subs.add(fn); return () => this._subs.delete(fn); }
  _emit(e) { for (const fn of this._subs) fn(e); }
  start() {}
  stop() {}
  update(_realDtMs) {}
  now() { return 0; }
  setPaused(p) { if (this.capabilities.pause) this.paused = !!p; }
  setSpeed(x) { if (this.capabilities.speed) this.speed = x; }
}

/**
 * interface CommandSink {
 *   send(command): Promise<{ ok: boolean, message?: string }>
 * }
 * command = { id, type, issuedAt, agentIds: string[], target?: Ref | {kind:'territory', id}, payload? }
 * types   = assign_task | use_tool | move | recall | pause | resume | terminate | duplicate | migrate
 */
const COMMAND_TYPES = Object.freeze(['assign_task', 'use_tool', 'move', 'recall', 'pause', 'resume', 'terminate', 'duplicate', 'migrate']);
class CommandSink {
  send(_cmd) { return Promise.resolve({ ok: false, message: 'No command sink connected' }); }
}
let _cmdSeq = 0;
function makeCommand(type, agentIds, target, payload) {
  if (!COMMAND_TYPES.includes(type)) throw new Error('Unknown command type: ' + type);
  return { id: 'c' + (++_cmdSeq), type, issuedAt: Date.now(), agentIds: [...agentIds], target: target || null, payload: payload || {} };
}

/* =====================================================================================
 *  SECTION 1b · HOST — the plugin side of agnostic's host bridge (ADR 0005)
 *
 *  Framed by the agnostic shell, this page runs in an opaque origin with connect-src 'none': it
 *  cannot reach the API. It asks the shell by postMessage, and the shell answers only what this
 *  plugin's manifest permits, with the signed-in user's own credential (which the page never
 *  sees) — and the server still checks that user's role. Protocol 1:
 *
 *     page  → shell   {type:'agnostic:hello', protocol}
 *     shell → page    {type:'agnostic:init', protocol, plugin:{id,name,version}, permissions[], user:{auth, signedIn, role}}
 *     page  → shell   {type:'agnostic:request', id, method, path, body?}
 *     shell → page    {type:'agnostic:response', id, status, data}     status 0 = never reached the server
 *
 *  The shell re-sends init after a sign-in or sign-out. Opened on its own (a new tab) there is no
 *  shell: `mode` is 'standalone', and the page keeps its swarms in this browser instead.
 *
 *  Since agnostic 0.1.9 a request may carry `ifMatch` / `ifNoneMatch` (a document's revision, which
 *  comes back as `etag`) and `idempotencyKey` (a POST that is safe to retry), and its path may
 *  carry a query string — each when the shell lists the feature in `init.features`. The server
 *  checks every bridged request against this plugin's permissions too, not only the shell.
 * ===================================================================================== */
class Host {
  constructor() {
    this.mode = 'connecting';  // 'connecting' | 'connected' | 'standalone'
    this.info = null;          // the latest agnostic:init
    this.pending = new Map();  // request id → {resolve, timer}
    this.seq = 0;
    // A random prefix per page load: request ids restart with every load, and a reply the shell
    // sends after a reload must never match a request of this page that happens to share a number.
    this.prefix = 'q' + randomToken(6) + '-';
    this.listeners = new Set();
    let framed = false;
    try { framed = window.parent !== window; } catch (err) { framed = true; }
    if (!framed) { this.mode = 'standalone'; return; }
    window.addEventListener('message', (e) => this.onMessage(e));
    try { window.parent.postMessage({ type: 'agnostic:hello', protocol: 1 }, '*'); } catch (err) { /* detached */ }
    // A parent that never answers is not the agnostic shell (or is an older one): stand alone.
    this.timer = setTimeout(() => { if (this.mode === 'connecting') this.setMode('standalone'); }, 3000);
  }
  onMessage(e) {
    if (e.source !== window.parent) return;
    const m = e.data;
    if (!m || typeof m !== 'object' || typeof m.type !== 'string') return;
    if (m.type === 'agnostic:init') {
      const u = m.user && typeof m.user === 'object' ? m.user : {};
      this.info = {
        plugin: m.plugin && typeof m.plugin === 'object' ? m.plugin : {},
        permissions: Array.isArray(m.permissions) ? m.permissions.filter((x) => typeof x === 'string') : [],
        features: Array.isArray(m.features) ? m.features.filter((x) => typeof x === 'string') : [],
        user: { auth: typeof u.auth === 'string' ? u.auth : 'unknown', signedIn: !!u.signedIn, role: typeof u.role === 'string' ? u.role : null },
      };
      clearTimeout(this.timer);
      this.setMode('connected');
    } else if (m.type === 'agnostic:response') {
      const r = this.pending.get(m.id);
      if (!r) return;
      this.pending.delete(m.id);
      clearTimeout(r.timer);
      r.resolve({ status: Number.isInteger(m.status) ? m.status : 0, data: m.data === undefined ? null : m.data, etag: typeof m.etag === 'string' ? m.etag : null });
    }
  }
  setMode(mode) { this.mode = mode; for (const fn of this.listeners) fn(this); }
  onChange(fn) { this.listeners.add(fn); return () => this.listeners.delete(fn); }
  can(permission) { return this.mode === 'connected' && this.info.permissions.includes(permission); }
  /** Whether the shell's bridge carries `feature` ('query' | 'revisions' | 'idempotency'). */
  has(feature) { return this.mode === 'connected' && this.info.features.includes(feature); }
  pluginId() { return (this.info && typeof this.info.plugin.id === 'string' && this.info.plugin.id) || 'swarm'; }
  /** The user's role when the server enforces roles; null when auth is off or unknown. */
  role() { return this.info && this.info.user.auth === 'required' ? this.info.user.role : null; }
  /** Whether the user may write at all (start crews, save swarms): any role but viewer. */
  mayWrite() { return this.mode === 'connected' && this.role() !== 'viewer'; }
  /** `opts`: {ifMatch, ifNoneMatch, idempotencyKey}, each sent only when the shell carries it. */
  request(method, path, body, opts) {
    if (this.mode !== 'connected') return Promise.resolve({ status: 0, data: { error: 'not connected to agnostic' }, etag: null });
    const id = this.prefix + ++this.seq;
    return new Promise((resolve) => {
      const timer = setTimeout(() => { if (this.pending.delete(id)) resolve({ status: 0, data: { error: 'the shell did not answer' }, etag: null }); }, 30000);
      this.pending.set(id, { resolve, timer });
      const msg = { type: 'agnostic:request', id, method, path };
      if (body !== undefined) msg.body = body;
      const o = opts || {};
      if (o.ifMatch && this.has('revisions')) msg.ifMatch = o.ifMatch;
      if (o.ifNoneMatch && this.has('revisions')) msg.ifNoneMatch = o.ifNoneMatch;
      if (o.idempotencyKey && this.has('idempotency')) msg.idempotencyKey = o.idempotencyKey;
      try { window.parent.postMessage(msg, '*'); } catch (err) { this.pending.delete(id); clearTimeout(timer); resolve({ status: 0, data: { error: 'the shell is gone' }, etag: null }); }
    });
  }
}
/** The error text of a bridge response. */
function errOf(r) {
  if (r && r.data && typeof r.data.error === 'string') return r.data.error;
  return r && r.status ? 'HTTP ' + r.status : 'the server is unreachable';
}

/* =====================================================================================
 *  SECTION 2 · SIM — world, scenarios and the deterministic simulator
 *  Everything in this section is private to the MockSource. The view never imports it.
 * ===================================================================================== */

/** Mock model catalogue: blended $ per 1k tokens and a throughput factor. Numbers are illustrative. */
const SIM_MODELS = {
  'lg-reasoner': { price: 0.0120, tps: 0.9 },
  'md-general':  { price: 0.0030, tps: 1.1 },
  'md-coder':    { price: 0.0030, tps: 1.25 },
  'sm-fast':     { price: 0.0006, tps: 1.5 },
  'local-8b':    { price: 0.0000, tps: 0.8 },
};
const ROLE_MODEL = {
  orchestrator: 'lg-reasoner', planner: 'lg-reasoner', researcher: 'md-general', coder: 'md-coder', reviewer: 'lg-reasoner', runner: 'sm-fast',
};
/** Tokens/sec while \"thinking\" at a task, per role (before model factor). */
const ROLE_TPS = { orchestrator: 300, planner: 700, researcher: 520, coder: 820, reviewer: 600, runner: 220 };
/** How likely a role is to go use a tool at each decision point, and which tools it favours. */
const ROLE_TOOL_P = { planner: 0.35, researcher: 0.6, coder: 0.45, reviewer: 0.42, runner: 0.65 };
const ROLE_TOOLS = {
  planner:    { llm: 6, fs: 2, db: 2 },
  researcher: { search: 7, llm: 3, db: 1 },
  coder:      { fs: 4, exec: 4, llm: 3 },
  reviewer:   { fs: 3, exec: 3, llm: 4 },
  runner:     { exec: 5, db: 4, fs: 2 },
};
const TOOL_MS = { llm: [1300, 3000], search: [900, 2100], exec: [1100, 3400], db: [500, 1500], fs: [350, 900] };

function buildWorld(scale) {
  const territories = [
    { id: 'local',    name: 'Local',      region: 'your machine',  kind: 'local', cap: 28 * scale, costPerSec: 0.00002, speed: 0.85,
      latencyMs: { 'us-east': 32, 'eu-west': 88, 'ap-south': 205 } },
    { id: 'us-east',  name: 'us-east-1',  region: 'N. Virginia',   kind: 'cloud', cap: 90 * scale, costPerSec: 0.0012, speed: 1.10,
      latencyMs: { local: 32, 'eu-west': 74, 'ap-south': 190 } },
    { id: 'eu-west',  name: 'eu-west-1',  region: 'Ireland',       kind: 'cloud', cap: 70 * scale, costPerSec: 0.0014, speed: 1.15,
      latencyMs: { local: 88, 'us-east': 74, 'ap-south': 120 } },
    { id: 'ap-south', name: 'ap-south-1', region: 'Mumbai',        kind: 'cloud', cap: 60 * scale, costPerSec: 0.0009, speed: 1.05,
      latencyMs: { local: 205, 'us-east': 190, 'eu-west': 120 } },
  ];
  const T = (territory, kind, name) => ({ id: territory + '.' + kind, kind, name, territory });
  const tools = [
    T('local', 'fs', 'File System'), T('local', 'exec', 'Code Exec · sandbox'), T('local', 'llm', 'LLM · local-8b'),
    T('us-east', 'llm', 'LLM Endpoint'), T('us-east', 'search', 'Web Search'), T('us-east', 'db', 'Postgres'), T('us-east', 'exec', 'Code Exec · CI'),
    T('eu-west', 'llm', 'LLM Endpoint'), T('eu-west', 'search', 'Web Search'), T('eu-west', 'exec', 'Code Exec · CI'), T('eu-west', 'fs', 'Object Store'),
    T('ap-south', 'llm', 'LLM Endpoint'), T('ap-south', 'search', 'Web Search'), T('ap-south', 'db', 'Vector DB'),
  ];
  return { territories, tools };
}

/* ---- scenario vocabulary helpers ---- */
const FILE_STEMS = ['index', 'service', 'handlers', 'types', 'client', 'store', 'schema', 'routes', 'middleware', 'hooks', 'validators', 'adapter', 'queue', 'cache'];
function filesFor(rng, mod, n) {
  const stems = rng.shuffle(FILE_STEMS.slice());
  const out = [];
  for (let i = 0; i < n; i++) out.push(mod + '/' + stems[i % stems.length] + (i >= stems.length ? i : '') + '.ts');
  return out;
}

/**
 * Scenario = mission metadata + policy knobs + a task-graph builder.
 * Task spec: { key, title, role, territory, deps:[keys], work (agent-seconds), kind, priority, difficulty?,
 *              fanout?: { role, titles:[...], work:[min,max] }   — the lead agent splits the task into sub-agents
 *              rework?: { chance, role, work:[min,max], title } — review may bounce work back to a fresh agent }
 */
const SCENARIOS = {
  refactor: {
    key: 'refactor', icon: '⟨/⟩', name: 'Refactor a codebase',
    desc: 'The orchestrator maps the repo, drafts a plan, then fans Coders out across every module and file. Reviewers trail behind each module; the test suite shards out to cloud CI at the end.',
    tags: ['Coder fan-out', 'Local-first', 'Reviewers trail'],
    objective: 'Migrate the monorepo from callbacks to async/await and split the god-modules',
    budget: 11,
    policy: { spawnPerSec: 5, toolErr: 0.035, crash: 0.012, slow: 0.04, maxRetries: 2, idleReleaseMs: 3500 },
    build(rng, scale) {
      const MODS = ['auth', 'billing', 'api/routes', 'db/models', 'ui/components', 'payments', 'notifications', 'search', 'analytics', 'config', 'cli', 'workers',
        'media', 'i18n', 'feature-flags', 'webhooks', 'admin', 'reporting', 'sessions', 'audit', 'exports', 'imports', 'scheduler', 'mailer', 'gateway', 'sdk', 'infra', 'metrics', 'tracing', 'docs'];
      const nMods = Math.min(MODS.length, 10 * scale);
      const placeFor = (i) => (i < 4 * scale ? 'local' : i < 7 * scale ? 'us-east' : i < 9 * scale ? 'eu-west' : 'ap-south');
      const tasks = [
        { key: 'scan', title: 'Index repo & map dependency graph', role: 'planner', territory: 'local', deps: [], work: 4, kind: 'analysis', priority: 3 },
        { key: 'plan', title: 'Draft refactor plan (RFC)', role: 'planner', territory: 'local', deps: ['scan'], work: 4, kind: 'plan', priority: 3 },
      ];
      const reviews = [];
      for (let i = 0; i < nMods; i++) {
        const m = MODS[i];
        const terr = placeFor(i);
        tasks.push({ key: 'mod' + i, title: 'Refactor ' + m + '/', role: 'coder', territory: terr, deps: ['plan'], work: 4, kind: 'code', priority: 2,
          fanout: { role: 'coder', titles: filesFor(rng, m, rng.int(3, 6) + (scale >= 3 ? 3 : 0)).map((f) => 'Edit ' + f), work: [9, 15] } });
        tasks.push({ key: 'rev' + i, title: 'Review ' + m + '/ diff', role: 'reviewer', territory: terr, deps: ['mod' + i], work: 9, kind: 'review', priority: 2,
          rework: { chance: 0.3, role: 'coder', work: [5, 8], title: 'Address review: ' + m + '/' } });
        reviews.push('rev' + i);
      }
      tasks.push({ key: 'legacy', title: 'Port legacy/xml-rpc bridge', role: 'coder', territory: 'local', deps: ['plan'], work: 10, kind: 'code', priority: 1, difficulty: 40 });
      tasks.push({ key: 'tests', title: 'Run full test suite', role: 'runner', territory: 'us-east', deps: reviews, work: 4, kind: 'test', priority: 2,
        fanout: { role: 'runner', titles: Array.from({ length: 4 * scale }, (_, i) => 'Test shard ' + (i + 1) + '/' + 4 * scale), work: [8, 12] } });
      tasks.push({ key: 'pr', title: 'Write migration notes & open PR', role: 'planner', territory: 'local', deps: ['tests'], work: 7, kind: 'report', priority: 3 });
      return tasks;
    },
  },

  research: {
    key: 'research', icon: '⌕', name: 'Research sweep',
    desc: 'Researchers spread out across Web Search endpoints in every cloud region, each topic splitting into parallel queries. Planners synthesize pairs of findings; a reviewer cross-checks citations before the final brief.',
    tags: ['Researcher spread', 'Multi-region', 'Synthesis'],
    objective: 'Produce a cited landscape brief on production multi-agent systems',
    budget: 10,
    policy: { spawnPerSec: 4, toolErr: 0.04, crash: 0.01, slow: 0.06, maxRetries: 2, idleReleaseMs: 3500 },
    build(rng, scale) {
      const TOPICS = ['Agent orchestration frameworks', 'Vector DB benchmarks', 'Long-context evals', 'Tool-use reliability', 'Inference cost & latency',
        'Sandboxing practices', 'Multi-agent memory', 'Open-weight landscape', 'Guardrail tooling', 'Observability stacks', 'Prompt caching', 'Eval harnesses',
        'Retrieval quality', 'Distillation', 'Speculative decoding', 'Agent UX patterns', 'Model routing', 'Data governance', 'Fine-tuning ops', 'Red-teaming',
        'Edge inference', 'Batch APIs', 'Structured outputs', 'Code agents'];
      const REGIONS = ['us-east', 'eu-west', 'ap-south'];
      const nTopics = Math.min(TOPICS.length, 8 * scale);
      const tasks = [{ key: 'frame', title: 'Frame research questions', role: 'planner', territory: 'local', deps: [], work: 4, kind: 'plan', priority: 3 }];
      const QUAL = ['benchmarks', 'failure modes', 'pricing', 'adoption', 'papers 2025–26', 'case studies', 'limitations', 'tooling'];
      for (let i = 0; i < nTopics; i++) {
        const tp = TOPICS[i];
        const qs = rng.shuffle(QUAL.slice()).slice(0, rng.int(3, 5) + (scale >= 3 ? 2 : 0)).map((q) => 'Query: ' + tp.toLowerCase() + ' ' + q);
        tasks.push({ key: 'sv' + i, title: 'Survey: ' + tp, role: 'researcher', territory: REGIONS[i % 3], deps: ['frame'], work: 3, kind: 'research', priority: 2,
          fanout: { role: 'researcher', titles: qs, work: [10, 16] } });
      }
      const syn = [];
      for (let i = 0; i < nTopics; i += 2) {
        const deps = ['sv' + i];
        if (i + 1 < nTopics) deps.push('sv' + (i + 1));
        tasks.push({ key: 'syn' + i, title: 'Synthesize: ' + TOPICS[i] + (i + 1 < nTopics ? ' + ' + TOPICS[i + 1] : ''), role: 'planner',
          territory: i % 4 === 0 ? 'local' : 'us-east', deps, work: 13, kind: 'synthesis', priority: 2 });
        syn.push('syn' + i);
      }
      tasks.push({ key: 'paywall', title: 'Scrape paywalled benchmark tables', role: 'researcher', territory: 'eu-west', deps: ['frame'], work: 10, kind: 'research', priority: 1, difficulty: 30 });
      tasks.push({ key: 'kb', title: 'Store findings in knowledge base', role: 'runner', territory: 'ap-south', deps: syn.slice(0, Math.ceil(syn.length / 2)), work: 9, kind: 'data', priority: 1 });
      tasks.push({ key: 'check', title: 'Cross-check citations', role: 'reviewer', territory: 'us-east', deps: syn, work: 3, kind: 'review', priority: 2,
        fanout: { role: 'reviewer', titles: Array.from({ length: 3 * scale }, (_, i) => 'Verify citation batch ' + (i + 1)), work: [7, 10] } });
      tasks.push({ key: 'brief', title: 'Write landscape brief', role: 'planner', territory: 'local', deps: ['check', 'kb'], work: 11, kind: 'report', priority: 3 });
      return tasks;
    },
  },

  incident: {
    key: 'incident', icon: '⚠', name: 'Incident response',
    desc: 'P1: checkout is throwing 5xx. Urgent, rapid spawning across every cloud region at once, higher error rates and flaky slow calls. Diagnose, roll back, hotfix, verify, then write the postmortem.',
    tags: ['Urgent', 'Cloud-heavy', 'High error rate'],
    objective: 'P1 — checkout-svc 5xx spike: restore service and find root cause',
    budget: 8,
    policy: { spawnPerSec: 12, toolErr: 0.09, crash: 0.035, slow: 0.12, maxRetries: 2, idleReleaseMs: 2500, computeMult: 1.8 },
    build(rng, scale) {
      const regions = ['us-east', 'eu-west', 'ap-south'];
      const many = (n, f) => Array.from({ length: n * scale }, (_, i) => f(i));
      return [
        { key: 'triage', title: 'Triage alert: checkout 5xx spike', role: 'planner', territory: 'local', deps: [], work: 3, kind: 'triage', priority: 3 },
        { key: 'logs', title: 'Pull error logs (all regions)', role: 'runner', territory: 'us-east', deps: ['triage'], work: 3, kind: 'diagnose', priority: 3,
          fanout: { role: 'runner', titles: many(12, (i) => 'Tail logs ' + regions[i % 3] + '-' + 'abcd'[Math.floor(i / 3) % 4]), work: [6, 10] } },
        { key: 'metrics', title: 'Query latency & error metrics', role: 'runner', territory: 'eu-west', deps: ['triage'], work: 3, kind: 'diagnose', priority: 3,
          fanout: { role: 'runner', titles: many(7, (i) => ['p99 latency by route', 'error rate by pod', 'db pool saturation', 'GC pauses', 'upstream timeouts', 'queue depth', 'cache hit rate'][i % 7] + (i >= 7 ? ' #' + (i + 1) : '')), work: [6, 9] } },
        { key: 'deploys', title: 'Diff last 3 deploys', role: 'coder', territory: 'us-east', deps: ['triage'], work: 10, kind: 'code', priority: 3, difficulty: 1.4 },
        { key: 'upstream', title: 'Check upstream payments API', role: 'researcher', territory: 'ap-south', deps: ['triage'], work: 3, kind: 'research', priority: 2,
          fanout: { role: 'researcher', titles: many(4, (i) => ['Provider status pages', 'Recent API changelog', 'Community reports', 'SDK issue tracker'][i % 4] + (i >= 4 ? ' #' + (i + 1) : '')), work: [6, 9] } },
        { key: 'snapshot', title: 'Snapshot DB & queue state', role: 'runner', territory: 'ap-south', deps: ['triage'], work: 3, kind: 'ops', priority: 2,
          fanout: { role: 'runner', titles: many(6, (i) => ['orders db', 'payments queue', 'session cache', 'webhook backlog', 'feature flags', 'pod events'][i % 6] + (i >= 6 ? ' #' + (i + 1) : '')), work: [5, 8] } },
        { key: 'consumer', title: 'Restart payment-webhook consumer', role: 'runner', territory: 'eu-west', deps: ['triage'], work: 8, kind: 'ops', priority: 1, difficulty: 14 },
        { key: 'status', title: 'Post status page update', role: 'planner', territory: 'local', deps: ['triage'], work: 5, kind: 'comms', priority: 1 },
        { key: 'rca', title: 'Root-cause hypothesis', role: 'planner', territory: 'us-east', deps: ['logs', 'metrics', 'deploys', 'upstream', 'snapshot'], work: 11, kind: 'analysis', priority: 3, difficulty: 1.5 },
        { key: 'rollback', title: 'Roll back checkout-svc v2.41', role: 'runner', territory: 'us-east', deps: ['rca'], work: 3, kind: 'ops', priority: 3,
          fanout: { role: 'runner', titles: many(9, (i) => 'Rollback ' + regions[i % 3] + ' wave ' + (Math.floor(i / 3) + 1)), work: [6, 9] } },
        { key: 'hotfix', title: 'Hotfix: connection-pool leak', role: 'coder', territory: 'eu-west', deps: ['rca'], work: 3, kind: 'code', priority: 3,
          fanout: { role: 'coder', titles: many(6, (i) => ['Patch pool release path', 'Add timeout guard', 'Regression test', 'Bump client lib', 'Canary config', 'Load test replay'][i % 6] + (i >= 6 ? ' (' + (i + 1) + ')' : '')), work: [8, 12] } },
        { key: 'comms', title: 'Customer comms draft', role: 'planner', territory: 'local', deps: ['rca'], work: 7, kind: 'comms', priority: 1 },
        { key: 'verify', title: 'Verify recovery (synthetic checks)', role: 'reviewer', territory: 'ap-south', deps: ['rollback', 'hotfix'], work: 3, kind: 'verify', priority: 3,
          fanout: { role: 'reviewer', titles: many(9, (i) => 'Synthetic checkout ' + regions[i % 3] + ' #' + (Math.floor(i / 3) + 1)), work: [6, 9] } },
        { key: 'pm', title: 'Draft postmortem', role: 'planner', territory: 'local', deps: ['verify', 'comms'], work: 11, kind: 'report', priority: 2 },
      ];
    },
  },
};

/**
 * Sim — seeded, fixed-timestep simulator of an orchestrated agent swarm.
 * Emits schema events through `this.out(event)`; accepts commands via `command(cmd)`.
 * It has no notion of pixels: travel is expressed as durations derived from a latency matrix.
 *
 * `scenario` is {key, name, objective, budget, policy, mission?, build(rng, scale)} and `cfg` is the
 * rest of a compiled swarm spec (compileSpec): the world, model catalogue, per-role models, speeds,
 * tool habits, tool latencies/token sizes, and the role and swarm-wide agent caps.
 */
class Sim {
  constructor(scenario, { seed = 1337, scale = 1, cfg = null } = {}) {
    this.sc = scenario;
    this.seed = seed;
    this.scale = scale;
    this.policy = scenario.policy;
    this.cfg = cfg || compileSpec(defaultSpec(scenario.key, scale)).cfg;
    this.rng = new RNG((seed ^ hashStr(scenario.key)) >>> 0);
    this.world = this.cfg.world;
    this.terr = new Map(this.world.territories.map((t) => [t.id, { ...t, active: 0, tokens: 0, cost: 0 }]));
    this.tools = new Map(this.world.tools.map((t) => [t.id, { ...t }]));
    this.t = 0;
    this.dt = 50;
    this.out = () => {};
    this.evSeq = 0;
    this.agentSeq = 0;
    this.roleSeq = {};
    this.agents = new Map();
    this.tasks = new Map();
    this.taskByKey = new Map();
    this.planQueue = [];
    this.retryQueue = [];
    this.fanQueue = [];
    this.resv = {};
    this.spawnBucket = 2;
    this.totals = { tokens: 0, cost: 0 };
    this.rateHist = [];
    this.nextResTick = 0;
    this.nextStaff = 0;
    this.nextOrchNote = 0;
    this.phase = 'boot';
    this.done = false;
    this.stats = { spawned: 0, retries: 0, errors: 0, crashes: 0, peak: 0, tasksDone: 0, tasksFailed: 0 };
    this.orch = null;
    this.headless = false;     // the estimator: no one is watching, so a stall must end the run
    this.stalled = false;
    this.lastProgressT = 0;
    this.capWait = null;       // {role|'swarm': tasks waiting} from the last staffing pass
  }

  /* ---------------- event emission ---------------- */
  emit(type, agentId, taskId, territory, payload) {
    const e = { id: 'e' + ++this.evSeq, type, timestamp: Math.round(this.t), territory: territory || 'global', payload: payload || {} };
    if (agentId) e.agentId = agentId;
    if (taskId) e.taskId = taskId;
    this.out(e);
  }
  say(a, state, step, extra) {
    this.emit('agent.state_changed', a.id, null, a.territory, Object.assign({ state, step }, extra || {}));
  }

  /* ---------------- geometry-free travel model ---------------- */
  latency(a, b) { return a === b ? 0 : (this.terr.get(a).latencyMs[b] || 150); }
  refTerritory(ref) {
    if (!ref) return 'local';
    switch (ref.kind) {
      case 'hq': return 'local';
      case 'gateway': return ref.id;
      case 'tool': return this.tools.get(ref.id).territory;
      case 'task': return this.tasks.get(ref.id).territory;
      case 'agent': { const o = this.agents.get(ref.id); return o ? o.territory : 'local'; }
      default: return ref.territory || 'local';
    }
  }
  sameRef(a, b) { return !!a && !!b && a.kind === b.kind && a.id === b.id && a.kind !== 'point'; }
  isNear(from, to) {
    if (!from || !to || from.kind !== 'task' || to.kind !== 'task') return false;
    const A = this.tasks.get(from.id), B = this.tasks.get(to.id);
    return !!A && !!B && (A.parentId === B.id || B.parentId === A.id || (A.parentId && A.parentId === B.parentId));
  }
  travelMs(fromTerr, from, to) {
    const toTerr = this.refTerritory(to);
    if (fromTerr !== toTerr) return 1100 + this.latency(fromTerr, toTerr) * 16 + this.rng.range(0, 300);
    if (this.isNear(from, to)) return 650 + this.rng.range(0, 250);
    return 1100 + this.rng.range(0, 700);
  }
  msgMs(a, b) {
    const ta = a ? a.territory : 'local', tb = b ? b.territory : 'local';
    return ta === tb ? 450 + this.rng.range(0, 350) : 800 + this.latency(ta, tb) * 7;
  }

  /* ---------------- lifecycle ---------------- */
  start() {
    const orch = this.spawnAgent('orchestrator', 'local', { kind: 'hq' }, {
      name: 'Orchestrator',
      extra: {
        mission: Object.assign({ title: this.sc.name, scenario: this.sc.key, objective: this.sc.objective, budget: this.sc.budget, seed: this.seed, kind: 'sim' }, this.sc.mission || {}),
        world: this.world,
      },
    });
    this.orch = orch;
    orch.phase = 'orch';
    const specs = this.sc.build(this.rng, this.scale);
    this.planQueue = specs.map((s, i) => ({ at: 700 + i * Math.max(45, 110 / this.scale), spec: s }));
    this.say(orch, 'working', 'Decomposing mission: ' + this.sc.objective, { expectedMs: 700 + specs.length * 110 / this.scale });
    this.phase = 'plan';
  }

  /** Advance one fixed tick. */
  step() {
    if (this.done) return;
    const dt = this.dt;
    this.t += dt;
    if (this.phase === 'plan') this.tickPlanning();
    this.spawnBucket = Math.min(4, this.spawnBucket + (this.policy.spawnPerSec * dt) / 1000);
    this.tickFan();
    for (const a of this.agents.values()) if (a.alive) this.tickAgent(a, dt);
    if (this.t >= this.nextStaff) { this.nextStaff = this.t + 250; this.tickOrchestrator(); }
    this.tickProgressEvents();
    if (this.t >= this.nextResTick) { this.nextResTick = this.t + 500; this.emitResources(); }
    // sweep dead agents occasionally
    if ((this.t % 2000) < dt) for (const [id, a] of this.agents) if (!a.alive && this.t - a.endedAt > 1000) this.agents.delete(id);
    // Headless only: a swarm whose caps leave some work unstaffable would otherwise run forever.
    // On screen the operator can see the queue and act, so nothing is failed for them.
    if (this.headless && this.phase === 'run' && this.t - this.lastProgressT > SIM_STALL_MS) this.failStalled();
  }

  /** End a run that has stopped making progress: fail everything unresolved, then wrap up. */
  failStalled() {
    this.stalled = true;
    for (const task of this.tasks.values()) if (!this.resolved(task) && !task.parentId) this.failTask(task, 'Stalled — no agent could be staffed (check the role and region caps)');
    for (const task of this.tasks.values()) if (!this.resolved(task)) this.failTask(task, 'Stalled');
  }

  tickPlanning() {
    while (this.planQueue.length && this.planQueue[0].at <= this.t) this.createTask(this.planQueue.shift().spec);
    if (!this.planQueue.length) {
      this.phase = 'run';
      this.lastProgressT = this.t;
      this.say(this.orch, 'working', 'Dispatching agents', { expectedMs: 0 });
    }
  }

  /* ---------------- tasks ---------------- */
  createTask(spec, parent) {
    const id = parent ? parent.id + '.' + (parent.children.length + 1) : 't-' + spec.key;
    const deps = (spec.deps || []).map((k) => this.taskByKey.get(k)).filter(Boolean);
    const depth = parent ? parent.depth : deps.reduce((m, d) => Math.max(m, d.depth + 1), 0);
    const task = {
      id, key: spec.key || id, title: spec.title, role: spec.role, territory: spec.territory, kind: spec.kind || 'work',
      deps: deps.map((d) => d.id), dependents: [], parentId: parent ? parent.id : null, children: [],
      work: spec.work, own: 0, priority: spec.priority || 1, difficulty: spec.difficulty || 1,
      fanout: spec.fanout || null, rework: spec.rework || null, split: false, reworked: false,
      status: 'locked', assignees: new Set(), lead: null, attempts: 0, depth, createdAt: this.t, startedAt: 0,
      lastProgP: -1, lastProgT: 0, progress: 0, retryPending: false,
    };
    for (const d of deps) d.dependents.push(task.id);
    if (deps.every((d) => d.status === 'done' || d.status === 'failed')) task.status = 'pending';
    this.tasks.set(id, task);
    this.taskByKey.set(task.key, task);
    if (parent) parent.children.push(id);
    const payload = { title: task.title, role: task.role, deps: task.deps, depth, work: task.work, kind: task.kind, priority: task.priority };
    if (parent) Object.assign(payload, { parentId: parent.id, index: spec.index, of: spec.of });
    this.emit('task.created', null, id, task.territory, payload);
    return task;
  }
  resolved(task) { return task.status === 'done' || task.status === 'failed'; }
  kidsResolved(task) { return task.children.every((c) => this.resolved(this.tasks.get(c))); }
  liveAssignees(task) {
    let n = 0;
    for (const id of task.assignees) { const a = this.agents.get(id); if (a && a.alive) n++; }
    return n;
  }
  calcProgress(task) {
    const own = clamp(task.own / task.work, 0, 1);
    if (!task.children.length || task.reworked) return task.reworked && !this.kidsResolved(task) ? Math.min(own, 0.9) : own;
    const kids = task.children.filter((c) => this.resolved(this.tasks.get(c))).length / task.children.length;
    return 0.3 * own + 0.7 * kids;
  }
  tickProgressEvents() {
    for (const task of this.tasks.values()) {
      if (task.status !== 'active' && task.status !== 'pending') continue;
      const p = this.calcProgress(task);
      task.progress = p;
      if (p !== task.lastProgP && (this.t - task.lastProgT >= 1000 || (Math.abs(p - task.lastProgP) >= 0.03 && this.t - task.lastProgT >= 400))) {
        task.lastProgP = p;
        task.lastProgT = this.t;
        this.emit('task.progress', null, task.id, task.territory, { progress: +p.toFixed(4) });
      }
    }
  }
  assign(a, task, mode) {
    if (a.taskId && a.taskId !== task.id) this.unassign(a, false);
    a.taskId = task.id;
    task.assignees.add(a.id);
    if (!task.lead || !this.agents.get(task.lead) || !this.agents.get(task.lead).alive) task.lead = a.id;
    if (task.status === 'pending') { task.status = 'active'; if (!task.startedAt) task.startedAt = this.t; }
    task.retryPending = false;
    this.emit('task.assigned', a.id, task.id, task.territory, { mode });
  }
  unassign(a, announce = true) {
    const task = a.taskId && this.tasks.get(a.taskId);
    a.taskId = null;
    if (!task) return;
    task.assignees.delete(a.id);
    if (task.lead === a.id) task.lead = [...task.assignees][0] || null;
    if (!this.resolved(task) && this.liveAssignees(task) === 0 && task.status === 'active') task.status = 'pending';
    if (announce) this.say(a, a.phase === 'moving' ? 'moving' : 'idle', 'Released task', { taskId: null });
  }
  completeTask(task) {
    if (this.resolved(task)) return;
    task.status = 'done';
    task.own = task.work;
    task.progress = 1;
    this.stats.tasksDone++;
    this.lastProgressT = this.t;
    const dur = this.t - (task.startedAt || task.createdAt);
    this.emit('task.completed', task.lead, task.id, task.territory, { result: this.resultText(task), durationMs: Math.round(dur) });
    const parent = task.parentId && this.tasks.get(task.parentId);
    const lead = parent && parent.lead && this.agents.get(parent.lead);
    for (const id of [...task.assignees]) {
      const a = this.agents.get(id);
      if (!a || !a.alive) continue;
      const to = lead && lead.alive ? lead : this.orch;
      this.message(a, to, 'result', 'Done: ' + task.title);
      a.taskId = null;
      if (a.parentId && parent) this.finishAgent(a, 'Subtask complete: ' + task.title);
      else this.think(a);
    }
    task.assignees.clear();
    if (parent && this.kidsResolved(parent) && lead && lead.alive && lead.phase === 'coord') this.think(lead);
    this.unlockDependents(task);
  }
  failTask(task, reason) {
    if (this.resolved(task)) return;
    task.status = 'failed';
    this.stats.tasksFailed++;
    this.lastProgressT = this.t;
    this.emit('task.failed', null, task.id, task.territory, { reason, attempts: task.attempts });
    for (const c of task.children) { const ch = this.tasks.get(c); if (!this.resolved(ch)) this.failTask(ch, 'Parent task failed'); }
    for (const id of [...task.assignees]) { const a = this.agents.get(id); if (a && a.alive) { a.taskId = null; this.think(a); } }
    task.assignees.clear();
    const parent = task.parentId && this.tasks.get(task.parentId);
    if (parent && this.kidsResolved(parent)) { const l = this.agents.get(parent.lead); if (l && l.alive) this.think(l); }
    this.unlockDependents(task);
  }
  unlockDependents(task) {
    for (const did of task.dependents) {
      const d = this.tasks.get(did);
      if (d.status === 'locked' && d.deps.every((x) => this.resolved(this.tasks.get(x)))) d.status = 'pending';
    }
  }
  resultText(task) {
    const r = this.rng;
    switch (task.kind) {
      case 'code': return r.int(40, 400) + ' lines changed, ' + r.int(0, 3) + ' TODOs';
      case 'review': return task.reworked ? 'Approved after changes' : 'Approved (' + r.int(1, 6) + ' nits)';
      case 'test': return r.int(800, 2400) + ' passed, 0 failed';
      case 'research': return r.int(6, 18) + ' sources, ' + r.int(10, 40) + ' claims';
      case 'synthesis': return r.int(3, 7) + ' key findings';
      case 'diagnose': return r.int(2, 9) + ' anomalies flagged';
      default: return 'OK';
    }
  }

  /* ---------------- agents ---------------- */
  spawnAgent(role, territory, spawnAt, opts = {}) {
    const n = (this.roleSeq[role] = (this.roleSeq[role] || 0) + 1);
    const id = role === 'orchestrator' ? 'orch' : 'a' + ++this.agentSeq;
    const name = opts.name || ROLES[role].label + '-' + String(n).padStart(2, '0');
    const model = (territory === 'local' && this.cfg.roleLocalModel[role]) || this.cfg.roleModel[role] || 'unknown';
    const a = {
      id, name, role, model, territory, parentId: opts.parentId || null, taskId: null, held: false,
      phase: 'spawning', phaseEnd: this.t + 450, loc: spawnAt.kind === 'agent' ? this.agents.get(spawnAt.id).loc : spawnAt, dest: null,
      pendingTool: null, forcedTool: null, sinceTool: 1, tokens: 0, cost: 0, health: 100, errors: 0, idleSince: this.t, idleGrace: 0,
      alive: true, endedAt: 0, paused: null, crashAt: 0, dirty: true, retryOf: opts.retryOf || null,
    };
    this.agents.set(id, a);
    // The orchestrator holds no agent slot: a region's cap counts the agents doing the work.
    if (role !== 'orchestrator') {
      this.terr.get(territory).active++;
      this.stats.spawned++;
      let active = 0;
      for (const t of this.terr.values()) active += t.active;
      this.stats.peak = Math.max(this.stats.peak, active);
    }
    this.emit('agent.spawned', id, null, territory, Object.assign({
      name, role, model, parentId: a.parentId, spawnAt, retryOf: a.retryOf, health: 100,
    }, opts.extra || {}));
    return a;
  }
  finishAgent(a, result) {
    if (!a.alive) return;
    this.say(a, 'done', result);
    this.emit('agent.completed', a.id, null, a.territory, { result, tokens: Math.round(a.tokens), cost: +a.cost.toFixed(4) });
    this.removeAgent(a);
  }
  removeAgent(a) {
    if (a.taskId) this.unassign(a, false);
    a.alive = false;
    a.endedAt = this.t;
    if (a.role !== 'orchestrator') this.terr.get(a.territory).active--;
  }
  message(from, to, kind, text) {
    if (!from || !to || !from.alive) return;
    this.emit('agent.message', from.id, from.taskId, from.territory, { to: to.id, kind, text, durationMs: Math.round(this.msgMs(from, to)) });
  }

  /* ---------------- orchestrator ---------------- */
  tickOrchestrator() {
    const orch = this.orch;
    if (this.phase === 'run' || this.phase === 'plan') {
      const hc = this.headcount();
      // Retries respawn at HQ — when the caps allow; otherwise the task is staffed like any other later.
      while (this.retryQueue.length && this.retryQueue[0].at <= this.t) {
        const r = this.retryQueue.shift();
        const task = this.tasks.get(r.taskId);
        if (!task || this.resolved(task) || this.liveAssignees(task) > 0) { if (task) task.retryPending = false; continue; }
        if (this.capFull(hc, task.role, task.territory)) { task.retryPending = false; continue; }
        const a = this.spawnAgent(task.role, task.territory, { kind: 'hq' }, { retryOf: r.retryOf, parentId: r.parentId });
        this.took(hc, task.role, task.territory);
        this.stats.retries++;
        this.assign(a, task, 'retry');
        this.message(orch, a, 'request', 'Retry #' + task.attempts + ': ' + task.title);
      }
      // Staff unassigned work, highest priority first.
      const open = [];
      for (const task of this.tasks.values()) {
        if (task.status === 'pending' && !task.retryPending && this.liveAssignees(task) === 0) open.push(task);
      }
      open.sort((x, y) => y.priority - x.priority || x.createdAt - y.createdAt);
      const wait = {};
      for (const task of open) {
        const idle = this.findIdle(task.role, task.territory);
        if (idle) { this.assign(idle, task, 'auto'); this.message(orch, idle, 'request', 'Assigned: ' + task.title); this.think(idle); continue; }
        const full = this.capFull(hc, task.role, task.territory);
        if (full === 'region') continue; // waits for capacity there, as it always has
        if (full) { wait[full] = (wait[full] || 0) + 1; continue; }
        if (this.spawnBucket < 1) break;
        this.spawnBucket -= 1;
        const parent = task.parentId && this.tasks.get(task.parentId);
        const lead = parent && this.agents.get(parent.lead);
        const at = lead && lead.alive && lead.territory === task.territory ? { kind: 'agent', id: lead.id } : task.territory === 'local' ? { kind: 'hq' } : { kind: 'gateway', id: task.territory };
        const a = this.spawnAgent(task.role, task.territory, at, { parentId: lead && lead.alive ? lead.id : null });
        this.took(hc, task.role, task.territory);
        this.assign(a, task, parent ? 'fanout' : 'auto');
      }
      this.capWait = wait;
      if (this.phase === 'run' && this.t >= this.nextOrchNote) {
        this.nextOrchNote = this.t + 3000;
        let live = 0, done = 0;
        for (const a of this.agents.values()) if (a.alive && a.role !== 'orchestrator') live++;
        for (const t of this.tasks.values()) if (this.resolved(t)) done++;
        const capped = Object.keys(wait).map((k) => wait[k] + ' waiting on the ' + (k === 'swarm' ? 'swarm-wide cap' : ROLES[k].label + ' cap'));
        this.say(orch, 'working', 'Monitoring ' + live + ' agents · ' + done + '/' + this.tasks.size + ' tasks resolved' + (capped.length ? ' · ' + capped.join(', ') : ''));
      }
      if (this.phase === 'run' && [...this.tasks.values()].every((t) => this.resolved(t))) {
        this.phase = 'wrap';
        this.wrapAt = this.t + 2600;
        this.say(orch, 'working', 'Compiling final report', { expectedMs: 2600 });
        for (const a of this.agents.values()) if (a.alive && a !== orch && !a.taskId) this.finishAgent(a, 'Mission complete — released');
      }
    } else if (this.phase === 'wrap' && this.t >= this.wrapAt) {
      for (const a of this.agents.values()) if (a.alive && a !== orch) this.finishAgent(a, 'Mission complete — released');
      const byTerritory = {};
      for (const T of this.terr.values()) byTerritory[T.id] = { tokens: Math.round(T.tokens), cost: +T.cost.toFixed(4) };
      this.say(orch, 'done', 'Mission complete');
      this.emitResources();
      this.emit('agent.completed', orch.id, null, 'local', {
        result: 'Mission complete', tokens: Math.round(orch.tokens), cost: +orch.cost.toFixed(4),
        summary: { durationMs: this.t, tokens: Math.round(this.totals.tokens), cost: +this.totals.cost.toFixed(4), ...this.stats, byTerritory },
      });
      orch.alive = false;
      this.phase = 'done';
      this.done = true;
    }
  }
  findIdle(role, territory) {
    for (const a of this.agents.values()) {
      if (a.alive && a.phase === 'idle' && !a.held && !a.paused && a.role === role && a.territory === territory && !a.parentId) return a;
    }
    return null;
  }
  /**
   * Agents holding a slot under the caps — per role, per region and swarm-wide. A lead coordinating
   * its sub-agents holds none: otherwise a role or region capped at N would deadlock the moment N
   * leads fanned out and sat waiting for sub-agents that need those very slots.
   */
  headcount() {
    const byRole = {}, byTerr = {};
    let total = 0;
    for (const a of this.agents.values()) {
      if (!a.alive || a.role === 'orchestrator' || a.phase === 'coord') continue;
      byRole[a.role] = (byRole[a.role] || 0) + 1;
      byTerr[a.territory] = (byTerr[a.territory] || 0) + 1;
      total++;
    }
    return { byRole, byTerr, total };
  }
  /** Which cap stops one more `role` agent in `territory`: the role's key, 'swarm', 'region', or null. */
  capFull(hc, role, territory) {
    const max = this.cfg.roleCaps[role];
    if (max != null && (hc.byRole[role] || 0) >= max) return role;
    if (this.cfg.maxActive != null && hc.total >= this.cfg.maxActive) return 'swarm';
    const T = territory && this.terr.get(territory);
    if (T && (hc.byTerr[territory] || 0) >= T.cap) return 'region';
    return null;
  }
  took(hc, role, territory) {
    hc.byRole[role] = (hc.byRole[role] || 0) + 1;
    hc.byTerr[territory] = (hc.byTerr[territory] || 0) + 1;
    hc.total++;
  }
  scheduleRetry(task, deadAgent) {
    task.attempts++;
    if (task.attempts > this.policy.maxRetries) { this.failTask(task, 'Exceeded ' + this.policy.maxRetries + ' retries'); return; }
    task.retryPending = true;
    task.own *= task.difficulty > 3 ? 0.25 : 0.85; // fragile tasks lose most context on a crash
    this.retryQueue.push({ at: this.t + 900, taskId: task.id, retryOf: deadAgent.id, parentId: deadAgent.parentId });
    this.retryQueue.sort((x, y) => x.at - y.at);
  }

  /* ---------------- resources ---------------- */
  emitResources() {
    let active = 0, cap = 0;
    const byTerritory = {};
    for (const T of this.terr.values()) {
      active += T.active;
      cap += T.cap;
      byTerritory[T.id] = { active: T.active, cap: T.cap, tokens: Math.round(T.tokens), cost: +T.cost.toFixed(4), costPerSec: 0 };
    }
    this.rateHist.push({ t: this.t, tokens: this.totals.tokens, cost: this.totals.cost, terr: Object.fromEntries([...this.terr.values()].map((T) => [T.id, T.cost])) });
    while (this.rateHist.length > 5) this.rateHist.shift();
    const h0 = this.rateHist[0];
    const span = Math.max(0.001, (this.t - h0.t) / 1000);
    const agents = {};
    for (const a of this.agents.values()) if (a.dirty) { agents[a.id] = [Math.round(a.tokens), +a.cost.toFixed(4)]; a.dirty = false; }
    for (const T of this.terr.values()) byTerritory[T.id].costPerSec = +((T.cost - (h0.terr[T.id] || 0)) / span).toFixed(5);
    this.emit('resource.tick', null, null, 'global', {
      tokens: Math.round(this.totals.tokens), tokensPerSec: Math.round((this.totals.tokens - h0.tokens) / span),
      cost: +this.totals.cost.toFixed(4), costPerSec: +((this.totals.cost - h0.cost) / span).toFixed(5),
      budget: this.sc.budget, active, cap, byTerritory, agents,
    });
  }
}
/** Sim time without a task resolving or advancing after which a headless run is called stalled. */
const SIM_STALL_MS = 120000;

/* ---- Sim · agent behaviour (step machine) ---- */
const TOOL_TOKENS = { llm: [3000, 14000], search: [1500, 6000], db: [300, 2000], exec: [400, 2500], fs: [300, 1800] };
const TOOL_ERRORS = {
  llm: [['429', 'Rate limited (429) — backing off'], ['529', 'Endpoint overloaded (529)']],
  search: [['TIMEOUT', 'Search timed out after 30s'], ['5XX', 'Search provider returned 502']],
  exec: [['EXIT_1', 'Command failed: 3 tests red'], ['OOM', 'Sandbox out of memory']],
  db: [['DEADLOCK', 'Deadlock detected'], ['POOL', 'Connection pool exhausted']],
  fs: [['EACCES', 'Permission denied'], ['ENOENT', 'File not found']],
};
const CRASHES = [['CONTEXT_OVERFLOW', 'Context window exceeded'], ['PANIC', 'Unhandled exception in tool loop'], ['BAD_TOOL', 'Hallucinated a non-existent tool'], ['OOM_KILL', 'Worker OOM-killed']];
const WORK_VERBS = {
  planner: ['Decomposing', 'Drafting', 'Reasoning about', 'Outlining', 'Synthesizing'],
  researcher: ['Reading sources:', 'Extracting claims:', 'Comparing results:', 'Ranking sources:'],
  coder: ['Editing', 'Refactoring', 'Fixing types:', 'Writing tests:', 'Converting callbacks:'],
  reviewer: ['Reviewing', 'Checking edge cases:', 'Annotating', 'Diffing'],
  runner: ['Executing', 'Monitoring job:', 'Parsing output:', 'Collecting artifacts:'],
};

Object.assign(Sim.prototype, {
  accrue(a, tokens, compute) {
    const m = this.cfg.models[a.model];
    const cost = compute + (m ? (tokens / 1000) * m.price : 0);
    a.tokens += tokens;
    a.cost += cost;
    a.dirty = true;
    const T = this.terr.get(a.territory);
    T.tokens += tokens;
    T.cost += cost;
    this.totals.tokens += tokens;
    this.totals.cost += cost;
  },

  tickAgent(a, dt) {
    const T = this.terr.get(a.territory);
    const C = this.cfg;
    let tps = 0, f = 0.5;
    switch (a.phase) {
      case 'working': tps = C.roleTps[a.role] * (C.models[a.model] ? C.models[a.model].tps : 1); f = 1; break;
      case 'coord': tps = C.roleTps[a.role] * 0.2; f = 1; break;
      case 'orch': tps = C.roleTps.orchestrator * (this.phase === 'plan' ? 2 : 0.6); f = 1; break;
      case 'tool': f = 1; break;
      case 'moving': f = 0.8; break;
      case 'paused': f = 0.25; break;
    }
    this.accrue(a, (tps * dt) / 1000, (T.costPerSec * f * (this.policy.computeMult || 1) * dt) / 1000);
    if (a.phase === 'paused' || a.phase === 'orch') return;
    if (a.phase === 'working' && a.taskId) {
      const task = this.tasks.get(a.taskId);
      if (task && !this.resolved(task) && task.status !== 'locked') {
        const eff = a.role === task.role ? 1 : 0.6;
        const cap = this.workCap(task);
        task.own = Math.min(cap, task.own + (dt / 1000) * T.speed * eff);
        this.lastProgressT = this.t;
        if (task.own >= cap - 1e-6) { a.phaseEnd = 0; this.reachedThreshold(a, task); return; }
      }
    }
    if (a.crashAt && this.t >= a.crashAt) {
      a.crashAt = 0;
      const c = this.rng.pick(CRASHES);
      return this.crash(a, c[0], c[1]);
    }
    if (a.phase === 'idle' && !a.held && this.t - a.idleSince > this.policy.idleReleaseMs + a.idleGrace) {
      return this.finishAgent(a, 'Released — no pending work');
    }
    if (a.phaseEnd && this.t >= a.phaseEnd) { a.phaseEnd = 0; this.onPhaseEnd(a); }
  },

  workCap(task) { return task.fanout && !task.split ? task.work * 0.5 : task.work; },

  onPhaseEnd(a) {
    switch (a.phase) {
      case 'moving':
        a.loc = a.dest;
        a.at = this.refTerritory(a.dest);
        a.dest = null;
        if (a.pendingTool && a.loc && a.loc.kind === 'tool' && a.loc.id === a.pendingTool) return this.callTool(a);
        return this.think(a);
      case 'working':
        a.sinceTool++;
        this.chatter(a);
        return this.think(a);
      case 'tool': return this.toolReturn(a);
      default: return this.think(a);
    }
  },

  /** Decide the agent's next step. */
  think(a) {
    if (!a.alive || a.paused || a.role === 'orchestrator') return;
    if (a.forcedTool) { const id = a.forcedTool; a.forcedTool = null; return this.goUseTool(a, null, id); }
    const task = a.taskId && this.tasks.get(a.taskId);
    if (!task || this.resolved(task)) { a.taskId = null; return this.becomeIdle(a); }
    const at = { kind: 'task', id: task.id };
    if (!this.sameRef(a.loc, at)) return this.moveTo(a, at, 'task');
    if (task.status === 'locked') {
      a.phase = 'waiting';
      a.phaseEnd = this.t + 600;
      if (a.lastStep !== 'wait') { a.lastStep = 'wait'; this.say(a, 'idle', 'Waiting on dependencies'); }
      return;
    }
    if (task.status === 'pending') { task.status = 'active'; if (!task.startedAt) task.startedAt = this.t; }
    if ((task.split || task.reworked) && !this.kidsResolved(task)) return this.coordinate(a, task);
    // A lead done coordinating takes a slot again — or waits for one while its role (or the swarm) is
    // at its cap. Whoever holds a slot only ever waits on its own work, so one always frees up.
    if (a.phase === 'coord' && this.capFull(this.headcount(), a.role, a.territory)) return this.awaitSlot(a);
    if (task.own >= this.workCap(task) - 1e-6) return this.reachedThreshold(a, task);
    const mix = this.cfg.roleTools[a.role]; // null when the role uses no tool this world has
    if (mix && a.sinceTool >= 1 && this.rng.chance(this.cfg.toolP[a.role] || 0)) return this.goUseTool(a, this.rng.weighted(mix));
    return this.work(a, task);
  },

  reachedThreshold(a, task) {
    if (task.fanout && !task.split) return this.split(a, task);
    if (task.rework && !task.reworkRolled) {
      task.reworkRolled = true;
      if (this.rng.chance(task.rework.chance)) return this.requestRework(a, task);
    }
    if (task.children.length && !this.kidsResolved(task)) return this.coordinate(a, task);
    return this.completeTask(task);
  },

  work(a, task) {
    const dur = this.rng.range(1600, 4200);
    a.phase = 'working';
    a.phaseEnd = this.t + dur;
    a.lastStep = 'work';
    if (this.rng.chance(this.policy.crash * task.difficulty * (dur / 3000))) a.crashAt = this.t + this.rng.range(0.2, 0.9) * dur;
    if (task.kind === 'review' && !task.pinged) {
      task.pinged = true;
      const dep = task.deps.length && this.tasks.get(task.deps[0]);
      const coder = dep && dep.lead && this.agents.get(dep.lead);
      if (coder && coder.alive) this.message(a, coder, 'review', 'Reading your diff');
    }
    const title = task.title.replace(/^(Edit|Review|Survey:|Query:|Refactor) /, '');
    this.say(a, 'working', this.rng.pick(WORK_VERBS[a.role] || ['Working on']) + ' ' + title, { expectedMs: Math.round(dur) });
  },

  awaitSlot(a) {
    a.phase = 'coord'; // holds no slot while it waits
    a.phaseEnd = this.t + 500;
    const label = 'Waiting for a free slot to finish its own part';
    if (a.lastStep !== label) { a.lastStep = label; this.say(a, 'idle', label, { expectedMs: 0 }); }
  },

  coordinate(a, task) {
    const done = task.children.filter((c) => this.resolved(this.tasks.get(c))).length;
    a.phase = 'coord';
    a.phaseEnd = this.t + 1500;
    const label = (task.reworked ? 'Waiting on fixes' : 'Coordinating sub-agents') + ' (' + done + '/' + task.children.length + ')';
    if (a.lastStep !== label) { a.lastStep = label; this.say(a, 'working', label, { expectedMs: 0 }); }
  },

  split(a, task) {
    task.split = true;
    const spec = task.fanout;
    const n = spec.titles.length;
    this.say(a, 'working', 'Fanning out ' + n + ' sub-agents', { expectedMs: n * 110 });
    const hc = this.headcount();
    for (let i = 0; i < n; i++) {
      const terr = this.pickSubTerritory(task.territory, hc);
      const child = this.createTask({ key: task.id + '.' + (i + 1), title: spec.titles[i], role: spec.role, territory: terr, deps: [],
        work: this.rng.range(spec.work[0], spec.work[1]), kind: task.kind, priority: task.priority, difficulty: task.difficulty, index: i, of: n }, task);
      child.retryPending = true; // reserved for the fan-out spawn below
      this.fanQueue.push({ at: this.t + 150 + i * 110, taskId: child.id, leadId: a.id });
    }
    this.coordinate(a, task);
  },

  pickSubTerritory(home, hc) {
    const others = [...this.terr.values()].filter((T) => T.id !== home && T.kind === 'cloud').sort((x, y) => this.latency(home, x.id) - this.latency(home, y.id));
    for (const T of [this.terr.get(home), ...others]) {
      const r = this.resv[T.id] || 0;
      if ((hc.byTerr[T.id] || 0) + r < T.cap) { this.resv[T.id] = r + 1; return T.id; }
    }
    return home;
  },

  tickFan() {
    let hc = null;
    while (this.fanQueue.length && this.fanQueue[0].at <= this.t) {
      const f = this.fanQueue.shift();
      const task = this.tasks.get(f.taskId);
      if (!task) continue;
      this.resv[task.territory] = Math.max(0, (this.resv[task.territory] || 0) - 1);
      task.retryPending = false;
      if (this.resolved(task)) continue;
      if (!hc) hc = this.headcount();
      if (this.capFull(hc, task.role, task.territory)) continue; // the orchestrator staffs it when a slot frees up
      this.took(hc, task.role, task.territory);
      const lead = this.agents.get(f.leadId);
      const at = lead && lead.alive ? { kind: 'agent', id: lead.id } : task.territory === 'local' ? { kind: 'hq' } : { kind: 'gateway', id: task.territory };
      const sub = this.spawnAgent(task.role, task.territory, at, { parentId: lead && lead.alive ? lead.id : null });
      this.assign(sub, task, 'fanout');
    }
  },

  requestRework(a, task) {
    task.reworked = true;
    task.own = task.work * 0.9;
    const r = task.rework;
    const child = this.createTask({ key: task.id + '.fix', title: r.title, role: r.role, territory: task.territory, deps: [],
      work: this.rng.range(r.work[0], r.work[1]), kind: 'code', priority: task.priority + 1, index: 0, of: 1 }, task);
    child.status = 'pending';
    this.message(a, this.orch, 'review', 'Changes requested: ' + task.title.replace(/^Review /, ''));
    this.coordinate(a, task);
  },

  chatter(a) {
    if (!this.rng.chance(0.14)) return;
    let to = a.parentId && this.agents.get(a.parentId);
    if (!to || !to.alive) {
      const task = a.taskId && this.tasks.get(a.taskId);
      const lead = task && task.lead !== a.id && this.agents.get(task.lead);
      to = lead && lead.alive ? lead : this.rng.chance(0.4) ? this.orch : null;
    }
    if (to && to.alive && to !== a) this.message(a, to, 'info', this.rng.pick(['Sharing context', 'Partial results ready', 'Interface changed — heads up', 'Need a decision on approach', 'Found a relevant file', 'Status: on track']));
  },

  /* ---- movement ---- */
  moveTo(a, ref, reason) {
    const toTerr = this.refTerritory(ref);
    if (reason !== 'tool' && toTerr !== a.territory) {
      this.terr.get(a.territory).active--;
      a.territory = toTerr;
      this.terr.get(toTerr).active++;
    }
    const from = a.at || this.refTerritory(a.loc) || a.territory;
    const dur = this.travelMs(from, a.loc, ref);
    a.phase = 'moving';
    a.phaseEnd = this.t + dur;
    a.dest = ref;
    a.loc = null;
    a.lastStep = 'move';
    this.emit('agent.moved', a.id, a.taskId, a.territory, { to: ref, durationMs: Math.round(dur), reason });
  },

  /* ---- tools ---- */
  pickTool(a, kind) {
    const all = [...this.tools.values()].filter((t) => t.kind === kind);
    if (!all.length) return null;
    const here = a.at || a.territory;
    const own = all.find((t) => t.territory === here) || all.find((t) => t.territory === a.territory);
    if (own && this.rng.next() > 0.12) return own;
    const w = {};
    for (const t of all) w[t.id] = 1 / (this.latency(here, t.territory) + 30);
    return this.tools.get(this.rng.weighted(w));
  },
  goUseTool(a, kind, toolId) {
    const tool = toolId ? this.tools.get(toolId) : this.pickTool(a, kind);
    if (!tool) { const task = a.taskId && this.tasks.get(a.taskId); return task ? this.work(a, task) : this.becomeIdle(a); }
    a.pendingTool = tool.id;
    const ref = { kind: 'tool', id: tool.id };
    if (this.sameRef(a.loc, ref)) return this.callTool(a);
    this.moveTo(a, ref, 'tool');
  },
  opText(a, kind) {
    const r = this.rng;
    const task = a.taskId && this.tasks.get(a.taskId);
    const subj = task ? task.title.replace(/^(Edit|Review|Query:|Survey:|Refactor) /, '') : 'context';
    switch (kind) {
      case 'llm': return 'completion · ' + r.int(2, 96) + 'k ctx';
      case 'search': return 'search \"' + subj.toLowerCase().slice(0, 42) + '\"';
      case 'exec': return r.pick(['pytest -q', 'tsc --noEmit', 'npm test', 'eslint --fix', 'go test ./...', 'kubectl rollout status', './scripts/diag.sh']);
      case 'db': return r.pick(['SELECT … WHERE status >= 500', 'vector query k=20', 'upsert findings', 'EXPLAIN ANALYZE', 'read audit_log']);
      default: return r.pick(['read ', 'write ', 'patch ', 'glob ']) + (subj.includes('/') ? subj : 'workspace/' + subj.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 24));
    }
  },
  callTool(a) {
    const tool = this.tools.get(a.pendingTool);
    a.pendingTool = null;
    const [lo, hi] = this.cfg.toolMs[tool.kind];
    let dur = this.rng.range(lo, hi) * (tool.territory === 'local' && tool.kind === 'llm' ? 1.6 : 1);
    const slow = this.terr.get(tool.territory).kind === 'cloud' && this.rng.chance(this.policy.slow);
    if (slow) dur *= this.rng.range(3, 5);
    a.phase = 'tool';
    a.phaseEnd = this.t + dur;
    a.toolCall = { toolId: tool.id, kind: tool.kind, started: this.t, slow };
    a.lastStep = 'tool';
    this.emit('tool.called', a.id, a.taskId, tool.territory, { toolId: tool.id, kind: tool.kind, op: this.opText(a, tool.kind), expectedMs: Math.round(dur), slow });
  },
  toolReturn(a) {
    const c = a.toolCall;
    a.toolCall = null;
    a.sinceTool = 0;
    if (!c) return this.think(a);
    const tool = this.tools.get(c.toolId);
    const latencyMs = Math.round(this.t - c.started);
    if (this.rng.chance(this.policy.toolErr * (c.slow ? 2 : 1))) {
      const [code, msg] = this.rng.pick(TOOL_ERRORS[c.kind]);
      this.emit('tool.returned', a.id, a.taskId, tool.territory, { toolId: tool.id, kind: tool.kind, ok: false, latencyMs, result: msg });
      return this.hurt(a, code, msg);
    }
    const [lo, hi] = this.cfg.toolTokens[c.kind];
    this.accrue(a, this.rng.range(lo, hi), 0);
    const task = a.taskId && this.tasks.get(a.taskId);
    if (task && !this.resolved(task) && task.status !== 'locked') {
      task.own = Math.min(this.workCap(task), task.own + 0.8 * this.terr.get(a.territory).speed);
      this.lastProgressT = this.t;
    }
    const r = this.rng;
    const result = { llm: r.int(300, 2400) + ' tokens out', search: r.int(6, 20) + ' results', exec: 'exit 0 · ' + r.int(12, 240) + ' passed',
      db: r.int(1, 900) + ' rows', fs: 'ok · ' + r.range(0.4, 24).toFixed(1) + ' KB' }[c.kind];
    this.emit('tool.returned', a.id, a.taskId, tool.territory, { toolId: tool.id, kind: tool.kind, ok: true, latencyMs, result });
    this.think(a);
  },

  /* ---- failure ---- */
  hurt(a, code, msg) {
    const dmg = this.rng.int(18, 34);
    a.health = Math.max(0, a.health - dmg);
    a.errors++;
    this.stats.errors++;
    if (a.health <= 0) return this.crash(a, 'HEALTH', 'Too many consecutive failures');
    const retryIn = Math.round(this.rng.range(1100, 2200));
    this.emit('agent.error', a.id, a.taskId, a.territory, { code, message: msg, damage: dmg, health: a.health, fatal: false, retryInMs: retryIn });
    a.phase = 'error';
    a.phaseEnd = this.t + retryIn;
  },
  crash(a, code, msg) {
    this.stats.crashes++;
    this.stats.errors++;
    const task = a.taskId && this.tasks.get(a.taskId);
    this.emit('agent.error', a.id, a.taskId, a.territory, { code, message: msg, damage: a.health, health: 0, fatal: true });
    this.emit('agent.terminated', a.id, a.taskId, a.territory, { reason: 'crashed', tokens: Math.round(a.tokens), cost: +a.cost.toFixed(4) });
    this.removeAgent(a);
    if (task && !this.resolved(task) && this.liveAssignees(task) === 0) this.scheduleRetry(task, a);
  },

  becomeIdle(a) {
    if (!a.alive || a.role === 'orchestrator') return;
    if (!a.held && !a.parentId) {
      let best = null;
      for (const t of this.tasks.values()) {
        if (t.status === 'pending' && !t.retryPending && t.role === a.role && t.territory === a.territory && this.liveAssignees(t) === 0 && (!best || t.priority > best.priority)) best = t;
      }
      if (best) { this.assign(a, best, 'auto'); return this.think(a); }
    }
    if (a.phase !== 'idle') {
      a.phase = 'idle';
      a.idleSince = this.t;
      a.lastStep = 'idle';
      this.say(a, 'idle', a.held ? 'Holding — awaiting orders' : 'Awaiting assignment', { taskId: null, held: a.held });
    }
    a.phaseEnd = 0;
  },

  /* ---- operator commands (arrive via MockCommandSink) ---- */
  interrupt(a) {
    if (a.paused) a.paused = null;
    if (a.phase === 'tool' && a.toolCall) {
      const tool = this.tools.get(a.toolCall.toolId);
      this.emit('tool.returned', a.id, a.taskId, tool.territory, { toolId: tool.id, kind: tool.kind, ok: false, latencyMs: Math.round(this.t - a.toolCall.started), result: 'Cancelled by operator' });
    }
    a.toolCall = null;
    a.pendingTool = null;
    a.crashAt = 0;
    a.phase = 'idle';
    a.phaseEnd = 0;
    a.idleSince = this.t;
  },
  bestCloud(exclude) {
    const clouds = [...this.terr.values()].filter((T) => T.kind === 'cloud' && T.id !== exclude && T.active < T.cap);
    clouds.sort((x, y) => this.latency('local', x.id) - this.latency('local', y.id));
    return clouds[0] ? clouds[0].id : null;
  },
  command(cmd) {
    const all = (cmd.agentIds || []).map((id) => this.agents.get(id)).filter((a) => a && a.alive);
    const agents = all.filter((a) => a.role !== 'orchestrator');
    if (!agents.length) return { ok: false, message: all.length ? 'The orchestrator does not take unit orders' : 'No controllable agents selected' };
    const tgt = cmd.target || {};
    let ok = 0, why = '';
    const capOk = (terrId) => { const T = this.terr.get(terrId); if (T.active < T.cap) return true; why = T.name + ' is at capacity (' + T.cap + ')'; return false; };
    switch (cmd.type) {
      case 'assign_task': {
        const task = this.tasks.get(tgt.id);
        if (!task) return { ok: false, message: 'Unknown task' };
        if (this.resolved(task)) return { ok: false, message: 'Task already ' + task.status };
        for (const a of agents) {
          if (task.territory !== a.territory && !capOk(task.territory)) continue;
          this.interrupt(a);
          a.held = false;
          this.assign(a, task, 'user');
          this.think(a);
          ok++;
        }
        return { ok: ok > 0, message: ok ? ok + ' → ' + task.title + (task.status === 'locked' ? ' (locked — will wait)' : '') : why };
      }
      case 'use_tool': {
        const tool = this.tools.get(tgt.id);
        if (!tool) return { ok: false, message: 'Unknown tool' };
        for (const a of agents) { this.interrupt(a); a.forcedTool = tool.id; this.think(a); ok++; }
        return { ok: true, message: ok + ' → call ' + tool.name + ' (' + tool.territory + ')' };
      }
      case 'move': {
        const terr = tgt.territory && this.terr.get(tgt.territory) ? tgt.territory : null;
        for (const a of agents) {
          if (terr && terr !== a.territory && !capOk(terr)) continue;
          this.interrupt(a);
          this.unassign(a, false);
          a.held = true;
          this.moveTo(a, { kind: 'point', x: tgt.x, y: tgt.y, territory: terr || a.territory, id: 'p' + this.evSeq }, terr && terr !== a.territory ? 'migrate' : 'move');
          ok++;
        }
        return { ok: ok > 0, message: ok ? ok + ' moving · holding position on arrival' : why };
      }
      case 'recall':
        for (const a of agents) {
          this.interrupt(a);
          this.unassign(a, false);
          a.held = true;
          this.moveTo(a, a.territory === 'local' ? { kind: 'hq' } : { kind: 'gateway', id: a.territory }, 'recall');
          ok++;
        }
        return { ok: true, message: ok + ' recalled to base' };
      case 'pause':
        for (const a of agents) {
          if (a.paused) continue;
          a.paused = { phase: a.phase, remaining: a.phaseEnd ? Math.max(0, a.phaseEnd - this.t) : 0, crashIn: a.crashAt ? a.crashAt - this.t : 0 };
          a.phase = 'paused';
          a.phaseEnd = 0;
          a.crashAt = 0;
          this.say(a, 'paused', 'Paused by operator');
          ok++;
        }
        return { ok: ok > 0, message: ok ? ok + ' paused' : 'Already paused' };
      case 'resume':
        for (const a of agents) {
          const p = a.paused;
          if (!p) continue;
          a.paused = null;
          a.phase = p.phase;
          a.phaseEnd = p.remaining ? this.t + p.remaining : 0;
          if (p.crashIn) a.crashAt = this.t + p.crashIn;
          if (p.phase === 'moving' && a.dest) this.emit('agent.moved', a.id, a.taskId, a.territory, { to: a.dest, durationMs: Math.round(Math.max(200, p.remaining)), reason: 'resume' });
          else if (p.phase === 'working' || p.phase === 'tool' || p.phase === 'coord') this.say(a, 'working', 'Resumed', { expectedMs: Math.round(p.remaining) });
          else { a.phase = 'idle'; a.idleSince = this.t; this.say(a, 'idle', 'Resumed'); this.think(a); }
          if (!a.phaseEnd && a.phase !== 'idle' && a.phase !== 'moving') a.phaseEnd = this.t + 50;
          ok++;
        }
        return { ok: ok > 0, message: ok ? ok + ' resumed' : 'Nothing to resume' };
      case 'terminate':
        for (const a of agents) {
          this.interrupt(a);
          this.emit('agent.terminated', a.id, a.taskId, a.territory, { reason: 'user', tokens: Math.round(a.tokens), cost: +a.cost.toFixed(4) });
          this.removeAgent(a);
          ok++;
        }
        return { ok: true, message: ok + ' terminated' };
      case 'duplicate': {
        const hc = this.headcount();
        for (const a of agents) {
          if (!capOk(a.territory)) continue;
          const full = this.capFull(hc, a.role, null);
          if (full) { why = full === 'swarm' ? 'The swarm-wide cap (' + this.cfg.maxActive + ') is reached' : ROLES[a.role].label + 's are capped at ' + this.cfg.roleCaps[a.role]; continue; }
          this.took(hc, a.role, a.territory);
          const c = this.spawnAgent(a.role, a.territory, { kind: 'agent', id: a.id }, { parentId: a.parentId });
          c.at = a.at;
          const task = a.taskId && this.tasks.get(a.taskId);
          if (task && !this.resolved(task)) { this.assign(c, task, 'clone'); this.message(a, c, 'info', 'Handing over context'); }
          else c.held = a.held;
          ok++;
        }
        return { ok: ok > 0, message: ok ? ok + ' clone(s) spawned' : why };
      }
      case 'migrate':
        for (const a of agents) {
          const dest = tgt.id && this.terr.get(tgt.id) ? tgt.id : a.territory === 'local' ? this.bestCloud() : 'local';
          if (!dest) { why = 'No cloud capacity available'; continue; }
          if (dest === a.territory || !capOk(dest)) continue;
          this.interrupt(a);
          this.unassign(a, false);
          a.held = false;
          a.idleGrace = 9000;
          this.moveTo(a, dest === 'local' ? { kind: 'hq' } : { kind: 'gateway', id: dest }, 'migrate');
          ok++;
        }
        return { ok: ok > 0, message: ok ? ok + ' migrating' : why || 'Already there' };
      default:
        return { ok: false, message: 'Unknown command ' + cmd.type };
    }
  },
});

/* =====================================================================================
 *  SECTION 2b · SWARM SPECS — a saved swarm, its defaults, and what it compiles to
 *
 *  A spec is the one input to every run. The launcher keeps one per swarm (a plugin document in
 *  the user's tenant), the editor edits it, the simulator runs what compileSpec makes of it, the
 *  estimator runs that headless over several seeds to price it, and a live run submits its tasks
 *  to agnostic as a crew (specToCrewRequest).
 *
 *  Every field has a default, and every value read back is clamped (normalizeSpec): a stored
 *  document is untrusted input — an older version, a hand edit, an import, another tab's write.
 *  Values are absolute (the budget is dollars, a cap is agents); the workload scale only decides
 *  how much work a template generates, and the editor rescales caps and budget alongside it.
 * ===================================================================================== */
const SPEC_VERSION = 1;
const RECORDING_MAX = 200000;      // events a mission's replay log keeps (see App.record)
const SPEC_PREFIX = 'swarm-';      // document keys: swarm-<id>
const SPEC_MAX_BYTES = 32768;      // the server keeps a plugin document of up to 32 KiB
const SPEC_MAX_TASKS = 300;
const SPEC_MAX_LIVE_RUNS = 20;     // live crews and simulations are capped apart: a burst of
const SPEC_MAX_SIM_RUNS = 10;      // simulations never pushes a crew you might watch out of the list
const SPEC_RESERVE = 4096;         // room an editor save leaves for run records and the estimate
const SPEC_MAX_MODELS = 12;
const REGION_IDS = ['local', 'us-east', 'eu-west', 'ap-south'];
const TOOL_KEYS = ['llm', 'search', 'exec', 'db', 'fs'];
const TASK_KIND_LIST = ['plan', 'analysis', 'research', 'synthesis', 'code', 'review', 'test', 'data', 'ops', 'diagnose', 'triage', 'verify', 'comms', 'report', 'work'];
const PRIORITY_LABELS = ['', 'Low', 'Normal', 'High', 'Critical'];
const RE_SPEC_ID = /^[a-z0-9]{6,24}$/;
const RE_MODEL = /^[a-z0-9][a-z0-9._-]{0,39}$/;
const RE_TASK_KEY = /^[a-z0-9][a-z0-9_-]{0,31}$/;
const RE_PRESET = /^[a-z0-9][a-z0-9-]{0,99}$/;
const RE_LIVE_MODEL = /^[A-Za-z0-9][A-Za-z0-9._:\\/-]{0,99}$/;
const RE_CREW_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const RE_IDEM_KEY = /^[A-Za-z0-9._:-]{8,128}$/;

const ROLE_GOALS = {
  planner: 'Break the objective into a plan, sequence the work, and write up the result',
  researcher: 'Find and read the sources the plan needs, and summarize what they say',
  coder: 'Make the code changes the plan calls for, with tests',
  reviewer: 'Review each change for correctness and send back what must be fixed',
  runner: 'Run the commands, jobs and queries the work needs, and report their output',
};
const TEMPLATES = Object.assign({}, ...Object.values(SCENARIOS).map(({ key, icon, name, desc, tags }) => ({ [key]: { key, icon, name, desc, tags } })), {
  custom: {
    key: 'custom', icon: '✦', name: 'Custom swarm',
    desc: 'A small plan → build → review → test pipeline to make your own. Every task, role, model, tool, region, cap and failure rate is yours to set.',
    tags: ['Your tasks', 'Every setting'],
  },
});
function customTasks() {
  return [
    { key: 'plan', title: 'Plan the work', role: 'planner', region: 'local', deps: [], work: 5, kind: 'plan', priority: 3, difficulty: 1, fanout: null, rework: null },
    { key: 'research', title: 'Gather background', role: 'researcher', region: 'us-east', deps: ['plan'], work: 3, kind: 'research', priority: 2, difficulty: 1, fanout: { count: 4, work: [8, 12] }, rework: null },
    { key: 'build', title: 'Implement the change', role: 'coder', region: 'local', deps: ['plan'], work: 4, kind: 'code', priority: 2, difficulty: 1, fanout: { count: 5, work: [9, 14] }, rework: null },
    { key: 'review', title: 'Review the change', role: 'reviewer', region: 'local', deps: ['build'], work: 8, kind: 'review', priority: 2, difficulty: 1, fanout: null, rework: { chance: 0.3 } },
    { key: 'test', title: 'Run the test suite', role: 'runner', region: 'us-east', deps: ['review'], work: 4, kind: 'test', priority: 2, difficulty: 1, fanout: { count: 3, work: [6, 10] }, rework: null },
    { key: 'report', title: 'Write up the results', role: 'planner', region: 'local', deps: ['research', 'test'], work: 6, kind: 'report', priority: 3, difficulty: 1, fanout: null, rework: null },
  ];
}

/* ---- readers: an untrusted value → a value of the right type, in range, or the default ---- */
function rdNum(v, lo, hi, d) {
  const n = typeof v === 'number' ? v : typeof v === 'string' && v.trim() !== '' ? Number(v) : NaN;
  return Number.isFinite(n) ? clamp(n, lo, hi) : d;
}
function rdInt(v, lo, hi, d) { const n = rdNum(v, lo, hi, NaN); return Number.isFinite(n) ? Math.round(n) : d; }
function rdOptInt(v, lo, hi) { return v == null || v === '' ? null : rdInt(v, lo, hi, null); }
function rdStr(v, max, d) { return typeof v === 'string' ? v.trim().slice(0, max) : d; }
function rdBool(v, d) { return typeof v === 'boolean' ? v : d; }
function rdPair(v, lo, hi, d) {
  if (!Array.isArray(v) || v.length !== 2) return d.slice();
  const a = rdNum(v[0], lo, hi, d[0]), b = rdNum(v[1], lo, hi, d[1]);
  return [Math.min(a, b), Math.max(a, b)];
}
function newSpecId() {
  const b = new Uint8Array(8);
  try { crypto.getRandomValues(b); } catch (err) { for (let i = 0; i < b.length; i++) b[i] = Math.floor(Math.random() * 256); }
  let s = '';
  for (const x of b) s += (x % 36).toString(36);
  return s + Date.now().toString(36).slice(-4);
}

/** A complete spec for `template` ('refactor' | 'research' | 'incident' | 'custom') at a workload scale. */
function defaultSpec(template, scale) {
  const sc = SCENARIOS[template] || null;
  const k = clamp(Math.round(scale) || 1, 1, 3);
  const now = Date.now();
  const roles = {};
  for (const r of ROLE_KEYS) {
    const tools = {};
    for (const t of TOOL_KEYS) tools[t] = ROLE_TOOLS[r][t] || 0;
    roles[r] = { max: null, model: ROLE_MODEL[r], localModel: r === 'runner' ? 'local-8b' : '', tps: ROLE_TPS[r], toolP: ROLE_TOOL_P[r], tools, goal: ROLE_GOALS[r] };
  }
  const models = {};
  for (const m in SIM_MODELS) models[m] = { price: SIM_MODELS[m].price, tps: SIM_MODELS[m].tps };
  const tools = {};
  for (const t of TOOL_KEYS) tools[t] = { on: true, ms: TOOL_MS[t].slice(), tokens: TOOL_TOKENS[t].slice() };
  const regions = {};
  for (const t of buildWorld(1).territories) regions[t.id] = { on: true, cap: t.cap * k, costPerSec: t.costPerSec, speed: t.speed };
  const policy = Object.assign({ spawnPerSec: 5, toolErr: 0.035, crash: 0.012, slow: 0.04, maxRetries: 2, idleReleaseMs: 3500, computeMult: 1 }, sc ? sc.policy : {});
  policy.spawnPerSec = +(policy.spawnPerSec * k).toFixed(2);
  return {
    v: SPEC_VERSION, id: newSpecId(), name: sc ? sc.name : TEMPLATES.custom.name,
    objective: sc ? sc.objective : 'Plan, build, review and test a change end to end',
    template: sc ? sc.key : 'custom', created: now, updated: now,
    seed: 1337, scale: k, budget: (sc ? sc.budget : 4) * k, maxActive: null,
    orchestrator: { model: ROLE_MODEL.orchestrator, tps: ROLE_TPS.orchestrator },
    roles, models, tools, regions, policy,
    tasks: sc ? null : customTasks(),
    live: { roster: 'roles', preset: '', process: 'auto', maxConcurrency: 4, models: {} },
    estimate: null, runs: [],
  };
}

/** An untrusted document → a complete, in-range spec; null when it is not a spec at all. */
function normalizeSpec(raw) {
  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return null;
  const template = SCENARIOS[raw.template] ? raw.template : 'custom';
  const s = defaultSpec(template, rdInt(raw.scale, 1, 3, 1));
  if (typeof raw.id === 'string' && RE_SPEC_ID.test(raw.id)) s.id = raw.id;
  s.name = rdStr(raw.name, 80, '') || s.name;
  s.objective = rdStr(raw.objective, 400, s.objective);
  s.created = rdNum(raw.created, 0, 1e15, s.created);
  s.updated = rdNum(raw.updated, 0, 1e15, s.updated);
  s.seed = rdInt(raw.seed, 1, 2147483647, s.seed);
  s.budget = rdNum(raw.budget, 0.01, 1e6, s.budget);
  s.maxActive = raw.maxActive === undefined ? null : rdOptInt(raw.maxActive, 1, 5000);
  if (raw.models && typeof raw.models === 'object' && !Array.isArray(raw.models)) {
    const m = {};
    for (const name of Object.keys(raw.models).slice(0, SPEC_MAX_MODELS)) {
      const v = raw.models[name];
      if (!RE_MODEL.test(name) || !v || typeof v !== 'object') continue;
      m[name] = { price: rdNum(v.price, 0, 10, 0), tps: rdNum(v.tps, 0.05, 10, 1) };
    }
    if (Object.keys(m).length) s.models = m;
  }
  const first = Object.keys(s.models)[0];
  const model = (v, d) => (typeof v === 'string' && s.models[v] ? v : s.models[d] ? d : first);
  const o = raw.orchestrator || {};
  s.orchestrator = { model: model(o.model, s.orchestrator.model), tps: rdNum(o.tps, 1, 20000, s.orchestrator.tps) };
  for (const r of ROLE_KEYS) {
    const d = s.roles[r], v = (raw.roles && raw.roles[r]) || {};
    const tools = {};
    for (const t of TOOL_KEYS) tools[t] = rdNum(v.tools && v.tools[t], 0, 10, d.tools[t]);
    const lm = v.localModel === undefined ? d.localModel : v.localModel;
    s.roles[r] = {
      max: v.max === undefined ? d.max : rdOptInt(v.max, 1, 5000),
      model: model(v.model, d.model),
      localModel: typeof lm === 'string' && s.models[lm] ? lm : '',
      tps: rdNum(v.tps, 1, 20000, d.tps),
      toolP: rdNum(v.toolP, 0, 1, d.toolP),
      tools,
      goal: rdStr(v.goal, 300, '') || d.goal,
    };
  }
  for (const t of TOOL_KEYS) {
    const d = s.tools[t], v = (raw.tools && raw.tools[t]) || {};
    s.tools[t] = { on: rdBool(v.on, d.on), ms: rdPair(v.ms, 10, 600000, d.ms), tokens: rdPair(v.tokens, 0, 1000000, d.tokens) };
  }
  for (const id of REGION_IDS) {
    const d = s.regions[id], v = (raw.regions && raw.regions[id]) || {};
    s.regions[id] = {
      on: id === 'local' ? true : rdBool(v.on, d.on), cap: rdInt(v.cap, id === 'local' ? 1 : 0, 5000, d.cap),
      costPerSec: rdNum(v.costPerSec, 0, 10, d.costPerSec), speed: rdNum(v.speed, 0.05, 10, d.speed),
    };
  }
  const p = raw.policy || {}, dp = s.policy;
  s.policy = {
    spawnPerSec: rdNum(p.spawnPerSec, 0.1, 200, dp.spawnPerSec), toolErr: rdNum(p.toolErr, 0, 0.95, dp.toolErr), crash: rdNum(p.crash, 0, 0.9, dp.crash),
    slow: rdNum(p.slow, 0, 0.95, dp.slow), maxRetries: rdInt(p.maxRetries, 0, 10, dp.maxRetries), idleReleaseMs: rdInt(p.idleReleaseMs, 200, 600000, dp.idleReleaseMs),
    computeMult: rdNum(p.computeMult, 0, 100, dp.computeMult),
  };
  if (Array.isArray(raw.tasks)) s.tasks = normalizeTasks(raw.tasks);
  const l = raw.live || {}, dl = s.live;
  s.live = {
    roster: l.roster === 'preset' ? 'preset' : 'roles', preset: typeof l.preset === 'string' && RE_PRESET.test(l.preset) ? l.preset : '',
    process: ['auto', 'sequential', 'parallel', 'dag'].includes(l.process) ? l.process : dl.process,
    maxConcurrency: rdInt(l.maxConcurrency, 1, 64, dl.maxConcurrency), models: {},
  };
  if (l.models && typeof l.models === 'object') for (const r of ROLE_KEYS) if (typeof l.models[r] === 'string' && RE_LIVE_MODEL.test(l.models[r])) s.live.models[r] = l.models[r];
  s.estimate = normalizeEstimate(raw.estimate);
  s.runs = Array.isArray(raw.runs) ? raw.runs.map(normalizeRun).filter(Boolean) : [];
  capRuns(s);
  // A document from a NEWER Swarm Command may hold fields this one does not know; writing it
  // back would drop them. It is shown and simulated, never saved over.
  if (Number.isInteger(raw.v) && raw.v > SPEC_VERSION) s.readOnly = true;
  return s;
}
/** Keep the newest SPEC_MAX_LIVE_RUNS live runs and SPEC_MAX_SIM_RUNS simulations, oldest first. */
function capRuns(s) {
  const live = s.runs.filter((r) => r.kind === 'live').slice(-SPEC_MAX_LIVE_RUNS);
  const sim = s.runs.filter((r) => r.kind === 'sim').slice(-SPEC_MAX_SIM_RUNS);
  s.runs = live.concat(sim).sort((a, b) => a.at - b.at);
  return s;
}
/** Trim what can be recomputed or spared until `s` fits the server's limit: old simulations first, then the estimate, then old live runs. */
function fitSpec(s) {
  while (specBytes(storableSpec(s)) > SPEC_MAX_BYTES) {
    const sim = s.runs.findIndex((r) => r.kind === 'sim');
    if (sim >= 0) { s.runs.splice(sim, 1); continue; }
    if (s.estimate) { s.estimate = null; continue; }
    if (s.runs.length) { s.runs.shift(); continue; }
    break;
  }
  return s;
}
/** The document a spec is stored as — without the flags that only exist on screen. */
function storableSpec(s) {
  const d = Object.assign({}, s);
  delete d.readOnly;
  delete d.unsaved;
  return d;
}
function normalizeTasks(list) {
  const out = [], seen = new Set();
  for (const v of list.slice(0, SPEC_MAX_TASKS)) {
    if (!v || typeof v !== 'object' || typeof v.key !== 'string' || !RE_TASK_KEY.test(v.key) || seen.has(v.key)) continue;
    seen.add(v.key);
    const t = {
      key: v.key, title: rdStr(v.title, 160, '') || v.key, role: ROLE_KEYS.includes(v.role) ? v.role : 'coder',
      region: REGION_IDS.includes(v.region) ? v.region : 'local', deps: [], work: rdNum(v.work, 0.5, 3600, 5),
      kind: TASK_KIND_LIST.includes(v.kind) ? v.kind : 'work', priority: rdInt(v.priority, 1, 4, 2), difficulty: rdNum(v.difficulty, 0.1, 100, 1),
      fanout: null, rework: null,
    };
    if (Array.isArray(v.deps)) t.deps = [...new Set(v.deps.filter((d) => typeof d === 'string' && RE_TASK_KEY.test(d)))].slice(0, 64);
    if (v.fanout && typeof v.fanout === 'object') {
      const count = rdInt(v.fanout.count, 0, 40, 0);
      if (count) {
        t.fanout = { count, work: rdPair(v.fanout.work, 0.5, 3600, [8, 12]) };
        if (Array.isArray(v.fanout.titles)) {
          const ti = v.fanout.titles.filter((x) => typeof x === 'string').map((x) => x.trim().slice(0, 120)).filter(Boolean);
          if (ti.length === count) t.fanout.titles = ti;
        }
      }
    }
    if (v.rework && typeof v.rework === 'object') { const c = rdNum(v.rework.chance, 0, 1, 0); if (c > 0) t.rework = { chance: c }; }
    out.push(t);
  }
  const keys = new Set(out.map((t) => t.key));
  for (const t of out) t.deps = t.deps.filter((d) => keys.has(d) && d !== t.key);
  return out;
}
function normalizeEstimate(e) {
  if (!e || typeof e !== 'object' || typeof e.sig !== 'string') return null;
  const runs = rdInt(e.runs, 1, 1000, 0);
  if (!runs) return null;
  const n = (v) => rdNum(v, 0, 1e12, 0);
  const g = (o, k) => n(o && typeof o === 'object' ? o[k] : 0);
  return {
    sig: e.sig.slice(0, 16), at: n(e.at), runs, cost: { min: g(e.cost, 'min'), p50: g(e.cost, 'p50'), max: g(e.cost, 'max') },
    durationMs: { p50: g(e.durationMs, 'p50'), max: g(e.durationMs, 'max') }, tokens: { p50: g(e.tokens, 'p50') }, peak: { p50: g(e.peak, 'p50') },
    failed: n(e.failed), over: rdInt(e.over, 0, runs, 0), stalled: rdInt(e.stalled, 0, runs, 0),
  };
}
/**
 * A run record. A live run is recorded BEFORE its crew is submitted, with the idempotency key the
 * submission carries (`key`), and gains the crew's id once agnostic answers — so a run whose answer
 * never arrived ('unconfirmed') is still on the card, and still says which key to look for.
 * `tokens` and `costMicro` are what agnostic metered for a finished live crew; never a simulation's.
 */
function normalizeRun(r) {
  if (!r || typeof r !== 'object' || (r.kind !== 'sim' && r.kind !== 'live')) return null;
  const o = { kind: r.kind, at: rdNum(r.at, 0, 1e15, 0), status: rdStr(r.status, 24, '') };
  if (r.kind === 'live') {
    const crew = typeof r.crew === 'string' && RE_CREW_ID.test(r.crew) ? r.crew.toLowerCase() : '';
    const key = typeof r.key === 'string' && RE_IDEM_KEY.test(r.key) ? r.key : '';
    if (!crew && !key) return null;
    if (crew) o.crew = crew;
    if (key) o.key = key;
    o.engine = rdStr(r.engine, 24, '');
  }
  for (const k of ['seed', 'cost', 'durationMs', 'done', 'failed', 'total', 'tokens', 'costMicro']) if (typeof r[k] === 'number' && Number.isFinite(r[k])) o[k] = rdNum(r[k], 0, 1e12, 0);
  return o;
}

/** A spec's own document bytes, as the server will count them. */
function specBytes(s) { return new TextEncoder().encode(JSON.stringify(s)).length; }
/** Fingerprint of everything the simulator reads — an estimate is current while this matches. */
function specSig(s) {
  const sim = { template: s.template, seed: s.seed, scale: s.scale, budget: s.budget, maxActive: s.maxActive, orchestrator: s.orchestrator,
    roles: s.roles, models: s.models, tools: s.tools, regions: s.regions, policy: s.policy, tasks: s.tasks };
  return hashStr(JSON.stringify(sim, (k, v) => (k === 'goal' ? undefined : v))).toString(36);
}
const regionOn = (s, id) => id === 'local' || (!!s.regions[id] && s.regions[id].on && s.regions[id].cap > 0);

/** A custom task → the simulator's task spec. */
function customToSim(t) {
  const o = { key: t.key, title: t.title, role: t.role, territory: t.region, deps: t.deps.slice(), work: t.work, kind: t.kind, priority: t.priority };
  if (t.difficulty !== 1) o.difficulty = t.difficulty;
  if (t.fanout) {
    const n = t.fanout.count;
    o.fanout = { role: t.role, work: t.fanout.work.slice(),
      titles: t.fanout.titles && t.fanout.titles.length === n ? t.fanout.titles.slice() : Array.from({ length: n }, (_, i) => t.title + ' · part ' + (i + 1) + '/' + n) };
  }
  if (t.rework) o.rework = { chance: t.rework.chance, role: 'coder', work: [5, 8], title: 'Address review: ' + t.title.replace(/^Review /, '') };
  return o;
}
/** A simulator task spec → an editable custom task (the editor's \"Customize tasks\"). */
function simToCustom(t) {
  return {
    key: t.key, title: t.title, role: t.role, region: t.territory, deps: (t.deps || []).slice(), work: t.work,
    kind: TASK_KIND_LIST.includes(t.kind) ? t.kind : 'work', priority: clamp(t.priority || 1, 1, 4), difficulty: t.difficulty || 1,
    fanout: t.fanout ? { count: t.fanout.titles.length, work: t.fanout.work.slice(), titles: t.fanout.titles.slice() } : null,
    rework: t.rework ? { chance: t.rework.chance } : null,
  };
}
/** The primary tasks a spec runs, as simulator task specs — generated exactly as the Sim will. */
function specTasks(s) {
  if (s.tasks) return s.tasks.map(customToSim);
  const sc = SCENARIOS[s.template];
  return sc.build(new RNG((s.seed ^ hashStr(sc.key)) >>> 0), s.scale);
}
/** Task keys in dependency order (stable: list order breaks ties); null when the deps form a cycle. */
function topoOrder(tasks) {
  const idx = new Map(tasks.map((t, i) => [t.key, i]));
  const indeg = tasks.map(() => 0), out = tasks.map(() => []);
  tasks.forEach((t, i) => { for (const d of t.deps || []) { const j = idx.get(d); if (j !== undefined && j !== i) { indeg[i]++; out[j].push(i); } } });
  const ready = [], order = [];
  indeg.forEach((n, i) => { if (!n) ready.push(i); });
  while (ready.length) {
    ready.sort((a, b) => a - b);
    const i = ready.shift();
    order.push(tasks[i]);
    for (const j of out[i]) if (--indeg[j] === 0) ready.push(j);
  }
  return order.length === tasks.length ? order : null;
}

/**
 * What stands between a spec and a run. `errors` block running and saving, `tooBig` blocks only
 * saving (a draft that will not fit can still be simulated), `warnings` are worth knowing.
 */
function validateSpec(s) {
  const errors = [], warnings = [], tabs = {};
  const err = (tab, msg) => { errors.push(msg); tabs[tab] = (tabs[tab] || 0) + 1; };
  if (!s.name.trim()) err('mission', 'Give the swarm a name.');
  if (!(s.budget > 0)) err('compute', 'The budget must be more than $0.');
  if (!(s.regions.local.cap >= 1)) err('compute', 'Local needs room for at least one agent.');
  for (const r of ['orchestrator', ...ROLE_KEYS]) {
    const m = r === 'orchestrator' ? s.orchestrator.model : s.roles[r].model;
    if (!s.models[m]) err('models', (ROLES[r] || { label: r }).label + ' uses a model that is not in the catalogue.');
  }
  let tasks = [];
  if (s.tasks) {
    const keys = new Set(), all = new Set(s.tasks.map((t) => t.key));
    for (const t of s.tasks) {
      if (!RE_TASK_KEY.test(t.key)) err('tasks', 'Task key \"' + t.key + '\" must be lower-case letters, digits, - or _ (up to 32).');
      else if (keys.has(t.key)) err('tasks', 'Two tasks share the key \"' + t.key + '\".');
      keys.add(t.key);
      if (!t.title.trim()) err('tasks', 'Task \"' + t.key + '\" needs a title.');
      for (const d of t.deps) {
        if (d === t.key) err('tasks', 'Task \"' + t.key + '\" depends on itself.');
        else if (!all.has(d)) err('tasks', 'Task \"' + t.key + '\" depends on \"' + d + '\", which is not a task.');
      }
    }
    if (!s.tasks.length) err('tasks', 'A swarm needs at least one task.');
    else if (!topoOrder(s.tasks)) err('tasks', 'The task dependencies form a cycle.');
    tasks = s.tasks.map(customToSim);
  } else {
    try { tasks = specTasks(s); } catch (e) { err('tasks', 'The template could not generate its tasks.'); }
  }
  const off = {};
  for (const t of tasks) if (!regionOn(s, t.territory)) off[t.territory] = (off[t.territory] || 0) + 1;
  for (const id in off) warnings.push(off[id] + ' task' + (off[id] === 1 ? ' is' : 's are') + ' placed in ' + id + ', which is off — ' + (off[id] === 1 ? 'it runs' : 'they run') + ' on Local.');
  for (const r of ROLE_KEYS) {
    const max = s.roles[r].max;
    if (max == null) continue;
    const fan = tasks.filter((t) => t.role === r && t.fanout).length;
    if (fan && max < 3) warnings.push(ROLES[r].label + ' is capped at ' + max + ' — its fan-out sub-agents will queue a few at a time.');
  }
  let cap = 0;
  for (const id of REGION_IDS) if (regionOn(s, id)) cap += s.regions[id].cap;
  if (s.maxActive != null && s.maxActive < 3) warnings.push('A swarm-wide cap under 3 agents serializes nearly all of the work.');
  else if (s.maxActive != null && s.maxActive > cap) warnings.push('The swarm-wide cap (' + s.maxActive + ') is above the regions’ total (' + cap + '), so the regions bind first.');
  if (TOOL_KEYS.every((k) => !s.tools[k].on)) warnings.push('Every tool is off — agents only think, and no tool tokens or latency are simulated.');
  const bytes = specBytes(s);
  return { errors, warnings, tabs, bytes, tooBig: bytes > SPEC_MAX_BYTES - SPEC_RESERVE, taskCount: tasks.length, fanout: tasks.reduce((n, t) => n + (t.fanout ? t.fanout.titles.length : 0), 0) };
}

/** A spec → {sc, cfg} for `new Sim(sc, {seed, scale, cfg})`. Regions that are off drop out of the world. */
function compileSpec(s) {
  const on = (id) => regionOn(s, id);
  const base = buildWorld(1);
  const territories = base.territories.filter((t) => on(t.id)).map((t) => {
    const r = s.regions[t.id], latencyMs = {};
    for (const k in t.latencyMs) if (on(k)) latencyMs[k] = t.latencyMs[k];
    return Object.assign({}, t, { cap: r.cap, costPerSec: r.costPerSec, speed: r.speed, latencyMs });
  });
  const tools = base.tools.filter((x) => on(x.territory) && s.tools[x.kind].on);
  const kinds = new Set(tools.map((x) => x.kind));
  const cfg = {
    world: { territories, tools }, models: s.models, maxActive: s.maxActive,
    roleModel: { orchestrator: s.orchestrator.model }, roleLocalModel: {}, roleTps: { orchestrator: s.orchestrator.tps },
    toolP: {}, roleTools: {}, roleCaps: {}, toolMs: {}, toolTokens: {},
  };
  for (const r of ROLE_KEYS) {
    const R = s.roles[r];
    cfg.roleModel[r] = R.model;
    cfg.roleLocalModel[r] = R.localModel || '';
    cfg.roleTps[r] = R.tps;
    cfg.toolP[r] = R.toolP;
    cfg.roleCaps[r] = R.max;
    const mix = {};
    let any = false;
    for (const k of TOOL_KEYS) if (kinds.has(k) && R.tools[k] > 0) { mix[k] = R.tools[k]; any = true; }
    cfg.roleTools[r] = any ? mix : null;
  }
  for (const k of TOOL_KEYS) { cfg.toolMs[k] = s.tools[k].ms.slice(); cfg.toolTokens[k] = s.tools[k].tokens.slice(); }
  const remap = (t) => Object.assign(t, { territory: on(t.territory) ? t.territory : 'local' });
  const sc = {
    key: s.template, name: s.name, objective: s.objective, budget: s.budget, policy: Object.assign({}, s.policy),
    mission: { kind: 'sim', specId: s.id, template: s.template },
    build: s.tasks ? () => s.tasks.map((t) => remap(customToSim(t))) : (rng, scale) => SCENARIOS[s.template].build(rng, scale).map(remap),
  };
  return { sc, cfg };
}

/**
 * Price a spec: run it headless over `runs` seeds (seed, seed + 7919, …) and summarize each run's
 * final orchestrator summary. Yields to the page every few milliseconds, so the UI stays live;
 * resolves null when `signal.cancelled` turns true.
 */
async function estimateSpec(spec, { runs = 8, onProgress = null, signal = null } = {}) {
  const s = deepCopy(spec);
  const rows = [];
  for (let i = 0; i < runs; i++) {
    const { sc, cfg } = compileSpec(s);
    const seed = ((s.seed - 1 + i * 7919) % 2147483647) + 1;
    const sim = new Sim(sc, { seed, scale: s.scale, cfg });
    sim.headless = true;
    let sum = null;
    sim.out = (e) => { if (e.type === 'agent.completed' && e.agentId === 'orch') sum = e.payload.summary; };
    sim.start();
    const LIMIT = 6 * 3600 * 1000; // a guard on sim time, never reached by a sane spec
    while (!sim.done && sim.t < LIMIT) {
      const t0 = performance.now();
      while (!sim.done && sim.t < LIMIT && performance.now() - t0 < 12) for (let k = 0; k < 40 && !sim.done; k++) sim.step();
      if (signal && signal.cancelled) return null;
      if (onProgress) {
        let res = 0;
        for (const t of sim.tasks.values()) if (sim.resolved(t)) res++;
        onProgress((i + (sim.tasks.size ? res / sim.tasks.size : 0) * 0.98) / runs);
      }
      await new Promise((r) => setTimeout(r, 0));
    }
    rows.push(sum ? { cost: sum.cost, ms: sum.durationMs, tokens: sum.tokens, peak: sum.peak, failed: sum.tasksFailed, stalled: sim.stalled }
      : { cost: sim.totals.cost, ms: sim.t, tokens: sim.totals.tokens, peak: sim.stats.peak, failed: sim.stats.tasksFailed, stalled: true });
  }
  if (onProgress) onProgress(1);
  const col = (k) => rows.map((r) => r[k]);
  return {
    sig: specSig(s), at: Date.now(), runs,
    cost: { min: Math.min(...col('cost')), p50: quantile(col('cost'), 0.5), max: Math.max(...col('cost')) },
    durationMs: { p50: quantile(col('ms'), 0.5), max: Math.max(...col('ms')) },
    tokens: { p50: quantile(col('tokens'), 0.5) }, peak: { p50: quantile(col('peak'), 0.5) },
    failed: col('failed').reduce((a, b) => a + b, 0) / runs,
    over: rows.filter((r) => r.cost > s.budget).length, stalled: rows.filter((r) => r.stalled).length,
  };
}

/* ---- live: a spec → an agnostic crew request ---- */
const PRIORITY_WIRE = ['normal', 'low', 'normal', 'high', 'critical'];
const EXPECTED_OUTPUT = {
  code: 'The change as a patch, with a one-paragraph summary', review: 'Approval, or a numbered list of the changes required',
  test: 'Pass and fail counts, and the names of any failing tests', research: 'The key findings as bullet points, each with its source',
  synthesis: 'A short synthesis of the findings', plan: 'A numbered plan', analysis: 'A numbered analysis with a conclusion',
  report: 'The finished document, in Markdown', comms: 'The finished message, ready to send', data: 'What was stored, and where',
  ops: 'What was done and the system state afterwards', diagnose: 'The anomalies found, most likely cause first', triage: 'Severity, impact and next steps',
  verify: 'Pass or fail for each check', work: 'A concise result',
};
/** Map a free-text agent role onto the view's five unit roles (a preset agent's sprite). */
function guessRole(text) {
  const t = String(text || '').toLowerCase();
  if (/review|audit|qa\\b|quality|secur|complian|verif|test/.test(t)) return 'reviewer';
  if (/research|analy|investigat|scien|insight|search/.test(t)) return 'researcher';
  if (/deploy|ops|monitor|infra|release|pipeline|runner|sre|operat/.test(t)) return 'runner';
  if (/plan|manag|lead|architect|strateg|coordinat|product|owner/.test(t)) return 'planner';
  return 'coder';
}
/** A preset document's agent → a crew agent definition (allow-listed fields only), or null. */
function presetAgent(p, i) {
  if (!p || typeof p !== 'object') return null;
  const key = typeof p.agent_key === 'string' ? p.agent_key : typeof p.key === 'string' ? p.key : 'agent-' + (i + 1);
  if (!/^[a-z0-9][a-z0-9-]{0,99}$/.test(key) || typeof p.role !== 'string' || !p.role || typeof p.goal !== 'string' || !p.goal) return null;
  const def = { key, role: p.role, goal: p.goal };
  for (const f of ['name', 'backstory', 'domain', 'complexity']) if (typeof p[f] === 'string' && p[f]) def[f] = p[f];
  if (typeof p.allow_delegation === 'boolean') def.allow_delegation = p.allow_delegation;
  return { def, view: guessRole(p.role + ' ' + (p.name || '') + ' ' + key) };
}
/**
 * The crew a spec submits, and the plan the live view binds the crew's events to.
 *
 * Only the primary tasks travel: fan-out, rework, regions, caps, tools and the failure model are
 * simulator settings. The roster is one agent per role the tasks use (with the spec's goals and
 * live models), or a preset's agents. `process` 'auto' is a DAG when any task has dependencies.
 */
function specToCrewRequest(s, preset) {
  const order = topoOrder(specTasks(s)) || [];
  const pos = new Map(order.map((t, i) => [t.key, i]));
  const process = s.live.process === 'auto' ? (order.some((t) => (t.deps || []).length) ? 'dag' : 'parallel') : s.live.process;
  let roster = [];
  if (s.live.roster === 'preset' && preset && Array.isArray(preset.agents)) {
    const seen = new Set();
    for (const [i, p] of preset.agents.slice(0, 100).entries()) {
      const a = presetAgent(p, i);
      if (a && !seen.has(a.def.key)) { seen.add(a.def.key); roster.push(a); }
    }
  }
  if (!roster.length) {
    const used = new Set(order.map((t) => t.role));
    roster = ROLE_KEYS.filter((r) => used.has(r)).map((r) => {
      const def = { key: r, name: ROLES[r].label, role: ROLES[r].label, goal: s.roles[r].goal };
      if (s.live.models[r]) def.llm_model = s.live.models[r];
      return { def, view: r };
    });
  }
  const objective = s.objective.trim();
  const tasks = order.map((t) => {
    const o = {
      description: (objective ? 'Mission: ' + objective + '\\nTask: ' : '') + t.title,
      expected_output: EXPECTED_OUTPUT[t.kind] || EXPECTED_OUTPUT.work, priority: PRIORITY_WIRE[clamp(t.priority || 2, 1, 4)],
    };
    const d = t.difficulty || 1;
    if (d >= 10) o.risk = 'high'; else if (d > 1.2) o.risk = 'medium';
    if (process === 'dag') {
      const deps = (t.deps || []).map((k) => pos.get(k)).filter((x) => x !== undefined);
      if (deps.length) o.dependencies = deps;
    }
    return o;
  });
  const request = { name: s.name, process, agents: roster.map((a) => a.def), tasks };
  if (process === 'parallel') request.max_concurrency = s.live.maxConcurrency;
  return {
    request,
    plan: {
      process,
      maxConcurrency: process === 'parallel' ? s.live.maxConcurrency : 0,
      tasks: order.map((t, i) => ({ idx: i, key: t.key, title: t.title, role: t.role, kind: t.kind || 'work', priority: t.priority || 1,
        deps: process === 'parallel' ? [] : (t.deps || []).filter((k) => pos.has(k)), description: tasks[i].description })),
      agents: roster.map((a) => ({ key: a.def.key, name: a.def.name || a.def.key, role: a.view, model: a.def.llm_model || '' })),
    },
  };
}

/* =====================================================================================
 *  SECTION 3 · EVENTSOURCE IMPLEMENTATIONS (+ matching CommandSinks)
 * ===================================================================================== */

/** MockSource — owns a Sim and advances it on a fixed timestep against a speed-scaled clock. */
class MockSource extends EventSource {
  constructor(sim) {
    super();
    this.sim = sim;
    this.capabilities = { pause: true, speed: true, seek: false };
    this.clock = 0;
    this.started = false;
    sim.out = (e) => this._emit(e);
  }
  start() {
    if (this.started) return;
    this.started = true;
    this.sim.start();
  }
  update(realDtMs) {
    if (!this.started || this.paused || this.ended) return;
    this.clock += Math.min(realDtMs, 100) * this.speed; // clamp: a backgrounded tab must not fast-forward minutes at once
    while (!this.sim.done && this.sim.t + this.sim.dt <= this.clock) this.sim.step();
    if (this.sim.done) { this.ended = true; this.clock = this.sim.t; }
  }
  /** Headless fast-forward (tests / thumbnails). */
  runToEnd(maxMs = 15 * 60 * 1000) {
    this.start();
    while (!this.sim.done && this.sim.t < maxMs) this.sim.step();
    this.clock = this.sim.t;
    this.ended = this.sim.done;
  }
  now() { return this.clock; }
}

/** MockCommandSink — commands go straight into the simulator, whose reaction comes back as events. */
class MockCommandSink extends CommandSink {
  constructor(sim) { super(); this.sim = sim; }
  send(cmd) {
    try { return Promise.resolve(this.sim.command(cmd)); }
    catch (err) { console.error(err); return Promise.resolve({ ok: false, message: String(err && err.message || err) }); }
  }
}

/** ReplaySource — plays back a recorded event log with pause / speed / seek. */
class ReplaySource extends EventSource {
  constructor(log) {
    super();
    this.log = log;
    this.capabilities = { pause: true, speed: true, seek: true };
    this.clock = 0;
    this.idx = 0;
    this.duration = log.length ? log[log.length - 1].timestamp : 0;
    this.onRewind = null; // set by the app: consumers must reset before history is re-emitted
  }
  start() { this.idx = 0; this.clock = 0; this.ended = false; }
  update(realDtMs) {
    if (this.paused) return;
    this.clock = Math.min(this.duration, this.clock + Math.min(realDtMs, 100) * this.speed);
    this._pump();
    if (this.clock >= this.duration) { this.ended = true; this.paused = true; }
  }
  _pump() { while (this.idx < this.log.length && this.log[this.idx].timestamp <= this.clock) this._emit(this.log[this.idx++]); }
  seek(ms) {
    ms = clamp(ms, 0, this.duration);
    if (ms < this.clock) {
      this.idx = 0;
      this.clock = ms;
      if (this.onRewind) this.onRewind(ms);
    } else this.clock = ms;
    this._pump();
    this.ended = this.clock >= this.duration;
  }
  now() { return this.clock; }
}

/** Replays are read-only. */
class ReadOnlySink extends CommandSink {
  send() { return Promise.resolve({ ok: false, message: 'Replay is read-only — exit replay to issue orders' }); }
}

/**
 * LiveCrewSource — drives the view from a real agnostic crew, through the host bridge.
 *
 * agnostic numbers every event of a crew and stamps it with when it collected it (0.1.9), so the
 * source reads with a cursor — GET /crews/{id}/events?after=N — and sees each event exactly once,
 * one poll at a time; the view's clock follows the server's (`at_ms`), so a replay keeps the
 * crew's real pace. Tasks are bound by the ENGINE's task ids, never by matching description text:
 * a crew this source submits takes them from the 202 (`task_ids`, in request order), and any other
 * crew — an earlier run of this swarm, a crew from the Crews list — from GET /crews/{id}/plan,
 * which describes its agents and tasks. A crew from before the server last restarted has no plan
 * and no events left; its outcome alone is shown.
 *
 *     crew_started   → the orchestrator reports the run
 *     task_started   → a unit of the agent the engine chose walks to the task and works it (a clone
 *                      when that agent is already busy; in a parallel crew, beyond the concurrency
 *                      limit the task waits as queued — the engine reports a whole wave at once)
 *     token          → the task's output (the engine sends the whole text as one token event; a
 *                      parallel or DAG crew sends none, and its outputs arrive with the outcome)
 *     task_completed → task done or failed; the unit returns to HQ (a clone retires)
 *     crew_completed → mission over; GET /crews/{id} fills in results, usage and anything missed
 *
 * Tokens and cost. While the crew runs, tokens are estimated from output length (≈ 4 characters
 * each) and shown with ≈. When it ends, GET /crews/{id} answers what the engine METERED for each
 * task — tokens, model, duration, and the gateway's cost when it reported one — and those replace
 * the estimate. A cost the gateway did not report stays n/a: never a simulated number.
 *
 * Losing contact is not an outcome. No answer, a 401 or a 403 pauses the source — it says so, and
 * resumes when the shell answers again (a sign-in re-sends init) — rather than recording the crew
 * as lost. Only the server saying it holds no such crew ends it that way.
 */
const CREW_TERMINAL = new Set(['completed', 'failed', 'cancelled', 'unknown']);
/** A task's title from a crew task description: the part after this plugin's \"Mission: …\\nTask: \" prefix. */
function taskTitle(description, i) {
  const m = /^Mission:[^\\n]*\\n(?:Task: )?([\\s\\S]*)$/.exec(String(description || ''));
  return oneLine(m ? m[1] : description, 90) || 'Task ' + (i + 1);
}
/**
 * The plan GET /crews/{id}/plan describes, in the view's terms. When the crew is this swarm's own
 * (`built` has the same tasks in the same order) its titles, roles and kinds are kept; otherwise
 * they come from the crew itself.
 */
function planFromServer(p, built) {
  const tasks = p && Array.isArray(p.tasks) ? p.tasks : [];
  const ours = built && built.plan && built.plan.tasks.length === tasks.length
    && built.plan.tasks.every((t, i) => tasks[i] && t.description === tasks[i].description);
  const keyOf = (j) => (ours ? built.plan.tasks[j].key : 't' + j);
  const plan = {
    process: p && typeof p.process === 'string' ? p.process : 'sequential',
    maxConcurrency: p && Number.isInteger(p.max_concurrency) ? p.max_concurrency : 0,
    tasks: tasks.map((t, i) => {
      const own = ours ? built.plan.tasks[i] : null;
      const deps = Array.isArray(t.dependencies) ? t.dependencies.filter((j) => Number.isInteger(j) && j >= 0 && j < tasks.length && j !== i).map(keyOf) : [];
      return {
        idx: i, key: keyOf(i), title: own ? own.title : taskTitle(t.description, i),
        role: own ? own.role : guessRole(t.description), kind: own ? own.kind : 'work',
        priority: own ? own.priority : ({ critical: 4, high: 3, normal: 2, low: 1, background: 1 }[t.priority] || 2),
        deps, description: typeof t.description === 'string' ? t.description : '', engineId: typeof t.task_id === 'string' ? t.task_id : null,
      };
    }),
    agents: (p && Array.isArray(p.agents) ? p.agents : []).filter((a) => a && typeof a.key === 'string').map((a) => ({
      key: a.key, name: typeof a.name === 'string' && a.name ? a.name : a.key,
      role: guessRole((a.role || '') + ' ' + (a.name || '') + ' ' + a.key), model: typeof a.llm_model === 'string' ? a.llm_model : '',
    })),
  };
  return plan;
}

class LiveCrewSource extends EventSource {
  /**
   * `built` is {request, plan} from specToCrewRequest when this source submits the crew, and may be
   * null when it watches one (`opts.crewId`): the plan then comes from the server.
   * opts: {crewId, idempotencyKey, onSubmitted(crewId|null, engineMode, status), onFinished(status, summary)}.
   */
  constructor(host, spec, built, opts = {}) {
    super();
    this.capabilities = { pause: false, speed: false, seek: false, commands: false };
    this.host = host;
    this.spec = spec;
    this.built = built || null;
    this.request = built ? built.request : null;
    this.crewId = opts.crewId || null;
    this.idemKey = opts.idempotencyKey || null;
    this.onSubmitted = opts.onSubmitted || null;
    this.onFinished = opts.onFinished || null;
    // Timing, in ms — fields so a test can run a whole crew in milliseconds.
    this.firstPollMs = 400;
    this.pollMs = 1000;
    this.hiddenPollMs = 5000;
    this.retryMs = 1500;
    this.t0 = 0;
    this.seq = 0;
    this.timer = 0;
    this.stopped = false;
    this.finished = false;
    this.polling = false;
    this.misses = 0;
    this.waiting = '';            // why the source is paused, or '' while it runs
    this.after = 0;               // the event cursor: the highest number read
    this.serverT = 0;             // the server's clock (at_ms) as of `serverAt`
    this.serverAt = 0;
    this.status = this.crewId ? 'pending' : 'submitting';
    this.engineMode = '';
    this.lost = 0;
    this.missed = 0;
    this.byEngine = new Map();     // engine task id → plan task
    this.outputs = new Map();      // engine task id → output seen before its task was bound
    this.unitTokens = {};
    this.tokens = 0;               // estimated while running; replaced by the metered total at the end
    this.tokensActual = false;
    this.usage = null;             // the crew's metered usage, once the outcome is read
    this.peak = 0;
    this.wallMs = 0;
    this.times = null;             // {submitted, started, finished} epoch ms, from the outcome
    this.sawEnd = false;
    this.unforwarded = [];
    this.tasks = [];
    this.byKey = new Map();
    this.agents = new Map();
    // Submitting: the swarm's own plan IS the crew's. Watching: the crew's plan comes from the
    // server (attach), and `built` only lends titles and roles when the tasks are the same.
    if (this.built && !this.crewId) this.adoptPlan(this.built.plan);
    this.unwatchHost = host.onChange(() => { if (this.waiting && !this.stopped && !this.finished) this.resume(); });
  }
  /** Take `plan` as the crew's tasks and roster. */
  adoptPlan(plan) {
    this.plan = plan;
    this.tasks = plan.tasks.map((t) => Object.assign({}, t, { id: 't' + t.idx, status: 'pending', output: '', startedAt: 0, agentKey: null, unit: null, usage: null }));
    this.byKey = new Map(this.tasks.map((t) => [t.key, t]));
    for (const t of this.tasks) if (t.engineId) this.byEngine.set(t.engineId, t);
    this.agents = new Map(plan.agents.map((a) => [a.key, Object.assign({}, a, { id: 'ag-' + safeId(a.key), busyMain: false, clones: 0 })]));
  }
  /** The view's clock: the server's `at_ms`, advanced by the time since it was last seen. */
  now() {
    if (!this.t0) return 0;
    if (this.finished) return this.serverT;
    return this.serverT + (performance.now() - this.serverAt);
  }
  ts() { return Math.round(this.now()); }
  /** An event the server stamped at `at` ms: keep the clock from running behind it. */
  sync(at) {
    if (!Number.isFinite(at) || at < 0) return;
    if (at > this.now()) { this.serverT = at; this.serverAt = performance.now(); }
  }
  emit(type, agentId, taskId, payload, at) {
    const e = { id: 'L' + ++this.seq, type, timestamp: at != null ? at : this.ts(), territory: type === 'resource.tick' ? 'global' : 'local', payload: payload || {} };
    if (agentId) e.agentId = agentId;
    if (taskId) e.taskId = taskId;
    this._emit(e);
  }
  say(step) { this.emit('agent.state_changed', 'orch', null, { state: this.finished ? 'done' : this.waiting ? 'paused' : 'working', step }); }
  start() {
    this.t0 = performance.now();
    this.serverAt = this.t0;
    this.bootOrchestrator();
    if (this.crewId) this.attach(); else this.submit();
  }
  stop() { this.stopped = true; clearTimeout(this.timer); if (this.unwatchHost) this.unwatchHost(); }
  bootOrchestrator() {
    this.emit('agent.spawned', 'orch', null, {
      name: 'agnostic', role: 'orchestrator', model: 'crew', health: 100, spawnAt: { kind: 'hq' },
      mission: { title: this.spec.name, scenario: 'live', objective: this.spec.objective, budget: 0, seed: 0, kind: 'live', specId: this.spec.id, crewId: this.crewId || '' },
      world: {
        territories: [{ id: 'local', name: 'agnostic', region: 'this server', kind: 'local', cap: Math.max(1, this.agents.size), costPerSec: 0, speed: 1, latencyMs: {} }],
        tools: [{ id: 'local.llm', kind: 'llm', name: 'LLM gateway', territory: 'local' }],
      },
    });
  }
  /** Put the plan's tasks and agents on the map. */
  bootPlan() {
    for (const t of this.tasks) {
      this.emit('task.created', null, t.id, { title: t.title, role: t.role, deps: t.deps.map((k) => this.byKey.get(k)).filter(Boolean).map((x) => x.id), work: 1, kind: t.kind, priority: t.priority });
    }
    for (const a of this.agents.values()) this.emit('agent.spawned', a.id, null, { name: a.name, role: a.role, model: a.model || 'server default', health: 100, spawnAt: { kind: 'hq' } });
  }
  /** Watch a crew this source did not submit: its plan from the server, then its events. */
  async attach() {
    this.say('Reattaching to crew ' + this.crewId.slice(0, 8));
    const r = await this.host.request('GET', '/api/v1/crews/' + this.crewId + '/plan');
    if (this.stopped) return;
    if (r.status === 200 && r.data && Array.isArray(r.data.tasks)) {
      this.adoptPlan(planFromServer(r.data, this.built));
