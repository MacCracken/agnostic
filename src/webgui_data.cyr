      case 'agent.message': this._message(e, p); break;
      case 'agent.error': this._error(e, p); break;
      case 'agent.completed': this._ended(e, p, 'completed'); break;
      case 'agent.terminated': this._ended(e, p, p.reason || 'terminated'); break;
      case 'task.created': this._taskCreated(e, p); break;
      case 'task.assigned': this._taskAssigned(e, p); break;
      case 'task.progress': { const t = this.task(e); t.progress = clamp(+p.progress || 0, 0, 1); if (t.status === 'pending' && t.assignees.size) t.status = 'active'; break; }
      case 'task.completed': this._taskResolved(e, p, 'done'); break;
      case 'task.failed': this._taskResolved(e, p, 'failed'); break;
      case 'tool.called': this._toolCalled(e, p); break;
      case 'tool.returned': this._toolReturned(e, p); break;
      case 'resource.tick': this._resources(e, p); break;
    }
    if (FEED_CAT[e.type] && !(e.type === 'agent.state_changed' && !/^(paused|done)$/.test(p.state) && !p.held)) this._feed(e);
    this.version++;
    for (const fn of this.listeners) fn(e, this);
  }

  /* ---------- lookups with graceful auto-registration (real sources may omit world info) ---------- */
  ensureTerritory(id, def) {
    let t = this.territories.get(id);
    if (!t) {
      t = Object.assign({ id, name: id, region: '', kind: id === 'local' ? 'local' : 'cloud', cap: 0, costPerSec: 0, speed: 1, latencyMs: {},
        active: 0, tokens: 0, cost: 0, rate: 0 }, def || {});
      this.territories.set(id, t);
      this.worldVersion++;
    } else if (def) Object.assign(t, def);
    return t;
  }
  ensureTool(id, kind, territory, name) {
    let t = this.tools.get(id);
    if (!t) {
      t = { id, kind: kind || 'llm', name: name || (TOOL_KINDS[kind] || TOOL_KINDS.llm).label, territory: territory || 'local', calls: 0, errors: 0, slow: 0,
        active: new Set(), lastCallAt: -1e9, lastSlowAt: -1e9 };
      this.tools.set(id, t);
      this.ensureTerritory(t.territory);
      this.worldVersion++;
    }
    return t;
  }
  agent(e) {
    let a = this.agents.get(e.agentId);
    if (!a) a = this._newAgent(e.agentId, { name: e.agentId, role: 'coder' }, e);
    return a;
  }
  task(e) {
    let t = this.tasks.get(e.taskId);
    if (!t) t = this._taskCreated(e, { title: e.taskId, role: 'coder', deps: [] });
    return t;
  }
  agentName(id) { const a = this.agents.get(id); return a ? a.name : id === undefined ? '?' : String(id); }
  refLabel(ref) {
    if (!ref) return '?';
    switch (ref.kind) {
      case 'hq': return 'HQ';
      case 'gateway': return (this.territories.get(ref.id) || { name: ref.id }).name + ' gateway';
      case 'tool': { const t = this.tools.get(ref.id); return t ? t.name + ' (' + t.territory + ')' : ref.id; }
      case 'task': { const t = this.tasks.get(ref.id); return t ? t.title : ref.id; }
      case 'agent': return this.agentName(ref.id);
      default: return 'waypoint';
    }
  }
  log(a, text, cls) {
    a.log.push({ t: this.time, text, cls: cls || '' });
    if (a.log.length > 40) a.log.splice(0, a.log.length - 40);
  }
  setState(a, s, t) {
    if (a.state === s) return;
    a.state = s;
    a.stateSince = t;
    a.timeline.push({ t, s });
    if (a.timeline.length > 240) a.timeline.splice(0, 60);
  }
  setAgentTask(a, taskId) {
    if (a.taskId === taskId) return;
    const prev = a.taskId && this.tasks.get(a.taskId);
    if (prev) {
      prev.assignees.delete(a.id);
      if (prev.status === 'active' && prev.assignees.size === 0) prev.status = 'pending';
    }
    a.taskId = taskId || null;
  }

  /* ---------- agents ---------- */
  _newAgent(id, p, e) {
    const a = {
      id, name: p.name || id, role: ROLES[p.role] ? p.role : 'coder', model: p.model || 'unknown', territory: e.territory, parentId: p.parentId || null,
      state: 'idle', step: 'Spawning', expectedMs: 0, stateSince: e.timestamp, taskId: null, toolId: null, held: false, slow: false,
      tokens: 0, cost: 0, health: p.health == null ? 100 : p.health, errors: 0, spawnedAt: e.timestamp, endedAt: 0, alive: true, endReason: null,
      log: [], timeline: [{ t: e.timestamp, s: 'idle' }], retryOf: p.retryOf || null, spawnAt: p.spawnAt || null, dest: null,
    };
    this.agents.set(id, a);
    return a;
  }
  _spawned(e, p) {
    const a = this._newAgent(e.agentId, p, e);
    if (p.role === 'orchestrator') {
      this.orchestratorId = a.id;
      if (p.world) {
        for (const t of p.world.territories || []) this.ensureTerritory(t.id, t);
        for (const t of p.world.tools || []) this.ensureTool(t.id, t.kind, t.territory, t.name);
      }
      if (p.mission) Object.assign(this.mission, p.mission);
      this.mission.status = 'running';
      this.mission.startedAt = e.timestamp;
      this.resources.budget = (p.mission && p.mission.budget) || 0;
      this.log(a, 'Mission received: ' + (this.mission.objective || this.mission.title));
      return;
    }
    const s = this.stats;
    s.agentsSpawned++;
    s.roleCounts[a.role] = (s.roleCounts[a.role] || 0) + 1;
    s.territoryAgents[e.territory] = (s.territoryAgents[e.territory] || 0) + 1;
    if (a.retryOf) s.retries++;
    this.log(a, 'Spawned in ' + e.territory + ' · ' + a.model + (a.retryOf ? ' · retry of ' + this.agentName(a.retryOf) : a.parentId ? ' · sub-agent of ' + this.agentName(a.parentId) : ''));
    if (p.taskId) this._taskAssigned({ agentId: a.id, taskId: p.taskId, timestamp: e.timestamp }, { mode: 'spawn' });
  }
  _moved(e, p) {
    const a = this.agent(e);
    if (a.territory !== e.territory) { this.log(a, 'Migrating ' + a.territory + ' → ' + e.territory); a.territory = e.territory; this.stats.migrations++; }
    a.dest = p.to || null;
    a.toolId = null;
    a.expectedMs = p.durationMs || 0;
    a.step = '→ ' + this.refLabel(p.to);
    this.setState(a, 'moving', e.timestamp);
    a.stateSince = e.timestamp;
  }
  _state(e, p) {
    const a = this.agent(e);
    if ('taskId' in p) this.setAgentTask(a, p.taskId);
    if ('held' in p) a.held = !!p.held;
    if (p.state !== 'working') a.toolId = null;
    a.step = p.step || a.step;
    a.expectedMs = p.expectedMs || 0;
    this.setState(a, p.state || a.state, e.timestamp);
    a.stateSince = e.timestamp;
    if (p.state === 'paused' || p.state === 'idle' || /^Fanning|^Coordinating|^Waiting/.test(p.step || '')) this.log(a, p.step);
  }
  _message(e, p) {
    const a = this.agent(e);
    const to = this.agents.get(p.to);
    this.stats.messages++;
    this.log(a, '→ ' + (to ? to.name : p.to) + ': ' + (p.text || p.kind));
    if (to) this.log(to, '← ' + a.name + ': ' + (p.text || p.kind));
  }
  _error(e, p) {
    const a = this.agent(e);
    a.health = p.health == null ? Math.max(0, a.health - (p.damage || 20)) : p.health;
    a.errors++;
    this.stats.errors++;
    this.log(a, (p.fatal ? '✖ FATAL ' : '⚠ ') + (p.code ? p.code + ': ' : '') + (p.message || 'error'), 'err');
    if (!p.fatal) {
      a.step = (p.message || 'Error') + (p.retryInMs ? ' — retry in ' + (p.retryInMs / 1000).toFixed(1) + 's' : '');
      a.expectedMs = p.retryInMs || 0;
      this.setState(a, 'error', e.timestamp);
      a.stateSince = e.timestamp;
    }
  }
  _ended(e, p, reason) {
    const a = this.agent(e);
    if (!a.alive) return;
    a.alive = false;
    a.endedAt = e.timestamp;
    a.endReason = reason;
    if (p.tokens != null) a.tokens = p.tokens;
    if (p.cost != null) a.cost = p.cost;
    this.setAgentTask(a, null);
    if (a.toolId) { const t = this.tools.get(a.toolId); if (t) t.active.delete(a.id); a.toolId = null; }
    this.setState(a, reason === 'completed' ? 'done' : 'dead', e.timestamp);
    if (reason === 'crashed') this.stats.crashes++;
    this.log(a, reason === 'completed' ? '✔ ' + (p.result || 'Completed') : '✖ Terminated (' + reason + ')', reason === 'completed' ? 'ok' : 'err');
    if (a.id === this.orchestratorId) {
      this.mission.status = 'complete';
      this.mission.endedAt = e.timestamp;
      this.mission.summary = p.summary || null;
    }
  }

  /* ---------- tasks ---------- */
  _taskCreated(e, p) {
    const deps = (p.deps || []).filter((d) => d !== e.taskId);
    let depth = p.depth;
    if (depth == null) depth = deps.reduce((m, d) => Math.max(m, ((this.tasks.get(d) || {}).depth || 0) + 1), 0);
    const t = {
      id: e.taskId, title: p.title || e.taskId, role: p.role || 'coder', kind: p.kind || 'work', deps, dependents: [], parentId: p.parentId || null,
      children: [], depth, index: p.index || 0, of: p.of || 1, territory: e.territory, status: 'locked', progress: 0, assignees: new Set(),
      createdAt: e.timestamp, unlockedAt: 0, completedAt: 0, priority: p.priority || 1, result: '', attempts: 0, work: p.work || 0,
    };
    this.tasks.set(t.id, t);
    for (const d of deps) { const dt = this.tasks.get(d); if (dt) dt.dependents.push(t.id); }
    if (t.parentId) { const par = this.tasks.get(t.parentId); if (par) par.children.push(t.id); }
    this.stats.tasksTotal++;
    this._recompute(t, e.timestamp);
    return t;
  }
  _recompute(t, now) {
    if (t.status === 'done' || t.status === 'failed') return;
    const locked = t.deps.some((d) => { const x = this.tasks.get(d); return x && x.status !== 'done' && x.status !== 'failed'; });
    if (locked) { t.status = 'locked'; return; }
    if (t.status === 'locked') t.unlockedAt = now;
    t.status = t.assignees.size ? 'active' : 'pending';
  }
  _taskAssigned(e, p) {
    const t = this.task(e);
    const a = this.agents.get(e.agentId);
    if (!a) return;
    this.setAgentTask(a, t.id);
    t.assignees.add(a.id);
    if (t.status === 'pending') t.status = 'active';
    if (p.mode === 'retry') t.attempts++;
    this.log(a, 'Assigned: ' + t.title + (p.mode && p.mode !== 'auto' ? ' (' + p.mode + ')' : ''));
  }
  _taskResolved(e, p, status) {
    const t = this.task(e);
    t.status = status;
    t.completedAt = e.timestamp;
    if (status === 'done') { t.progress = 1; t.result = p.result || ''; this.stats.tasksDone++; }
    else {
      this.stats.tasksFailed++;
      t.result = p.reason || 'failed';
      this.markers.push({ id: 'm' + t.id, t: e.timestamp, taskId: t.id, territory: t.territory, text: 'FAILED: ' + t.title, reason: p.reason || '' });
    }
    for (const id of t.assignees) { const a = this.agents.get(id); if (a && a.taskId === t.id) a.taskId = null; }
    t.assignees.clear();
    for (const d of t.dependents) { const dt = this.tasks.get(d); if (dt) this._recompute(dt, e.timestamp); }
  }

  /* ---------- tools & resources ---------- */
  _toolCalled(e, p) {
    const tool = this.ensureTool(p.toolId || e.territory + '.' + (p.kind || 'llm'), p.kind, e.territory);
    tool.calls++;
    tool.lastCallAt = e.timestamp;
    tool.active.add(e.agentId);
    if (p.slow) { tool.slow++; tool.lastSlowAt = e.timestamp; this.stats.slowCalls++; }
    this.stats.toolCalls++;
    const a = this.agent(e);
    a.toolId = tool.id;
    a.slow = !!p.slow;
    a.step = (p.slow ? '⏳ ' : '') + tool.name + ': ' + (p.op || tool.kind);
    a.expectedMs = p.expectedMs || 0;
    this.setState(a, 'working', e.timestamp);
    a.stateSince = e.timestamp;
    this.log(a, '⚙ ' + tool.name + (tool.territory !== a.territory ? ' @' + tool.territory : '') + ' · ' + (p.op || '') + (p.slow ? ' (slow)' : ''));
  }
  _toolReturned(e, p) {
    const tool = this.tools.get(p.toolId);
    if (tool) { tool.active.delete(e.agentId); if (p.ok === false) tool.errors++; }
    const a = this.agent(e);
    if (a.toolId === p.toolId) a.toolId = null;
    a.slow = false;
    this.log(a, '↩ ' + (p.ok === false ? 'failed: ' : '') + (p.result || 'ok') + (p.latencyMs ? ' · ' + (p.latencyMs / 1000).toFixed(1) + 's' : ''), p.ok === false ? 'err' : '');
  }
  _resources(e, p) {
    const r = this.resources;
    for (const k of ['tokens', 'tokensPerSec', 'cost', 'costPerSec', 'active', 'cap', 'estimated', 'costKnown']) if (p[k] != null) r[k] = p[k];
    if (p.budget) r.budget = p.budget;
    if (p.byTerritory) {
      r.byTerritory = p.byTerritory;
      for (const id in p.byTerritory) {
        const b = p.byTerritory[id];
        const t = this.ensureTerritory(id);
        t.active = b.active; t.tokens = b.tokens; t.cost = b.cost; t.rate = b.costPerSec || 0;
        if (b.cap) t.cap = b.cap;
      }
    }
    if (p.agents) for (const id in p.agents) { const a = this.agents.get(id); if (a) { a.tokens = p.agents[id][0]; a.cost = p.agents[id][1]; } }
    this.stats.peakActive = Math.max(this.stats.peakActive, r.active || 0);
    this.tpsHistory.push(r.tokensPerSec || 0);
    if (this.tpsHistory.length > 120) this.tpsHistory.shift();
  }

  /* ---------- feed ---------- */
  _feed(e) {
    const d = describeEvent(e, this);
    if (!d) return;
    d.seq = ++this.feedSeq;
    d.e = e;
    this.feed.push(d);
    if (this.feed.length > 600) this.feed.splice(0, 100);
  }

  /** Mission summary computed purely from events (works for any source). */
  summary() {
    let localTok = 0, cloudTok = 0, localCost = 0, cloudCost = 0, localAgents = 0, cloudAgents = 0;
    for (const t of this.territories.values()) {
      const n = this.stats.territoryAgents[t.id] || 0;
      if (t.kind === 'local') { localTok += t.tokens; localCost += t.cost; localAgents += n; }
      else { cloudTok += t.tokens; cloudCost += t.cost; cloudAgents += n; }
    }
    const s = this.stats;
    const resolved = s.tasksDone + s.tasksFailed;
    return {
      durationMs: (this.mission.endedAt || this.time) - (this.mission.startedAt || 0),
      tokens: this.resources.tokens, cost: this.resources.cost, budget: this.resources.budget,
      successRate: resolved ? s.tasksDone / resolved : 1, tasksDone: s.tasksDone, tasksFailed: s.tasksFailed, tasksTotal: s.tasksTotal,
      agentsUsed: s.agentsSpawned, peakActive: s.peakActive, errors: s.errors, crashes: s.crashes, retries: s.retries, toolCalls: s.toolCalls,
      messages: s.messages, slowCalls: s.slowCalls, migrations: s.migrations,
      localTok, cloudTok, localCost, cloudCost, localAgents, cloudAgents, roleCounts: s.roleCounts,
    };
  }
}

/** Human-readable feed line for an event. Returns {cat, icon, who, text, cls, agentId, taskId, toolId}. */
function describeEvent(e, s) {
  const p = e.payload || {};
  const who = e.agentId ? s.agentName(e.agentId) : '';
  const task = e.taskId ? s.tasks.get(e.taskId) : null;
  const tt = task ? task.title : e.taskId;
  const base = { cat: FEED_CAT[e.type], agentId: e.agentId || null, taskId: e.taskId || null, toolId: p.toolId || null, t: e.timestamp, who, cls: '' };
  switch (e.type) {
    case 'agent.spawned':
      return Object.assign(base, { icon: '✚', text: p.role === 'orchestrator' ? 'online · mission: ' + (p.mission ? p.mission.objective : '') : (p.retryOf ? 'respawned at HQ (retry of ' + s.agentName(p.retryOf) + ')' : 'spawned in ' + e.territory + (p.parentId ? ' by ' + s.agentName(p.parentId) : '')) });
    case 'agent.moved': return Object.assign(base, { icon: '➜', text: (p.reason === 'migrate' ? 'migrating to ' + e.territory + ' · ' : '') + '→ ' + s.refLabel(p.to) });
    case 'agent.state_changed': return Object.assign(base, { icon: p.state === 'paused' ? '❚❚' : '•', text: p.step || p.state });
    case 'agent.message': return Object.assign(base, { icon: '✉', text: '→ ' + s.agentName(p.to) + ': ' + (p.text || p.kind) });
    case 'agent.error': return Object.assign(base, { icon: p.fatal ? '✖' : '⚠', text: (p.fatal ? 'CRASHED · ' : '') + (p.code ? p.code + ' · ' : '') + (p.message || ''), cls: 'error' });
    case 'agent.completed': return Object.assign(base, { icon: '✔', text: p.result || 'completed', cls: 'ok' });
    case 'agent.terminated': return Object.assign(base, { icon: '✖', text: 'terminated (' + (p.reason || '?') + ')', cls: p.reason === 'released' ? '' : 'error' });
    case 'task.created': return Object.assign(base, { icon: '◇', who: '', text: 'Task created: ' + tt + (p.deps && p.deps.length ? ' · ' + p.deps.length + ' deps' : '') });
    case 'task.assigned': return Object.assign(base, { icon: '◆', text: 'assigned → ' + tt + (p.mode && p.mode !== 'auto' ? ' (' + p.mode + ')' : '') });
    case 'task.completed': return Object.assign(base, { icon: '✔', who: '', text: 'Task done: ' + tt + (p.result ? ' — ' + p.result : ''), cls: 'ok' });
    case 'task.failed': return Object.assign(base, { icon: '☠', who: '', text: 'Task FAILED: ' + tt + ' — ' + (p.reason || ''), cls: 'error' });
    case 'tool.called': { const tool = s.tools.get(p.toolId); return Object.assign(base, { icon: '⚙', text: (tool ? tool.name : p.kind) + ' · ' + (p.op || '') + (p.slow ? ' ⏳ slow' : '') }); }
    case 'tool.returned': { const tool = s.tools.get(p.toolId); return Object.assign(base, { icon: p.ok === false ? '⚠' : '↩', text: (tool ? tool.name : p.kind) + ' → ' + (p.result || 'ok'), cls: p.ok === false ? 'error' : '' }); }
  }
  return null;
}

/* =====================================================================================
 *  SECTION 5 · RENDERER
 *  5a Layout   — owns every coordinate. Derived from store data alone: territories sit at distances
 *                proportional to network latency; tasks fill rings outward along dependency chains.
 *  5b Visual   — per-entity animation state (paths, effects, pulses, fog reveals), derived from events.
 *  5c Renderer — Canvas 2D drawing of the map and the minimap.
 *  Nothing in this section reads simulator internals — only the Store and the event stream.
 * ===================================================================================== */
const RING_STEP = 125;   // radial distance between task rings
const BIG_GAP = 72;      // half arc-length a primary task claims (room for its fan-out satellites)
const SMALL_GAP = 24;    // half arc-length a small cross-territory sub-task claims
// Fan-out of cloud regions (by latency rank). The farthest sits \"behind\" the nearer two.
const CLOUD_ANGLES = [-30, 30, 0, 62, -62, 14, 80, -80].map((d) => (d * Math.PI) / 180);
const angDiff = (a, b) => Math.abs(Math.atan2(Math.sin(a - b), Math.cos(a - b)));
const satRadius = (n) => Math.max(48, (n * 24) / TAU);

class Layout {
  constructor() { this.reset(); }
  reset() {
    this.terr = new Map();   // id → {id, x, y, r, baseR, kind, angle, facing, rings:[{r, occ:[[angle, halfWidth]]}]}
    this.tools = new Map();  // id → {x, y, territory, kind}
    this.tasks = new Map();  // id → {x, y, r, sat, small, parent, angle, ring, territory}
    this.version = -1;
    this.hub = null;
    this.scale = 1;
    this.bounds = { minX: -1400, minY: -1000, maxX: 1400, maxY: 1000 };
    this.boundsVersion = 0;
  }

  /** (Re)place territories and tool structures whenever the store learns about new ones. */
  sync(store) {
    if (store.worldVersion === this.version) return;
    this.version = store.worldVersion;
    const list = [...store.territories.values()];
    if (!list.length) return;
    const hub = list.find((t) => t.kind === 'local') || list[0];
    this.hub = hub.id;
    let totalCap = 0;
    for (const t of list) totalCap += t.cap || 60;
    const f = (this.scale = clamp(Math.sqrt(totalCap / 248), 1, 1.8));
    const lat = (t) => (hub.latencyMs && hub.latencyMs[t.id]) || (t.latencyMs && t.latencyMs[hub.id]) || 120;
    const clouds = list.filter((t) => t !== hub).sort((a, b) => lat(a) - lat(b) || (a.id < b.id ? -1 : 1));
    const place = (t, x, y, r, angle, facing) => {
      let L = this.terr.get(t.id);
      if (!L) { L = { id: t.id, rings: [], r: 0 }; this.terr.set(t.id, L); }
      Object.assign(L, { x, y, kind: t.kind, angle, facing, baseR: r, r: Math.max(L.r, r) });
    };
    place(hub, 0, 0, 500 * f, 0, 0);
    // Distance from HQ encodes network latency. (A real deployment with many regions would want a
    // force layout here; a fixed fan is plenty for a handful.)
    clouds.forEach((t, i) => {
      const ang = CLOUD_ANGLES[i % CLOUD_ANGLES.length];
      const d = (1200 + lat(t) * 4 + Math.floor(i / CLOUD_ANGLES.length) * 900) * f;
      place(t, Math.cos(ang) * d, Math.sin(ang) * d, 400 * f, ang, ang + Math.PI);
    });
    const byTerr = new Map();
    for (const tool of store.tools.values()) {
      if (!byTerr.has(tool.territory)) byTerr.set(tool.territory, []);
      byTerr.get(tool.territory).push(tool);
    }
    for (const [id, arr] of byTerr) {
      const T = this.terr.get(id);
      if (!T) continue;
      const rr = (T.kind === 'local' ? 150 : 125) * Math.min(f, 1.3);
      arr.forEach((tool, i) => {
        const a = T.facing + Math.PI / arr.length + (i / arr.length) * TAU;
        this.tools.set(tool.id, { x: T.x + Math.cos(a) * rr, y: T.y + Math.sin(a) * rr, territory: id, kind: tool.kind });
      });
    }
    this._bounds();
  }
  _bounds() {
    let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    for (const T of this.terr.values()) {
      minX = Math.min(minX, T.x - T.r); maxX = Math.max(maxX, T.x + T.r);
      minY = Math.min(minY, T.y - T.r); maxY = Math.max(maxY, T.y + T.r);
    }
    if (minX === Infinity) return;
    const m = 240;
    this.bounds = { minX: minX - m, minY: minY - m, maxX: maxX + m, maxY: maxY + m };
    this.boundsVersion++;
  }
  _ring(T, i) {
    while (T.rings.length <= i) {
      const r0 = (T.kind === 'local' ? 250 : 215) * Math.min(this.scale, 1.3);
      T.rings.push({ r: r0 + T.rings.length * RING_STEP, occ: [] });
    }
    return T.rings[i];
  }
  /** Nearest free angle to `pref` on a ring, or null when the ring is full. */
  _free(R, pref, w) {
    const step = Math.max(0.015, w / 4);
    const maxK = Math.ceil(Math.PI / step) * 2 + 2;
    for (let k = 0; k <= maxK; k++) {
      const off = (k % 2 ? 1 : -1) * Math.ceil(k / 2) * step;
      if (Math.abs(off) > Math.PI) break;
      const th = pref + off;
      let ok = true;
      for (const o of R.occ) if (angDiff(th, o[0]) < o[1] + w - 1e-9) { ok = false; break; }
      if (ok) return th;
    }
    return null;
  }
  _grow(T, r) { if (r > T.r) { T.r = r; this._bounds(); } }

  /**
   * Stable slot for a task. Fan-out children orbit their parent as satellites; everything else sits on a
   * ring one step further out than its same-territory dependencies, at the angle of those dependencies —
   * so pipelines read as spokes radiating out from the core, and fog lifts outward as work unlocks.
   */
  addTask(task, store) {
    if (this.tasks.has(task.id)) return this.tasks.get(task.id);
    const T = this.terr.get(task.territory) || this.terr.get(this.hub);
    if (!T) return null;
    const parent = task.parentId && store.tasks.get(task.parentId);
    const P = parent && this.tasks.get(parent.id);
    let L;
    if (P && !P.sat && !P.small && P.territory === T.id) {
      const n = Math.max(1, task.of || 1);
      const ang = P.angle + (n === 1 ? 0 : Math.PI / n) + ((task.index || 0) / n) * TAU;
      const rs = satRadius(n);
      L = { x: P.x + Math.cos(ang) * rs, y: P.y + Math.sin(ang) * rs, r: 9, sat: true, small: true, parent: parent.id, angle: ang, ring: P.ring, territory: T.id };
      this._grow(T, dist(T.x, T.y, L.x, L.y) + 60);
    } else {
      const small = !!parent;
      let ring = 0, sx = 0, sy = 0, k = 0;
      for (const d of task.deps) {
        let D = this.tasks.get(d);
        if (!D || D.territory !== T.id) continue;
        if (D.sat) D = this.tasks.get(D.parent) || D;
        ring = Math.max(ring, D.ring + 1);
        sx += Math.cos(D.angle); sy += Math.sin(D.angle); k++;
      }
      const pref = k ? Math.atan2(sy, sx) : T.facing;
      let ang = null, R = null;
      for (let guard = 0; guard < 30 && ang == null; guard++) {
        R = this._ring(T, ring);
        const w = (small ? SMALL_GAP : BIG_GAP) / R.r;
        ang = this._free(R, pref, w);
        if (ang == null) ring++;
        else R.occ.push([ang, w]);
      }
      if (ang == null) ang = pref;
      L = { x: T.x + Math.cos(ang) * R.r, y: T.y + Math.sin(ang) * R.r, r: small ? 11 : 18, sat: false, small, parent: null, angle: ang, ring, territory: T.id };
      this._grow(T, R.r + (small ? 65 : 105));
    }
    this.tasks.set(task.id, L);
    return L;
  }
  center(territoryId) { const T = this.terr.get(territoryId); return T ? { x: T.x, y: T.y } : { x: 0, y: 0 }; }
  posOf(ref) {
    if (!ref) return this.center(this.hub);
    switch (ref.kind) {
      case 'hq': return this.center(this.hub);
      case 'gateway': return this.center(ref.id);
      case 'tool': return this.tools.get(ref.id) || this.center(this.hub);
      case 'task': return this.tasks.get(ref.id) || this.center(this.hub);
      case 'point': return { x: ref.x || 0, y: ref.y || 0 };
      default: return null;
    }
  }
  territoryAt(x, y) {
    let best = null, bd = Infinity;
    for (const T of this.terr.values()) {
      const d = dist(x, y, T.x, T.y);
      if (d < T.r && d / T.r < bd) { bd = d / T.r; best = T.id; }
    }
    return best;
  }
  /** Point on territory A's rim facing territory B — where network links attach. */
  port(aId, bId) {
    const A = this.terr.get(aId), B = this.terr.get(bId);
    if (!A || !B) return A || B || { x: 0, y: 0 };
    const d = dist(A.x, A.y, B.x, B.y) || 1;
    return { x: A.x + ((B.x - A.x) / d) * A.r * 0.82, y: A.y + ((B.y - A.y) / d) * A.r * 0.82 };
  }
}

/* ---------------- 5b Visual state ---------------- */
const SLOT_R = { task: [26, 22], small: [14, 8], tool: [36, 22], hq: [68, 56], gateway: [46, 46], point: [0, 26], agent: [20, 12] };
const easeInOut = (k) => (k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2);

class Visual {
  constructor(layout, clock) {
    this.layout = layout;
    this.clock = clock; // () => source time; lets bulk replays skip effects that are already over
    this.reset();
  }
  reset() {
    this.units = new Map();  // agentId → {x, y, path, seg, len, t0, dur, seed, seed2, alive, endT, endKind, spawnT, hitT, terr, role, orch}
    this.effects = [];
    this.pulses = [];
    this.reveals = new Map(); // taskId → time its fog started lifting
    this.sawMoves = false;
    this.fogDirty = true;
  }
  fx(kind, x, y, t0, dur, extra) {
    if (this.clock() - t0 > dur) return;
    this.effects.push(Object.assign({ kind, x, y, t0, dur }, extra || {}));
  }
  unitPos(u, t) {
    if (!u.path) return u;
    if (t <= u.t0) return u.path[0];
    let d = easeInOut(clamp((t - u.t0) / u.dur, 0, 1)) * u.len;
    const P = u.path;
    for (let i = 1; i < P.length; i++) {
      const seg = u.seg[i - 1];
      if (d <= seg || i === P.length - 1) {
        const f = seg ? Math.min(1, d / seg) : 1;
        return { x: P[i - 1].x + (P[i].x - P[i - 1].x) * f, y: P[i - 1].y + (P[i].y - P[i - 1].y) * f };
      }
      d -= seg;
    }
    return P[P.length - 1];
  }
  freeze(u, t) { const p = this.unitPos(u, t); u.x = p.x; u.y = p.y; u.path = null; }
  slotFor(u, ref) {
    let key = ref.kind;
    if (key === 'task') { const L = this.layout.tasks.get(ref.id); if (L && L.small) key = 'small'; }
    const [base, spread] = SLOT_R[key] || SLOT_R.point;
    const a = u.seed * TAU, r = base + u.seed2 * spread;
    return { x: Math.cos(a) * r, y: Math.sin(a) * r };
  }
  refPos(ref, t) {
    if (ref && ref.kind === 'agent') {
      const o = this.units.get(ref.id);
      return o ? this.unitPos(o, t) : this.layout.center(this.layout.hub);
    }
    return this.layout.posOf(ref) || this.layout.center(this.layout.hub);
  }
  /** Path from the unit's current interpolated position to a slot at `ref`, via network ports when crossing territories. */
  routeTo(u, ref, t0, durationMs) {
    const start = this.unitPos(u, t0);
    const dest = this.refPos(ref, t0);
    const off = this.slotFor(u, ref);
    const end = { x: dest.x + off.x, y: dest.y + off.y };
    const L = this.layout;
    const fromT = L.territoryAt(start.x, start.y) || u.terr;
    const toT = (ref.kind === 'gateway' && ref.id) || (ref.kind === 'hq' && L.hub) || L.territoryAt(dest.x, dest.y) || fromT;
    const path = [{ x: start.x, y: start.y }];
    if (fromT && toT && fromT !== toT) { path.push(L.port(fromT, toT)); path.push(L.port(toT, fromT)); }
    path.push(end);
    const seg = [];
    let len = 0;
    for (let i = 1; i < path.length; i++) { const s = dist(path[i - 1].x, path[i - 1].y, path[i].x, path[i].y); seg.push(s); len += s; }
    Object.assign(u, { path, seg, len: len || 1, t0, dur: durationMs || Math.max(400, (len / 300) * 1000), destKey: ref.kind + ':' + (ref.id || ''), x: start.x, y: start.y });
  }

  onEvent(e, store) {
    const t = e.timestamp;
    const p = e.payload || {};
    switch (e.type) {
      case 'agent.spawned': {
        this.layout.sync(store);
        const u = { id: e.agentId, x: 0, y: 0, path: null, seed: hash01(e.agentId, 1), seed2: hash01(e.agentId, 2), alive: true, endT: 0, endKind: '',
          spawnT: t, hitT: -1e9, terr: e.territory, role: ROLES[p.role] ? p.role : 'coder', destKey: '', orch: p.role === 'orchestrator' };
        if (u.orch) { const c = this.layout.center(this.layout.hub); u.x = c.x; u.y = c.y; this.units.set(u.id, u); break; }
        const at = p.spawnAt || (e.territory === this.layout.hub ? { kind: 'hq' } : { kind: 'gateway', id: e.territory });
        const base = at.kind === 'agent' ? this.refPos(at, t) : this.layout.posOf(at.kind === 'gateway' ? { kind: 'gateway', id: at.id || e.territory } : at);
        const off = this.slotFor(u, at.kind === 'agent' ? { kind: 'agent' } : at);
        u.x = base.x + off.x; u.y = base.y + off.y;
        this.units.set(u.id, u);
        this.fx('spawn', u.x, u.y, t, 650, { color: ROLES[u.role].color });
        if (at.kind === 'gateway') { const hq = this.layout.center(this.layout.hub); this.fx('beam', hq.x, hq.y, t, 750, { x2: base.x, y2: base.y, color: '#a78bfa' }); }
        if (p.retryOf) this.fx('ring', u.x, u.y, t, 1200, { color: '#fcd34d', r: 54 });
        break;
      }
      case 'agent.moved': {
        this.sawMoves = true;
        const u = this.units.get(e.agentId);
        if (!u || u.orch || !p.to) break;
        u.terr = e.territory;
        this.routeTo(u, p.to, t, p.durationMs);
        break;
      }
      case 'agent.state_changed': {
        const u = this.units.get(e.agentId);
        if (u && p.state === 'paused' && u.path) this.freeze(u, t);
        break;
      }
      case 'agent.error': {
        const u = this.units.get(e.agentId);
        if (!u) break;
        u.hitT = t;
        const pos = this.unitPos(u, t);
        this.fx('hit', pos.x, pos.y, t, 900, { text: p.fatal ? 'CRASH' : '-' + (p.damage || 0) });
        if (p.fatal) this.fx('explode', pos.x, pos.y, t, 1000, { seed: u.seed });
        break;
      }
      case 'agent.completed':
      case 'agent.terminated': {
        const u = this.units.get(e.agentId);
        if (!u || !u.alive) break;
        this.freeze(u, t);
        u.alive = false;
        u.endT = t;
        u.endKind = e.type === 'agent.completed' ? 'done' : p.reason || 'dead';
        if (u.orch) break;
        if (u.endKind === 'done') this.fx('done', u.x, u.y, t, 800);
        else if (u.endKind === 'crashed') this.fx('wreck', u.x, u.y, t, 20000, { seed: u.seed });
        else if (u.endKind === 'user') this.fx('zap', u.x, u.y, t, 650);
        break;
      }
      case 'agent.message': {
        if (!p.to || !this.units.has(e.agentId)) break;
        const dur = Math.max(250, p.durationMs || 800);
        if (this.clock() - t > dur) break;
        this.pulses.push({ from: e.agentId, to: p.to, t0: t, dur, kind: p.kind || 'info' });
        break;
      }
      case 'task.created': {
        this.layout.sync(store);
        const task = store.tasks.get(e.taskId);
        const L = task && this.layout.addTask(task, store);
        if (task && task.status !== 'locked') this.reveals.set(task.id, t);
        if (L && !L.sat && task.status !== 'locked') this.fx('reveal', L.x, L.y, t, 1100);
        this.fogDirty = true;
        break;
      }
      case 'task.assigned':
      case 'tool.called': {
        if (this.sawMoves) break; // only synthesize travel for sources that don't emit agent.moved
        const u = this.units.get(e.agentId);
        if (!u || u.orch) break;
        const ref = e.type === 'tool.called' ? { kind: 'tool', id: p.toolId } : { kind: 'task', id: e.taskId };
        if (u.destKey !== ref.kind + ':' + ref.id) this.routeTo(u, ref, t, 0);
        break;
      }
      case 'task.completed':
      case 'task.failed': {
        const L = this.layout.tasks.get(e.taskId);
        if (L) this.fx(e.type === 'task.completed' ? 'taskdone' : 'taskfail', L.x, L.y, t, 1300, { r: L.r });
        const task = store.tasks.get(e.taskId);
        if (task) {
          for (const d of task.dependents) {
            const dt = store.tasks.get(d);
            if (!dt || dt.status === 'locked' || this.reveals.has(d)) continue;
            this.reveals.set(d, t);
            const DL = this.layout.tasks.get(d);
            if (DL) this.fx('reveal', DL.x, DL.y, t, 1100);
          }
        }
        this.fogDirty = true;
        break;
      }
      case 'tool.returned':
        if (p.ok === false) { const L = this.layout.tools.get(p.toolId); if (L) this.fx('spark', L.x, L.y, t, 650, { seed: hash01(e.id) }); }
        break;
    }
  }

  /** Once per frame: advance interpolated positions, prune finished effects and faded units. */
  update(now) {
    for (const [id, u] of this.units) {
      if (u.path) {
        const pos = this.unitPos(u, now);
        u.x = pos.x; u.y = pos.y;
        if (now >= u.t0 + u.dur) u.path = null;
      }
      if (!u.alive && !u.orch && now - u.endT > 900) this.units.delete(id);
    }
    if (this.effects.length) this.effects = this.effects.filter((f) => now - f.t0 < f.dur && now >= f.t0 - 50);
    if (this.pulses.length) this.pulses = this.pulses.filter((q) => now - q.t0 < q.dur && now >= q.t0 - 50);
  }
}

/* ---------------- 5c Renderer ---------------- */
const FONT = '-apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, sans-serif';
const MONO = 'ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, monospace';
const PULSE_COLORS = { result: '#4ade80', request: '#fcd34d', info: '#38bdf8', review: '#f472b6' };
const TASK_GLYPH = { code: '{}', review: '✓', test: '▶', research: '?', synthesis: 'Σ', plan: '≡', analysis: '∴', report: '✎', data: 'DB',
  triage: '!', diagnose: '~', ops: '⚙', comms: '@', verify: '✓', work: '•' };
const TOOL_GLYPH = { llm: 'AI', search: 'WEB', exec: '>_', db: 'DB', fs: 'FS' };

const _rgb = new Map();
function rgba(hex, a) {
  let c = _rgb.get(hex);
  if (!c) { const n = parseInt(hex.slice(1), 16); c = (n >> 16 & 255) + ',' + (n >> 8 & 255) + ',' + (n & 255); _rgb.set(hex, c); }
  return 'rgba(' + c + ',' + a + ')';
}
function polyPath(ctx, x, y, r, n, rot) {
  for (let i = 0; i < n; i++) {
    const a = rot + (i / n) * TAU;
    if (i === 0) ctx.moveTo(x + Math.cos(a) * r, y + Math.sin(a) * r);
    else ctx.lineTo(x + Math.cos(a) * r, y + Math.sin(a) * r);
  }
  ctx.closePath();
}
/** Adds the role's silhouette as a sub-path (so many units can share one fill call). */
function rolePath(ctx, role, x, y, r) {
  switch ((ROLES[role] || ROLES.coder).shape) {
    case 'diamond': return polyPath(ctx, x, y, r * 1.2, 4, -Math.PI / 2);
    case 'triangle': return polyPath(ctx, x, y + r * 0.15, r * 1.3, 3, -Math.PI / 2);
    case 'square': return polyPath(ctx, x, y, r * 1.12, 4, Math.PI / 4);
    case 'pentagon': return polyPath(ctx, x, y, r * 1.12, 5, -Math.PI / 2);
    case 'hexagon': return polyPath(ctx, x, y, r * 1.1, 6, 0);
    default: return polyPath(ctx, x, y, r * 1.25, 6, Math.PI / 6);
  }
}
/** Small standalone icon (HUD portraits, legend). */
function drawRoleIcon(canvas, role, state, health) {
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const w = canvas.clientWidth || 32, h = canvas.clientHeight || 32;
  if (canvas.width !== Math.round(w * dpr)) { canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr); }
  const g = canvas.getContext('2d');
  g.setTransform(dpr, 0, 0, dpr, 0, 0);
  g.clearRect(0, 0, w, h);
  const r = Math.min(w, h) * 0.26, x = w / 2, y = h / 2 - (health != null ? 2 : 0);
  if (state) { g.beginPath(); g.arc(x, y, r + 5, 0, TAU); g.strokeStyle = STATE_COLORS[state] || STATE_COLORS.idle; g.lineWidth = 2.2; g.stroke(); }
  g.beginPath();
  if (role === 'orchestrator') polyPath(g, x, y, r * 1.25, 6, Math.PI / 6); else rolePath(g, role, x, y, r);
  g.fillStyle = state === 'dead' ? '#3f3f46' : (ROLES[role] || ROLES.coder).color;
  g.fill();
  g.strokeStyle = 'rgba(0,0,0,.6)'; g.lineWidth = 1; g.stroke();
  if (health != null) {
    g.fillStyle = 'rgba(0,0,0,.7)'; g.fillRect(4, h - 6, w - 8, 3);
    g.fillStyle = health > 60 ? '#22c55e' : health > 30 ? '#f59e0b' : '#ef4444'; g.fillRect(4, h - 6, (w - 8) * clamp(health / 100, 0, 1), 3);
  }
}

class Renderer {
  constructor(canvas, minimap, store, layout, visual, ui) {
    Object.assign(this, { canvas, minimap, store, layout, visual, ui });
    this.ctx = canvas.getContext('2d', { alpha: false });
    this.mctx = minimap.getContext('2d');
    this.cam = { x: 0, y: 0, zoom: 0.4, target: null };
    this.inset = { l: 0, t: 48, r: 336, b: 222 };
    this.fog = document.createElement('canvas');
    this.fctx = this.fog.getContext('2d');
    this.fogBase = null;
    this.fogBuilt = null;
    this.fogUntil = 0;
    this.fogForce = true;
    this.glows = new Map();
    this.hole = this._makeHole();
    this.frame = 0;
    this.view = { minX: 0, minY: 0, maxX: 1, maxY: 1 };
    this.px = 1;
    this.resize();
  }

  /* ---------- camera ---------- */
  resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    this.dpr = dpr; this.W = window.innerWidth; this.H = window.innerHeight;
    this.canvas.width = Math.round(this.W * dpr); this.canvas.height = Math.round(this.H * dpr);
    const r = this.minimap.getBoundingClientRect();
    this.mW = Math.max(10, r.width); this.mH = Math.max(10, r.height);
    this.minimap.width = Math.round(this.mW * dpr); this.minimap.height = Math.round(this.mH * dpr);
  }
  freeCenter() { const i = this.inset; return { x: (i.l + this.W - i.r) / 2, y: (i.t + this.H - i.b) / 2 }; }
  toWorld(sx, sy) { const c = this.cam; return { x: (sx - this.W / 2) / c.zoom + c.x, y: (sy - this.H / 2) / c.zoom + c.y }; }
  toScreen(wx, wy) { const c = this.cam; return { x: (wx - c.x) * c.zoom + this.W / 2, y: (wy - c.y) * c.zoom + this.H / 2 }; }
  panBy(dx, dy) { this.cam.x -= dx / this.cam.zoom; this.cam.y -= dy / this.cam.zoom; this.cam.target = null; this.clampCam(); }
  zoomAt(sx, sy, factor) {
    const c = this.cam;
    const before = this.toWorld(sx, sy);
    c.zoom = clamp(c.zoom * factor, 0.07, 2.8);
    const after = this.toWorld(sx, sy);
    c.x += before.x - after.x; c.y += before.y - after.y;
    c.target = null;
    this.clampCam();
  }
  /** Smoothly bring a world point to the centre of the unobstructed part of the map. */
  focus(wx, wy, zoom) {
    const z = zoom || this.cam.zoom, fc = this.freeCenter();
    this.cam.target = { x: wx - (fc.x - this.W / 2) / z, y: wy - (fc.y - this.H / 2) / z, zoom: z };
  }
  /** Fit the whole map. `loose` lets the edges tuck under the translucent HUD panels for a bigger picture. */
  fitAll(instant, loose) {
    const b = this.layout.bounds, i = loose ? { l: 0, t: 48, r: 180, b: 110 } : this.inset;
    const w = this.W - i.l - i.r, h = this.H - i.t - i.b;
    const z = clamp(Math.min(w / (b.maxX - b.minX), h / (b.maxY - b.minY)), 0.07, 1.2);
    this.cam.target = { x: (b.minX + b.maxX) / 2 - ((i.l + this.W - i.r) / 2 - this.W / 2) / z, y: (b.minY + b.maxY) / 2 - ((i.t + this.H - i.b) / 2 - this.H / 2) / z, zoom: z };
    if (instant) this._snap();
  }
  _snap() { const t = this.cam.target; if (t) { Object.assign(this.cam, { x: t.x, y: t.y, zoom: t.zoom }); this.cam.target = null; } }
  updateCamera(dt) {
    const c = this.cam, t = c.target;
    if (!t) return;
    const k = 1 - Math.pow(0.002, Math.min(dt, 100) / 1000);
    c.x = lerp(c.x, t.x, k); c.y = lerp(c.y, t.y, k); c.zoom = lerp(c.zoom, t.zoom, k);
    if (Math.abs(c.x - t.x) * c.zoom < 0.5 && Math.abs(c.y - t.y) * c.zoom < 0.5 && Math.abs(c.zoom - t.zoom) < 0.0005) this._snap();
  }
  clampCam() {
    const b = this.layout.bounds, c = this.cam;
    c.x = clamp(c.x, b.minX - 300, b.maxX + 300);
    c.y = clamp(c.y, b.minY - 300, b.maxY + 300);
  }

  /* ---------- sprites ---------- */
  glow(color) {
    let c = this.glows.get(color);
    if (!c) {
      c = document.createElement('canvas'); c.width = c.height = 64;
      const g = c.getContext('2d'), gr = g.createRadialGradient(32, 32, 0, 32, 32, 32);
      gr.addColorStop(0, rgba(color, 1)); gr.addColorStop(0.22, rgba(color, 0.55)); gr.addColorStop(0.55, rgba(color, 0.14)); gr.addColorStop(1, rgba(color, 0));
      g.fillStyle = gr; g.fillRect(0, 0, 64, 64);
      this.glows.set(color, c);
    }
    return c;
  }
  _makeHole() {
    const c = document.createElement('canvas'); c.width = c.height = 128;
    const g = c.getContext('2d'), gr = g.createRadialGradient(64, 64, 0, 64, 64, 64);
    gr.addColorStop(0, 'rgba(0,0,0,1)'); gr.addColorStop(0.5, 'rgba(0,0,0,0.92)'); gr.addColorStop(1, 'rgba(0,0,0,0)');
    g.fillStyle = gr; g.fillRect(0, 0, 128, 128);
    return c;
  }

  /* ---------- fog of war: low-res world-space mask, holes cut where work is unlocked ---------- */
  _fogBase() {
    const b = this.layout.bounds, fb = this.fogBuilt;
    if (fb && b.minX >= fb.minX && b.minY >= fb.minY && b.maxX <= fb.maxX && b.maxY <= fb.maxY) return;
    const pad = 700, s = 0.1;
    const B = { minX: b.minX - pad, minY: b.minY - pad, maxX: b.maxX + pad, maxY: b.maxY + pad };
    const w = Math.ceil((B.maxX - B.minX) * s), h = Math.ceil((B.maxY - B.minY) * s);
    const c = this.fogBase || document.createElement('canvas');
    c.width = w; c.height = h;
    const g = c.getContext('2d');
    g.fillStyle = 'rgba(3,7,12,0.8)';
    g.fillRect(0, 0, w, h);
    const rng = new RNG(99);
    for (let i = 0, n = (w * h) / 80; i < n; i++) {
      g.fillStyle = rng.chance(0.5) ? 'rgba(26,40,58,0.10)' : 'rgba(0,0,0,0.14)';
      g.beginPath(); g.arc(rng.next() * w, rng.next() * h, 3 + rng.next() * 15, 0, TAU); g.fill();
    }
    this.fogBase = c; this.fogBuilt = B; this.fogS = s;
    this.fog.width = w; this.fog.height = h;
    this.fogForce = true;
  }
  renderFog(now) {
    this._fogBase();
    const v = this.visual;
    if (!v.fogDirty && !this.fogForce && now > this.fogUntil) return;
    v.fogDirty = false; this.fogForce = false;
    const g = this.fctx, B = this.fogBuilt, s = this.fogS, L = this.layout;
    g.globalCompositeOperation = 'copy';
    g.drawImage(this.fogBase, 0, 0);
    g.globalCompositeOperation = 'destination-out';
    const hole = (x, y, r) => { if (r > 1) { const R = r * s; g.drawImage(this.hole, (x - B.minX) * s - R, (y - B.minY) * s - R, R * 2, R * 2); } };
    for (const T of L.terr.values()) hole(T.x, T.y, T.kind === 'local' ? 380 : 320);
    const hub = L.terr.get(L.hub);
    if (hub) for (const T of L.terr.values()) {
      if (T === hub) continue;
      const a = L.port(hub.id, T.id), b = L.port(T.id, hub.id);
      const n = Math.ceil(dist(a.x, a.y, b.x, b.y) / 70);
      for (let i = 0; i <= n; i++) hole(lerp(a.x, b.x, i / n), lerp(a.y, b.y, i / n), 100);
    }
    let until = 0;
    for (const t of this.store.tasks.values()) {
      if (t.status === 'locked') continue;
      const P = L.tasks.get(t.id);
      if (!P) continue;
      const rt = v.reveals.get(t.id);
      let k = 1;
      if (rt != null && now - rt < 1100) { k = smoothstep(clamp((now - rt) / 1100, 0, 1)); until = Math.max(until, rt + 1100); }
      hole(P.x, P.y, (P.sat ? 100 : P.small ? 110 : 210) * k);
    }
    this.fogUntil = until;
    g.globalCompositeOperation = 'source-over';
  }

  /* ---------- frame ---------- */
  draw(now, rt, dt) {
    const { ctx, dpr, W, H, cam } = this;
    this.frame++;
    this.layout.sync(this.store);
    this.updateCamera(dt);
    const z = cam.zoom;
    this.px = 1 / z;
    this.view = { minX: cam.x - W / 2 / z, maxX: cam.x + W / 2 / z, minY: cam.y - H / 2 / z, maxY: cam.y + H / 2 / z };
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.fillStyle = '#060a0f';
    ctx.fillRect(0, 0, W, H);
    ctx.setTransform(dpr * z, 0, 0, dpr * z, dpr * (W / 2 - cam.x * z), dpr * (H / 2 - cam.y * z));
    this.drawGrid();
    this.drawTerritories();
    this.drawLinks(now);
    this.drawDeps();
    this.drawTasks(now, false);
    this.drawStructures(now);
    if (this.ui.fog) {
      this.renderFog(now);
      const B = this.fogBuilt;
      ctx.imageSmoothingEnabled = true;
      ctx.drawImage(this.fog, B.minX, B.minY, this.fog.width / this.fogS, this.fog.height / this.fogS);
    }
    this.drawTasks(now, true);
    this.drawMarkers(now);
    this.drawEffects(now, 'under');
    this.drawUnitLinks(now);
    this.drawUnits(now, rt);
    this.drawPulses(now);
    this.drawEffects(now, 'over');
    this.drawOrders(rt);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    this.drawLabels(now, rt);
    this.drawBox();
    if (this.frame % 2 === 0) this.drawMinimap();
  }
  inView(x, y, m) { const v = this.view; return x > v.minX - m && x < v.maxX + m && y > v.minY - m && y < v.maxY + m; }

  drawGrid() {
    const { ctx, view: v } = this;
    let step = 200;
    while (step * this.cam.zoom < 30) step *= 2;
    ctx.beginPath();
    for (let x = Math.floor(v.minX / step) * step; x <= v.maxX; x += step) { ctx.moveTo(x, v.minY); ctx.lineTo(x, v.maxY); }
    for (let y = Math.floor(v.minY / step) * step; y <= v.maxY; y += step) { ctx.moveTo(v.minX, y); ctx.lineTo(v.maxX, y); }
    ctx.strokeStyle = 'rgba(110,150,190,0.05)';
    ctx.lineWidth = this.px;
    ctx.stroke();
  }

  drawTerritories() {
    const { ctx, layout, store, px } = this;
    for (const T of layout.terr.values()) {
      if (!this.inView(T.x, T.y, T.r + 60)) continue;
      const info = store.territories.get(T.id) || {};
      const local = T.kind === 'local';
      const col = local ? '#2dd4bf' : '#a78bfa';
      const g = ctx.createRadialGradient(T.x, T.y, T.r * 0.05, T.x, T.y, T.r);
      g.addColorStop(0, rgba(col, local ? 0.10 : 0.085));
      g.addColorStop(0.7, rgba(col, 0.04));
      g.addColorStop(1, rgba(col, 0.015));
      ctx.fillStyle = g;
      ctx.beginPath(); ctx.arc(T.x, T.y, T.r, 0, TAU); ctx.fill();
      ctx.beginPath();
      for (const R of T.rings) { ctx.moveTo(T.x + R.r, T.y); ctx.arc(T.x, T.y, R.r, 0, TAU); }
      ctx.strokeStyle = rgba(col, 0.06); ctx.lineWidth = px; ctx.stroke();
      ctx.beginPath(); ctx.arc(T.x, T.y, T.r, 0, TAU);
      ctx.strokeStyle = rgba(col, local ? 0.5 : 0.42);
      ctx.lineWidth = (local ? 2.5 : 2) * px;
      if (!local) ctx.setLineDash([14 * px, 9 * px]);
      ctx.stroke();
      ctx.setLineDash([]);
      if (info.cap) { // capacity gauge along the top of the border
        const span = Math.PI * 0.42, a0 = -Math.PI / 2 - span / 2, u = clamp((info.active || 0) / info.cap, 0, 1);
        ctx.lineCap = 'round'; ctx.lineWidth = 5 * px;
        ctx.beginPath(); ctx.arc(T.x, T.y, T.r + 11 * px, a0, a0 + span); ctx.strokeStyle = 'rgba(255,255,255,0.09)'; ctx.stroke();
        if (u > 0) { ctx.beginPath(); ctx.arc(T.x, T.y, T.r + 11 * px, a0, a0 + span * u); ctx.strokeStyle = u > 0.9 ? '#ef4444' : col; ctx.stroke(); }
        ctx.lineCap = 'butt';
      }
    }
  }

  drawLinks(now) {
    const { ctx, layout } = this;
    const hub = layout.terr.get(layout.hub);
    if (!hub) return;
    const ids = [...layout.terr.keys()];
    ctx.lineCap = 'round';
    for (let i = 0; i < ids.length; i++) for (let j = i + 1; j < ids.length; j++) {
      const A = layout.terr.get(ids[i]), B = layout.terr.get(ids[j]);
      const main = A === hub || B === hub;
      const from = B === hub ? B : A, to = B === hub ? A : B;
      const a = layout.port(from.id, to.id), b = layout.port(to.id, from.id);
      ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
      ctx.strokeStyle = main ? 'rgba(120,170,220,0.10)' : 'rgba(120,170,220,0.045)';
      ctx.lineWidth = main ? 36 : 14;
      ctx.stroke();
      ctx.setLineDash([18, 24]);
      ctx.lineDashOffset = -now / 22;
      ctx.strokeStyle = main ? 'rgba(130,200,255,0.28)' : 'rgba(130,200,255,0.1)';
      ctx.lineWidth = Math.max(main ? 3 : 2, 1.2 * this.px);
      ctx.stroke();
      ctx.setLineDash([]);
    }
    ctx.lineCap = 'butt';
  }

  drawDeps() {
    const { ctx, store, layout, px, ui } = this;
    const hov = ui.hover && ui.hover.kind === 'task' ? ui.hover.id : null;
    ctx.beginPath();
    for (const L of layout.tasks.values()) {
      if (!L.sat) continue;
      const P = layout.tasks.get(L.parent);
      if (P && this.inView(L.x, L.y, 120)) { ctx.moveTo(P.x, P.y); ctx.lineTo(L.x, L.y); }
    }
    ctx.strokeStyle = 'rgba(160,190,220,0.16)'; ctx.lineWidth = 1.2 * px; ctx.stroke();
    const met = [], unmet = [], hot = [];
    for (const t of store.tasks.values()) {
      if (!t.deps.length || t.status === 'done' || t.status === 'failed') continue;
      const B = layout.tasks.get(t.id);
      if (!B) continue;
      for (const d of t.deps) {
        const A = layout.tasks.get(d), D = store.tasks.get(d);
        if (!A || !D) continue;
        const seg = [A.x, A.y, B.x, B.y];
        if (hov && (hov === t.id || hov === d)) hot.push(seg);
        else if (t.status === 'locked') (D.status === 'done' || D.status === 'failed' ? met : unmet).push(seg);
      }
    }
    const stroke = (list, style, w, dash) => {
      if (!list.length) return;
      ctx.beginPath();
      for (const s of list) { ctx.moveTo(s[0], s[1]); ctx.lineTo(s[2], s[3]); }
      ctx.strokeStyle = style; ctx.lineWidth = w * px;
      if (dash) ctx.setLineDash([5 * px, 6 * px]);
      ctx.stroke(); ctx.setLineDash([]);
    };
    stroke(unmet, 'rgba(148,163,184,0.20)', 1.2, true);
    stroke(met, 'rgba(74,222,128,0.22)', 1.2, false);
    stroke(hot, 'rgba(56,189,248,0.75)', 2, false);
  }

  drawTasks(now, lockedPass) {
    const { ctx, store, layout, px, ui } = this;
    const z = this.cam.zoom;
    const hov = ui.hover && ui.hover.kind === 'task' ? ui.hover.id : null;
    let font = '';
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    for (const t of store.tasks.values()) {
      if ((t.status === 'locked') !== lockedPass) continue;
      const L = layout.tasks.get(t.id);
      if (!L || !this.inView(L.x, L.y, 90)) continue;
      const r = L.r, x = L.x, y = L.y;
      if (lockedPass) {
        ctx.beginPath(); ctx.arc(x, y, r, 0, TAU);
        ctx.fillStyle = 'rgba(8,13,20,0.75)'; ctx.fill();
        ctx.setLineDash([4 * px, 4 * px]);
        ctx.strokeStyle = hov === t.id ? 'rgba(226,232,240,0.9)' : 'rgba(148,163,184,0.5)';
        ctx.lineWidth = 1.5 * px; ctx.stroke(); ctx.setLineDash([]);
        if (r * z > 6) { // padlock
          const s = r * 0.42;
          ctx.fillStyle = 'rgba(148,163,184,0.7)';
          ctx.fillRect(x - s, y - s * 0.15, s * 2, s * 1.35);
          ctx.beginPath(); ctx.arc(x, y - s * 0.15, s * 0.68, Math.PI, 0);
          ctx.strokeStyle = 'rgba(148,163,184,0.7)'; ctx.lineWidth = s * 0.32; ctx.stroke();
        }
        continue;
      }
      const col = TASK_COLORS[t.status];
      const resolved = t.status === 'done' || t.status === 'failed';
      if (t.status === 'active' && !L.small) { // contested capture zone
        ctx.beginPath(); ctx.arc(x, y, r + 13, 0, TAU);
        ctx.setLineDash([6, 7]); ctx.lineDashOffset = -now / 40;
        ctx.strokeStyle = 'rgba(245,158,11,0.45)'; ctx.lineWidth = 1.6 * Math.max(1, px); ctx.stroke();
        ctx.setLineDash([]);
      }
      ctx.beginPath(); ctx.arc(x, y, r, 0, TAU);
      ctx.fillStyle = t.status === 'done' ? 'rgba(21,94,52,0.9)' : t.status === 'failed' ? 'rgba(127,29,29,0.92)' : '#0c1621';
      ctx.fill();
      ctx.strokeStyle = col; ctx.lineWidth = (hov === t.id ? 2.6 : 1.6) * px; ctx.stroke();
      if (!resolved) {
        const pr = r + 5;
        ctx.beginPath(); ctx.arc(x, y, pr, 0, TAU);
        ctx.strokeStyle = 'rgba(255,255,255,0.08)'; ctx.lineWidth = Math.max(3.5, 2.5 * px); ctx.stroke();
        if (t.progress > 0) {
          ctx.beginPath(); ctx.arc(x, y, pr, -Math.PI / 2, -Math.PI / 2 + TAU * t.progress);
          ctx.strokeStyle = t.status === 'active' ? '#fbbf24' : '#e2e8f0'; ctx.stroke();
        }
        if (!L.small) { // progress bar
          const bw = 50, bh = Math.max(5, 3.5 * px), by = y + r + 12;
          ctx.fillStyle = 'rgba(0,0,0,0.7)'; ctx.fillRect(x - bw / 2 - px, by - px, bw + 2 * px, bh + 2 * px);
          ctx.fillStyle = 'rgba(255,255,255,0.08)'; ctx.fillRect(x - bw / 2, by, bw, bh);
          ctx.fillStyle = t.status === 'active' ? '#f59e0b' : '#94a3b8'; ctx.fillRect(x - bw / 2, by, bw * t.progress, bh);
        }
      }
      if (r * z > 6.5) {
        const f = '700 ' + Math.round(r * (resolved ? 1 : 0.8)) + 'px ' + FONT;
        if (f !== font) { ctx.font = f; font = f; }
        ctx.fillStyle = resolved ? '#fff' : t.status === 'active' ? '#fde68a' : '#cbd5e1';
        ctx.fillText(t.status === 'done' ? '✓' : t.status === 'failed' ? '✕' : TASK_GLYPH[t.kind] || '•', x, y + 1);
      }
    }
  }

  drawStructures(now) {
    const { ctx, store, layout, px } = this;
    const z = this.cam.zoom;
    ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    for (const T of layout.terr.values()) { // cloud gateways
      if (T.id === layout.hub || !this.inView(T.x, T.y, 80)) continue;
      ctx.beginPath(); ctx.arc(T.x, T.y, 34, 0, TAU); ctx.fillStyle = 'rgba(35,24,72,0.92)'; ctx.fill();
      ctx.strokeStyle = 'rgba(167,139,250,0.85)'; ctx.lineWidth = 2.5; ctx.stroke();
      ctx.setLineDash([10, 8]); ctx.lineDashOffset = now / 50;
      ctx.beginPath(); ctx.arc(T.x, T.y, 46, 0, TAU); ctx.strokeStyle = 'rgba(167,139,250,0.45)'; ctx.lineWidth = 2; ctx.stroke();
      ctx.setLineDash([]);
      const a = now / 700;
      ctx.beginPath();
      for (let i = 0; i < 3; i++) { const s = a + (i * TAU) / 3; ctx.moveTo(T.x + Math.cos(s) * 22, T.y + Math.sin(s) * 22); ctx.arc(T.x, T.y, 22, s, s + 1.2); }
      ctx.strokeStyle = 'rgba(196,181,253,0.8)'; ctx.lineWidth = 3; ctx.stroke();
      if (34 * z > 9) { ctx.font = '700 15px ' + FONT; ctx.fillStyle = '#ddd6fe'; ctx.fillText('☁', T.x, T.y + 1); }
    }
    for (const [id, P] of layout.tools) {
      const tool = store.tools.get(id);
      if (!tool || !this.inView(P.x, P.y, 60)) continue;
      const col = (TOOL_KINDS[tool.kind] || TOOL_KINDS.llm).color;
      const busy = tool.active.size;
      if (busy) {
        ctx.globalCompositeOperation = 'lighter';
        const s = 46 + Math.min(30, busy * 4) + Math.sin(now / 180) * 3;
        ctx.globalAlpha = 0.35;
        ctx.drawImage(this.glow(col), P.x - s, P.y - s, s * 2, s * 2);
        ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
      }
      ctx.beginPath(); polyPath(ctx, P.x, P.y, 31, 6, Math.PI / 6);
      ctx.fillStyle = '#0d1520'; ctx.fill();
      ctx.strokeStyle = rgba(col, busy ? 0.9 : 0.45); ctx.lineWidth = (busy ? 2.4 : 1.6) * Math.max(1, px * 0.8); ctx.stroke();
      ctx.beginPath();
      switch (tool.kind) {
        case 'llm': polyPath(ctx, P.x, P.y, 19, 8, Math.PI / 8); break;
        case 'search': ctx.arc(P.x, P.y, 17, 0, TAU); break;
        case 'exec': ctx.rect(P.x - 16, P.y - 13, 32, 26); break;
        case 'db': ctx.ellipse(P.x, P.y - 10, 15, 5, 0, 0, TAU); ctx.moveTo(P.x - 15, P.y - 10); ctx.lineTo(P.x - 15, P.y + 10); ctx.ellipse(P.x, P.y + 10, 15, 5, 0, Math.PI, 0, true); ctx.lineTo(P.x + 15, P.y - 10); break;
        default: ctx.moveTo(P.x - 17, P.y - 12); ctx.lineTo(P.x - 5, P.y - 12); ctx.lineTo(P.x - 1, P.y - 8); ctx.lineTo(P.x + 17, P.y - 8); ctx.lineTo(P.x + 17, P.y + 13); ctx.lineTo(P.x - 17, P.y + 13); ctx.closePath();
      }
      ctx.fillStyle = rgba(col, busy ? 0.32 : 0.16); ctx.fill();
      ctx.strokeStyle = col; ctx.lineWidth = 1.6; ctx.stroke();
      if (31 * z > 9) { ctx.font = '700 10px ' + MONO; ctx.fillStyle = col; ctx.fillText(TOOL_GLYPH[tool.kind] || '?', P.x, P.y + 1); }
      if (busy && 31 * z > 7) {
        ctx.beginPath(); ctx.arc(P.x + 24, P.y - 22, 9, 0, TAU); ctx.fillStyle = col; ctx.fill();
        ctx.font = '700 10px ' + MONO; ctx.fillStyle = '#0b1118'; ctx.fillText(String(busy), P.x + 24, P.y - 21.5);
      }
      if (now - tool.lastSlowAt < 2500 && 31 * z > 6) { ctx.font = '13px ' + FONT; ctx.fillText('⏳', P.x - 25, P.y - 22); }
    }
    const hub = layout.terr.get(layout.hub); // HQ / orchestrator command center
    if (hub && this.inView(hub.x, hub.y, 90)) {
      const orch = store.agents.get(store.orchestratorId);
      const st = orch ? (orch.alive ? orch.state : 'done') : 'idle';
      const hovered = this.ui.hover && this.ui.hover.kind === 'agent' && this.ui.hover.id === store.orchestratorId;
      const selected = orch && this.ui.selection.has(orch.id);
      ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = 0.25;
      ctx.drawImage(this.glow('#fcd34d'), hub.x - 110, hub.y - 110, 220, 220);
      ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
      ctx.beginPath(); polyPath(ctx, hub.x, hub.y, 54, 6, Math.PI / 6);
      ctx.fillStyle = '#17120a'; ctx.fill();
      ctx.strokeStyle = selected ? '#4ade80' : hovered ? '#fff' : '#fcd34d'; ctx.lineWidth = 3; ctx.stroke();
      ctx.beginPath(); polyPath(ctx, hub.x, hub.y, 40, 6, Math.PI / 6); ctx.strokeStyle = 'rgba(252,211,77,0.35)'; ctx.lineWidth = 1.5; ctx.stroke();
      if (st === 'working' || st === 'idle') { // radar sweep
        const a = now / 900;
        const g = ctx.createConicGradient ? ctx.createConicGradient(a, hub.x, hub.y) : null;
        if (g) { g.addColorStop(0, 'rgba(252,211,77,0.35)'); g.addColorStop(0.15, 'rgba(252,211,77,0)'); g.addColorStop(1, 'rgba(252,211,77,0)'); ctx.fillStyle = g; ctx.beginPath(); ctx.arc(hub.x, hub.y, 38, 0, TAU); ctx.fill(); }
      }
      ctx.beginPath(); ctx.arc(hub.x, hub.y, 64, 0, TAU);
      ctx.strokeStyle = STATE_COLORS[st] || STATE_COLORS.idle; ctx.lineWidth = 3; ctx.stroke();
      if (orch && st === 'working' && orch.expectedMs > 0) {
        const p = clamp((now - orch.stateSince) / orch.expectedMs, 0, 1);
        ctx.beginPath(); ctx.arc(hub.x, hub.y, 64, -Math.PI / 2, -Math.PI / 2 + TAU * p); ctx.strokeStyle = '#fbbf24'; ctx.lineWidth = 5; ctx.stroke();
      }
      ctx.font = '800 17px ' + FONT; ctx.fillStyle = '#fcd34d'; ctx.fillText('HQ', hub.x, hub.y + 1);
    }
  }

  drawMarkers(now) {
    const { ctx, store, layout, px } = this;
    for (const m of store.markers) {
      const L = layout.tasks.get(m.taskId);
      if (!L || !this.inView(L.x, L.y, 80)) continue;
      const x = L.x + L.r * 0.9, y = L.y - L.r - 18;
      const age = now - m.t;
      if (age >= 0 && age < 5000) {
        const k = (age % 1250) / 1250;
        ctx.beginPath(); ctx.arc(L.x, L.y, L.r + 10 + k * 50, 0, TAU);
        ctx.strokeStyle = rgba('#ef4444', 0.6 * (1 - k)); ctx.lineWidth = 2 * px; ctx.stroke();
      }
      ctx.beginPath(); ctx.moveTo(x, y + 9); ctx.lineTo(x, y + 22); ctx.strokeStyle = '#ef4444'; ctx.lineWidth = 2 * Math.max(1, px * 0.7); ctx.stroke();
      ctx.beginPath(); polyPath(ctx, x, y, Math.max(10, 6 * px), 4, 0);
      ctx.fillStyle = '#7f1d1d'; ctx.fill(); ctx.strokeStyle = '#ef4444'; ctx.lineWidth = 1.6 * px; ctx.stroke();
      ctx.font = '800 ' + Math.round(Math.max(11, 7 * px)) + 'px ' + FONT; ctx.fillStyle = '#fecaca';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('!', x, y + 1);
    }
  }
}

const HP_BANDS = [[60, 1e9, '#22c55e'], [30, 60, '#f59e0b'], [-1e9, 30, '#ef4444']];
const ORDER_COLORS = { assign_task: '#fcd34d', use_tool: '#a78bfa', move: '#4ade80', recall: '#4ade80', migrate: '#c4b5fd' };

Object.assign(Renderer.prototype, {
  /** Unit radius in world units, with a screen-space minimum so the swarm stays visible when zoomed out. */
  unitRadius() { return Math.max(10, 4.4 / this.cam.zoom); },

  drawUnitLinks(now) {
    const { ctx, store, visual, layout, px, ui } = this;
    const beams = {}, fam = [], famHot = [], rally = [];
    for (const u of visual.units.values()) {
      if (!u.alive || u.orch) continue;
      const a = store.agents.get(u.id);
      if (!a) continue;
      if (a.toolId && a.state === 'working') {
        const T = layout.tools.get(a.toolId);
        if (T && (this.inView(u.x, u.y, 60) || this.inView(T.x, T.y, 60))) (beams[T.kind] = beams[T.kind] || []).push(u.x, u.y, T.x, T.y);
      }
      if (a.parentId) {
        const p = visual.units.get(a.parentId);
        if (p && p.alive) {
          const hot = ui.selection.has(u.id) || ui.selection.has(a.parentId);
          if (hot) famHot.push(u.x, u.y, p.x, p.y);
          else if (this.inView(u.x, u.y, 40) || this.inView(p.x, p.y, 40)) fam.push(u.x, u.y, p.x, p.y);
        }
      }
      if (u.path && ui.selection.has(u.id)) { const e = u.path[u.path.length - 1]; rally.push(u.x, u.y, e.x, e.y); }
    }
    const segs = (arr, style, w, dash, off) => {
      if (!arr.length) return;
      ctx.beginPath();
      for (let i = 0; i < arr.length; i += 4) { ctx.moveTo(arr[i], arr[i + 1]); ctx.lineTo(arr[i + 2], arr[i + 3]); }
      ctx.strokeStyle = style; ctx.lineWidth = w;
      if (dash) { ctx.setLineDash(dash); ctx.lineDashOffset = off || 0; }
      ctx.stroke();
      ctx.setLineDash([]);
    };
    segs(fam, 'rgba(56,189,248,0.11)', 1.1 * px);
    segs(famHot, 'rgba(56,189,248,0.5)', 1.4 * px, [4 * px, 4 * px]);
    for (const k in beams) segs(beams[k], rgba((TOOL_KINDS[k] || TOOL_KINDS.llm).color, 0.6), 1.7 * px, [6 * px, 5 * px], -now / 25);
    segs(rally, 'rgba(74,222,128,0.65)', 1.3 * px, [5 * px, 5 * px], -now / 40);
    for (let i = 0; i < rally.length; i += 4) { ctx.beginPath(); ctx.arc(rally[i + 2], rally[i + 3], 4 * px, 0, TAU); ctx.fillStyle = '#4ade80'; ctx.fill(); }
  },

  drawUnits(now) {
    const { ctx, store, visual, ui, px } = this;
    const R = this.unitRadius();
    const sel = ui.selection;
    const hov = ui.hover && ui.hover.kind === 'agent' ? ui.hover.id : null;
    const roles = {};
    for (const k of ROLE_KEYS) roles[k] = [];
    const rings = { idle: [], moving: [], working: [], error: [], paused: [], done: [] };
    const arcs = [], spin = [], hpb = [], selU = [], fading = [], hurt = [];
    for (const u of visual.units.values()) {
      if (u.orch) continue;
      if (!this.inView(u.x, u.y, R * 3)) { u.vis = false; continue; }
      const a = store.agents.get(u.id);
      if (!a) continue;
      u.vis = true;
      if (!u.alive) { fading.push(u); continue; }
      let x = u.x, y = u.y, r = R;
      const age = now - u.spawnT;
      if (age >= 0 && age < 350) r *= 0.3 + 0.7 * smoothstep(age / 350);
      const sh = now - u.hitT;
      if (sh >= 0 && sh < 450) {
        const k = 1 - sh / 450;
        x += Math.sin(sh * 0.12 + u.seed * 20) * 3.2 * px * k;
        y += Math.cos(sh * 0.15 + u.seed * 13) * 1.6 * px * k;
        hurt.push(u);
      }
      u.dx = x; u.dy = y; u.dr = r;
      (roles[a.role] || roles.coder).push(u);
      const st = rings[a.state] ? a.state : 'idle';
      rings[st].push(u);
      if (st === 'working') { if (a.expectedMs > 0) arcs.push(u, clamp((now - a.stateSince) / a.expectedMs, 0, 1)); else spin.push(u); }
      if (a.health < 100 || sel.has(u.id) || u.id === hov) hpb.push(u, a.health);
      if (sel.has(u.id)) selU.push(u);
    }
    const ringR = (u) => u.dr * 1.34 + 3 * px;
    if (selU.length) {
      ctx.beginPath();
      for (const u of selU) { const rr = ringR(u) + 5 * px; ctx.moveTo(u.dx + rr, u.dy); ctx.arc(u.dx, u.dy, rr, 0, TAU); }
      ctx.fillStyle = 'rgba(74,222,128,0.10)'; ctx.fill();
      ctx.strokeStyle = '#4ade80'; ctx.lineWidth = 1.8 * px; ctx.stroke();
    }
    const flash = rings.error.concat(hurt);
    if (flash.length) {
      ctx.globalCompositeOperation = 'lighter';
      ctx.globalAlpha = 0.5 + 0.25 * Math.sin(now / 70);
      const img = this.glow('#ef4444');
      for (const u of flash) { const s = u.dr * 3.4; ctx.drawImage(img, u.dx - s, u.dy - s, s * 2, s * 2); }
      ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
    }
    ctx.lineJoin = 'round';
    ctx.strokeStyle = 'rgba(2,5,9,0.92)'; ctx.lineWidth = 1.5 * px;
    for (const role of ROLE_KEYS) {
      const list = roles[role];
      if (!list.length) continue;
      ctx.beginPath();
      for (const u of list) rolePath(ctx, role, u.dx, u.dy, u.dr);
      ctx.fillStyle = ROLES[role].color; ctx.fill(); ctx.stroke();
    }
    if (flash.length && Math.floor(now / 110) % 2 === 0) {
      ctx.beginPath();
      for (const u of flash) rolePath(ctx, u.role, u.dx, u.dy, u.dr);
      ctx.fillStyle = 'rgba(239,68,68,0.78)'; ctx.fill();
    }
    ctx.lineWidth = 2.3 * px;
    for (const st in rings) {
      const list = rings[st];
      if (!list.length) continue;
      ctx.beginPath();
      for (const u of list) { const rr = ringR(u); ctx.moveTo(u.dx + rr, u.dy); ctx.arc(u.dx, u.dy, rr, 0, TAU); }
      ctx.strokeStyle = st === 'working' ? 'rgba(245,158,11,0.45)' : STATE_COLORS[st];
      if (st === 'paused') ctx.setLineDash([3 * px, 3 * px]);
      ctx.stroke();
      ctx.setLineDash([]);
    }
    if (arcs.length || spin.length) { // working: progress arc (or a spinner while coordinating sub-agents)
      ctx.beginPath();
      for (let i = 0; i < arcs.length; i += 2) {
        const u = arcs[i], rr = ringR(u), a0 = -Math.PI / 2;
        ctx.moveTo(u.dx, u.dy - rr); ctx.arc(u.dx, u.dy, rr, a0, a0 + TAU * Math.max(0.03, arcs[i + 1]));
      }
      for (const u of spin) {
        const rr = ringR(u), a0 = now / 240 + u.seed * TAU;
        ctx.moveTo(u.dx + Math.cos(a0) * rr, u.dy + Math.sin(a0) * rr); ctx.arc(u.dx, u.dy, rr, a0, a0 + 1.7);
      }
      ctx.strokeStyle = '#fcd34d'; ctx.lineWidth = 3 * px; ctx.lineCap = 'round'; ctx.stroke(); ctx.lineCap = 'butt';
    }
    if (hpb.length) {
      ctx.beginPath();
      for (let i = 0; i < hpb.length; i += 2) { const u = hpb[i], w = u.dr * 2.6; ctx.rect(u.dx - w / 2 - px, u.dy - ringR(u) - 8 * px, w + 2 * px, 4.5 * px); }
      ctx.fillStyle = 'rgba(0,0,0,0.85)'; ctx.fill();
      for (const [lo, hi, col] of HP_BANDS) {
        ctx.beginPath();
        let any = false;
        for (let i = 0; i < hpb.length; i += 2) {
          const h = hpb[i + 1];
          if (h < lo || h >= hi) continue;
          const u = hpb[i], w = u.dr * 2.6;
          ctx.rect(u.dx - w / 2, u.dy - ringR(u) - 7 * px, w * clamp(h / 100, 0, 1), 2.5 * px);
          any = true;
        }
        if (any) { ctx.fillStyle = col; ctx.fill(); }
      }
    }
    if (hov) {
      const u = visual.units.get(hov);
      if (u && u.vis && u.alive && !u.orch) { ctx.beginPath(); ctx.arc(u.dx, u.dy, ringR(u) + 6 * px, 0, TAU); ctx.strokeStyle = 'rgba(255,255,255,0.9)'; ctx.lineWidth = 1.4 * px; ctx.stroke(); }
    }
    for (const u of fading) {
      const k = clamp((now - u.endT) / 900, 0, 1), done = u.endKind === 'done';
      ctx.globalAlpha = 1 - k;
      ctx.beginPath(); rolePath(ctx, u.role, u.x, u.y - (done ? k * 22 : 0), R * (done ? 1 + 0.4 * k : 1 - 0.6 * k));
      ctx.fillStyle = done ? '#86efac' : '#52525b'; ctx.fill();
    }
    ctx.globalAlpha = 1;
  },

  /** Inter-agent messages: a glowing packet travelling along a faint line between the two units. */
  drawPulses(now) {
    const { ctx, visual, px } = this;
    if (!visual.pulses.length) return;
    const s = Math.max(20, 9 * px);
    const cores = [];
    ctx.lineWidth = 1.5 * px;
    for (const q of visual.pulses) {
      const A = visual.units.get(q.from), B = visual.units.get(q.to);
      if (!A || !B || now < q.t0) continue;
      if (!this.inView(A.x, A.y, 80) && !this.inView(B.x, B.y, 80)) continue;
      const k = clamp((now - q.t0) / q.dur, 0, 1), e = easeInOut(k);
      const col = PULSE_COLORS[q.kind] || PULSE_COLORS.info;
      ctx.beginPath(); ctx.moveTo(A.x, A.y); ctx.lineTo(B.x, B.y);
      ctx.strokeStyle = rgba(col, 0.2 * (1 - k * 0.6)); ctx.stroke();
      const x = lerp(A.x, B.x, e), y = lerp(A.y, B.y, e);
      ctx.globalCompositeOperation = 'lighter';
      ctx.drawImage(this.glow(col), x - s, y - s, s * 2, s * 2);
      ctx.globalCompositeOperation = 'source-over';
      cores.push(x, y);
    }
    ctx.beginPath();
    for (let i = 0; i < cores.length; i += 2) { ctx.moveTo(cores[i] + 2.6 * px, cores[i + 1]); ctx.arc(cores[i], cores[i + 1], 2.6 * px, 0, TAU); }
    ctx.fillStyle = '#fff'; ctx.fill();
  },

  drawEffects(now, layer) {
    const { ctx, visual, px } = this;
    const R = this.unitRadius();
    const ring = (x, y, r, col, a, w) => { if (a <= 0) return; ctx.beginPath(); ctx.arc(x, y, Math.max(0.1, r), 0, TAU); ctx.strokeStyle = rgba(col, a); ctx.lineWidth = w * px; ctx.stroke(); };
    const glow = (x, y, s, col, a) => { ctx.globalCompositeOperation = 'lighter'; ctx.globalAlpha = clamp(a, 0, 1); ctx.drawImage(this.glow(col), x - s, y - s, s * 2, s * 2); ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over'; };
    for (const f of visual.effects) {
      if (now < f.t0 || !this.inView(f.x, f.y, 260)) continue;
      const k = clamp((now - f.t0) / f.dur, 0, 1), out = 1 - (1 - k) * (1 - k);
      if (layer === 'under') {
        switch (f.kind) {
          case 'spawn': ring(f.x, f.y, R + 34 * out, f.color, 1 - k, 2.4); break;
          case 'ring': ring(f.x, f.y, R + (f.r || 50) * out, f.color, 1 - k, 3); glow(f.x, f.y, 50 * (1 - k) + 10, f.color, 0.6 * (1 - k)); break;
          case 'reveal': ring(f.x, f.y, 24 + 200 * out, '#38bdf8', 0.55 * (1 - k), 2); break;
          case 'taskdone': ring(f.x, f.y, f.r + 80 * out, '#22c55e', 1 - k, 3); glow(f.x, f.y, 70, '#22c55e', 0.5 * (1 - k)); break;
          case 'taskfail': ring(f.x, f.y, f.r + 80 * out, '#ef4444', 1 - k, 3); glow(f.x, f.y, 70, '#ef4444', 0.6 * (1 - k)); break;
          case 'beam':
            ctx.beginPath(); ctx.moveTo(f.x, f.y); ctx.lineTo(f.x2, f.y2);
            ctx.strokeStyle = rgba(f.color, 0.55 * (1 - k)); ctx.lineWidth = Math.max(5, 3 * px) * (1 - k * 0.6); ctx.stroke();
            break;
          case 'wreck': {
            const a = k < 0.75 ? 0.9 : 0.9 * (1 - (k - 0.75) / 0.25);
            ctx.globalAlpha = a;
            ctx.beginPath(); ctx.arc(f.x, f.y, R * 1.6, 0, TAU); ctx.fillStyle = 'rgba(20,10,10,0.7)'; ctx.fill();
            for (let i = 0; i < 6; i++) {
              const an = f.seed * 40 + i * 1.7, d = R * (0.4 + ((i * 37) % 10) / 10);
              ctx.fillStyle = i % 2 ? '#52525b' : '#7f1d1d';
              ctx.fillRect(f.x + Math.cos(an) * d - R * 0.22, f.y + Math.sin(an) * d - R * 0.22, R * 0.44, R * 0.44);
            }
            ctx.globalAlpha = 1;
            break;
          }
        }
      } else {
        switch (f.kind) {
          case 'done': ring(f.x, f.y, R + 26 * out, '#4ade80', 1 - k, 2.2); glow(f.x, f.y, 34, '#22c55e', 0.6 * (1 - k)); break;
          case 'hit': glow(f.x, f.y, R * 4, '#ef4444', 0.8 * (1 - k)); break;
          case 'zap': ring(f.x, f.y, R + 30 * out, '#ffffff', 1 - k, 3); glow(f.x, f.y, 50, '#e0f2fe', 0.9 * (1 - k)); break;
          case 'explode': {
            glow(f.x, f.y, 70 + 40 * k, '#fb923c', 0.9 * (1 - k));
            ctx.beginPath();
            for (let i = 0; i < 12; i++) {
              const an = f.seed * TAU + (i / 12) * TAU + (i % 3) * 0.2, d = R * 0.5 + 70 * out * (0.6 + (i % 4) * 0.15), s = (1 - k) * 4.5 * Math.max(1, px);
              ctx.rect(f.x + Math.cos(an) * d - s / 2, f.y + Math.sin(an) * d - s / 2, s, s);
            }
            ctx.fillStyle = rgba('#fdba74', 1 - k); ctx.fill();
            break;
          }
          case 'spark': {
            ctx.beginPath();
            for (let i = 0; i < 7; i++) {
              const an = f.seed * TAU + i * 0.9, d0 = 30 + 10 * out, d1 = d0 + 16 * (1 - k);
              ctx.moveTo(f.x + Math.cos(an) * d0, f.y + Math.sin(an) * d0); ctx.lineTo(f.x + Math.cos(an) * d1, f.y + Math.sin(an) * d1);
            }
            ctx.strokeStyle = rgba('#fde047', 1 - k); ctx.lineWidth = 2 * Math.max(1, px * 0.8); ctx.stroke();
            break;
          }
        }
      }
    }
  },

  /** Order feedback markers (UI-only, real time). */
  drawOrders(rt) {
    const { ctx, ui, px } = this;
    if (!ui.orders.length) return;
    ui.orders = ui.orders.filter((o) => rt - o.t0 < 650);
    for (const o of ui.orders) {
      const k = (rt - o.t0) / 650, r = (30 - 20 * k) * px;
      ctx.beginPath(); ctx.arc(o.x, o.y, r, 0, TAU);
      ctx.strokeStyle = rgba(o.color, 1 - k); ctx.lineWidth = 2 * px; ctx.stroke();
      ctx.beginPath();
      for (let i = 0; i < 4; i++) {
        const a = Math.PI / 4 + (i * Math.PI) / 2, d = r + 8 * px, w = 5 * px;
        const cx = o.x + Math.cos(a) * d, cy = o.y + Math.sin(a) * d;
        ctx.moveTo(cx + Math.cos(a + 2.4) * w, cy + Math.sin(a + 2.4) * w); ctx.lineTo(cx - Math.cos(a) * w * 0.4, cy - Math.sin(a) * w * 0.4); ctx.lineTo(cx + Math.cos(a - 2.4) * w, cy + Math.sin(a - 2.4) * w);
      }
      ctx.stroke();
    }
  },

  /** Text width with a cache (titles rarely change; measureText is not free). */
  tw(text) {
    const k = this.ctx.font + '|' + text;
    let w = this._tw.get(k);
    if (w === undefined) {
      if (this._tw.size > 4000) this._tw.clear();
      w = this.ctx.measureText(text).width;
      this._tw.set(k, w);
    }
    return w;
  },

  /**
   * Screen-space labels, placed greedily by priority and skipped when they would overlap one already
   * drawn — so zooming out thins labels instead of smearing them together.
   */
  drawLabels(now) {
    const { ctx, store, layout, visual, ui, W, H } = this;
    const z = this.cam.zoom;
    if (!this._tw) this._tw = new Map();
    const on = (p, m) => p.x > -m && p.x < W + m && p.y > -m && p.y < H + m;
    const placed = [];
    const free = (x, y, w, h) => {
      for (const r of placed) if (x < r[0] + r[2] && x + w > r[0] && y < r[1] + r[3] && y + h > r[1]) return false;
      placed.push([x, y, w, h]);
      return true;
    };
    const halo = (txt, x, y, fill) => { ctx.strokeText(txt, x, y); ctx.fillStyle = fill; ctx.fillText(txt, x, y); };
    const label = (txt, x, y, fill, size, force) => { // centred, baseline y; returns whether drawn
      const w = this.tw(txt);
      if (!free(x - w / 2 - 3, y - size, w + 6, size + 4) && !force) return false;
      halo(txt, x, y, fill);
      return true;
    };
    ctx.textAlign = 'center'; ctx.textBaseline = 'alphabetic';
    ctx.lineJoin = 'round'; ctx.strokeStyle = 'rgba(3,6,10,0.92)'; ctx.lineWidth = 3;
    const hubInfo = store.territories.get(layout.hub) || {};
    for (const T of layout.terr.values()) {
      const info = store.territories.get(T.id) || {};
      const p = this.toScreen(T.x, T.y - T.r);
      if (!on(p, 260)) continue;
      const bottom = this.toScreen(T.x, T.y + T.r).y;
      p.y = Math.min(Math.max(p.y, this.inset.t + 60), bottom - 40); // keep the title out from under the top bar
      const local = T.kind === 'local';
      const lat = local ? 0 : (hubInfo.latencyMs || {})[T.id];
      ctx.font = '800 14px ' + FONT;
      label((local ? '⌂ ' : '☁ ') + (info.name || T.id).toUpperCase(), p.x, p.y - 50, local ? '#5eead4' : '#c4b5fd', 14, true);
      ctx.font = '600 10.5px ' + FONT;
      label((local ? 'LOCAL · ' : 'CLOUD · ') + (info.region || '') + (lat ? ' · ' + lat + ' ms from HQ' : ''), p.x, p.y - 35, '#94a3b8', 11, true);
      ctx.font = '600 10.5px ' + MONO;
      const hot = info.cap && info.active / info.cap > 0.9;
      label((info.active || 0) + '/' + (info.cap || '?') + ' agents · ' + (local ? 'free compute' : fmtCost(info.costPerSec || 0, 4) + '/agent·s') + ' · ' + fmtCost(info.rate || 0, 3) + '/s',
        p.x, p.y - 21, hot ? '#fca5a5' : '#cbd5e1', 11, true);
    }
    const hub = layout.terr.get(layout.hub);
    const orch = store.agents.get(store.orchestratorId);
    if (hub && orch) {
      const p = this.toScreen(hub.x, hub.y + 64);
      if (on(p, 200)) {
        ctx.font = '800 11px ' + FONT; label('ORCHESTRATOR', p.x, p.y + 16, '#fcd34d', 11, true);
        if (z > 0.2) { ctx.font = '500 10.5px ' + MONO; const s = orch.step || ''; label(s.length > 54 ? s.slice(0, 53) + '…' : s, p.x, p.y + 30, '#e2e8f0', 11, true); }
      }
    }
    if (hub && z > 0.09) {
      ctx.font = '600 10.5px ' + MONO;
      for (const T of layout.terr.values()) {
        if (T === hub) continue;
        const a = layout.port(hub.id, T.id), b = layout.port(T.id, hub.id);
        const p = this.toScreen((a.x + b.x) / 2, (a.y + b.y) / 2);
        if (on(p, 60)) label('⇄ ' + ((hubInfo.latencyMs || {})[T.id] || '?') + ' ms', p.x, p.y - 8, '#7dd3fc', 11, true);
      }
    }
    const hov = ui.hover || {};
    // unit names: hovered + selected first (forced), everyone else only when zoomed right in
    const named = [];
    if (hov.kind === 'agent') { const u = visual.units.get(hov.id); if (u && u.vis && !u.orch) named.push([u, true]); }
    if (ui.selection.size <= 24 && (z >= 0.4 || ui.selection.size <= 3)) for (const id of ui.selection) { const u = visual.units.get(id); if (u && u.vis && !u.orch && id !== hov.id) named.push([u, ui.selection.size <= 3]); }
    ctx.font = '600 10px ' + MONO;
    const unitLabel = (u, force) => {
      const a = store.agents.get(u.id);
      const p = this.toScreen(u.dx, u.dy);
      if (!a || !on(p, 40)) return;
      label(a.name + (a.state === 'paused' ? ' ❚❚' : a.held && a.state === 'idle' ? ' ⚑' : ''), p.x, p.y - (u.dr * 1.34 * z + 15), ui.selection.has(u.id) ? '#bbf7d0' : '#e2e8f0', 10, force);
    };
    for (const [u, f] of named) unitLabel(u, f);
    // task titles by priority: hovered › active › pending › failed › locked › done
    const PRI = { active: 1, pending: 2, failed: 3, locked: 4, done: 5 };
    const cands = [];
    for (const t of store.tasks.values()) {
      const L = layout.tasks.get(t.id);
      if (!L) continue;
      const hot = hov.kind === 'task' && hov.id === t.id;
      if (!hot && (L.small ? z < 0.9 : z < 0.3)) continue;
      const p = this.toScreen(L.x, L.y + L.r);
      if (on(p, 160)) cands.push([hot ? 0 : PRI[t.status] + (L.small ? 0.5 : 0), t, L, p, hot]);
    }
    cands.sort((a, b) => a[0] - b[0]);
    let font = '';
    for (const [, t, L, p, hot] of cands) {
      const f = L.small ? '500 9.5px ' + FONT : '600 10.5px ' + FONT;
      if (f !== font) { ctx.font = f; font = f; }
      const max = hot ? 80 : L.small ? 24 : 32;
      const title = t.title.length > max ? t.title.slice(0, max - 1) + '…' : t.title;
      const col = { locked: '#64748b', pending: '#cbd5e1', active: '#fde68a', done: '#86efac', failed: '#fca5a5' }[t.status];
      label(title, p.x, p.y + (L.small ? 13 : 12 * z + Math.max(5 * z, 3.5) + 12), col, L.small ? 10 : 11, hot);
    }
    if (z >= 0.4) {
      ctx.font = '600 10px ' + FONT;
      for (const [id, P] of layout.tools) {
        const tool = store.tools.get(id);
        const p = this.toScreen(P.x, P.y + 31);
        if (tool && on(p, 80)) label(tool.name, p.x, p.y + 13, rgba((TOOL_KINDS[tool.kind] || TOOL_KINDS.llm).color, 0.9), 10, false);
      }
    }
    if (z >= 1.2) {
      ctx.font = '600 10px ' + MONO;
      for (const u of visual.units.values()) if (u.vis && u.alive && !u.orch && !ui.selection.has(u.id) && u.id !== hov.id) unitLabel(u, false);
    }
    if (z >= 0.3) {
      ctx.font = '12px ' + FONT;
      for (const u of visual.units.values()) {
        if (!u.vis || !u.alive || u.orch) continue;
        const a = store.agents.get(u.id);
        if (!a || !a.slow || !a.toolId) continue;
        const p = this.toScreen(u.dx, u.dy);
        ctx.fillText('⏳', p.x + u.dr * z + 8, p.y - u.dr * z - 2);
      }
    }
    ctx.font = '800 12px ' + FONT;
    for (const f of visual.effects) {
      if (f.kind !== 'hit' || now < f.t0) continue;
      const k = clamp((now - f.t0) / f.dur, 0, 1);
      const p = this.toScreen(f.x, f.y);
      if (!on(p, 40)) continue;
      ctx.globalAlpha = 1 - k;
      halo(f.text, p.x, p.y - 18 - k * 28, f.text === 'CRASH' ? '#f87171' : '#fca5a5');
    }
    ctx.globalAlpha = 1;
  },

  drawBox() {
    const b = this.ui.box;
    if (!b) return;
    const { ctx } = this;
    const x = Math.min(b.x0, b.x1), y = Math.min(b.y0, b.y1), w = Math.abs(b.x1 - b.x0), h = Math.abs(b.y1 - b.y0);
    ctx.fillStyle = 'rgba(74,222,128,0.08)'; ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = '#4ade80'; ctx.lineWidth = 1; ctx.setLineDash([4, 3]);
    ctx.strokeRect(x + 0.5, y + 0.5, w, h); ctx.setLineDash([]);
  },

  drawMinimap() {
    const m = this.mctx, dpr = this.dpr, w = this.mW, h = this.mH;
    const { store, layout, visual } = this;
    const b = layout.bounds, bw = b.maxX - b.minX, bh = b.maxY - b.minY;
    const s = Math.min(w / bw, h / bh);
    const ox = (w - bw * s) / 2 - b.minX * s, oy = (h - bh * s) / 2 - b.minY * s;
    this.mm = { s, ox, oy };
    const ip = 1 / s;
    m.setTransform(dpr, 0, 0, dpr, 0, 0);
    m.fillStyle = '#03070b'; m.fillRect(0, 0, w, h);
    m.setTransform(dpr * s, 0, 0, dpr * s, dpr * ox, dpr * oy);
    const hub = layout.terr.get(layout.hub);
    if (hub) {
      m.beginPath();
      for (const T of layout.terr.values()) { if (T === hub) continue; const a = layout.port(hub.id, T.id), c = layout.port(T.id, hub.id); m.moveTo(a.x, a.y); m.lineTo(c.x, c.y); }
      m.strokeStyle = 'rgba(125,211,252,0.3)'; m.lineWidth = 1.5 * ip; m.stroke();
    }
    for (const T of layout.terr.values()) {
      const local = T.kind === 'local';
      m.beginPath(); m.arc(T.x, T.y, T.r, 0, TAU);
      m.fillStyle = local ? 'rgba(45,212,191,0.14)' : 'rgba(167,139,250,0.12)'; m.fill();
      m.strokeStyle = local ? 'rgba(45,212,191,0.65)' : 'rgba(167,139,250,0.55)'; m.lineWidth = ip; m.stroke();
    }
    const byStatus = {};
    for (const t of store.tasks.values()) {
      const L = layout.tasks.get(t.id);
      if (L) (byStatus[t.status] = byStatus[t.status] || []).push(L);
    }
    for (const st in byStatus) {
      m.beginPath();
      for (const L of byStatus[st]) { const q = (L.small ? 1.6 : 2.6) * ip; m.rect(L.x - q, L.y - q, q * 2, q * 2); }
      m.fillStyle = TASK_COLORS[st]; m.fill();
    }
    if (this.ui.fog && this.fogBuilt) {
      const B = this.fogBuilt;
      m.drawImage(this.fog, B.minX, B.minY, this.fog.width / this.fogS, this.fog.height / this.fogS);
    }
    const dots = {};
    for (const u of visual.units.values()) {
      if (!u.alive || u.orch) continue;
      const a = store.agents.get(u.id);
      const key = a && a.state === 'error' ? 'err' : u.role;
      (dots[key] = dots[key] || []).push(u);
    }
    const q = 1.3 * ip;
    for (const k in dots) {
      m.beginPath();
      for (const u of dots[k]) m.rect(u.x - q, u.y - q, q * 2, q * 2);
      m.fillStyle = k === 'err' ? '#ef4444' : ROLES[k].color; m.fill();
    }
    if (hub) { m.fillStyle = '#fcd34d'; m.fillRect(hub.x - 4 * ip, hub.y - 4 * ip, 8 * ip, 8 * ip); }
    m.fillStyle = '#ef4444';
    for (const mk of store.markers) { const L = layout.tasks.get(mk.taskId); if (L) m.fillRect(L.x - 3 * ip, L.y - 3 * ip, 6 * ip, 6 * ip); }
    const v = this.view;
    m.strokeStyle = 'rgba(255,255,255,0.85)'; m.lineWidth = 1.2 * ip;
    m.strokeRect(v.minX, v.minY, v.maxX - v.minX, v.maxY - v.minY);
  },
  miniToWorld(mx, my) { const mm = this.mm; return mm ? { x: (mx - mm.ox) / mm.s, y: (my - mm.oy) / mm.s } : { x: 0, y: 0 }; },

  /** What is under a screen point? Units first, then structures, tasks, markers, territory. */
  pickAt(sx, sy) {
    const w = this.toWorld(sx, sy), px = this.px, R = this.unitRadius();
    const { visual, layout, store } = this;
    let best = null, bd = R * 1.45 + 5 * px;
    for (const u of visual.units.values()) {
      if (!u.alive || u.orch) continue;
      const d = dist(w.x, w.y, u.x, u.y);
      if (d < bd) { bd = d; best = u.id; }
    }
    if (best) return { kind: 'agent', id: best };
    const hub = layout.terr.get(layout.hub);
    if (hub && store.orchestratorId && dist(w.x, w.y, hub.x, hub.y) < 60) return { kind: 'agent', id: store.orchestratorId };
    for (const [id, P] of layout.tools) if (dist(w.x, w.y, P.x, P.y) < 33 + 3 * px) return { kind: 'tool', id };
    for (const mk of store.markers) {
      const L = layout.tasks.get(mk.taskId);
      if (L && dist(w.x, w.y, L.x + L.r * 0.9, L.y - L.r - 18) < 12 + 4 * px) return { kind: 'marker', id: mk.taskId };
    }
    for (const [id, P] of layout.tasks) if (dist(w.x, w.y, P.x, P.y) < P.r + 7 + 4 * px) return { kind: 'task', id };
    for (const T of layout.terr.values()) if (T.id !== layout.hub && dist(w.x, w.y, T.x, T.y) < 50) return { kind: 'gateway', id: T.id };
    const t = layout.territoryAt(w.x, w.y);
    return t ? { kind: 'territory', id: t } : null;
  },
  unitsInBox(x0, y0, x1, y1) {
    const a = this.toWorld(Math.min(x0, x1), Math.min(y0, y1)), b = this.toWorld(Math.max(x0, x1), Math.max(y0, y1));
    const out = [];
    for (const u of this.visual.units.values()) if (u.alive && !u.orch && u.x >= a.x && u.x <= b.x && u.y >= a.y && u.y <= b.y) out.push(u.id);
    return out;
  },
});

/* =====================================================================================
 *  SECTION 6 · HUD — DOM panels. Reads the Store + UI state; sends intents to the App.
 * ===================================================================================== */
const $ = (id) => document.getElementById(id);
const COMMANDS = [
  { id: 'assign', icon: '◎', label: 'Assign Task', key: 'T', tip: 'Pick a task on the map for the selected agents (or right-click a task)' },
  { id: 'recall', icon: '↩', label: 'Recall', key: 'R', tip: 'Return to base — HQ, or the region gateway — and hold position' },
  { id: 'pause', icon: '❚❚', label: 'Pause', key: 'P', tip: 'Freeze / unfreeze the selected agents' },
  { id: 'duplicate', icon: '⊕', label: 'Duplicate', key: 'C', tip: 'Spawn a clone with the same role, region and task' },
  { id: 'migrate', icon: '⇄', label: 'Migrate', key: 'M', tip: 'Move agents between Local and a Cloud region (cost vs capacity)' },
  { id: 'terminate', icon: '✕', label: 'Terminate', key: 'X', tip: 'Kill the selected agents — their task is re-queued', danger: true },
  { id: 'tool', icon: '⚙', label: 'Use Tool', key: 'U', tip: 'Send agents to call a specific tool (or right-click a structure)' },
  { id: 'move', icon: '➜', label: 'Move', key: 'V', tip: 'Move to a point and hold position (or right-click the ground)' },
  { id: 'focus', icon: '◉', label: 'Focus', key: 'Z', tip: 'Center the camera on the selection' },
];
const STATE_LABEL = { idle: 'idle', moving: 'moving', working: 'working', error: 'error', paused: 'paused', done: 'done', dead: 'terminated' };

class HUD {
  constructor(app) {
    this.app = app;
    this.store = app.store;
    this.ui = app.ui;
    this.el = {
      tps: $('r-tps'), tokens: $('r-tokens'), cost: $('r-cost'), budget: $('r-budget'), agents: $('r-agents'), tasks: $('r-tasks'), time: $('r-time'),
      speed: $('speed'), fps: $('fps'), mission: $('mission-title'), sel: $('selection'), cmds: $('commands'), feed: $('feed'), feedList: $('feed-list'),
      feedCount: $('feed-count'), tooltip: $('tooltip'), toast: $('toast'), hint: $('hint'), replay: $('replay-bar'), scrub: $('rp-scrub'),
      rpTime: $('rp-time'), rpPlay: $('rp-play'), help: $('help'), legend: $('legend'), srcTag: $('src-tag'), cancel: $('btn-cancel'),
    };
    this.spark = this.el.tps.querySelector('canvas');
    this.feedCats = new Set(['agent', 'task', 'tool', 'msg', 'error']);
    this.feedText = '';
    this.feedSelectedOnly = false;
    this.feedSeen = 0;
    this.selKey = null;
    this.cmdKey = null;
    this.next = { top: 0, sel: 0, feed: 0, tip: 0 };
    this.buildLegend();
    this.buildHelp();
    this.bindTopbar();
    this.bindCommands();
    this.bindFeed();
    this.bindReplayBar();
    this.store.onReset(() => { this.feedSeen = 0; this.el.feedList.innerHTML = ''; this.selKey = null; this.cmdKey = null; });
  }

  update(now, rt) {
    const n = this.next;
    if (rt >= n.top) { n.top = rt + 100; this.updateTop(now); }
    if (rt >= n.sel) { n.sel = rt + 120; this.updateSelection(now); this.renderCommands(); }
    if (rt >= n.feed) { n.feed = rt + 150; this.updateFeed(); }
    if (rt >= n.tip) { n.tip = rt + 250; this.app.input.refreshTooltip(); }
    this.updateReplay();
  }
  selectionChanged() { this.next.sel = 0; this.cmdKey = null; }
  setFps(fps, units) { this.el.fps.textContent = fps + ' fps · ' + units + ' units'; }

  /* ---------- top bar ---------- */
  bindTopbar() {
    this.el.speed.addEventListener('click', (e) => {
      const b = e.target.closest('button');
      if (!b) return;
      const v = +b.dataset.speed;
      if (v === 0) this.app.togglePause(); else this.app.setSpeed(v);
    });
    $('btn-replay').onclick = () => (this.app.mode === 'replay' ? this.app.exitReplay() : this.app.enterReplay(false));
    $('btn-help').onclick = () => this.toggleHelp();
    $('btn-menu').onclick = () => this.app.showMenu();
    this.el.cancel.onclick = () => this.app.cancelCrew();
  }
  updateTop(now) {
    const s = this.store, r = s.resources, el = this.el;
    el.tps.querySelector('.v').textContent = fmtTokens(r.tokensPerSec || 0);
    this.drawSpark();
    // A live crew's tokens are an estimate until agnostic reports what it metered (≈), and its
    // cost is n/a until the gateway reports one — never a simulated number.
    const live = !!(s.mission && s.mission.kind === 'live');
    el.tokens.querySelector('.v').textContent = (live && r.estimated ? '≈ ' : '') + fmtTokens(r.tokens || 0);
    el.cost.querySelector('.v').textContent = live && !r.costKnown ? 'n/a' : fmtCost(r.cost);
    el.cost.querySelector('small').textContent = live ? (r.costKnown ? 'reported by agnostic' : 'not reported') : '+' + fmtCost(r.costPerSec, 3) + '/s';
    const left = Math.max(0, (r.budget || 0) - (r.cost || 0)), frac = r.budget ? left / r.budget : 1;
    el.budget.querySelector('i').style.width = (frac * 100).toFixed(1) + '%';
    el.budget.querySelector('.v2').textContent = r.budget ? fmtCost(left) + ' of ' + fmtCost(r.budget, 0) : '—';
    el.budget.classList.toggle('low', frac < 0.25);
    el.budget.classList.toggle('none', !r.budget);
    let la = 0, lc = 0, ca = 0, cc = 0;
    for (const t of s.territories.values()) {
      if (t.kind === 'local') { la += t.active || 0; lc += t.cap || 0; } else { ca += t.active || 0; cc += t.cap || 0; }
    }
    el.agents.querySelector('.v').textContent = (r.active || 0) + ' / ' + (r.cap || lc + cc);
    el.agents.querySelector('.l').textContent = 'L ' + la + '/' + lc;
    el.agents.querySelector('.c').textContent = 'C ' + ca + '/' + cc;
    el.tasks.querySelector('.v').textContent = s.stats.tasksDone + ' / ' + s.stats.tasksTotal;
    el.tasks.querySelector('small').textContent = s.stats.tasksFailed + ' failed · ' + s.stats.retries + ' retries';
    const end = s.mission.status === 'complete' ? s.mission.endedAt : now;
    el.time.querySelector('.v').textContent = s.mission.status === 'idle' ? '00:00' : fmtTime(end - (s.mission.startedAt || 0));
    el.mission.textContent = s.mission.title || '';
    // Every mission says what it is: a simulation, a real crew, or a replay of either.
    const tag = this.app.mode === 'replay' ? 'replay' : live ? 'live' : 'sim';
    el.srcTag.className = 'src-tag ' + tag;
    el.srcTag.textContent = tag === 'replay' ? (live ? 'REPLAY · LIVE' : 'REPLAY · SIM') : live ? 'LIVE' : 'SIM';
    el.srcTag.title = tag === 'replay' ? 'A replay of the recorded event log' : live ? 'A real crew on this agnostic server' : 'Simulated — no agent ran';
    // The label says what the number is: a simulator's estimate, or what agnostic reported.
    el.cost.querySelector('label').textContent = live ? 'COST' : 'EST. COST';
    el.cost.title = live
      ? (r.costKnown ? 'The cost the LLM gateway reported for this crew\\'s calls, through agnostic' : 'No cost reported yet — the gateway prices each call, and agnostic reports it when the crew ends')
      : 'Estimated spend: model tokens + per-second compute';
    const lsrc = this.app.live && this.app.live.source;
    el.cancel.classList.toggle('hidden', !(this.app.mode === 'live' && lsrc instanceof LiveCrewSource && !lsrc.finished && lsrc.crewId));
    const src = this.app.source;
    el.speed.classList.toggle('disabled', !src || !src.capabilities.speed || this.app.mode === 'menu');
    for (const b of el.speed.querySelectorAll('button')) {
      const v = +b.dataset.speed;
      b.classList.toggle('on', !!src && (v === 0 ? src.paused : !src.paused && src.speed === v));
    }
  }
  drawSpark() {
    const c = this.spark, g = c.getContext('2d'), h = this.store.tpsHistory.slice(-60);
    g.clearRect(0, 0, c.width, c.height);
    if (h.length < 2) return;
    const max = Math.max(1, ...h), W = c.width, H = c.height;
    g.beginPath();
    h.forEach((v, i) => { const x = (i / (h.length - 1)) * W, y = H - 3 - (v / max) * (H - 6); if (i) g.lineTo(x, y); else g.moveTo(x, y); });
    g.strokeStyle = '#39d0ff'; g.lineWidth = 2.5; g.stroke();
    g.lineTo(W, H); g.lineTo(0, H); g.closePath();
    g.fillStyle = 'rgba(57,208,255,0.15)'; g.fill();
  }

  /* ---------- legend / help ---------- */
  buildLegend() {
    const body = $('legend-body');
    let html = '';
    for (const k of ['orchestrator', ...ROLE_KEYS]) html += '<div class=\"row\"><canvas data-role=\"' + k + '\"></canvas>' + ROLES[k].label + (k === 'orchestrator' ? ' (HQ)' : '') + '</div>';
    html += '<div class=\"sep\"></div>';
    for (const [st, label] of [['idle', 'Idle'], ['moving', 'Moving'], ['working', 'Working · progress arc'], ['error', 'Error / damaged'], ['done', 'Done'], ['paused', 'Paused']]) {
      html += '<div class=\"row\"><span class=\"ring\" style=\"border-color:' + STATE_COLORS[st] + (st === 'paused' ? ';border-style:dashed' : '') + '\"></span>' + label + '</div>';
    }
    html += '<div class=\"sep\"></div>';
    html += '<div class=\"row\"><span class=\"terr\" style=\"background:rgba(45,212,191,.22);border:1.5px solid #2dd4bf\"></span>Local — free, small cap</div>';
    html += '<div class=\"row\"><span class=\"terr\" style=\"background:rgba(167,139,250,.2);border:1.5px dashed #a78bfa\"></span>Cloud — big cap, costs $/s</div>';
    html += '<div class=\"row\"><span class=\"ring\" style=\"border-color:#94a3b8;border-style:dashed\"></span>Locked task (in fog)</div>';
    html += '<div class=\"row\"><span class=\"ring\" style=\"border-color:#38bdf8;background:#38bdf8;transform:scale(.6)\"></span>Message pulse</div>';
    html += '<div class=\"row\"><span class=\"ring\" style=\"border-color:#ef4444;background:#7f1d1d;border-radius:2px;transform:rotate(45deg) scale(.8)\"></span>Hard failure marker</div>';
    body.innerHTML = html;
    for (const c of body.querySelectorAll('canvas')) drawRoleIcon(c, c.dataset.role, null);
    const lg = this.el.legend, tg = $('legend-toggle');
    const set = (collapsed) => { lg.classList.toggle('collapsed', collapsed); tg.textContent = collapsed ? '+' : '–'; };
    try { set(localStorage.getItem('swarm.legend') === 'collapsed'); } catch { /* storage unavailable */ }
    lg.querySelector('h4').onclick = () => {
      const c = !lg.classList.contains('collapsed');
      set(c);
      try { localStorage.setItem('swarm.legend', c ? 'collapsed' : 'open'); } catch { /* ignore */ }
    };
  }
  buildHelp() {
    const rows = [
      ['Select', 'Click · drag a box · Shift adds'], ['Select a whole role', 'Double-click a unit'], ['Inspect', 'Click a task, structure or region'],
      ['Order', 'Right-click task / structure / ground'], ['Pan', 'WASD / arrows · edge-scroll · right-, middle- or Alt-drag'], ['Zoom', 'Mouse wheel / pinch'],
      ['Control groups', 'Ctrl+1–9 (or Alt) set · 1–9 recall · twice = jump'], ['Pause simulation', 'Space'], ['Sim speed', '− / +  or  1× 2× 4×'],
      ['Commands', 'T R P C M X U V Z (see card)'], ['Camera', 'H HQ · F fit map · minimap click/drag'], ['Fog of war', 'G toggles'], ['Cancel / deselect', 'Esc'],
    ];
    this.el.help.innerHTML = '<div class=\"panel-title\">CONTROLS<span style=\"flex:1\"></span><span id=\"help-x\" style=\"cursor:pointer\">✕</span></div>'
      + rows.map(([a, b]) => '<div class=\"row\"><span>' + a + '</span><span>' + b + '</span></div>').join('');
    $('help-x').onclick = () => this.toggleHelp(false);
  }
  toggleHelp(force) { const h = this.el.help; h.classList.toggle('hidden', force === undefined ? !h.classList.contains('hidden') : !force); }

  /* ---------- command card ---------- */
  bindCommands() {
    this.el.cmds.addEventListener('click', (e) => {
      const b = e.target.closest('button.cmd');
      if (b && !b.disabled) this.app.command(b.dataset.cmd);
    });
  }
  renderCommands() {
    const ui = this.ui, app = this.app, s = this.store;
    const ids = app.controllable();
    const live = app.mode === 'live' && s.mission.status !== 'complete';
    const enabled = live && app.canCommand() && ids.length > 0;
    const why = app.mode === 'replay' ? 'Replay is read-only' : !live ? 'Mission is not running' : !app.canCommand() ? 'A live crew takes no unit orders' : 'Select agents first';
    let key, html = '';
    if (ui.migrateMenu && enabled) {
      const here = new Set(ids.map((id) => s.agents.get(id).territory));
      const terrs = [...s.territories.values()];
      key = 'mig|' + [...here].join(',') + '|' + terrs.map((t) => t.active + '/' + t.cap).join(',');
      if (key === this.cmdKey) return;
      for (const t of terrs) {
        const full = t.active >= t.cap, only = here.size === 1 && here.has(t.id);
        html += '<button class=\"cmd\" data-cmd=\"migrate:' + t.id + '\"' + (full || only ? ' disabled' : '') + ' title=\"' + escapeHtml(t.name + ' · ' + (t.kind === 'local' ? 'your machine — no compute charge' : t.region + ' · ' + fmtCost(t.costPerSec, 4) + ' per agent-second')) + '\">'
          + '<span class=\"ic\" style=\"color:' + (t.kind === 'local' ? 'var(--local)' : 'var(--cloud)') + '\">' + (t.kind === 'local' ? '⌂' : '☁') + '</span>'
          + '<span class=\"lb\">' + escapeHtml(t.name) + '</span><span class=\"lb mono\" style=\"font-size:9px\">' + t.active + '/' + t.cap + (t.kind === 'local' ? ' · free' : ' · ' + (t.costPerSec * 100).toFixed(2) + '¢/s') + '</span></button>';
      }
      html += '<button class=\"cmd\" data-cmd=\"migrate:auto\" title=\"Local ⇄ nearest cloud region with free capacity\"><span class=\"ic\">⇄</span><span class=\"lb\">Auto</span></button>';
      html += '<button class=\"cmd\" data-cmd=\"back\" title=\"Back (Esc)\"><span class=\"ic\">‹</span><span class=\"lb\">Back</span><kbd>Esc</kbd></button>';
    } else {
      const allPaused = ids.length > 0 && ids.every((id) => s.agents.get(id).state === 'paused');
      const tgt = ui.targeting ? ui.targeting.type : '';
      key = [enabled, allPaused, tgt, why].join('|');
      if (key === this.cmdKey) return;
      for (const c of COMMANDS) {
        let icon = c.icon, label = c.label;
        if (c.id === 'pause' && allPaused) { icon = '▶'; label = 'Resume'; }
        const on = (c.id === 'assign' && tgt === 'assign_task') || (c.id === 'tool' && tgt === 'use_tool') || (c.id === 'move' && tgt === 'move');
        const dis = c.id === 'focus' ? !(ui.selection.size || ui.inspect) : !enabled;
        html += '<button class=\"cmd' + (c.danger ? ' danger' : '') + (on ? ' active' : '') + '\" data-cmd=\"' + c.id + '\"' + (dis ? ' disabled' : '')
          + ' title=\"' + escapeHtml(c.tip + ' [' + c.key + ']' + (dis && c.id !== 'focus' ? ' — ' + why : '')) + '\"><kbd>' + c.key + '</kbd><span class=\"ic\">' + icon + '</span><span class=\"lb\">' + label + '</span></button>';
      }
    }
    this.cmdKey = key;
    this.el.cmds.innerHTML = html;
  }

  /* ---------- tooltip / toast / hint ---------- */
  showTooltip(target, x, y) {
    const html = target ? this.tooltipHtml(target) : '';
    const t = this.el.tooltip;
    if (!html) { t.classList.add('hidden'); return; }
    if (t._html !== html) { t.innerHTML = html; t._html = html; }
    t.classList.remove('hidden');
    const w = t.offsetWidth, h = t.offsetHeight;
    let left = x + 16, top = y + 18;
    if (left + w > innerWidth - 8) left = x - w - 12;
    if (top + h > innerHeight - 8) top = y - h - 12;
    t.style.left = Math.max(4, left) + 'px';
    t.style.top = Math.max(4, top) + 'px';
  }
  hideTooltip() { this.el.tooltip.classList.add('hidden'); }
  tooltipHtml(tg) {
    const s = this.store;
    const row = (k, v) => '<div class=\"tt-row\">' + k + ' <b>' + escapeHtml(v) + '</b></div>';
    const title = (color, text) => '<div class=\"tt-title\"><span style=\"color:' + color + '\">●</span>' + escapeHtml(text) + '</div>';
    switch (tg.kind) {
      case 'agent': {
        const a = s.agents.get(tg.id);
        if (!a) return '';
        if (a.role === 'orchestrator') {
          return title(ROLES.orchestrator.color, 'HQ · Orchestrator') + row('Mission', s.mission.objective || s.mission.title) + row('Doing', a.step || '—')
            + row('Agents spawned', s.stats.agentsSpawned) + row('Model', a.model) + '<div class=\"tt-row\">Click to inspect · right-click to rally selected units here</div>';
        }
        const R = ROLES[a.role] || ROLES.coder, task = a.taskId && s.tasks.get(a.taskId);
        return title(R.color, a.name) + row('Role', R.label + ' · ' + a.model) + row('Territory', a.territory)
          + row('State', STATE_LABEL[a.state] + (a.held && a.state === 'idle' ? ' (holding)' : '')) + row('Step', a.step || '—')
          + (task ? row('Task', task.title) : '') + row('Tokens', fmtTokens(a.tokens) + ' · ' + fmtCost(a.cost, 3)) + row('Health', Math.round(a.health) + '%');
      }
      case 'marker':
      case 'task': {
        const t = s.tasks.get(tg.id);
        if (!t) return '';
        const deps = t.deps.map((d) => s.tasks.get(d)).filter(Boolean), done = deps.filter((d) => d.status === 'done' || d.status === 'failed').length;
        const kids = t.children.map((c) => s.tasks.get(c)).filter(Boolean), kd = kids.filter((k) => k.status === 'done').length;
        const who = [...t.assignees].map((id) => s.agentName(id));
        return title(TASK_COLORS[t.status], t.title) + row('Status', t.status + (t.status === 'locked' ? ' — waiting on dependencies (fog)' : ''))
          + row('Progress', fmtPct(t.progress)) + row('Needs', (ROLES[t.role] || ROLES.coder).label + ' · ' + t.territory)
          + (deps.length ? row('Dependencies', done + '/' + deps.length + ' resolved') : '') + (kids.length ? row('Sub-tasks', kd + '/' + kids.length + ' done') : '')
          + (who.length ? row('Assigned', who.slice(0, 4).join(', ') + (who.length > 4 ? ' +' + (who.length - 4) : '')) : '')
          + (t.attempts ? row('Retries', t.attempts) : '') + (t.result ? row(t.status === 'failed' ? 'Failure' : 'Result', t.result) : '')
          + (t.status !== 'done' && t.status !== 'failed' ? '<div class=\"tt-row\">Right-click with agents selected to assign</div>' : '');
      }
      case 'tool': {
        const t = s.tools.get(tg.id);
        if (!t) return '';
        const K = TOOL_KINDS[t.kind] || TOOL_KINDS.llm;
        return title(K.color, t.name) + row('Type', K.label) + row('Territory', t.territory) + row('In use', t.active.size + ' agents')
          + row('Calls', t.calls + ' · ' + t.errors + ' errors · ' + t.slow + ' slow') + '<div class=\"tt-row\">Right-click with agents selected to call this tool</div>';
      }
      case 'gateway':
      case 'territory': {
        const t = s.territories.get(tg.id);
        if (!t) return '';
        const hub = [...s.territories.values()].find((x) => x.kind === 'local');
        const lat = hub && hub !== t ? (hub.latencyMs || {})[t.id] : 0;
        return title(t.kind === 'local' ? '#2dd4bf' : '#a78bfa', t.name + ' · ' + (t.kind === 'local' ? 'LOCAL' : 'CLOUD'))
          + row('Region', t.region || '—') + row('Agents', (t.active || 0) + ' / ' + t.cap) + row('Compute', t.kind === 'local' ? 'free (your machine)' : fmtCost(t.costPerSec, 4) + ' per agent-second')
          + (lat ? row('Latency to HQ', lat + ' ms') : '') + row('Spend', fmtCost(t.cost, 2) + ' · now ' + fmtCost(t.rate, 3) + '/s') + row('Tokens', fmtTokens(t.tokens))
          + (tg.kind === 'gateway' ? '<div class=\"tt-row\">Right-click with agents selected to migrate here</div>' : '');
      }
    }
    return '';
  }
  toast(msg, kind) {
    const d = document.createElement('div');
    d.className = kind || '';
    d.textContent = msg;
    this.el.toast.appendChild(d);
    while (this.el.toast.children.length > 4) this.el.toast.firstChild.remove();
    setTimeout(() => d.remove(), 2700);
  }
  setHint(text) { const h = this.el.hint; h.classList.toggle('hidden', !text); if (text) h.textContent = text; }

  /* ---------- start / summary screens ---------- */
  showStart(v) {
    $('start-screen').classList.toggle('hidden', !v);
    if (v) this.app.launcher.render();
  }
  showSummary(sum) {
    const box = $('summary-screen');
    if (!sum) { box.classList.add('hidden'); return; }
    const m = this.store.mission;
    const stat = (label, v, sub) => '<div class=\"stat\"><label>' + label + '</label><div class=\"v\">' + v + '</div><small>' + sub + '</small></div>';
    if (m.kind === 'live') { this.showLiveSummary(sum, m, stat, box); return; }
    const run = this.app.live || {};
    const saved = !!(run.spec && this.app.library.get(run.spec.id));
    const split = (label, l, c, fmt) => {
      const t = l + c || 1;
      return '<div class=\"split-row\"><span>' + label + '</span><div class=\"bar\" style=\"display:flex\"><i style=\"width:' + ((l / t) * 100).toFixed(1) + '%;background:#2dd4bf\"></i><i style=\"width:'
        + ((c / t) * 100).toFixed(1) + '%;background:#a78bfa\"></i></div><span><b style=\"color:#5eead4\">L</b> ' + fmt(l) + ' · <b style=\"color:#c4b5fd\">C</b> ' + fmt(c) + '</span></div>';
    };
    const secs = Math.max(1, sum.durationMs / 1000);
    const roles = ROLE_KEYS.filter((k) => sum.roleCounts[k]).map((k) => '<span style=\"color:' + ROLES[k].color + '\">' + ROLES[k].label + ' ' + sum.roleCounts[k] + '</span>').join(' · ');
    $('summary-inner').innerHTML = '<div class=\"ov-title\">MISSION <b>COMPLETE</b></div>'
      + '<div class=\"ov-sub\"><span class=\"src-tag sim\">SIMULATED</span>' + escapeHtml(m.title) + ' — ' + escapeHtml(m.objective) + (m.seed ? ' · seed ' + m.seed : '') + '</div>'
      + '<div class=\"sum-grid\">'
      + stat('DURATION', fmtTime(sum.durationMs), 'simulated time')
      + stat('TOKENS', fmtTokens(sum.tokens), fmtTokens(sum.tokens / secs) + '/s average')
      + stat('COST', fmtCost(sum.cost), (sum.budget ? fmtPct(sum.cost / sum.budget) + ' of ' + fmtCost(sum.budget, 0) + ' budget' : '') + ' · ' + fmtCost(sum.cost / Math.max(1, sum.tasksDone), 3) + '/task')
      + stat('SUCCESS RATE', fmtPct(sum.successRate), sum.tasksDone + '/' + sum.tasksTotal + ' tasks · ' + sum.tasksFailed + ' failed')
      + stat('AGENTS USED', sum.agentsUsed, 'peak ' + sum.peakActive + ' concurrent')
      + stat('ERRORS', sum.errors, sum.crashes + ' crashes · ' + sum.retries + ' retries')
      + stat('TOOL CALLS', sum.toolCalls, sum.slowCalls + ' slow cloud calls')
      + stat('MESSAGES', sum.messages, sum.migrations + ' migrations')
      + '</div><div class=\"split-box\"><div class=\"panel-title\">LOCAL VS CLOUD</div>'
      + split('Agents', sum.localAgents, sum.cloudAgents, String) + split('Tokens', sum.localTok, sum.cloudTok, fmtTokens) + split('Cost', sum.localCost, sum.cloudCost, (x) => fmtCost(x))
      + '<div class=\"split-row\" style=\"grid-template-columns:90px 1fr\"><span>Roles</span><span>' + roles + '</span></div></div>'
      + '<div class=\"sum-actions\"><button class=\"primary\" data-act=\"replay\">⟲ Watch replay</button><button data-act=\"again\" title=\"Same swarm, same seed\">↻ Run again</button>'
      + '<button data-act=\"reseed\" title=\"Same swarm, a new seed\">⚄ New seed</button>'
      + (run.spec ? (saved ? '<button data-act=\"edit\">✎ Edit swarm</button>' : '<button data-act=\"save\">＋ Save as swarm</button>') : '')
      + '<button data-act=\"menu\">☰ Swarms</button><button data-act=\"export\">⤓ Export log</button><button data-act=\"close\">Close</button></div>';
    this.bindSummary(box);
    box.classList.remove('hidden');
  }
  bindSummary(box) {
    box.onclick = (e) => {
      const b = e.target.closest('button[data-act]');
      if (!b) return;
      const act = b.dataset.act;
      if (act === 'results') this.showResults(this.store.mission);
      else if (act === 'replay') this.app.enterReplay(true);
      else if (act === 'again') this.app.runAgain(false);
      else if (act === 'reseed') this.app.runAgain(true);
      else if (act === 'edit' || act === 'save') this.app.editRunSpec();
      else if (act === 'menu') this.app.showMenu();
      else if (act === 'export') this.app.exportLog();
      else box.classList.add('hidden');
    };
  }
  /**
   * A real crew's summary: what agnostic reported, with nothing simulated mixed in. Tokens and cost
   * are the engine's own metering once the crew has ended; a cost the gateway did not report is n/a,
   * and a token count nothing metered is marked as the estimate it is.
   */
  showLiveSummary(sum, m, stat, box) {
    const ls = m.summary || {};
    const run = this.app.live || {};
    const spec = run.spec && (this.app.library.get(run.spec.id) || run.spec);
    const est = run.saved && spec && spec.estimate;
    const status = String(ls.status || 'finished');
    const good = status === 'completed';
    const head = { completed: 'CREW <b>COMPLETED</b>', failed: 'CREW <b>FAILED</b>', cancelled: 'CREW <b>CANCELLED</b>', refused: 'CREW <b>REFUSED</b>', lost: 'CREW <b>LOST</b>',
      unconfirmed: 'CREW <b>UNCONFIRMED</b>' }[status] || 'CREW <b>' + escapeHtml(status.toUpperCase()) + '</b>';
    const total = (ls.tasksDone || 0) + (ls.tasksFailed || 0);
    const tok = ls.tokensActual
      ? stat('TOKENS', fmtTokens(ls.tokens || 0), 'metered by agnostic for ' + (ls.meteredTasks || 0) + ' of ' + total + ' tasks')
      : stat('TOKENS', '≈ ' + fmtTokens(ls.tokens || 0), ls.engineMode === 'placeholder' ? 'estimated — the placeholder engine meters nothing' : 'estimated from output length — nothing was metered');
    const cost = ls.costMicro != null
      ? stat('COST', fmtMicro(ls.costMicro), 'reported by the gateway' + (ls.costedTasks < ls.meteredTasks ? ' for ' + ls.costedTasks + ' of ' + ls.meteredTasks + ' calls — the rest unpriced' : ''))
      : stat('COST', 'n/a', ls.meteredTasks ? 'the gateway reported no cost' : 'nothing was metered');
    const vsEst = est && ls.costMicro != null && est.cost.p50 > 0
      ? ' · actual is ' + Math.round(((ls.costMicro / 1e6) / est.cost.p50) * 100) + '% of it' : '';
    $('summary-inner').innerHTML = '<div class=\"ov-title\"' + (good ? '' : ' style=\"color:#fca5a5\"') + '>' + head + '</div>'
      + '<div class=\"ov-sub\"><span class=\"src-tag live\">LIVE</span>' + escapeHtml(m.title) + (ls.crewId ? ' · crew <span class=\"mono\">' + escapeHtml(ls.crewId) + '</span>' : '') + '</div>'
      + (ls.error ? '<div class=\"ov-sub\" style=\"color:#fca5a5;margin-top:-14px\">' + escapeHtml(ls.error) + '</div>' : '')
      + (ls.unforwarded && ls.unforwarded.length ? '<div class=\"ov-sub\" style=\"margin-top:-14px\">Not forwarded to the engine: ' + escapeHtml(ls.unforwarded.join(', ')) + '</div>' : '')
      + '<div class=\"sum-grid\">'
      + stat('DURATION', fmtTime(ls.durationMs || sum.durationMs), ls.timed ? 'run time, as agnostic recorded it' : 'how long this view watched')
      + stat('TASKS', (ls.tasksDone || 0) + ' / ' + total, (ls.tasksFailed || 0) + ' not completed')
      + stat('AGENTS', ls.spawned || 0, 'peak ' + (ls.peak || 0) + ' tasks at once · ' + escapeHtml(ls.process || ''))
      + stat('ENGINE', escapeHtml(ls.engineMode || '?'), ls.engineMode === 'placeholder' ? 'no LLM gateway — outputs are echoes' : 'as reported by agnostic')
      + tok + cost
      + stat('SIMULATED EST.', est ? fmtCost(est.cost.p50) : '—', est ? 'p50 of ' + est.runs + ' simulated runs' + vsEst : 'estimate the swarm to compare')
      + stat('EVENTS MISSED', ls.dropped || 0, ls.dropped ? (ls.lost ? ls.lost + ' dropped before agnostic took them' : 'fell out of the crew’s event window') : 'every progress event arrived')
      + '</div>'
      + '<div class=\"sum-actions\"><button class=\"primary\" data-act=\"results\"' + (total ? '' : ' disabled') + '>☰ Results</button><button data-act=\"replay\">⟲ Watch replay</button>'
      + (run.saved && status !== 'unconfirmed' ? '<button data-act=\"again\" title=\"Submit this swarm to agnostic again\">⚡ Run live again</button>' : '')
      + '<button data-act=\"menu\">☰ Swarms</button><button data-act=\"export\">⤓ Export log</button><button data-act=\"close\">Close</button></div>';
    this.bindSummary(box);
    box.classList.remove('hidden');
  }
  /** Every task's output, with what agnostic metered for it — and the whole as a file to keep. */
  showResults(m) {
    const ls = (m && m.summary) || {};
    const rows = Array.isArray(ls.results) ? ls.results : [];
    const usageLine = (u) => {
      if (!u || typeof u !== 'object') return '';
      const parts = [];
      if (typeof u.model === 'string') parts.push(u.model);
      if (Number.isInteger(u.total_tokens)) parts.push(fmtTokens(u.total_tokens) + ' tokens');
      if (Number.isInteger(u.cost_micro_usd)) parts.push(fmtMicro(u.cost_micro_usd));
      if (Number.isInteger(u.duration_ms)) parts.push(fmtTime(u.duration_ms));
      return parts.join(' · ');
    };
    const html = '<div class=\"results\">' + rows.map((t, i) => '<div class=\"res-item\"><div class=\"res-head\"><b>' + (i + 1) + '. ' + escapeHtml(t.title || 'Task') + '</b>'
      + '<span class=\"res-st ' + (t.status === 'done' ? 'ok' : 'bad') + '\">' + escapeHtml(t.status === 'done' ? 'DONE' : String(t.status || '').toUpperCase()) + '</span>'
      + '<small>' + escapeHtml(usageLine(t.usage)) + '</small></div>'
      + '<pre class=\"res-out\">' + escapeHtml(t.output || '(no output)') + '</pre></div>').join('') + '</div>'
      + '<div class=\"res-dl\"><button class=\"lbtn\" type=\"button\" data-dl=\"md\">⤓ Markdown</button><button class=\"lbtn\" type=\"button\" data-dl=\"json\">⤓ JSON</button></div>';
    this.app.modal.confirm('Results · ' + (m.title || 'crew'), html, { yes: 'Close', no: '', wide: true });
    const dl = (e) => {
      const b = e.target.closest('button[data-dl]');
      if (!b) return;
      const base = 'crew-' + (ls.crewId ? ls.crewId.slice(0, 8) : 'results');
      if (b.dataset.dl === 'json') {
        downloadText(base + '.json', JSON.stringify({ crew_id: ls.crewId || null, status: ls.status, engine_mode: ls.engineMode, tokens: ls.tokensActual ? ls.tokens : null,
          cost_micro_usd: ls.costMicro, tasks: rows.map((t) => ({ title: t.title, status: t.status, usage: t.usage || null, output: t.output })) }, null, 2));
      } else {
        downloadText(base + '.md', '# ' + (m.title || 'Crew') + '\\n\\nCrew `' + (ls.crewId || '?') + '` — ' + ls.status + (ls.engineMode ? ' · ' + ls.engineMode + ' engine' : '') + '\\n\\n'
          + rows.map((t, i) => '## ' + (i + 1) + '. ' + t.title + ' — ' + t.status + (usageLine(t.usage) ? '\\n\\n_' + usageLine(t.usage) + '_' : '') + '\\n\\n' + (t.output || '_(no output)_') + '\\n').join('\\n'));
      }
    };
    $('modal-body').onclick = dl;
  }
}

Object.assign(HUD.prototype, {
  /* ---------- selection panel ---------- */
  updateSelection(now) {
    const s = this.store, ui = this.ui;
    const ids = [...ui.selection].filter((id) => s.agents.has(id));
    let key;
    if (ids.length === 1) key = 'one:' + ids[0];
    else if (ids.length > 1) key = 'many:' + ids.length + ':' + ids.slice(0, 90).join(',');
    else if (ui.inspect) key = 'ins:' + ui.inspect.kind + ':' + ui.inspect.id;
    else key = 'none';
    if (key !== this.selKey) {
      this.selKey = key;
      if (ids.length === 1) this.buildUnit(ids[0]);
      else if (ids.length > 1) this.buildMany(ids);
      else if (ui.inspect) this.buildInspect(ui.inspect);
      else this.buildNone();
    }
    if (ids.length === 1) this.refreshUnit(ids[0], now);
    else if (ids.length > 1) this.refreshMany(ids);
    else if (ui.inspect) this.refreshInspect(ui.inspect);
    else this.refreshNone();
  },
  buildNone() {
    this.el.sel.innerHTML = '<div class=\"sel-empty\" style=\"max-width:560px\"><div class=\"panel-title\" style=\"justify-content:center\">MISSION</div>'
      + '<b data-f=\"obj\"></b><br><span data-f=\"prog\"></span><br>'
      + '<span style=\"color:var(--faint)\">Click a unit or drag a box to select · double-click selects a whole role · right-click a task or structure to give orders · click a task, tool or region to inspect it</span></div>';
  },
  refreshNone() {
    const s = this.store, q = (f) => this.el.sel.querySelector('[data-f=\"' + f + '\"]');
    const o = q('obj');
    if (!o) return;
    o.textContent = s.mission.objective || s.mission.title || 'No mission running';
    q('prog').textContent = s.mission.status === 'idle' ? '' : s.stats.tasksDone + '/' + s.stats.tasksTotal + ' tasks complete · ' + (s.resources.active || 0) + ' agents active · ' + fmtCost(s.resources.cost) + ' spent';
  },

  buildUnit(id) {
    this.el.sel.innerHTML = '<div class=\"sel-main\"><div class=\"sel-head\"><canvas data-f=\"portrait\"></canvas><div style=\"min-width:0\"><div class=\"sel-name\" data-f=\"name\"></div><div class=\"sel-sub\" data-f=\"sub\"></div></div></div>'
      + '<dl class=\"kv\"><dt>State</dt><dd data-f=\"state\"></dd><dt>Task</dt><dd data-f=\"task\"></dd><dt>Step</dt><dd data-f=\"step\"></dd>'
      + '<dt>Tokens</dt><dd data-f=\"tokens\"></dd><dt>Health</dt><dd><div class=\"hp\" style=\"margin-top:5px\"><i data-f=\"hp\"></i></div></dd><dt>Lineage</dt><dd data-f=\"lineage\"></dd></dl></div>'
      + '<div class=\"sel-side\"><div class=\"panel-title\" style=\"margin-bottom:0\">LOG <span style=\"flex:1\"></span><span data-f=\"errs\" style=\"letter-spacing:0\"></span></div><div class=\"sel-log\" data-f=\"log\"></div>'
      + '<div class=\"timeline-wrap\"><div class=\"panel-title\">ACTIVITY TIMELINE <span style=\"flex:1\"></span><span data-f=\"life\" class=\"mono\" style=\"letter-spacing:0\"></span></div><canvas class=\"timeline\" data-f=\"tl\"></canvas></div></div>';
    this.unitRefs = {};
    for (const n of this.el.sel.querySelectorAll('[data-f]')) this.unitRefs[n.dataset.f] = n;
    this.unitLogKey = '';
  },
  refreshUnit(id, now) {
    const a = this.store.agents.get(id), r = this.unitRefs;
    if (!a || !r) return;
    const R = ROLES[a.role] || ROLES.coder;
    const st = a.alive ? a.state : a.endReason === 'completed' ? 'done' : 'dead';
    drawRoleIcon(r.portrait, a.role, st, null);
    r.name.textContent = a.name;
    r.name.style.color = R.color;
    r.sub.innerHTML = escapeHtml(R.label) + ' · <span class=\"mono\">' + escapeHtml(a.model) + '</span> · <span style=\"color:' + (this.isLocal(a.territory) ? 'var(--local)' : 'var(--cloud)') + '\">'
      + escapeHtml((this.store.territories.get(a.territory) || { name: a.territory }).name) + '</span>';
    const col = STATE_COLORS[st] || STATE_COLORS.idle;
    const label = a.alive ? STATE_LABEL[a.state] + (a.held && a.state === 'idle' ? ' · holding' : '') : a.endReason === 'completed' ? 'completed' : 'terminated · ' + a.endReason;
    r.state.innerHTML = '<span class=\"state-pill\" style=\"color:' + col + ';border-color:' + col + '\">' + escapeHtml(label) + '</span>';
    const task = a.taskId && this.store.tasks.get(a.taskId);
    r.task.textContent = task ? task.title + ' · ' + fmtPct(task.progress) : a.role === 'orchestrator' ? this.store.mission.objective : '—';
    r.task.title = r.task.textContent;
    r.step.textContent = a.step || '—';
    r.step.title = a.step || '';
    r.tokens.textContent = fmtTokens(a.tokens) + ' tok · ' + fmtCost(a.cost, 3);
    r.hp.style.width = clamp(a.health, 0, 100) + '%';
    r.hp.style.background = a.health > 60 ? 'var(--ok)' : a.health > 30 ? 'var(--work)' : 'var(--err)';
    r.lineage.textContent = a.role === 'orchestrator' ? 'spawned ' + this.store.stats.agentsSpawned + ' agents'
      : a.retryOf ? 'retry of ' + this.store.agentName(a.retryOf) : a.parentId ? 'sub-agent of ' + this.store.agentName(a.parentId) : 'spawned by Orchestrator';
    r.errs.textContent = a.errors ? a.errors + ' error' + (a.errors > 1 ? 's' : '') : '';
    r.errs.style.color = 'var(--err)';
    const lines = a.log.slice(-5);
    const lk = a.log.length + ':' + (lines.length ? lines[lines.length - 1].t + lines[lines.length - 1].text : '');
    if (lk !== this.unitLogKey) {
      this.unitLogKey = lk;
      r.log.innerHTML = lines.map((l) => '<div title=\"' + escapeHtml(l.text) + '\"><span class=\"t\">' + fmtTime(l.t) + '</span><span class=\"' + l.cls + '\">' + escapeHtml(l.text) + '</span></div>').join('') || '<div>—</div>';
    }
    const end = a.alive ? now : a.endedAt;
    r.life.textContent = 'alive ' + fmtTime(end - a.spawnedAt);
    this.drawTimeline(r.tl, a, end);
  },
  drawTimeline(c, a, end) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2), w = c.clientWidth || 200, h = c.clientHeight || 16;
    if (c.width !== Math.round(w * dpr)) { c.width = Math.round(w * dpr); c.height = Math.round(h * dpr); }
    const g = c.getContext('2d');
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.clearRect(0, 0, w, h);
    const tl = a.timeline;
    const t0 = tl.length ? Math.max(a.spawnedAt, tl[0].t) : a.spawnedAt, span = Math.max(1000, end - t0);
    for (let i = 0; i < tl.length; i++) {
      const s = Math.max(tl[i].t, t0), e = i + 1 < tl.length ? tl[i + 1].t : end;
      if (e <= s) continue;
      g.fillStyle = STATE_COLORS[tl[i].s] || '#333';
      g.fillRect(((s - t0) / span) * w, 3, Math.max(1, ((e - s) / span) * w), h - 6);
    }
    g.fillStyle = 'rgba(255,255,255,0.25)';
    for (let t = Math.ceil(t0 / 10000) * 10000; t < end; t += 10000) g.fillRect(((t - t0) / span) * w, 0, 1, 3);
  },

  buildMany(ids) {
    const box = this.el.sel;
    box.innerHTML = '<div class=\"sel-summary\"><div class=\"panel-title\">SELECTION</div><div><span class=\"big\" data-f=\"n\"></span> agents</div><div data-f=\"roles\"></div>'
      + '<div data-f=\"states\" class=\"mono\" style=\"font-size:10.5px;color:var(--dim)\"></div><div data-f=\"where\" class=\"mono\" style=\"font-size:10.5px\"></div>'
      + '<div data-f=\"spend\" class=\"mono\" style=\"font-size:10.5px;color:var(--gold)\"></div></div><div class=\"sel-grid\" data-f=\"grid\"></div>';
    const grid = box.querySelector('[data-f=\"grid\"]');
    const cols = Math.max(1, Math.floor((grid.clientWidth + 4) / 42)), rows = Math.max(1, Math.floor((grid.clientHeight + 4) / 42));
    const cap = cols * rows;
    const shown = ids.length > cap ? ids.slice(0, cap - 1) : ids;
    grid.innerHTML = shown.map((id) => '<div class=\"pt\" data-id=\"' + id + '\" title=\"' + escapeHtml(this.store.agentName(id)) + '\"><canvas></canvas></div>').join('')
      + (ids.length > cap ? '<div class=\"pt more\">+' + (ids.length - shown.length) + '</div>' : '');
    grid.onclick = (e) => {
      const p = e.target.closest('.pt[data-id]');
      if (!p) return;
      if (e.shiftKey) { this.ui.selection.delete(p.dataset.id); this.selectionChanged(); } else this.app.select([p.dataset.id], false);
    };
    this.manyRefs = {};
    for (const n of box.querySelectorAll('[data-f]')) this.manyRefs[n.dataset.f] = n;
    this.portraits = [...grid.querySelectorAll('.pt[data-id]')].map((p) => [p.dataset.id, p.querySelector('canvas')]);
  },
  refreshMany(ids) {
    const s = this.store, r = this.manyRefs;
    if (!r) return;
    const roles = {}, states = {};
    let tok = 0, cost = 0, loc = 0, cl = 0;
    for (const id of ids) {
      const a = s.agents.get(id);
      roles[a.role] = (roles[a.role] || 0) + 1;
      states[a.state] = (states[a.state] || 0) + 1;
      tok += a.tokens; cost += a.cost;
      if (this.isLocal(a.territory)) loc++; else cl++;
    }
    r.n.textContent = ids.length;
    r.roles.innerHTML = Object.keys(roles).map((k) => '<span style=\"color:' + (ROLES[k] || ROLES.coder).color + '\">' + (ROLES[k] || ROLES.coder).label + ' ' + roles[k] + '</span>').join(' · ');
    r.states.innerHTML = Object.keys(states).map((k) => '<span style=\"color:' + (STATE_COLORS[k] || '#999') + '\">' + k + ' ' + states[k] + '</span>').join(' · ');
    r.where.innerHTML = '<span style=\"color:var(--local)\">Local ' + loc + '</span> · <span style=\"color:var(--cloud)\">Cloud ' + cl + '</span>';
    r.spend.textContent = fmtTokens(tok) + ' tok · ' + fmtCost(cost, 3);
    for (const [id, c] of this.portraits) { const a = s.agents.get(id); if (a) drawRoleIcon(c, a.role, a.alive ? a.state : 'dead', a.health); }
  },

  buildInspect(ins) {
    this.el.sel.innerHTML = '<div style=\"flex:1;min-width:0;display:flex;flex-direction:column;gap:6px\"><div class=\"panel-title\" data-f=\"kind\"></div><div class=\"sel-name\" data-f=\"title\" style=\"white-space:nowrap;overflow:hidden;text-overflow:ellipsis\"></div>'
      + '<div data-f=\"bar\" class=\"bar\" style=\"height:8px\"><i></i></div><dl class=\"kv\" data-f=\"kv\" style=\"grid-template-columns:110px 1fr\"></dl></div>';
    this.insRefs = {};
    for (const n of this.el.sel.querySelectorAll('[data-f]')) this.insRefs[n.dataset.f] = n;
  },
  refreshInspect(ins) {
    const s = this.store, r = this.insRefs;
    if (!r) return;
    const kv = (pairs) => pairs.filter(Boolean).map(([k, v, c]) => '<dt>' + k + '</dt><dd' + (c ? ' style=\"color:' + c + '\"' : '') + ' title=\"' + escapeHtml(v) + '\">' + escapeHtml(v) + '</dd>').join('');
    const bar = r.bar.querySelector('i');
    if (ins.kind === 'task') {
      const t = s.tasks.get(ins.id);
      if (!t) return;
      r.kind.textContent = 'TASK · ' + t.status.toUpperCase();
      r.kind.style.color = TASK_COLORS[t.status];
      r.title.textContent = t.title;
      r.bar.style.display = '';
      bar.style.width = (t.progress * 100).toFixed(1) + '%';
      bar.style.background = TASK_COLORS[t.status === 'pending' ? 'active' : t.status];
      const deps = t.deps.map((d) => s.tasks.get(d)).filter(Boolean);
      const kids = t.children.map((c) => s.tasks.get(c)).filter(Boolean);
      r.kv.innerHTML = kv([
        ['Progress', fmtPct(t.progress)], ['Needs', (ROLES[t.role] || ROLES.coder).label + ' · ' + t.territory + ' · ' + t.kind],
        deps.length && ['Dependencies', deps.map((d) => (d.status === 'done' ? '✓ ' : d.status === 'failed' ? '✕ ' : '… ') + d.title).join('  ')],
        kids.length && ['Sub-tasks', kids.filter((k) => k.status === 'done').length + '/' + kids.length + ' done (fan-out)'],
        t.parentId && ['Parent', (s.tasks.get(t.parentId) || { title: t.parentId }).title],
        ['Assigned', [...t.assignees].map((id) => s.agentName(id)).join(', ') || '—'],
        t.attempts && ['Retries', String(t.attempts)],
        t.result && [t.status === 'failed' ? 'Failure' : 'Result', t.result, t.status === 'failed' ? '#fca5a5' : '#86efac'],
      ]);
    } else if (ins.kind === 'tool') {
      const t = s.tools.get(ins.id);
      if (!t) return;
      const K = TOOL_KINDS[t.kind] || TOOL_KINDS.llm;
      r.kind.textContent = 'STRUCTURE · ' + K.label.toUpperCase();
      r.kind.style.color = K.color;
      r.title.textContent = t.name;
      r.bar.style.display = 'none';
      r.kv.innerHTML = kv([['Territory', t.territory], ['In use by', [...t.active].map((id) => s.agentName(id)).join(', ') || 'idle'],
        ['Calls', String(t.calls)], ['Errors', String(t.errors), t.errors ? '#fca5a5' : ''], ['Slow calls', String(t.slow), t.slow ? '#fcd34d' : '']]);
    } else {
      const t = s.territories.get(ins.id);
      if (!t) return;
      const local = t.kind === 'local';
      r.kind.textContent = (local ? 'TERRITORY · LOCAL' : 'TERRITORY · CLOUD');
      r.kind.style.color = local ? '#5eead4' : '#c4b5fd';
      r.title.textContent = t.name + ' — ' + (t.region || '');
      r.bar.style.display = '';
      bar.style.width = ((t.active / Math.max(1, t.cap)) * 100).toFixed(1) + '%';
      bar.style.background = local ? 'var(--local)' : 'var(--cloud)';
      const hub = [...s.territories.values()].find((x) => x.kind === 'local');
      r.kv.innerHTML = kv([['Capacity', (t.active || 0) + ' / ' + t.cap + ' agents'], ['Compute price', local ? 'free (your machine)' : fmtCost(t.costPerSec, 4) + ' per agent-second'],
        !local && hub && ['Latency to HQ', ((hub.latencyMs || {})[t.id] || '?') + ' ms'], ['Spend rate', fmtCost(t.rate, 3) + ' / s'], ['Total spend', fmtCost(t.cost, 2)],
        ['Tokens', fmtTokens(t.tokens)], ['Agents spawned here', String(s.stats.territoryAgents[t.id] || 0)]]);
    }
  },
  isLocal(terrId) { const t = this.store.territories.get(terrId); return t ? t.kind === 'local' : terrId === 'local'; },

  /* ---------- event feed ---------- */
  bindFeed() {
    $('feed-chips').addEventListener('click', (e) => {
      const b = e.target.closest('.chip');
      if (!b) return;
      const c = b.dataset.cat;
      if (this.feedCats.has(c)) this.feedCats.delete(c); else this.feedCats.add(c);
      b.classList.toggle('on', this.feedCats.has(c));
      this.rebuildFeed();
    });
    $('feed-agent').addEventListener('input', (e) => { this.feedText = e.target.value.trim().toLowerCase(); this.rebuildFeed(); });
    $('feed-selected').addEventListener('change', (e) => { this.feedSelectedOnly = e.target.checked; this.rebuildFeed(); });
    $('feed-toggle').onclick = () => this.toggleFeed();
    this.el.feedList.addEventListener('click', (e) => { const li = e.target.closest('li'); if (li && li._d) this.app.focusFeedItem(li._d); });
  },
  toggleFeed() {
    const f = this.el.feed, collapsed = !f.classList.contains('collapsed');
    f.classList.toggle('collapsed', collapsed);
    $('feed-toggle').textContent = collapsed ? '‹' : '›';
    this.app.renderer.inset.r = collapsed ? 46 : 336;
  },
  feedMatch(d) {
    if (!this.feedCats.has(d.cat)) return false;
    if (this.feedSelectedOnly && !(d.agentId && this.ui.selection.has(d.agentId))) return false;
    if (this.feedText) {
      const a = d.agentId && this.store.agents.get(d.agentId);
      if (!((a ? a.name : '') + ' ' + (d.agentId || '')).toLowerCase().includes(this.feedText)) return false;
    }
    return true;
  },
  feedItem(d) {
    const li = document.createElement('li');
    li.className = d.cls || '';
    li._d = d;
    li.innerHTML = '<span class=\"t\">' + fmtTime(d.t) + '</span><span class=\"i\">' + d.icon + '</span><span class=\"x\">' + (d.who ? '<b>' + escapeHtml(d.who) + '</b> ' : '') + escapeHtml(d.text) + '</span>';
    li.title = (d.who ? d.who + ' ' : '') + d.text;
    return li;
  },
  updateFeed() {
    const feed = this.store.feed;
    this.el.feedCount.textContent = this.store.feedSeq + ' events';
    if (!feed.length || feed[feed.length - 1].seq <= this.feedSeen) return;
    let i = feed.length - 1;
    while (i > 0 && feed[i - 1].seq > this.feedSeen) i--;
    const items = [];
    for (let j = i; j < feed.length; j++) if (this.feedMatch(feed[j])) items.push(feed[j]);
    this.feedSeen = feed[feed.length - 1].seq;
    if (!items.length) return;
    const frag = document.createDocumentFragment();
    for (let j = items.length - 1; j >= Math.max(0, items.length - 120); j--) frag.appendChild(this.feedItem(items[j]));
    const list = this.el.feedList;
    list.insertBefore(frag, list.firstChild);
    while (list.children.length > 160) list.lastChild.remove();
  },
  rebuildFeed() {
    const list = this.el.feedList, feed = this.store.feed;
    list.innerHTML = '';
    const items = [];
    for (let j = feed.length - 1; j >= 0 && items.length < 160; j--) if (this.feedMatch(feed[j])) items.push(feed[j]);
    const frag = document.createDocumentFragment();
    for (const d of items) frag.appendChild(this.feedItem(d));
    list.appendChild(frag);
    this.feedSeen = feed.length ? feed[feed.length - 1].seq : 0;
  },

  /* ---------- replay bar ---------- */
  bindReplayBar() {
    $('rp-play').onclick = () => this.app.togglePause();
    $('rp-exit').onclick = () => this.app.exitReplay();
    $('rp-export').onclick = () => this.app.exportLog();
    const sc = this.el.scrub;
    sc.addEventListener('input', () => { this.scrubbing = true; this.app.seek((+sc.value / 1000) * (this.app.source.duration || 0)); });
    sc.addEventListener('change', () => { this.scrubbing = false; });
  },
  showReplayBar(v) {
    this.el.replay.classList.toggle('hidden', !v);
    this.app.renderer.inset.t = v ? 100 : 48;
    $('btn-replay').innerHTML = v ? '▸<span class=\"tb-label\"> LIVE</span>' : '⟲<span class=\"tb-label\"> REPLAY</span>';
    $('btn-replay').title = v ? 'Return to the live mission' : 'Scrub through the recorded event log';
  },
  updateReplay() {
    const src = this.app.source;
    if (this.app.mode !== 'replay' || !src) return;
    if (!this.scrubbing) this.el.scrub.value = String(Math.round((src.now() / (src.duration || 1)) * 1000));
    this.el.rpTime.textContent = fmtTime(src.now()) + ' / ' + fmtTime(src.duration);
    this.el.rpPlay.textContent = src.paused ? '▶' : '❚❚';
  },
});

/* =====================================================================================
 *  SECTION 6b · LAUNCHER, EDITOR & LIBRARY — the swarms you keep, and the page that edits them
 * ===================================================================================== */
const ESTIMATE_RUNS = 8;

/** A confirm dialog. The iframe sandbox has no allow-modals, so window.confirm() is not available. */
class Modal {
  constructor() {
    this.el = $('modal');
    this.resolve = null;
    $('modal-yes').addEventListener('click', () => this.close(true));
    $('modal-no').addEventListener('click', () => this.close(false));
    $('modal-alt').addEventListener('click', () => this.close('alt'));
    this.el.addEventListener('mousedown', (e) => { if (e.target === this.el) this.close(false); });
    window.addEventListener('keydown', (e) => {
      if (!this.isOpen()) return;
      if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); this.close(false); }
      else if (e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); this.close(true); }
    }, true);
  }
  isOpen() { return !this.el.classList.contains('hidden'); }
  /**
   * Resolves true for yes, false for no (and Escape), 'alt' for the optional third choice.
   * `html` is trusted markup: callers escape what they interpolate.
   */
  confirm(title, html, { yes = 'OK', no = 'Cancel', danger = false, alt = '', wide = false } = {}) {
    if (this.resolve) this.close(false);
    this.el.querySelector('.modal-box').classList.toggle('wide', !!wide);
    $('modal-body').onclick = null;
    $('modal-title').textContent = title;
    $('modal-body').innerHTML = html;
    const y = $('modal-yes'), n = $('modal-no'), x = $('modal-alt');
    x.textContent = alt;
    x.classList.toggle('hidden', !alt);
    y.textContent = yes;
    y.className = 'lbtn ' + (danger ? 'danger' : 'primary');
    n.textContent = no || '';
    n.classList.toggle('hidden', !no);
    this.el.classList.remove('hidden');
    y.focus();
    return new Promise((r) => { this.resolve = r; });
  }
  close(v) {
    this.el.classList.add('hidden');
    const r = this.resolve;
    this.resolve = null;
    if (r) r(v);
  }
}

/** localStorage for a page opened on its own; null where storage is unavailable (a sandboxed frame). */
function browserStore() {
  try {
    const ls = window.localStorage, K = 'swarm-command.specs';
    ls.getItem(K);
    return {
      read() { try { const v = JSON.parse(ls.getItem(K) || '{}'); return v && typeof v === 'object' && !Array.isArray(v) ? v : {}; } catch (err) { return {}; } },
      write(v) { try { ls.setItem(K, JSON.stringify(v)); return true; } catch (err) { return false; } },
    };
  } catch (err) { return null; }
}

/**
 * SwarmLibrary — the saved swarms. Inside agnostic they are this plugin's documents on the
 * server, in the caller's tenant (key swarm-<id>, one spec each); opened on its own the page keeps
 * them in this browser; with neither, they last for the session.
 *
 * Every write to the server carries the document's revision (`ifMatch`, the etag it was read or
 * last written at), so a write made from a stale copy — another tab, an older read — is refused
 * (412) instead of silently undoing someone else's change. Writes to one swarm go one at a time
 * through a queue: a background record (a run, an estimate) is applied to the LATEST copy and
 * retried on a conflict; the editor's save is not retried — it reports the conflict and lets the
 * user choose (Editor.saveConflict).
 */
class SwarmLibrary {
  constructor(host) {
    this.host = host;
    this.specs = new Map();
    this.etags = new Map();   // id → the revision the cached copy was read or written at
    this.queues = new Map();  // id → the tail of that swarm's write queue
    this.state = 'idle'; // 'idle' | 'loading' | 'ready' | 'error'
    this.error = '';
    this.scope = '';
    this.skipped = 0;
    this.seq = 0;
    this.listeners = new Set();
    this.errorListeners = new Set();
  }
  onChange(fn) { this.listeners.add(fn); }
  changed() { for (const fn of this.listeners) fn(); }
  /** Background writes that fail are reported here, never only to the console. */
  onError(fn) { this.errorListeners.add(fn); }
  reportError(message) { for (const fn of this.errorListeners) fn(message); }
  /** 'server' | 'browser' | 'none' (this session only) | 'pending' (the shell has not answered yet). */
  backend() {
    if (this.host.mode === 'connected') return this.host.can('storage') ? 'server' : 'none';
    if (this.host.mode === 'standalone') return browserStore() ? 'browser' : 'none';
    return 'pending';
  }
  /** Whether this user may write swarms here: not a viewer, and not a read-only document. */
  writable(spec) {
    if (spec && spec.readOnly) return false;
    return !(this.host.mode === 'connected' && this.host.role() === 'viewer');
  }
  get(id) { return this.specs.get(id) || null; }
  list() { return [...this.specs.values()].sort((a, b) => b.updated - a.updated); }
  docPath(key) { return '/api/v1/plugins/' + this.host.pluginId() + '/data' + (key ? '/' + key : ''); }
  async load() {
    const seq = ++this.seq, be = this.backend();
    this.error = '';
    this.skipped = 0;
    if (be === 'pending') { this.state = 'loading'; this.changed(); return; }
    // Swarms that exist only in this session (made before agnostic answered, or with no
    // storage permission) are kept across a reload rather than vanishing with it.
    const sessionOnly = [...this.specs.values()].filter((x) => x.unsaved);
    if (be === 'none') { this.state = 'ready'; this.changed(); return; }
    if (be === 'browser') {
      this.specs.clear();
      for (const raw of Object.values(browserStore().read())) { const s = normalizeSpec(raw); if (s) this.specs.set(s.id, s); else this.skipped++; }
      for (const x of sessionOnly) if (!this.specs.has(x.id)) this.specs.set(x.id, x);
      this.state = 'ready';
      this.changed();
      return;
    }
    this.state = 'loading';
    this.changed();
    let r = await this.host.request('GET', this.docPath());
    // A transient failure gets one more try before the launcher says it could not list.
    if (r.status === 0 || r.status >= 500) { await sleepMs(800); if (seq !== this.seq) return; r = await this.host.request('GET', this.docPath()); }
    if (seq !== this.seq) return;
    if (r.status !== 200 || !r.data || !Array.isArray(r.data.documents)) {
      this.state = 'error';
      this.error = r.status === 401 ? 'Sign in to see your swarms.' : r.status === 403 ? 'Your role cannot read this plugin’s documents.' : 'Could not list your swarms: ' + errOf(r);
      this.changed();
      return;
    }
    this.scope = typeof r.data.scope === 'string' ? r.data.scope : '';
    const keys = r.data.documents.map((d) => d && d.key).filter((k) => typeof k === 'string' && k.startsWith(SPEC_PREFIX) && RE_SPEC_ID.test(k.slice(SPEC_PREFIX.length)));
    const got = new Map(), tags = new Map();
    let next = 0;
    const worker = async () => {
      while (next < keys.length) {
        const key = keys[next++];
        let g = await this.host.request('GET', this.docPath(key));
        if (g.status === 0 || g.status >= 500) g = await this.host.request('GET', this.docPath(key));
        const s = g.status === 200 ? normalizeSpec(g.data) : null;
        if (s) { s.id = key.slice(SPEC_PREFIX.length); got.set(s.id, s); if (g.etag) tags.set(s.id, g.etag); } else this.skipped++;
      }
    };
    await Promise.all([worker(), worker(), worker(), worker()]);
    if (seq !== this.seq) return;
    for (const x of sessionOnly) if (!got.has(x.id)) got.set(x.id, x);
    this.specs = got;
    this.etags = tags;
    this.state = 'ready';
    this.changed();
  }
  /** Run `job` after every earlier write to swarm `id` has finished. */
  enqueue(id, job) {
    const prev = this.queues.get(id) || Promise.resolve();
    const run = prev.then(job, job);
    this.queues.set(id, run.catch(() => {}));
    return run;
  }
  /**
   * Write `s` as it is. `mode`: 'create' (refused if it exists), 'replace' (refused unless the
   * stored copy is still the one we hold), or 'force' (overwrite whatever is there). Resolves
   * {ok, message, conflict?, spec?}.
   */
  async write(s, mode) {
    const doc = storableSpec(s);
    const bytes = specBytes(doc);
    if (bytes > SPEC_MAX_BYTES) return { ok: false, message: 'This swarm is ' + fmtKB(bytes) + ' — the server keeps up to 32 KB per swarm' };
    const be = this.backend();
    if (be === 'server') {
      const opts = {};
      const tag = this.etags.get(s.id);
      if (mode === 'create') opts.ifNoneMatch = '*';
      else if (mode === 'replace' && tag && this.host.has('revisions')) opts.ifMatch = tag;
      const r = await this.host.request('PUT', this.docPath(SPEC_PREFIX + s.id), doc, opts);
      if (r.status === 412) return { ok: false, conflict: true, message: 'This swarm was changed somewhere else since it was loaded' };
      if (r.status !== 200 && r.status !== 201) {
        const why = { 401: 'Sign in to save swarms', 403: 'Your role cannot save swarms — it needs write access', 413: 'Too big for the server (32 KB per swarm)',
          507: 'The server already holds the most swarms it keeps for this plugin (256) — delete some first' }[r.status];
        return { ok: false, message: why || 'Could not save: ' + errOf(r) };
      }
      if (r.data && typeof r.data.etag === 'string') this.etags.set(s.id, r.data.etag);
      else this.etags.delete(s.id);
    } else if (be === 'browser') {
      const st = browserStore(), all = st.read();
      all[s.id] = doc;
      if (!st.write(all)) return { ok: false, message: 'This browser refused to store the swarm' };
    } else if (be === 'pending') {
      return { ok: false, message: 'Still connecting to agnostic — try again in a moment' };
    }
    const kept = normalizeSpec(doc) || s;
    kept.id = s.id;
    if (be === 'none') kept.unsaved = true;
    this.specs.set(s.id, kept);
    this.changed();
    return { ok: true, message: be === 'none' ? 'kept for this session only' : '', spec: kept };
  }
  /**
   * Save a whole spec from the editor. `isNew` creates it; otherwise the copy being replaced must
   * still be the stored one, and a conflict comes back as {conflict: true} for the user to settle.
   * `force` overwrites regardless. Editor saves leave SPEC_RESERVE bytes for run records.
   */
  save(spec, { isNew = false, force = false } = {}) {
    if (!this.writable(spec)) return Promise.resolve({ ok: false, message: spec && spec.readOnly ? 'This swarm was made by a newer Swarm Command and is read-only here' : 'Your role (viewer) cannot save swarms' });
    const s = deepCopy(spec);
    delete s.readOnly;
    delete s.unsaved;
    s.updated = Date.now();
    const bytes = specBytes(storableSpec(s));
    if (bytes > SPEC_MAX_BYTES - SPEC_RESERVE) {
      return Promise.resolve({ ok: false, message: 'This swarm is ' + fmtKB(bytes) + ' — keep it under ' + fmtKB(SPEC_MAX_BYTES - SPEC_RESERVE) + ' so its runs can be recorded on it' });
    }
    return this.enqueue(s.id, () => this.write(s, force ? 'force' : isNew ? 'create' : 'replace'));
  }
  async remove(id) {
    const spec = this.specs.get(id);
    if (spec && !this.writable(spec) && !spec.readOnly) return { ok: false, message: 'Your role (viewer) cannot delete swarms' };
    return this.enqueue(id, async () => {
      const be = this.backend();
      if (be === 'server') {
        const r = await this.host.request('DELETE', this.docPath(SPEC_PREFIX + id));
        if (r.status !== 200 && r.status !== 404) return { ok: false, message: r.status === 403 ? 'Your role cannot delete swarms' : 'Could not delete: ' + errOf(r) };
      } else if (be === 'browser') {
        const st = browserStore(), all = st.read();
        delete all[id];
        st.write(all);
      }
      this.specs.delete(id);
      this.etags.delete(id);
      this.changed();
      return { ok: true };
    });
  }
  /** Read swarm `id` fresh from the server, with its revision. Resolves the spec, or null. */
  async reload(id) {
    if (this.backend() !== 'server') return this.get(id);
    const g = await this.host.request('GET', this.docPath(SPEC_PREFIX + id));
    if (g.status !== 200) return null;
    const s = normalizeSpec(g.data);
    if (!s) return null;
    s.id = id;
    if (g.etag) this.etags.set(id, g.etag);
    this.specs.set(id, s);
    this.changed();
    return s;
  }
  /**
   * Change a saved spec in place — run records, estimates. `fn` is applied to the LATEST copy;
   * on a conflict the copy is re-read and `fn` applied again (up to three times), so two writers
   * never undo each other. `touch: false` keeps the card where it is (a background record is not
   * an edit). A spec that would outgrow the server's limit is trimmed — oldest simulations first,
   * then the estimate, then the oldest live runs — before it is refused. Resolves the saved spec,
   * or null after reporting why.
   */
  patch(id, fn, { touch = true } = {}) {
    return this.enqueue(id, async () => {
      for (let attempt = 0; attempt < 3; attempt++) {
        const cur = this.specs.get(id);
        if (!cur) return null;
        if (!this.writable(cur)) { fn(cur); this.changed(); return null; } // kept on screen, not stored
        const next = deepCopy(cur);
        delete next.readOnly;
        delete next.unsaved;
        fn(next);
        capRuns(next);
        if (touch) next.updated = Date.now();
        fitSpec(next);
        const r = await this.write(next, 'replace');
        if (r.ok) return r.spec;
        if (r.conflict) { if (!(await this.reload(id))) break; continue; }
        this.reportError('Could not update ' + cur.name + ': ' + r.message);
        fn(cur); // keep it on screen for this session at least
        this.changed();
        return null;
      }
      this.reportError('Could not update a swarm: it kept changing somewhere else');
      return null;
    });
  }
}

/** The kickoff page: your swarms, the templates, and where they are kept. */
class Launcher {
  constructor(app) {
    this.app = app;
    this.lib = app.library;
    this.host = app.host;
    this.busy = new Map(); // spec id → {progress, signal}
    this.estPaint = 0;
    this.buildTemplates();
    $('lib-list').addEventListener('click', (e) => this.onClick(e));
    $('btn-new').addEventListener('click', () => this.app.editor.open(defaultSpec('custom', 1), { isNew: true }));
    $('opt-import').addEventListener('change', (e) => { const f = e.target.files[0]; e.target.value = ''; if (f) this.importFile(f); });
    $('opt-load').addEventListener('change', (e) => { const f = e.target.files[0]; e.target.value = ''; if (f) this.app.loadLogFile(f); });
    this.lib.onChange(() => { this.render(); if (this.lib.state === 'ready') this.refreshRuns(); });
    this.lib.onError((m) => this.app.hud.toast(m, 'bad'));
    this.host.onChange(() => { this.lib.load(); this.render(); this.loadCrews(); });
    $('crews-refresh').addEventListener('click', () => this.loadCrews(true));
    $('crews-list').addEventListener('click', (e) => {
      const b = e.target.closest('button[data-crew]');
      const c = b && this.crews.find((x) => x.crew_id === b.dataset.crew);
      if (c) this.app.watchCrew(c);
    });
    this.runsCheckedAt = 0;
    this.crews = [];
    this.crewsAt = 0;
    // While the launcher is on screen, crews and run records are kept current.
    setInterval(() => { if (this.visible()) { this.refreshRuns(); this.loadCrews(); } }, 15000);
  }
  /**
   * A crew left running when its view closed is still \"running\" on its card. Ask agnostic how the
   * recent ones ended — newest first, a few at a time, not more often than every 15 seconds — and
   * record what it metered. A run whose submission was never answered ('submitting' with no crew
   * id after ten minutes) becomes 'unconfirmed': only the Crews list can say whether it started.
   */
  async refreshRuns() {
    if (!this.host.can('crews:read') || Date.now() - this.runsCheckedAt < 15000) return;
    this.runsCheckedAt = Date.now();
    const open = [];
    for (const s of this.lib.list()) {
      if (!this.lib.writable(s)) continue;
      for (const r of s.runs) {
        if (r.kind !== 'live' || CREW_TERMINAL.has(r.status) || /lost|refused|unconfirmed/.test(r.status)) continue;
        if (Date.now() - r.at > 7 * 86400000) continue;
        open.push({ id: s.id, run: r });
      }
    }
    open.sort((x, y) => y.run.at - x.run.at);
    for (const { id, run } of open.slice(0, 6)) {
      if (!run.crew) {
        if (Date.now() - run.at > 600000) {
          await this.lib.patch(id, (x) => { const r = x.runs.find((q) => q.kind === 'live' && q.key === run.key); if (r && !r.crew) r.status = 'unconfirmed'; }, { touch: false });
        }
        continue;
      }
      const g = await this.host.request('GET', '/api/v1/crews/' + run.crew);
      let status = null;
      if (g.status === 200 && g.data && typeof g.data.status === 'string') status = g.data.status;
      else if (g.status === 404) status = 'lost';
      if (!status || status === 'pending' || status === 'running') continue;
      const res = g.data && Array.isArray(g.data.results) ? g.data.results : [];
      const done = res.filter((x) => x && x.status === 'completed').length;
      const u = g.data && g.data.usage && typeof g.data.usage === 'object' ? g.data.usage : null;
      await this.lib.patch(id, (x) => {
        const r = x.runs.find((q) => q.kind === 'live' && q.crew === run.crew);
        if (!r) return;
        r.status = status;
        if (res.length) Object.assign(r, { done, failed: res.length - done, total: res.length });
        if (g.data && g.data.finished_at && (g.data.started_at || g.data.submitted_at)) r.durationMs = g.data.finished_at - (g.data.started_at || g.data.submitted_at);
        if (u && Number.isInteger(u.metered_tasks) && u.metered_tasks > 0 && Number.isInteger(u.total_tokens)) r.tokens = u.total_tokens;
        if (u && Number.isInteger(u.cost_micro_usd)) r.costMicro = u.cost_micro_usd;
      }, { touch: false });
    }
  }
  /** The tenant's crews, from agnostic — the newest dozen — for the Crews section. */
  async loadCrews(force) {
    const sec = $('crews-sec');
    if (!this.host.can('crews:read') || !this.host.has('query')) { sec.hidden = true; return; }
    sec.hidden = false;
    if (!force && Date.now() - this.crewsAt < 10000) return;
    this.crewsAt = Date.now();
    const r = await this.host.request('GET', '/api/v1/crews?limit=12');
    if (r.status === 200 && r.data && Array.isArray(r.data.crews)) this.crews = r.data.crews.filter((c) => c && typeof c.crew_id === 'string' && RE_CREW_ID.test(c.crew_id));
    this.renderCrews(r.status === 200 ? '' : r.status === 401 ? 'Sign in to see your crews.' : 'Could not list crews: ' + errOf(r));
  }
  renderCrews(error) {
    const list = $('crews-list');
    if (error) { list.innerHTML = '<div class=\"crew-empty\">' + escapeHtml(error) + '</div>'; return; }
    if (!this.crews.length) { list.innerHTML = '<div class=\"crew-empty\">No crews yet. Run a swarm live, or submit one to the API — every crew of yours shows up here.</div>'; return; }
    list.innerHTML = this.crews.map((c) => {
      const st = String(c.status || '?');
      const cls = /failed|cancelled|unknown/.test(st) ? 'bad' : st === 'completed' ? 'ok' : 'run';
      const when = Number.isFinite(c.submitted_at) ? fmtAgo(c.submitted_at) : '';
      const took = Number.isFinite(c.finished_at) && Number.isFinite(c.submitted_at) ? fmtTime(c.finished_at - (c.started_at || c.submitted_at)) : '';
      const meter = (Number.isInteger(c.total_tokens) ? fmtTokens(c.total_tokens) + ' tok' : '') + (Number.isInteger(c.cost_micro_usd) ? ' · ' + fmtMicro(c.cost_micro_usd) : '');
      return '<div class=\"crew-row\"><span class=\"nm\">' + escapeHtml(c.name || 'crew') + '<small>' + escapeHtml(c.crew_id.slice(0, 8)) + (c.engine_mode === 'placeholder' ? ' · placeholder' : '') + '</small></span>'
        + '<span class=\"st ' + cls + '\">' + escapeHtml(st.toUpperCase()) + '</span>'
        + '<span class=\"mt\">' + (Number.isInteger(c.tasks_submitted) ? c.tasks_submitted + ' tasks' : '') + (took ? ' · ' + took : '') + '</span>'
        + '<span class=\"mt\" title=\"what agnostic metered\">' + escapeHtml(meter || when) + '</span>'
        + '<button class=\"lbtn\" type=\"button\" data-crew=\"' + escapeHtml(c.crew_id) + '\" title=\"Watch it on the map\">WATCH ▸</button></div>';
    }).join('');
  }
  visible() { return !$('start-screen').classList.contains('hidden'); }
  buildTemplates() {
    const wrap = $('scenario-cards');
    wrap.innerHTML = Object.values(TEMPLATES).map((t) => '<div class=\"card\"><h3><span class=\"ico\">' + t.icon + '</span>' + escapeHtml(t.name) + '</h3><p>' + escapeHtml(t.desc) + '</p>'
      + '<div class=\"tags\">' + t.tags.map((x) => '<span>' + escapeHtml(x) + '</span>').join('') + '</div>'
      + '<div class=\"go-row\"><button class=\"go\" type=\"button\" data-act=\"demo\" data-key=\"' + t.key + '\" title=\"Simulate it now — nothing is saved\">▶ DEMO</button>'
      + '<button class=\"go alt\" type=\"button\" data-act=\"customize\" data-key=\"' + t.key + '\" title=\"Open it in the editor as a new swarm\">＋ CUSTOMIZE</button></div></div>').join('');
    wrap.addEventListener('click', (e) => {
      const b = e.target.closest('button[data-act]');
      if (!b) return;
      const spec = defaultSpec(b.dataset.key, +$('opt-scale').value || 1);
      spec.seed = clamp(Math.floor(+$('opt-seed').value) || 1, 1, 2147483647);
      if (b.dataset.act === 'demo') this.app.simulate(spec, { saved: false });
      else this.app.editor.open(spec, { isNew: true });
    });
  }
  renderConn() {
    const c = $('conn'), h = this.host, be = this.lib.backend();
    let cls = '', text;
    if (h.mode === 'connecting') text = 'Connecting to agnostic…';
    else if (h.mode === 'standalone') {
      cls = 'warn';
      text = 'Standalone — open this view inside agnostic to keep swarms on the server and run live crews. ' + (be === 'browser' ? 'Swarms are kept in this browser.' : 'Swarms last for this session.');
    } else {
      cls = 'ok';
      const u = h.info.user;
      text = 'Connected to agnostic · ' + (u.auth === 'off' ? 'auth off (loopback)' : u.signedIn ? 'signed in' + (u.role ? ' as ' + u.role : '') : 'not signed in')
        + (be === 'server' ? ' · swarms are kept on the server' + (this.lib.scope && this.lib.scope !== '_' ? ' for tenant ' + this.lib.scope : '') : ' · no storage permission — swarms last for this session');
    }
    c.className = 'conn ' + cls;
    c.querySelector('span').textContent = text;
  }
  render() {
    if (!this.visible()) return;
    this.renderConn();
    this.loadCrews();
    // A viewer may look, simulate and estimate — not create or import.
    const w = this.lib.writable(null);
    $('btn-new').disabled = !w;
    $('btn-new').title = w ? '' : 'Your role (viewer) cannot create swarms';
    $('opt-import').disabled = !w;
    const list = $('lib-list'), lib = this.lib, specs = lib.list();
    $('lib-count').textContent = specs.length ? specs.length + (specs.length === 1 ? ' swarm' : ' swarms') + (lib.skipped ? ' · ' + lib.skipped + ' unreadable document(s) skipped' : '') : '';
    if (lib.state === 'error') { list.innerHTML = '<div class=\"swarm-empty\">' + escapeHtml(lib.error) + '</div>'; return; }
    if (!specs.length) {
      list.innerHTML = lib.state === 'loading' ? '<div class=\"swarm-empty\">Loading your swarms…</div>'
        : '<div class=\"swarm-empty\"><b>No swarms yet.</b> Customize a template below or start a <b>new swarm</b>: set its agents, models, tools, regions, caps and budget — then simulate it, estimate what it costs over several seeds, or run it live as a crew on this agnostic server.</div>';
      return;
    }
    list.innerHTML = specs.map((s) => this.card(s)).join('');
  }
  card(s) {
    const T = TEMPLATES[s.template] || TEMPLATES.custom, v = validateSpec(s), h = this.host;
    const roles = new Set(specTasks(s).map((t) => t.role));
    const regions = REGION_IDS.filter((id) => regionOn(s, id)).length;
    const capped = ROLE_KEYS.filter((r) => s.roles[r].max != null).length + (s.maxActive != null ? 1 : 0);
    const chips = [v.taskCount + ' tasks' + (v.fanout ? ' + ' + v.fanout + ' sub' : ''), roles.size + (roles.size === 1 ? ' role' : ' roles'), regions + (regions === 1 ? ' region' : ' regions'),
      fmtCost(s.budget, s.budget < 10 ? 2 : 0) + ' budget', s.scale + '×'];
    if (capped) chips.push(capped + (capped === 1 ? ' cap' : ' caps'));
    if (s.tasks && s.template !== 'custom') chips.push('custom tasks');
    const why = !h.can('crews:write') ? (h.mode === 'standalone' ? 'Open this view inside agnostic to run a live crew' : 'This plugin may not start crews here')
      : h.role() === 'viewer' ? 'Your role (viewer) cannot start crews' : v.errors.length ? v.errors[0] : '';
    const runs = s.runs.slice(-4).reverse().map((r) => this.runChip(r)).join('');
    const id = escapeHtml(s.id);
    // A viewer — and anyone, on a document from a newer Swarm Command — may look, simulate and
    // estimate, but not change what is stored.
    const ro = !this.lib.writable(s);
    const roWhy = s.readOnly ? 'Made by a newer Swarm Command — read-only here' : 'Your role (viewer) cannot change swarms';
    const roAttr = ro ? ' disabled title=\"' + escapeHtml(roWhy) + '\"' : '';
    return '<div class=\"swarm\" data-id=\"' + id + '\">'
      + '<div class=\"sw-head\"><span class=\"ico\">' + T.icon + '</span><div class=\"sw-name\">' + escapeHtml(s.name) + (s.readOnly ? '<span class=\"ro-badge\">READ-ONLY</span>' : '') + (s.unsaved ? '<span class=\"ro-badge\">NOT SAVED</span>' : '') + '<small>' + escapeHtml(s.objective || T.desc) + '</small></div>'
      + '<div class=\"sw-tools\"><button type=\"button\" data-act=\"dup\" title=\"Duplicate\"' + (this.lib.writable(null) ? '' : ' disabled') + '>⧉</button><button type=\"button\" data-act=\"export\" title=\"Export as a file\">⤓</button><button type=\"button\" class=\"del\" data-act=\"del\"' + (ro && !s.readOnly ? roAttr : ' title=\"Delete\"') + '>✕</button></div></div>'
      + '<div class=\"sw-chips\">' + chips.map((c) => '<span>' + escapeHtml(c) + '</span>').join('') + '</div>'
      + '<div class=\"sw-est\">' + this.estHtml(s) + '</div>'
      + '<div class=\"sw-runs\">' + (runs || '<span class=\"run-chip\" style=\"opacity:.6\">never run</span>') + '</div>'
      + '<div class=\"sw-actions\"><button class=\"lbtn primary\" type=\"button\" data-act=\"sim\"' + (v.errors.length ? ' disabled title=\"' + escapeHtml(v.errors[0]) + '\"' : ' title=\"Watch it play out in the simulator\"') + '>▶ SIMULATE</button>'
      + '<button class=\"lbtn\" type=\"button\" data-act=\"estimate\"' + (v.errors.length ? ' disabled' : '') + ' title=\"Simulate it ' + ESTIMATE_RUNS + ' times, headless, and price it\">' + (this.busy.has(s.id) ? '■ STOP' : 'Σ ESTIMATE') + '</button>'
      + '<button class=\"lbtn\" type=\"button\" data-act=\"live\"' + (why ? ' disabled title=\"' + escapeHtml(why) + '\"' : ' title=\"Submit its tasks to agnostic as a real crew\"') + '>⚡ RUN LIVE</button>'
      + '<button class=\"lbtn\" type=\"button\" data-act=\"edit\"' + (ro ? roAttr : ' title=\"Edit every setting\"') + '>✎ EDIT</button></div></div>';
  }
  estHtml(s) {
    const b = this.busy.get(s.id);
    if (b) return 'Simulating ' + ESTIMATE_RUNS + ' runs… ' + Math.round(b.progress * 100) + '%<div class=\"bar\"><i style=\"width:' + (b.progress * 100).toFixed(1) + '%\"></i></div>';
    const e = s.estimate;
    if (!e) return 'No cost estimate yet';
    return '<b>≈ ' + fmtCost(e.cost.p50) + '</b> p50 · ' + fmtCost(e.cost.min) + '–' + fmtCost(e.cost.max) + ' · ' + fmtTime(e.durationMs.p50) + ' · ' + e.runs + ' runs'
      + (e.over ? ' · <span style=\"color:#fca5a5\">over budget in ' + e.over + '</span>' : '') + (e.stalled ? ' · <span style=\"color:#fca5a5\">stalled in ' + e.stalled + '</span>' : '')
      + (e.sig !== specSig(s) ? ' · <span class=\"stale\" title=\"Settings changed since this estimate\">stale</span>' : '');
  }
  runChip(r) {
    if (r.kind === 'sim') {
      return '<span class=\"run-chip\" title=\"Simulated ' + escapeHtml(new Date(r.at).toLocaleString()) + (r.seed ? ' · seed ' + r.seed : '') + '\">SIM ' + fmtCost(r.cost || 0) + ' · ' + (r.done || 0) + '/' + (r.total || 0) + ' · ' + fmtAgo(r.at) + '</span>';
    }
    const st = r.status || 'submitted', bad = /failed|cancelled|lost|refused|unknown|unconfirmed/.test(st);
    const metered = (Number.isFinite(r.tokens) ? ' · ' + fmtTokens(r.tokens) + ' tokens' : '') + (Number.isFinite(r.costMicro) ? ' · ' + fmtMicro(r.costMicro) + ' (reported by agnostic)' : '');
    const tip = (r.crew ? 'Crew ' + r.crew : 'Submission ' + (r.key || '')) + ' · ' + st + (r.engine ? ' · ' + r.engine + ' engine' : '') + (r.total ? ' · ' + (r.done || 0) + '/' + r.total + ' tasks' : '')
      + (r.durationMs ? ' · ' + fmtTime(r.durationMs) : '') + metered
      + (st === 'unconfirmed' ? ' — agnostic never answered the submission; look for it in Crews' : '');
    const label = 'LIVE ' + st + (Number.isFinite(r.costMicro) ? ' · ' + fmtMicro(r.costMicro) : '') + ' · ' + fmtAgo(r.at);
    if (!r.crew || !this.host.can('crews:read')) return '<span class=\"run-chip live' + (bad ? ' bad' : '') + '\" title=\"' + escapeHtml(tip) + '\">' + escapeHtml(label) + '</span>';
    return '<button type=\"button\" class=\"run-chip live' + (bad ? ' bad' : '') + '\" data-act=\"watch\" data-crew=\"' + escapeHtml(r.crew) + '\" title=\"' + escapeHtml(tip + ' — watch it') + '\">' + escapeHtml(label) + ' ▸</button>';
  }
  paintEstimate(id) {
    const card = $('lib-list').querySelector('.swarm[data-id=\"' + id + '\"]');
    const s = this.lib.get(id);
    if (card && s) card.querySelector('.sw-est').innerHTML = this.estHtml(s);
  }
  async onClick(e) {
    const b = e.target.closest('button[data-act]');
    const card = b && b.closest('.swarm');
    const s = card && this.lib.get(card.dataset.id);
    if (!s || b.disabled) return;
    switch (b.dataset.act) {
      case 'sim': this.app.simulate(s, { saved: true }); break;
      case 'estimate': this.estimate(s); break;
      case 'live': this.app.runLive(s); break;
      case 'edit': this.app.editor.open(s); break;
      case 'watch': this.app.watchRun(s, b.dataset.crew); break;
      case 'export': downloadText('swarm-' + s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40) + '.json',
        JSON.stringify({ format: 'swarm-command/spec', version: SPEC_VERSION, spec: s }, null, 2)); break;
      case 'dup': {
        const c = deepCopy(s);
        Object.assign(c, { id: newSpecId(), name: (s.name + ' (copy)').slice(0, 80), created: Date.now(), runs: [] });
        delete c.readOnly;
        c.v = SPEC_VERSION;
        const r = await this.lib.save(c, { isNew: true });
        this.app.hud.toast(r.ok ? 'Duplicated ' + s.name : r.message, r.ok ? 'good' : 'bad');
        break;
      }
      case 'del': {
        const ok = await this.app.modal.confirm('Delete ' + s.name + '?', 'The swarm and its run history are removed' + (this.lib.backend() === 'server' ? ' from the server' : '') + '. Crews it started are not affected.', { yes: 'Delete', danger: true });
        if (!ok) return;
        const r = await this.lib.remove(s.id);
        if (!r.ok) this.app.hud.toast(r.message, 'bad');
        break;
      }
    }
  }
  async estimate(spec) {
    const cur = this.busy.get(spec.id);
    if (cur) { cur.signal.cancelled = true; return; }
    const job = { progress: 0, signal: { cancelled: false } };
    this.busy.set(spec.id, job);
    this.render();
    const est = await estimateSpec(spec, {
      runs: ESTIMATE_RUNS, signal: job.signal,
      onProgress: (p) => { job.progress = p; const now = performance.now(); if (now - this.estPaint > 120) { this.estPaint = now; this.paintEstimate(spec.id); } },
    });
    this.busy.delete(spec.id);
    if (!est) { this.render(); return; }
    await this.lib.patch(spec.id, (s) => { s.estimate = est; }, { touch: false });
    this.render();
    this.app.hud.toast(spec.name + ': ≈ ' + fmtCost(est.cost.p50) + ' (p50 of ' + est.runs + ' simulated runs)', 'good');
  }
  async importFile(f) {
    try {
      if (f.size > 1048576) throw new Error('the file is over 1 MB');
      const data = JSON.parse(await readFileText(f));
      const s = normalizeSpec(data && data.format === 'swarm-command/spec' ? data.spec : data);
      if (!s) throw new Error('it does not hold a swarm');
      if (this.lib.get(s.id)) s.id = newSpecId();
      s.runs = []; // its crews ran on some other server
      const r = await this.lib.save(s, { isNew: true });
      this.app.hud.toast(r.ok ? 'Imported ' + s.name : r.message, r.ok ? 'good' : 'bad');
    } catch (err) {
      this.app.hud.toast('Could not import: ' + err.message, 'bad');
    }
  }
}

/* ---- the editor ---- */
const ED_TABS = [['mission', 'Mission'], ['agents', 'Agents'], ['models', 'Models & tools'], ['compute', 'Compute & budget'], ['tasks', 'Tasks'], ['failure', 'Failure model'], ['live', 'Live run']];
const pctShow = (x) => +(x * 100).toFixed(2);
const attrNum = (o) => (o.min != null ? ' data-min=\"' + o.min + '\" min=\"' + o.min + '\"' : '') + (o.max != null ? ' data-max=\"' + o.max + '\" max=\"' + o.max + '\"' : '');
const attrCommon = (o) => (o.cls ? ' class=\"' + o.cls + '\"' : '') + (o.ph ? ' placeholder=\"' + escapeHtml(o.ph) + '\"' : '') + (o.dis ? ' disabled' : '') + (o.rr ? ' data-rr=\"1\"' : '');
function edNum(k, v, o = {}) {
  const shown = v == null || v === '' ? '' : String(o.show ? o.show(v) : v);
  return '<input type=\"number\" data-k=\"' + k + '\" data-t=\"' + (o.t || 'num') + '\" step=\"' + (o.step || 'any') + '\"' + attrNum(o) + attrCommon(o) + ' value=\"' + escapeHtml(shown) + '\">';
}
function edText(k, v, o = {}) {
  return '<input type=\"text\" spellcheck=\"false\" data-k=\"' + k + '\" data-t=\"' + (o.t || 'str') + '\"' + (o.max ? ' maxlength=\"' + o.max + '\"' : '') + attrCommon(o) + ' value=\"' + escapeHtml(v == null ? '' : String(v)) + '\">';
}
function edSel(k, v, opts, o = {}) {
  return '<select data-k=\"' + k + '\" data-t=\"' + (o.t || 'sel') + '\"' + attrCommon(o) + '>'
    + opts.map(([val, label]) => '<option value=\"' + escapeHtml(String(val)) + '\"' + (String(val) === String(v) ? ' selected' : '') + '>' + escapeHtml(label) + '</option>').join('') + '</select>';
}
function edChk(k, v, o = {}) { return '<input type=\"checkbox\" data-k=\"' + k + '\" data-t=\"bool\"' + (v ? ' checked' : '') + attrCommon(o) + '>'; }
const roleCell = (r) => '<span class=\"rl\"><i style=\"background:' + ROLES[r].color + '\"></i>' + ROLES[r].label + '</span>';
const pathKey = (p) => (/^\\d+$/.test(p) ? +p : p);
function setPath(o, path, v) {
  for (let i = 0; i < path.length - 1; i++) {
    const k = pathKey(path[i]);
    if (o[k] == null || typeof o[k] !== 'object') o[k] = {};
    o = o[k];
  }
  o[pathKey(path[path.length - 1])] = v;
}
function getPath(o, path) {
  for (const p of path) { if (o == null) return undefined; o = o[pathKey(p)]; }
  return o;
}

/**
 * Editor — every capability of a swarm, with a default for each. Inputs carry their place in the
 * draft (data-k, '|'-separated) and how to read them (data-t), so one listener edits them all.
 */
class Editor {
  constructor(app) {
    this.app = app;
    this.draft = null;
    this.orig = '';
    this.isNew = false;
    this.tab = 'mission';
    this.estJob = null;
    this.showReq = false;
    this.presets = null;
    this.check = null;
    $('ed-tabs').innerHTML = ED_TABS.map(([k, l]) => '<button type=\"button\" data-tab=\"' + k + '\">' + l + '<span class=\"n\"></span></button>').join('');
    $('ed-tabs').addEventListener('click', (e) => { const b = e.target.closest('button[data-tab]'); if (b) this.show(b.dataset.tab); });
    $('ed-pane').addEventListener('input', (e) => this.onInput(e, false));
    $('ed-pane').addEventListener('change', (e) => this.onInput(e, true));
    $('ed-pane').addEventListener('click', (e) => this.onAction(e));
    $('ed-side').addEventListener('click', (e) => this.onAction(e));
    $('ed-name').addEventListener('input', (e) => { if (this.draft) { this.draft.name = e.target.value; this.renderSide(); } });
    $('ed-cancel').addEventListener('click', () => this.close());
    $('ed-save').addEventListener('click', () => this.save(false));
    window.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !this.isOpen() || this.app.modal.isOpen()) return;
      const tag = e.target && e.target.tagName;
      if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
      this.close();
    });
  }
  isOpen() { return !$('editor').classList.contains('hidden'); }
  open(spec, { isNew = false } = {}) {
    this.draft = deepCopy(spec);
    this.orig = JSON.stringify(this.draft);
    this.isNew = isNew;
    this.showReq = false;
    $('ed-kicker').textContent = (isNew ? 'NEW SWARM · ' : 'EDIT SWARM · ') + (TEMPLATES[spec.template] || TEMPLATES.custom).name.toUpperCase();
    $('ed-name').value = this.draft.name;
    $('editor').classList.remove('hidden');
    this.show('mission');
    if (!this.presets && this.app.host.can('presets:read')) this.loadPresets();
  }
  dirty() { return !!this.draft && JSON.stringify(this.draft) !== this.orig; }
  async close(force) {
    if (!this.isOpen()) return;
    if (!force && this.dirty()) {
      const ok = await this.app.modal.confirm('Discard your changes?', 'The changes to <b>' + escapeHtml(this.draft.name) + '</b> have not been saved.', { yes: 'Discard', no: 'Keep editing', danger: true });
      if (!ok) return;
    }
    if (this.estJob) this.estJob.signal.cancelled = true;
    this.estJob = null;
    $('editor').classList.add('hidden');
    this.draft = null;
  }
  show(tab) {
    this.tab = tab;
    for (const b of $('ed-tabs').querySelectorAll('button')) b.classList.toggle('on', b.dataset.tab === tab);
    this.renderSide();
    this.renderPane();
  }
  renderPane() {
    const d = this.draft;
    const body = { mission: this.paneMission, agents: this.paneAgents, models: this.paneModels, compute: this.paneCompute, tasks: this.paneTasks, failure: this.paneFailure, live: this.paneLive }[this.tab].call(this, d);
    $('ed-pane').innerHTML = body + '<div class=\"ed-actions\" style=\"margin-top:16px\"><button class=\"lbtn sm\" type=\"button\" data-act=\"reset-tab\" title=\"Put this tab’s settings back to the ' + escapeHtml((TEMPLATES[d.template] || TEMPLATES.custom).name) + ' defaults\">↺ Reset this tab to defaults</button></div>';
  }

  /* ---- input → draft ---- */
  parse(el, t) {
    const raw = el.value, s = raw.trim();
    const lo = el.dataset.min != null ? +el.dataset.min : -Infinity, hi = el.dataset.max != null ? +el.dataset.max : Infinity;
    const n = s === '' ? NaN : Number(s), inRange = Number.isFinite(n) && n >= lo && n <= hi;
    switch (t) {
      case 'bool': return { ok: true, v: el.checked };
      case 'sel': case 'roster': return { ok: true, v: el.value };
      case 'selnum': case 'scale': return { ok: true, v: +el.value };
      case 'str': return { ok: true, v: raw };
      case 'livemodel': return s === '' || RE_LIVE_MODEL.test(s) ? { ok: true, v: s } : { ok: false };
      case 'key': return { ok: RE_TASK_KEY.test(s), v: s };
      case 'model-name': return { ok: RE_MODEL.test(s), v: s };
      case 'deps': return { ok: true, v: [...new Set(s.split(/[\\s,]+/).filter(Boolean))] };
      case 'optint': return s === '' ? { ok: true, v: null } : inRange && Number.isInteger(n) ? { ok: true, v: n } : { ok: false };
      case 'int': case 'fan': return inRange && Number.isInteger(n) ? { ok: true, v: n } : { ok: false };
      case 'pct': case 'rework': return inRange ? { ok: true, v: n / 100 } : { ok: false };
      case 'sec': return inRange ? { ok: true, v: Math.round(n * 1000) } : { ok: false };
      default: return inRange ? { ok: true, v: n } : { ok: false };
    }
  }
  onInput(e, commit) {
    const el = e.target, k = el.dataset && el.dataset.k;
    if (!k || !this.draft) return;
    const t = el.dataset.t || 'str';
    const discrete = el.tagName === 'SELECT' || el.type === 'checkbox' || el.type === 'radio';
    if (discrete && !commit) return;
    const res = this.parse(el, t);
    el.classList.toggle('bad', !res.ok);
    if (!res.ok) return;
    const d = this.draft, path = k.split('|');
    switch (t) {
      case 'scale': this.rescale(res.v); return;
      case 'key': if (commit) this.renameTask(+path[1], res.v, el); return;
      case 'model-name': if (commit) this.renameModel(path[1], res.v, el); return;
      case 'fan': {
        const cur = getPath(d, path);
        setPath(d, path, res.v > 0 ? Object.assign({ count: res.v, work: cur ? cur.work : [8, 12] }, cur && cur.titles && cur.count === res.v ? { titles: cur.titles } : {}) : null);
        break;
      }
      case 'rework': setPath(d, path, res.v > 0 ? { chance: res.v } : null); break;
      case 'livemodel': if (res.v) setPath(d, path, res.v); else delete d.live.models[path[2]]; break;
      default: setPath(d, path, res.v);
    }
    this.renderSide();
    if (commit && el.dataset.rr) this.renderPane();
  }
  rescale(k) {
    const d = this.draft, f = k / d.scale;
    if (!(f > 0) || f === 1) return;
    for (const id of REGION_IDS) d.regions[id].cap = Math.max(id === 'local' ? 1 : 0, Math.round(d.regions[id].cap * f));
    d.budget = +(d.budget * f).toFixed(2);
    d.policy.spawnPerSec = +(d.policy.spawnPerSec * f).toFixed(2);
    if (d.maxActive != null) d.maxActive = Math.max(1, Math.round(d.maxActive * f));
    d.scale = k;
    this.app.hud.toast('Region caps, budget and spawn rate scaled ×' + +f.toFixed(2) + ' with the workload', 'good');
    this.renderSide();
    this.renderPane();
  }
  renameTask(i, key, el) {
    const tasks = this.draft.tasks, t = tasks && tasks[i];
    if (!t || t.key === key) return;
    if (tasks.some((x, j) => j !== i && x.key === key)) { el.classList.add('bad'); this.app.hud.toast('Another task already has the key ' + key, 'bad'); return; }
    const old = t.key;
    t.key = key;
    for (const x of tasks) x.deps = x.deps.map((dk) => (dk === old ? key : dk));
    this.renderSide();
    this.renderPane();
  }
  renameModel(old, name, el) {
    const d = this.draft;
    if (name === old || !d.models[old]) return;
    if (d.models[name]) { el.classList.add('bad'); this.app.hud.toast('There is already a model called ' + name, 'bad'); return; }
    const m = {};
    for (const k of Object.keys(d.models)) m[k === old ? name : k] = d.models[k];
    d.models = m;
    if (d.orchestrator.model === old) d.orchestrator.model = name;
    for (const r of ROLE_KEYS) {
      if (d.roles[r].model === old) d.roles[r].model = name;
      if (d.roles[r].localModel === old) d.roles[r].localModel = name;
    }
    this.renderSide();
    this.renderPane();
  }
  async onAction(e) {
    const b = e.target.closest('button[data-act]');
    if (!b || b.disabled || !this.draft) return;
    const d = this.draft;
    switch (b.dataset.act) {
      case 'reseed': d.seed = 1 + Math.floor(Math.random() * 999999); break;
      case 'add-model': {
        let n = Object.keys(d.models).length + 1;
        while (d.models['model-' + n]) n++;
        d.models['model-' + n] = { price: 0.003, tps: 1 };
        break;
      }
      case 'del-model': {
        const m = b.dataset.m;
        const users = ['orchestrator', ...ROLE_KEYS].filter((r) => (r === 'orchestrator' ? d.orchestrator.model === m : d.roles[r].model === m || d.roles[r].localModel === m));
        if (users.length) { this.app.hud.toast(m + ' is in use by ' + users.map((r) => ROLES[r].label).join(', '), 'bad'); return; }
        if (Object.keys(d.models).length <= 1) { this.app.hud.toast('Keep at least one model', 'bad'); return; }
        delete d.models[m];
        break;
      }
      case 'customize': {
        d.tasks = specTasks(d).map(simToCustom);
        if (specBytes(d) > SPEC_MAX_BYTES) {
          for (const t of d.tasks) if (t.fanout) delete t.fanout.titles; // keep the counts, drop the generated sub-task names
        }
        break;
      }
      case 'revert-tasks': {
        const ok = await this.app.modal.confirm('Go back to generated tasks?', 'Your task edits are dropped and the template generates the tasks again.', { yes: 'Revert', danger: true });
        if (!ok) return;
        d.tasks = null;
        break;
      }
      case 'add-task': {
        let n = d.tasks.length + 1;
        while (d.tasks.some((t) => t.key === 'task-' + n)) n++;
        d.tasks.push({ key: 'task-' + n, title: 'New task', role: 'coder', region: 'local', deps: [], work: 5, kind: 'work', priority: 2, difficulty: 1, fanout: null, rework: null });
        break;
      }
      case 'del-task': {
        const i = +b.dataset.i, gone = d.tasks[i] && d.tasks[i].key;
        d.tasks.splice(i, 1);
        for (const t of d.tasks) t.deps = t.deps.filter((k) => k !== gone);
        break;
      }
      case 'reset-tab': this.resetTab(); break;
      case 'toggle-req': this.showReq = !this.showReq; break;
      case 'estimate': this.estimate(); return;
      case 'save-sim': this.save(true); return;
      default: return;
    }
    this.renderSide();
    this.renderPane();
  }
  /** Put the current tab's settings back to the template's defaults (at the draft's scale). */
  resetTab() {
    const d = this.draft, z = defaultSpec(d.template, d.scale);
    switch (this.tab) {
      case 'mission': d.objective = z.objective; d.seed = z.seed; break;
      case 'agents':
        for (const r of ROLE_KEYS) Object.assign(d.roles[r], { max: null, tps: z.roles[r].tps, toolP: z.roles[r].toolP, goal: z.roles[r].goal });
        d.orchestrator.tps = z.orchestrator.tps;
        d.maxActive = null;
        d.policy.spawnPerSec = z.policy.spawnPerSec;
        d.policy.idleReleaseMs = z.policy.idleReleaseMs;
        break;
      case 'models':
        d.models = z.models;
        d.tools = z.tools;
        d.orchestrator.model = z.orchestrator.model;
        for (const r of ROLE_KEYS) Object.assign(d.roles[r], { model: z.roles[r].model, localModel: z.roles[r].localModel, tools: z.roles[r].tools });
        break;
      case 'compute': d.regions = z.regions; d.budget = z.budget; d.policy.computeMult = z.policy.computeMult; break;
      case 'tasks': d.tasks = z.tasks; break;
      case 'failure': for (const k of ['toolErr', 'slow', 'crash', 'maxRetries']) d.policy[k] = z.policy[k]; break;
      case 'live': d.live = z.live; break;
    }
  }
  async save(thenSimulate) {
    const v = validateSpec(this.draft);
    if (v.errors.length) { this.app.hud.toast(v.errors[0], 'bad'); return; }
    if (v.tooBig) { this.app.hud.toast('This swarm is ' + fmtKB(v.bytes) + ' — keep it under ' + fmtKB(SPEC_MAX_BYTES - SPEC_RESERVE) + ' so its runs can be recorded on it', 'bad'); return; }
    const d = this.draft;
    d.name = d.name.trim();
    d.objective = d.objective.trim();
    if (d.tasks) for (const t of d.tasks) t.title = t.title.trim() || t.key;
    for (const r of ROLE_KEYS) d.roles[r].goal = d.roles[r].goal.trim() || ROLE_GOALS[r];
    $('ed-save').disabled = true;
    let r = await this.app.library.save(d, { isNew: this.isNew });
    if (!r.ok && r.conflict) {
      // Someone else saved this swarm since it was opened here — another tab, another user. Never
      // overwrite that silently: say so, and let the user choose.
      const pick = await this.app.modal.confirm('This swarm changed somewhere else',
        'It was saved from another tab or by someone else since you opened it here. <b>Overwrite</b> replaces that version with yours; '
        + '<b>Save as a copy</b> keeps both; <b>Cancel</b> keeps editing — and nothing is lost either way.',
        { yes: 'Overwrite', alt: 'Save as a copy', no: 'Cancel', danger: true });
      if (pick === true) r = await this.app.library.save(d, { force: true });
      else if (pick === 'alt') {
        const c = deepCopy(d);
        Object.assign(c, { id: newSpecId(), name: (d.name + ' (mine)').slice(0, 80), created: Date.now(), runs: [], estimate: null });
        r = await this.app.library.save(c, { isNew: true });
      } else { $('ed-save').disabled = false; return; }
    }
    $('ed-save').disabled = false;
    if (!r.ok) { this.app.hud.toast(r.message, 'bad'); return; }
    this.orig = JSON.stringify(this.draft);
    this.app.hud.toast((this.isNew ? 'Created ' : 'Saved ') + d.name + (r.message ? ' — ' + r.message : ''), 'good');
    await this.close(true);
    if (thenSimulate) this.app.simulate(r.spec, { saved: true });
  }
  async estimate() {
    if (this.estJob) { this.estJob.signal.cancelled = true; return; }
    const job = (this.estJob = { progress: 0, signal: { cancelled: false } });
    let paint = 0;
    this.renderSide();
    const est = await estimateSpec(this.draft, {
      runs: ESTIMATE_RUNS, signal: job.signal,
      onProgress: (p) => { job.progress = p; const now = performance.now(); if (now - paint > 120) { paint = now; if (this.estJob === job) this.renderSide(); } },
    });
    if (this.estJob !== job) return; // closed, or another estimate replaced it
    this.estJob = null;
    if (est && this.draft) this.draft.estimate = est;
    if (this.draft) this.renderSide();
  }
  async loadPresets() {
    const r = await this.app.host.request('GET', '/api/v1/presets');
    this.presets = r.status === 200 && r.data && Array.isArray(r.data.presets) ? r.data.presets.filter((p) => p && typeof p.name === 'string' && RE_PRESET.test(p.name)) : [];
    if (this.isOpen() && this.tab === 'live') this.renderPane();
  }
  liveBuilt(d) {
    const name = d.live.roster === 'preset' ? d.live.preset : '';
    const doc = name ? this.app.presetCache.get(name) || null : null;
    if (name && !doc) this.app.presetDoc(name).then((x) => { if (x && this.isOpen() && this.tab === 'live') this.renderPane(); });
    return specToCrewRequest(d, doc);
  }

  /* ---- the side panel: estimate, checks, run ---- */
  renderSide() {
    const d = this.draft;
    if (!d) return;
    const v = (this.check = validateSpec(d));
    for (const b of $('ed-tabs').querySelectorAll('button')) b.querySelector('.n').textContent = v.tabs[b.dataset.tab] ? '●' : '';
    const e = d.estimate, row = (k, x) => '<div class=\"est-row\"><span>' + k + '</span><b>' + x + '</b></div>';
    let html = '<div class=\"ed-box\"><div class=\"panel-title\">COST ESTIMATE</div>';
    if (this.estJob) {
      html += row('Simulating ' + ESTIMATE_RUNS + ' runs…', Math.round(this.estJob.progress * 100) + '%')
        + '<div class=\"bar\" style=\"margin-top:6px\"><i style=\"width:' + (this.estJob.progress * 100).toFixed(1) + '%;background:var(--accent)\"></i></div>'
        + '<div class=\"ed-actions\"><button class=\"lbtn sm\" type=\"button\" data-act=\"estimate\">■ Stop</button></div>';
    } else if (e) {
      html += '<div class=\"est-big\">≈ ' + fmtCost(e.cost.p50) + '</div>'
        + row('range', fmtCost(e.cost.min) + ' – ' + fmtCost(e.cost.max)) + row('duration (p50)', fmtTime(e.durationMs.p50) + ' sim') + row('tokens (p50)', fmtTokens(e.tokens.p50))
        + row('peak agents', Math.round(e.peak.p50)) + row('failed tasks', e.failed.toFixed(1) + ' / run') + row('over budget', e.over + ' of ' + e.runs) + (e.stalled ? row('stalled', e.stalled + ' of ' + e.runs) : '')
        + (e.sig !== specSig(d) ? '<div class=\"est-stale\">Settings changed since this estimate.</div>' : '')
        + '<div class=\"ed-actions\"><button class=\"lbtn sm\" type=\"button\" data-act=\"estimate\"' + (v.errors.length ? ' disabled' : '') + '>Σ Estimate again</button></div>';
    } else {
      html += '<p class=\"note\" style=\"margin-top:0\">Runs the swarm headless ' + ESTIMATE_RUNS + ' times, on different seeds, and reports the spread of cost and duration. Nothing runs for real.</p>'
        + '<div class=\"ed-actions\"><button class=\"lbtn sm primary\" type=\"button\" data-act=\"estimate\"' + (v.errors.length ? ' disabled' : '') + '>Σ Estimate cost</button></div>';
    }
    html += '</div><div class=\"ed-box\"><div class=\"panel-title\">CHECKS</div><div class=\"chk-list\">'
      + v.errors.map((x) => '<div class=\"e\">✕ ' + escapeHtml(x) + '</div>').join('')
      + (v.tooBig ? '<div class=\"e\">✕ ' + fmtKB(v.bytes) + ' — the server keeps 32 KB per swarm, and ' + fmtKB(SPEC_RESERVE) + ' of that is kept for its run records.</div>' : '')
      + v.warnings.map((x) => '<div class=\"w\">⚠ ' + escapeHtml(x) + '</div>').join('')
      + (!v.errors.length && !v.tooBig && !v.warnings.length ? '<div class=\"ok\">✓ Ready to run</div>' : '') + '</div>'
      + row('tasks', v.taskCount + (v.fanout ? ' + ' + v.fanout + ' sub-tasks' : '')) + row('size', fmtKB(v.bytes) + ' of 32 KB') + '</div>';
    const be = this.app.library.backend();
    html += '<div class=\"ed-box\"><div class=\"ed-actions\" style=\"margin-top:0\"><button class=\"lbtn primary\" type=\"button\" data-act=\"save-sim\"' + (v.errors.length || v.tooBig ? ' disabled' : '') + '>▶ Save &amp; simulate</button></div>'
      + '<p class=\"note\">Saved swarms are kept ' + (be === 'server' ? 'on this agnostic server, in your tenant.' : be === 'browser' ? 'in this browser.' : 'for this session only.') + '</p></div>';
    $('ed-side').innerHTML = html;
    $('ed-save').disabled = v.errors.length > 0 || v.tooBig;
  }

  /* ---- the tabs ---- */
  paneMission(d) {
    const T = TEMPLATES[d.template] || TEMPLATES.custom, v = this.check || validateSpec(d);
    const roles = [...new Set(specTasks(d).map((t) => t.role))].map((r) => ROLES[r].label).join(', ');
    return '<h4>MISSION</h4><div class=\"frm\">'
      + '<label>Objective</label><textarea data-k=\"objective\" data-t=\"str\" maxlength=\"400\" rows=\"3\" spellcheck=\"false\">' + escapeHtml(d.objective) + '</textarea>'
      + '<label>Template</label><div><b>' + T.icon + ' ' + escapeHtml(T.name) + '</b><span class=\"hint\">' + (d.tasks ? 'tasks customized' : 'tasks generated by the template') + '</span></div>'
      + '<label>Seed</label><div>' + edNum('seed', d.seed, { t: 'int', min: 1, max: 2147483647, step: 1 }) + ' <button class=\"lbtn sm\" type=\"button\" data-act=\"reseed\">⚄ New seed</button><span class=\"hint\">the same seed plays out the same way</span></div>'
      + '<label>Workload scale</label><div>' + edSel('scale', d.scale, [[1, '1× — normal'], [2, '2× — large'], [3, '3× — stress']], { t: 'scale' })
      + '<span class=\"hint\">' + (d.tasks ? 'custom tasks keep their size; caps, budget and spawn rate still scale' : 'more generated work; caps, budget and spawn rate scale with it') + '</span></div>'
      + '</div><p class=\"note\">' + v.taskCount + ' tasks' + (v.fanout ? ', fanning out into ' + v.fanout + ' sub-tasks' : '') + ' · ' + escapeHtml(roles) + '. ' + escapeHtml(T.desc) + '</p>';
  }
  paneAgents(d) {
    const used = new Set(specTasks(d).map((t) => t.role));
    let rows = '<tr><td>' + roleCell('orchestrator') + '</td><td class=\"ro\">1 · at HQ</td><td>' + edNum('orchestrator|tps', d.orchestrator.tps, { min: 1, max: 20000, cls: 'w-sm' }) + '</td><td class=\"ro\">—</td><td class=\"ro\">plans, staffs and monitors</td></tr>';
    for (const r of ROLE_KEYS) {
      const R = d.roles[r];
      rows += '<tr><td>' + roleCell(r) + (used.has(r) ? '' : '<span class=\"hint\">no tasks</span>') + '</td>'
        + '<td>' + edNum('roles|' + r + '|max', R.max, { t: 'optint', min: 1, max: 5000, step: 1, cls: 'w-sm', ph: 'no cap' }) + '</td>'
        + '<td>' + edNum('roles|' + r + '|tps', R.tps, { min: 1, max: 20000, cls: 'w-sm' }) + '</td>'
        + '<td>' + edNum('roles|' + r + '|toolP', R.toolP, { t: 'pct', min: 0, max: 100, step: 1, cls: 'w-sm', show: pctShow }) + ' %</td>'
        + '<td class=\"grow\">' + edText('roles|' + r + '|goal', R.goal, { max: 300 }) + '</td></tr>';
    }
    return '<h4>ROLES</h4><div class=\"tbl-wrap\"><table class=\"etbl\"><tr><th>ROLE</th><th>MAX AT ONCE</th><th>TOKENS / S</th><th>TOOL USE</th><th>GOAL — SENT TO A LIVE CREW</th></tr>' + rows + '</table></div>'
      + '<p class=\"note\"><b>Max at once</b> caps how many agents of a role work at the same time — a lead waiting on its own sub-agents does not count against it; empty means no cap beyond the regions. '
      + '<b>Tokens/s</b> is thinking speed before the model’s speed factor. <b>Tool use</b> is the chance an agent reaches for a tool at each step.</p>'
      + '<h4>SWARM</h4><div class=\"frm\">'
      + '<label>Max agents at once</label><div>' + edNum('maxActive', d.maxActive, { t: 'optint', min: 1, max: 5000, step: 1, ph: 'no cap' }) + '<span class=\"hint\">across every role and region</span></div>'
      + '<label>Spawn rate</label><div>' + edNum('policy|spawnPerSec', d.policy.spawnPerSec, { min: 0.1, max: 200, step: 0.5 }) + '<span class=\"hint\">new agents per second, at most</span></div>'
      + '<label>Release idle agents after</label><div>' + edNum('policy|idleReleaseMs', d.policy.idleReleaseMs, { t: 'sec', min: 0.2, max: 600, step: 0.5, show: (x) => x / 1000 }) + '<span class=\"hint\">seconds without work</span></div>'
      + '</div>';
  }
  paneModels(d) {
    const names = Object.keys(d.models), opts = names.map((m) => [m, m]);
    const usedBy = (m) => ['orchestrator', ...ROLE_KEYS].filter((r) => (r === 'orchestrator' ? d.orchestrator.model === m : d.roles[r].model === m || d.roles[r].localModel === m)).map((r) => ROLES[r].abbr);
    const cat = names.map((m) => '<tr><td>' + edText('models|' + m, m, { t: 'model-name', max: 40 }) + '</td>'
      + '<td>$ ' + edNum('models|' + m + '|price', d.models[m].price, { min: 0, max: 10, step: 0.0001 }) + '</td>'
      + '<td>' + edNum('models|' + m + '|tps', d.models[m].tps, { min: 0.05, max: 10, step: 0.05, cls: 'w-sm' }) + ' ×</td>'
      + '<td class=\"ro\">' + (usedBy(m).join(' ') || '—') + '</td><td><button class=\"x\" type=\"button\" data-act=\"del-model\" data-m=\"' + escapeHtml(m) + '\" title=\"Remove\">✕</button></td></tr>').join('');
    let who = '<tr><td>' + roleCell('orchestrator') + '</td><td>' + edSel('orchestrator|model', d.orchestrator.model, opts, { rr: true }) + '</td><td class=\"ro\">—</td></tr>';
    for (const r of ROLE_KEYS) {
      who += '<tr><td>' + roleCell(r) + '</td><td>' + edSel('roles|' + r + '|model', d.roles[r].model, opts, { rr: true }) + '</td><td>'
        + edSel('roles|' + r + '|localModel', d.roles[r].localModel, [['', '(same)'], ...opts], { rr: true }) + '</td></tr>';
    }
    let tools = '';
    for (const k of TOOL_KEYS) {
      const T = d.tools[k];
      tools += '<tr><td><span class=\"rl\"><i style=\"background:' + TOOL_KINDS[k].color + '\"></i>' + TOOL_KINDS[k].label + '</span></td><td>' + edChk('tools|' + k + '|on', T.on, { rr: true }) + '</td>'
        + '<td><span class=\"pair\">' + edNum('tools|' + k + '|ms|0', T.ms[0], { min: 10, max: 600000, step: 10, dis: !T.on }) + '–' + edNum('tools|' + k + '|ms|1', T.ms[1], { min: 10, max: 600000, step: 10, dis: !T.on }) + '</span></td>'
        + '<td><span class=\"pair\">' + edNum('tools|' + k + '|tokens|0', T.tokens[0], { min: 0, max: 1000000, step: 100, dis: !T.on }) + '–' + edNum('tools|' + k + '|tokens|1', T.tokens[1], { min: 0, max: 1000000, step: 100, dis: !T.on }) + '</span></td></tr>';
    }
    let mix = '';
    for (const r of ROLE_KEYS) {
      mix += '<tr><td>' + roleCell(r) + '</td>';
      for (const k of TOOL_KEYS) mix += '<td>' + edNum('roles|' + r + '|tools|' + k, d.roles[r].tools[k], { min: 0, max: 10, step: 1, cls: 'w-sm', dis: !d.tools[k].on }) + '</td>';
      mix += '</tr>';
    }
    return '<h4>MODEL CATALOGUE</h4><div class=\"tbl-wrap\"><table class=\"etbl\"><tr><th>MODEL</th><th>$ PER 1K TOKENS</th><th>SPEED</th><th>USED BY</th><th></th></tr>' + cat + '</table></div>'
      + '<div class=\"ed-actions\"><button class=\"lbtn sm\" type=\"button\" data-act=\"add-model\"' + (names.length >= SPEC_MAX_MODELS ? ' disabled' : '') + '>＋ Add model</button></div>'
      + '<p class=\"note\">Illustrative numbers: set them to your providers’ blended prices. <b>Speed</b> multiplies a role’s tokens per second.</p>'
      + '<h4>WHO USES WHICH MODEL</h4><div class=\"tbl-wrap\"><table class=\"etbl\"><tr><th>ROLE</th><th>MODEL</th><th>ON LOCAL</th></tr>' + who + '</table></div>'
      + '<p class=\"note\"><b>On Local</b> swaps in another model for agents running on your machine — by default the runners use local-8b there.</p>'
      + '<h4>TOOLS</h4><div class=\"tbl-wrap\"><table class=\"etbl\"><tr><th>TOOL</th><th>ON</th><th>LATENCY (MS)</th><th>TOKENS PER CALL</th></tr>' + tools + '</table></div>'
      + '<h4>TOOL MIX PER ROLE</h4><div class=\"tbl-wrap\"><table class=\"etbl\"><tr><th>ROLE</th>' + TOOL_KEYS.map((k) => '<th>' + TOOL_KINDS[k].label.toUpperCase() + '</th>').join('') + '</tr>' + mix + '</table></div>'
      + '<p class=\"note\">Relative weights: an agent reaching for a tool picks one in proportion; 0 means never.</p>';
  }
  paneCompute(d) {
    const base = new Map(buildWorld(1).territories.map((t) => [t.id, t]));
    let rows = '', cap = 0, burn = 0;
    for (const id of REGION_IDS) {
      const R = d.regions[id], B = base.get(id), on = regionOn(d, id), off = id !== 'local' && !R.on;
      if (on) { cap += R.cap; burn += R.cap * R.costPerSec; }
      rows += '<tr><td><span class=\"rl\"><i style=\"background:' + (B.kind === 'local' ? 'var(--local)' : 'var(--cloud)') + '\"></i>' + escapeHtml(B.name) + '</span><span class=\"hint\">' + escapeHtml(B.region) + '</span></td>'
        + '<td>' + (id === 'local' ? '<span class=\"ro\">always</span>' : edChk('regions|' + id + '|on', R.on, { rr: true })) + '</td>'
        + '<td>' + edNum('regions|' + id + '|cap', R.cap, { t: 'int', min: id === 'local' ? 1 : 0, max: 5000, step: 1, cls: 'w-sm', dis: off }) + '</td>'
        + '<td>$ ' + edNum('regions|' + id + '|costPerSec', R.costPerSec, { min: 0, max: 10, step: 0.00001, dis: off }) + '</td>'
        + '<td>' + edNum('regions|' + id + '|speed', R.speed, { min: 0.05, max: 10, step: 0.05, cls: 'w-sm', dis: off }) + ' ×</td>'
        + '<td class=\"ro\">' + (id === 'local' ? '—' : (B.latencyMs.local || '?') + ' ms') + '</td></tr>';
    }
    return '<h4>BUDGET</h4><div class=\"frm\">'
      + '<label>Mission budget</label><div>$ ' + edNum('budget', d.budget, { min: 0.01, max: 1000000, step: 0.5 }) + '<span class=\"hint\">the top bar drains it; the estimate counts runs that overspend</span></div>'
      + '<label>Compute price ×</label><div>' + edNum('policy|computeMult', d.policy.computeMult, { min: 0, max: 100, step: 0.1, cls: 'w-sm' }) + '<span class=\"hint\">multiplies every region’s per-second price</span></div>'
      + '</div><h4>REGIONS</h4><div class=\"tbl-wrap\"><table class=\"etbl\"><tr><th>REGION</th><th>ON</th><th>AGENT CAP</th><th>$ PER AGENT-SECOND</th><th>SPEED</th><th>LATENCY</th></tr>' + rows + '</table></div>'
      + '<p class=\"note\">Capacity <b>' + cap + ' agents</b> across the regions that are on · compute at full use costs <b>' + fmtCost(burn * d.policy.computeMult * 60) + '/min</b> before tokens. '
      + 'Tasks placed in a region that is off run on Local. <b>Speed</b> scales how fast agents there get through work.</p>';
  }
  paneTasks(d) {
    const T = TEMPLATES[d.template] || TEMPLATES.custom;
    if (!d.tasks) {
      const list = specTasks(d);
      const rows = list.map((t) => '<tr><td class=\"ro\">' + escapeHtml(t.key) + '</td><td>' + escapeHtml(t.title) + '</td><td class=\"ro\">' + ROLES[t.role].label + '</td><td class=\"ro\">' + escapeHtml(t.territory)
        + '</td><td class=\"ro\">' + escapeHtml((t.deps || []).join(', ') || '—') + '</td><td class=\"ro\">' + t.work + '</td><td class=\"ro\">' + (t.fanout ? t.fanout.titles.length : '—') + '</td></tr>').join('');
      return '<h4>TASKS — GENERATED</h4><p class=\"note\" style=\"margin:0 0 8px\">The ' + escapeHtml(T.name) + ' template generates these ' + list.length + ' tasks for seed ' + d.seed + ' at ' + d.scale + '×; another seed or scale generates another set. Customize them to edit, add or remove tasks.</p>'
        + '<div class=\"ed-actions\" style=\"margin:0 0 10px\"><button class=\"lbtn sm primary\" type=\"button\" data-act=\"customize\">✎ Customize tasks</button></div>'
        + '<div class=\"tbl-wrap\"><table class=\"etbl\"><tr><th>KEY</th><th>TITLE</th><th>ROLE</th><th>REGION</th><th>AFTER</th><th>WORK</th><th>FAN-OUT</th></tr>' + rows + '</table></div>';
    }
    const roleOpts = ROLE_KEYS.map((r) => [r, ROLES[r].label]), regionOpts = REGION_IDS.map((id) => [id, id === 'local' ? 'Local' : id]);
    const kindOpts = TASK_KIND_LIST.map((k) => [k, k]), priOpts = [1, 2, 3, 4].map((p) => [p, PRIORITY_LABELS[p]]);
    const rows = d.tasks.map((t, i) => '<tr>'
      + '<td>' + edText('tasks|' + i + '|key', t.key, { t: 'key', cls: 'w-sm', max: 32 }) + '</td>'
      + '<td class=\"grow\">' + edText('tasks|' + i + '|title', t.title, { max: 160 }) + '</td>'
      + '<td>' + edSel('tasks|' + i + '|role', t.role, roleOpts) + '</td>'
      + '<td>' + edSel('tasks|' + i + '|region', t.region, regionOpts) + '</td>'
      + '<td>' + edText('tasks|' + i + '|deps', t.deps.join(', '), { t: 'deps', cls: 'w-sm', ph: '—' }) + '</td>'
      + '<td>' + edNum('tasks|' + i + '|work', t.work, { min: 0.5, max: 3600, step: 0.5, cls: 'w-sm' }) + '</td>'
      + '<td>' + edSel('tasks|' + i + '|kind', t.kind, kindOpts) + '</td>'
      + '<td>' + edSel('tasks|' + i + '|priority', t.priority, priOpts, { t: 'selnum' }) + '</td>'
      + '<td>' + edNum('tasks|' + i + '|fanout', t.fanout ? t.fanout.count : 0, { t: 'fan', min: 0, max: 40, step: 1, cls: 'w-sm' }) + '</td>'
      + '<td>' + edNum('tasks|' + i + '|rework', t.rework ? t.rework.chance : 0, { t: 'rework', min: 0, max: 100, step: 1, cls: 'w-sm', show: pctShow }) + '</td>'
      + '<td><button class=\"x\" type=\"button\" data-act=\"del-task\" data-i=\"' + i + '\" title=\"Remove\">✕</button></td></tr>').join('');
    return '<h4>TASKS</h4><div class=\"tbl-wrap\"><table class=\"etbl tasks\"><tr><th>KEY</th><th>TITLE</th><th>ROLE</th><th>REGION</th><th>AFTER</th><th>WORK S</th><th>KIND</th><th>PRIORITY</th><th>FAN-OUT</th><th>REWORK %</th><th></th></tr>' + rows + '</table></div>'
      + '<div class=\"ed-actions\"><button class=\"lbtn sm\" type=\"button\" data-act=\"add-task\"' + (d.tasks.length >= SPEC_MAX_TASKS ? ' disabled' : '') + '>＋ Add task</button>'
      + (d.template !== 'custom' ? '<button class=\"lbtn sm\" type=\"button\" data-act=\"revert-tasks\">↺ Back to generated tasks</button>' : '') + '</div>'
      + '<p class=\"note\"><b>After</b> lists the keys a task waits for. <b>Work</b> is agent-seconds at speed 1×. <b>Fan-out</b> splits a task across that many sub-agents of its role once its lead is halfway through; '
      + '<b>rework</b> is the chance a review sends the work back to a coder.</p>';
  }
  paneFailure(d) {
    const P = d.policy;
    return '<h4>FAILURE MODEL</h4><div class=\"frm\">'
      + '<label>Tool errors</label><div>' + edNum('policy|toolErr', P.toolErr, { t: 'pct', min: 0, max: 95, step: 0.5, show: pctShow }) + ' %<span class=\"hint\">of tool calls fail — rate limits, timeouts, red tests; slow calls fail twice as often</span></div>'
      + '<label>Slow cloud calls</label><div>' + edNum('policy|slow', P.slow, { t: 'pct', min: 0, max: 95, step: 0.5, show: pctShow }) + ' %<span class=\"hint\">of cloud tool calls take 3–5× longer</span></div>'
      + '<label>Crashes</label><div>' + edNum('policy|crash', P.crash, { t: 'pct', min: 0, max: 90, step: 0.1, show: pctShow }) + ' %<span class=\"hint\">chance per ~3 s of work that an agent dies, × the task’s difficulty</span></div>'
      + '<label>Retries per task</label><div>' + edNum('policy|maxRetries', P.maxRetries, { t: 'int', min: 0, max: 10, step: 1, cls: 'w-sm' }) + '<span class=\"hint\">respawns after a crash before the task fails</span></div>'
      + '</div><p class=\"note\">An error costs the agent health and a crash at zero. A crash loses part of the task’s progress — most of it on fragile tasks (difficulty over 3).</p>';
  }
  paneLive(d) {
    const h = this.app.host, built = this.liveBuilt(d), R = built.request;
    const presetOpts = (this.presets || []).map((p) => [p.name, p.name + (Number.isInteger(p.agent_count) ? ' · ' + p.agent_count + ' agents' : '')]);
    let html = '<h4>ROSTER</h4><div class=\"radio-row\">'
      + '<label><input type=\"radio\" name=\"ed-roster\" value=\"roles\" data-k=\"live|roster\" data-t=\"roster\" data-rr=\"1\"' + (d.live.roster === 'roles' ? ' checked' : '') + '> One agent per role the tasks use, with the goals from the Agents tab</label>'
      + '<label><input type=\"radio\" name=\"ed-roster\" value=\"preset\" data-k=\"live|roster\" data-t=\"roster\" data-rr=\"1\"' + (d.live.roster === 'preset' ? ' checked' : '') + (h.can('presets:read') ? '' : ' disabled') + '> A preset’s agents '
      + (this.presets ? edSel('live|preset', d.live.preset, [['', '— choose a preset —'], ...presetOpts], { rr: true, dis: d.live.roster !== 'preset' }) : '<span class=\"hint\">' + (h.can('presets:read') ? 'loading presets…' : 'needs agnostic') + '</span>')
      + '</label></div>';
    html += '<h4>PROCESS</h4><div class=\"frm\"><label>Process</label><div>'
      + edSel('live|process', d.live.process, [['auto', 'Auto — a DAG when tasks have dependencies'], ['sequential', 'Sequential — one task at a time, in order'], ['parallel', 'Parallel — every task at once, ignoring dependencies'], ['dag', 'DAG — follows the dependencies']], { rr: true })
      + '</div><label>Max concurrency</label><div>' + edNum('live|maxConcurrency', d.live.maxConcurrency, { t: 'int', min: 1, max: 64, step: 1, cls: 'w-sm', dis: R.process !== 'parallel' }) + '<span class=\"hint\">' + (R.process === 'dag' ? 'a DAG runs each wave of ready tasks all at once — the engine applies no limit' : 'parallel only') + '</span></div></div>';
    if (d.live.roster === 'roles') {
      html += '<h4>LLM MODELS</h4><div class=\"tbl-wrap\"><table class=\"etbl\"><tr><th>ROLE</th><th>MODEL ID — OPTIONAL</th></tr>'
        + ROLE_KEYS.map((r) => '<tr><td>' + roleCell(r) + '</td><td class=\"grow\">' + edText('live|models|' + r, d.live.models[r] || '', { t: 'livemodel', ph: 'the server’s default model', max: 100 }) + '</td></tr>').join('')
        + '</table></div><p class=\"note\">Model ids your LLM gateway knows. The simulator’s catalogue is not sent.</p>';
    }
    html += '<h4>WHAT GETS SUBMITTED</h4><p class=\"note\" style=\"margin-top:0\">' + R.agents.length + ' agent' + (R.agents.length === 1 ? '' : 's') + ' and ' + R.tasks.length + ' tasks, process <b>' + R.process + '</b>'
      + (R.max_concurrency ? ' (' + R.max_concurrency + ' at a time)' : '') + '. Fan-out, rework, regions, caps, tools and the failure model shape only the simulator: a live crew runs these tasks with these agents on this agnostic server, which reports the tokens and cost the LLM gateway metered once the crew ends.</p>'
      + (d.live.roster === 'preset' && !d.live.preset ? '<p class=\"note\" style=\"color:#fcd34d\">Choose a preset — until then the roster is one agent per role.</p>' : '')
      + '<div class=\"ed-actions\"><button class=\"lbtn sm\" type=\"button\" data-act=\"toggle-req\">' + (this.showReq ? 'Hide' : 'Show') + ' the request</button></div>'
      + (this.showReq ? '<pre class=\"req\">' + escapeHtml(JSON.stringify(R, null, 2)) + '</pre>' : '');
    return html;
  }
}

/* =====================================================================================
 *  SECTION 7 · INPUT — mouse & keyboard → camera, selection, orders
 * ===================================================================================== */
class Input {
  constructor(app) {
    this.app = app;
    this.r = app.renderer;
    this.ui = app.ui;
    this.keys = new Set();
    this.mouse = { x: 0, y: 0, inside: false };
    this.drag = null;   // {button, x0, y0, lx, ly, mode:'pending'|'box'|'pan', shift, ctrl}
    this.mini = null;   // minimap drag
    this.lastClick = { t: 0, id: null };
    this.lastGroupTap = { n: -1, t: 0 };
    const c = this.r.canvas;
    c.addEventListener('mousedown', (e) => this.onDown(e));
    c.addEventListener('wheel', (e) => this.onWheel(e), { passive: false });
    c.addEventListener('contextmenu', (e) => e.preventDefault());
    window.addEventListener('mousemove', (e) => this.onMove(e));
    window.addEventListener('mouseup', (e) => this.onUp(e));
    document.documentElement.addEventListener('mouseleave', () => { this.mouse.inside = false; });
    window.addEventListener('keydown', (e) => this.onKey(e, true));
    window.addEventListener('keyup', (e) => this.onKey(e, false));
    window.addEventListener('blur', () => { this.keys.clear(); this.drag = null; this.ui.box = null; this.mouse.inside = false; });
    const m = this.r.minimap;
    m.addEventListener('mousedown', (e) => this.onMiniDown(e));
    m.addEventListener('contextmenu', (e) => e.preventDefault());
  }
  active() { return this.app.mode !== 'menu' && !this.app.overlayOpen(); }

  /** Per frame: keyboard + edge-of-screen panning. */
  update(dt) {
    if (!this.active()) return;
    const k = this.keys, sp = (950 * Math.min(dt, 50)) / 1000;
    let dx = 0, dy = 0;
    if (k.has('KeyW') || k.has('ArrowUp')) dy += sp;
    if (k.has('KeyS') || k.has('ArrowDown')) dy -= sp;
    if (k.has('KeyA') || k.has('ArrowLeft')) dx += sp;
    if (k.has('KeyD') || k.has('ArrowRight')) dx -= sp;
    const m = this.mouse, E = 6;
    if (m.inside && !this.mini && !(this.drag && this.drag.mode === 'pan') && document.hasFocus()) {
      if (m.x <= E) dx += sp; else if (m.x >= innerWidth - 1 - E) dx -= sp;
      if (m.y <= E) dy += sp; else if (m.y >= innerHeight - 1 - E) dy -= sp;
    }
    if (dx || dy) this.r.panBy(dx, dy);
  }

  onDown(e) {
    if (!this.active()) return;
    const x = e.clientX, y = e.clientY;
    this.mouse.inside = true;
    if (e.button === 1 || (e.button === 0 && e.altKey)) { this.drag = { button: e.button, x0: x, y0: y, lx: x, ly: y, mode: 'pan' }; e.preventDefault(); return; }
    if (e.button === 2) { this.drag = { button: 2, x0: x, y0: y, lx: x, ly: y, mode: 'pending' }; return; }
    if (e.button !== 0) return;
    if (this.ui.targeting) { this.app.confirmTarget(x, y); return; }
    this.drag = { button: 0, x0: x, y0: y, lx: x, ly: y, mode: 'pending', shift: e.shiftKey, ctrl: e.ctrlKey || e.metaKey };
  }
  onMove(e) {
    const x = e.clientX, y = e.clientY;
    this.mouse.x = x; this.mouse.y = y; this.mouse.inside = true;
    if (this.mini) { this.miniJump(e); return; }
    const d = this.drag;
    if (d) {
      if (d.mode === 'pending' && Math.hypot(x - d.x0, y - d.y0) > 5) d.mode = d.button === 0 ? 'box' : 'pan';
      if (d.mode === 'pan') { this.r.panBy(x - d.lx, y - d.ly); this.r.canvas.classList.add('panning'); }
      else if (d.mode === 'box') this.ui.box = { x0: d.x0, y0: d.y0, x1: x, y1: y };
      d.lx = x; d.ly = y;
      if (d.mode !== 'pending') this.app.hud.hideTooltip();
      return;
    }
    if (e.target === this.r.canvas && this.active()) this.hoverAt(x, y);
    else if (this.ui.hover) { this.ui.hover = null; this.app.hud.hideTooltip(); }
  }
  onUp(e) {
    if (this.mini) { this.mini = null; return; }
    const d = this.drag;
    if (!d || e.button !== d.button) return;
    this.drag = null;
    this.r.canvas.classList.remove('panning');
    const x = e.clientX, y = e.clientY;
    if (d.mode === 'box') {
      this.ui.box = null;
      this.app.select(this.r.unitsInBox(d.x0, d.y0, x, y), d.shift);
      return;
    }
    if (d.mode === 'pan') return;
    if (d.button === 2) {
      if (this.ui.targeting || this.ui.migrateMenu) this.app.cancelTargeting();
      else this.app.orderAt(x, y);
      return;
    }
    if (d.button === 0) this.click(x, y, d.shift, d.ctrl);
  }
  click(x, y, shift, ctrl) {
    const t = this.r.pickAt(x, y);
    const now = performance.now();
    if (t && t.kind === 'agent') {
      const dbl = this.lastClick.id === t.id && now - this.lastClick.t < 380;
      this.lastClick = { t: now, id: t.id };
      if ((dbl || ctrl) && t.id !== this.app.store.orchestratorId) this.app.selectRoleOnScreen(t.id, shift);
      else if (shift) this.app.toggleSelect(t.id);
      else this.app.select([t.id], false);
      return;
    }
    this.lastClick = { t: 0, id: null };
    if (!shift) this.app.inspect(t);
  }
  onWheel(e) {
    e.preventDefault();
    if (!this.active()) return;
    let dy = e.deltaY;
    if (e.deltaMode === 1) dy *= 16; else if (e.deltaMode === 2) dy *= 400;
    this.r.zoomAt(e.clientX, e.clientY, Math.exp(-dy * (e.ctrlKey ? 0.01 : 0.0017)));
  }
  hoverAt(x, y) {
    const t = this.r.pickAt(x, y);
    this.ui.hover = t;
    this.r.canvas.style.cursor = this.ui.targeting ? '' : t && t.kind !== 'territory' ? 'pointer' : '';
    if (t && t.kind !== 'territory') this.app.hud.showTooltip(t, x, y); else this.app.hud.hideTooltip();
  }
  /** Tooltip contents are live data — re-render them periodically while hovering. */
  refreshTooltip() {
    if (this.drag || !this.mouse.inside || !this.active()) return;
    const el = document.elementFromPoint(this.mouse.x, this.mouse.y);
    if (el === this.r.canvas) this.hoverAt(this.mouse.x, this.mouse.y);
  }

  onKey(e, down) {
    const tag = e.target && e.target.tagName;
    if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') { if (down && e.key === 'Escape') e.target.blur(); return; }
    const code = e.code;
    if (!down) { this.keys.delete(code); return; }
    if (!this.active()) return;
    if (!e.metaKey && !e.ctrlKey) this.keys.add(code);
    const app = this.app;
    if (/^Digit[1-9]$/.test(code)) {
      const n = +code.slice(5);
      if (e.ctrlKey || e.metaKey || e.altKey) { e.preventDefault(); app.setGroup(n, e.shiftKey); return; }
      const now = performance.now(), dbl = this.lastGroupTap.n === n && now - this.lastGroupTap.t < 380;
      this.lastGroupTap = { n, t: now };
      app.recallGroup(n, dbl);
      return;
    }
    if (e.metaKey || e.ctrlKey) return;
    switch (code) {
      case 'Space': e.preventDefault(); app.togglePause(); break;
      case 'Escape': app.escape(); break;
      case 'KeyT': app.command('assign'); break;
      case 'KeyR': app.command('recall'); break;
      case 'KeyP': app.command('pause'); break;
      case 'KeyC': app.command('duplicate'); break;
      case 'KeyM': app.command('migrate'); break;
      case 'KeyX': case 'Delete': app.command('terminate'); break;
      case 'KeyU': app.command('tool'); break;
      case 'KeyV': app.command('move'); break;
      case 'KeyZ': app.command('focus'); break;
      case 'KeyH': app.focusHQ(); break;
      case 'KeyF': this.r.fitAll(false, true); break;
      case 'KeyG': this.ui.fog = !this.ui.fog; app.hud.toast('Fog of war ' + (this.ui.fog ? 'on' : 'off')); break;
      case 'Equal': case 'NumpadAdd': app.stepSpeed(1); break;
      case 'Minus': case 'NumpadSubtract': app.stepSpeed(-1); break;
      case 'Slash': if (e.shiftKey) app.hud.toggleHelp(); break;
      default: return;
    }
  }

  onMiniDown(e) {
    if (!this.active()) return;
    const rect = this.r.minimap.getBoundingClientRect();
    if (e.button === 2) { const w = this.r.miniToWorld(e.clientX - rect.left, e.clientY - rect.top); this.app.orderAtWorld(w.x, w.y); return; }
    if (e.button !== 0) return;
    e.preventDefault();
    this.mini = { rect };
    this.miniJump(e);
  }
  miniJump(e) {
    const rect = this.mini.rect, w = this.r.miniToWorld(e.clientX - rect.left, e.clientY - rect.top);
    Object.assign(this.r.cam, { x: w.x, y: w.y, target: null });
    this.r.clampCam();
  }
}

/* =====================================================================================
 *  SECTION 8 · APP — wiring, main loop, live ⇄ replay switching
 *  The only place that knows concrete EventSource / CommandSink classes: simulate() pairs a
 *  MockSource with a MockCommandSink, startCrew() a LiveCrewSource with a LiveCommandSink, and
 *  enterReplay() a ReplaySource with a ReadOnlySink. Store, Layout, Visual, Renderer, HUD and Input
 *  never know which one they are looking at — the mission's `kind` only labels it.
 * ===================================================================================== */
class App {
  constructor() {
    this.ui = { selection: new Set(), hover: null, box: null, orders: [], fog: true, targeting: null, migrateMenu: false, inspect: null };
    this.groups = {};
    this.mode = 'menu';      // 'menu' | 'live' | 'replay' ('live' = a running mission, simulated or real)
    this.source = null;
    this.sink = new CommandSink();
    this.live = null;        // {source, sink, spec, kind: 'sim' | 'live', saved}
    this.recording = [];
    this.attract = false;
    this.host = new Host();
    this.library = new SwarmLibrary(this.host);
    this.presetCache = new Map();
    this.store = new Store();
    this.layout = new Layout();
    this.visual = new Visual(this.layout, () => (this.source ? this.source.now() : 0));
    this.store.onEvent((e, s) => this.visual.onEvent(e, s));
    this.renderer = new Renderer($('map'), $('minimap'), this.store, this.layout, this.visual, this.ui);
    this.store.onReset(() => { this.layout.reset(); this.visual.reset(); this.renderer.fogForce = true; });
    this.modal = new Modal();
    this.hud = new HUD(this);
    this.input = new Input(this);
    this.editor = new Editor(this);
    this.launcher = new Launcher(this);
    this.library.load();
    this.fps = { frames: 0, t: 0 };
    window.addEventListener('resize', () => this.renderer.resize());
    this.loop = this.loop.bind(this);
    requestAnimationFrame(this.loop);
  }
  overlayOpen() { return this.modal.isOpen() || this.editor.isOpen(); }
  /** Unit orders need a running mission whose source takes them — a live crew does not. */
  canCommand() { return this.mode === 'live' && !!this.source && this.source.capabilities.commands !== false; }

  /* ---------- sources ---------- */
  attach(source, sink) {
    if (this.unsub) this.unsub();
    this.source = source;
    this.sink = sink;
    this.unsub = source.subscribe((e) => this.store.apply(e));
  }
  /** Record everything `source` emits — kept apart from attach() so a live crew is still recorded while a replay is on screen. */
  record(source) {
    if (this.recUnsub) this.recUnsub();
    // Bounded: a long crew watched for hours must not grow the page without limit. Past the cap
    // the oldest half goes, and the replay starts later — said in the log rather than hidden.
    this.recUnsub = source.subscribe((e) => {
      this.recording.push(e);
      if (this.recording.length > RECORDING_MAX) {
        const keep = this.recording.slice(-Math.floor(RECORDING_MAX / 2));
        this.recording = [this.recording[0]].concat(keep); // the first event carries the world
        console.warn('[swarm] the recorded event log reached ' + RECORDING_MAX + ' events; its oldest half was dropped');
      }
    });
  }
  teardown() {
    if (this.unsub) { this.unsub(); this.unsub = null; }
    if (this.recUnsub) { this.recUnsub(); this.recUnsub = null; }
    if (this.source) this.source.stop();
    if (this.live && this.live.source !== this.source) this.live.source.stop();
    this.source = null;
    this.live = null;
    this.summaryAt = 0;
    this.summaryShown = false;
  }
  resetUI() {
    const ui = this.ui;
    ui.selection.clear(); ui.hover = null; ui.box = null; ui.targeting = null; ui.migrateMenu = false; ui.inspect = null; ui.orders = [];
    this.groups = {};
    this.hud.setHint(null);
    this.hud.hideTooltip();
    this.hud.selectionChanged();
  }
  /**
   * Simulate a swarm spec. `saved`: it is in the library, so the finished run is recorded on it.
   * `attract`: the demo that plays behind the launcher.
   */
  simulate(spec, { saved = false, seed = null, attract = false } = {}) {
    const s = deepCopy(spec);
    if (seed != null) s.seed = seed;
    const v = validateSpec(s);
    if (v.errors.length) { this.hud.toast(v.errors[0], 'bad'); return; }
    this.teardown();
    this.recording = [];
    this.store.reset();
    this.resetUI();
    const { sc, cfg } = compileSpec(s);
    const sim = new Sim(sc, { seed: s.seed, scale: s.scale, cfg });
    const source = new MockSource(sim);
    const sink = new MockCommandSink(sim);
    this.live = { source, sink, spec: s, kind: 'sim', saved: saved && !attract };
    this.attract = attract;
    this.attach(source, sink);
    if (!attract) this.record(source);
    this.mode = attract ? 'menu' : 'live';
    source.start();
    if (attract) source.setSpeed(2);
    this.hud.showStart(attract);
    this.hud.showSummary(null);
    this.hud.showReplayBar(false);
    this.renderer.fitAll(true, true);
    if (!attract) this.hud.toast('Simulating ' + s.name + ' · seed ' + s.seed, 'good');
  }
  /** Run the same swarm again: a simulation with the same seed (or a new one), or a crew submitted afresh. */
  runAgain(newSeed) {
    const l = this.live;
    if (!l) { this.showMenu(); return; }
    const spec = (l.saved && this.library.get(l.spec.id)) || l.spec;
    if (l.kind === 'live') { this.runLive(spec); return; }
    this.simulate(spec, { saved: l.saved, seed: newSeed ? 1 + Math.floor(Math.random() * 999999) : l.spec.seed });
  }
  /** Open the finished run's swarm in the editor — or, for a quick demo, as a new swarm to save. */
  editRunSpec() {
    const l = this.live;
    if (!l || !l.spec) return;
    const saved = this.library.get(l.spec.id);
    if (saved) this.editor.open(saved);
    else this.editor.open(l.spec, { isNew: true });
  }
  async showMenu() {
    const src = this.live && this.live.source;
    if (src instanceof LiveCrewSource && !src.finished && (src.crewId || src.status === 'submitting') && this.mode !== 'menu') {
      const ok = await this.modal.confirm('Leave this crew?', src.crewId
        ? 'It keeps running on agnostic — leaving only stops watching it. Its swarm’s card, and the Crews list, can watch it again.'
        : 'It is still being submitted. Leaving does not stop that: the crew is recorded on its swarm’s card either way.', { yes: 'Leave', no: 'Stay' });
      if (!ok) return;
    }
    this.hud.showReplayBar(false);
    this.hud.showSummary(null);
    const demo = defaultSpec('research', 1);
    demo.seed = 7 + Math.floor(Math.random() * 1000);
    this.simulate(demo, { attract: true }); // attract mode behind the launcher
  }

  /* ---------- live crews ---------- */
  async presetDoc(name) {
    if (this.presetCache.has(name)) return this.presetCache.get(name);
    if (!this.host.can('presets:read') || !RE_PRESET.test(name)) return null;
    const r = await this.host.request('GET', '/api/v1/presets/' + name);
    if (r.status !== 200 || !r.data || !Array.isArray(r.data.agents)) return null; // a failure is not cached
    this.presetCache.set(name, r.data);
    return r.data;
  }
  /** Submit a swarm to agnostic as a real crew — after saying plainly what that means. */
  async runLive(spec) {
    const h = this.host;
    if (!h.can('crews:write')) { this.hud.toast(h.mode === 'standalone' ? 'Open this view inside agnostic to run a live crew' : 'This plugin may not start crews here', 'bad'); return; }
    if (h.role() === 'viewer') { this.hud.toast('Your role (viewer) cannot start crews', 'bad'); return; }
    const v = validateSpec(spec);
    if (v.errors.length) { this.hud.toast(v.errors[0], 'bad'); return; }
    let preset = null;
    if (spec.live.roster === 'preset' && spec.live.preset) {
      preset = await this.presetDoc(spec.live.preset);
      if (!preset) { this.hud.toast('Could not load the preset ' + spec.live.preset, 'bad'); return; }
    }
    const built = specToCrewRequest(spec, preset), R = built.request;
    if (!R.tasks.length || !R.agents.length) { this.hud.toast('This swarm has nothing to submit', 'bad'); return; }
    if (R.tasks.length > 1000 || R.agents.length > 100) { this.hud.toast('agnostic takes at most 1000 tasks and 100 agents in a crew', 'bad'); return; }
    const ok = await this.modal.confirm('Run ' + spec.name + ' live?',
      'This submits a real crew to agnostic: <b>' + R.agents.length + ' agent' + (R.agents.length === 1 ? '' : 's') + '</b> and <b>' + R.tasks.length + ' tasks</b>, process <b>' + escapeHtml(R.process) + '</b>. '
      + 'With an LLM gateway configured every task is a real model call, and can cost money — the cost agnostic reports is shown when the crew ends.'
      + (spec.estimate ? ' The simulator estimated ≈ ' + fmtCost(spec.estimate.cost.p50) + ' for this swarm — a simulation, not a quote.' : ''), { yes: '⚡ Submit crew' });
    if (!ok) return;
    this.startCrew(spec, built, null);
  }
  /** Watch a crew a swarm started earlier — still running, or finished. Bound by the crew's own plan. */
  async watchRun(spec, crewId) {
    if (!this.host.can('crews:read') || !RE_CREW_ID.test(crewId || '')) { this.hud.toast('Open this view inside agnostic to watch a crew', 'bad'); return; }
    const preset = spec.live.roster === 'preset' && spec.live.preset ? await this.presetDoc(spec.live.preset) : null;
    // The swarm's current plan lends its titles and roles only if the crew's tasks are the same.
    this.startCrew(spec, specToCrewRequest(spec, preset), crewId.toLowerCase());
  }
  /** Watch any crew of this tenant — from the Crews list — whether or not one of these swarms started it. */
  watchCrew(crew) {
    const id = String(crew && crew.crew_id || '').toLowerCase();
    if (!RE_CREW_ID.test(id)) return;
    const owner = this.library.list().find((s) => s.runs.some((r) => r.kind === 'live' && r.crew === id));
    if (owner) { this.watchRun(owner, id); return; }
    const spec = defaultSpec('custom', 1);
    spec.name = typeof crew.name === 'string' && crew.name ? crew.name : 'Crew ' + id.slice(0, 8);
    spec.objective = '';
    this.startCrew(spec, null, id);
  }
  /**
   * Run or watch a crew. A run of a saved swarm is recorded on it BEFORE it is submitted, with the
   * idempotency key the submission carries — so leaving the view, a dropped answer or a closed tab
   * never loses the record of a crew that may be costing money.
   */
  startCrew(spec, built, crewId) {
    const s = deepCopy(spec);
    const saved = !!this.library.get(s.id);
    this.teardown();
    this.recording = [];
    this.store.reset();
    this.resetUI();
    const key = crewId ? null : 'sw-' + s.id + '-' + randomToken(12);
    const at = Date.now();
    if (!crewId && saved) {
      this.library.patch(s.id, (x) => { x.runs.push({ kind: 'live', at, status: 'submitting', key, engine: '' }); }, { touch: false });
    }
    const source = new LiveCrewSource(this.host, s, built, {
      crewId, idempotencyKey: key,
      onSubmitted: (id, engine, status) => {
        if (!saved) return;
        this.library.patch(s.id, (x) => {
          let r = x.runs.find((q) => q.kind === 'live' && q.key === key);
          if (!r) { r = { kind: 'live', at, key }; x.runs.push(r); }
          if (id) r.crew = id;
          r.status = status === 'pending' ? 'running' : status;
          r.engine = engine || r.engine || '';
        }, { touch: false });
      },
      onFinished: (status, sum) => { if (saved && (sum.crewId || key)) this.recordLive(s.id, sum, key); },
    });
    const sink = new LiveCommandSink();
    this.live = { source, sink, spec: s, kind: 'live', saved };
    this.attract = false;
    this.attach(source, sink);
    this.record(source);
    this.mode = 'live';
    source.start();
    this.hud.showStart(false);
    this.hud.showSummary(null);
    this.hud.showReplayBar(false);
    this.renderer.fitAll(true, true);
    this.hud.toast(crewId ? 'Watching crew ' + crewId.slice(0, 8) : 'Submitting ' + s.name + ' to agnostic…', 'good');
  }
  /** Record how a live crew ended on its swarm: status, counts, its real duration, and what agnostic metered. */
  recordLive(id, sum, key) {
    this.library.patch(id, (x) => {
      let r = x.runs.find((q) => q.kind === 'live' && ((sum.crewId && q.crew === sum.crewId) || (key && q.key === key)));
      if (!r) { r = { kind: 'live', at: Date.now() }; x.runs.push(r); }
      if (sum.crewId) r.crew = sum.crewId;
      Object.assign(r, { status: sum.status, engine: sum.engineMode || r.engine || '', done: sum.tasksDone, failed: sum.tasksFailed, total: sum.tasksDone + sum.tasksFailed });
      if (sum.timed) r.durationMs = Math.round(sum.durationMs);
      if (sum.tokensActual) r.tokens = sum.tokens; else delete r.tokens;
      if (sum.costMicro != null) r.costMicro = sum.costMicro; else delete r.costMicro;
    }, { touch: false });
  }
  recordSim(sum) {
    const l = this.live;
    if (!l || l.kind !== 'sim' || !l.saved) return;
    this.library.patch(l.spec.id, (x) => {
      x.runs.push({ kind: 'sim', at: Date.now(), status: 'complete', seed: l.spec.seed, cost: +sum.cost.toFixed(4), durationMs: Math.round(sum.durationMs), done: sum.tasksDone, failed: sum.tasksFailed, total: sum.tasksTotal });
    }, { touch: false });
  }
  async cancelCrew() {
    const src = this.live && this.live.source;
    if (!(src instanceof LiveCrewSource) || src.finished) return;
    if (!src.crewId) { this.hud.toast('The crew has not been accepted yet — wait for agnostic to answer', 'bad'); return; }
    const ok = await this.modal.confirm('Cancel this crew?', 'agnostic stops it: tasks that have not finished will not run.', { yes: 'Cancel crew', no: 'Keep it running', danger: true });
    if (!ok) return;
    const r = await src.cancel();
    this.hud.toast(r.message, r.ok ? 'good' : 'bad');
  }

  /* ---------- replay ---------- */
  enterReplay(fromStart) {
    if (!this.recording.length) { this.hud.toast('Nothing recorded yet', 'bad'); return; }
    if (this.mode === 'replay') return;
    const live = this.live;
    this.replayReturn = { wasPaused: live ? live.source.paused : true };
    if (live) live.source.setPaused(true);
    const rs = new ReplaySource(this.recording.slice());
    rs.onRewind = () => this.store.reset();
    this.store.reset();
    this.attach(rs, new ReadOnlySink());
    this.mode = 'replay';
    this.cancelTargeting();
    rs.start();
    rs.setSpeed(live ? live.source.speed : 1);
    if (fromStart) { rs.seek(0); rs.setPaused(false); } else { rs.seek(rs.duration); rs.setPaused(true); }
    this.hud.showReplayBar(true);
    this.hud.showSummary(null);
    this.hud.toast(fromStart ? 'Replaying the recorded event log' : 'Replay — drag the scrubber to rewind', 'good');
  }
  exitReplay() {
    if (this.mode !== 'replay') return;
    this.hud.showReplayBar(false);
    if (!this.live) { this.showMenu(); return; }
    const src = this.live.source;
    if (this.unsub) { this.unsub(); this.unsub = null; }
    this.source = src; // the visual clock must read live time while history is re-applied
    this.store.reset();
    for (const e of this.recording) this.store.apply(e);
    this.attach(src, this.live.sink); // the recorder never stopped
    this.mode = 'live';
    src.setPaused(this.replayReturn ? this.replayReturn.wasPaused : false);
    if (this.store.mission.status === 'complete') this.summaryShown = true;
  }
  seek(ms) { if (this.source && this.source.capabilities.seek) this.source.seek(ms); }
  exportLog() {
    if (!this.recording.length) { this.hud.toast('Nothing to export', 'bad'); return; }
    const m = this.store.mission;
    const crew = m.kind === 'live' && this.live && this.live.source.crewId;
    downloadText('swarm-' + (crew ? 'live-' + crew.slice(0, 8) : (m.scenario || 'log') + '-' + (m.seed || 0)) + '.json', JSON.stringify({
      format: 'swarm-command/event-log', version: 1, exportedAt: new Date().toISOString(),
      mission: { title: m.title, scenario: m.scenario, seed: m.seed, kind: m.kind || 'sim', crewId: crew || undefined }, events: this.recording }));
  }
  loadLogFile(file) {
    const reader = new FileReader();
    reader.onload = () => {
      try {
        const data = JSON.parse(reader.result);
        const events = Array.isArray(data) ? data : data && data.events;
        if (!Array.isArray(events) || !events.length) throw new Error('no events found');
        const bad = events.map(validateEvent).filter(Boolean);
        if (bad.length) throw new Error(bad.length + ' invalid events (first: ' + bad[0] + ')');
        events.sort((x, y) => x.timestamp - y.timestamp);
        this.teardown();
        this.store.reset();
        this.resetUI();
        this.recording = events;
        this.mode = 'live'; // so enterReplay proceeds; there is no live source to return to
        this.hud.showStart(false);
        this.enterReplay(true);
        this.renderer.fitAll(true, true);
      } catch (err) {
        this.hud.toast('Could not load log: ' + err.message, 'bad');
      }
    };
    reader.readAsText(file);
  }

  /* ---------- time ---------- */
  togglePause() {
    const s = this.source;
    if (!s || !s.capabilities.pause || this.mode === 'menu') return;
    if (this.mode === 'replay' && s.ended && s.paused) { s.seek(0); s.setPaused(false); return; }
    s.setPaused(!s.paused);
  }
  setSpeed(x) {
    const s = this.source;
    if (!s || !s.capabilities.speed || this.mode === 'menu') return;
    s.setSpeed(x);
    s.setPaused(false);
  }
  stepSpeed(d) {
    const steps = [1, 2, 4], s = this.source;
    if (s) this.setSpeed(steps[clamp(steps.indexOf(s.speed) + d, 0, steps.length - 1)]);
  }

  /* ---------- selection ---------- */
  controllable() {
    const out = [];
    for (const id of this.ui.selection) { const a = this.store.agents.get(id); if (a && a.alive && a.role !== 'orchestrator') out.push(id); }
    return out;
  }
  select(ids, add) {
    const sel = this.ui.selection;
    if (!add) sel.clear();
    for (const id of ids) sel.add(id);
    if (sel.size > 1 && this.store.orchestratorId) sel.delete(this.store.orchestratorId);
    this.ui.inspect = null;
    this.ui.migrateMenu = false;
    this.hud.selectionChanged();
  }
  toggleSelect(id) {
    const sel = this.ui.selection;
    if (sel.has(id)) sel.delete(id); else sel.add(id);
    if (sel.size > 1 && this.store.orchestratorId) sel.delete(this.store.orchestratorId);
    this.ui.inspect = null;
    this.hud.selectionChanged();
  }
  selectRoleOnScreen(id, add) {
    const a = this.store.agents.get(id);
    if (!a) return;
    const v = this.renderer.view, ids = [];
    for (const u of this.visual.units.values()) {
      if (!u.alive || u.orch || u.x < v.minX || u.x > v.maxX || u.y < v.minY || u.y > v.maxY) continue;
      const b = this.store.agents.get(u.id);
      if (b && b.role === a.role) ids.push(u.id);
    }
    this.select(ids, add);
    this.hud.toast('Selected ' + ids.length + ' ' + ROLES[a.role].label + (ids.length === 1 ? '' : 's') + ' on screen');
  }
  inspect(t) {
    this.ui.selection.clear();
    this.ui.inspect = !t || t.kind === 'agent' ? null : t.kind === 'marker' ? { kind: 'task', id: t.id } : t.kind === 'gateway' ? { kind: 'territory', id: t.id } : t;
    this.ui.migrateMenu = false;
    this.hud.selectionChanged();
  }
  pruneSelection() {
    const sel = this.ui.selection;
    if (!sel.size) return;
    let changed = false;
    for (const id of sel) {
      const a = this.store.agents.get(id);
      if (!a || (!a.alive && sel.size > 1)) { sel.delete(id); changed = true; }
    }
    if (changed) this.hud.selectionChanged();
  }
  setGroup(n, add) {
    const ids = this.controllable();
    if (!ids.length) { this.hud.toast('Select agents first, then Ctrl+' + n, 'bad'); return; }
    this.groups[n] = add && this.groups[n] ? [...new Set([...this.groups[n], ...ids])] : ids;
    this.hud.toast('Control group ' + n + ' ← ' + this.groups[n].length + ' agent' + (this.groups[n].length === 1 ? '' : 's'), 'good');
  }
  recallGroup(n, jump) {
    const g = (this.groups[n] || []).filter((id) => { const a = this.store.agents.get(id); return a && a.alive; });
    this.groups[n] = g;
    if (!g.length) { this.hud.toast('Group ' + n + ' is empty — Ctrl+' + n + ' (or Alt+' + n + ') stores the selection', 'bad'); return; }
    this.select(g, false);
    if (jump) this.focusSelection();
  }

  /* ---------- camera helpers ---------- */
  focusSelection() {
    let sx = 0, sy = 0, n = 0;
    for (const id of this.ui.selection) {
      const u = this.visual.units.get(id);
      if (u) { sx += u.x; sy += u.y; n++; }
    }
    const z = Math.max(this.renderer.cam.zoom, 0.55);
    if (n) { this.renderer.focus(sx / n, sy / n, z); return; }
    const ins = this.ui.inspect;
    if (!ins) return;
    const p = ins.kind === 'task' ? this.layout.tasks.get(ins.id) : ins.kind === 'tool' ? this.layout.tools.get(ins.id) : this.layout.terr.get(ins.id);
    if (p) this.renderer.focus(p.x, p.y, z);
  }
  focusHQ() { const c = this.layout.center(this.layout.hub); this.renderer.focus(c.x, c.y, Math.max(this.renderer.cam.zoom, 0.5)); }
  focusFeedItem(d) {
    const z = Math.max(this.renderer.cam.zoom, 0.65);
    const u = d.agentId && this.visual.units.get(d.agentId);
    if (u) {
      this.renderer.focus(u.x, u.y, z);
      if (d.agentId === this.store.orchestratorId || (this.store.agents.get(d.agentId) || {}).alive) this.select([d.agentId], false);
      return;
    }
    if (d.agentId && this.store.agents.has(d.agentId)) this.select([d.agentId], false); // show the (dead) agent's record
    const L = d.taskId && this.layout.tasks.get(d.taskId);
    if (L) { this.renderer.focus(L.x, L.y, z); if (!d.agentId) this.inspect({ kind: 'task', id: d.taskId }); return; }
    const T = d.toolId && this.layout.tools.get(d.toolId);
    if (T) { this.renderer.focus(T.x, T.y, z); if (!d.agentId) this.inspect({ kind: 'tool', id: d.toolId }); }
  }

  /* ---------- commands ---------- */
  command(id) {
    const ui = this.ui;
    if (id === 'focus') return this.focusSelection();
    if (this.mode !== 'live') { if (this.mode === 'replay') this.hud.toast('Replay is read-only — exit replay to issue orders', 'bad'); return; }
    if (!this.canCommand()) { this.hud.toast('A live crew takes no unit orders — Cancel crew is the one control agnostic has', 'bad'); return; }
    if (id === 'back') { this.cancelTargeting(); return; }
    const ids = this.controllable();
    if (!ids.length) { this.hud.toast('Select one or more agents first', 'bad'); return; }
    switch (id) {
      case 'assign': return this.toggleTargeting('assign_task', 'ASSIGN TASK — left-click a task on the map · Esc cancels');
      case 'tool': return this.toggleTargeting('use_tool', 'USE TOOL — left-click a tool structure · Esc cancels');
      case 'move': return this.toggleTargeting('move', 'MOVE — left-click a destination; units hold there · Esc cancels');
      case 'recall': return this.issue('recall');
      case 'pause': return this.issue(ids.every((x) => this.store.agents.get(x).state === 'paused') ? 'resume' : 'pause');
      case 'duplicate': return this.issue('duplicate');
      case 'terminate': return this.issue('terminate');
      case 'migrate':
        if (ui.migrateMenu) return this.cancelTargeting();
        this.cancelTargeting();
        ui.migrateMenu = true;
        this.hud.setHint('MIGRATE — pick a destination on the command card, or right-click a region gateway');
        this.hud.selectionChanged();
        return;
      default:
        if (id.startsWith('migrate:')) {
          const dest = id.slice(8);
          this.cancelTargeting();
          return this.issue('migrate', dest === 'auto' ? null : { kind: 'territory', id: dest }, dest === 'auto' ? null : this.layout.center(dest));
        }
    }
  }
  toggleTargeting(type, hint) {
    if (this.ui.targeting && this.ui.targeting.type === type) { this.cancelTargeting(); return; }
    this.cancelTargeting();
    this.ui.targeting = { type };
    this.hud.setHint(hint);
    this.renderer.canvas.classList.add('targeting');
    this.hud.selectionChanged();
  }
  cancelTargeting() {
    this.ui.targeting = null;
    this.ui.migrateMenu = false;
    this.hud.setHint(null);
    this.renderer.canvas.classList.remove('targeting');
    this.hud.selectionChanged();
  }
  escape() {
    if (!$('help').classList.contains('hidden')) { this.hud.toggleHelp(false); return; }
    if (this.ui.targeting || this.ui.migrateMenu) { this.cancelTargeting(); return; }
    if (this.ui.selection.size || this.ui.inspect) { this.ui.selection.clear(); this.ui.inspect = null; this.hud.selectionChanged(); }
  }
  confirmTarget(sx, sy) {
    const tg = this.ui.targeting;
    if (!tg) return;
    const t = this.renderer.pickAt(sx, sy), w = this.renderer.toWorld(sx, sy);
    if (tg.type === 'assign_task') {
      if (!t || (t.kind !== 'task' && t.kind !== 'marker')) { this.hud.toast('Pick a task (objective) on the map', 'bad'); return; }
      this.orderTarget({ kind: 'task', id: t.id }, w);
    } else if (tg.type === 'use_tool') {
      if (!t || t.kind !== 'tool') { this.hud.toast('Pick a tool structure on the map', 'bad'); return; }
      this.orderTarget(t, w);
    } else {
      this.issue('move', { kind: 'point', x: Math.round(w.x), y: Math.round(w.y), territory: this.layout.territoryAt(w.x, w.y) }, w);
    }
    this.cancelTargeting();
  }
  orderAt(sx, sy) {
    if (!this.controllable().length || !this.canCommand()) return;
    this.orderTarget(this.renderer.pickAt(sx, sy), this.renderer.toWorld(sx, sy));
  }
  orderAtWorld(x, y) {
    if (!this.controllable().length || !this.canCommand()) return;
    this.issue('move', { kind: 'point', x: Math.round(x), y: Math.round(y), territory: this.layout.territoryAt(x, y) }, { x, y });
  }
  /** Right-click semantics: task → assign · structure → use · HQ → rally home · gateway → migrate · ground → move & hold. */
  orderTarget(t, w) {
    if (t && (t.kind === 'task' || t.kind === 'marker')) return this.issue('assign_task', { kind: 'task', id: t.id }, this.layout.tasks.get(t.id));
    if (t && t.kind === 'tool') return this.issue('use_tool', { kind: 'tool', id: t.id }, this.layout.tools.get(t.id));
    if (t && t.kind === 'agent' && t.id === this.store.orchestratorId) {
      const c = this.layout.center(this.layout.hub);
      return this.issue('move', { kind: 'point', x: Math.round(c.x + 90), y: Math.round(c.y), territory: this.layout.hub }, c);
    }
    if (t && t.kind === 'gateway') return this.issue('migrate', { kind: 'territory', id: t.id }, this.layout.center(t.id));
    return this.issue('move', { kind: 'point', x: Math.round(w.x), y: Math.round(w.y), territory: this.layout.territoryAt(w.x, w.y) }, w);
  }
  issue(type, target, at) {
    const ids = this.controllable();
    if (!ids.length) { this.hud.toast('Select one or more agents first', 'bad'); return; }
    if (this.mode !== 'live') { this.hud.toast('Replay is read-only — exit replay to issue orders', 'bad'); return; }
    if (!this.canCommand()) { this.hud.toast('A live crew takes no unit orders', 'bad'); return; }
    if (at) this.ui.orders.push({ x: at.x, y: at.y, t0: performance.now(), color: ORDER_COLORS[type] || '#4ade80' });
    this.sink.send(makeCommand(type, ids, target)).then((res) => {
      this.hud.toast((res.ok ? '✓ ' : '✕ ') + (res.message || type), res.ok ? 'good' : 'bad');
      this.hud.selectionChanged();
    });
  }

  /* ---------- frame ---------- */
  loop(ts) {
    const dt = this.lastTs ? Math.min(100, ts - this.lastTs) : 16;
    this.lastTs = ts;
    try {
      if (this.source) this.source.update(dt);
      const now = this.source ? this.source.now() : 0;
      this.input.update(dt);
      this.visual.update(now);
      this.pruneSelection();
      this.renderer.draw(now, ts, dt);
      this.hud.update(now, ts);
      this.checkMissionEnd(ts);
      this.tickFps(ts);
    } catch (err) {
      console.error(err);
    }
    requestAnimationFrame(this.loop);
  }
  checkMissionEnd(ts) {
    if (this.summaryShown || this.store.mission.status !== 'complete' || !this.live || this.source !== this.live.source) return;
    if (!this.summaryAt) this.summaryAt = ts + (this.attract ? 4000 : 2200);
    if (ts < this.summaryAt) return;
    this.summaryShown = true;
    if (this.attract) { this.showMenu(); return; }
    const sum = this.store.summary();
    this.hud.showSummary(sum);
    this.recordSim(sum);
  }
  tickFps(ts) {
    const f = this.fps;
    f.frames++;
    if (ts - f.t < 500) return;
    let n = 0;
    for (const u of this.visual.units.values()) if (u.alive && !u.orch) n++;
    this.hud.setFps(Math.round((f.frames * 1000) / (ts - f.t)), n);
    f.frames = 0;
    f.t = ts;
  }
}

if (typeof document !== 'undefined' && document.getElementById('map')) {
  window.app = new App();
  window.app.showMenu();
}
</script>
</body>
</html>
";

# The `i`th page's bytes as a NUL-terminated C string, or 0 when `i` is out of range.
#
# A chain rather than a table because a `var` array of string literals has no
# spelling in Cyrius.
fn agnostic_webgui_asset_bytes(i): i64 {
    if (i == 0) { return _AGNOSTIC_WEBGUI_ASSET_00; }
    if (i == 1) { return _AGNOSTIC_WEBGUI_ASSET_01; }
    return 0;
}

# The `i`th page's length in bytes, as the generator counted it, or 0.
fn agnostic_webgui_asset_len(i): i64 {
    if (i == 0) { return 36729; }
    if (i == 1) { return 429829; }
    return 0;
}

# The SHA-256 of the `i`th page's source file, lowercase hex, or 0.
fn agnostic_webgui_asset_sha256(i): i64 {
    if (i == 0) { return "beea3daa33223a43ae256c406c10a9795338867d188700fe5f0fbc102946d44a"; }
    if (i == 1) { return "9c548705695a17699c31fba1e3cb6f41cfaf67f332ace713ee4ba870f09eb2ac"; }
    return 0;
}

# The `i`th page's source path, relative to `src/webgui/`, or 0.
fn agnostic_webgui_asset_path(i): i64 {
    if (i == 0) { return "index.html"; }
    if (i == 1) { return "plugins/swarm/index.html"; }
    return 0;
}

# The Content-Security-Policy the `i`th page is served with, or 0.
fn agnostic_webgui_asset_csp(i): i64 {
    if (i == 0) { return "default-src 'none'; script-src 'sha256-S1VrhLT2zvUHm4a9GnRHl9f5Aj52Gl6VWb4b16OBc/Q=' 'sha256-8iGTNXriYVDdoS1ptrHlMIzG3MozOu+U6J945PTq8Xw='; style-src 'unsafe-inline'; img-src data:; connect-src 'self'; frame-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"; }
    if (i == 1) { return "default-src 'none'; script-src 'sha256-pJ22yUUt/Y6jv8NXIrVo8Hkq3Eldzglcd2FGOYwzT8Q='; style-src 'unsafe-inline'; connect-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"; }
    return 0;
}

# The plugin permission vocabulary, `src/webgui/permissions.json`, as compact JSON:
# `{name: {grants, routes[]}}`. Parsed once at mount (`src/webgui/plugins.cyr`), which
# enforces it on every request a plugin makes (ADR 0007).
fn agnostic_webgui_permissions_json(): i64 {
    return "{\"storage\":{\"grants\":\"keep its own documents\",\"routes\":[\"GET /api/v1/plugins/:self/data\",\"GET /api/v1/plugins/:self/data/:key\",\"PUT /api/v1/plugins/:self/data/:key\",\"DELETE /api/v1/plugins/:self/data/:key\"]},\"presets:read\":{\"grants\":\"read the preset library\",\"routes\":[\"GET /api/v1/presets\",\"GET /api/v1/presets/:name\"]},\"definitions:read\":{\"grants\":\"read agent definitions\",\"routes\":[\"GET /api/v1/agents/definitions\",\"GET /api/v1/agents/definitions/:key\"]},\"crews:read\":{\"grants\":\"list crews and read their plans, progress and results\",\"routes\":[\"GET /api/v1/crews\",\"GET /api/v1/crews/:id\",\"GET /api/v1/crews/:id/events\",\"GET /api/v1/crews/:id/plan\"]},\"crews:write\":{\"grants\":\"start and cancel crews\",\"routes\":[\"POST /api/v1/crews\",\"POST /api/v1/crews/:id/cancel\"]}}";
}

# The `i`th plugin's manifest as compact JSON, or 0. `asset` is the page the
# generator resolved its `entry` to.
fn agnostic_webgui_plugin_manifest(i): i64 {
    if (i == 0) { return "{\"id\":\"swarm\",\"name\":\"Swarm Command\",\"description\":\"An RTS-style command view of an agent swarm: every unit is an agent, every objective a task, every structure a tool. Save swarms, simulate them or estimate their cost, run one as a live crew and see what it really cost, and watch any crew on this server. Each mission is labelled simulated or live.\",\"version\":\"0.3.0\",\"data\":\"mixed\",\"entry\":\"index.html\",\"permissions\":[\"storage\",\"presets:read\",\"crews:read\",\"crews:write\"],\"asset\":1}"; }
    return 0;
}
