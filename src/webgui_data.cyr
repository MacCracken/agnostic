    // A plugin's documents outlive switching it off, so Settings says what it keeps —
    // in this user's tenant — and lets anyone who may write clear it.
    const mayWrite = () => state.auth === 'off' || ['operator', 'admin', 'super_admin'].includes(store.get(ROLE_KEY));
    const dataPath = (p, key) => '/api/v1/plugins/' + encodeURIComponent(p.id) + '/data' + (key ? '/' + encodeURIComponent(key) : '');
    async function loadStored(p, node) {
      const r = await api('GET', dataPath(p));
      if (r.status !== 200 || !r.data || !Array.isArray(r.data.documents)) {
