<link rel=\"icon\" href=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath d='M8 1l7 7-7 7-7-7z' fill='%2339d0ff'/%3E%3C/svg%3E\">
<style>
:root {
  --bg: #060a0f;
  --panel: #0c131c;
  --panel-2: #111b27;
  --line: #1c2a38;
  --line-2: #2a3d50;
  --text: #d4e4f1;
  --dim: #7d93a8;
  --faint: #4b6075;
  --accent: #39d0ff;
  --ok: #22c55e;
  --warn: #f59e0b;
  --err: #ef4444;
  --sim: #a78bfa;
  --mono: ui-monospace, \"SF Mono\", SFMono-Regular, Menlo, Consolas, monospace;
  --sans: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Inter, Roboto, sans-serif;
  --top-h: 48px;
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); font: 13px/1.5 var(--sans); }
body { display: flex; flex-direction: column; }
button { font: inherit; color: inherit; cursor: pointer; }
button:focus-visible, input:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
a { color: var(--accent); }
[hidden] { display: none !important; }

.top { flex: none; height: var(--top-h); display: flex; align-items: stretch; background: linear-gradient(180deg, #0c131c, #080d13); border-bottom: 1px solid var(--line-2); }
.brand { display: flex; align-items: center; padding: 0 16px; font-weight: 700; letter-spacing: .14em; color: var(--accent); border-right: 1px solid var(--line); white-space: nowrap; }
.brand b { color: var(--text); margin-left: 6px; }
.tabs { display: flex; align-items: stretch; overflow-x: auto; min-width: 0; }
.tab { background: none; border: 0; border-bottom: 2px solid transparent; padding: 0 16px; color: var(--dim); white-space: nowrap; font-weight: 600; letter-spacing: .02em; }
.tab:hover { color: var(--text); }
.tab[aria-selected=\"true\"] { color: var(--text); border-bottom-color: var(--accent); }
.tab .dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--sim); margin-right: 7px; vertical-align: 2px; }
.spacer { flex: 1; }
.who { display: flex; align-items: center; gap: 10px; padding: 0 14px; color: var(--dim); font-size: 12px; white-space: nowrap; }

main { flex: 1; min-height: 0; overflow: auto; }
.view { max-width: 980px; margin: 0 auto; padding: 28px 20px 40px; }
.view.plugin { max-width: none; height: 100%; padding: 0; display: flex; flex-direction: column; }
h1 { font-size: 20px; margin: 0 0 4px; letter-spacing: .01em; }
h2 { font-size: 13px; margin: 0 0 12px; letter-spacing: .14em; color: var(--dim); text-transform: uppercase; }
.lede { color: var(--dim); margin: 0 0 24px; max-width: 70ch; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
.card { background: var(--panel); border: 1px solid var(--line-2); border-radius: 8px; padding: 18px; }
.card.stacked { margin-top: 16px; }
.kv { display: grid; grid-template-columns: 120px 1fr; gap: 6px 12px; font-size: 12.5px; }
.kv dt { color: var(--dim); }
.kv dd { margin: 0; font-family: var(--mono); overflow-wrap: anywhere; }
.pill { display: inline-block; font: 600 10.5px var(--mono); letter-spacing: .06em; padding: 2px 8px; border-radius: 10px; border: 1px solid var(--line-2); color: var(--dim); white-space: nowrap; }
.pill.ok { color: var(--ok); border-color: rgba(34, 197, 94, .45); }
.pill.bad { color: var(--err); border-color: rgba(239, 68, 68, .45); }
.pill.sim { color: var(--sim); border-color: rgba(167, 139, 250, .45); }
.list { list-style: none; margin: 0; padding: 0; }
.list li { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-top: 1px solid var(--line); }
.list li:first-child { border-top: 0; }
.list .name { font-weight: 600; }
.muted { color: var(--dim); }
.btn { background: #0f1823; border: 1px solid var(--line-2); border-radius: 5px; padding: 6px 12px; font: 600 12px var(--sans); }
.btn:hover { border-color: var(--accent); }
.btn.primary { background: #0e3346; border-color: var(--accent); color: var(--accent); }
.btn:disabled { opacity: .45; cursor: default; }

.plugin-row { display: grid; grid-template-columns: 1fr auto; gap: 6px 20px; align-items: center; padding: 16px 0; border-top: 1px solid var(--line); }
.plugin-row:first-of-type { border-top: 0; }
.plugin-row .title { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.plugin-row .desc { grid-column: 1; color: var(--dim); max-width: 64ch; }
.plugin-row .perms { grid-column: 1; color: var(--faint); font-size: 12px; }
.plugin-row .stored { grid-column: 1; color: var(--faint); font-size: 12px; display: flex; align-items: center; gap: 10px; }
.btn.small { padding: 2px 9px; font-size: 11px; }
.switch { position: relative; width: 42px; height: 24px; border-radius: 12px; border: 1px solid var(--line-2); background: #142030; padding: 0; transition: background .15s, border-color .15s; }
.switch::after { content: \"\"; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: var(--dim); transition: transform .15s, background .15s; }
.switch[aria-checked=\"true\"] { background: #0e3346; border-color: var(--accent); }
.switch[aria-checked=\"true\"]::after { transform: translateX(18px); background: var(--accent); }
.switch:disabled { opacity: .45; cursor: default; }

.plugin-bar { flex: none; display: flex; align-items: center; gap: 10px; padding: 8px 14px; background: var(--panel-2); border-bottom: 1px solid var(--line-2); font-size: 12px; }
.plugin-bar .name { font-weight: 700; }
.frame { flex: 1; min-height: 0; width: 100%; border: 0; background: #000; display: block; }

.overlay { position: fixed; inset: 0; background: rgba(3, 6, 10, .82); display: flex; align-items: center; justify-content: center; z-index: 20; }
.dialog { width: min(380px, 92vw); background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 10px; padding: 22px; }
.dialog label { display: block; color: var(--dim); font-size: 12px; margin: 12px 0 4px; }
.dialog input { width: 100%; background: #0b131c; color: var(--text); border: 1px solid var(--line-2); border-radius: 5px; padding: 8px 10px; font: inherit; }
.dialog .row { display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px; }
.dialog .error { color: var(--err); min-height: 1.5em; margin-top: 10px; font-size: 12px; }
#toast { position: fixed; right: 16px; bottom: 16px; max-width: min(420px, 90vw); background: var(--panel-2); border: 1px solid var(--line-2); border-radius: 6px; padding: 10px 14px; opacity: 0; transform: translateY(8px); transition: opacity .2s, transform .2s; pointer-events: none; z-index: 30; }
#toast.show { opacity: 1; transform: none; }
#toast.bad { border-color: var(--err); }
@media (max-width: 640px) { .brand { padding: 0 10px; letter-spacing: .08em; } .tab { padding: 0 10px; } .kv { grid-template-columns: 96px 1fr; } }
</style>
</head>
<body>
<header class=\"top\">
  <div class=\"brand\">◈<b>AGNOSTIC</b></div>
  <nav class=\"tabs\" id=\"tabs\" role=\"tablist\" aria-label=\"Views\"></nav>
  <div class=\"spacer\"></div>
  <div class=\"who\" id=\"who\"></div>
</header>

<main id=\"main\">
  <section class=\"view\" id=\"view-overview\" hidden>
    <h1>Overview</h1>
    <p class=\"lede\">This server's state, and the views it can show. Views are plugins built into
      the binary; an administrator switches them on in Settings.</p>
    <div class=\"cards\">
      <div class=\"card\">
        <h2>Server</h2>
        <dl class=\"kv\" id=\"server-kv\"></dl>
      </div>
      <div class=\"card\">
        <h2>Views</h2>
        <ul class=\"list\" id=\"views-list\"></ul>
      </div>
    </div>
  </section>

  <section class=\"view\" id=\"view-settings\" hidden>
    <h1>Settings</h1>
    <p class=\"lede\">Settings apply to the whole deployment and are kept in its database, so they
      survive a restart. Changing one needs the administrator role and is recorded in the audit trail.</p>
    <div class=\"card\">
      <h2>Plugins</h2>
      <div id=\"plugin-rows\"></div>
    </div>
    <div class=\"card stacked\">
      <h2>Session</h2>
      <div id=\"session-info\"></div>
    </div>
  </section>

  <section class=\"view plugin\" id=\"view-plugin\" hidden>
    <div class=\"plugin-bar\">
      <span class=\"name\" id=\"plugin-name\"></span>
      <span class=\"pill\" id=\"plugin-version\"></span>
      <span class=\"pill sim\" id=\"plugin-sim\" hidden>SIMULATED DATA</span>
      <span class=\"spacer\"></span>
      <a id=\"plugin-newtab\" target=\"_blank\" rel=\"noopener noreferrer\">Open in a new tab</a>
      <button class=\"btn\" id=\"plugin-reload\" type=\"button\">Reload</button>
    </div>
    <iframe class=\"frame\" id=\"plugin-frame\" title=\"Plugin view\" sandbox=\"allow-scripts allow-downloads\" referrerpolicy=\"no-referrer\"></iframe>
  </section>
</main>

<div class=\"overlay\" id=\"signin\" hidden>
  <form class=\"dialog\" id=\"signin-form\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"signin-title\" novalidate>
    <h1 id=\"signin-title\">Sign in</h1>
    <p class=\"muted\" id=\"signin-why\">This server requires authentication.</p>
    <label for=\"signin-email\">Email</label>
    <input id=\"signin-email\" type=\"email\" autocomplete=\"username\" spellcheck=\"false\">
    <label for=\"signin-password\">Password</label>
    <input id=\"signin-password\" type=\"password\" autocomplete=\"current-password\">
    <div class=\"error\" id=\"signin-error\" role=\"alert\"></div>
    <div class=\"row\">
      <button class=\"btn\" id=\"signin-cancel\" type=\"button\">Cancel</button>
      <button class=\"btn primary\" id=\"signin-go\" type=\"submit\">Sign in</button>
    </div>
  </form>
</div>

<div id=\"toast\" role=\"status\" aria-live=\"polite\"></div>

<script>
  'use strict';
  // The plugin host bridge's gate (ADR 0005, ADR 0007): pure functions, no DOM and no state,
  // so they run in Node as well (tests/webgui/shell.test.mjs). The app script below holds the
  // state, makes the calls and answers the frame.
  //
  // What a plugin may ask for is the SERVER's catalogue — `GET /api/v1/plugins` answers each
  // permission's routes (from src/webgui/permissions.json) — compiled here into matchers.
  // The server checks the same table again on every bridged request (`X-Agnostic-Plugin`),
  // so this check is a fast refusal and a second wall, never the only one.
  window.AgnosticBridge = (() => {
    const METHODS = Object.freeze(['GET', 'POST', 'PUT', 'DELETE']);
    const MAX_BODY = 262144;
    const MAX_INFLIGHT = 16;
    const RE_PATH = /^\\/api\\/v1\\/[A-Za-z0-9\\/._-]*(\\?[A-Za-z0-9._~=&%-]{0,512})?$/;
    const RE_ID = /^[A-Za-z0-9._:-]{1,64}$/;
    const RE_ETAG = /^\"[0-9a-f]{16}\"$/;
    const RE_IDEM = /^[A-Za-z0-9._:-]{8,128}$/;
    const reEscape = (s) => String(s).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');

    /** One catalogue route (\"GET /api/v1/crews/:id\") as a matcher for plugin `pluginId`. */
    function compileRoute(route, pluginId) {
      const sp = String(route).indexOf(' ');
      if (sp < 1) return null;
      const method = route.slice(0, sp);
      const segs = route.slice(sp + 1).split('/').slice(1).map((seg) => {
        if (seg === ':self') return reEscape(pluginId);
        if (seg.startsWith(':')) return '[^/]+';
        return reEscape(seg);
      });
      return { method, re: new RegExp('^/' + segs.join('/') + '$') };
    }
    /** Every route the plugin's permissions grant, per the catalogue. Unknown names grant nothing. */
    function grantsFor(plugin, catalogue) {
      const out = [];
      for (const name of (plugin && plugin.permissions) || []) {
        const entry = catalogue && Object.prototype.hasOwnProperty.call(catalogue, name) ? catalogue[name] : null;
        for (const route of (entry && Array.isArray(entry.routes) ? entry.routes : [])) {
          const g = compileRoute(route, plugin.id);
          if (g) out.push(g);
        }
      }
      return out;
    }
    /** Whether (method, path) is one of `grants`. The query string is not part of the match. */
    function granted(grants, method, path) {
      const bare = String(path).split('?')[0];
      return grants.some((g) => g.method === method && g.re.test(bare));
    }
    /**
     * Check one `agnostic:request` from `plugin`. Returns `{ok: true, method, path, body, headers}`
     * — what to send — or `{ok: false, status, error}`, answered by the shell without reaching
     * the network: 400 malformed, 403 not granted, 413 too large.
     */
    function check(msg, plugin, grants) {
      const no = (status, error) => ({ ok: false, status, error });
      const idOk = (typeof msg.id === 'string' && RE_ID.test(msg.id)) || (typeof msg.id === 'number' && Number.isFinite(msg.id));
      if (!idOk) return no(400, 'a request id is a short string or a number');
      const method = typeof msg.method === 'string' ? msg.method.toUpperCase() : '';
      const path = typeof msg.path === 'string' ? msg.path : '';
      if (!METHODS.includes(method) || !RE_PATH.test(path) || path.includes('..') || path.includes('//')) {
        return no(400, 'the shell refused a malformed request');
      }
      if (!granted(grants, method, path)) return no(403, plugin.name + ' is not permitted to ' + method + ' ' + path.split('?')[0]);
      let body;
      if (msg.body !== undefined && msg.body !== null) {
        if (method === 'GET' || method === 'DELETE') return no(400, 'a ' + method + ' carries no body');
        let text;
        try { text = JSON.stringify(msg.body); } catch (err) { return no(400, 'the body is not JSON'); }
        if (typeof text !== 'string') return no(400, 'the body is not JSON');
        if (text.length > MAX_BODY) return no(413, 'the body is over 256 KB');
        body = msg.body;
      }
      const headers = {};
      if (msg.ifMatch !== undefined) {
        if ((method !== 'PUT' && method !== 'DELETE') || typeof msg.ifMatch !== 'string' || !RE_ETAG.test(msg.ifMatch)) {
          return no(400, 'ifMatch is a document etag, on a PUT or a DELETE');
        }
        headers['If-Match'] = msg.ifMatch;
      }
      if (msg.ifNoneMatch !== undefined) {
        if (method !== 'PUT' || msg.ifNoneMatch !== '*') return no(400, \"ifNoneMatch is '*', on a PUT\");
        headers['If-None-Match'] = '*';
      }
      if (msg.idempotencyKey !== undefined) {
        if (method !== 'POST' || typeof msg.idempotencyKey !== 'string' || !RE_IDEM.test(msg.idempotencyKey)) {
          return no(400, 'an idempotencyKey is 8-128 of [A-Za-z0-9._:-], on a POST');
        }
        headers['Idempotency-Key'] = msg.idempotencyKey;
      }
      return { ok: true, method, path, body, headers };
    }
    return Object.freeze({ METHODS, MAX_BODY, MAX_INFLIGHT, compileRoute, grantsFor, granted, check });
  })();
</script>
<script>
  'use strict';
  // Agnostic WebGUI shell. Served at /ui with a CSP that admits exactly this script
  // (by hash) and connects only to its own origin. Every value that came from the
  // server is written with textContent, never innerHTML.
  (() => {
    const $ = (id) => document.getElementById(id);
    const TOKEN_KEY = 'agnostic.token';
    const ROLE_KEY = 'agnostic.role';
    const state = { plugins: null, pluginsError: null, catalogue: {}, ready: null, auth: 'unknown', route: 'overview' };

    // --- session: kept per tab, and only if storage is usable ---------------------
    const store = {
      get(k) { try { return sessionStorage.getItem(k) || ''; } catch (e) { return ''; } },
      set(k, v) { try { if (v) sessionStorage.setItem(k, v); else sessionStorage.removeItem(k); } catch (e) { /* storage unavailable */ } },
    };

    // `extra`: further request headers — the bridge's `X-Agnostic-Plugin`, `If-Match`,
    // `If-None-Match` and `Idempotency-Key`, which `AgnosticBridge.check` has already vetted.
    async function api(method, path, body, extra) {
      const headers = Object.assign({ Accept: 'application/json' }, extra || {});
      const token = store.get(TOKEN_KEY);
      if (token) headers.Authorization = 'Bearer ' + token;
      const init = { method, headers, credentials: 'omit', cache: 'no-store' };
      // Every POST and PUT declares JSON, even with no body: the server refuses one that
      // does not (415) — that refusal is what stops a cross-site form post.
      if (method === 'POST' || method === 'PUT') headers['Content-Type'] = 'application/json';
      if (body !== undefined) init.body = JSON.stringify(body);
      let res;
      try { res = await fetch(path, init); } catch (e) { return { status: 0, data: { error: 'the server is unreachable' } }; }
      let data = null;
      try { data = await res.json(); } catch (e) { data = null; }
      const etag = res.headers.get('ETag');
      if (res.status === 401) {
        state.auth = 'required';
        if (token) { store.set(TOKEN_KEY, ''); store.set(ROLE_KEY, ''); }
      } else if (res.ok && !token) {
        state.auth = 'off';
      } else if (res.ok) {
        state.auth = 'signed-in';
      }
      return { status: res.status, data, etag: etag || null };
    }
    const errText = (r) => (r.data && typeof r.data.error === 'string') ? r.data.error : ('HTTP ' + r.status);

    // --- small DOM helpers ----------------------------------------------------------
    function el(tag, cls, text) {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      if (text !== undefined && text !== null) n.textContent = String(text);
      return n;
    }
    let toastTimer = 0;
    function toast(msg, bad) {
      const t = $('toast');
      t.textContent = msg;
      t.className = 'show' + (bad ? ' bad' : '');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { t.className = ''; }, 3600);
    }

    // --- data -----------------------------------------------------------------------
    async function loadReady() {
      const r = await api('GET', '/ready');
      state.ready = r.data && typeof r.data === 'object' ? r.data : null;
    }
    async function loadPlugins() {
      const r = await api('GET', '/api/v1/plugins');
      if (r.status === 200 && r.data && Array.isArray(r.data.plugins)) {
        state.plugins = r.data.plugins;
        // The permission vocabulary, as the server enforces it (src/webgui/permissions.json).
        state.catalogue = r.data.catalogue && typeof r.data.catalogue === 'object' ? r.data.catalogue : {};
        state.pluginsError = null;
      } else {
        state.plugins = null;
        state.pluginsError = r.status === 401 ? 'signin' : errText(r);
      }
    }
    const enabledPlugins = () => (state.plugins || []).filter((p) => p.enabled);
    const findPlugin = (id) => (state.plugins || []).find((p) => p.id === id) || null;

    // --- routing: #overview, #settings, #plugin/<id> ---------------------------------
    function parseRoute() {
      const h = location.hash.replace(/^#/, '');
      if (h === 'settings') return { view: 'settings' };
      if (h.startsWith('plugin/')) return { view: 'plugin', id: h.slice(7) };
      return { view: 'overview' };
    }
    function go(hash) { if (location.hash !== '#' + hash) location.hash = hash; else render(); }

    // --- the plugin host bridge (0.1.8, ADR 0005; checked by the server since 0.1.9, ADR 0007)
    // A plugin page runs sandboxed in an opaque origin with connect-src 'none': it
    // cannot reach the API itself. It asks the shell, by postMessage, and the shell
    // answers only requests the plugin's manifest permits — made with the user's own
    // credential, which the plugin never sees, and marked `X-Agnostic-Plugin` so the
    // server checks the same permissions again. The server also still enforces the
    // user's role on every one of them: a permission is the plugin's limit, not the user's.
    //
    // ⚠ `gen` is the page SESSION. A page announces itself with `agnostic:hello`, and a
    // reload or a different plugin in the frame starts a new session — the frame's window
    // object stays the same, so `e.source` cannot tell two pages apart. A reply is posted
    // only into the session that asked; anything answered after the page changed is
    // dropped, so a late answer can never resolve the next page's request of the same id.
    const bridge = { plugin: null, grants: [], gen: 0, inflight: 0 };
    const permissionWords = (name) => {
      const c = state.catalogue && state.catalogue[name];
      return c && typeof c.grants === 'string' ? c.grants : name;
    };
    function newSession() { bridge.gen++; bridge.inflight = 0; }
    function dataLabel(p, long) {
      if (p.data === 'mixed') return long ? 'SIMULATED + LIVE' : 'SIM + LIVE';
      return long ? 'SIMULATED DATA' : 'SIMULATED';
    }
    function sendInit() {
      const frame = $('plugin-frame');
      if (!bridge.plugin || !frame.contentWindow) return;
      frame.contentWindow.postMessage({
        type: 'agnostic:init', protocol: 1,
        // What this shell's bridge carries beyond protocol 1's first form (0.1.9): query
        // strings in a path, `ifMatch`/`ifNoneMatch` with an `etag` on the answer, and an
        // `idempotencyKey` on a POST. A plugin checks for a feature before relying on it.
        features: ['query', 'revisions', 'idempotency'],
        plugin: { id: bridge.plugin.id, name: bridge.plugin.name, version: bridge.plugin.version },
        permissions: (bridge.plugin.permissions || []).slice(),
        // `off`: every route is open (loopback). `required`: the server enforces roles,
        // and `role` is this user's. `unknown`: no answer from the server yet.
        user: {
          auth: state.auth === 'off' ? 'off' : state.auth === 'unknown' ? 'unknown' : 'required',
          signedIn: !!store.get(TOKEN_KEY), role: store.get(ROLE_KEY) || null,
        },
      }, '*');
    }
    window.addEventListener('message', async (e) => {
      const frame = $('plugin-frame');
      // Only the plugin frame on screen may ask, and only as itself — and it is always
      // sandboxed, so its origin is opaque ('null'). A frame that navigated itself to a
      // real origin is no longer the plugin, and gets nothing.
      if (!bridge.plugin || !frame.contentWindow || e.source !== frame.contentWindow) return;
      if (e.origin !== 'null') return;
      const msg = e.data;
      if (!msg || typeof msg !== 'object' || typeof msg.type !== 'string') return;
      if (msg.type === 'agnostic:hello') { newSession(); sendInit(); return; }
      if (msg.type !== 'agnostic:request') return;
      const p = bridge.plugin;
      const gen = bridge.gen;
      const reply = (status, data, etag) => {
        if (gen !== bridge.gen || bridge.plugin !== p) return; // the page that asked is gone
        const out = { type: 'agnostic:response', id: msg.id, status, data };
