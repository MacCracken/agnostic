    function renderPlugin(id) {
      const p = findPlugin(id);
      const frame = $('plugin-frame');
      if (!p && state.pluginsError === 'signin') {
        frame.removeAttribute('src');
        go('overview');
        openSignin('Sign in to open this view.');
        return;
      }
      if (!p || !p.enabled) {
        frame.removeAttribute('src');
        toast(p ? p.name + ' is switched off.' : 'There is no such view.', true);
        go('overview');
        return;
      }
      $('plugin-name').textContent = p.name;
      $('plugin-version').textContent = 'v' + p.version;
      // A `mixed` view labels each mission itself, so the bar says only that it can.
      $('plugin-sim').hidden = p.data === 'live';
      $('plugin-sim').textContent = dataLabel(p, true);
      $('plugin-newtab').href = p.url;
      frame.title = p.name;
      bridge.plugin = p;
      bridge.grants = window.AgnosticBridge.grantsFor(p, state.catalogue);
      if (frame.getAttribute('src') !== p.url) { newSession(); frame.setAttribute('src', p.url); }
    }

    function render() {
      const route = parseRoute();
      state.route = route.view;
      renderTabs(route);
      renderWho();
      for (const v of ['overview', 'settings', 'plugin']) $('view-' + v).hidden = v !== route.view;
      if (route.view !== 'plugin') { $('plugin-frame').removeAttribute('src'); bridge.plugin = null; bridge.grants = []; newSession(); }
      if (route.view === 'overview') renderOverview();
      else if (route.view === 'settings') renderSettings();
      else renderPlugin(route.id);
    }

    // --- actions --------------------------------------------------------------------
    async function togglePlugin(p, sw) {
      const want = !p.enabled;
      sw.disabled = true;
      const r = await api('PUT', '/api/v1/plugins/' + encodeURIComponent(p.id), { enabled: want });
      if (r.status === 200 && r.data && r.data.plugin) {
        Object.assign(p, r.data.plugin);
        toast(p.name + (p.enabled ? ' is on.' : ' is off.'));
      } else if (r.status === 401) {
        openSignin('Sign in as an administrator to change plugins.');
      } else if (r.status === 403) {
        toast('Changing a plugin needs the administrator role.', true);
      } else {
        toast('Could not change ' + p.name + ': ' + errText(r), true);
      }
      render();
    }

    function openSignin(why) {
      $('signin-why').textContent = why || 'This server requires authentication.';
      $('signin-error').textContent = '';
      $('signin').hidden = false;
      $('signin-email').focus();
    }
    function closeSignin() { $('signin').hidden = true; $('signin-password').value = ''; }
    async function signIn() {
      const email = $('signin-email').value.trim();
      const password = $('signin-password').value;
      if (!email || !password) { $('signin-error').textContent = 'Email and password are both required.'; return; }
      $('signin-go').disabled = true;
      const r = await api('POST', '/api/v1/auth/login', { email, password });
      $('signin-go').disabled = false;
      if (r.status === 200 && r.data && typeof r.data.token === 'string') {
        store.set(TOKEN_KEY, r.data.token);
        store.set(ROLE_KEY, typeof r.data.role === 'string' ? r.data.role : '');
