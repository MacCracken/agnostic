      for (const p of enabledPlugins()) add(p.name, 'plugin/' + p.id, route.view === 'plugin' && route.id === p.id, p.data !== 'live');
      add('Settings', 'settings', route.view === 'settings');
    }

    function renderWho() {
      const who = $('who');
      who.replaceChildren();
      const role = store.get(ROLE_KEY);
      if (store.get(TOKEN_KEY)) {
        who.append(el('span', null, 'Signed in' + (role ? ' · ' + role : '')));
        const out = el('button', 'btn', 'Sign out');
        out.type = 'button';
        out.addEventListener('click', signOut);
        who.append(out);
      } else if (state.auth === 'required') {
        const b = el('button', 'btn primary', 'Sign in');
        b.type = 'button';
        b.addEventListener('click', () => openSignin());
        who.append(b);
      } else if (state.auth === 'off') {
        who.append(el('span', 'pill', 'AUTH OFF · LOOPBACK'));
      }
    }

    function renderOverview() {
      const kv = $('server-kv');
      kv.replaceChildren();
      const row = (k, v) => { kv.append(el('dt', null, k)); const d = el('dd'); if (v instanceof Node) d.append(v); else d.textContent = v; kv.append(d); };
      const r = state.ready;
      if (!r) {
        row('status', el('span', 'pill bad', 'UNREACHABLE'));
      } else {
        const ok = r.status === 'ready';
        row('status', el('span', 'pill ' + (ok ? 'ok' : 'bad'), String(r.status || 'unknown').toUpperCase()));
        if (r.version) row('version', r.version);
        if (r.checks && typeof r.checks === 'object') {
          for (const k of Object.keys(r.checks)) row(k, String(r.checks[k]));
        }
      }
      const list = $('views-list');
      list.replaceChildren();
      if (state.pluginsError === 'signin') {
        const li = el('li');
        li.append(el('span', 'muted', 'Sign in to see the views on this server.'));
        const b = el('button', 'btn', 'Sign in');
        b.type = 'button';
        b.addEventListener('click', () => openSignin());
        li.append(el('span', 'spacer'), b);
        list.append(li);
        return;
      }
      if (state.pluginsError) { list.append(el('li', 'muted', 'Could not list views: ' + state.pluginsError)); return; }
      if (!state.plugins || !state.plugins.length) { list.append(el('li', 'muted', 'This build has no views.')); return; }
      for (const p of state.plugins) {
        const li = el('li');
        li.append(el('span', 'name', p.name));
        if (p.data !== 'live') li.append(el('span', 'pill sim', dataLabel(p, false)));
        li.append(el('span', 'spacer'));
        if (p.enabled) {
          const b = el('button', 'btn', 'Open');
          b.type = 'button';
          b.addEventListener('click', () => go('plugin/' + p.id));
          li.append(b);
        } else {
          li.append(el('span', 'muted', 'Off — switch it on in Settings'));
        }
        list.append(li);
      }
    }

    function renderSettings() {
      const rows = $('plugin-rows');
      rows.replaceChildren();
      if (state.pluginsError === 'signin') {
        rows.append(el('p', 'muted', 'Sign in to manage plugins.'));
      } else if (state.pluginsError) {
        rows.append(el('p', 'muted', 'Could not list plugins: ' + state.pluginsError));
      } else {
        const role = store.get(ROLE_KEY);
        const mayChange = state.auth === 'off' || role === 'admin' || role === 'super_admin';
        for (const p of state.plugins || []) {
          const row = el('div', 'plugin-row');
          const title = el('div', 'title');
