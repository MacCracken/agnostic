      const bytes = docs.reduce((n, d) => n + (Number.isInteger(d.bytes) ? d.bytes : 0), 0);
      const scope = typeof r.data.scope === 'string' && r.data.scope !== '_' ? ' in tenant ' + r.data.scope : '';
      node.replaceChildren(el('span', null, 'Stored documents' + scope + ': ' + (docs.length ? docs.length + ' · ' + (bytes / 1024).toFixed(1) + ' KB' : 'none')));
      if (docs.length && mayWrite()) {
        const b = el('button', 'btn small', 'Delete all');
        b.type = 'button';
        b.addEventListener('click', () => clearStored(p, docs, node, b));
        node.append(b);
      }
    }
    async function clearStored(p, docs, node, b) {
      if (!window.confirm('Delete all ' + docs.length + ' of ' + p.name + '\\u2019s stored documents? This cannot be undone.')) return;
