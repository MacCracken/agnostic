# agnostic/routes/definitions — agent definition CRUD.
#
# ## The status contract
#
# | Route | Codes |
# |---|---|
# | `GET /api/v1/agents/definitions` | 200 |
# | `POST /api/v1/agents/definitions` | **201** · 400 · 409 · 422 · **507** |
# | `GET /api/v1/agents/definitions/{key}` | 200 · 404 · 422 |
# | `PUT /api/v1/agents/definitions/{key}` | 200 · 400 · 404 · **412** (0.1.15) · 422 |
# | `DELETE /api/v1/agents/definitions/{key}` | 200 · 404 · **412** (0.1.15) · 422 |
#
# A single definition answers with its revision — `etag` in the body and an `ETag` header —
# and `If-Match` on `PUT` or `DELETE` makes the write conditional (0.1.15; see
# `src/engine/definitions.cyr`, "Revisions").
#
# **201, not 202** — and the contrast with `POST /api/v1/crews` is the point. A
# crew is *accepted work that is not finished*, so 202 and a poll. A definition
# **is** complete when the call returns.
#
# **409 on `POST` to an existing key; 404 on `PUT` to an absent one. No upsert.**
# An upsert makes a typo'd key silently create a second definition and leaves the
# caller unable to tell which happened.
#
# **507, not 503, when the store is full.** In M2's vocabulary 503 means *the
# engine cannot act*; reusing it would make two different faults indistinguishable
# to a retry policy. One is retriable after a `DELETE`, the other is not.
#
# **200 on `DELETE`, not 204.** `_agnostic_serve_send` always writes a
# Content-Type and a body, so a genuine 204 needs a no-body arm in `serve.cyr`.
# Inventing a response mode for one route is not worth it, and 200-with-a-body
# matches `POST /api/v1/crews/{id}/cancel`.
#
# ## ⚠ Every response says where the definition lives
#
# `"storage": "memory"` is on all five. The store is process-lifetime and a
# restart empties it, and no property of the record can distinguish durable from
# not — so it is disclosed rather than inferred, the same way M2 discloses
# placeholder mode. **M4 flips the literal to `"patra"` and nothing else on the
# wire moves.**
#
# This module reaches the store only through `agnostic_definitions_*`, never
# through `_agnostic_definitions`, so M4 can replace the storage without touching
# a handler.

var AGNOSTIC_JK_DEFINITION  = str_from("definition");
var AGNOSTIC_JK_DEFINITIONS = str_from("definitions");
var AGNOSTIC_JK_STORAGE     = str_from("storage");
var AGNOSTIC_JV_PATRA       = str_from("patra");
var AGNOSTIC_JV_DELETED     = str_from("deleted");
var AGNOSTIC_JK_INTACT      = str_from("intact");
var AGNOSTIC_JK_BAD_INDEX   = str_from("bad_index");
var AGNOSTIC_JK_AT_OPEN     = str_from("entries_at_open");
var AGNOSTIC_JK_APPENDED    = str_from("appended");
var AGNOSTIC_JK_VERIFIED    = str_from("verified");
var AGNOSTIC_JV_AT_OPEN     = str_from("open");
# The verdict and its breaks (0.1.15).
var AGNOSTIC_JK_VERDICT     = str_from("verdict");
var AGNOSTIC_JK_BREAKS      = str_from("breaks");
var AGNOSTIC_JK_BREAK_COUNT = str_from("break_count");
var AGNOSTIC_JK_KIND        = str_from("kind");
# ⚠ Its own key, not the crew-events `dropped_events`. Reusing a key named for a
# different concept reads as the same number twice.
var AGNOSTIC_JK_AUDIT_DROP  = str_from("dropped");
# The audit entries route (0.1.10).
var AGNOSTIC_JK_ENTRIES     = str_from("entries");
var AGNOSTIC_JK_TIMESTAMP   = str_from("timestamp");
var AGNOSTIC_JK_SEVERITY    = str_from("severity");
var AGNOSTIC_JK_SOURCE      = str_from("source");
var AGNOSTIC_JK_ACTION      = str_from("action");
var AGNOSTIC_JK_DETAILS     = str_from("details");
var AGNOSTIC_JK_HASH        = str_from("hash");
var AGNOSTIC_JK_PREV_HASH   = str_from("prev_hash");
var AGNOSTIC_JK_CUT         = str_from("cut");
var AGNOSTIC_JK_OLDEST_HELD = str_from("oldest_held");

# Where definitions live. One literal, so M4 has one thing to change.
fn agnostic_definitions_storage(): i64 {
    return AGNOSTIC_JV_PATRA;
}

# Stamp `storage` onto a response body.
fn _agnostic_def_stamp(a, obj): i64 {
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_STORAGE,
      bayan_json_v_str_new_a(a, agnostic_definitions_storage()));
    return obj;
}

# The body every single-definition response carries: the record, the fields that
# were retained but shape nothing, its revision (0.1.15), and where it lives.
fn _agnostic_def_body_a(a, d): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0; }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_DEFINITION,
      agnostic_agent_def_to_value_a(a, d));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_UNFORWARDED,
      agnostic_agent_def_unforwarded_a(a, d));
    var tag = agnostic_definition_etag_a(a, d);
    if (tag == 0) { return 0; }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_ETAG, bayan_json_v_str_new_a(a, tag));
    return _agnostic_def_stamp(a, obj);
}

# A single-definition response: `status`, the body, and the revision as an `ETag` header
# too (0.1.15) — the bridge hands a plugin the header, and a script can read either.
fn _agnostic_def_answer_a(a, status, d): i64 {
    var b = _agnostic_def_body_a(a, d);
    if (b == 0) { return 0; }
    var r = agnostic_response_json_a(a, status, b);
    var tag = agnostic_definition_etag_a(a, d);
    if (r == 0 || tag == 0) { return r; }
    var hb = str_builder_new_a(a);
    if (hb == 0) { return r; }
    str_builder_add_cstr_a(a, hb, "ETag: ");
    str_builder_add_a(a, hb, tag);
    str_builder_add_cstr_a(a, hb, "\r\n");
    var line = str_builder_build_a(a, hb);
    if (line == 0) { return r; }
    return agnostic_response_set_headers(r, str_data(line));
}

# The 412 a stale `If-Match` earns, with the `revision` code plugin documents use.
fn _agnostic_def_stale_a(a): i64 {
    return agnostic_response_error_code_a(a, AGNOSTIC_EC_REVISION,
      str_from_a(a, "the definition is not the revision this write was made from; read it again"));
}

# The 422 a malformed key earns.
#
# ⚠ 422, not 404 — the caller's key is not a legal key, which is a different fact
# from no definition having that name. Mirrors `_agnostic_crew_bad_id_a`.
fn _agnostic_def_bad_key_a(a): i64 {
    return agnostic_response_error_a(a, AGNOSTIC_HTTP_UNPROCESSABLE,
      str_from_a(a, "key must match [a-z0-9][a-z0-9-]* and be at most 100 characters"));
}

# The 404 an absent key earns.
fn _agnostic_def_not_found_a(a): i64 {
    return agnostic_response_error_a(a, HTTP_NOT_FOUND,
      str_from_a(a, "agent definition not found"));
}

# Decode a request body into a definition, or answer with the rejection.
# Returns the definition, storing a ready-made error response through `out_resp`.
fn _agnostic_def_decode(a, body: Str, out_resp): i64 {
    store64(out_resp, 0);
    var v = agnostic_decode_a(a, body);
    if (v == 0) {
        store64(out_resp, agnostic_response_error_a(a, HTTP_BAD_REQUEST,
            str_from_a(a, "malformed JSON body")));
        return 0;
    }
    var reject: i64[1];
    store64(&reject, 0);
    # -1: not inside an `agents` array, so messages go out unprefixed.
    var d = agnostic_agent_def_decode_a(a, v, 0 - 1, &reject);
    if (d == 0 || agnostic_agent_def_complexity_ok(d) == 0) {
        # An unknown `complexity` is refused here, at the door, not by the decoder: stored
        # definitions are decoded by the same path and are read as they are (0.1.15).
        if (d != 0) { agnostic_agent_def_complexity_reject_a(a, &reject, 0 - 1); }
        var rj = load64(&reject);
        store64(out_resp, agnostic_response_error_a(a, agnostic_reject_status(rj),
            agnostic_reject_message(rj)));
        return 0;
    }
    return d;
}

# `GET /api/v1/agents/definitions` — every stored definition, as summaries.
fn agnostic_route_definitions_list_a(a): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0; }
    var arr = bayan_json_v_arr_new_a(a);
    if (arr == 0) { return 0; }

    var keys = agnostic_definitions_keys_a(a);
    if (keys == 0) { return 0; }
    var shown = 0;
    var i = 0;
    while (i < vec_len(keys)) {
        # A key removed between the snapshot and this fetch answers 0 and is
        # skipped — see `agnostic_definitions_keys`. `total` counts what is in
        # the array, never what the snapshot happened to hold.
        var d = agnostic_definitions_get(vec_get(keys, i));
        if (d != 0) {
            bayan_json_v_arr_push_a(a, arr, agnostic_agent_def_summary_a(a, d));
            shown = shown + 1;
        }
        i = i + 1;
    }

    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_DEFINITIONS, arr);
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_TOTAL, bayan_json_v_int_new_a(a, shown));
    return agnostic_response_json_a(a, HTTP_OK, _agnostic_def_stamp(a, obj));
}

# `POST /api/v1/agents/definitions` — create one. 201, or 409 if the key is taken.
fn agnostic_route_definition_create_a(a, body: Str): i64 {
    var resp: i64[1];
    var d = _agnostic_def_decode(a, body, &resp);
    if (d == 0) { return load64(&resp); }

    var key = agnostic_agent_def_key(d);
    var rc = agnostic_definitions_create(key, d);

    if (rc == AGNOSTIC_DEF_EXISTS) {
        return agnostic_response_error_a(a, AGNOSTIC_HTTP_CONFLICT,
          str_from_a(a, "an agent definition with this key already exists; use PUT to replace it"));
    }
    if (rc == AGNOSTIC_DEF_FULL) {
        # ⚠ 507, and the message says what to do about it. The store never
        # evicts, so this is a real ceiling rather than a transient — a retry
        # without a delete will fail identically.
        return agnostic_response_error_a(a, AGNOSTIC_HTTP_INSUFFICIENT_STORAGE,
          str_from_a(a, "the definition store is full; delete a definition before creating another"));
    }
    if (rc != AGNOSTIC_DEF_OK) {
        return agnostic_response_error_a(a, HTTP_INTERNAL,
          str_from_a(a, "could not store the agent definition"));
    }

    agnostic_audit_record(SEV_INFO, AGNOSTIC_AUDIT_SRC, str_from_a(a, "definition.create"),
      agnostic_audit_detail_a(a, "key", key));

    return _agnostic_def_answer_a(a, AGNOSTIC_HTTP_CREATED, d);
}

# `GET /api/v1/agents/definitions/{key}` — one definition.
fn agnostic_route_definition_get_a(a, key: Str): i64 {
    if (agnostic_key_is_valid(key) == 0) { return _agnostic_def_bad_key_a(a); }
    var d = agnostic_definitions_get(key);
    if (d == 0) { return _agnostic_def_not_found_a(a); }
    return _agnostic_def_answer_a(a, HTTP_OK, d);
}

# `PUT /api/v1/agents/definitions/{key}` — replace one. 404 if absent; never creates.
#
# ⚠ **The path key wins, and a body that disagrees is a 400.** Silently
# preferring one over the other would let `PUT /…/alpha` with `{"key":"beta"}`
# write to a name the caller did not address — and whichever side lost, the
# caller could not tell from the response.
#
# `If-Match` (0.1.15): the write happens only if the definition is still that revision —
# 412 with code `revision` otherwise. Checked before the body is read, as RFC 9110 §13.2.1
# orders it (an absent definition is still 404), and again under the store lock with the
# write, so nothing lands between them.
fn agnostic_route_definition_replace_a(a, key: Str, body: Str, ctx): i64 {
    if (agnostic_key_is_valid(key) == 0) { return _agnostic_def_bad_key_a(a); }
    var if_match = agnostic_reqctx_if_match(ctx);
    if (if_match != 0) {
        var cur = agnostic_definitions_get(key);
        if (cur == 0) { return _agnostic_def_not_found_a(a); }
        if (agnostic_definition_precondition_a(a, cur, if_match) == 0) { return _agnostic_def_stale_a(a); }
    }

    var resp: i64[1];
    var d = _agnostic_def_decode(a, body, &resp);
    if (d == 0) { return load64(&resp); }

    if (str_eq(agnostic_agent_def_key(d), key) == 0) {
        return agnostic_response_error_a(a, HTTP_BAD_REQUEST,
          str_from_a(a, "the 'key' in the body must match the key in the path"));
    }

    var rc = agnostic_definitions_replace_if_a(a, key, d, if_match);
    if (rc == AGNOSTIC_DEF_MISSING) { return _agnostic_def_not_found_a(a); }
    if (rc == AGNOSTIC_DEF_PRECONDITION) { return _agnostic_def_stale_a(a); }
    if (rc != AGNOSTIC_DEF_OK) {
        return agnostic_response_error_a(a, HTTP_INTERNAL,
          str_from_a(a, "could not store the agent definition"));
    }

    agnostic_audit_record(SEV_INFO, AGNOSTIC_AUDIT_SRC, str_from_a(a, "definition.replace"),
      agnostic_audit_detail_a(a, "key", key));

    return _agnostic_def_answer_a(a, HTTP_OK, d);
}

# `DELETE /api/v1/agents/definitions/{key}` — remove one. With `If-Match` (0.1.15), only if it
# is still that revision: 412 with code `revision` otherwise, and an absent one is 404.
fn agnostic_route_definition_delete_a(a, key: Str, ctx): i64 {
    if (agnostic_key_is_valid(key) == 0) { return _agnostic_def_bad_key_a(a); }
    var rc = agnostic_definitions_remove_if_a(a, key, agnostic_reqctx_if_match(ctx));
    if (rc == AGNOSTIC_DEF_PRECONDITION) { return _agnostic_def_stale_a(a); }
    if (rc != AGNOSTIC_DEF_OK) {
        return _agnostic_def_not_found_a(a);
    }
    # ⚠ Recorded at WARNING, not INFO. A deletion is the entry an operator goes
    # looking for, and severity is what `chain_by_severity` filters on.
    agnostic_audit_record(SEV_WARNING, AGNOSTIC_AUDIT_SRC, str_from_a(a, "definition.delete"),
      agnostic_audit_detail_a(a, "key", key));

    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0; }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_KEY, bayan_json_v_str_new_a(a, key));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_STATUS,
      bayan_json_v_str_new_a(a, AGNOSTIC_JV_DELETED));
    return agnostic_response_json_a(a, HTTP_OK, _agnostic_def_stamp(a, obj));
}

# `GET /api/v1/audit` — the state of the tamper-evident trail.
#
# ## Why this exists
#
# A tamper-evident chain nobody can check is decoration. This is the smallest
# surface that makes it real: how many entries are recorded, whether the chain
# still verifies, and — the part verification cannot tell you — how many appends
# failed.
#
# ⚠ **`dropped` is the number this endpoint exists for.** Verification proves the
# entries that ARE present form an unbroken chain; it cannot show one that was
# never written, because a failed append leaves no hole to find. A chain
# reporting `"intact": true` with a non-zero `dropped` has not told you
# everything, and only this counter says so.
#
# `bad_index` is present only when the chain is broken, and names the first entry
# that failed — omitted rather than rendered as -1, the same rule
# `agnostic_outcome_to_value_a` follows for `error`.
#
# ## What the verdict found (0.1.15)
#
# `verdict` is `intact`, `restarts` (breaks, every one where a restart did not link to the
# trail before it), `altered`, or `unverified` (the trail could not be read at open).
# `breaks` lists the first 32 breaks as `{index, kind}`, `kind` `restart` or `altered`, and
# `break_count` counts them all — the whole trail is walked, so an alteration after the first
# break is reported too. `intact` is true only for `intact`, as it always meant;
# `src/engine/audit.cyr` says what each kind can and cannot prove.
fn agnostic_route_audit_a(a): i64 {
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0; }

    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_TOTAL,
      bayan_json_v_int_new_a(a, agnostic_audit_count()));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_AT_OPEN,
      bayan_json_v_int_new_a(a, agnostic_audit_at_open()));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_APPENDED,
      bayan_json_v_int_new_a(a, agnostic_audit_appended()));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_AUDIT_DROP,
      bayan_json_v_int_new_a(a, agnostic_audit_dropped()));

    # ⚠ **`verified` says WHEN, and it says `open` rather than `now`.** The verdict is
    # taken once, at start-up. A per-request re-verify re-reads and re-hashes the whole
    # trail, a cost that grows with it, so it is not done here. (Until libro 2.8.9 it would
    # also have killed the process on a pool worker; that is fixed, and cost is the reason
    # left.) Reporting the moment is the honest half: a client reading `"intact": true` must
    # know it means "when this process started", not "a millisecond ago".
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_VERIFIED,
      bayan_json_v_str_new_a(a, AGNOSTIC_JV_AT_OPEN));

    var intact = agnostic_audit_is_intact();
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_INTACT, bayan_json_v_bool_new_a(a, intact));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_VERDICT,
      bayan_json_v_str_new_a(a, str_from_a(a, agnostic_audit_verdict_name(agnostic_audit_verdict()))));
    var bad = agnostic_audit_bad_index();
    if (bad >= 0) {
        bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_BAD_INDEX, bayan_json_v_int_new_a(a, bad));
    }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_BREAK_COUNT,
      bayan_json_v_int_new_a(a, agnostic_audit_break_count()));
    var breaks = bayan_json_v_arr_new_a(a);
    if (breaks == 0) { return 0; }
    var i = 0;
    while (i < agnostic_audit_breaks_kept()) {
        var bo = bayan_json_v_obj_new_a(a);
        if (bo == 0) { return 0; }
        bayan_json_v_obj_set_a(a, bo, AGNOSTIC_JK_INDEX, bayan_json_v_int_new_a(a, agnostic_audit_break_index(i)));
        bayan_json_v_obj_set_a(a, bo, AGNOSTIC_JK_KIND, bayan_json_v_str_new_a(a,
            str_from_a(a, agnostic_audit_break_kind_name(agnostic_audit_break_kind(i)))));
        bayan_json_v_arr_push_a(a, breaks, bo);
        i = i + 1;
    }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_BREAKS, breaks);

    # ⚠ 200 even when the chain is broken. The request succeeded and the answer
    # is the finding; a 500 would make a tamper report indistinguishable from a
    # server fault, and an operator polling this needs to tell those apart.
    return agnostic_response_json_a(a, HTTP_OK, _agnostic_def_stamp(a, obj));
}

# `GET /api/v1/audit/entries[?limit=&before=]` — the trail's newest entries (0.1.10).
#
# `{entries: [...], total, oldest_held, next?}`, newest first. Each entry is `{index,
# timestamp, severity, source, action, details, hash, prev_hash, cut?}`: `index` is its
# position in the chain from 0, `hash` and `prev_hash` its links — so a reader can see the
# chain hold from one entry to the next — and `cut: true` marks a field too long for the
# kept copy (the stored entry is whole). `total` is how many entries the chain holds.
#
# **Read from what this process keeps, not from the store** — the newest 1024 entries
# (`AGNOSTIC_AUDIT_RING`, `src/engine/audit.cyr`, which says why). `oldest_held` is the
# lowest index this route can answer; older entries are in the store and verified at open,
# and are not served here. `next` is the index to send back as `?before=` for the page
# after this one; absent when this page reached `oldest_held`. `limit` is 1 to 200,
# default 50. ADMIN, as the trail's summary is: it records every user's actions.
fn agnostic_route_audit_entries_a(a, path: Str): i64 {
    var limit = agnostic_query_uint_a(a, path, "limit", 50);
    if (limit < 1 || limit > 200) {
        return agnostic_response_error_a(a, AGNOSTIC_HTTP_UNPROCESSABLE,
          str_from_a(a, "'limit' is a number from 1 to 200"));
    }
    var total = agnostic_audit_next_index();
    var before = agnostic_query_uint_a(a, path, "before", total);
    if (before < 0) {
        return agnostic_response_error_a(a, AGNOSTIC_HTTP_UNPROCESSABLE,
          str_from_a(a, "'before' is an entry index — the 'next' of an earlier page"));
    }
    var rows = agnostic_audit_entries_a(a, before, limit);
    if (rows == 0) { return 0; }
    var lo = agnostic_audit_oldest_held();

    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0; }
    var arr = bayan_json_v_arr_new_a(a);
    if (arr == 0) { return 0; }
    var i = 0;
    var last = 0 - 1;
    while (i < vec_len(rows)) {
        var r = vec_get(rows, i);
        var o = bayan_json_v_obj_new_a(a);
        if (o == 0) { return 0; }
        last = agnostic_audit_read_get(r, AGNOSTIC_AR_INDEX);
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_INDEX, bayan_json_v_int_new_a(a, last));
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_TIMESTAMP,
          bayan_json_v_str_new_a(a, agnostic_audit_read_get(r, AGNOSTIC_AR_TS)));
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_SEVERITY, bayan_json_v_str_new_a(a,
            str_from_a(a, agnostic_audit_severity_wire(agnostic_audit_read_get(r, AGNOSTIC_AR_SEV)))));
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_SOURCE,
          bayan_json_v_str_new_a(a, agnostic_audit_read_get(r, AGNOSTIC_AR_SRC)));
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_ACTION,
          bayan_json_v_str_new_a(a, agnostic_audit_read_get(r, AGNOSTIC_AR_ACTION)));
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_DETAILS,
          bayan_json_v_str_new_a(a, agnostic_audit_read_get(r, AGNOSTIC_AR_DETAILS)));
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_HASH,
          bayan_json_v_str_new_a(a, agnostic_audit_read_get(r, AGNOSTIC_AR_HASH)));
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_PREV_HASH,
          bayan_json_v_str_new_a(a, agnostic_audit_read_get(r, AGNOSTIC_AR_PREV)));
        if (agnostic_audit_read_get(r, AGNOSTIC_AR_CUT) != 0) {
            bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_CUT, bayan_json_v_bool_new_a(a, 1));
        }
        bayan_json_v_arr_push_a(a, arr, o);
        i = i + 1;
    }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_ENTRIES, arr);
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_TOTAL, bayan_json_v_int_new_a(a, total));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_OLDEST_HELD, bayan_json_v_int_new_a(a, lo));
    if (last > lo) {
        bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_NEXT, bayan_json_v_int_new_a(a, last));
    }
    return agnostic_response_json_a(a, HTTP_OK, obj);
}
