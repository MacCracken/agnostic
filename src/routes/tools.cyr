# agnostic/routes/tools — `GET /api/v1/tools`: what the presets ask for, and what can answer (0.4.0).
#
# The M6 ledger, on the wire. The presets once named 38 tools, and each is listed with the engine
# tool behind it, or none: `src/engine/tools.cyr` says why that table is explicit and why a miss is an
# error, never a smaller agent. `unresolved` is the number M6 takes to 0.
#
# Since 0.4.5 a crew's agents call what resolves (ADR 0040), so `crews_call_tools` is `true`. A preset
# names only those, and a name with nothing behind it is refused at the door.
#
# The engine's tools are listed apart from the ledger's names: agnostic's vocabulary and agnosai's do
# not line up, and a name in one is not a name in the other.

var AGNOSTIC_JK_RESOLVED     = str_from("resolved");
var AGNOSTIC_JK_UNRESOLVED   = str_from("unresolved");
var AGNOSTIC_JK_BACKEND      = str_from("backend");
var AGNOSTIC_JK_ENGINE_TOOLS = str_from("engine_tools");
var AGNOSTIC_JK_CALL_TOOLS   = str_from("crews_call_tools");

# Whether a crew's agents can call a tool (0.4.5, ADR 0040). `tests/tools.tcyr` pins it.
var AGNOSTIC_CREWS_CALL_TOOLS = 1;

# The engine's tools as `{name, description}`, by name, in `a`. An empty array before mount.
fn _agnostic_tools_engine_a(a): i64 {
    var arr = bayan_json_v_arr_new_a(a);
    var schemas = agnostic_qa_engine_tools();
    if (arr == 0 || schemas == 0) { return arr; }
    var i = 0;
    while (i < vec_len(schemas)) {
        var sc = vec_get(schemas, i);
        var o = bayan_json_v_obj_new_a(a);
        if (o == 0) { return 0; }
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_NAME, bayan_json_v_str_new_a(a, agnosai_tool_schema_name(sc)));
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_DESCRIPTION,
          bayan_json_v_str_new_a(a, agnosai_tool_schema_description(sc)));
        bayan_json_v_arr_push_a(a, arr, o);
        i = i + 1;
    }
    return arr;
}

# `GET /api/v1/tools`.
fn agnostic_route_tools_a(a): i64 {
    var reg = agnostic_qa_catalog();
    var tools = bayan_json_v_arr_new_a(a);
    if (tools == 0) { return 0; }
    var total = agnostic_qa_ledger_count();
    var resolved = 0;
    var i = 0;
    while (i < total) {
        var name = agnostic_qa_ledger_at(i);
        var o = bayan_json_v_obj_new_a(a);
        if (o == 0) { return 0; }
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_NAME, bayan_json_v_str_new_a(a, name));
        var ok = agnostic_qa_tool_is_resolvable(reg, name);
        if (ok == 1) {
            resolved = resolved + 1;
            bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_BACKEND,
              bayan_json_v_str_new_a(a, agnostic_qa_backend_name(name)));
        }
        bayan_json_v_obj_set_a(a, o, AGNOSTIC_JK_RESOLVED, bayan_json_v_bool_new_a(a, ok));
        bayan_json_v_arr_push_a(a, tools, o);
        i = i + 1;
    }
    var engine = _agnostic_tools_engine_a(a);
    if (engine == 0) { return 0; }
    var obj = bayan_json_v_obj_new_a(a);
    if (obj == 0) { return 0; }
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_TOOLS, tools);
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_TOTAL, bayan_json_v_int_new_a(a, total));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_RESOLVED, bayan_json_v_int_new_a(a, resolved));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_UNRESOLVED, bayan_json_v_int_new_a(a, total - resolved));
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_ENGINE_TOOLS, engine);
    bayan_json_v_obj_set_a(a, obj, AGNOSTIC_JK_CALL_TOOLS, bayan_json_v_bool_new_a(a, AGNOSTIC_CREWS_CALL_TOOLS));
    return agnostic_response_json_a(a, HTTP_OK, obj);
}
